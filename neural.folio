# A neural network that learns, written from scratch in Folio: no library, only lists of numbers and the
# sums that change them. Folio has no random numbers and no sine, so it uses ones written in Folio too.
#
# It learns to tell apart two spirals of dots wound into each other, which no straight line can do, and
# draws what it believes at six moments, from knowing nothing to having both arms right. Blue means it
# thinks a dot there belongs to the blue arm. Then it is shown dots it has never seen.
#
# micrograd.folio is the same idea a number at a time, the way Andrej Karpathy's micrograd does it. This
# one works a layer at a time, which is some hundred times quicker.

use "math.folio" # random numbers, sine and cosine, and square roots, all written in Folio

set turns to 1.75 # how far each arm winds round
set reach to 3 # the network is given each dot's place times this, a size its weights find easy

# ---------- the dots to learn ----------

# about -0.1 to 0.1, more often near 0
to noise
    return (random() + random() + random() - 1.5) / 15
end

# Two arms from the middle outwards: the orange one (-1), and the blue one (1) half a turn on from it.
# More dots further out, where an arm is longer.
to spirals with count
    set made to empty list
    repeat count times
        for each label in list of -1, 1
            set far to sqrt(between(0.02, 1))
            set angle to turns * 2 * pi * far
            add record with x label * far * cosine(angle) + noise(), y label * far * sine(angle) + noise(), label label to made
        end
    end
    return made
end

# ---------- the network ----------

to zeros with count
    set made to empty list
    repeat count times
        add 0 to made
    end
    return made
end

# A layer is a row of neurons. Each adds up its inputs, each times a weight, plus a bias; all but the last
# layer's then turn anything below zero into zero (a ReLU). The weights are one list, a neuron after
# another, and start random. The `blame` lists will say how much the loss changes when each number does,
# and `pace` and `spread` are what Adam remembers of the blame so far.
to layer with inputs, neurons, last
    set weights to empty list
    set edge to sqrt(6 / (inputs + neurons))
    repeat inputs * neurons times
        add between(0 - edge, edge) to weights
    end
    return record with neurons neurons, last last, weights weights, bias zeros(neurons),
        weight_blame zeros(inputs * neurons), bias_blame zeros(neurons),
        weight_pace zeros(inputs * neurons), bias_pace zeros(neurons),
        weight_spread zeros(inputs * neurons), bias_spread zeros(neurons)
end

# layers of neurons, each layer taking the one before as its inputs
to network with sizes
    set layers to empty list
    for each k from 1 to length of sizes - 1
        add layer(item k of sizes, item (k + 1) of sizes, k is length of sizes - 1) to layers
    end
    return layers
end

# What every neuron says for one dot: a list for each layer, after the inputs themselves.
to fire with layers, inputs
    set said to list of inputs
    for each one in layers
        set weights to weights of one
        set outs to empty list
        set spot to 0
        for each j from 1 to neurons of one
            set total to item j of bias of one
            for each v in inputs
                add 1 to spot
                set total to total + item spot of weights * v
            end
            if total is less than 0 and not last of one
                set total to 0
            end
            add total to outs
        end
        add outs to said
        set inputs to outs
    end
    return said
end

# the network's score for a place: above 0 means blue, below 0 orange
to score_at with layers, x, y
    set said to fire(layers, list of x * reach, y * reach)
    return item 1 of item (length of said) of said
end

# Backpropagation. `blame` is how much the loss changes when the score does. Going back a layer at a
# time, each neuron's blame is added to its bias's and, times each input, to that weight's; and each
# input takes its share of the blame back to the neuron it came from, unless that neuron said 0.
to pass_back with layers, said, blame
    set blames to list of blame
    for each back from 1 to length of layers
        set k to length of layers - back + 1
        set one to item k of layers
        set inputs to item k of said
        set weights to weights of one
        set weight_blame to weight_blame of one
        set bias_blame to bias_blame of one
        set passed to zeros(length of inputs)
        set spot to 0
        for each j from 1 to length of blames
            set g to item j of blames
            set item j of bias_blame to item j of bias_blame + g
            for each i from 1 to length of inputs
                add 1 to spot
                set item i of passed to item i of passed + g * item spot of weights
                set item spot of weight_blame to item spot of weight_blame + g * item i of inputs
            end
        end
        if k is greater than 1
            for each i from 1 to length of inputs
                if item i of inputs is 0
                    set item i of passed to 0
                end
            end
        end
        set blames to passed
    end
end

# How wrong the network is: a "max-margin" loss that wants every score past 1 on the right side. Gives
# the loss and how many dots are on the right side, and, when `learning`, leaves each weight's blame.
to judge with layers, dots, learning
    set loss to 0
    set right to 0
    for each dot in dots
        set said to fire(layers, list of x of dot * reach, y of dot * reach)
        set score to item 1 of item (length of said) of said
        if (label of dot is greater than 0) is (score is greater than 0)
            add 1 to right
        end
        set short to 1 - label of dot * score
        if short is greater than 0
            set loss to loss + short / length of dots
            if learning
                pass_back(layers, said, (0 - label of dot) / length of dots)
            end
        end
    end
    return record with loss loss, right right / length of dots
end

# Adam: every number steps against its blame, at a pace that is the blame's running average over its
# running size, so a number whose blame is small but steady moves as far as one whose blame is big.
to adam with numbers, blames, pace, spread, rate, warm_pace, warm_spread
    for each k from 1 to length of numbers
        set g to item k of blames
        set m to 0.9 * item k of pace + 0.1 * g
        set v to 0.999 * item k of spread + 0.001 * g * g
        set item k of pace to m
        set item k of spread to v
        set item k of numbers to item k of numbers - rate * (m / warm_pace) / (sqrt(v / warm_spread) + 0.00000001)
        set item k of blames to 0
    end
end

# ---------- drawing ----------

to shade with score
    if score is less than -1.5
        return "#f4a77a"
    else if score is less than -0.5
        return "#f8c8a8"
    else if score is less than 0
        return "#fde4d3"
    else if score is less than 0.5
        return "#d9e6fb"
    else if score is less than 1.5
        return "#afc9f5"
    end
    return "#86acee"
end

set cells to 50 # a picture is cells by cells squares
set cell to 3 # each this wide
set view to 1.15 # and shows from -view to view

# What the network believes, a row at a time (a run of squares of one colour is one box), with the dots
# on top and a line of words beneath. `left` and `bottom` say where the picture goes.
to picture with layers, dots, left, bottom, words
    for each row from 0 to cells - 1
        set y to (row + 0.5) / cells * 2 * view - view
        set run_color to shade(score_at(layers, 0.5 / cells * 2 * view - view, y))
        set run_start to 0
        for each column from 1 to cells
            set color to "the end"
            if column is less than cells
                set color to shade(score_at(layers, (column + 0.5) / cells * 2 * view - view, y))
            end
            if color is not run_color
                set over to 0.5 # a box goes a little under the next one and the row above, so no seam shows
                if column is cells
                    set over to 0
                end
                pen color run_color
                draw box at left + run_start * cell, bottom + row * cell size (column - run_start) * cell + over by cell + 0.5
                set run_color to color
                set run_start to column
            end
        end
    end
    for each dot in dots
        if label of dot is 1
            pen color "#1c5fd4"
        else
            pen color "#e8590c"
        end
        draw circle at left + (x of dot + view) / (2 * view) * cells * cell, bottom + (y of dot + view) / (2 * view) * cells * cell size 1.6
    end
    pen color "#8a94a6"
    draw words at left, bottom - 15 size 12
end

# the loss after each step, as a line falling from the top left
to chart with losses, left, bottom, width, height
    pen color "#9aa4b2"
    pen width 1
    pen up
    move to left, bottom + height
    pen down
    move to left, bottom
    move to left + width, bottom
    set highest to item 1 of losses
    pen color "#e11d48"
    pen width 2
    pen up
    set step to 0
    for each loss in losses
        move to left + step / (length of losses - 1) * width, bottom + loss / highest * height
        pen down
        add 1 to step
    end
    pen color "#8a94a6"
    draw "how wrong it is (the loss), step by step" at left + 8, bottom + height - 12 size 12
end

# ---------- learning ----------

to percent with part
    return whole(part * 100 + 0.5)
end

to train with layers, dots, steps
    set losses to empty list
    set shots to list of 1, 20, 45, 70, 100, steps # the steps a picture is drawn after
    set drawn to 0
    set warm_pace to 1
    set warm_spread to 1
    for each step from 1 to steps
        set result to judge(layers, dots, yes)
        if step is 1
            picture(layers, dots, -240, 80, "before: " + percent(right of result) + "% right")
            set drawn to 1
        end
        set warm_pace to warm_pace * 0.9
        set warm_spread to warm_spread * 0.999
        for each one in layers
            adam(weights of one, weight_blame of one, weight_pace of one, weight_spread of one, 0.03, 1 - warm_pace, 1 - warm_spread)
            adam(bias of one, bias_blame of one, bias_pace of one, bias_spread of one, 0.03, 1 - warm_pace, 1 - warm_spread)
        end
        add loss of result to losses
        if step is 1 or step is divisible by 25
            say "step " step ": loss " rounded(loss of result) ", " percent(right of result) "% right"
        end
        if drawn is less than length of shots and step is item (drawn + 1) of shots
            set now to judge(layers, dots, no)
            picture(layers, dots, -240 + (drawn - whole(drawn / 3) * 3) * 165, 80 - whole(drawn / 3) * 180, "step " + step + ": " + percent(right of now) + "% right")
            add 1 to drawn
        end
    end
    chart(losses, -240, -240, 480, 105)
end

set dots to spirals(100)
set model to network(list of 2, 16, 16, 1)
set count to 0
for each one in model
    add length of weights of one + length of bias of one to count
end
say "A network with 2 inputs, two layers of 16 neurons and 1 output: " count " numbers to learn."
set steps to 150
train(model, dots, steps)
set result to judge(model, dots, no)
say "after " steps " steps: " percent(right of result) "% of the " length of dots " dots are on the right side"
set unseen to spirals(100)
say "and " percent(right of judge(model, unseen, no)) "% of " length of unseen " new dots it had never seen"
