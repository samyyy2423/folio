# Standalone Moth. This file and machine.moth, made into machine code by machine.moth itself, are moth.exe
# (moth on Linux), which compiles a Moth program into a program of its own with neither JavaScript nor Rust:
#
#     moth [shell] [--allow-...]
#     moth build program.moth [--target windows|linux|wasm] [--allow-read] [--allow-write] ...
#         [--icon app.ico] [--version 1.2.0] [--include files]
#     moth run [--allow-...] program.moth [arguments...]
#     moth tidy program.moth [--check]
#     moth check program.moth
#     moth test program.test.moth
#
# The first moth.exe comes from GitHub's releases, or from Node.js (`node bootstrap.mjs`); after that it
# builds itself, into the same bytes:
#
#     moth build moth.moth --allow-read --allow-write --allow-run --include moth-debugger.moth
#
# Every name made here starts with cli_, from when a file used `as` a name shared its functions' variables
# with the program's top level (DESIGN.md, section 27).

use "machine.moth" as machine
use "wasm.moth" as webassembly # moth build --target wasm
use "stdlib.moth" as standard # the libraries a program anywhere can use (see cli_sources_of)
use "webpage.moth" as webpage # the page moth build --web writes a program into
use "checker-rules.moth" as checker_rules # what the checker's rules do with each type (see cli_rules)
use "tools/hash.moth" as cli_hashing # SHA-256, for the sums of packages' files in moth.sums

# what a build ships with: --icon's file, --version's numbers and --include's files and folders (see cli_main)
set cli_asked to record with icon nothing, version nothing, include empty list, installer no, app_name nothing, sign nothing

set cli_usage to "usage: moth build <file.moth> [--target windows|linux|wasm] [--allow-...] [--icon <file>] [--version <1.2.0>] [--include <file or folder>]\n       moth build <file.moth> --installer [--name <name>] [--version <1.2.0>] [--icon <file>] [--sign <command>]\n       moth build --web <file.moth>\n       moth run [--allow-...] <file.moth> [arguments...]\n       moth debug [--allow-...] <file.moth> [arguments...]\n       moth profile [--allow-...] <file.moth> [arguments...]\n       moth coverage [--allow-...] <file.moth> [arguments...]\n       moth notebook [--allow-...] <file.md>\n       moth tidy <files...> [--check]\n       moth check <file.moth>\n       moth lsp\n       moth test [files...] [--allow-...]\n       moth add <git repository or name> [name] [--signed] | moth get [--signed] | moth update [name] [--signed]\n       moth remove <name> | moth packages\n       moth search [words...] [--index <address or file>] | moth audit [--index <address or file>]\n       moth [shell] [--allow-...]\n       moth kernel [--allow-...]\n  build compiles a Moth program to machine code: a program of its own, <file>.exe for Windows or <file>\n  for Linux, for the system moth runs on unless --target says; with --target wasm, <file>.wasm, a WebAssembly\n  module (with GC and exceptions) that Moth's JavaScript runs, runWasm in moth.js; with --web, <file>.html, a\n  page that runs it in a browser, with Moth's engine and the files it uses in it. run builds it for this system into a file\n  beside it, runs it with the arguments after it, ends with the number it ended with, and removes the file.\n  debug runs it so too, stopping at its first line for commands: step, next, out, go, break, show, where\n  and the rest, which help lists. profile runs it so too, and then says where its time went: each\n  function's own time and calls, and the lines that took longest. coverage runs it so too, and then says\n  how many of each file's lines with a statement on them ran, and which didn't.\n  notebook runs each ```moth block of a Markdown file in turn, as the shell runs entries, and writes what\n  it said under it, in an ```output block, which the next run writes again.\n  The --allow flags let the program read or write files, read sites, start programs or use libraries\n  without asking: --allow-read, --allow-write, --allow-net, --allow-run, --allow-libraries or --allow-all,\n  and --allow-read=data,notes.txt (or --allow-write=..., --allow-net=...) only those. --icon gives a Windows\n  program its icon (an .ico or .png file), --version its version, and --include builds a file, or a folder's\n  files, into the program, where read finds them before it looks on the disk. --installer then makes\n  <file>-setup.exe (or <file>-setup), which installs the program for a person, with a menu entry and a way to\n  take it away, and no administrator needed; --name names it there. --sign runs a command on each program\n  built, with its name after it: --sign \"signtool sign /fd SHA256 /a\".\n  tidy writes the files the one way Moth writes code; --check only says which of them need it.\n  check finds problems in a file without running it, and test runs every test_ function in the files, each\n  in a run of its own; with no file, every file ending in .test.moth here and in the folders inside.\n  lsp is the language server an editor starts: problems as you type, tidying, the outline, where a name is\n  made, what it is, and what can come next, over the Language Server Protocol on the input and output.\n  add fetches a package, a Git repository (an address, github.com/someone/thing, or a folder), into\n  packages/, and lists it, at its commit, in moth.packages; a program uses it with use the package \"thing\".\n  An @ after it asks for a version: github.com/someone/thing@v1.2, a tag, branch or commit.\n  A name alone is one from the package index, which search lists, or finds the words in; --index gives\n  another index, an address or a file.\n  get fetches every package listed, at its commit; update moves them, or one, to their newest (a branch's,\n  if one was asked for; one asked for at a tag or commit stays there); remove takes\n  one away; and packages lists them. moth.sums keeps the SHA-256 of each package's files, which add and\n  update write and get checks, so a package that has changed is found. --signed takes only packages whose\n  commit, or the tag they were asked for at, has a signature git trusts. audit checks the packages against\n  the advisories in the package index, and says which are about the commits they're at.\n  moth alone, or moth shell, is the Moth shell: Moth typed a line at a\n  time, each entry run as a program of its own that has what the entries before it left. kernel runs cells\n  for Jupyter (editors/jupyter): each line it reads names a file of code, run as a notebook's block."

# the folder a file is in, with its last / or \, or "" for the folder moth runs in
to cli_folder_of with cli_path
    set cli_cut to 0
    for each cli_k from 1 to length of cli_path
        set cli_c to item cli_k of cli_path
        if cli_c is "/" or cli_c is "\\"
            set cli_cut to cli_k
        end
    end
    set cli_out to ""
    for each cli_k from 1 to cli_cut
        add item cli_k of cli_path to cli_out
    end
    return cli_out
end

to cli_name_of with cli_path
    set cli_folder to cli_folder_of(cli_path)
    set cli_out to ""
    for each cli_k from length of cli_folder + 1 to length of cli_path
        add item cli_k of cli_path to cli_out
    end
    return cli_out
end

# the files a program's lines `use`, by the names they give, as written
to cli_used_by with cli_source, cli_from
    set cli_found to empty list
    for each cli_line in split cli_source by "\n"
        set cli_rest to cli_line
        repeat while length of cli_rest is greater than 0 and (item 1 of cli_rest is " " or item 1 of cli_rest is "\t")
            set cli_rest to cli_tail(cli_rest, 2)
        end
        set cli_k to 0
        if length of cli_rest is greater than 17 and cli_first(cli_rest, 17) is "use the package \""
            set cli_k to 18
        else if length of cli_rest is greater than 5 and cli_first(cli_rest, 5) is "use \""
            set cli_k to 6
        end
        if cli_k is not 0
            set cli_name to ""
            repeat while cli_k is at most length of cli_rest and item cli_k of cli_rest is not "\""
                add item cli_k of cli_rest to cli_name
                add 1 to cli_k
            end
            if cli_first(cli_rest, 5) is "use \"" # from the folder of the file that uses it, as the parser finds it
                add cli_folder_of(cli_from) + cli_name to cli_found
            else # a package's main file, in packages/ beside the program
                add "packages/" + cli_name + "/" + cli_name + ".moth" to cli_found
            end
        end
    end
    return cli_found
end

# a text from its character `cli_from` on
to cli_tail with cli_text, cli_from
    set cli_out to ""
    for each cli_k from cli_from to length of cli_text
        add item cli_k of cli_text to cli_out
    end
    return cli_out
end

# a text's first `cli_n` characters
to cli_first with cli_text, cli_n
    set cli_out to ""
    for each cli_k from 1 to cli_n
        add item cli_k of cli_text to cli_out
    end
    return cli_out
end

# 1234567 as 1,234,567
to cli_grouped with cli_n
    set cli_digits to "" + cli_n
    set cli_out to ""
    for each cli_k from 1 to length of cli_digits
        if cli_k is greater than 1 and cli_three(length of cli_digits - cli_k + 1)
            add "," to cli_out
        end
        add item cli_k of cli_digits to cli_out
    end
    return cli_out
end

# whether n is a multiple of 3
to cli_three with cli_n
    set cli_left to cli_n
    repeat while cli_left is greater than 2
        set cli_left to cli_left - 3
    end
    return cli_left is 0
end

# the line something is wrong on, and under it a ^ at the spot, with the line's own tabs kept so it lines up
to cli_excerpt with cli_source, cli_line_no, cli_col
    set cli_lines to split cli_source by "\n"
    set cli_text to ""
    if cli_line_no is at most length of cli_lines
        set cli_text to item cli_line_no of cli_lines
    end
    set cli_mark to ""
    for each cli_k from 1 to cli_col - 1
        if cli_k is at most length of cli_text and item cli_k of cli_text is "\t"
            add "\t" to cli_mark
        else
            add " " to cli_mark
        end
    end
    return cli_text + "\n" + cli_mark + "^"
end

# the text of the file something is wrong in: the program's own, or one it uses
to cli_text_for with cli_file, cli_main_source, cli_names, cli_texts
    if cli_file is ""
        return cli_main_source
    end
    for each cli_k from 1 to length of cli_names
        if item cli_k of cli_names is cli_file
            return item cli_k of cli_texts
        end
    end
    return ""
end

# file:line:col: what's wrong, then the line with a ^ under the spot, the way editors and terminals can
# jump to; a mistake goes to the error output, a problem the checker found to the normal one
to cli_say_problem with cli_where, cli_line_no, cli_col, cli_message, cli_source, cli_to_errors
    set cli_said to cli_where + ":" + cli_line_no + ":" + cli_col + ": " + cli_message + "\n" + cli_excerpt(cli_source, cli_line_no, cli_col)
    if cli_to_errors
        say cli_said to the error output
    else
        say cli_said
    end
end

# a mistake in the program, as Moth shows one
to cli_report with cli_why, cli_main_file, cli_main_source, cli_names, cli_texts
    say cli_report_text(cli_why, cli_main_file, cli_main_source, cli_names, cli_texts) to the error output
end

to cli_report_text with cli_why, cli_main_file, cli_main_source, cli_names, cli_texts
    set cli_at to nothing
    try
        set cli_at to at of cli_why
    if it fails # a mistake in what the build was given, as its icon, not in the program: it has no place
        return "moth: " + cli_why
    end
    set cli_where to cli_main_file
    if file of cli_at is not ""
        set cli_where to file of cli_at
    end
    return cli_where + ":" + line of at of cli_why + ":" + col of cli_at + ": " + reason of cli_why + "\n"
        + cli_excerpt(cli_text_for(file of cli_at, cli_main_source, cli_names, cli_texts), line of cli_at, col of cli_at)
end

# the files a program uses, by the names its `use` lines give, each with its text: records for the compiler
to cli_files_of with cli_names, cli_texts
    set cli_made to empty list
    for each cli_k from 1 to length of cli_names
        add record with name item cli_k of cli_names, text item cli_k of cli_texts to cli_made
    end
    return cli_made
end

# the text of each file an editor has open, by its path, which moth lsp keeps (see cli_lsp_handle): read in
# place of the file on the disk, so a change not yet saved counts
set cli_open_texts to empty dictionary

# every file the program uses, and the files those use, by the names their `use` lines give: beside the file
# that uses it, or else, for one of the standard library's (json.moth, math.moth and the rest), moth's own
# copy. A file that's neither is left out: compile_machine says there is no file called that, at the line
# that uses it.
to cli_sources_of with cli_path, cli_source
    set cli_folder to cli_folder_of(cli_path)
    set cli_names to empty list
    set cli_texts to empty list
    set cli_waiting to cli_used_by(cli_source, "")
    set cli_k to 1
    repeat while cli_k is at most length of cli_waiting
        set cli_name to item cli_k of cli_waiting
        add 1 to cli_k
        if not (cli_name is in cli_names)
            set cli_text to nothing
            if (cli_folder + cli_name) is in cli_open_texts
                set cli_text to item (cli_folder + cli_name) of cli_open_texts
            else
                try
                    set cli_text to read cli_folder + cli_name
                if it fails
                    set cli_text to standard's standard_text(cli_name)
                end
            end
            if cli_text is not nothing
                add cli_name to cli_names
                add cli_text to cli_texts
                for each cli_more in cli_used_by(cli_text, cli_name)
                    add cli_more to cli_waiting
                end
            end
        end
    end
    return record with names cli_names, texts cli_texts
end

# a file's text, or nothing, with why on the error output, if it can't be read
to cli_text_of with cli_path
    try
        return read cli_path
    if it fails with cli_why
        say "moth: " + cli_why to the error output
    end
    return nothing
end

# a path without its .moth
to cli_stem with cli_path
    if length of cli_path is greater than 5 and cli_tail(cli_path, length of cli_path - 4) is ".moth"
        return cli_first(cli_path, length of cli_path - 5)
    end
    return cli_path
end

# where `moth build` puts the program it makes
to cli_out_for with cli_path, cli_target
    if cli_target is "windows"
        return cli_stem(cli_path) + ".exe"
    end
    return cli_stem(cli_path)
end

# where `moth run` puts the program it makes, for as long as it runs: beside the file, with its folder
# named even when it has none, so the system looks for it there and nowhere else
to cli_temp_for with cli_path, cli_target, cli_mark
    set cli_beside to cli_stem(cli_path) + cli_mark
    if cli_folder_of(cli_path) is ""
        set cli_beside to "./" + cli_beside
    end
    if cli_target is "windows"
        return cli_beside + ".exe"
    end
    return cli_beside
end

# whether a file is already where `moth run` or `moth test` would put its program while it runs, which would
# replace it and then remove it: if so, it says so, and nothing is built
to cli_in_the_way with cli_temp
    try
        if length of (read bytes cli_temp) is at least 0
            say "moth: there's already a file called '" + cli_temp + "', where the program would go while it runs: move it first" to the error output
            return yes
        end
    if it fails
        return no
    end
end

to cli_build with cli_path, cli_target, cli_allowing, cli_into, cli_telling
    set cli_source to cli_text_of(cli_path)
    if cli_source is nothing
        return no
    end
    return cli_build_source(cli_path, cli_source, cli_target, cli_allowing, cli_into, cli_telling, cli_name_of(cli_path))
end

# what --icon and --include name, read: the icon's bytes, and each file's name and bytes, a folder's every
# file; or nothing, said, if one can't be read
to cli_shipping
    set cli_made to record with icon nothing, names empty list, datas empty list
    try
        if icon of cli_asked is not nothing
            set icon of cli_made to read bytes icon of cli_asked
        end
        for each cli_given_path in include of cli_asked
            cli_include_path(cli_made, cli_given_path)
        end
    if it fails with cli_why
        say "moth: " + cli_why to the error output
        return nothing
    end
    return cli_made
end

to cli_include_path with cli_made, cli_path
    set cli_inside to nothing
    try
        set cli_inside to read the folder cli_path
    if it fails
        set cli_inside to nothing
    end
    if cli_inside is nothing # a file
        set cli_named to names of cli_made
        add cli_path to cli_named
        set cli_held to datas of cli_made
        add read bytes cli_path to cli_held
        return nothing
    end
    set cli_base to cli_path
    if length of cli_base is greater than 0
        set cli_end to item (length of cli_base) of cli_base
        if cli_end is not "/" and cli_end is not "\\"
            set cli_base to cli_base + "/"
        end
    end
    for each cli_entry in cli_inside
        if item (length of cli_entry) of cli_entry is "/" # a folder inside, without its /
            set cli_folder_name to ""
            for each cli_k from 1 to length of cli_entry - 1
                add item cli_k of cli_entry to cli_folder_name
            end
            cli_include_path(cli_made, cli_base + cli_folder_name)
        else
            cli_include_path(cli_made, cli_base + cli_entry)
        end
    end
end

# the same, for code that isn't quite what the file holds: the test runner adds lines at its end. Its
# mistakes say they're in `cli_program`: the file's name, or for a test its path, as the Node.js command
# line said it.
to cli_build_source with cli_path, cli_source, cli_target, cli_allowing, cli_into, cli_telling, cli_program
    set cli_used to cli_sources_of(cli_path, cli_source)
    set cli_names to names of cli_used
    set cli_texts to texts of cli_used
    set cli_shipped to cli_shipping()
    if cli_shipped is nothing
        return no
    end
    try
        set cli_bytes to machine's compile_shipping(cli_source, cli_names, cli_texts, cli_target, cli_program, cli_allowing,
            icon of cli_shipped, version of cli_asked, names of cli_shipped, datas of cli_shipped)
    if it fails with cli_why
        cli_report(cli_why, cli_path, cli_source, cli_names, cli_texts)
        return no
    end
    set cli_system to "Linux"
    if cli_target is "windows"
        set cli_system to "Windows"
    end
    try
        write cli_bytes as bytes to cli_into
    if it fails with cli_whynot
        say "moth: " + cli_whynot to the error output
        return no
    end
    if cli_telling
        say "compiled " + cli_path + " to machine code for " + cli_system + " -> " + cli_into + " (" + cli_grouped(length of cli_bytes) + " bytes)"
    end
    return yes
end

# `moth build app.moth --installer`: then app-setup.exe (app-setup on Linux), a program holding the one just
# built, which puts it where a person's own programs go, with a menu entry and a way to take it away
# (tools/installer.moth, from the standard library); --name names it there, else the file does, and
# --version and --icon are the installer's too
to cli_build_installer with cli_path, cli_target, cli_built
    set cli_app to app_name of cli_asked
    if cli_app is nothing
        set cli_app to cli_name_of(cli_stem(cli_path))
    end
    set cli_version_given to version of cli_asked
    if cli_version_given is nothing
        set cli_version_given to "1.0.0"
    end
    set cli_file_name to cli_name_of(cli_built)
    for each cli_c in cli_app + cli_version_given + cli_file_name
        if cli_c is "\"" or cli_c is "{" or cli_c is "\\"
            say "moth: an installer's name and version can't have \", { or \\ in them" to the error output
            return 1
        end
    end
    set cli_icon_name to "nothing"
    set cli_names to list of cli_file_name
    set cli_datas to empty list
    set cli_icon_bytes to nothing
    try
        add read bytes cli_built to cli_datas
        if icon of cli_asked is not nothing
            set cli_icon_bytes to read bytes icon of cli_asked
            add "icon of the program.png" to cli_names
            add cli_icon_bytes to cli_datas
            set cli_icon_name to "\"icon of the program.png\""
        end
    if it fails with cli_why
        say "moth: " + cli_why to the error output
        return 1
    end
    set cli_source to "use \"installer.moth\" as installer\ninstaller's setup(\"" + cli_app + "\", \"" + cli_version_given + "\", \"" + cli_file_name + "\", " + cli_icon_name + ")\n"
    set cli_setup_path to cli_stem(cli_path) + "-setup"
    if cli_target is "windows"
        set cli_setup_path to cli_setup_path + ".exe"
    end
    set cli_used to cli_sources_of(cli_path, cli_source)
    try
        set cli_bytes to machine's compile_shipping(cli_source, names of cli_used, texts of cli_used, cli_target, cli_name_of(cli_setup_path), (list of "--allow-all"),
            cli_icon_bytes, version of cli_asked, cli_names, cli_datas)
    if it fails with cli_why
        cli_report(cli_why, cli_path, cli_source, names of cli_used, texts of cli_used)
        return 1
    end
    try
        write cli_bytes as bytes to cli_setup_path
    if it fails with cli_whynot
        say "moth: " + cli_whynot to the error output
        return 1
    end
    say "made its installer -> " + cli_setup_path + " (" + cli_grouped(length of cli_bytes) + " bytes): run, it installs " + cli_app + " " + cli_version_given
    if not cli_signed(cli_setup_path)
        return 1
    end
    return 0
end

# --sign's command, run with the program's name after it (signtool sign /fd SHA256 /a app.exe): whether it
# went well, or there was nothing to run
to cli_signed with cli_signing
    if sign of cli_asked is nothing
        return yes
    end
    set cli_words to cli_command_words(sign of cli_asked)
    if length of cli_words is 0
        say "moth: --sign needs a command, as in --sign \"signtool sign /fd SHA256 /a\"" to the error output
        return no
    end
    set cli_sign_args to empty list
    for each cli_k from 2 to length of cli_words
        add item cli_k of cli_words to cli_sign_args
    end
    add cli_signing to cli_sign_args
    set cli_got to nothing
    try
        set cli_got to run program item 1 of cli_words with cli_sign_args keeping its output
    if it fails with cli_why
        say "moth: --sign couldn't start " + item 1 of cli_words + ": " + cli_why to the error output
        return no
    end
    if code of cli_got is not 0
        say "moth: signing " + cli_signing + " failed (" + code of cli_got + "): " + output of cli_got + mistakes of cli_got to the error output
        return no
    end
    say "signed " + cli_signing
    return yes
end

# a command's words, split at spaces, a "quoted part" one word with its spaces
to cli_command_words with cli_command_text
    set cli_words to empty list
    set cli_word to ""
    set cli_in_quotes to no
    set cli_has_word to no
    for each cli_c in cli_command_text
        if cli_c is "\""
            set cli_in_quotes to not cli_in_quotes
            set cli_has_word to yes
        else if cli_c is " " and not cli_in_quotes
            if cli_has_word
                add cli_word to cli_words
            end
            set cli_word to ""
            set cli_has_word to no
        else
            add cli_c to cli_word
            set cli_has_word to yes
        end
    end
    if cli_has_word
        add cli_word to cli_words
    end
    return cli_words
end

# `moth run file.moth a b`: the program, built into a file beside it, started with those arguments and
# this moth's own input and output, waited for, and the file removed. Gives the number it ended with, or 1
# for a mistake, or for a number this system can't end with (Windows gives a crash a huge one).
to cli_run with cli_path, cli_target, cli_allowing, cli_passed_on
    set cli_temp to cli_temp_for(cli_path, cli_target, "-run")
    if cli_in_the_way(cli_temp)
        return 1
    end
    if not cli_build(cli_path, cli_target, cli_allowing, cli_temp, no)
        return 1
    end
    return cli_run_built(cli_temp, cli_passed_on)
end

# `moth debug file.moth a b`: as moth run, with the debugger built into the program, which stops at its
# first line and takes commands from this moth's input (see moth-debugger.moth). The debugger is a file
# this moth was built with (--include moth-debugger.moth), or else one in the folder moth runs in.
to cli_debug with cli_path, cli_target, cli_allowing, cli_passed_on
    set cli_temp to cli_temp_for(cli_path, cli_target, "-debug")
    if cli_in_the_way(cli_temp)
        return 1
    end
    set cli_debugger to nothing
    try
        set cli_debugger to read "moth-debugger.moth"
    if it fails
        say "moth: debugging needs moth-debugger.moth, which this moth wasn't built with: build it with --include moth-debugger.moth" to the error output
        return 1
    end
    set cli_source to cli_text_of(cli_path)
    if cli_source is nothing
        return 1
    end
    set cli_used to cli_sources_of(cli_path, cli_source)
    set cli_names to names of cli_used
    set cli_texts to texts of cli_used
    add "moth-debugger.moth" to cli_names
    add cli_debugger to cli_texts
    try
        set cli_bytes to machine's compile_debugging(cli_source, cli_names, cli_texts, cli_target, cli_name_of(cli_path), cli_allowing)
    if it fails with cli_why
        cli_report(cli_why, cli_path, cli_source, cli_names, cli_texts)
        return 1
    end
    try
        write cli_bytes as bytes to cli_temp
    if it fails with cli_whynot
        say "moth: " + cli_whynot to the error output
        return 1
    end
    return cli_run_built(cli_temp, cli_passed_on)
end

# `moth build --web app.moth`: app.html, the playground's page in app mode with Moth's engine in it, holding the
# program and the files it uses, so it runs in a browser from the file itself or from any site
to cli_build_web with cli_path
    set cli_source to cli_text_of(cli_path)
    if cli_source is nothing
        return 1
    end
    set cli_used to cli_sources_of(cli_path, cli_source)
    set cli_names to names of cli_used
    set cli_texts to texts of cli_used
    try
        machine's read_program(cli_source, cli_files_of(cli_names, cli_texts)) # a mistake in reading it is said here
    if it fails with cli_why
        cli_report(cli_why, cli_path, cli_source, cli_names, cli_texts)
        return 1
    end
    set cli_files to empty dictionary
    for each cli_k from 1 to length of cli_names
        set item (item cli_k of cli_names) of cli_files to item cli_k of cli_texts
    end
    set cli_app to record with name cli_name_of(cli_path), source cli_source, files cli_files
    set cli_json to join (split cli_app as json by "</") with "<\\/" # nothing in it ends the page's script
    set cli_page to join (split webpage's page_text() by webpage's page_place) with cli_json
    set cli_out to cli_stem(cli_path) + ".html"
    try
        write cli_page to cli_out
    if it fails with cli_why
        say "moth: " + cli_why to the error output
        return 1
    end
    say "made " + cli_out + ", a page that runs " + cli_name_of(cli_path) + " in a browser (" + cli_grouped(length of (cli_page as bytes)) + " bytes)"
    return 0
end

# `moth build app.moth --target wasm`: app.wasm, a WebAssembly module wasm.moth makes, with what running it needs
# in a section of its own (see wasm_with_details), for runWasm in moth.js
to cli_build_wasm with cli_path
    set cli_source to cli_text_of(cli_path)
    if cli_source is nothing
        return 1
    end
    set cli_used to cli_sources_of(cli_path, cli_source)
    set cli_names to names of cli_used
    set cli_texts to texts of cli_used
    try
        set cli_made to webassembly's wasm_compile(cli_source, cli_names, cli_texts)
    if it fails with cli_why
        cli_report(cli_why, cli_path, cli_source, cli_names, cli_texts)
        return 1
    end
    set cli_bytes to webassembly's wasm_with_details(cli_made)
    set cli_out to cli_stem(cli_path) + ".wasm"
    try
        write cli_bytes as bytes to cli_out
    if it fails with cli_why
        say "moth: " + cli_why to the error output
        return 1
    end
    say "compiled " + cli_path + " to WebAssembly -> " + cli_out + " (" + cli_grouped(length of cli_bytes) + " bytes)"
    return 0
end

# `moth profile file.moth a b`: as moth run, with the profiler (moth-profiler.moth, from the standard library)
# built into the program in the debugger's place, which counts each line and says where the time went once
# the program has ended; `moth coverage`, with moth-coverage.moth there, which says which lines ran
to cli_profile with cli_path, cli_target, cli_allowing, cli_passed_on, cli_watcher
    set cli_temp to cli_temp_for(cli_path, cli_target, "-" + item 1 of split (item 2 of split cli_watcher by "-") by ".")
    if cli_in_the_way(cli_temp)
        return 1
    end
    set cli_source to cli_text_of(cli_path)
    if cli_source is nothing
        return 1
    end
    set cli_used to cli_sources_of(cli_path, cli_source)
    set cli_names to names of cli_used
    set cli_texts to texts of cli_used
    add "moth-debugger.moth" to cli_names # the profiler, or coverage, where the debugger would be
    add standard's standard_text(cli_watcher) to cli_texts
    try
        set cli_bytes to machine's compile_debugging(cli_source, cli_names, cli_texts, cli_target, cli_name_of(cli_path), cli_allowing)
    if it fails with cli_why
        cli_report(cli_why, cli_path, cli_source, cli_names, cli_texts)
        return 1
    end
    try
        write cli_bytes as bytes to cli_temp
    if it fails with cli_whynot
        say "moth: " + cli_whynot to the error output
        return 1
    end
    return cli_run_built(cli_temp, cli_passed_on)
end

# the program built into `cli_temp` started, waited for and removed: the number it ended with
to cli_run_built with cli_temp, cli_passed_on
    set cli_ended to 1
    try
        set cli_ended to run program cli_temp with cli_passed_on
    if it fails with cli_why
        say "moth: " + cli_why to the error output
    end
    try
        remove the file cli_temp
    if it fails with cli_whygone
        say "moth: " + cli_whygone to the error output
    end
    if cli_ended is less than 0 or cli_ended is greater than 255
        return 1
    end
    return cli_ended
end

# what moth runs on: Linux has /proc, Windows doesn't
to cli_host
    try
        if length of (read bytes "/proc/version") is at least 0
            return "linux"
        end
    if it fails
        return "windows"
    end
end

# --allow-read, --allow-write, --allow-net, --allow-run, --allow-libraries or --allow-all, the first three
# maybe with =names
to cli_allow_flag with cli_flag
    for each cli_kind in list of "read", "write", "net", "run", "libraries", "all"
        set cli_start to "--allow-" + cli_kind
        if cli_flag is cli_start
            return yes
        end
        if length of cli_flag is greater than length of cli_start + 1 and cli_first(cli_flag, length of cli_start + 1) is cli_start + "="
            return cli_kind is not "all" and cli_kind is not "run" and cli_kind is not "libraries"
        end
    end
    return no
end

# ---------- tidying ----------
# Moth code is written one way, and `moth tidy` writes it that way: `cli_format` is `format()` in moth.js,
# in Moth. The parser says where each statement starts and how deep it is (`layout`), and which pieces are
# written with no space after them (`tight`), so nothing is guessed; the pieces of a line come from
# `cli_pieces_of`, which reads one line as the tokenizer does but keeps every piece as it was written.

to cli_is_digit with cli_c
    return cli_c is at least "0" and cli_c is at most "9"
end

to cli_starts_word with cli_c
    return (cli_c is at least "a" and cli_c is at most "z") or (cli_c is at least "A" and cli_c is at most "Z") or cli_c is "_"
end

to cli_in_word with cli_c
    return cli_starts_word(cli_c) or cli_is_digit(cli_c)
end

# a digit of a number written after 0x or 0b
to cli_is_digit_of with cli_c, cli_mark
    if cli_mark is "b"
        return cli_c is "0" or cli_c is "1"
    end
    return cli_is_digit(cli_c) or (cli_c is at least "a" and cli_c is at most "f") or (cli_c is at least "A" and cli_c is at most "F")
end

# how many columns a piece takes, counted as JavaScript counts them: 2 for a character past the first
# 65,536, which run from the first below to the second
to cli_width_of with cli_text
    set cli_wide to 0
    for each cli_c in cli_text
        add 1 to cli_wide
        if cli_c is at least "𐀀" and cli_c is at most "􏿿"
            add 1 to cli_wide
        end
    end
    return cli_wide
end

# a text without the spaces (and other control characters) at its end
to cli_trimmed with cli_text
    set cli_upto to length of cli_text
    repeat while cli_upto is greater than 0 and item cli_upto of cli_text is at most " "
        set cli_upto to cli_upto - 1
    end
    return cli_first(cli_text, cli_upto)
end

to cli_spaces with cli_many
    set cli_room to ""
    repeat cli_many times
        add " " to cli_room
    end
    return cli_room
end

# a '{' right before one of these starts a value in text: a name, or a bracket
to cli_starts_value with cli_c
    return cli_starts_word(cli_c) or cli_c is "("
end

# Where text that starts with the quote at character cli_at ends: the character just past its closing
# quote. What follows a backslash is the text's own, even a quote, and a value in it ("Hi {name}") ends at
# its own '}', and can have text of its own inside it.
to cli_text_end with cli_chars, cli_at
    set cli_te_k to cli_at + 1
    repeat while item cli_te_k of cli_chars is not "\""
        set cli_te_c to item cli_te_k of cli_chars
        if cli_te_c is "\\"
            set cli_te_k to cli_te_k + 2
        else if cli_te_c is "{" and cli_starts_value(item (cli_te_k + 1) of cli_chars)
            set cli_te_k to cli_value_end(cli_chars, cli_te_k) + 1
        else
            add 1 to cli_te_k
        end
    end
    return cli_te_k + 1
end

# the character that ends the value in text whose '{' is character cli_at: its '}'
to cli_value_end with cli_chars, cli_at
    set cli_ve_k to cli_at + 1
    repeat while item cli_ve_k of cli_chars is not "}"
        if item cli_ve_k of cli_chars is "\""
            set cli_ve_k to cli_text_end(cli_chars, cli_ve_k)
        else
            add 1 to cli_ve_k
        end
    end
    return cli_ve_k
end

# One line of code as its pieces, as written: for each, what it is, its text, the column it starts at and
# the column just past it, counted as the parser counts columns; then the line's comment, or nothing, and
# the column that starts. Only lines the parser has read already come here, so nothing here is a mistake.
to cli_pieces_of with cli_line
    set cli_chars to split cli_line by ""
    add "" to cli_chars
    set cli_pieces to empty list
    set cli_note to nothing
    set cli_note_col to 0
    set cli_i to 1
    set cli_col to 1
    repeat while item cli_i of cli_chars is not ""
        set cli_c to item cli_i of cli_chars
        if cli_c is at most " " # every control character counts as a space
            add 1 to cli_col
            add 1 to cli_i
        else if cli_c is "#" # a comment, and the rest of the line with it
            set cli_note_col to cli_col
            set cli_note to ""
            repeat while item cli_i of cli_chars is not ""
                add item cli_i of cli_chars to cli_note
                add 1 to cli_i
            end
            set cli_note to cli_trimmed(cli_note)
        else
            set cli_start to cli_col
            set cli_text to ""
            set cli_what to cli_c
            if cli_is_digit(cli_c)
                set cli_what to "number"
                set cli_mark to item (cli_i + 1) of cli_chars
                if cli_c is "0" and (cli_mark is "x" or cli_mark is "b") and cli_is_digit_of(item (cli_i + 2) of cli_chars, cli_mark)
                    set cli_text to cli_c + cli_mark
                    set cli_i to cli_i + 2
                    repeat while cli_is_digit_of(item cli_i of cli_chars, cli_mark)
                        add item cli_i of cli_chars to cli_text
                        add 1 to cli_i
                    end
                else
                    repeat while cli_is_digit(item cli_i of cli_chars)
                        add item cli_i of cli_chars to cli_text
                        add 1 to cli_i
                    end
                    if item cli_i of cli_chars is "." and cli_is_digit(item (cli_i + 1) of cli_chars)
                        add "." to cli_text
                        add 1 to cli_i
                        repeat while cli_is_digit(item cli_i of cli_chars)
                            add item cli_i of cli_chars to cli_text
                            add 1 to cli_i
                        end
                    end
                end
            else if cli_starts_word(cli_c)
                set cli_what to "word"
                repeat while cli_in_word(item cli_i of cli_chars)
                    add item cli_i of cli_chars to cli_text
                    add 1 to cli_i
                end
            else if cli_c is "\""
                set cli_what to "string"
                set cli_end to cli_text_end(cli_chars, cli_i)
                repeat while cli_i is less than cli_end
                    add item cli_i of cli_chars to cli_text
                    add 1 to cli_i
                end
            else if cli_c is "'" # `math's sine`
                set cli_what to "'s"
                set cli_text to "'s"
                set cli_i to cli_i + 2
            else
                set cli_text to cli_c
                add 1 to cli_i
            end
            set cli_col to cli_start + cli_width_of(cli_text)
            add record with what cli_what, text cli_text, col cli_start, over cli_col to cli_pieces
        end
    end
    return record with pieces cli_pieces, note cli_note, col cli_note_col
end

# whether a piece is one the parser marked as written with no space after it
to cli_marked with cli_tight, cli_at, cli_piece
    return (cli_at + ":" + col of cli_piece) is in cli_tight
end

# The pieces of line `cli_at` joined the one way Moth writes them: a space between each, but none inside
# brackets, before a comma or 's, before a call's bracket, or after a minus that makes a number negative.
to cli_joined with cli_pieces, cli_at, cli_tight
    set cli_out to ""
    set cli_before to nothing
    for each cli_piece in cli_pieces
        set cli_close to cli_before is nothing or what of cli_before is "(" or what of cli_piece is ")" or
            what of cli_piece is "," or what of cli_piece is "'s"
        if not cli_close and what of cli_before is "-" and cli_marked(cli_tight, cli_at, cli_before)
            set cli_close to yes
        end
        if not cli_close and what of cli_piece is "(" and cli_marked(cli_tight, cli_at, cli_piece)
            set cli_close to yes
        end
        if not cli_close
            add " " to cli_out
        end
        add text of cli_piece to cli_out
        set cli_before to cli_piece
    end
    return cli_out
end

# whether a line closes a block, so a comment just before it belongs to the block instead
to cli_closes with cli_pieces
    set cli_word to lowercase of text of item 1 of cli_pieces
    if cli_word is "end" or cli_word is "else"
        return yes
    end
    if length of cli_pieces is less than 3
        return no
    end
    set cli_start_words to ""
    for each cli_which from 1 to 3
        if cli_which is greater than 1
            add " " to cli_start_words
        end
        add lowercase of text of item cli_which of cli_pieces to cli_start_words
    end
    return cli_start_words is "if it fails"
end

# every file the code says it uses, each with an empty text: only the file in front of it is tidied
to cli_empty_files with cli_source
    set cli_made to empty list
    for each cli_name in cli_used_by(cli_source, "")
        add record with name cli_name, text "" to cli_made
    end
    return cli_made
end

# Moth code, tidied: each line indented four spaces for each block it is in (and four more if it carries
# on the statement from the line before), single spaces between the pieces of a line, comments kept where
# they are, at most one blank line in a row, and one new line at the end. Code with a mistake in it can't
# be tidied: it fails as compiling it would.
to cli_format with cli_source
    set cli_read to machine's read_layout(cli_source, cli_empty_files(cli_source))
    set cli_layout to layout of cli_read
    set cli_tight to tight of cli_read
    set cli_lines to empty list
    set cli_indent to 0 # the indent of the statement being written, for the lines that carry it on
    set cli_waiting to empty list # lines with only a comment, which take the indent of the code after them
    set cli_at to 0
    for each cli_line in split cli_source by "\n"
        add 1 to cli_at
        set cli_got to cli_pieces_of(cli_line)
        set cli_pieces to pieces of cli_got
        if length of cli_pieces is 0
            if note of cli_got is not nothing
                add note of cli_got to cli_lines
                add length of cli_lines to cli_waiting
            else if length of cli_lines is greater than 0 and item (length of cli_lines) of cli_lines is not ""
                add "" to cli_lines
            end
        else
            set cli_key to cli_at + ":" + col of item 1 of cli_pieces
            set cli_here to cli_indent + 4
            if cli_key is in cli_layout
                set cli_here to (item cli_key of cli_layout) * 4
                set cli_indent to cli_here
            end
            set cli_under to cli_here # a comment just before an end, else or if it fails goes inside the block
            if cli_closes(cli_pieces)
                set cli_under to cli_here + 4
            end
            for each cli_which in cli_waiting
                set item cli_which of cli_lines to cli_spaces(cli_under) + item cli_which of cli_lines
            end
            set cli_waiting to empty list
            set cli_text to cli_spaces(cli_here) + cli_joined(cli_pieces, cli_at, cli_tight)
            if note of cli_got is not nothing
                set cli_gap to (col of cli_got) - (over of item (length of cli_pieces) of cli_pieces)
                if cli_gap is less than 1
                    set cli_gap to 1
                end
                set cli_text to cli_text + cli_spaces(cli_gap) + note of cli_got
            end
            add cli_text to cli_lines
        end
    end
    set cli_upto to length of cli_lines # no blank lines at the end, and one new line after the last
    repeat while cli_upto is greater than 0 and item cli_upto of cli_lines is ""
        set cli_upto to cli_upto - 1
    end
    set cli_out to ""
    for each cli_which from 1 to cli_upto
        add item cli_which of cli_lines to cli_out
        add "\n" to cli_out
    end
    return cli_out
end

# whether tidying kept every piece: the same pieces, of the same kinds, in the same order. A no here would
# be a bug in the tidying, never a mistake in the code.
to cli_same_pieces with cli_before, cli_after
    set cli_one to machine's read_tokens(cli_before)
    set cli_two to machine's read_tokens(cli_after)
    if length of cli_one is not length of cli_two
        return no
    end
    for each cli_which from 1 to length of cli_one
        set cli_x to item cli_which of cli_one
        set cli_y to item cli_which of cli_two
        if type of cli_x is not type of cli_y or value of cli_x is not value of cli_y
            return no
        end
    end
    return yes
end

# whether a mistake caught from the compiler is one of its own: a record that says where and why
to cli_is_problem with cli_why
    try
        if reason of cli_why is nothing
            return yes
        end
    if it fails
        return no
    end
    return yes
end

# `moth tidy file.moth`: the file tidied in place, or with --check only said to need it. Gives whether it
# is tidy now (or was already), and says what it did.
to cli_tidy_one with cli_path, cli_checking
    set cli_source to cli_text_of(cli_path)
    if cli_source is nothing
        return no
    end
    set cli_tidied to nothing
    try
        set cli_tidied to cli_format(cli_source)
    if it fails with cli_whytidy
        if cli_is_problem(cli_whytidy)
            cli_report(cli_whytidy, cli_path, cli_source, empty list, empty list)
        else
            say "moth: " + cli_path + ": " + cli_whytidy to the error output
        end
        return no
    end
    if not cli_same_pieces(cli_source, cli_tidied)
        say "moth: " + cli_path + ": tidying would have changed the code" to the error output
        return no
    end
    if cli_tidied is cli_source
        say cli_path + " is tidy"
        return yes
    end
    if cli_checking
        say cli_path + " needs tidying"
        return no
    end
    try
        write cli_tidied to cli_path
    if it fails with cli_whywrite
        say "moth: " + cli_whywrite to the error output
        return no
    end
    say "tidied " + cli_path
    return yes
end

# every file named, each tidied: 0 if they all are tidy now, 1 if any wasn't tidied
to cli_tidy_all with cli_paths, cli_checking
    set cli_wrong to 0
    for each cli_path in cli_paths
        if not cli_tidy_one(cli_path, cli_checking)
            set cli_wrong to 1
        end
    end
    return cli_wrong
end

# ---------- problems, found without running it ----------
# `moth check` finds what checker.js finds, in the same words and the same order (DESIGN §107): a name
# nothing ever sets; a line that can never run; a name set or made and never used; and what the types say.
# It works the types out as checker.js does, twice: from what's sure ("will fail"), then with what the code
# says of itself that no run checks too ("doesn't fit"). Where checker.js runs one of vm.js's checks on a
# value of each type, this looks up what that check does in checker-rules.moth, which make-checker-rules.mjs
# makes from the same rules. So it knows types and not values: a check whose outcome rests on a value written
# out (`1 / 0`, `item 0 of x`, `repeat "x" times`) it leaves to the playground's checker.

set cli_enders to dictionary where "return" is "return", "fail" is "fail", "stop" is "stop", "exit" is "stop the program"
# what an input that says what it is holds, by its place in vm.js's KINDS, and how a message says each
set cli_kind_types to list of "number", "text", "yes/no", "list", "record", "dictionary", "bytes", "function"
set cli_kind_words to list of "a number", "text", "yes or no", "a list", "a record", "a dictionary", "bytes", "a function"
set cli_measure_types to list of "distance", "time", "weight", "volume"
set cli_measure_words to list of "a distance", "a time", "a weight", "a volume"
# what `a list of` says each holds as, and what each is
set cli_item_words to dictionary where "numbers" is "number", "text" is "text", "texts" is "text", "yes or no" is "yes/no",
    "lists" is "list", "records" is "record", "dictionaries" is "dictionary", "bytes" is "bytes", "functions" is "function"
# checker-rules.moth's lines, as a dictionary, and its messages, made the first time they're wanted
set cli_rules_kept to record with cached nothing, messages nothing
# the letter checker-rules.moth writes each type as
set cli_type_codes to dictionary where "number" is "n", "text" is "t", "yes/no" is "y", "nothing" is "0", "list" is "l", "record" is "r",
    "dictionary" is "d", "bytes" is "b", "distance" is "D", "time" is "T", "weight" is "W", "volume" is "V"

to cli_rules
    if cached of cli_rules_kept is nothing
        set cli_table to empty dictionary
        for each cli_line in split checker_rules's rules_text() by "\n"
            set cli_cut to position of "=" in cli_line
            if cli_cut is greater than 0
                set item (cli_first(cli_line, cli_cut - 1)) of cli_table to cli_tail(cli_line, cli_cut + 1)
            end
        end
        set messages of cli_rules_kept to split checker_rules's messages_text() by "\n"
        set cached of cli_rules_kept to cli_table
    end
    return cached of cli_rules_kept
end

# whether a text starts with another
to cli_begins_with with cli_text, cli_start
    if length of cli_text is less than length of cli_start
        return no
    end
    return (items 1 to length of cli_start of cli_text) is cli_start
end

to cli_finishes_with with cli_text, cli_end
    set cli_n to length of cli_text - length of cli_end
    if cli_n is less than 0
        return no
    end
    return (items cli_n + 1 to length of cli_text of cli_text) is cli_end
end

# ----- types, as checker.js has them -----
# A type is text: "number", "text", "record"..., or "record:dog", a record the kind dog makes, or "list:number",
# a list whose every item is a number. nothing means nothing known yet, and "?" could be several.

to cli_base_type with cli_t
    if cli_t is nothing or cli_t is "?" or not (":" is in cli_t)
        return cli_t
    end
    if cli_begins_with(cli_t, "record:")
        return "record"
    end
    if cli_begins_with(cli_t, "list:")
        return "list"
    end
    return cli_t
end

# what each item of a list of this type is, or "?" if that isn't known
to cli_holds with cli_t
    if cli_t is not nothing and cli_t is not "?" and ":" is in cli_t and cli_begins_with(cli_t, "list:")
        return cli_tail(cli_t, 6)
    end
    return "?"
end

to cli_join with cli_a, cli_b
    if cli_a is nothing
        return cli_b
    end
    if cli_b is nothing or cli_a is cli_b
        return cli_a
    end
    if cli_a is "?" or cli_b is "?" or cli_base_type(cli_a) is not cli_base_type(cli_b)
        return "?"
    end
    if cli_base_type(cli_a) is "list"
        set cli_items to cli_join(cli_holds(cli_a), cli_holds(cli_b))
        if cli_items is "?"
            return "list"
        end
        return "list:" + cli_items
    end
    return cli_base_type(cli_a)
end

to cli_known_type with cli_t
    return cli_t is not nothing and cli_t is not "?" and cli_base_type(cli_t) is not "function"
end

to cli_plural with cli_name
    set cli_n to length of cli_name
    if cli_n is greater than 1 and item cli_n of cli_name is "y" and not (item (cli_n - 1) of cli_name is in "aeiou")
        return cli_first(cli_name, cli_n - 1) + "ies"
    end
    if cli_finishes_with(cli_name, "s") or cli_finishes_with(cli_name, "x") or cli_finishes_with(cli_name, "z") or cli_finishes_with(cli_name, "ch") or cli_finishes_with(cli_name, "sh")
        return cli_name + "es"
    end
    return cli_name + "s"
end

# a type as a message says it: "a number", "text", "a dog", "a list of numbers"
to cli_described with cli_t
    if cli_begins_with(cli_t, "record:")
        set cli_name to cli_tail(cli_t, 8)
        if cli_first(cli_name, 1) is in "aeiou"
            return "an " + cli_name
        end
        return "a " + cli_name
    end
    if cli_begins_with(cli_t, "list:")
        return "a list of " + cli_each_word(cli_tail(cli_t, 6))
    end
    for each cli_k from 1 to 4
        if item cli_k of cli_measure_types is cli_t
            return item cli_k of cli_measure_words
        end
    end
    for each cli_k from 1 to 8
        if item cli_k of cli_kind_types is cli_t and cli_k is not 2 and cli_k is not 3 and cli_k is not 7
            return item cli_k of cli_kind_words
        end
    end
    return cli_t
end

# the items of a list of this type, as `a list of` says them: "numbers", "dogs", "lists of numbers"
to cli_each_word with cli_t
    if cli_begins_with(cli_t, "record:")
        return cli_plural(cli_tail(cli_t, 8))
    end
    if cli_begins_with(cli_t, "list:")
        return "lists of " + cli_each_word(cli_tail(cli_t, 6))
    end
    for each cli_k from 1 to 4
        if item cli_k of cli_measure_types is cli_t
            return cli_plural(cli_t)
        end
    end
    set cli_words to dictionary where "number" is "numbers", "yes/no" is "yes or no", "list" is "lists", "record" is "records",
        "dictionary" is "dictionaries", "function" is "functions"
    if cli_t is in cli_words
        return item cli_t of cli_words
    end
    return cli_t
end

# ----- the checker's state -----

to cli_new_state
    return record with found empty list, made empty dictionary, used empty dictionary, scopes 0, sources empty dictionary,
        sure empty dictionary, said empty dictionary, mode "sure", checks empty list, defines empty dictionary,
        declared empty dictionary, gives empty list, kinds empty dictionary, makers empty dictionary, fields_set empty dictionary,
        unknown_kinds empty dictionary, rulebook cli_rules(), places empty dictionary
end

# Where a variable, an input or what a function gives is made, so moth lsp can say its type once they're all
# worked out: its file, line and column, and what it is there ("set", "input w" or "gives"), to its key.
to cli_note_place with cli_state, cli_at, cli_what, cli_key
    if cli_key is not nothing
        set item (file of cli_at + ":" + line of cli_at + ":" + col of cli_at + " " + cli_what) of (places of cli_state) to cli_key
    end
end

# a problem found: where it is, what kind it is ("fails", "doesn't fit", "never runs" or "unused"), and what to say
to cli_note_problem with cli_state, cli_at, cli_kind, cli_message
    if cli_kind is "unused" and file of cli_at is not ""
        return nothing # a file the program uses can make more than this program needs
    end
    set cli_list to found of cli_state
    add record with line line of cli_at, col col of cli_at, file file of cli_at, kind cli_kind, message cli_message to cli_list
end

# which variable a name means here, as a key of its own: which scope has it, and which of its slots it is
to cli_key_for with cli_frame, cli_wanted
    set cli_known_keys to keys_known of cli_frame
    if cli_wanted is in cli_known_keys
        return item cli_wanted of cli_known_keys
    end
    set cli_found to machine's read_resolve(scope of cli_frame, cli_wanted)
    set cli_key to nothing
    if cli_found is not nothing
        set cli_owner to cli_frame
        repeat depth of cli_found times
            set cli_owner to outer of cli_owner
        end
        set cli_key to (id of cli_owner) + ":" + slot of cli_found
    end
    set item cli_wanted of cli_known_keys to cli_key
    return cli_key
end

# one more way a variable gets its value, worked out once the others' are known: a record whose `how` says how
to cli_add_source with cli_state, cli_key, cli_how
    set cli_all to sources of cli_state
    if not (cli_key is in cli_all)
        set item cli_key of cli_all to empty list
    end
    set cli_list to item cli_key of cli_all
    add cli_how to cli_list
end

to cli_slot_type with cli_state, cli_key
    set cli_types to sure of cli_state
    if mode of cli_state is "said"
        set cli_types to said of cli_state
    end
    if cli_key is in cli_types
        return item cli_key of cli_types
    end
    return nothing
end

# a function (or the program, or an app's handler) being checked: its scope, the define it is (or nothing),
# and what its returns give
to cli_new_frame with cli_state, cli_outer, cli_params, cli_body, cli_order, cli_def
    set cli_scope to nothing
    if cli_outer is not nothing
        set cli_scope to scope of cli_outer
    end
    set cli_id to scopes of cli_state
    set scopes of cli_state to cli_id + 1
    return record with scope machine's read_scope(cli_scope, cli_params, cli_body, cli_order), id cli_id, outer cli_outer, def cli_def,
        skipped 0, returns empty list, ends_open no, return_key "returns " + cli_id, name "", keys_known empty dictionary
end

# checks a function's body in a frame of its own, as checker.js's Checker does
to cli_check_function with cli_state, cli_outer, cli_name, cli_params, cli_body, cli_order, cli_def
    set cli_frame to cli_new_frame(cli_state, cli_outer, cli_params, cli_body, cli_order, cli_def)
    set name of cli_frame to cli_name
    for each cli_k from 1 to length of cli_params
        set cli_kind to -1
        if cli_def is not nothing and cli_k is at most length of kinds of cli_def
            set cli_kind to item cli_k of kinds of cli_def
        end
        set cli_type to "?"
        if cli_kind is at least 0
            set cli_type to item (cli_kind + 1) of cli_kind_types
        end
        set cli_key to cli_key_for(cli_frame, item cli_k of cli_params)
        cli_add_source(cli_state, cli_key, record with how "fixed", type cli_type)
        if cli_def is not nothing
            cli_note_place(cli_state, at of cli_def, "input " + lowercase of item cli_k of cli_params, cli_key)
        end
        if cli_def is not nothing and types of cli_def is not nothing
            if item cli_k of types of cli_def is not nothing
                set item cli_key of (declared of cli_state) to record with words item cli_k of types of cli_def, at at of cli_def
            end
        end
    end
    if cli_def is not nothing and gives of cli_def is not nothing
        set cli_gives to gives of cli_state
        add cli_def to cli_gives
    end
    cli_check_block(cli_state, cli_frame, cli_body)
    set ends_open of cli_frame to not cli_ends_block(cli_body)
    set cli_returns to returns of cli_frame
    if ends_open of cli_frame
        add (record with how "fixed", type "nothing") to cli_returns
    end
    set item (return_key of cli_frame) of (sources of cli_state) to cli_returns
    if cli_def is not nothing and gives of cli_def is not nothing and ends_open of cli_frame
        cli_type_check(cli_state, at of cli_def, record with how "end", frame cli_frame)
    end
    return cli_frame
end

# whether a block can't reach its end: its last statement returns, fails or stops the program, or is an if
# whose every way does
to cli_ends_block with cli_body
    if length of cli_body is 0
        return no
    end
    set cli_last to item (length of cli_body) of cli_body
    set cli_what to kind of cli_last
    if cli_what is "return" or cli_what is "fail" or cli_what is "exit"
        return yes
    end
    if cli_what is "if"
        return cli_ends_block(then of cli_last) and cli_ends_block(otherwise of cli_last)
    end
    return no
end

# ----- what an expression is -----

to cli_type_of with cli_state, cli_frame, cli_e
    set cli_what to kind of cli_e
    if cli_what is "value"
        set cli_t to type of cli_e
        if cli_t is "string"
            return "text"
        else if cli_t is "yes" or cli_t is "no"
            return "yes/no"
        end
        return cli_t
    else if cli_what is "name"
        set cli_key to cli_key_for(cli_frame, name of cli_e)
        if cli_key is nothing
            return "?"
        end
        return cli_slot_type(cli_state, cli_key)
    else if cli_what is "math"
        set cli_a to cli_base_type(cli_type_of(cli_state, cli_frame, left of cli_e))
        set cli_b to cli_base_type(cli_type_of(cli_state, cli_frame, right of cli_e))
        if cli_a is nothing or cli_b is nothing
            return nothing
        end
        if op of cli_e is "+" and (cli_a is "text" or cli_b is "text")
            return "text"
        end
        if not cli_known_type(cli_a) or not cli_known_type(cli_b)
            return "?"
        end
        set cli_key to "type|" + op of cli_e + "|" + item cli_a of cli_type_codes + item cli_b of cli_type_codes
        if cli_key is in rulebook of cli_state
            return item cli_key of rulebook of cli_state
        end
        return "?"
    else if cli_what is "compare" or cli_what is "not"
        return "yes/no"
    else if cli_what is "negate"
        set cli_t to cli_base_type(cli_type_of(cli_state, cli_frame, operand of cli_e))
        if cli_t is nothing or cli_t is "?" or cli_t is in cli_measure_types
            return cli_t
        end
        return "number"
    else if cli_what is "length" or cli_what is "random"
        return "number"
    else if cli_what is "now" # the time, the date and the weekday are text; the rest are numbers
        if which of cli_e is 0 or which of cli_e is 1 or which of cli_e is 8
            return "text"
        end
        return "number"
    else if cli_what is "builtin"
        if name of cli_e is "unit" or name of cli_e is "in" # `5 km`, `trip in miles`
            return item ("unit|" + value of item 2 of args of cli_e) of rulebook of cli_state
        end
        set cli_key to "gives|" + name of cli_e
        if cli_key is in rulebook of cli_state
            return item cli_key of rulebook of cli_state
        end
        return "?"
    else if cli_what is "ask"
        return "text"
    else if cli_what is "read"
        if binary of cli_e
            return "bytes"
        end
        return "text"
    else if cli_what is "arguments" or cli_what is "readFolder" or cli_what is "list"
        return "list"
    else if cli_what is "record"
        return "record"
    else if cli_what is "dictionary"
        return "dictionary"
    else if cli_what is "field"
        return cli_field_type(cli_state, cli_type_of(cli_state, cli_frame, subject of cli_e), name of cli_e)
    else if cli_what is "item" # where the code says what a list holds, an item of it is that
        set cli_of to cli_type_of(cli_state, cli_frame, subject of cli_e)
        if cli_of is nothing
            return nothing
        end
        if mode of cli_state is "said"
            return cli_holds(cli_of)
        end
        return "?"
    else if cli_what is "call"
        return cli_call_type(cli_state, cli_frame, cli_e)
    end
    return "?"
end

# the function a call's name means, where it's one made exactly once and never anything else, or nothing
to cli_only_define with cli_state, cli_key
    if cli_key is nothing or not (cli_key is in defines of cli_state)
        return nothing
    end
    set cli_made to item cli_key of defines of cli_state
    if length of cli_made is not 1 or length of item cli_key of sources of cli_state is not 1
        return nothing
    end
    return item 1 of cli_made
end

# what a call gives: what a kind makes, or what a function returns; and where the code is taken at its word,
# what its `gives` says
to cli_call_type with cli_state, cli_frame, cli_e
    set cli_made to cli_only_define(cli_state, cli_key_for(cli_frame, name of cli_e))
    if cli_made is nothing
        return "?"
    end
    set cli_d to define of cli_made
    if made_kind of cli_d is not nothing
        return "record:" + made_kind of cli_d
    end
    if mode of cli_state is "said" and gives of cli_d is not nothing
        set cli_said to cli_type_named(cli_state, gives of cli_d, at of cli_d)
        if cli_begins_with(cli_said, "maybe:")
            return "?"
        end
        return cli_said
    end
    return cli_slot_type(cli_state, return_key of frame of cli_made)
end

# the kind a kind is made from (`kind puppy with name from dog(name)`), or nothing
to cli_parent_kind with cli_state, cli_kind
    if cli_kind is nothing or parent of cli_kind is nothing or not (parent of cli_kind is in makers of cli_state)
        return nothing
    end
    return item (parent of cli_kind) of makers of cli_state
end

to cli_kind_named with cli_state, cli_name
    if cli_name is nothing or not (cli_name is in kinds of cli_state)
        return nothing
    end
    return item cli_name of kinds of cli_state
end

# what field `name` of a value of type `of` is: for a record a kind makes, what the kind's input says it is
to cli_field_type with cli_state, cli_of, cli_name
    if cli_of is nothing
        return nothing
    end
    if cli_of is "?" or not cli_begins_with(cli_of, "record:")
        return "?"
    end
    set cli_kind to cli_kind_named(cli_state, cli_tail(cli_of, 8))
    if cli_kind is nothing or cli_name is in fields_set of cli_state
        return "?"
    end
    if cli_name is "kind"
        return "text"
    end
    set cli_seen to 0
    repeat while cli_kind is not nothing and cli_seen is less than 100
        set cli_d to define of cli_kind
        for each cli_k from 1 to length of params of cli_d
            if item cli_k of params of cli_d is cli_name
                set cli_input_kind to item cli_k of kinds of cli_d
                if cli_input_kind is less than 0
                    return "?"
                end
                if mode of cli_state is "said" and types of cli_d is not nothing
                    if item cli_k of types of cli_d is not nothing
                        return cli_type_named(cli_state, item cli_k of types of cli_d, at of cli_d)
                    end
                end
                return item (cli_input_kind + 1) of cli_kind_types
            end
        end
        if cli_name is in owns of cli_kind
            return "function"
        end
        set cli_kind to cli_kind_named(cli_state, cli_parent_kind(cli_state, cli_kind))
        add 1 to cli_seen
    end
    return "?"
end

# every field a record the kind makes has, in the order it has them, or nothing if that can't be known
to cli_fields_of with cli_state, cli_name, cli_seen
    set cli_kind to cli_kind_named(cli_state, cli_name)
    if cli_kind is nothing or cli_name is in cli_seen
        return nothing
    end
    set item cli_name of cli_seen to yes
    set cli_body to body of define of cli_kind
    set cli_start to value of item 1 of cli_body
    set cli_fields to nothing
    if kind of cli_start is "record"
        set cli_fields to empty list
        for each cli_f in fields of cli_start
            add cli_f to cli_fields
        end
    else if cli_parent_kind(cli_state, cli_kind) is not nothing
        set cli_fields to cli_fields_of(cli_state, cli_parent_kind(cli_state, cli_kind), cli_seen)
    end
    if cli_fields is nothing
        return nothing
    end
    for each cli_k from 2 to length of cli_body
        set cli_s to item cli_k of cli_body
        if kind of cli_s is "setField" and not (name of cli_s is in cli_fields)
            add name of cli_s to cli_fields
        end
    end
    return cli_fields
end

# The type an input's `as`, or a `gives`, names, as written: "a number", "a dog", "a list of numbers", "a dog or
# nothing". A kind it names that the program doesn't make is said to be wrong, at `at`, once.
to cli_type_named with cli_state, cli_words, cli_at
    if cli_words is "nothing"
        return cli_words
    end
    if cli_finishes_with(cli_words, " or nothing") # "maybe:" before what it is when it isn't nothing
        set cli_inner to cli_type_named(cli_state, cli_first(cli_words, length of cli_words - 11), cli_at)
        if cli_inner is "nothing"
            return cli_inner
        end
        return "maybe:" + cli_inner
    end
    for each cli_k from 1 to 8
        if item cli_k of cli_kind_words is cli_words
            return item cli_k of cli_kind_types
        end
    end
    if cli_begins_with(cli_words, "a list of ")
        set cli_items to cli_items_named(cli_state, cli_tail(cli_words, 11), cli_at)
        if cli_items is "?"
            return "list"
        end
        return "list:" + cli_items
    end
    set cli_name to cli_words
    if cli_begins_with(cli_name, "an ")
        set cli_name to cli_tail(cli_name, 4)
    else if cli_begins_with(cli_name, "a ")
        set cli_name to cli_tail(cli_name, 3)
    end
    set cli_found to cli_kind_type(cli_state, cli_name, cli_at, no)
    if cli_found is "?"
        return "record"
    end
    return cli_found
end

to cli_items_named with cli_state, cli_words, cli_at
    if cli_begins_with(cli_words, "lists of ")
        set cli_items to cli_items_named(cli_state, cli_tail(cli_words, 10), cli_at)
        if cli_items is "?"
            return "list"
        end
        return "list:" + cli_items
    end
    if cli_words is in cli_item_words
        return item cli_words of cli_item_words
    end
    return cli_kind_type(cli_state, cli_words, cli_at, yes)
end

# "record:dog", for a kind the program makes called `name` (or, `many`, that `name` is more than one of:
# dogs, boxes, puppies), or "?", having said there's none
to cli_kind_type with cli_state, cli_name, cli_at, cli_many
    set cli_tried to list of cli_name
    if cli_many
        set cli_tried to list of cli_name, cli_cut_end(cli_name, "s", ""), cli_cut_end(cli_name, "es", ""), cli_cut_end(cli_name, "ies", "y")
    end
    for each cli_one in cli_tried
        if cli_one is in kinds of cli_state
            return "record:" + cli_one
        end
    end
    set cli_mark to line of cli_at + ":" + col of cli_at + ":" + cli_name
    if not (cli_mark is in unknown_kinds of cli_state)
        set item cli_mark of (unknown_kinds of cli_state) to yes
        set cli_names to empty list
        for each cli_k in kinds of cli_state
            add cli_k to cli_names
        end
        set cli_guess to machine's read_closest(item (length of cli_tried) of cli_tried, cli_names)
        if cli_guess is nothing
            set cli_guess to machine's read_closest(cli_name, cli_names)
        end
        set cli_said to "there is no kind called '" + cli_name + "'"
        if cli_guess is not nothing
            set cli_said to cli_said + ". Did you mean '" + cli_guess + "'?"
        end
        cli_note_problem(cli_state, cli_at, "doesn't fit", cli_said)
    end
    return "?"
end

# a text with `end` at its end taken off and `instead` put there, or the text as it was if it doesn't end so
to cli_cut_end with cli_text, cli_end, cli_instead
    if not cli_finishes_with(cli_text, cli_end)
        return cli_text
    end
    return cli_first(cli_text, length of cli_text - length of cli_end) + cli_instead
end

# whether a value of type `t` is what `wanted` (a type cli_type_named made) says: yes, no, or nothing if that
# can't be known
to cli_fits_type with cli_state, cli_t, cli_wanted
    if cli_t is nothing or cli_t is "?" or cli_wanted is nothing or cli_wanted is "?"
        return nothing
    end
    if cli_begins_with(cli_wanted, "maybe:")
        if cli_t is "nothing"
            return yes
        end
        return cli_fits_type(cli_state, cli_t, cli_tail(cli_wanted, 7))
    end
    if cli_base_type(cli_t) is not cli_base_type(cli_wanted)
        return no
    end
    if cli_begins_with(cli_wanted, "record:")
        if not cli_begins_with(cli_t, "record:")
            return nothing
        end
        set cli_k to cli_tail(cli_t, 8)
        set cli_seen to 0
        repeat while cli_k is not nothing and cli_seen is less than 100
            if cli_k is cli_tail(cli_wanted, 8)
                return yes
            end
            set cli_k to cli_parent_kind(cli_state, cli_kind_named(cli_state, cli_k))
            add 1 to cli_seen
        end
        return no
    end
    if cli_begins_with(cli_wanted, "list:")
        if cli_begins_with(cli_t, "list:")
            return cli_fits_type(cli_state, cli_tail(cli_t, 6), cli_tail(cli_wanted, 6))
        end
        return nothing
    end
    return yes
end

# ----- the checks -----

# a check to make once the types are known: on what's sure, then on what the code says too
to cli_will_fail with cli_state, cli_frame, cli_at, cli_check
    if skipped of cli_frame is greater than 0
        return nothing
    end
    set at of cli_check to cli_at
    set frame of cli_check to cli_frame
    set sort of cli_check to "will fail"
    set cli_list to checks of cli_state
    add cli_check to cli_list
end

# a check of what the code says of itself, which no run makes: never "will fail"
to cli_type_check with cli_state, cli_at, cli_check
    set at of cli_check to cli_at
    set sort of cli_check to "fit"
    set cli_list to checks of cli_state
    add cli_check to cli_list
end

# a check of one of checker.js's RULES at `at`, on the values of `operands`, once each one's type is known
to cli_rule with cli_state, cli_frame, cli_at, cli_name, cli_args, cli_operands
    cli_will_fail(cli_state, cli_frame, cli_at, record with how "rule", name cli_name, args cli_args, operands cli_operands, at nothing,
        frame nothing, sort nothing)
end

# whether an expression is a value written out: a number, text, yes, no or nothing, or a number with a - before it
to cli_written with cli_e
    if kind of cli_e is "value"
        return yes
    end
    return kind of cli_e is "negate" and kind of operand of cli_e is "value" and type of operand of cli_e is "number"
end

# What rule `name` does on values of these types, as checker-rules.moth has it: the message, or nothing. A rule
# whose outcome rests on a value written out gives "" instead: moth check leaves it out.
to cli_apply with cli_state, cli_name, cli_args, cli_operands, cli_types
    set cli_key to cli_name
    set cli_named to nothing
    for each cli_arg in cli_args
        if cli_name is "add" or cli_name is "setField" or cli_name is "field"
            set cli_named to cli_arg
            set cli_key to cli_key + "|@NAME@"
        else
            set cli_key to cli_key + "|" + cli_arg
        end
    end
    set cli_key to cli_key + "|"
    for each cli_t in cli_types
        set cli_key to cli_key + item (cli_base_type(cli_t)) of cli_type_codes
    end
    if not (cli_key is in rulebook of cli_state)
        return nothing
    end
    set cli_rule_said to item cli_key of rulebook of cli_state
    set cli_bar to position of "|" in cli_rule_said
    set cli_number to cli_tail(cli_rule_said, cli_bar + 1)
    if cli_number is ""
        return nothing
    end
    set cli_message to item (number of cli_number) of messages of cli_rules_kept
    for each cli_k from 1 to length of cli_operands
        if cli_written(item cli_k of cli_operands) and ("" + cli_k) is in cli_first(cli_rule_said, cli_bar - 1)
            return ""
        end
    end
    if cli_named is not nothing
        set cli_message to join (split cli_message by "@NAME@") with cli_named
    end
    return cli_message
end

# the turtle's actions, in vm.js's order, by name: what the rules call each
to cli_action_number with cli_state, cli_action
    set cli_n to 0
    for each cli_a in split item "actions" of rulebook of cli_state by "|"
        if cli_a is cli_action
            return cli_n
        end
        add 1 to cli_n
    end
    return -1
end

# runs one check in the mode the state is in: the message it fails with, "" for one moth check leaves out, or
# nothing if it doesn't fail
to cli_run_check with cli_state, cli_c
    set cli_how to how of cli_c
    set cli_frame to frame of cli_c
    if cli_how is "rule"
        set cli_types to empty list
        for each cli_e in operands of cli_c
            set cli_t to cli_type_of(cli_state, cli_frame, cli_e)
            if not cli_known_type(cli_t)
                return nothing
            end
            add cli_t to cli_types
        end
        return cli_apply(cli_state, name of cli_c, args of cli_c, operands of cli_c, cli_types)
    else if cli_how is "list add" # what the code says a list holds is all it gets
        set cli_current to cli_slot_type(cli_state, key of cli_c)
        set cli_v to cli_type_of(cli_state, cli_frame, value of cli_c)
        if cli_known_type(cli_current) and cli_known_type(cli_v) and cli_holds(cli_current) is not "?" and cli_fits_type(cli_state, cli_v, cli_holds(cli_current)) is no
            return "can't add " + cli_described(cli_v) + " to " + cli_described(cli_current)
        end
    else if cli_how is "play"
        set cli_note to cli_type_of(cli_state, cli_frame, note of cli_c)
        set cli_time to cli_type_of(cli_state, cli_frame, time of cli_c)
        if not cli_known_type(cli_note)
            return nothing
        end
        if not cli_known_type(cli_time)
            return cli_apply(cli_state, "note", empty list, (list of note of cli_c), (list of cli_note))
        end
        return cli_apply(cli_state, "play", (list of unit of cli_c), (list of note of cli_c, time of cli_c), (list of cli_note, cli_time))
    else if cli_how is "field"
        set cli_t to cli_type_of(cli_state, cli_frame, subject of cli_c)
        if not cli_known_type(cli_t)
            return nothing
        end
        if cli_base_type(cli_t) is not "record"
            return cli_apply(cli_state, "field", (list of name of cli_c), (list of subject of cli_c), (list of cli_t))
        end
        if cli_begins_with(cli_t, "record:") # a record a kind makes has the fields the kind gives it, unless something adds one
            set cli_fields to cli_fields_of(cli_state, cli_tail(cli_t, 8), empty dictionary)
            if cli_fields is not nothing and not (name of cli_c is in cli_fields) and not (name of cli_c is in fields_set of cli_state)
                return cli_no_field(name of cli_c, cli_fields)
            end
        end
    else if cli_how is "item"
        set cli_t to cli_type_of(cli_state, cli_frame, subject of cli_c)
        if not cli_known_type(cli_t)
            return nothing
        end
        set cli_t to cli_base_type(cli_t)
        if cli_t is not "list" and cli_t is not "text" and cli_t is not "bytes"
            return cli_apply(cli_state, "item", empty list, (list of subject of cli_c), (list of cli_t))
        end
    else if cli_how is "call"
        return cli_call_check(cli_state, cli_frame, call of cli_c)
    else if cli_how is "return"
        set cli_t to "nothing"
        if value of cli_c is not nothing
            set cli_t to cli_type_of(cli_state, cli_frame, value of cli_c)
        end
        set cli_d to def of cli_frame
        if cli_fits_type(cli_state, cli_t, cli_type_named(cli_state, gives of cli_d, at of cli_d)) is no
            return "'" + name of cli_frame + "' must give " + gives of cli_d + ", not " + cli_described(cli_t)
        end
    else if cli_how is "end"
        set cli_d to def of cli_frame
        set cli_wanted to cli_type_named(cli_state, gives of cli_d, at of cli_d)
        if cli_wanted is not "nothing" and not cli_begins_with(cli_wanted, "maybe:")
            return "'" + name of cli_frame + "' must give " + gives of cli_d + ", but it can reach its end without giving anything"
        end
    end
    return nothing
end

to cli_no_field with cli_name, cli_fields
    set cli_guess to machine's read_closest(cli_name, cli_fields)
    if cli_guess is nothing
        return "this record has no '" + cli_name + "'"
    end
    return "this record has no '" + cli_name + "'. Did you mean '" + cli_guess + "'?"
end

# a call, as checker.js's call() checks it: a name that isn't a function; then, where it's a function made once,
# how many inputs it gets, and what kind each input says it is; then what each says beyond that; then a
# record's own function a kind doesn't give
to cli_call_check with cli_state, cli_frame, cli_e
    set cli_key to cli_key_for(cli_frame, name of cli_e)
    set cli_type to cli_slot_type(cli_state, cli_key)
    if cli_known_type(cli_type)
        return "'" + name of cli_e + "' is " + cli_described(cli_base_type(cli_type)) + ", not a function"
    end
    set cli_types to empty list
    for each cli_arg in args of cli_e
        add cli_type_of(cli_state, cli_frame, cli_arg) to cli_types
    end
    set cli_made to cli_only_define(cli_state, cli_key)
    if cli_type is "function" and cli_made is not nothing
        set cli_d to define of cli_made
        set cli_n to length of params of cli_d
        if length of args of cli_e is not cli_n
            set cli_inputs to "inputs"
            if cli_n is 1
                set cli_inputs to "input"
            end
            return "'" + name of cli_e + "' needs " + cli_n + " " + cli_inputs + " but got " + length of args of cli_e
        end
        for each cli_k from 1 to length of kinds of cli_d
            set cli_kind to item cli_k of kinds of cli_d
            set cli_t to item cli_k of cli_types
            if cli_kind is at least 0 and cli_t is not nothing and cli_t is not "?"
                if cli_base_type(cli_t) is not item (cli_kind + 1) of cli_kind_types
                    return "'" + name of cli_e + "' needs " + item cli_k of params of cli_d + " to be " + item (cli_kind + 1) of cli_kind_words + ", not " + cli_described(cli_base_type(cli_t))
                end
            end
        end
        if mode of cli_state is "said" and types of cli_d is not nothing
            for each cli_k from 1 to length of types of cli_d
                set cli_words to item cli_k of types of cli_d
                if cli_words is not nothing
                    if cli_fits_type(cli_state, item cli_k of cli_types, cli_type_named(cli_state, cli_words, at of cli_d)) is no
                        return "'" + name of cli_e + "' needs " + item cli_k of params of cli_d + " to be " + cli_words + ", not " + cli_described(item cli_k of cli_types)
                    end
                end
            end
        end
    end
    # `rex's speak()`, where rex is surely a dog: dog has no speak, and nothing gives a record one (see own_calls in compiler.moth)
    if cli_key is nothing or not (cli_key is in defines of cli_state) or length of cli_types is 0
        return nothing
    end
    set cli_helper to define of item 1 of item cli_key of defines of cli_state
    if length of params of cli_helper is 0 or length of body of cli_helper is 0
        return nothing
    end
    set cli_tried to item 1 of body of cli_helper
    if item 1 of params of cli_helper is not "the record" or kind of cli_tried is not "try"
        return nothing
    end
    set cli_t to item 1 of cli_types
    if cli_t is nothing or cli_t is "?" or not cli_begins_with(cli_t, "record:")
        return nothing
    end
    set cli_own to name of item 1 of body of cli_tried
    set cli_fields to cli_fields_of(cli_state, cli_tail(cli_t, 8), empty dictionary)
    if cli_fields is not nothing and not (cli_own is in cli_fields) and not (cli_own is in fields_set of cli_state)
        return value of value of item 1 of handler of cli_tried
    end
    return nothing
end

# ----- walking the program, as checker.js does -----

# a name used here: whether anything sets it, and if nothing does, that it will fail
to cli_use_name with cli_state, cli_frame, cli_wanted, cli_at, cli_call, cli_statement
    set cli_key to cli_key_for(cli_frame, cli_wanted)
    if cli_key is nothing
        if skipped of cli_frame is 0 # inside the right side of and or or, which may never run
            cli_note_problem(cli_state, cli_at, "fails", machine's read_undefined(scope of cli_frame, cli_wanted, cli_call, cli_statement))
        end
        return no
    end
    set item cli_key of (used of cli_state) to yes
    return yes
end

# a name this scope sets or makes, which may turn out to be used nowhere
to cli_made_name with cli_state, cli_key, cli_at, cli_message
    set cli_table to made of cli_state
    if cli_key is not nothing and not (cli_key is in cli_table)
        set item cli_key of cli_table to record with at cli_at, message cli_message
    end
end

to cli_check_each with cli_state, cli_frame, cli_nodes
    for each cli_node in cli_nodes
        cli_check_expr(cli_state, cli_frame, cli_node)
    end
end

to cli_check_call with cli_state, cli_frame, cli_e, cli_statement
    if not cli_use_name(cli_state, cli_frame, name of cli_e, at of cli_e, yes, cli_statement)
        return nothing
    end
    cli_check_each(cli_state, cli_frame, args of cli_e)
    cli_will_fail(cli_state, cli_frame, at of cli_e, record with how "call", call cli_e, at nothing, frame nothing, sort nothing)
end

to cli_check_expr with cli_state, cli_frame, cli_e
    if cli_e is nothing
        return nothing
    end
    set cli_what to kind of cli_e
    if cli_what is "name"
        cli_use_name(cli_state, cli_frame, name of cli_e, at of cli_e, no, no)
    else if cli_what is "call"
        cli_check_call(cli_state, cli_frame, cli_e, no)
    else if cli_what is "and" or cli_what is "or"
        cli_check_expr(cli_state, cli_frame, left of cli_e)
        set skipped of cli_frame to skipped of cli_frame + 1
        cli_check_expr(cli_state, cli_frame, right of cli_e)
        set skipped of cli_frame to skipped of cli_frame - 1
    else if cli_what is "math"
        cli_check_expr(cli_state, cli_frame, left of cli_e)
        cli_check_expr(cli_state, cli_frame, right of cli_e)
        cli_rule(cli_state, cli_frame, at of cli_e, "math", (list of op of cli_e), (list of left of cli_e, right of cli_e))
    else if cli_what is "compare"
        cli_check_expr(cli_state, cli_frame, left of cli_e)
        cli_check_expr(cli_state, cli_frame, right of cli_e)
        if op of cli_e is not "is"
            cli_rule(cli_state, cli_frame, at of cli_e, "compare", (list of op of cli_e), (list of left of cli_e, right of cli_e))
        end
    else if cli_what is "random"
        cli_check_expr(cli_state, cli_frame, left of cli_e)
        cli_check_expr(cli_state, cli_frame, right of cli_e)
        cli_rule(cli_state, cli_frame, at of cli_e, "random", empty list, (list of left of cli_e, right of cli_e))
    else if cli_what is "not"
        cli_check_expr(cli_state, cli_frame, operand of cli_e)
    else if cli_what is "negate"
        cli_check_expr(cli_state, cli_frame, operand of cli_e)
        cli_rule(cli_state, cli_frame, at of cli_e, "negate", empty list, (list of operand of cli_e))
    else if cli_what is "list" or cli_what is "dictionary"
        cli_check_each(cli_state, cli_frame, items of cli_e)
    else if cli_what is "record"
        cli_check_each(cli_state, cli_frame, values of cli_e)
    else if cli_what is "builtin"
        cli_check_each(cli_state, cli_frame, args of cli_e)
        cli_rule(cli_state, cli_frame, at of cli_e, "builtin", (list of name of cli_e), args of cli_e)
    else if cli_what is "field"
        cli_check_expr(cli_state, cli_frame, subject of cli_e)
        cli_will_fail(cli_state, cli_frame, at of cli_e, record with how "field", subject subject of cli_e, name name of cli_e, at nothing,
            frame nothing, sort nothing)
    else if cli_what is "length"
        cli_check_expr(cli_state, cli_frame, subject of cli_e)
        cli_rule(cli_state, cli_frame, at of cli_e, "length", empty list, (list of subject of cli_e))
    else if cli_what is "read"
        cli_check_expr(cli_state, cli_frame, subject of cli_e)
        set cli_binary to "false"
        if binary of cli_e
            set cli_binary to "true"
        end
        cli_rule(cli_state, cli_frame, at of cli_e, "read", (list of cli_binary), (list of subject of cli_e))
    else if cli_what is "readFolder"
        cli_check_expr(cli_state, cli_frame, subject of cli_e)
        cli_rule(cli_state, cli_frame, at of cli_e, "readFolder", empty list, (list of subject of cli_e))
    else if cli_what is "item"
        cli_check_expr(cli_state, cli_frame, subject of cli_e)
        cli_check_expr(cli_state, cli_frame, index of cli_e)
        cli_will_fail(cli_state, cli_frame, at of cli_e, record with how "item", subject subject of cli_e, at nothing, frame nothing, sort nothing)
    else if cli_what is "ask"
        cli_check_expr(cli_state, cli_frame, question of cli_e)
    end
end

to cli_check_block with cli_state, cli_frame, cli_body
    set cli_n to 0
    for each cli_s in cli_body
        add 1 to cli_n
        cli_check_statement(cli_state, cli_frame, cli_s)
        if (kind of cli_s) is in cli_enders and cli_n is less than length of cli_body
            cli_note_problem(cli_state, at of item (cli_n + 1) of cli_body, "never runs",
                "this line can never run, because '" + item (kind of cli_s) of cli_enders + "' comes first")
            return nothing
        end
    end
end

to cli_check_statement with cli_state, cli_frame, cli_s
    set cli_what to kind of cli_s
    if cli_what is "set"
        cli_check_expr(cli_state, cli_frame, value of cli_s)
        set cli_key to cli_key_for(cli_frame, name of cli_s)
        cli_add_source(cli_state, cli_key, record with how "expr", frame cli_frame, e value of cli_s)
        cli_note_place(cli_state, at of cli_s, "set", cli_key)
        cli_made_name(cli_state, cli_key, at of cli_s, "'" + name of cli_s + "' is set but never used")
    else if cli_what is "add"
        cli_check_expr(cli_state, cli_frame, value of cli_s)
        if cli_use_name(cli_state, cli_frame, name of cli_s, at of cli_s, no, no)
            set cli_key to cli_key_for(cli_frame, name of cli_s)
            cli_add_source(cli_state, cli_key, record with how "add", frame cli_frame, key cli_key, e value of cli_s)
            set cli_named to record with kind "name", name name of cli_s, at at of cli_s
            cli_rule(cli_state, cli_frame, at of cli_s, "add", (list of name of cli_s), (list of cli_named, value of cli_s))
            cli_will_fail(cli_state, cli_frame, at of cli_s, record with how "list add", key cli_key, value value of cli_s, at nothing,
                frame nothing, sort nothing)
        end
    else if cli_what is "say"
        cli_check_each(cli_state, cli_frame, parts of cli_s)
    else if cli_what is "if"
        cli_check_expr(cli_state, cli_frame, cond of cli_s)
        cli_check_block(cli_state, cli_frame, then of cli_s)
        cli_check_block(cli_state, cli_frame, otherwise of cli_s)
    else if cli_what is "while"
        cli_check_expr(cli_state, cli_frame, cond of cli_s)
        cli_check_block(cli_state, cli_frame, body of cli_s)
    else if cli_what is "repeat" # how many times rests on the value: the playground's checker says
        cli_check_expr(cli_state, cli_frame, count of cli_s)
        cli_check_block(cli_state, cli_frame, body of cli_s)
    else if cli_what is "count"
        cli_check_expr(cli_state, cli_frame, start of cli_s)
        cli_check_expr(cli_state, cli_frame, limit of cli_s)
        set cli_key to cli_key_for(cli_frame, name of cli_s)
        cli_add_source(cli_state, cli_key, record with how "fixed", type "number")
        cli_note_place(cli_state, at of cli_s, "set", cli_key)
        cli_rule(cli_state, cli_frame, at of cli_s, "count", empty list, (list of start of cli_s, limit of cli_s))
        cli_check_block(cli_state, cli_frame, body of cli_s)
    else if cli_what is "each"
        cli_check_expr(cli_state, cli_frame, over of cli_s)
        set cli_key to cli_key_for(cli_frame, name of cli_s)
        cli_add_source(cli_state, cli_key, record with how "each", frame cli_frame, e over of cli_s)
        cli_note_place(cli_state, at of cli_s, "set", cli_key)
        cli_rule(cli_state, cli_frame, at of cli_s, "each", empty list, (list of over of cli_s))
        cli_check_block(cli_state, cli_frame, body of cli_s)
    else if cli_what is "define"
        set cli_key to cli_key_for(cli_frame, name of cli_s)
        cli_add_source(cli_state, cli_key, record with how "fixed", type "function")
        # the test runner calls a test_ function at the top level, so it is used
        if not (outer of cli_frame is nothing and length of name of cli_s is greater than 5 and cli_first(name of cli_s, 5) is "test_")
            cli_made_name(cli_state, cli_key, at of cli_s, "'" + name of cli_s + "' is made but never used")
        end
        if made_kind of cli_s is not nothing # what a record the kind makes holds
            set cli_from to nothing
            if kind of value of item 1 of body of cli_s is "call"
                set cli_from to name of value of item 1 of body of cli_s
            end
            set cli_owns to empty list
            for each cli_b in body of cli_s
                if kind of cli_b is "setField" and kind of value of cli_b is "name"
                    if name of value of cli_b is name of cli_s + "'s " + name of cli_b
                        add name of cli_b to cli_owns
                    end
                end
            end
            if not (made_kind of cli_s is in kinds of cli_state)
                set item (made_kind of cli_s) of (kinds of cli_state) to record with define cli_s, parent cli_from, owns cli_owns
            end
            set item (name of cli_s) of (makers of cli_state) to made_kind of cli_s
        end
        set cli_inner to cli_check_function(cli_state, cli_frame, name of cli_s, params of cli_s, body of cli_s, order of cli_s, cli_s)
        cli_note_place(cli_state, at of cli_s, "gives", return_key of cli_inner)
        set cli_defines to defines of cli_state
        if not (cli_key is in cli_defines)
            set item cli_key of cli_defines to empty list
        end
        set cli_list to item cli_key of cli_defines
        add (record with define cli_s, frame cli_inner) to cli_list
    else if cli_what is "when"
        cli_check_expr(cli_state, cli_frame, label of cli_s) # the button or text box it waits for, if any
        cli_check_function(cli_state, cli_frame, name of fn of cli_s, params of fn of cli_s, body of fn of cli_s, order of fn of cli_s, nothing)
    else if cli_what is "every" # how often must be a number
        cli_check_expr(cli_state, cli_frame, interval of cli_s)
        cli_rule(cli_state, cli_frame, at of cli_s, "every", (list of ("" + unit of cli_s)), (list of interval of cli_s))
        cli_check_function(cli_state, cli_frame, name of fn of cli_s, params of fn of cli_s, body of fn of cli_s, order of fn of cli_s, nothing)
    else if cli_what is "return"
        cli_check_expr(cli_state, cli_frame, value of cli_s)
        set cli_returns to returns of cli_frame
        if value of cli_s is nothing
            add (record with how "fixed", type "nothing") to cli_returns
        else
            add (record with how "expr", frame cli_frame, e value of cli_s) to cli_returns
        end
        if def of cli_frame is not nothing and gives of def of cli_frame is not nothing # what it gives must be what it says it gives
            cli_type_check(cli_state, at of cli_s, record with how "return", value value of cli_s, frame cli_frame, at nothing, sort nothing)
        end
    else if cli_what is "fail" or cli_what is "do"
        cli_check_expr(cli_state, cli_frame, value of cli_s)
    else if cli_what is "exit" # the number it stops with must be a whole number from 0 to 255
        if value of cli_s is not nothing
            cli_check_expr(cli_state, cli_frame, value of cli_s)
            cli_rule(cli_state, cli_frame, at of cli_s, "exit", empty list, (list of value of cli_s))
        end
    else if cli_what is "call"
        cli_check_call(cli_state, cli_frame, cli_s, yes)
    else if cli_what is "setItem"
        cli_check_expr(cli_state, cli_frame, subject of target of cli_s)
        cli_check_expr(cli_state, cli_frame, index of target of cli_s)
        cli_check_expr(cli_state, cli_frame, value of cli_s)
        cli_rule(cli_state, cli_frame, at of target of cli_s, "setItem", empty list, (list of subject of target of cli_s))
    else if cli_what is "setField"
        cli_check_expr(cli_state, cli_frame, target of cli_s)
        cli_check_expr(cli_state, cli_frame, value of cli_s)
        if def of cli_frame is nothing or made_kind of def of cli_frame is nothing # a record's field can then be anything
            set item (name of cli_s) of (fields_set of cli_state) to yes
        end
        cli_rule(cli_state, cli_frame, at of cli_s, "setField", (list of name of cli_s), (list of target of cli_s))
    else if cli_what is "remove"
        cli_check_expr(cli_state, cli_frame, key of cli_s)
        cli_check_expr(cli_state, cli_frame, target of cli_s)
        cli_rule(cli_state, cli_frame, at of cli_s, "remove", empty list, (list of target of cli_s))
    else if cli_what is "removeFile"
        cli_check_expr(cli_state, cli_frame, target of cli_s)
        cli_rule(cli_state, cli_frame, at of cli_s, "removeFile", empty list, (list of target of cli_s))
    else if cli_what is "wait"
        cli_check_expr(cli_state, cli_frame, amount of cli_s)
        cli_rule(cli_state, cli_frame, at of cli_s, "wait", (list of ("" + unit of cli_s)), (list of amount of cli_s))
    else if cli_what is "play" # a beep has neither
        if note of cli_s is not nothing
            cli_check_expr(cli_state, cli_frame, note of cli_s)
            cli_check_expr(cli_state, cli_frame, time of cli_s)
            cli_will_fail(cli_state, cli_frame, at of cli_s, record with how "play", note note of cli_s, time time of cli_s,
                unit "" + unit of cli_s, at nothing, frame nothing, sort nothing)
        end
    else if cli_what is "write"
        cli_check_expr(cli_state, cli_frame, value of cli_s)
        cli_check_expr(cli_state, cli_frame, target of cli_s)
        cli_rule(cli_state, cli_frame, at of cli_s, "write", empty list, (list of target of cli_s))
    else if cli_what is "expect" # only comparing kinds that can't be compared is certain to fail
        set cli_c to cond of cli_s
        if kind of cli_c is not "compare"
            cli_check_expr(cli_state, cli_frame, cli_c)
        else
            cli_check_expr(cli_state, cli_frame, left of cli_c)
            cli_check_expr(cli_state, cli_frame, right of cli_c)
            if op of cli_c is not "is"
                cli_rule(cli_state, cli_frame, at of cli_s, "compare", (list of op of cli_c), (list of left of cli_c, right of cli_c))
            end
        end
    else if cli_what is "try" # a mistake inside it is caught, so nothing in it is certain to fail
        set skipped of cli_frame to skipped of cli_frame + 1
        cli_check_block(cli_state, cli_frame, body of cli_s)
        set skipped of cli_frame to skipped of cli_frame - 1
        if name of cli_s is not nothing
            cli_add_source(cli_state, cli_key_for(cli_frame, name of cli_s), record with how "fixed", type "?")
        end
        cli_check_block(cli_state, cli_frame, handler of cli_s)
    else if cli_what is "turtle"
        if value of cli_s is not nothing
            cli_check_expr(cli_state, cli_frame, value of cli_s)
            if action of cli_s is "picture" # whether a file is a picture isn't known: only what is neither a name nor bytes
                cli_rule(cli_state, cli_frame, at of cli_s, "picture", empty list, (list of item 1 of items of value of cli_s))
            else if kind of value of cli_s is not "list" or action of cli_s is "forward"
                # the width check rests on the value, so it's only made when the width is written out
                if action of cli_s is not "width" or kind of value of cli_s is "value"
                    cli_rule(cli_state, cli_frame, at of cli_s, "turtle", (list of ("" + cli_action_number(cli_state, action of cli_s))), (list of value of cli_s))
                end
            end
        end
    end
end

# what one way a variable gets its value gives, with the types as they stand
to cli_source_type with cli_state, cli_how
    set cli_way to how of cli_how
    if cli_way is "fixed"
        return type of cli_how
    else if cli_way is "expr"
        return cli_type_of(cli_state, frame of cli_how, e of cli_how)
    else if cli_way is "each" # a list's items could be anything, unless the code says what it holds
        set cli_list_type to cli_type_of(cli_state, frame of cli_how, e of cli_how)
        if cli_list_type is nothing or cli_list_type is "text"
            return cli_list_type
        end
        if mode of cli_state is "said"
            return cli_holds(cli_list_type)
        end
        return "?"
    else if cli_way is "add"
        set cli_current to cli_slot_type(cli_state, key of cli_how)
        set cli_v to cli_type_of(cli_state, frame of cli_how, e of cli_how)
        if cli_base_type(cli_current) is "list"
            if cli_holds(cli_current) is not "?" and cli_fits_type(cli_state, cli_v, cli_holds(cli_current)) is no
                return "list"
            end
            return cli_current
        end
        if cli_current is "text"
            return cli_current
        end
        if cli_current is "number" and cli_v is "number"
            return "number"
        end
        if cli_current is not nothing and cli_current is in cli_measure_types and cli_v is cli_current # `add 300 m to trip`
            return cli_current
        end
        # an add that will fail doesn't change the type: the program stops there
        if cli_current is nothing or cli_v is nothing or (cli_known_type(cli_current) and cli_known_type(cli_v))
            return nothing
        end
        return "?"
    end
    return "?"
end

# whether one problem comes after another: by its line, then by its column
to cli_problem_after with cli_a, cli_b
    if line of cli_a is not line of cli_b
        return line of cli_a is greater than line of cli_b
    end
    return col of cli_a is greater than col of cli_b
end

# every problem once, in the checker's order: by line, then by column, two at one spot as they came
to cli_sorted_problems with cli_problems
    set cli_seen to empty dictionary
    set cli_out to empty list
    for each cli_p in cli_problems
        set cli_mark to line of cli_p + ":" + col of cli_p + ":" + message of cli_p
        if not (cli_mark is in cli_seen)
            set item cli_mark of cli_seen to yes
            set cli_next to empty list
            set cli_placed to no
            for each cli_q in cli_out
                if not cli_placed and cli_problem_after(cli_q, cli_p)
                    add cli_p to cli_next
                    set cli_placed to yes
                end
                add cli_q to cli_next
            end
            if not cli_placed
                add cli_p to cli_next
            end
            set cli_out to cli_next
        end
    end
    return cli_out
end

# every problem in a program's tree (the parser's, with the files it uses in place)
to cli_problems_in with cli_body
    return cli_sorted_problems(found of cli_checked(cli_body))
end

# the checker's state once it has checked a program's tree: what it found, and the type of every variable
to cli_checked with cli_body
    set cli_state to cli_new_state()
    cli_check_function(cli_state, nothing, "main", empty list, cli_body, 0, nothing)
    # every variable's type: again until nothing changes, first from what's sure, then with what the code says
    for each cli_mode in list of "sure", "said"
        set mode of cli_state to cli_mode
        set cli_types to sure of cli_state
        if cli_mode is "said"
            set cli_types to said of cli_state
        end
        set cli_changed to yes
        repeat while cli_changed
            set cli_changed to no
            for each cli_key in sources of cli_state
                set cli_type to nothing
                if cli_mode is "said" and cli_key is in declared of cli_state
                    set cli_said to item cli_key of declared of cli_state
                    set cli_type to cli_type_named(cli_state, words of cli_said, at of cli_said)
                else
                    for each cli_how in item cli_key of sources of cli_state
                        set cli_type to cli_join(cli_type, cli_source_type(cli_state, cli_how))
                    end
                end
                set cli_was to nothing
                if cli_key is in cli_types
                    set cli_was to item cli_key of cli_types
                end
                if cli_type is not cli_was
                    set item cli_key of cli_types to cli_type
                    set cli_changed to yes
                end
            end
        end
    end
    set mode of cli_state to "said"
    for each cli_d in gives of cli_state # a kind a `gives` names that the program doesn't make
        cli_type_named(cli_state, gives of cli_d, at of cli_d)
    end
    for each cli_c in checks of cli_state
        if sort of cli_c is "fit"
            set mode of cli_state to "said"
            set cli_said to cli_run_check(cli_state, cli_c)
            if cli_said is not nothing and cli_said is not ""
                cli_note_problem(cli_state, at of cli_c, "doesn't fit", cli_said)
            end
        else
            set cli_done to no
            for each cli_mode in list of "sure", "said"
                if not cli_done
                    set mode of cli_state to cli_mode
                    set cli_said to cli_run_check(cli_state, cli_c)
                    if cli_said is not nothing
                        set cli_done to yes
                        if cli_said is not "" # one moth check leaves out, resting on a value written out
                            set cli_kind to "fails"
                            if cli_mode is "said"
                                set cli_kind to "doesn't fit"
                            end
                            cli_note_problem(cli_state, at of cli_c, cli_kind, cli_said)
                        end
                    end
                end
            end
        end
    end
    for each cli_key in made of cli_state
        if not (cli_key is in used of cli_state)
            set cli_entry to item cli_key of (made of cli_state)
            cli_note_problem(cli_state, at of cli_entry, "unused", message of cli_entry)
        end
    end
    return cli_state
end

# every problem in a program, with the files it uses in place
to cli_problems_of with cli_source, cli_names, cli_texts
    return cli_problems_in(machine's read_program(cli_source, cli_files_of(cli_names, cli_texts)))
end

# `moth check file.moth`: every problem, where it is, and the line with a ^ under the spot; 0 if no line
# will fail and nothing doesn't fit what it says
to cli_check_file with cli_path
    set cli_source to cli_text_of(cli_path)
    if cli_source is nothing
        return 1
    end
    set cli_used to cli_sources_of(cli_path, cli_source)
    set cli_problems to empty list
    try
        set cli_problems to cli_problems_of(cli_source, names of cli_used, texts of cli_used)
    if it fails with cli_whycheck # code that can't be read at all is one problem of its own
        if not cli_is_problem(cli_whycheck)
            fail with cli_whycheck
        end
        set cli_at to at of cli_whycheck
        set cli_where to cli_path
        if file of cli_at is not ""
            set cli_where to file of cli_at
        end
        cli_say_problem(cli_where, line of cli_at, col of cli_at, "error: " + reason of cli_whycheck,
            cli_text_for(file of cli_at, cli_source, names of cli_used, texts of cli_used), no)
        return 1
    end
    set cli_wrong to 0
    for each cli_p in cli_problems
        set cli_said to kind of cli_p
        if cli_said is "fails"
            set cli_said to "will fail"
            set cli_wrong to 1
        else if cli_said is "doesn't fit" # the code goes against what it says it is: a mistake too
            set cli_wrong to 1
        end
        set cli_where to cli_path
        if file of cli_p is not ""
            set cli_where to file of cli_p
        end
        cli_say_problem(cli_where, line of cli_p, col of cli_p, cli_said + ": " + message of cli_p,
            cli_text_for(file of cli_p, cli_source, names of cli_used, texts of cli_used), no)
    end
    if length of cli_problems is 0
        say cli_path + ": no problems found"
    end
    return cli_wrong
end

# ---------- the language server ----------
# `moth lsp` (DESIGN §108): what moth knows of a program, for any editor, over the Language Server Protocol
# on the input and the output: the problems moth check finds, as you type; tidying, as moth tidy does; each
# function, kind and variable a file makes, for its outline; where a name is made, in the file or one it
# uses; what a name is, when the pointer is on it; and the names that could come next. Each message is
# JSON after a "Content-Length" line and an empty line, each line ending with "\r\n" (ask for ... bytes
# reads them as they come). Lines and columns are counted from 0 there, and columns as JavaScript counts
# them, as Moth's are.

set cli_cr to ((list of 13) as bytes) as text # a carriage return, which Moth text can't write
# what can come next in a line, for completion
set cli_lsp_words to list of "set", "to", "say", "if", "else", "end", "repeat", "while", "for each", "return", "add", "remove",
    "kind", "use", "try", "if it fails", "either way", "fail with", "stop", "expect", "match", "when", "every", "ask", "read",
    "write", "length of", "item", "list of", "empty list", "empty dictionary", "record with", "dictionary where", "yes", "no",
    "nothing", "and", "or", "not", "is", "is not", "is greater than", "is less than", "is at least", "is at most", "is in",
    "as a number", "as text", "as yes or no", "as a list", "as a record", "as a dictionary", "as bytes", "as a function",
    "as a list of", "gives", "with"

# the next message the editor sent, as a dictionary, or nothing when the input has ended
to cli_lsp_read
    set cli_header to ""
    set cli_blank to cli_cr + "\n" + cli_cr + "\n"
    repeat while not cli_finishes_with(cli_header, cli_blank)
        set cli_byte to ask for 1 bytes
        if length of cli_byte is 0
            return nothing
        end
        set cli_header to cli_header + (cli_byte as text)
    end
    set cli_size to -1
    for each cli_raw in split cli_header by "\n"
        set cli_line to join (split cli_raw by cli_cr) with ""
        set cli_colon to position of ":" in cli_line
        if cli_colon is greater than 0 and lowercase of cli_first(cli_line, cli_colon - 1) is "content-length"
            set cli_size to number of cli_trimmed(cli_tail(cli_line, cli_colon + 1))
        end
    end
    if cli_size is less than 0
        return dictionary where "method" is "?" # a message moth can't read: answered as one it doesn't know
    end
    set cli_body to ask for cli_size bytes
    try
        return json from (cli_body as text)
    if it fails
        return dictionary where "method" is "?"
    end
end

# a message to the editor: its JSON, with Content-Length counting its bytes and the new line say puts after it
to cli_lsp_send with cli_message
    set cli_text to cli_message as json
    say "Content-Length: " + (length of (cli_text as bytes) + 1) + cli_cr
    say cli_cr
    say cli_text
end

to cli_lsp_reply with cli_id, cli_result
    cli_lsp_send(dictionary where "jsonrpc" is "2.0", "id" is cli_id, "result" is cli_result)
end

to cli_lsp_tell with cli_method, cli_params
    cli_lsp_send(dictionary where "jsonrpc" is "2.0", "method" is cli_method, "params" is cli_params)
end

# a field of a message, or nothing if it hasn't one
to cli_lsp_get with cli_from, cli_key
    if cli_from is nothing or not (cli_key is in cli_from)
        return nothing
    end
    return item cli_key of cli_from
end

# a file's path, from its address: file:///C:/a%20b/x.moth is C:/a b/x.moth, and file:///home/x.moth /home/x.moth
to cli_lsp_path with cli_uri
    set cli_rest to cli_uri
    if cli_begins_with(cli_rest, "file://")
        set cli_rest to cli_tail(cli_rest, 8)
    end
    set cli_bytes to empty list # its UTF-8, as %C3%A9 is é
    set cli_k to 1
    repeat while cli_k is at most length of cli_rest
        set cli_c to item cli_k of cli_rest
        if cli_c is "%" and cli_k + 2 is at most length of cli_rest
            add cli_hex_value(item (cli_k + 1) of cli_rest) * 16 + cli_hex_value(item (cli_k + 2) of cli_rest) to cli_bytes
            add 3 to cli_k
        else
            for each cli_b in cli_c as bytes
                add cli_b to cli_bytes
            end
            add 1 to cli_k
        end
    end
    set cli_out to (cli_bytes as bytes) as text
    if length of cli_out is at least 3 and item 1 of cli_out is "/" and item 3 of cli_out is ":"
        set cli_out to cli_tail(cli_out, 2)
    end
    return cli_out
end

to cli_hex_value with cli_c
    set cli_at to position of (lowercase of cli_c) in "0123456789abcdef"
    if cli_at is 0
        return 0
    end
    return cli_at - 1
end

# a file's address, from its path
to cli_lsp_uri with cli_path
    set cli_path to join (split cli_path by "\\") with "/"
    set cli_out to "file://"
    if length of cli_path is at least 2 and item 2 of cli_path is ":"
        set cli_out to cli_out + "/"
    end
    for each cli_c in cli_path
        if cli_c is " "
            add "%20" to cli_out
        else if cli_c is "%"
            add "%25" to cli_out
        else if cli_c is "#"
            add "%23" to cli_out
        else
            add cli_c to cli_out
        end
    end
    return cli_out
end

# a position in a file, as the protocol has it: a line and a column, from 0
to cli_lsp_place with cli_line, cli_col
    return dictionary where "line" is cli_line, "character" is cli_col
end

to cli_lsp_range with cli_line, cli_col, cli_end_line, cli_end_col
    return dictionary where "start" is cli_lsp_place(cli_line, cli_col), "end" is cli_lsp_place(cli_end_line, cli_end_col)
end

to cli_lsp_word_char with cli_c
    return cli_in_word(cli_c)
end

# a line's text, by its number from 1, or "" past the end
to cli_lsp_line with cli_lines, cli_n
    if cli_n is less than 1 or cli_n is greater than length of cli_lines
        return ""
    end
    return join (split item cli_n of cli_lines by cli_cr) with ""
end

# which character of a line is at a column counted as JavaScript counts them, from 1
to cli_lsp_char_at with cli_text, cli_col
    set cli_width to 1
    set cli_k to 1
    repeat while cli_k is at most length of cli_text and cli_width is less than cli_col
        add cli_width_of(item cli_k of cli_text) to cli_width
        add 1 to cli_k
    end
    return cli_k
end

# the column, from 1, after the word that starts at column `col` of a line, or after the one character there
to cli_lsp_word_end with cli_text, cli_col
    set cli_k to cli_lsp_char_at(cli_text, cli_col)
    if cli_k is greater than length of cli_text
        return cli_col + 1
    end
    if not cli_lsp_word_char(item cli_k of cli_text)
        return cli_col + cli_width_of(item cli_k of cli_text)
    end
    set cli_end to cli_col
    repeat while cli_k is at most length of cli_text and cli_lsp_word_char(item cli_k of cli_text)
        add cli_width_of(item cli_k of cli_text) to cli_end
        add 1 to cli_k
    end
    return cli_end
end

# ----- problems -----

# what each problem kind is to an editor: 1 an error (what makes moth check end with 1), 2 a warning
to cli_lsp_severity with cli_kind
    if cli_kind is "fails" or cli_kind is "error" or cli_kind is "doesn't fit"
        return 1
    end
    return 2
end

to cli_lsp_diagnostic with cli_lines, cli_line, cli_col, cli_kind, cli_message
    set cli_text to cli_lsp_line(cli_lines, cli_line)
    set cli_found to dictionary where "range" is cli_lsp_range(cli_line - 1, cli_col - 1, cli_line - 1, cli_lsp_word_end(cli_text, cli_col) - 1),
        "severity" is cli_lsp_severity(cli_kind), "source" is "moth", "message" is cli_message
    if cli_kind is "unused" or cli_kind is "never runs"
        set item "tags" of cli_found to list of 1 # shown faded, as code that's not needed
    end
    return cli_found
end

# The problems in a document, as moth check finds them, for the editor. One in a file it uses that stops it
# running is shown on the line that uses that file; the file's other problems show when it's opened itself.
to cli_lsp_problems with cli_path, cli_source
    set cli_lines to split cli_source by "\n"
    set cli_known to cli_lsp_known(cli_path, cli_source)
    set cli_out to empty list
    if why of cli_known is not nothing # code that can't be read: its first mistake, as moth check says it
        set cli_at to at of why of cli_known
        if file of cli_at is ""
            add cli_lsp_diagnostic(cli_lines, line of cli_at, col of cli_at, "error", reason of why of cli_known) to cli_out
        else
            add cli_lsp_used_problem(cli_lines, file of cli_at, line of cli_at, col of cli_at, "error", reason of why of cli_known) to cli_out
        end
        return cli_out
    end
    set cli_problems to cli_sorted_problems(found of cli_lsp_state(cli_known))
    for each cli_p in cli_problems
        if file of cli_p is ""
            add cli_lsp_diagnostic(cli_lines, line of cli_p, col of cli_p, kind of cli_p, message of cli_p) to cli_out
        else if kind of cli_p is "fails"
            add cli_lsp_used_problem(cli_lines, file of cli_p, line of cli_p, col of cli_p, kind of cli_p, message of cli_p) to cli_out
        end
    end
    return cli_out
end

# a problem in a file the document uses, on the line that uses it
to cli_lsp_used_problem with cli_lines, cli_file, cli_line, cli_col, cli_kind, cli_message
    set cli_at to 1
    for each cli_k from 1 to length of cli_lines
        if cli_at is 1 and ("\"" + cli_file + "\"") is in item cli_k of cli_lines
            set cli_at to cli_k
        end
    end
    set cli_text to cli_lsp_line(cli_lines, cli_at)
    return dictionary where "range" is cli_lsp_range(cli_at - 1, 0, cli_at - 1, length of cli_text), "severity" is cli_lsp_severity(cli_kind),
        "source" is "moth", "message" is cli_file + ":" + cli_line + ":" + cli_col + ": " + cli_message
end

to cli_lsp_publish with cli_uri, cli_source
    set cli_found to empty list
    if cli_source is not nothing
        set cli_found to cli_lsp_problems(cli_lsp_path(cli_uri), cli_source)
    end
    cli_lsp_tell("textDocument/publishDiagnostics", dictionary where "uri" is cli_uri, "diagnostics" is cli_found)
end

# ----- what a program makes -----
# Each function, kind, input and variable, from the program's tree: its name, what it is, where it's made
# (the file, "" for the document's own, and the line and column of its `to`, `kind`, `set`...), and the
# lines it covers.

# What moth knows of each document, by its path, kept while its text and the texts of the files it uses stay
# the same, so the outline, a hover and the problems after one change read the program once: see cli_lsp_known.
set cli_lsp_kept to empty dictionary

# What moth knows of a document: a record with source and used (what it was worked out from), why (the first
# mistake that stops the code being read as it is, or nothing), tree (the program's tree, with the files it
# uses in place, or nothing), and state (the checker's, once something wants it: see cli_lsp_state).
to cli_lsp_known with cli_path, cli_source
    set cli_used to cli_sources_of(cli_path, cli_source)
    if cli_path is in cli_lsp_kept
        set cli_kept to item cli_path of cli_lsp_kept
        if cli_lsp_same(cli_kept, cli_source, cli_used)
            return cli_kept
        end
    end
    set cli_read to cli_lsp_read_tree(cli_source, cli_used)
    set cli_kept to record with source cli_source, used cli_used, why why of cli_read, tree tree of cli_read, state nothing
    set item cli_path of cli_lsp_kept to cli_kept
    return cli_kept
end

# whether what's kept was worked out from this text, and these files with these texts
to cli_lsp_same with cli_kept, cli_source, cli_used
    if source of cli_kept is not cli_source or length of names of used of cli_kept is not length of names of cli_used
        return no
    end
    for each cli_k from 1 to length of names of cli_used
        if item cli_k of names of used of cli_kept is not item cli_k of names of cli_used
            return no
        end
        if item cli_k of texts of used of cli_kept is not item cli_k of texts of cli_used
            return no
        end
    end
    return yes
end

# The checker's state for a document, its problems and the type of each variable, or nothing if its tree
# couldn't be read; checked once, the first time it's wanted
to cli_lsp_state with cli_kept
    if state of cli_kept is nothing and tree of cli_kept is not nothing
        set state of cli_kept to cli_checked(tree of cli_kept)
    end
    return state of cli_kept
end

# A program's tree, from code that's being typed: a record with why (the first mistake that stopped it being
# read as it is, or nothing) and tree. Code often can't be read for a moment as it's typed, so each time it
# can't, the line with the mistake is left out (made empty, so the lines after it keep their numbers; for a
# mistake at the end of the code, the last line with something on it), or a block left open is ended at the
# end, and it's read again, a few times at most. The outline, hovers and completion then still know the rest.
to cli_lsp_read_tree with cli_source, cli_used
    set cli_files to cli_files_of(names of cli_used, texts of cli_used)
    set cli_lines to split cli_source by "\n"
    set cli_first_why to nothing
    set cli_last_mark to ""
    repeat 12 times
        set cli_text to join cli_lines with "\n"
        set cli_tree to nothing
        set cli_wrong to nothing
        try
            set cli_tree to machine's read_program(cli_text, cli_files)
        if it fails with cli_why
            if not cli_is_problem(cli_why)
                fail with cli_why
            end
            set cli_wrong to cli_why
        end
        if cli_wrong is nothing
            return record with why cli_first_why, tree cli_tree
        end
        if cli_first_why is nothing
            set cli_first_why to cli_wrong
        end
        if file of at of cli_wrong is not "" # a mistake in a file it uses, which isn't the editor's to mend
            return record with why cli_first_why, tree nothing
        end
        set cli_mark to line of at of cli_wrong + ":" + col of at of cli_wrong + ":" + reason of cli_wrong
        if cli_finishes_with(reason of cli_wrong, "is missing its 'end'")
            add "end" to cli_lines
        else
            set cli_n to line of at of cli_wrong
            if cli_n is greater than length of cli_lines
                set cli_n to length of cli_lines
            else if cli_mark is not cli_last_mark and cli_lsp_starts_line(item cli_n of cli_lines, col of at of cli_wrong)
                # A mistake at the start of a line is most often the line before's, left unfinished: `set x to`,
                # then a line that isn't the value it waits for. That line's left out first; if the mistake is
                # still here then, it's this line's own.
                if not cli_begins_with(reason of cli_wrong, "a line can't start with")
                    set cli_n to cli_n - 1
                    repeat while cli_n is at least 1 and cli_trimmed(item cli_n of cli_lines) is ""
                        set cli_n to cli_n - 1
                    end
                    if cli_n is less than 1
                        set cli_n to line of at of cli_wrong
                    end
                end
            end
            repeat while cli_n is at least 1 and cli_trimmed(item cli_n of cli_lines) is ""
                set cli_n to cli_n - 1
            end
            if cli_n is less than 1
                return record with why cli_first_why, tree nothing
            end
            set item cli_n of cli_lines to ""
        end
        set cli_last_mark to cli_mark
    end
    return record with why cli_first_why, tree nothing
end

# whether a column of a line, counted from 1 as JavaScript counts them, is its first that isn't a space
to cli_lsp_starts_line with cli_text, cli_col
    set cli_k to 1
    repeat while cli_k is at most length of cli_text and (item cli_k of cli_text is " " or item cli_k of cli_text is "\t")
        add 1 to cli_k
    end
    return cli_lsp_char_at(cli_text, cli_col) is cli_k
end

# what a define is called where it's written: dog's speak is speak, in the kind dog
to cli_lsp_own_name with cli_name
    set cli_cut to position of "'s " in cli_name
    if cli_cut is 0
        return cli_name
    end
    return cli_tail(cli_name, cli_cut + 3)
end

# whether a name is one a program can't write: what the parser makes for itself, as "the step on line 3"
to cli_lsp_hidden with cli_name
    return " " is in cli_lsp_own_name(cli_name)
end

# what a function says it takes and gives: `with w as a number, h as a number gives a number`
to cli_lsp_signature with cli_d
    set cli_out to ""
    for each cli_k from 1 to length of params of cli_d
        if cli_k is 1
            set cli_out to "with "
        else
            add ", " to cli_out
        end
        add item cli_k of params of cli_d to cli_out
        set cli_said to nothing
        if types of cli_d is not nothing and cli_k is at most length of types of cli_d
            set cli_said to item cli_k of types of cli_d
        end
        if cli_said is nothing and cli_k is at most length of kinds of cli_d and item cli_k of kinds of cli_d is at least 0
            set cli_said to item (item cli_k of kinds of cli_d + 1) of cli_kind_words
        end
        if cli_said is not nothing
            add " as " + cli_said to cli_out
        end
    end
    if gives of cli_d is not nothing
        if cli_out is not ""
            add " " to cli_out
        end
        add "gives " + gives of cli_d to cli_out
    end
    return cli_out
end

# Everything a block makes, into `found`: records with name, what ("function", "kind", "method", "input" or
# "variable"), define (for the first three), file, line, col, and inside (the define whose body it's in, or
# nothing at the top level)
to cli_lsp_made with cli_body, cli_inside, cli_found, cli_seen
    for each cli_s in cli_body
        set cli_what to kind of cli_s
        if cli_what is "define" and not cli_lsp_hidden(name of cli_s)
            set cli_sort to "function"
            if made_kind of cli_s is not nothing
                set cli_sort to "kind"
            else if "'s " is in name of cli_s
                set cli_sort to "method"
            end
            add (record with name name of cli_s, what cli_sort, define cli_s, file file of at of cli_s, line line of at of cli_s,
                col col of at of cli_s, inside cli_inside) to cli_found
            for each cli_p in params of cli_s
                add (record with name cli_p, what "input", define cli_s, file file of at of cli_s, line line of at of cli_s,
                    col col of at of cli_s, inside cli_s) to cli_found
            end
            cli_lsp_made(body of cli_s, cli_s, cli_found, empty dictionary)
        else if cli_what is "set" or cli_what is "count" or cli_what is "each"
            set cli_mark to lowercase of name of cli_s
            if not cli_lsp_hidden(name of cli_s) and not (cli_mark is in cli_seen)
                set item cli_mark of cli_seen to yes
                add (record with name name of cli_s, what "variable", define nothing, file file of at of cli_s, line line of at of cli_s,
                    col col of at of cli_s, inside cli_inside) to cli_found
            end
        end
        for each cli_inner in cli_lsp_blocks(cli_s)
            cli_lsp_made(cli_inner, cli_inside, cli_found, cli_seen)
        end
    end
end

# the blocks inside a statement that aren't a function of their own
to cli_lsp_blocks with cli_s
    set cli_what to kind of cli_s
    if cli_what is "if"
        return list of then of cli_s, otherwise of cli_s
    else if cli_what is "while" or cli_what is "repeat" or cli_what is "count" or cli_what is "each"
        return list of body of cli_s
    else if cli_what is "try"
        return list of body of cli_s, handler of cli_s
    end
    return empty list
end

# the line a block that starts on line n ends on: the first line after it as far in as it, or less, that
# starts with `end`; or n itself if there's none
to cli_lsp_end_line with cli_lines, cli_n
    set cli_start to cli_lsp_line(cli_lines, cli_n)
    set cli_depth to length of cli_start - length of cli_trimmed_front(cli_start)
    for each cli_k from cli_n + 1 to length of cli_lines
        set cli_text to cli_lsp_line(cli_lines, cli_k)
        set cli_rest to cli_trimmed_front(cli_text)
        if cli_rest is not ""
            if length of cli_text - length of cli_rest is at most cli_depth
                if cli_rest is "end" or cli_begins_with(cli_rest, "end ") or cli_begins_with(cli_rest, "end#")
                    return cli_k
                end
                return cli_n
            end
        end
    end
    return cli_n
end

to cli_trimmed_front with cli_text
    set cli_k to 1
    repeat while cli_k is at most length of cli_text and (item cli_k of cli_text is " " or item cli_k of cli_text is "\t")
        add 1 to cli_k
    end
    return cli_tail(cli_text, cli_k)
end

# where the name of what's made on a line is: the column, from 1, of `name` after the `to`, `kind`, `set` or
# `for each` at `col`, or col itself
to cli_lsp_name_col with cli_text, cli_col, cli_name
    set cli_k to cli_lsp_char_at(cli_text, cli_col)
    set cli_low to lowercase of cli_text
    set cli_want to lowercase of cli_lsp_own_name(cli_name)
    set cli_at to cli_col
    repeat while cli_k + length of cli_want - 1 is at most length of cli_low
        if (items cli_k to (cli_k + length of cli_want - 1) of cli_low) is cli_want
            set cli_before to cli_k is 1 or not cli_lsp_word_char(item (cli_k - 1) of cli_low)
            set cli_after to cli_k + length of cli_want is greater than length of cli_low or not cli_lsp_word_char(item (cli_k + length of cli_want) of cli_low)
            if cli_before and cli_after
                return cli_at
            end
        end
        add cli_width_of(item cli_k of cli_low) to cli_at
        add 1 to cli_k
    end
    return cli_col
end

# ----- symbols, definitions, hovers and completion -----

# the text of a file the document uses, or the document's own
to cli_lsp_file_text with cli_path, cli_source, cli_file
    if cli_file is ""
        return cli_source
    end
    try
        return read cli_folder_of(cli_path) + cli_file
    if it fails
        set cli_std to standard's standard_text(cli_file)
        if cli_std is not nothing
            return cli_std
        end
    end
    return ""
end

to cli_lsp_symbol_kind with cli_what
    if cli_what is "kind"
        return 5
    else if cli_what is "method"
        return 6
    else if cli_what is "function"
        return 12
    end
    return 13
end

# the outline: each function, kind and variable the document makes, functions inside the ones they're made in
to cli_lsp_symbols with cli_path, cli_source
    set cli_tree to tree of cli_lsp_known(cli_path, cli_source)
    if cli_tree is nothing
        return empty list
    end
    set cli_lines to split cli_source by "\n"
    set cli_made to empty list
    cli_lsp_made(cli_tree, nothing, cli_made, empty dictionary)
    set cli_by_define to empty dictionary # each function's and kind's symbol, by its line
    set cli_kinds to empty dictionary # each kind's symbol, by its name, for its own functions
    set cli_placed to empty list # each symbol, with what to put it in
    for each cli_m in cli_made
        if file of cli_m is "" and what of cli_m is not "input"
            set cli_text to cli_lsp_line(cli_lines, line of cli_m)
            set cli_name_at to cli_lsp_name_col(cli_text, col of cli_m, name of cli_m)
            set cli_end to line of cli_m
            if what of cli_m is not "variable"
                set cli_end to cli_lsp_end_line(cli_lines, line of cli_m)
            end
            set cli_detail to ""
            if define of cli_m is not nothing
                set cli_detail to cli_lsp_signature(define of cli_m)
            end
            set cli_own to cli_lsp_own_name(name of cli_m)
            set cli_symbol to dictionary where "name" is cli_own, "detail" is cli_detail, "kind" is cli_lsp_symbol_kind(what of cli_m),
                "range" is cli_lsp_range(line of cli_m - 1, 0, cli_end - 1, length of cli_lsp_line(cli_lines, cli_end)),
                "selectionRange" is cli_lsp_range(line of cli_m - 1, cli_name_at - 1, line of cli_m - 1, cli_name_at - 1 + length of cli_own),
                "children" is empty list
            if define of cli_m is not nothing
                set item ("" + line of cli_m) of cli_by_define to cli_symbol
            end
            if what of cli_m is "kind"
                set item (lowercase of name of cli_m) of cli_kinds to cli_symbol
            end
            add (record with symbol cli_symbol, made cli_m) to cli_placed
        end
    end
    set cli_top to empty list
    for each cli_one in cli_placed
        set cli_m to made of cli_one
        set cli_parent to nothing
        if what of cli_m is "method"
            set cli_owner to lowercase of cli_first(name of cli_m, (position of "'s " in name of cli_m) - 1)
            if cli_owner is in cli_kinds
                set cli_parent to item cli_owner of cli_kinds
            end
        end
        if cli_parent is nothing and inside of cli_m is not nothing
            if ("" + line of at of inside of cli_m) is in cli_by_define
                set cli_parent to item ("" + line of at of inside of cli_m) of cli_by_define
            end
        end
        if cli_parent is nothing
            add symbol of cli_one to cli_top
        else
            set cli_children to item "children" of cli_parent
            add symbol of cli_one to cli_children
        end
    end
    return cli_top
end

# the name at a position: the word there, with what's before its 's when that's part of the name (lib's twice)
to cli_lsp_name_at with cli_lines, cli_line, cli_char
    set cli_text to cli_lsp_line(cli_lines, cli_line + 1)
    set cli_k to cli_lsp_char_at(cli_text, cli_char + 1)
    if cli_k is greater than length of cli_text or not cli_lsp_word_char(item cli_k of cli_text)
        if cli_k is greater than 1 and cli_k - 1 is at most length of cli_text and cli_lsp_word_char(item (cli_k - 1) of cli_text)
            set cli_k to cli_k - 1
        else
            return nothing
        end
    end
    set cli_from to cli_k
    repeat while cli_from is greater than 1 and cli_lsp_word_char(item (cli_from - 1) of cli_text)
        set cli_from to cli_from - 1
    end
    set cli_to to cli_k
    repeat while cli_to is less than length of cli_text and cli_lsp_word_char(item (cli_to + 1) of cli_text)
        add 1 to cli_to
    end
    set cli_word to items cli_from to cli_to of cli_text
    set cli_owner to nothing
    if cli_from is greater than 4 and (items (cli_from - 3) to (cli_from - 1) of cli_text) is "'s "
        set cli_o to cli_from - 4
        repeat while cli_o is greater than 1 and cli_lsp_word_char(item (cli_o - 1) of cli_text)
            set cli_o to cli_o - 1
        end
        set cli_owner to items cli_o to (cli_from - 4) of cli_text
    end
    return record with word cli_word, owner cli_owner
end

# what a name at a position means: the thing it's made as, the nearest first (an input of the function the
# position is in, a variable made in it, then outside it), or nothing
to cli_lsp_meaning with cli_path, cli_source, cli_line, cli_char
    set cli_lines to split cli_source by "\n"
    set cli_named to cli_lsp_name_at(cli_lines, cli_line, cli_char)
    if cli_named is nothing
        return nothing
    end
    set cli_tree to tree of cli_lsp_known(cli_path, cli_source)
    if cli_tree is nothing
        return nothing
    end
    set cli_made to empty list
    cli_lsp_made(cli_tree, nothing, cli_made, empty dictionary)
    set cli_want to lowercase of word of cli_named
    set cli_full to nothing
    if owner of cli_named is not nothing
        set cli_full to lowercase of owner of cli_named + "'s " + cli_want
    end
    # the functions the position is in, innermost last, as lines from and to
    set cli_best to nothing
    set cli_best_depth to -1
    for each cli_m in cli_made
        set cli_name to lowercase of name of cli_m
        set cli_fits to no
        if cli_full is not nothing
            set cli_fits to cli_name is cli_full or (what of cli_m is "method" and cli_lsp_own_name(cli_name) is cli_want)
        else
            set cli_fits to cli_name is cli_want
        end
        if cli_fits
            set cli_depth to cli_lsp_scope_depth(cli_lines, cli_m, cli_line + 1)
            if cli_depth is greater than cli_best_depth
                set cli_best to cli_m
                set cli_best_depth to cli_depth
            end
        end
    end
    if cli_best is nothing and cli_full is nothing # a kind's own function, on the line that makes it
        for each cli_m in cli_made
            if what of cli_m is "method" and file of cli_m is "" and line of cli_m is cli_line + 1
                if lowercase of cli_lsp_own_name(name of cli_m) is cli_want
                    set cli_best to cli_m
                end
            end
        end
    end
    return cli_best
end

# how close what's made is to a line of the document: -1 if the line can't see it; 0 if it's made outside any
# function; else how far in the function it's made in is written, so an input of the function the line is in
# beats a variable of the function around it
to cli_lsp_scope_depth with cli_lines, cli_m, cli_line
    if inside of cli_m is nothing
        return 0
    end
    set cli_d to inside of cli_m
    if file of at of cli_d is not ""
        return -1
    end
    set cli_from to line of at of cli_d
    if cli_line is less than cli_from or cli_line is greater than cli_lsp_end_line(cli_lines, cli_from)
        return -1
    end
    return col of at of cli_d
end

# Where a thing is made, as the protocol has a place in a file; or nothing for one made in a file of the
# standard library's that's moth's own copy, which isn't on the disk for the editor to open
to cli_lsp_location with cli_uri, cli_path, cli_source, cli_m
    set cli_uri_of to cli_uri
    if file of cli_m is not ""
        if not cli_lsp_on_disk(cli_folder_of(cli_path) + file of cli_m)
            return nothing
        end
        set cli_uri_of to cli_lsp_uri(cli_folder_of(cli_path) + file of cli_m)
    end
    set cli_lines to split cli_lsp_file_text(cli_path, cli_source, file of cli_m) by "\n"
    set cli_text to cli_lsp_line(cli_lines, line of cli_m)
    set cli_at to cli_lsp_name_col(cli_text, col of cli_m, name of cli_m)
    if what of cli_m is "input"
        set cli_at to cli_lsp_name_col(cli_text, col of cli_m + 1, name of cli_m)
    end
    return dictionary where "uri" is cli_uri_of, "range" is cli_lsp_range(line of cli_m - 1, cli_at - 1, line of cli_m - 1, cli_at - 1 + length of cli_lsp_own_name(name of cli_m))
end

# the comment lines just above a line, as a function's own words for what it does
to cli_lsp_comment_above with cli_lines, cli_n
    set cli_first_line to cli_n
    repeat while cli_first_line is greater than 1 and cli_begins_with(cli_trimmed_front(cli_lsp_line(cli_lines, cli_first_line - 1)), "#")
        set cli_first_line to cli_first_line - 1
    end
    set cli_said to ""
    for each cli_k from cli_first_line to cli_n - 1
        set cli_words to cli_trimmed_front(cli_tail(cli_trimmed_front(cli_lsp_line(cli_lines, cli_k)), 2))
        if cli_said is not "" and cli_words is not ""
            add " " to cli_said
        end
        add cli_trimmed(cli_words) to cli_said
    end
    return cli_said
end

# whether a file is there to open: one the editor has open, or one on the disk
to cli_lsp_on_disk with cli_path
    if cli_path is in cli_open_texts
        return yes
    end
    try
        return length of (read cli_path) is at least 0
    if it fails
        return no
    end
end

# A type as a hover says it ("a number", "yes or no", "a list of dogs", "a dog or nothing"), or nothing if
# it isn't known
to cli_lsp_type_words with cli_t
    if cli_t is nothing or cli_t is "?"
        return nothing
    end
    if cli_begins_with(cli_t, "maybe:")
        set cli_inner to cli_lsp_type_words(cli_tail(cli_t, 7))
        if cli_inner is nothing
            return nothing
        end
        return cli_inner + " or nothing"
    end
    if cli_t is "yes/no"
        return "yes or no"
    end
    return cli_described(cli_t)
end

# What the checker worked out a thing holds, as words, or nothing if that isn't known: a variable's value
# ("set"), an input's ("input w"), or what a function gives ("gives"). What the code says of itself counts.
to cli_lsp_type_of with cli_known, cli_m, cli_what
    return cli_lsp_type_words(cli_lsp_raw_type(cli_known, cli_m, cli_what))
end

# the same, as the checker writes a type: "number", "record:dog", "list:text"..., or nothing
to cli_lsp_raw_type with cli_known, cli_m, cli_what
    set cli_state to cli_lsp_state(cli_known)
    if cli_state is nothing
        return nothing
    end
    set cli_place to file of cli_m + ":" + line of cli_m + ":" + col of cli_m + " " + cli_what
    if not (cli_place is in places of cli_state)
        return nothing
    end
    set cli_key to item cli_place of places of cli_state
    set cli_t to nothing
    if cli_key is in said of cli_state
        set cli_t to item cli_key of said of cli_state
    end
    if (cli_t is nothing or cli_t is "?") and cli_key is in sure of cli_state
        set cli_t to item cli_key of sure of cli_state
    end
    return cli_t
end

# What a name is, for a hover: a variable or an input, with what it holds where that's known; or how a
# function or a kind is made, in Moth, with what it takes and gives, and the comment above it
to cli_lsp_hover_text with cli_path, cli_source, cli_m
    set cli_known to cli_lsp_known(cli_path, cli_source)
    set cli_lines to split cli_lsp_file_text(cli_path, cli_source, file of cli_m) by "\n"
    set cli_code to ""
    set cli_d to define of cli_m
    set cli_in to ""
    if file of cli_m is not ""
        set cli_in to " of " + file of cli_m
    end
    if what of cli_m is "input"
        set cli_said to nothing
        for each cli_k from 1 to length of params of cli_d
            if lowercase of item cli_k of params of cli_d is lowercase of name of cli_m
                if types of cli_d is not nothing and item cli_k of types of cli_d is not nothing
                    set cli_said to item cli_k of types of cli_d
                else if item cli_k of kinds of cli_d is at least 0
                    set cli_said to item (item cli_k of kinds of cli_d + 1) of cli_kind_words
                end
            end
        end
        if cli_said is nothing
            set cli_said to cli_lsp_type_of(cli_known, cli_m, "input " + lowercase of name of cli_m)
        end
        set cli_code to "`" + name of cli_m + "`, an input of `" + name of cli_d + "`"
        if cli_said is not nothing
            set cli_code to cli_code + ": " + cli_said
        end
        return cli_code
    end
    if what of cli_m is "variable"
        set cli_code to "`" + name of cli_m + "`, a variable"
        set cli_holds_now to cli_lsp_type_of(cli_known, cli_m, "set")
        if cli_holds_now is not nothing
            set cli_code to cli_code + ": " + cli_holds_now
        end
        return cli_code + "\n\nFirst set on line " + line of cli_m + cli_in + "."
    end
    set cli_sig to cli_lsp_signature(cli_d)
    if what of cli_m is "kind"
        set cli_code to "kind " + made_kind of cli_d
    else
        set cli_code to "to " + cli_lsp_own_name(name of cli_d)
    end
    if cli_sig is not ""
        set cli_code to cli_code + " " + cli_sig
    end
    set cli_said to "```moth\n" + cli_code + "\n```"
    if what of cli_m is not "kind" and gives of cli_d is nothing # what it gives, as the checker works it out
        set cli_gives to cli_lsp_type_of(cli_known, cli_m, "gives")
        if cli_gives is not nothing
            set cli_said to cli_said + "\n\nGives " + cli_gives + "."
        end
    end
    set cli_comment to cli_lsp_comment_above(cli_lines, line of cli_m)
    if cli_comment is not ""
        set cli_said to cli_said + "\n\n" + cli_comment
    end
    if file of cli_m is not ""
        set cli_said to cli_said + "\n\nIn " + file of cli_m + ", line " + line of cli_m + "."
    end
    return cli_said
end

# ----- the files a document uses -----

# what a `use` line names: a record with file (the path, from the folder of the file that uses it), called (the
# name it's used as, or nothing), and from and upto (the characters of the line its name in quotes is at),
# or nothing for a line that isn't a use line
to cli_lsp_use_line with cli_text
    set cli_k to 1
    repeat while cli_k is at most length of cli_text and (item cli_k of cli_text is " " or item cli_k of cli_text is "\t")
        add 1 to cli_k
    end
    set cli_rest to cli_tail(cli_text, cli_k)
    set cli_package to no
    if cli_begins_with(cli_rest, "use the package \"")
        set cli_package to yes
        add 17 to cli_k
    else if cli_begins_with(cli_rest, "use \"")
        add 5 to cli_k
    else
        return nothing
    end
    set cli_from to cli_k
    repeat while cli_k is at most length of cli_text and item cli_k of cli_text is not "\""
        add 1 to cli_k
    end
    if cli_k is greater than length of cli_text
        return nothing
    end
    set cli_name to ""
    if cli_k is greater than cli_from
        set cli_name to items cli_from to (cli_k - 1) of cli_text
    end
    set cli_upto to cli_k - 1
    set cli_as to nothing
    set cli_after to cli_trimmed(cli_tail(cli_text, cli_k + 1))
    if cli_begins_with(cli_after, " as ")
        set cli_as to cli_trimmed_front(cli_tail(cli_after, 5))
        set cli_cut to position of "#" in cli_as
        if cli_cut is greater than 0
            set cli_as to cli_trimmed(cli_first(cli_as, cli_cut - 1))
        end
    end
    set cli_file to cli_name
    if cli_package
        set cli_file to "packages/" + cli_name + "/" + cli_name + ".moth"
    end
    return record with file cli_file, called cli_as, from cli_from, upto cli_upto
end

# The file a position names: on the name in quotes of a `use` line, or on the name a file is used as
# (shapes, in shapes's area): a record with path and text (the use line), or nothing
to cli_lsp_used_at with cli_path, cli_lines, cli_line, cli_char
    set cli_named to cli_lsp_name_at(cli_lines, cli_line, cli_char)
    for each cli_k from 1 to length of cli_lines
        set cli_text to cli_lsp_line(cli_lines, cli_k)
        set cli_use to cli_lsp_use_line(cli_text)
        if cli_use is not nothing
            set cli_on to no
            if cli_k is cli_line + 1
                set cli_at to cli_lsp_char_at(cli_text, cli_char + 1)
                set cli_on to cli_at is at least from of cli_use and cli_at is at most upto of cli_use + 1
            end
            if not cli_on and cli_named is not nothing and owner of cli_named is nothing and called of cli_use is not nothing
                set cli_on to lowercase of word of cli_named is lowercase of called of cli_use
            end
            if cli_on
                return record with path cli_folder_of(cli_path) + file of cli_use, file file of cli_use, text cli_trimmed(cli_trimmed_front(cli_text))
            end
        end
    end
    return nothing
end

# the comment a file starts with, its first paragraph, as what it's for
to cli_lsp_file_comment with cli_text
    set cli_said to ""
    for each cli_line in split cli_text by "\n"
        set cli_rest to cli_trimmed(cli_trimmed_front(cli_line))
        if not cli_begins_with(cli_rest, "#")
            return cli_said
        end
        set cli_words to cli_trimmed_front(cli_tail(cli_rest, 2))
        if cli_words is "" and cli_said is not ""
            return cli_said
        end
        if cli_said is not "" and cli_words is not ""
            add " " to cli_said
        end
        add cli_words to cli_said
    end
    return cli_said
end

# the names that could come next: Moth's words, and what the program makes that the position can see, or
# after `x's`, what x has
to cli_lsp_completions with cli_path, cli_source, cli_line, cli_char
    set cli_out to empty list
    set cli_lines to split cli_source by "\n"
    set cli_text to cli_lsp_line(cli_lines, cli_line + 1)
    set cli_upto to cli_lsp_char_at(cli_text, cli_char + 1) - 1
    set cli_before to ""
    if cli_upto is at least 1
        set cli_before to items 1 to cli_upto of cli_text
    end
    set cli_k to length of cli_before
    repeat while cli_k is at least 1 and cli_lsp_word_char(item cli_k of cli_before)
        set cli_k to cli_k - 1
    end
    set cli_owner to nothing
    if cli_k is at least 4 and (items (cli_k - 2) to cli_k of cli_before) is "'s "
        set cli_o to cli_k - 3
        repeat while cli_o is greater than 1 and cli_lsp_word_char(item (cli_o - 1) of cli_before)
            set cli_o to cli_o - 1
        end
        set cli_owner to lowercase of (items cli_o to (cli_k - 3) of cli_before)
    end
    set cli_tree to tree of cli_lsp_known(cli_path, cli_source)
    set cli_made to empty list
    if cli_tree is not nothing
        cli_lsp_made(cli_tree, nothing, cli_made, empty dictionary)
    end
    set cli_seen to empty dictionary
    for each cli_m in cli_made
        set cli_name to name of cli_m
        set cli_label to nothing
        if cli_owner is not nothing
            if "'s " is in cli_name and lowercase of cli_first(cli_name, (position of "'s " in cli_name) - 1) is cli_owner
                set cli_label to cli_lsp_own_name(cli_name)
            end
        else if not ("'s " is in cli_name) and cli_lsp_scope_depth(cli_lines, cli_m, cli_line + 1) is at least 0
            set cli_label to cli_name
        end
        if cli_label is not nothing and not (lowercase of cli_label is in cli_seen)
            set item (lowercase of cli_label) of cli_seen to yes
            set cli_item to dictionary where "label" is cli_label, "kind" is cli_lsp_completion_kind(what of cli_m)
            if define of cli_m is not nothing and what of cli_m is not "input"
                set item "detail" of cli_item to cli_lsp_signature(define of cli_m)
            end
            add cli_item to cli_out
        end
    end
    if cli_owner is not nothing and length of cli_out is 0 # x's, for x a record a kind makes: what the kind has
        set cli_at to cli_width_of(cli_first(cli_before, cli_o - 1))
        set cli_m to cli_lsp_meaning(cli_path, cli_source, cli_line, cli_at)
        if cli_m is not nothing and (what of cli_m is "variable" or what of cli_m is "input")
            set cli_what_it_is to "set"
            if what of cli_m is "input"
                set cli_what_it_is to "input " + lowercase of name of cli_m
            end
            set cli_known to cli_lsp_known(cli_path, cli_source)
            set cli_t to cli_lsp_raw_type(cli_known, cli_m, cli_what_it_is)
            if cli_t is not nothing and cli_begins_with(cli_t, "maybe:")
                set cli_t to cli_tail(cli_t, 7)
            end
            if cli_t is not nothing and cli_begins_with(cli_t, "record:")
                for each cli_item in cli_lsp_kind_has(cli_lsp_state(cli_known), cli_tail(cli_t, 8), cli_made)
                    add cli_item to cli_out
                end
            end
        end
    end
    if cli_owner is nothing
        for each cli_w in cli_lsp_words
            add (dictionary where "label" is cli_w, "kind" is 14) to cli_out
        end
    end
    return cli_out
end

# what a record the kind makes has, for completion: each input of the kind (and of the kind it's made from)
# as a field, and each of its functions, with what it takes
to cli_lsp_kind_has with cli_state, cli_name, cli_made
    set cli_out to empty list
    if cli_state is nothing
        return cli_out
    end
    set cli_seen to empty dictionary
    set cli_kind to cli_kind_named(cli_state, cli_name)
    set cli_from to cli_name
    set cli_steps to 0
    repeat while cli_kind is not nothing and cli_steps is less than 20
        for each cli_p in params of define of cli_kind
            if not (lowercase of cli_p is in cli_seen)
                set item (lowercase of cli_p) of cli_seen to yes
                add (dictionary where "label" is cli_p, "kind" is 5) to cli_out
            end
        end
        for each cli_own in owns of cli_kind
            if not (lowercase of cli_own is in cli_seen)
                set item (lowercase of cli_own) of cli_seen to yes
                set cli_item to dictionary where "label" is cli_own, "kind" is 2
                for each cli_m in cli_made
                    if lowercase of name of cli_m is lowercase of (cli_from + "'s " + cli_own) and define of cli_m is not nothing
                        set item "detail" of cli_item to cli_lsp_signature(define of cli_m)
                    end
                end
                add cli_item to cli_out
            end
        end
        set cli_from to cli_parent_kind(cli_state, cli_kind)
        set cli_kind to cli_kind_named(cli_state, cli_from)
        add 1 to cli_steps
    end
    return cli_out
end

to cli_lsp_completion_kind with cli_what
    if cli_what is "kind"
        return 7
    else if cli_what is "method"
        return 2
    else if cli_what is "function"
        return 3
    end
    return 6
end

# ----- the conversation -----

to cli_lsp_handle with cli_state, cli_msg
    set cli_method to cli_lsp_get(cli_msg, "method")
    set cli_id to cli_lsp_get(cli_msg, "id")
    set cli_params to cli_lsp_get(cli_msg, "params")
    set cli_doc to cli_lsp_get(cli_params, "textDocument")
    set cli_uri to cli_lsp_get(cli_doc, "uri")
    set cli_docs to docs of cli_state
    if cli_method is "initialize"
        # an editor that finds the problems itself (the VS Code extension, with Moth's engine) can ask for none
        set cli_options to cli_lsp_get(cli_params, "initializationOptions")
        if cli_lsp_get(cli_options, "diagnostics") is no
            set publish of cli_state to no
        end
        set cli_sync to dictionary where "openClose" is yes, "change" is 1, "save" is yes
        set cli_can to dictionary where "textDocumentSync" is cli_sync, "documentFormattingProvider" is yes, "documentSymbolProvider" is yes,
            "definitionProvider" is yes, "hoverProvider" is yes, "completionProvider" is (dictionary where "triggerCharacters" is (list of "'"))
        cli_lsp_reply(cli_id, dictionary where "capabilities" is cli_can, "serverInfo" is (dictionary where "name" is "moth"))
    else if cli_method is "shutdown"
        set down of cli_state to yes
        cli_lsp_reply(cli_id, nothing)
    else if cli_method is "textDocument/didOpen"
        cli_lsp_keep(cli_state, cli_uri, item "text" of cli_doc)
    else if cli_method is "textDocument/didChange"
        set cli_changes to item "contentChanges" of cli_params
        if length of cli_changes is greater than 0
            cli_lsp_keep(cli_state, cli_uri, item "text" of item (length of cli_changes) of cli_changes)
        end
    else if cli_method is "textDocument/didSave"
        if cli_uri is in cli_docs and publish of cli_state
            cli_lsp_publish(cli_uri, item cli_uri of cli_docs)
        end
    else if cli_method is "textDocument/didClose"
        cli_lsp_keep(cli_state, cli_uri, nothing)
    else if cli_id is not nothing and cli_method is not nothing and cli_begins_with(cli_method, "textDocument/") and cli_uri is not nothing
        set cli_source to nothing
        if cli_uri is in cli_docs
            set cli_source to item cli_uri of cli_docs
        else
            set cli_source to read cli_lsp_path(cli_uri)
        end
        set cli_path to cli_lsp_path(cli_uri)
        set cli_place to cli_lsp_get(cli_params, "position")
        if cli_method is "textDocument/formatting"
            set cli_tidy to nothing
            try
                set cli_tidy to cli_format(cli_source)
            if it fails with cli_why
                set cli_said to "" + cli_why
                if cli_is_problem(cli_why)
                    set cli_said to reason of cli_why
                end
                cli_lsp_tell("window/showMessage", dictionary where "type" is 2, "message" is "Moth can't tidy this until its mistake is put right: " + cli_said)
            end
            if cli_tidy is nothing or cli_tidy is cli_source
                cli_lsp_reply(cli_id, empty list)
            else
                set cli_lines to split cli_source by "\n"
                set cli_last to cli_lsp_line(cli_lines, length of cli_lines)
                set cli_edit to dictionary where "range" is cli_lsp_range(0, 0, length of cli_lines - 1, cli_width_of(cli_last)), "newText" is cli_tidy
                cli_lsp_reply(cli_id, list of cli_edit)
            end
        else if cli_method is "textDocument/documentSymbol"
            cli_lsp_reply(cli_id, cli_lsp_symbols(cli_path, cli_source))
        else if cli_method is "textDocument/definition"
            set cli_m to cli_lsp_meaning(cli_path, cli_source, item "line" of cli_place, item "character" of cli_place)
            set cli_file to nothing
            if cli_m is nothing
                set cli_file to cli_lsp_used_at(cli_path, (split cli_source by "\n"), item "line" of cli_place, item "character" of cli_place)
            end
            if cli_m is not nothing
                cli_lsp_reply(cli_id, cli_lsp_location(cli_uri, cli_path, cli_source, cli_m))
            else if cli_file is not nothing and cli_lsp_on_disk(path of cli_file) # the file itself, from its start
                cli_lsp_reply(cli_id, dictionary where "uri" is cli_lsp_uri(path of cli_file), "range" is cli_lsp_range(0, 0, 0, 0))
            else
                cli_lsp_reply(cli_id, nothing)
            end
        else if cli_method is "textDocument/hover"
            set cli_m to cli_lsp_meaning(cli_path, cli_source, item "line" of cli_place, item "character" of cli_place)
            set cli_said to nothing
            if cli_m is not nothing
                set cli_said to cli_lsp_hover_text(cli_path, cli_source, cli_m)
            else
                set cli_file to cli_lsp_used_at(cli_path, (split cli_source by "\n"), item "line" of cli_place, item "character" of cli_place)
                if cli_file is not nothing # the use line, and what the file says it's for
                    set cli_said to "```moth\n" + text of cli_file + "\n```"
                    set cli_about to cli_lsp_file_comment(cli_lsp_file_text(cli_path, cli_source, file of cli_file))
                    if cli_about is not ""
                        set cli_said to cli_said + "\n\n" + cli_about
                    end
                end
            end
            if cli_said is nothing
                cli_lsp_reply(cli_id, nothing)
            else
                set cli_shown to dictionary where "kind" is "markdown", "value" is cli_said
                cli_lsp_reply(cli_id, dictionary where "contents" is cli_shown)
            end
        else if cli_method is "textDocument/completion"
            cli_lsp_reply(cli_id, cli_lsp_completions(cli_path, cli_source, item "line" of cli_place, item "character" of cli_place))
        else
            cli_lsp_unknown(cli_id, cli_method)
        end
    else if cli_id is not nothing and cli_method is not nothing
        cli_lsp_unknown(cli_id, cli_method)
    end
end

to cli_lsp_unknown with cli_id, cli_method
    set cli_error to dictionary where "code" is -32601, "message" is "moth lsp doesn't do " + cli_method
    cli_lsp_send(dictionary where "jsonrpc" is "2.0", "id" is cli_id, "error" is cli_error)
end

# A document's text as the editor has it now, or nothing once it's closed: kept, read in place of the file by
# the documents that use it, and its problems said again, and theirs, as they may have changed with it
to cli_lsp_keep with cli_state, cli_uri, cli_text
    set cli_docs to docs of cli_state
    set cli_path to cli_lsp_path(cli_uri)
    if cli_text is nothing
        if cli_uri is in cli_docs
            remove cli_uri from cli_docs
        end
        if cli_path is in cli_open_texts
            remove cli_path from cli_open_texts
        end
        if cli_path is in cli_lsp_kept
            remove cli_path from cli_lsp_kept
        end
    else
        set item cli_uri of cli_docs to cli_text
        set item cli_path of cli_open_texts to cli_text
    end
    if not publish of cli_state
        return nothing
    end
    cli_lsp_publish(cli_uri, cli_text)
    for each cli_other in cli_docs
        if cli_other is not cli_uri and cli_lsp_uses(cli_lsp_path(cli_other), cli_path)
            cli_lsp_publish(cli_other, item cli_other of cli_docs)
        end
    end
end

# whether the document at one path used the file at another, when its problems were last found
to cli_lsp_uses with cli_path, cli_used_path
    if not (cli_path is in cli_lsp_kept)
        return no
    end
    for each cli_name in names of used of item cli_path of cli_lsp_kept
        if cli_folder_of(cli_path) + cli_name is cli_used_path
            return yes
        end
    end
    return no
end

# `moth lsp`: messages answered until the editor says exit: 0 if it said shutdown first, as the protocol has it
to cli_lsp
    set cli_state to record with docs empty dictionary, down no, publish yes
    repeat while yes
        set cli_msg to cli_lsp_read()
        if cli_msg is nothing
            return 1
        end
        set cli_method to cli_lsp_get(cli_msg, "method")
        if cli_method is "exit"
            if down of cli_state
                return 0
            end
            return 1
        end
        try
            cli_lsp_handle(cli_state, cli_msg)
        if it fails with cli_why # a mistake in moth itself: said, and the conversation goes on
            set cli_said to "" + cli_why
            if cli_is_problem(cli_why)
                set cli_said to reason of cli_why
            end
            set cli_id to cli_lsp_get(cli_msg, "id")
            if cli_id is not nothing
                set cli_error to dictionary where "code" is -32603, "message" is cli_said
                cli_lsp_send(dictionary where "jsonrpc" is "2.0", "id" is cli_id, "error" is cli_error)
            else
                cli_lsp_tell("window/logMessage", dictionary where "type" is 1, "message" is cli_said)
            end
        end
    end
end

# ---------- the tests a file holds ----------
# `moth test` runs every function named test_... in a file, each in a run of its own, as test() in moth.js
# does. The file is built once, with lines at its end that call the test whose name the program is started
# with, and then started once for each test, with what it says kept: a run of its own, so one test can't
# spoil another. A file with no test_ functions is one test itself.

to cli_test_names with cli_body
    set cli_names to empty list
    for each cli_s in cli_body
        if kind of cli_s is "define" and length of name of cli_s is greater than 5 and cli_first(name of cli_s, 5) is "test_"
            add name of cli_s to cli_names
        end
    end
    return cli_names
end

# the lines that go at the end of the file: the test the program was started with, and nothing else
to cli_test_driver with cli_names
    set cli_out to ""
    for each cli_name in cli_names
        add "if item 1 of arguments is \"" + cli_name + "\"\n    " + cli_name + "()\nend\n" to cli_out
    end
    return cli_out
end

# a text's lines, without the empty one after the last
to cli_text_lines with cli_text
    set cli_all to split cli_text by "\n"
    set cli_out to empty list
    set cli_n to 0
    for each cli_line in cli_all
        add 1 to cli_n
        if cli_n is less than length of cli_all or cli_line is not ""
            add cli_line to cli_out
        end
    end
    return cli_out
end

# Whether a line of the calls that led to a mistake is the one that called the test: the command line puts
# that call after the file's own lines, and test() in moth.js leaves it out. A call in a file the program
# uses names the file, so it is never this one.
to cli_past_line with cli_line, cli_last
    if length of cli_line is less than 2 or cli_first(cli_line, 2) is not "  "
        return no
    end
    set cli_at to position of ", called from line " in cli_line
    if cli_at is 0
        return no
    end
    set cli_digits to cli_tail(cli_line, cli_at + 19)
    set cli_ends to position of " " in cli_digits
    if cli_ends is not 0
        set cli_digits to cli_first(cli_digits, cli_ends - 1)
    end
    try
        return number of cli_digits is greater than cli_last
    if it fails
        return no
    end
end

# what a test that failed says: where the mistake was, the calls that led there, and what it said, each
# line indented four spaces
to cli_test_report with cli_answer, cli_last
    set cli_lines to empty list
    for each cli_line in cli_text_lines(mistakes of cli_answer)
        if not cli_past_line(cli_line, cli_last)
            add cli_line to cli_lines
        end
    end
    if length of cli_lines is 0
        add "stopped the program with " + code of cli_answer to cli_lines
    end
    set cli_told to cli_text_lines(output of cli_answer)
    if length of cli_told is greater than 0
        add "it said:" to cli_lines
        for each cli_line in cli_told
            add "  " + cli_line to cli_lines
        end
    end
    for each cli_line in cli_lines
        say "    " + cli_line
    end
end

# one file's tests: a tick or a cross for each, and what a cross says; how many passed and how many failed
to cli_test_file with cli_path, cli_target, cli_allowing, cli_naming
    if cli_naming
        say cli_path
    end
    set cli_source to cli_text_of(cli_path)
    if cli_source is nothing
        return record with passed 0, failed 1
    end
    set cli_used to cli_sources_of(cli_path, cli_source)
    set cli_names to nothing
    try
        set cli_names to cli_test_names(machine's read_program(cli_source, cli_files_of(names of cli_used, texts of cli_used)))
    if it fails with cli_whytests # a mistake that stops the file from being read at all
        if cli_is_problem(cli_whytests)
            cli_report(cli_whytests, cli_path, cli_source, names of cli_used, texts of cli_used)
        else
            say "moth: " + cli_path + ": " + cli_whytests to the error output
        end
        return record with passed 0, failed 1
    end
    set cli_whole to length of cli_names is 0 # a file with no tests is one test itself
    set cli_driver to ""
    if not cli_whole
        set cli_driver to cli_test_driver(cli_names)
    else
        set cli_names to list of cli_name_of(cli_path)
    end
    set cli_temp to cli_temp_for(cli_path, cli_target, "-test")
    if cli_in_the_way(cli_temp)
        return record with passed 0, failed 1
    end
    if not cli_build_source(cli_path, cli_source + "\n" + cli_driver, cli_target, cli_allowing, cli_temp, no, cli_path)
        return record with passed 0, failed 1
    end
    set cli_passed to 0
    set cli_failed to 0
    set cli_last to length of split cli_source by "\n"
    for each cli_label in cli_names
        set cli_given to empty list
        if not cli_whole
            set cli_given to list of cli_label
        end
        set cli_answer to nothing
        try
            set cli_answer to run program cli_temp with cli_given keeping its output
        if it fails with cli_whyran
            say "moth: " + cli_whyran to the error output
        end
        if cli_answer is nothing
            add 1 to cli_failed
        else if code of cli_answer is 0
            say "✓ " + cli_label
            add 1 to cli_passed
        else
            say "✗ " + cli_label
            add 1 to cli_failed
            cli_test_report(cli_answer, cli_last)
        end
    end
    try
        remove the file cli_temp
    if it fails with cli_whyleft
        say "moth: " + cli_whyleft to the error output
    end
    return record with passed cli_passed, failed cli_failed
end

# Finding the tests when none are named, as the Node.js command line found them: every file ending in .test.moth
# in the folder moth runs in and the folders inside it, but not hidden ones or node_modules, in the order a
# person sorts names (JavaScript's localeCompare), each folder's before the next name after it.

# punctuation, as localeCompare sorts it: before digits, which come before letters
set cli_marks to "_-,;:!?.'\"()[]{}@*/\\&#%`^+<=>|~$"

# where a character comes in that order, ignoring case: a number, more for later
to cli_weight with cli_c
    set cli_at to position of cli_c in "0123456789"
    if cli_at is greater than 0
        return 200 + cli_at
    end
    set cli_at to position of cli_c in "abcdefghijklmnopqrstuvwxyz"
    if cli_at is 0
        set cli_at to position of cli_c in "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    end
    if cli_at is greater than 0
        return 300 + cli_at
    end
    set cli_at to position of cli_c in cli_marks
    if cli_at is greater than 0
        return 100 + cli_at
    end
    if cli_c is " " or cli_c is "\t"
        return 50
    end
    return 1000 + item 1 of (cli_c as bytes) # anything else after the letters, as its first byte has it
end

# whether name a comes before name b: by their characters ignoring case, then lower case before upper
to cli_collates_before with cli_a, cli_b
    set cli_ka to empty list
    for each cli_c in cli_a
        add cli_weight(cli_c) to cli_ka
    end
    set cli_kb to empty list
    for each cli_c in cli_b
        add cli_weight(cli_c) to cli_kb
    end
    set cli_n to length of cli_ka
    if length of cli_kb is less than cli_n
        set cli_n to length of cli_kb
    end
    for each cli_k from 1 to cli_n
        if item cli_k of cli_ka is not item cli_k of cli_kb
            return item cli_k of cli_ka is less than item cli_k of cli_kb
        end
    end
    if length of cli_ka is not length of cli_kb
        return length of cli_ka is less than length of cli_kb
    end
    for each cli_k from 1 to cli_n
        set cli_ca to item cli_k of cli_a
        set cli_cb to item cli_k of cli_b
        if cli_ca is not cli_cb
            return position of cli_ca in "abcdefghijklmnopqrstuvwxyz" is greater than 0
        end
    end
    return no
end

# a folder's names, a folder's without the / after it, as localeCompare sorts them: each with whether it's a folder
to cli_sorted_entries with cli_names
    set cli_entries to empty list
    for each cli_name in cli_names
        set cli_is_folder to cli_tail(cli_name, length of cli_name) is "/"
        set cli_bare to cli_name
        if cli_is_folder
            set cli_bare to cli_first(cli_name, length of cli_name - 1)
        end
        set cli_entry to record with name cli_bare, folder cli_is_folder
        set cli_k to length of cli_entries # into its place among those before it
        add cli_entry to cli_entries
        repeat while cli_k is at least 1 and cli_collates_before(cli_bare, name of item cli_k of cli_entries)
            set item (cli_k + 1) of cli_entries to item cli_k of cli_entries
            set item cli_k of cli_entries to cli_entry
            set cli_k to cli_k - 1
        end
    end
    return cli_entries
end

# the .test.moth files in a folder ("" for the one moth runs in) and those inside it, joined to it as Node's
# path.join joins them, with \ on Windows
to cli_find_tests with cli_folder, cli_sep, cli_found
    set cli_looked to cli_folder
    if cli_looked is ""
        set cli_looked to "."
    end
    for each cli_entry in cli_sorted_entries(read the folder cli_looked)
        set cli_name to name of cli_entry
        set cli_path to cli_name
        if cli_folder is not ""
            set cli_path to cli_folder + cli_sep + cli_name
        end
        if cli_first(cli_name, 1) is not "." and cli_name is not "node_modules"
            if folder of cli_entry
                cli_find_tests(cli_path, cli_sep, cli_found)
            else if length of cli_name is greater than 10 and cli_tail(cli_name, length of cli_name - 9) is ".test.moth"
                add cli_path to cli_found
            end
        end
    end
    return cli_found
end

# `moth test a.test.moth b.test.moth`: every file's tests, then how many passed; 1 if any failed
to cli_test_all with cli_paths, cli_target, cli_allowing
    set cli_passed to 0
    set cli_failed to 0
    for each cli_path in cli_paths
        set cli_counts to cli_test_file(cli_path, cli_target, cli_allowing, length of cli_paths is greater than 1)
        add passed of cli_counts to cli_passed
        add failed of cli_counts to cli_failed
    end
    set cli_told to cli_passed + " passed"
    if cli_failed is not 0
        set cli_told to cli_told + ", " + cli_failed + " failed"
    end
    say cli_told
    if cli_failed is not 0
        return 1
    end
    return 0
end

# ---------- packages ----------
# The packages a program uses are in packages/, in the folder moth runs in, each a Git repository's clone,
# whose main file is named after it, and listed in moth.packages there: a line for each, its name, where it
# comes from (a site's address, or a folder) and the commit it's at, so `moth get` fetches the same ones
# anywhere. moth.sums beside it has the SHA-256 of each one's files at that commit, which `moth get` checks
# (DESIGN §103).

# git, run with these arguments, keeping what it says; or nothing, said why, if it can't be started. On
# Windows a package's files can be deeper than 260 characters, which git takes only when told to. A package's
# files are checked out as they are in the repository, whatever the system or the person's own settings, so
# their sum is the same everywhere: line ends as they were committed, and a symbolic link as a file holding
# where it points.
to cli_git with cli_git_args
    set cli_all_args to list of "-c", "core.longpaths=true", "-c", "core.autocrlf=false", "-c", "core.eol=lf", "-c", "core.symlinks=false"
    for each cli_arg in cli_git_args
        add cli_arg to cli_all_args
    end
    try
        return run program "git" with cli_all_args keeping its output
    if it fails with cli_git_why
        say "moth: packages need Git, which couldn't be started: " + cli_git_why to the error output
        return nothing
    end
end

# what git said went wrong, on one line
to cli_git_said with cli_answer
    set cli_said to cli_trimmed(mistakes of cli_answer)
    if cli_said is ""
        set cli_said to cli_trimmed(output of cli_answer)
    end
    set cli_one to ""
    for each cli_c in cli_said
        if cli_c is "\n"
            add " " to cli_one
        else if cli_c is not "\r"
            add cli_c to cli_one
        end
    end
    return cli_one
end

to cli_folder_here with cli_path
    try
        set cli_inside to read the folder cli_path
        return yes
    if it fails
        return no
    end
end

to cli_is_file with cli_path
    try
        set cli_held to read bytes cli_path
        return yes
    if it fails
        return no
    end
end

# a file's text, or nothing if it can't be read
to cli_read_or_nothing with cli_path
    try
        return read cli_path
    if it fails
        return nothing
    end
end

# a package's name: letters, digits, '-', '_' and '.', as `use the package` takes
to cli_package_name with cli_name
    if cli_name is "" or cli_name is "." or cli_name is ".."
        return no
    end
    for each cli_c in cli_name
        if not (cli_in_word(cli_c) or cli_c is "-" or cli_c is ".")
            return no
        end
    end
    return yes
end

# the name a repository's package gets when none is given: its last part, without .git
to cli_package_name_of with cli_source
    set cli_parts to empty list
    for each cli_part in split cli_source by "/"
        for each cli_piece in split cli_part by "\\"
            if cli_piece is not ""
                add cli_piece to cli_parts
            end
        end
    end
    if length of cli_parts is 0
        return ""
    end
    set cli_last to item (length of cli_parts) of cli_parts
    if length of cli_last is greater than 4 and cli_tail(cli_last, length of cli_last - 3) is ".git"
        return cli_first(cli_last, length of cli_last - 4)
    end
    return cli_last
end

# a line's words, the spaces between them gone
to cli_words_of with cli_line
    set cli_found to empty list
    for each cli_word in split cli_trimmed(cli_line) by " "
        if cli_word is not ""
            add cli_word to cli_found
        end
    end
    return cli_found
end

# the packages a moth.packages text lists, each a record of its name, source and commit, and its sum: what a
# moth.sums text (or nothing) has for that name at that commit, or nothing
to cli_packages_in with cli_text, cli_sums_text
    set cli_sums to empty list
    if cli_sums_text is not nothing
        for each cli_line in cli_text_lines(cli_sums_text)
            set cli_words to cli_words_of(cli_line)
            if length of cli_words is 3 and item 1 of item 1 of cli_words is not "#"
                add cli_words to cli_sums
            end
        end
    end
    set cli_list to empty list
    for each cli_line in cli_text_lines(cli_text)
        set cli_words to cli_words_of(cli_line)
        if length of cli_words is at least 3 and item 1 of item 1 of cli_words is not "#"
            set cli_from to ""
            for each cli_k from 2 to length of cli_words - 1
                if cli_k is greater than 2
                    add " " to cli_from
                end
                add item cli_k of cli_words to cli_from
            end
            set cli_name to item 1 of cli_words
            set cli_commit to item (length of cli_words) of cli_words
            set cli_sum to nothing
            for each cli_known in cli_sums
                if item 1 of cli_known is cli_name and item 2 of cli_known is cli_commit
                    set cli_sum to item 3 of cli_known
                end
            end
            add record with name cli_name, source cli_from, commit cli_commit, sum cli_sum to cli_list
        end
    end
    return cli_list
end

# moth.packages, read, with moth.sums's sums: a record of each line's name, source, commit and sum, or nothing
# if there isn't one
to cli_package_list
    set cli_text to cli_read_or_nothing("moth.packages")
    if cli_text is nothing
        return nothing
    end
    return cli_packages_in(cli_text, cli_read_or_nothing("moth.sums"))
end

to cli_write_packages with cli_list
    set cli_out to "# The packages this program uses: each one's name, where it comes from, and the commit it's at.\n# moth get fetches them into packages/, and moth add, update and remove change this list.\n"
    for each cli_one in cli_list
        add name of cli_one + " " + source of cli_one + " " + commit of cli_one + "\n" to cli_out
    end
    write cli_out to "moth.packages"
    cli_write_sums(cli_list)
end

# moth.sums: each package's name, its commit and the SHA-256 of its files there
to cli_write_sums with cli_list
    set cli_out to "# The SHA-256 of each package's files at the commit moth.packages has it at: its name, the commit and the sum.\n# moth add and update write them, and moth get checks them.\n"
    for each cli_one in cli_list
        if sum of cli_one is not nothing
            add name of cli_one + " " + commit of cli_one + " " + sum of cli_one + "\n" to cli_out
        end
    end
    write cli_out to "moth.sums"
end

to cli_short with cli_commit
    return cli_first(cli_commit, 7)
end

# the commit a package's clone is at, or nothing
to cli_head with cli_dir
    set cli_answer to cli_git(list of "-C", cli_dir, "rev-parse", "HEAD")
    if cli_answer is nothing or code of cli_answer is not 0
        return nothing
    end
    return cli_trimmed(output of cli_answer)
end

# a package's clone, at `cli_commit`, or its newest if nothing: the commit it's at, or nothing, said why
to cli_fetch with cli_name, cli_source, cli_commit
    set cli_dir to "packages/" + cli_name
    set cli_split to cli_source_and_ref(cli_source)
    set cli_answer to cli_git(list of "clone", "--quiet", place of cli_split, cli_dir)
    if cli_answer is nothing
        return nothing
    end
    if code of cli_answer is not 0
        say "moth: git couldn't fetch " + place of cli_split + ": " + cli_git_said(cli_answer) to the error output
        return nothing
    end
    if cli_commit is nothing and ref of cli_split is not nothing # the version wanted: a tag, a branch or a commit
        set cli_answer to cli_git(list of "-C", cli_dir, "checkout", "--quiet", ref of cli_split)
        if cli_answer is nothing
            return nothing
        end
        if code of cli_answer is not 0
            say "moth: " + place of cli_split + " has no tag, branch or commit called " + ref of cli_split + ": " + cli_git_said(cli_answer) to the error output
            return nothing
        end
    end
    if cli_commit is not nothing
        set cli_answer to cli_git(list of "-C", cli_dir, "checkout", "--quiet", cli_commit)
        if cli_answer is nothing
            return nothing
        end
        if code of cli_answer is not 0
            say "moth: " + cli_name + "'s commit " + cli_commit + " isn't in " + cli_source + ": " + cli_git_said(cli_answer) to the error output
            return nothing
        end
    end
    return cli_head(cli_dir)
end

# a package's clone moved to `cli_commit`, fetching what it hasn't got if need be: whether it is
to cli_move_to with cli_name, cli_commit
    set cli_dir to "packages/" + cli_name
    if cli_head(cli_dir) is cli_commit
        return yes
    end
    set cli_answer to cli_git(list of "-C", cli_dir, "checkout", "--quiet", cli_commit)
    if cli_answer is nothing
        return no
    end
    if code of cli_answer is not 0
        set cli_fetched to cli_git(list of "-C", cli_dir, "fetch", "--quiet", "origin")
        if cli_fetched is nothing
            return no
        end
        set cli_answer to cli_git(list of "-C", cli_dir, "checkout", "--quiet", cli_commit)
    end
    if code of cli_answer is not 0
        say "moth: " + cli_name + " couldn't go to commit " + cli_commit + ": " + cli_git_said(cli_answer) to the error output
        return no
    end
    return yes
end

# a folder and everything in it, gone, by the system's own command: whether it is
to cli_remove_folder with cli_path
    try
        if cli_host() is "windows"
            set cli_windows_path to ""
            for each cli_c in cli_path
                if cli_c is "/"
                    add "\\" to cli_windows_path
                else
                    add cli_c to cli_windows_path
                end
            end
            set cli_code to run program "cmd" with (list of "/c", "rmdir", "/s", "/q", cli_windows_path)
        else
            set cli_code to run program "rm" with (list of "-rf", cli_path)
        end
        return cli_code is 0 and not cli_folder_here(cli_path)
    if it fails with cli_why
        say "moth: " + cli_why to the error output
        return no
    end
end

# ---------- what packages are made of: their sums and signatures ----------

# every file in a package's folder but Git's own (a .git folder or file, at any depth), by its path there with
# / between its parts, added to cli_found; cli_inside is the folder inside it being looked in, "" or ending in /
to cli_package_files with cli_dir, cli_inside, cli_found
    set cli_at to cli_dir
    if cli_inside is not ""
        set cli_at to cli_dir + "/" + cli_first(cli_inside, length of cli_inside - 1)
    end
    for each cli_entry in read the folder cli_at
        if cli_entry is not ".git/" and cli_entry is not ".git"
            if item (length of cli_entry) of cli_entry is "/"
                cli_package_files(cli_dir, cli_inside + cli_entry, cli_found)
            else
                add cli_inside + cli_entry to cli_found
            end
        end
    end
end

# the sum of a package's files: for each, in order of its path, the SHA-256 of what's in it in hex, two spaces,
# its path and a line end, as sha256sum writes them; and the SHA-256 of all that, after "sha256:". Nothing,
# said, if a file can't be read
to cli_files_sum with cli_dir
    set cli_paths to empty list
    set cli_lines to ""
    try
        cli_package_files(cli_dir, "", cli_paths)
        for each cli_path in cli_paths in order
            add cli_hashing's sha256(read bytes (cli_dir + "/" + cli_path)) + "  " + cli_path + "\n" to cli_lines
        end
    if it fails with cli_why
        say "moth: can't read the files in " + cli_dir + ": " + cli_why to the error output
        return nothing
    end
    return "sha256:" + cli_hashing's sha256(cli_lines)
end

# what git sees changed in a package's folder, for a message: the files changed, added or taken away
to cli_changed_files with cli_dir
    set cli_answer to cli_git(list of "-C", cli_dir, "status", "--porcelain", "--untracked-files=all", "--ignored")
    if cli_answer is nothing or code of cli_answer is not 0
        return ""
    end
    set cli_paths to empty list
    for each cli_line in cli_text_lines(output of cli_answer)
        set cli_line_now to cli_trimmed(cli_line)
        if length of cli_line_now is greater than 3
            add cli_tail(cli_line_now, 4) to cli_paths
        end
    end
    return join cli_paths with ", "
end

# whether a package's files are the ones its sum says, its sum written into the record if it has none yet; said
# if not. cli_fresh: whether moth has just fetched it, so a difference comes from where it was fetched from, and
# the folder is taken away so that nothing uses it; cli_using: the package whose moth.sums the sum came from,
# or nothing for this folder's
to cli_check_sum with cli_one, cli_fresh, cli_using
    set cli_dir to "packages/" + name of cli_one
    set cli_now to cli_files_sum(cli_dir)
    if cli_now is nothing
        return no
    end
    if sum of cli_one is nothing
        set sum of cli_one to cli_now
        return yes
    end
    if cli_now is sum of cli_one
        return yes
    end
    if not cli_fresh
        set cli_which to cli_changed_files(cli_dir)
        if cli_which is not ""
            set cli_which to " (" + cli_which + ")"
        end
        say "moth: " + cli_dir + " has changed since it was fetched" + cli_which + ": remove that folder, and moth get fetches it again" to the error output
        return no
    end
    set cli_whose to "moth.sums"
    if cli_using is not nothing
        set cli_whose to cli_using + "'s moth.sums"
    end
    say "moth: " + name of cli_one + " at " + cli_short(commit of cli_one) + ", from " + place of cli_source_and_ref(source of cli_one) + ", isn't what " + cli_whose + " says: its files' sum is " + cli_now + ", not " + sum of cli_one + ", so it wasn't kept" to the error output
    cli_remove_folder(cli_dir)
    return no
end

# a package listed, made ready to use: fetched, or moved, to its commit, and its files checked against its sum.
# One fetched by a moth from before sums, with no sum yet, is fetched again, as moth fetches now, for its sum to
# be the same everywhere. Whether it's ready; said why if not
to cli_get_one with cli_one
    set cli_dir to "packages/" + name of cli_one
    set cli_here to cli_folder_here(cli_dir)
    if cli_here and sum of cli_one is nothing
        if not cli_remove_folder(cli_dir)
            say "moth: " + cli_dir + " couldn't be removed, to be fetched again" to the error output
            return no
        end
        set cli_here to no
    end
    if cli_here
        if not cli_move_to(name of cli_one, commit of cli_one)
            return no
        end
    else if cli_fetch(name of cli_one, source of cli_one, commit of cli_one) is nothing
        return no
    end
    return cli_check_sum(cli_one, not cli_here, nothing)
end

# whether a package is signed, as --signed asks (DESIGN §104): the tag it was asked for at, if that's a tag at its
# commit with a signature git trusts, or else its commit; said why if not
to cli_is_signed with cli_one
    set cli_dir to "packages/" + name of cli_one
    set cli_wanted to ref of cli_source_and_ref(source of cli_one)
    set cli_why to ""
    set cli_kind to nothing
    if cli_wanted is not nothing # a tag of its own, which can be signed, and not a name for a commit
        set cli_kind to cli_git(list of "-C", cli_dir, "cat-file", "-t", "refs/tags/" + cli_wanted)
        if cli_kind is nothing
            return no
        end
    end
    if cli_kind is not nothing and code of cli_kind is 0 and cli_trimmed(output of cli_kind) is "tag"
        set cli_tag to cli_git(list of "-C", cli_dir, "rev-parse", "--verify", "--quiet", "refs/tags/" + cli_wanted + "^\{commit}")
        if cli_tag is nothing
            return no
        end
        if code of cli_tag is 0 and cli_trimmed(output of cli_tag) is commit of cli_one
            set cli_answer to cli_git(list of "-C", cli_dir, "verify-tag", cli_wanted)
            if cli_answer is nothing
                return no
            end
            if code of cli_answer is 0
                return yes
            end
            set cli_why to cli_git_said(cli_answer)
        end
    end
    set cli_answer to cli_git(list of "-C", cli_dir, "verify-commit", commit of cli_one)
    if cli_answer is nothing
        return no
    end
    if code of cli_answer is 0
        return yes
    end
    if cli_git_said(cli_answer) is not ""
        set cli_why to cli_git_said(cli_answer)
    end
    set cli_what to "isn't signed"
    if cli_why is not ""
        set cli_what to "has no signature git trusts: " + cli_why
    end
    say "moth: " + name of cli_one + " at " + cli_short(commit of cli_one) + " " + cli_what to the error output
    return no
end

# ---------- the package index ----------
# A JSON file of the packages people have made, each by its name: where it comes from, as moth add takes it,
# and what it's for: {"packages": {"thing": {"repository": "github.com/someone/thing", "about": "..."}}}, and
# the advisories about them that moth audit reads (DESIGN §105). This one, unless --index gives another, an
# address or a file.

set cli_index_default to "https://raw.githubusercontent.com/samyyy2423/moth-packages/main/index.json"

# the index a command was given with --index, whether it was given --signed, and what else it was given
to cli_index_flag with cli_all
    set cli_index to cli_index_default
    set cli_only_signed to no
    set cli_others to empty list
    set cli_k to 1
    repeat while cli_k is at most length of cli_all
        if item cli_k of cli_all is "--index" and cli_k is less than length of cli_all
            set cli_index to item (cli_k + 1) of cli_all
            add 2 to cli_k
        else if item cli_k of cli_all is "--signed"
            set cli_only_signed to yes
            add 1 to cli_k
        else
            add item cli_k of cli_all to cli_others
            add 1 to cli_k
        end
    end
    return record with index cli_index, signed cli_only_signed, rest cli_others
end

# whether what moth add was given is a name alone, for the index: no folder, address or site in it, and no
# folder of that name here
to cli_index_name with cli_given
    for each cli_c in cli_given
        if cli_c is "/" or cli_c is "\\" or cli_c is ":"
            return no
        end
    end
    return cli_package_name(cli_given) and not cli_folder_here(cli_given)
end

# the index, read: what its JSON is, with its packages, or nothing, said, if it can't be read
to cli_index_json with cli_index
    set cli_text to nothing
    try
        if cli_first(cli_index + "        ", 8) is "https://" or cli_first(cli_index + "       ", 7) is "http://"
            set cli_got to run program "curl" with (list of "-fsSL", cli_index) keeping its output
            if code of cli_got is not 0
                say "moth: can't read the package index at " + cli_index + ": " + cli_trimmed(mistakes of cli_got) to the error output
                return nothing
            end
            set cli_text to output of cli_got
        else
            set cli_text to read cli_index
        end
    if it fails with cli_why
        say "moth: can't read the package index at " + cli_index + ": " + cli_why to the error output
        return nothing
    end
    try
        set cli_all to json from cli_text
        if "packages" is in cli_all
            return cli_all
        end
        say "moth: the package index at " + cli_index + " isn't one: it has no \"packages\"" to the error output
        return nothing
    if it fails with cli_why
        say "moth: the package index at " + cli_index + " isn't one: " + cli_why to the error output
        return nothing
    end
end

# the index's packages, each a record of its name, source and about, by name; nothing, said, if it can't be read
to cli_read_index with cli_index
    set cli_all to cli_index_json(cli_index)
    if cli_all is nothing
        return nothing
    end
    set cli_made to empty list
    try
        set cli_packages to item "packages" of cli_all
        for each cli_name in cli_packages
            set cli_entry to item cli_name of cli_packages
            set cli_about to ""
            if "about" is in cli_entry
                set cli_about to item "about" of cli_entry
            end
            add record with name cli_name, source item "repository" of cli_entry, about "" + cli_about to cli_made
        end
    if it fails with cli_why
        say "moth: the package index at " + cli_index + " isn't one: " + cli_why to the error output
        return nothing
    end
    return cli_made
end

# the index's package of this name, or nothing, said
to cli_index_find with cli_name, cli_index
    set cli_all to cli_read_index(cli_index)
    if cli_all is nothing
        return nothing
    end
    for each cli_one in cli_all
        if name of cli_one is cli_name
            return cli_one
        end
    end
    say "moth: the package index has no package called " + cli_name + ": moth search lists them" to the error output
    return nothing
end

# `moth search [words]`: the index's packages that have every word in their name or what they're for
to cli_search with cli_words, cli_index
    set cli_all to cli_read_index(cli_index)
    if cli_all is nothing
        return 1
    end
    set cli_shown to 0
    set cli_widest to 0
    for each cli_one in cli_all
        if length of name of cli_one is greater than cli_widest
            set cli_widest to length of name of cli_one
        end
    end
    for each cli_one in cli_all in order by name
        set cli_seen to lowercase of (name of cli_one + " " + about of cli_one)
        set cli_fits to yes
        for each cli_word in cli_words
            if position of lowercase of cli_word in cli_seen is 0
                set cli_fits to no
            end
        end
        if cli_fits
            say name of cli_one + cli_spaces(cli_widest - length of name of cli_one + 2) + about of cli_one
            add 1 to cli_shown
        end
    end
    if cli_shown is 0
        if length of cli_words is 0
            say "the package index has no packages yet"
        else
            say "no package in the index has " + join cli_words with " "
        end
    end
    return 0
end

# ---------- moth audit ----------

# where a package comes from, written one way, to compare two: in lowercase, \ as /, with no https://, http://,
# ssh:// or git:// before it (git@site:path as site/path), and no / or .git at its end
to cli_place_key with cli_place
    set cli_out to ""
    for each cli_c in lowercase of cli_place
        if cli_c is "\\"
            add "/" to cli_out
        else
            add cli_c to cli_out
        end
    end
    for each cli_start in list of "https://", "http://", "ssh://", "git://"
        if length of cli_out is greater than length of cli_start and cli_first(cli_out, length of cli_start) is cli_start
            set cli_out to cli_tail(cli_out, length of cli_start + 1)
        end
    end
    if length of cli_out is greater than 4 and cli_first(cli_out, 4) is "git@"
        set cli_rest to cli_tail(cli_out, 5)
        set cli_out to ""
        set cli_colon to no
        for each cli_c in cli_rest
            if cli_c is ":" and not cli_colon
                add "/" to cli_out
                set cli_colon to yes
            else
                add cli_c to cli_out
            end
        end
    end
    repeat while length of cli_out is greater than 0 and item (length of cli_out) of cli_out is "/"
        set cli_out to cli_first(cli_out, length of cli_out - 1)
    end
    if length of cli_out is greater than 4 and cli_tail(cli_out, length of cli_out - 3) is ".git"
        set cli_out to cli_first(cli_out, length of cli_out - 4)
    end
    return cli_out
end

# the repository an advisory is about, as cli_place_key writes it: its own "repository", or that of the index's
# package it names; nothing if neither
to cli_advisory_place with cli_advisory, cli_all
    if "repository" is in cli_advisory
        return cli_place_key("" + item "repository" of cli_advisory)
    end
    if "package" is in cli_advisory
        set cli_packages to item "packages" of cli_all
        set cli_name to "" + item "package" of cli_advisory
        if cli_name is in cli_packages
            return cli_place_key("" + item "repository" of item cli_name of cli_packages)
        end
    end
    return nothing
end

# whether `cli_older` is `cli_commit` or a commit before it, in a package's clone
to cli_is_ancestor with cli_dir, cli_older, cli_commit
    set cli_answer to cli_git(list of "-C", cli_dir, "merge-base", "--is-ancestor", cli_older, cli_commit)
    return cli_answer is not nothing and code of cli_answer is 0
end

# whether an advisory is about a package's commit: one of its "commits" (all of a commit or its first 7 or more
# digits), or one from its "introduced" commit on (if it has one) that isn't from its "fixed" commit on; or any,
# if it has none of those. Nothing if that needs the package's history and it isn't fetched
to cli_affected with cli_one, cli_advisory
    set cli_commit to lowercase of commit of cli_one
    set cli_listed to "commits" is in cli_advisory
    set cli_ranged to "introduced" is in cli_advisory or "fixed" is in cli_advisory
    if cli_listed
        for each cli_given in item "commits" of cli_advisory
            set cli_c to lowercase of ("" + cli_given)
            if length of cli_c is at least 7 and length of cli_c is at most length of cli_commit and cli_first(cli_commit, length of cli_c) is cli_c
                return yes
            end
        end
    end
    if not cli_ranged
        return not cli_listed
    end
    set cli_dir to "packages/" + name of cli_one
    if not cli_folder_here(cli_dir)
        return nothing
    end
    set cli_there to cli_git(list of "-C", cli_dir, "cat-file", "-e", cli_commit + "^\{commit}")
    if cli_there is nothing or code of cli_there is not 0
        return nothing
    end
    if "introduced" is in cli_advisory
        set cli_from to "" + item "introduced" of cli_advisory
        if cli_from is not "0" and not cli_is_ancestor(cli_dir, cli_from, cli_commit)
            return no
        end
    end
    if "fixed" is in cli_advisory and cli_is_ancestor(cli_dir, "" + item "fixed" of cli_advisory, cli_commit)
        return no
    end
    return yes
end

# an advisory's field as text, or "" if it hasn't that field
to cli_field with cli_advisory, cli_key
    if cli_key is in cli_advisory
        return "" + item cli_key of cli_advisory
    end
    return ""
end

# `moth audit`: each package moth.packages lists, checked against the index's advisories, each saying which
# commits of a package have a problem. 0 if none is about these packages' commits; 1 if one is, or a package
# couldn't be checked
to cli_audit with cli_index
    set cli_list to cli_package_list()
    if cli_list is nothing
        say "moth: there's no moth.packages here: moth add <git repository> adds a package" to the error output
        return 1
    end
    set cli_all to cli_index_json(cli_index)
    if cli_all is nothing
        return 1
    end
    set cli_found to 0
    set cli_unchecked to 0
    try
        set cli_advisories to empty list
        if "advisories" is in cli_all
            set cli_advisories to item "advisories" of cli_all
        end
        for each cli_one in cli_list
            set cli_key to cli_place_key(place of cli_source_and_ref(source of cli_one))
            set cli_said_why to no
            for each cli_advisory in cli_advisories
                if cli_advisory_place(cli_advisory, cli_all) is cli_key
                    set cli_hit to cli_affected(cli_one, cli_advisory)
                    if cli_hit is nothing
                        if not cli_said_why
                            say "moth: " + name of cli_one + " isn't fetched, so it couldn't be checked: moth get fetches it" to the error output
                            add 1 to cli_unchecked
                            set cli_said_why to yes
                        end
                    else if cli_hit
                        set cli_what to cli_field(cli_advisory, "id")
                        if cli_what is ""
                            set cli_what to "an advisory"
                        end
                        if cli_field(cli_advisory, "severity") is not ""
                            set cli_what to cli_what + " (" + cli_field(cli_advisory, "severity") + ")"
                        end
                        if cli_field(cli_advisory, "about") is not ""
                            set cli_what to cli_what + ": " + cli_field(cli_advisory, "about")
                        end
                        say name of cli_one + " at " + cli_short(commit of cli_one) + ": " + cli_what
                        if cli_field(cli_advisory, "fixed") is not ""
                            say "  fixed at " + cli_short(cli_field(cli_advisory, "fixed")) + ": moth update " + name of cli_one + " takes its newest"
                        else
                            say "  not fixed yet"
                        end
                        if cli_field(cli_advisory, "link") is not ""
                            say "  " + cli_field(cli_advisory, "link")
                        end
                        add 1 to cli_found
                    end
                end
            end
        end
    if it fails with cli_why
        say "moth: an advisory in the package index at " + cli_index + " isn't one: " + cli_why to the error output
        return 1
    end
    if cli_found is 1
        say "1 advisory is about these packages"
    else if cli_found is greater than 1
        say "" + cli_found + " advisories are about these packages"
    else if cli_unchecked is 0 and length of cli_list is 1
        say "no advisories about " + name of item 1 of cli_list + " at " + cli_short(commit of item 1 of cli_list)
    else if cli_unchecked is 0
        say "no advisories about these " + (length of cli_list) + " packages at their commits"
    end
    if cli_found is greater than 0 or cli_unchecked is greater than 0
        return 1
    end
    return 0
end

# a package's source as moth.packages has it, split: where it is, and after an @ in its last part, the tag,
# branch or commit wanted (DESIGN §93), or nothing
to cli_source_and_ref with cli_source
    set cli_cut to 0
    for each cli_k from 1 to length of cli_source
        set cli_c to item cli_k of cli_source
        if cli_c is "/" or cli_c is "\\" or cli_c is ":"
            set cli_cut to 0
        else if cli_c is "@"
            set cli_cut to cli_k
        end
    end
    if cli_cut is 0 or cli_cut is length of cli_source
        return record with place cli_source, ref nothing
    end
    return record with place cli_first(cli_source, cli_cut - 1), ref cli_tail(cli_source, cli_cut + 1)
end

# where a package comes from, as git takes it: github.com/someone/thing is https://github.com/someone/thing
to cli_package_source with cli_given
    for each cli_site in list of "github.com/", "gitlab.com/", "codeberg.org/", "bitbucket.org/"
        if length of cli_given is greater than length of cli_site and cli_first(cli_given, length of cli_site) is cli_site
            return "https://" + cli_given
        end
    end
    return cli_given
end

# `moth add <source> [name]`: the package fetched at its newest commit and listed, with the sum of its files,
# and the packages it lists in a moth.packages of its own, at their commits, unless there's one of that name
# here already, each checked against the sum the package's own moth.sums has for it, if it has one. With
# --signed, each must be signed (see cli_is_signed)
to cli_add with cli_given, cli_named, cli_only_signed
    set cli_source to cli_package_source(cli_given)
    set cli_name to cli_named
    if cli_name is nothing
        set cli_name to cli_package_name_of(place of cli_source_and_ref(cli_source))
    end
    if not cli_package_name(cli_name)
        say "moth: '" + cli_name + "' can't be a package's name (letters, digits, '-', '_' and '.' make one): give it one, as in moth add " + cli_given + " thing" to the error output
        return 1
    end
    set cli_list to cli_package_list()
    if cli_list is nothing
        set cli_list to empty list
    end
    for each cli_one in cli_list
        if name of cli_one is cli_name
            say "moth: there's a package called " + cli_name + " here already: moth update " + cli_name + " moves it to its newest" to the error output
            return 1
        end
    end
    if cli_folder_here("packages/" + cli_name)
        say "moth: there's a folder packages/" + cli_name + " already: remove it, or give the package another name" to the error output
        return 1
    end
    set cli_commit to cli_fetch(cli_name, cli_source, nothing)
    if cli_commit is nothing
        return 1
    end
    set cli_added to record with name cli_name, source cli_source, commit cli_commit, sum nothing
    if not cli_check_sum(cli_added, yes, nothing)
        return 1
    end
    if cli_only_signed and not cli_is_signed(cli_added)
        cli_remove_folder("packages/" + cli_name)
        return 1
    end
    add cli_added to cli_list
    set cli_wanted to ref of cli_source_and_ref(cli_source)
    if cli_wanted is nothing
        say "added " + cli_name + " at " + cli_short(cli_commit) + ", from " + cli_source
    else
        say "added " + cli_name + " at " + cli_short(cli_commit) + " (" + cli_wanted + "), from " + place of cli_source_and_ref(cli_source)
    end
    if not cli_is_file("packages/" + cli_name + "/" + cli_name + ".moth")
        say "  it has no " + cli_name + ".moth, so use the package \"" + cli_name + "\" won't find it: use its files by name, as in use \"packages/" + cli_name + "/...\""
    end
    set cli_failed to no
    set cli_k to length of cli_list # what each package added needs, the packages it adds too
    repeat while cli_k is at most length of cli_list
        set cli_needing to name of item cli_k of cli_list
        set cli_needs to cli_read_or_nothing("packages/" + cli_needing + "/moth.packages")
        if cli_needs is not nothing
            for each cli_need in cli_packages_in(cli_needs, cli_read_or_nothing("packages/" + cli_needing + "/moth.sums"))
                set cli_have to no
                for each cli_one in cli_list
                    if name of cli_one is name of cli_need
                        set cli_have to yes
                    end
                end
                if not cli_have and not cli_folder_here("packages/" + name of cli_need)
                    set cli_got to cli_fetch(name of cli_need, source of cli_need, commit of cli_need)
                    if cli_got is nothing
                        set cli_failed to yes
                    else if not cli_check_sum(cli_need, yes, cli_needing)
                        set cli_failed to yes
                    else if cli_only_signed and not cli_is_signed(cli_need)
                        cli_remove_folder("packages/" + name of cli_need)
                        set cli_failed to yes
                    else
                        add cli_need to cli_list
                        say "added " + name of cli_need + " at " + cli_short(cli_got) + ", which " + cli_needing + " uses"
                    end
                end
            end
        end
        add 1 to cli_k
    end
    cli_write_packages(cli_list)
    if cli_failed
        return 1
    end
    return 0
end

# `moth get`: every package listed, fetched or moved to its commit, and its files checked against moth.sums;
# one with no sum there yet fetched again and its sum written down. With --signed, each must be signed
to cli_get with cli_only_signed
    set cli_list to cli_package_list()
    if cli_list is nothing
        say "moth: there's no moth.packages here: moth add <git repository> adds a package" to the error output
        return 1
    end
    set cli_ended to 0
    set cli_summed to no
    for each cli_one in cli_list
        set cli_had to sum of cli_one
        set cli_fine to cli_get_one(cli_one)
        if cli_fine and cli_had is nothing
            set cli_summed to yes
        end
        if cli_fine and cli_only_signed
            set cli_fine to cli_is_signed(cli_one)
        end
        if cli_fine and cli_had is nothing
            say name of cli_one + " at " + cli_short(commit of cli_one) + ", its sum now in moth.sums"
        else if cli_fine
            say name of cli_one + " at " + cli_short(commit of cli_one)
        else
            set cli_ended to 1
        end
    end
    if cli_summed
        cli_write_sums(cli_list)
    end
    return cli_ended
end

# `moth update [name]`: every package, or the one named, moved to the newest commit where it comes from, once its
# files are checked against moth.sums, and the sum of its new files written down. With --signed, a newest
# commit that isn't signed isn't taken
to cli_update with cli_named, cli_only_signed
    set cli_list to cli_package_list()
    if cli_list is nothing
        say "moth: there's no moth.packages here: moth add <git repository> adds a package" to the error output
        return 1
    end
    set cli_found to no
    set cli_ended to 0
    for each cli_one in cli_list
        if cli_named is nothing or name of cli_one is cli_named
            set cli_found to yes
            set cli_dir to "packages/" + name of cli_one
            set cli_ready to cli_get_one(cli_one)
            set cli_answer to nothing
            if cli_ready
                set cli_answer to cli_git(list of "-C", cli_dir, "fetch", "--quiet", "origin")
            end
            set cli_wanted to ref of cli_source_and_ref(source of cli_one)
            set cli_newest_of to "origin/HEAD"
            if cli_wanted is not nothing # a branch moves on; a tag or a commit stays where it is
                set cli_newest_of to "origin/" + cli_wanted
                if cli_answer is not nothing and code of cli_answer is 0
                    set cli_branch to cli_git(list of "-C", cli_dir, "rev-parse", "--verify", "--quiet", cli_newest_of)
                    if cli_branch is nothing or code of cli_branch is not 0
                        set cli_newest_of to commit of cli_one
                    end
                end
            end
            if cli_answer is not nothing and code of cli_answer is 0
                set cli_answer to cli_git(list of "-C", cli_dir, "checkout", "--quiet", cli_newest_of)
            end
            if cli_answer is nothing
                set cli_ended to 1
            else if code of cli_answer is not 0
                say "moth: " + name of cli_one + " couldn't be updated: " + cli_git_said(cli_answer) to the error output
                set cli_ended to 1
            else
                set cli_newest to cli_head(cli_dir)
                set cli_moved to record with name name of cli_one, source source of cli_one, commit cli_newest, sum nothing
                if cli_newest is commit of cli_one and cli_wanted is not nothing and cli_newest_of is commit of cli_one
                    say name of cli_one + " stays at " + cli_wanted + ", " + cli_short(cli_newest)
                else if cli_newest is commit of cli_one
                    say name of cli_one + " is at its newest, " + cli_short(cli_newest)
                else if cli_only_signed and not cli_is_signed(cli_moved)
                    cli_move_to(name of cli_one, commit of cli_one)
                    say "moth: so " + name of cli_one + " stays at " + cli_short(commit of cli_one) to the error output
                    set cli_ended to 1
                else if cli_check_sum(cli_moved, yes, nothing)
                    say name of cli_one + ": " + cli_short(commit of cli_one) + " -> " + cli_short(cli_newest)
                    set commit of cli_one to cli_newest
                    set sum of cli_one to sum of cli_moved
                else
                    set cli_ended to 1
                end
            end
        end
    end
    if not cli_found and cli_named is not nothing
        say "moth: there's no package called " + cli_named + " here: moth packages lists them" to the error output
        return 1
    end
    cli_write_packages(cli_list)
    return cli_ended
end

# `moth remove <name>`: the package's folder gone, and its line
to cli_remove_package with cli_named
    set cli_list to cli_package_list()
    if cli_list is nothing
        set cli_list to empty list
    end
    set cli_kept to empty list
    for each cli_one in cli_list
        if name of cli_one is not cli_named
            add cli_one to cli_kept
        end
    end
    if length of cli_kept is length of cli_list
        say "moth: there's no package called " + cli_named + " here: moth packages lists them" to the error output
        return 1
    end
    if cli_folder_here("packages/" + cli_named) and not cli_remove_folder("packages/" + cli_named)
        say "moth: packages/" + cli_named + " couldn't be removed" to the error output
        return 1
    end
    cli_write_packages(cli_kept)
    say "removed " + cli_named
    return 0
end

# `moth packages`: each, its commit, where it comes from, and whether it's been fetched
to cli_list_packages
    set cli_list to cli_package_list()
    if cli_list is nothing or length of cli_list is 0
        say "no packages: moth add <git repository> adds one"
        return 0
    end
    for each cli_one in cli_list
        set cli_note to ""
        if not cli_folder_here("packages/" + name of cli_one)
            set cli_note to " (not fetched: moth get fetches it)"
        else if cli_head("packages/" + name of cli_one) is not commit of cli_one
            set cli_note to " (at another commit: moth get moves it back)"
        end
        say name of cli_one + " at " + cli_short(commit of cli_one) + ", from " + source of cli_one + cli_note
    end
    return 0
end

# `moth add`, `get`, `update`, `remove`, `packages`, `search` and `audit`, with what follows them
to cli_package_command with cli_command, cli_all
    set cli_flagged to cli_index_flag(cli_all)
    set cli_rest to rest of cli_flagged
    set cli_n to length of cli_rest
    set cli_only_signed to signed of cli_flagged
    if cli_only_signed and not (cli_command is "add" or cli_command is "get" or cli_command is "update")
        say cli_usage to the error output
        return 2
    end
    if cli_command is "search"
        return cli_search(cli_rest, index of cli_flagged)
    end
    if cli_command is "audit" and cli_n is 0
        return cli_audit(index of cli_flagged)
    end
    if cli_command is "add" and (cli_n is 1 or cli_n is 2)
        set cli_named to nothing
        if cli_n is 2
            set cli_named to item 2 of cli_rest
        end
        set cli_given to item 1 of cli_rest
        if cli_index_name(cli_given) # a name alone: the index's
            set cli_found to cli_index_find(cli_given, index of cli_flagged)
            if cli_found is nothing
                return 1
            end
            if cli_named is nothing
                set cli_named to cli_given
            end
            set cli_given to source of cli_found
        end
        return cli_add(cli_given, cli_named, cli_only_signed)
    end
    if cli_command is "get" and cli_n is 0
        return cli_get(cli_only_signed)
    end
    if cli_command is "update" and cli_n is 0
        return cli_update(nothing, cli_only_signed)
    end
    if cli_command is "update" and cli_n is 1
        return cli_update(item 1 of cli_rest, cli_only_signed)
    end
    if cli_command is "remove" and cli_n is 1
        return cli_remove_package(item 1 of cli_rest)
    end
    if cli_command is "packages" and cli_n is 0
        return cli_list_packages()
    end
    say cli_usage to the error output
    return 2
end

# ---------- the shell ----------
# `moth`, or `moth shell [--allow-...]`: Moth typed a line at a time (DESIGN §65). Each entry, once it's whole
# (a block once its `end` is typed), becomes a program of its own, built and run as `moth run` would: first
# what the entries before it left, then the entry. Their functions are made again, as their `to` blocks are
# written, and the names they gave values have them again, from what the last program saved in
# .moth-shell-state: each entry before is a file of its own, "[1]", "[2]" and so on, used in order, with
# its `to` blocks and `use` lines as they were typed and each other line blank, or giving a name its value
# where that name was first given one, so the line numbers are the ones typed, and a function changes the
# names it would have if the entries were one program. An entry that's a value shows it, as `say` would;
# one that fails changes nothing. What can't be saved (a function, bytes) is nothing in the next entry.

set cli_sh_state to ".moth-shell-state"

# a text without the spaces and tabs at either end
to cli_sh_strip with cli_text
    set cli_from to 1
    repeat while cli_from is at most length of cli_text and item cli_from of cli_text is at most " "
        add 1 to cli_from
    end
    return cli_trimmed(cli_tail(cli_text, cli_from))
end

# whether a line, its spaces before it gone, starts with `cli_start`
to cli_sh_starts with cli_line, cli_start
    set cli_bare to cli_sh_strip(cli_line)
    return length of cli_bare is at least length of cli_start and cli_first(cli_bare, length of cli_start) is cli_start
end

# what an entry is, as the compiler reads it: its statements, or the mistake reading it stopped at, and
# whether that's only that it isn't finished yet (a block with no `end`, a line cut short)
to cli_sh_read with cli_text, cli_files
    set cli_made to record with body nothing, why nothing, unfinished no
    try
        set body of cli_made to machine's read_program(cli_text, cli_files)
    if it fails with cli_why
        set why of cli_made to cli_why
        try
            set unfinished of cli_made to type of at of cli_why is "eof"
        if it fails
        end
    end
    return cli_made
end

# the names statements give values to at the top level, in the order they come, into `cli_found`; not
# those inside a function, which are its own
to cli_sh_names with cli_body, cli_file, cli_found
    for each cli_s in cli_body
        set cli_kind to kind of cli_s
        if file of at of cli_s is not cli_file # a file it uses makes its names again each time
            set cli_kind to ""
        end
        if cli_kind is "set" or cli_kind is "add" or cli_kind is "count" or cli_kind is "each" or (cli_kind is "try" and name of cli_s is not nothing)
            if not (name of cli_s is in cli_found) and position of "'s " in name of cli_s is 0
                add name of cli_s to cli_found
            end
        end
        if cli_kind is "if"
            cli_sh_names(then of cli_s, cli_file, cli_found)
            cli_sh_names(otherwise of cli_s, cli_file, cli_found)
        else if cli_kind is "while" or cli_kind is "repeat" or cli_kind is "count" or cli_kind is "each"
            cli_sh_names(body of cli_s, cli_file, cli_found)
        else if cli_kind is "try"
            cli_sh_names(body of cli_s, cli_file, cli_found)
            cli_sh_names(handler of cli_s, cli_file, cli_found)
        end
    end
end

# the names of the functions statements make at the top level, its own and those of the files it uses
to cli_sh_functions with cli_body, cli_found
    for each cli_s in cli_body
        if kind of cli_s is "define" and not (name of cli_s is in cli_found)
            add name of cli_s to cli_found
        end
    end
end

# An entry as the entries after it have it, in the file "[n]": its `to` blocks and `use` lines as they
# are, and for each other statement at the top, the names it first gives values to (none before it did)
# given the values saved for them, a line each, then blank lines to its end. Names that don't fit, as a
# statement of one line can only give one, go in `early`, given theirs before every entry.
to cli_sh_replay with cli_text, cli_body, cli_file, cli_known
    set cli_lines to split cli_text by "\n"
    set cli_n to length of cli_lines
    set cli_kept to empty list
    set cli_starts to empty list # where each statement of the entry's own starts, or a `use` line
    for each cli_k from 1 to cli_n
        add "" to cli_kept
    end
    set cli_in_library to no
    for each cli_k from 1 to cli_n
        set cli_line to item cli_k of cli_lines
        if cli_in_library
            set item cli_k of cli_kept to cli_line
            if cli_sh_strip(cli_line) is "end"
                set cli_in_library to no
            end
        else if cli_sh_starts(cli_line, "use ")
            set item cli_k of cli_kept to cli_line
            add cli_k to cli_starts
            if cli_sh_starts(cli_line, "use the library")
                set cli_in_library to yes
            end
        end
    end
    set cli_own to empty list
    for each cli_s in cli_body
        if file of at of cli_s is cli_file
            add cli_s to cli_own
            add line of at of cli_s to cli_starts
        end
    end
    set cli_early to empty list
    set cli_seen to empty list
    for each cli_known_name in cli_known
        add cli_known_name to cli_seen
    end
    for each cli_s in cli_own
        set cli_from to line of at of cli_s
        set cli_upto to cli_n
        for each cli_start in cli_starts
            if cli_start is greater than cli_from and cli_start - 1 is less than cli_upto
                set cli_upto to cli_start - 1
            end
        end
        if kind of cli_s is "define" and position of " " in name of cli_s is 0 # not one the parser made for a line's value
            for each cli_k from cli_from to cli_upto
                set item cli_k of cli_kept to item cli_k of cli_lines
            end
        else
            set cli_new to empty list
            cli_sh_names((list of cli_s), cli_file, cli_new)
            set cli_at to cli_from
            for each cli_name in cli_new
                if not (cli_name is in cli_seen)
                    add cli_name to cli_seen
                    if cli_at is at most cli_upto
                        set item cli_at of cli_kept to "set " + cli_name + " to moth_shell_get(\"" + cli_name + "\")"
                        add 1 to cli_at
                    else
                        add cli_name to cli_early
                    end
                end
            end
        end
    end
    return record with text (join cli_kept with "\n"), early cli_early
end

# the program for an entry: the shell's own few functions, what the entries before left, the entry, and
# every name's value saved for the next
to cli_sh_program with cli_sh, cli_uses, cli_names
    set cli_out to empty list
    add "to moth_shell_show with moth_shell_value" to cli_out
    add "    if moth_shell_value is not nothing" to cli_out
    add "        say moth_shell_value" to cli_out
    add "    end" to cli_out
    add "end" to cli_out
    add "set moth_shell_kept to empty dictionary" to cli_out
    if length of cli_uses is greater than 1
        add "try" to cli_out
        add "    set moth_shell_kept to load \"" + state of cli_sh + "\"" to cli_out
        add "if it fails" to cli_out
        add "end" to cli_out
    end
    add "to moth_shell_get with moth_shell_name" to cli_out
    add "    if moth_shell_name is in moth_shell_kept" to cli_out
    add "        return item moth_shell_name of moth_shell_kept" to cli_out
    add "    end" to cli_out
    add "    return nothing" to cli_out
    add "end" to cli_out
    add "to moth_shell_keep with moth_shell_all" to cli_out
    add "    try" to cli_out
    add "        save moth_shell_all to \"" + state of cli_sh + "\"" to cli_out
    add "        return nothing" to cli_out
    add "    if it fails" to cli_out
    add "    end" to cli_out
    add "    set moth_shell_fine to empty dictionary" to cli_out
    add "    for each moth_shell_name in keys of moth_shell_all" to cli_out
    add "        try" to cli_out
    add "            save (dictionary where moth_shell_name is item moth_shell_name of moth_shell_all) to \"" + state of cli_sh + "\"" to cli_out
    add "            set item moth_shell_name of moth_shell_fine to item moth_shell_name of moth_shell_all" to cli_out
    add "        if it fails with moth_shell_why" to cli_out
    add "            say \"(\" + moth_shell_name + \" can't be kept for the next entry: \" + moth_shell_why + \")\" to the error output" to cli_out
    add "            set item moth_shell_name of moth_shell_fine to nothing" to cli_out
    add "        end" to cli_out
    add "    end" to cli_out
    add "    save moth_shell_fine to \"" + state of cli_sh + "\"" to cli_out
    add "end" to cli_out
    for each cli_name in early of cli_sh
        add "set " + cli_name + " to moth_shell_get(\"" + cli_name + "\")" to cli_out
    end
    for each cli_use in cli_uses
        add "use \"" + cli_use + "\"" to cli_out
    end
    add "set moth_shell_saving to empty dictionary" to cli_out
    for each cli_name in cli_names
        add "try" to cli_out
        add "    set item \"" + cli_name + "\" of moth_shell_saving to " + cli_name to cli_out
        add "if it fails" to cli_out
        add "    set item \"" + cli_name + "\" of moth_shell_saving to nothing" to cli_out
        add "end" to cli_out
    end
    add "moth_shell_keep(moth_shell_saving)" to cli_out
    return join cli_out with "\n"
end

# An entry of one line that's a value, as `x + 1` or `xs` or `square(4)`, as code that shows it: `say` it,
# or, for a call to one of the functions made, show what it gives unless that's nothing. Anything else as
# it is.
to cli_sh_showing with cli_sh, cli_text, cli_read, cli_files
    if position of "\n" in cli_text is not 0
        return cli_text
    end
    set cli_shown to nothing
    if body of cli_read is not nothing
        set cli_body to body of cli_read
        if length of cli_body is not 1 or kind of item 1 of cli_body is not "call"
            return cli_text
        end
        if name of item 1 of cli_body is in functions of cli_sh
            set cli_shown to "moth_shell_show(" + cli_text + ")"
        else
            set cli_shown to "say " + cli_text
        end
    else if not unfinished of cli_read
        set cli_shown to "say " + cli_text
    end
    if cli_shown is nothing or body of cli_sh_read(cli_shown, cli_files) is nothing
        return cli_text
    end
    return cli_shown
end

# The files an entry uses, read from the folder the shell runs in, added to those the shell has; nothing,
# said, if one can't be read
to cli_sh_take_files with cli_sh, cli_text
    set cli_used to cli_sources_of("moth-shell.moth", cli_text)
    set cli_names to file_names of cli_sh
    set cli_texts to file_texts of cli_sh
    for each cli_k from 1 to length of names of cli_used
        set cli_name to item cli_k of names of cli_used
        if not (cli_name is in cli_names)
            add cli_name to cli_names
            add item cli_k of texts of cli_used to cli_texts
        end
    end
end

# an entry, whole: built and run; what it leaves kept for the entries after, if it ends well
to cli_sh_entry with cli_sh, cli_typed
    cli_sh_take_files(cli_sh, cli_typed)
    set cli_files to cli_files_of(file_names of cli_sh, file_texts of cli_sh)
    set cli_read to cli_sh_read(cli_typed, cli_files)
    set cli_text to cli_sh_showing(cli_sh, cli_typed, cli_read, cli_files)
    set typed of cli_sh to typed of cli_sh + 1
    set cli_file to "[" + typed of cli_sh + "]"
    if piece of cli_sh is not nothing # a notebook's blocks, or the kernel's cells, by their number
        set cli_file to piece of cli_sh + " " + typed of cli_sh
    end
    set said of cli_sh to ""
    set cli_names to empty list
    for each cli_name in known of cli_sh
        add cli_name to cli_names
    end
    set cli_read to cli_sh_read(cli_text, cli_files)
    if body of cli_read is not nothing
        cli_sh_names(body of cli_read, "", cli_names)
    end
    set cli_all_names to empty list
    set cli_all_texts to empty list
    set cli_uses to empty list
    for each cli_k from 1 to length of entries of cli_sh
        add item cli_k of labels of cli_sh to cli_uses
        add item cli_k of labels of cli_sh to cli_all_names
        add item cli_k of entries of cli_sh to cli_all_texts
    end
    add cli_file to cli_uses
    add cli_file to cli_all_names
    add cli_text to cli_all_texts
    for each cli_k from 1 to length of file_names of cli_sh
        add item cli_k of file_names of cli_sh to cli_all_names
        add item cli_k of file_texts of cli_sh to cli_all_texts
    end
    set cli_source to cli_sh_program(cli_sh, cli_uses, cli_names)
    try
        set cli_bytes to machine's compile_shipping(cli_source, cli_all_names, cli_all_texts, host of cli_sh, "moth shell",
            allowing of cli_sh, nothing, nothing, empty list, empty list)
    if it fails with cli_why
        if keeping of cli_sh
            set said of cli_sh to cli_report_text(cli_why, "moth shell", cli_source, cli_all_names, cli_all_texts)
            set failed of cli_sh to yes
            return nothing
        end
        cli_report(cli_why, "moth shell", cli_source, cli_all_names, cli_all_texts)
        set failed of cli_sh to yes
        return nothing
    end
    try
        write cli_bytes as bytes to program of cli_sh
    if it fails with cli_whynot
        say "moth: " + cli_whynot to the error output
        set failed of cli_sh to yes
        return nothing
    end
    if cli_sh_run(cli_sh) is not 0 # a mistake, or `stop the program`: nothing it did is kept
        set failed of cli_sh to yes
        return nothing
    end
    set cli_replayed to cli_sh_replay(cli_text, body of cli_read, "", known of cli_sh)
    set cli_entries to entries of cli_sh
    add text of cli_replayed to cli_entries
    set cli_labels to labels of cli_sh
    add cli_file to cli_labels
    set cli_early to early of cli_sh
    for each cli_name in early of cli_replayed
        add cli_name to cli_early
    end
    set known of cli_sh to cli_names
    cli_sh_functions(body of cli_read, functions of cli_sh)
end

# the program for an entry run, and removed: the number it ended with. A notebook keeps what it said, its
# output and then its mistakes, in `said`.
to cli_sh_run with cli_sh
    set cli_program to program of cli_sh
    set cli_ended to 1
    try
        if keeping of cli_sh
            set cli_answer to run program cli_program with empty list keeping its output
            set cli_ended to code of cli_answer
            set said of cli_sh to output of cli_answer + mistakes of cli_answer
        else
            set cli_ended to run program cli_program with empty list
        end
    if it fails with cli_why
        say "moth: " + cli_why to the error output
    end
    try
        remove the file cli_program
    if it fails
    end
    return cli_ended
end

# what the shell (or a notebook, `keeping` what each entry says) knows: the entries so far, and the rest; the
# file each entry's names are kept in for the next (`state`), and what an entry is called in a mistake, if
# not [1], [2] and so on (`piece`: "block" for a notebook's, "cell" for the kernel's)
to cli_sh_new with cli_host_now, cli_allowing, cli_program, cli_keeping
    return record with entries empty list, labels empty list, typed 0, early empty list, known empty list, functions empty list,
        file_names empty list, file_texts empty list, host cli_host_now, allowing cli_allowing, program cli_program,
        keeping cli_keeping, said "", failed no, piece nothing, state cli_sh_state
end

# ---------- notebooks ----------
# `moth notebook notes.md`: each ```moth block, in turn, an entry of the shell's (so a block has what the blocks
# before it made), and what it said, its output and then its mistakes, written under it in an ```output
# block, in place of the one there was. Everything else in the file stays as it is. (DESIGN §77)

to cli_notebook with cli_path, cli_flags
    set cli_text to cli_text_of(cli_path)
    if cli_text is nothing
        return 1
    end
    set cli_host_now to cli_host()
    set cli_program to "./.moth-notebook"
    if cli_host_now is "windows"
        set cli_program to "./.moth-notebook.exe"
    end
    set cli_allowing to empty list
    for each cli_flag in cli_flags
        add cli_flag to cli_allowing
    end
    add "--allow-read=" + cli_sh_state to cli_allowing
    add "--allow-write=" + cli_sh_state to cli_allowing
    set cli_sh to cli_sh_new(cli_host_now, cli_allowing, cli_program, yes)
    set piece of cli_sh to "block"
    set cli_lines to split cli_text by "\n"
    set cli_out to empty list
    set cli_blocks to 0
    set cli_failures to 0
    set cli_k to 1
    repeat while cli_k is at most length of cli_lines
        set cli_line to item cli_k of cli_lines
        add cli_line to cli_out
        add 1 to cli_k
        if cli_sh_strip(cli_line) is "```moth"
            set cli_code to empty list
            repeat while cli_k is at most length of cli_lines and cli_sh_strip(item cli_k of cli_lines) is not "```"
                add item cli_k of cli_lines to cli_code
                add item cli_k of cli_lines to cli_out
                add 1 to cli_k
            end
            if cli_k is at most length of cli_lines
                add item cli_k of cli_lines to cli_out
                add 1 to cli_k
            end
            set cli_after to cli_k # past an ```output block there was, and the empty lines before it
            repeat while cli_after is at most length of cli_lines and cli_sh_strip(item cli_after of cli_lines) is ""
                add 1 to cli_after
            end
            if cli_after is at most length of cli_lines and cli_sh_strip(item cli_after of cli_lines) is "```output"
                set cli_k to cli_after + 1
                repeat while cli_k is at most length of cli_lines and cli_sh_strip(item cli_k of cli_lines) is not "```"
                    add 1 to cli_k
                end
                add 1 to cli_k
            end
            add 1 to cli_blocks
            set failed of cli_sh to no
            set said of cli_sh to ""
            cli_sh_entry(cli_sh, cli_nb_showing(cli_sh, cli_code))
            if failed of cli_sh
                add 1 to cli_failures
            end
            set cli_said to said of cli_sh
            if length of cli_said is greater than 0 and item (length of cli_said) of cli_said is "\n"
                set cli_said to items 1 to (length of cli_said - 1) of cli_said
            end
            if cli_said is not ""
                add "" to cli_out
                add "```output" to cli_out
                for each cli_said_line in split cli_said by "\n"
                    add cli_said_line to cli_out
                end
                add "```" to cli_out
            end
            if cli_k is at most length of cli_lines and cli_sh_strip(item cli_k of cli_lines) is not ""
                add "" to cli_out # a line between the output and what follows
            end
        end
    end
    try
        remove the file cli_sh_state
    if it fails
    end
    try
        write join cli_out with "\n" to cli_path
    if it fails with cli_why
        say "moth: " + cli_why to the error output
        return 1
    end
    set cli_told to cli_path + ": " + cli_blocks + " blocks run"
    if cli_failures is greater than 0
        set cli_told to cli_told + ", " + cli_failures + " of them with a mistake"
    end
    say cli_told
    if cli_failures is greater than 0
        return 1
    end
    return 0
end

# A block of more than one line whose last line is a value, as `xs` or `square(4)`, as code that shows it, as
# the shell shows an entry of one line: `say` it, or, for a call to a function made before or in the block,
# show what it gives unless that's nothing. Anything else as it is.
to cli_nb_showing with cli_sh, cli_code
    set cli_whole to join cli_code with "\n"
    set cli_last to length of cli_code
    repeat while cli_last is at least 1 and cli_sh_strip(item cli_last of cli_code) is ""
        set cli_last to cli_last - 1
    end
    if cli_last is less than 2
        return cli_whole
    end
    set cli_line to item cli_last of cli_code
    if item 1 of cli_line is " " or item 1 of cli_line is "\t" # inside a block of its own
        return cli_whole
    end
    set cli_files to cli_files_of(file_names of cli_sh, file_texts of cli_sh)
    set cli_rest to join (items 1 to (cli_last - 1) of cli_code) with "\n"
    set cli_read to cli_sh_read(cli_whole, cli_files)
    set cli_shown to nothing
    if body of cli_read is nothing
        set cli_shown to cli_rest + "\n" + "say " + cli_line
    else
        set cli_body to body of cli_read
        set cli_final to item (length of cli_body) of cli_body
        set cli_made to empty list
        for each cli_name in functions of cli_sh
            add cli_name to cli_made
        end
        cli_sh_functions(cli_body, cli_made)
        if kind of cli_final is "call" and name of cli_final is in cli_made and line of at of cli_final is cli_last
            set cli_shown to cli_rest + "\n" + "moth_shell_show(" + cli_line + ")"
        else if kind of cli_final is "call" and line of at of cli_final is cli_last and cli_sh_strip(cli_line) is name of cli_final
            set cli_shown to cli_rest + "\n" + "say " + cli_line # a name alone, of no function: its value
        end
    end
    if cli_shown is nothing or body of cli_sh_read(cli_shown, cli_files) is nothing
        return cli_whole
    end
    return cli_shown
end

# ---------- the kernel ----------
# `moth kernel [--allow-...]`, for editors/jupyter's kernel: each line it reads names a file holding a cell's
# code, which runs as a notebook's block does (so a cell has what the cells before it made, its last line's
# value is shown, and one that fails keeps nothing), but as the shell's entries do: what it says, and its
# mistakes, go out as they come, and it asks this program's input, so a cell can ask a question. Before
# the cell, a line of byte 1 and "moth-cell"; after it, one of byte 1 and "moth-done" on the error output,
# then one of byte 1 and "moth-done ok" (or "moth-done failed"). A number and a space before the file's name
# number the cell, as Jupyter does, if that's past the last cell's number. An empty line, or the input's end,
# ends it. Its program and the file it keeps names in are its own, so two kernels can run in one folder.
# (DESIGN §122)
to cli_kernel with cli_flags
    set cli_host_now to cli_host()
    set cli_own to ".moth-kernel-" + (random number from 100000 to 999999)
    set cli_program to "./" + cli_own
    if cli_host_now is "windows"
        set cli_program to cli_program + ".exe"
    end
    set cli_allowing to empty list
    for each cli_flag in cli_flags
        add cli_flag to cli_allowing
    end
    add "--allow-read=" + cli_own + "-state" to cli_allowing
    add "--allow-write=" + cli_own + "-state" to cli_allowing
    set cli_sh to cli_sh_new(cli_host_now, cli_allowing, cli_program, no)
    set piece of cli_sh to "cell"
    set state of cli_sh to cli_own + "-state"
    set cli_mark to (list of 1) as bytes as text
    repeat while yes
        set cli_line to nothing
        try
            set cli_line to ask ""
        if it fails # the input has ended
        end
        if cli_line is nothing or cli_sh_strip(cli_line) is ""
            stop
        end
        say cli_mark + "moth-cell"
        set failed of cli_sh to no
        set cli_path to cli_sh_strip(cli_line)
        set cli_space to position of " " in cli_path
        if cli_space is greater than 1 and cli_kernel_whole(cli_first(cli_path, cli_space - 1))
            set cli_number to number of cli_first(cli_path, cli_space - 1)
            set cli_path to cli_sh_strip(cli_tail(cli_path, cli_space + 1))
            if cli_number - 1 is greater than typed of cli_sh # numbers never go back, so each cell's is its own
                set typed of cli_sh to cli_number - 1
            end
        end
        set cli_code_text to cli_text_of(cli_path)
        if cli_code_text is nothing
            set failed of cli_sh to yes
        else
            set cli_code to split cli_code_text by "\n"
            repeat while length of cli_code is greater than 0 and cli_sh_strip(item (length of cli_code) of cli_code) is ""
                set cli_code to items 1 to (length of cli_code - 1) of cli_code
            end
            if length of cli_code is greater than 0
                cli_sh_entry(cli_sh, cli_nb_showing(cli_sh, cli_code))
            end
        end
        say cli_mark + "moth-done" to the error output
        if failed of cli_sh
            say cli_mark + "moth-done failed"
        else
            say cli_mark + "moth-done ok"
        end
    end
    try
        remove the file state of cli_sh
    if it fails
    end
    return 0
end

# whether a text is digits alone
to cli_kernel_whole with cli_text
    for each cli_c in cli_text
        if position of cli_c in "0123456789" is 0
            return no
        end
    end
    return yes
end

to cli_shell with cli_flags
    set cli_host_now to cli_host()
    set cli_program to "./.moth-shell"
    if cli_host_now is "windows"
        set cli_program to "./.moth-shell.exe"
    end
    set cli_allowing to empty list
    for each cli_flag in cli_flags
        add cli_flag to cli_allowing
    end
    add "--allow-read=" + cli_sh_state to cli_allowing
    add "--allow-write=" + cli_sh_state to cli_allowing
    set cli_sh to cli_sh_new(cli_host_now, cli_allowing, cli_program, no)
    say "Moth shell. Type Moth code: a block runs once its 'end' is typed, and a value shows itself. 'quit' ends it."
    set cli_pending to ""
    set cli_blank to 0
    repeat while yes
        set cli_prompt to "moth>"
        if cli_pending is not ""
            set cli_prompt to "....>"
        end
        set cli_line to nothing
        try
            set cli_line to ask cli_prompt
        if it fails # the input has ended
        end
        if cli_line is nothing
            say ""
            stop
        end
        set cli_bare to cli_sh_strip(cli_line)
        if cli_pending is "" and (cli_bare is "quit" or cli_bare is "exit") and not (cli_bare is in known of cli_sh) and not (cli_bare is in functions of cli_sh)
            stop
        end
        if cli_pending is "" and cli_bare is ""
            set cli_blank to 0
        else
            set cli_typed to cli_line
            if cli_pending is not ""
                set cli_typed to cli_pending + "\n" + cli_line
            end
            if cli_bare is ""
                add 1 to cli_blank
            else
                set cli_blank to 0
            end
            cli_sh_take_files(cli_sh, cli_typed)
            set cli_read to cli_sh_read(cli_typed, cli_files_of(file_names of cli_sh, file_texts of cli_sh))
            if unfinished of cli_read and cli_blank is less than 2
                set cli_pending to cli_typed
            else if unfinished of cli_read # two lines left empty: what was typed is dropped
                say "(dropped what wasn't finished)"
                set cli_pending to ""
                set cli_blank to 0
            else
                set cli_pending to ""
                cli_sh_entry(cli_sh, cli_typed)
            end
        end
    end
    try
        remove the file cli_sh_state
    if it fails
    end
    return 0
end

# the arguments: `build`, `run`, `tidy`, `check` or `test`, the file (or files, for a tidy or a test), any
# --allow flags, --target for a build, and for a run whatever comes after the file, which is the program's
# own
to cli_main
    set cli_given to arguments
    set cli_target to nothing
    set cli_flags to empty list
    set cli_file to nothing
    set cli_passed to empty list
    set cli_paths to empty list # for a tidy, every file named
    set cli_checking to no
    set cli_web to no # moth build --web
    set cli_command to ""
    if length of cli_given is at least 1
        set cli_command to item 1 of cli_given
    end
    if length of cli_given is 0 or cli_command is "shell" or cli_command is "kernel" # the shell, or the kernel, with what
        # its entries may do
        set cli_shell_flags to empty list
        for each cli_k from 2 to length of cli_given
            set cli_arg to item cli_k of cli_given
            if not cli_allow_flag(cli_arg)
                say cli_usage to the error output
                stop the program with 2
            end
            add cli_arg to cli_shell_flags
        end
        if cli_command is "kernel"
            stop the program with cli_kernel(cli_shell_flags)
        end
        stop the program with cli_shell(cli_shell_flags)
    end
    if cli_command is "lsp" and length of cli_given is 1 # the language server, for an editor
        stop the program with cli_lsp()
    end
    if cli_command is "add" or cli_command is "get" or cli_command is "update" or cli_command is "remove" or cli_command is "packages" or cli_command is "search" or cli_command is "audit"
        set cli_rest to empty list
        for each cli_k from 2 to length of cli_given
            add item cli_k of cli_given to cli_rest
        end
        stop the program with cli_package_command(cli_command, cli_rest)
    end
    set cli_fine to (length of cli_given is at least 2 and (cli_command is "build" or cli_command is "run" or cli_command is "debug" or cli_command is "profile" or cli_command is "coverage" or cli_command is "notebook" or cli_command is "tidy" or cli_command is "check")) or cli_command is "test"
    set cli_k to 2
    repeat while cli_fine and cli_k is at most length of cli_given
        set cli_arg to item cli_k of cli_given
        if cli_file is not nothing and (cli_command is "run" or cli_command is "debug" or cli_command is "profile" or cli_command is "coverage") # after the file, everything is the program's own
            add cli_arg to cli_passed
            add 1 to cli_k
        else if cli_command is "tidy" and cli_arg is "--check"
            set cli_checking to yes
            add 1 to cli_k
        else if (cli_command is "tidy" or cli_command is "test") and not (length of cli_arg is greater than 1 and cli_first(cli_arg, 2) is "--")
            add cli_arg to cli_paths
            add 1 to cli_k
        else if cli_arg is "--web" and cli_command is "build" and not cli_web
            set cli_web to yes
            add 1 to cli_k
        else if cli_arg is "--target" and cli_command is "build" and cli_k is less than length of cli_given and cli_target is nothing
            set cli_target to item (cli_k + 1) of cli_given
            set cli_fine to cli_target is "windows" or cli_target is "linux" or cli_target is "wasm"
            add 2 to cli_k
        else if cli_arg is "--installer" and cli_command is "build" and not installer of cli_asked
            set installer of cli_asked to yes
            add 1 to cli_k
        else if cli_arg is "--sign" and cli_command is "build" and cli_k is less than length of cli_given
            set sign of cli_asked to item (cli_k + 1) of cli_given
            add 2 to cli_k
        else if cli_arg is "--name" and cli_command is "build" and cli_k is less than length of cli_given
            set app_name of cli_asked to item (cli_k + 1) of cli_given
            add 2 to cli_k
        else if (cli_arg is "--icon" or cli_arg is "--version" or cli_arg is "--include") and (cli_command is "build" or cli_command is "run") and cli_k is less than length of cli_given
            set cli_value to item (cli_k + 1) of cli_given
            if cli_arg is "--icon"
                set icon of cli_asked to cli_value
            else if cli_arg is "--version"
                set version of cli_asked to cli_value
            else
                set cli_included to include of cli_asked
                add cli_value to cli_included
            end
            add 2 to cli_k
        else if cli_command is not "tidy" and cli_command is not "check" and cli_allow_flag(cli_arg)
            add cli_arg to cli_flags
            add 1 to cli_k
        else if cli_file is nothing and not (length of cli_arg is greater than 1 and cli_first(cli_arg, 2) is "--")
            set cli_file to cli_arg
            add 1 to cli_k
        else
            set cli_fine to no
        end
    end
    if cli_file is nothing and cli_command is not "tidy" and cli_command is not "test"
        set cli_fine to no
    end
    if cli_command is "tidy" and length of cli_paths is 0
        set cli_fine to no
    end
    if not cli_fine # wrong usage: how to use it, and 2
        say cli_usage to the error output
        stop the program with 2
    end
    if cli_command is "tidy"
        stop the program with cli_tidy_all(cli_paths, cli_checking)
    end
    if cli_command is "check"
        stop the program with cli_check_file(cli_file)
    end
    if cli_command is "notebook"
        stop the program with cli_notebook(cli_file, cli_flags)
    end
    if cli_web
        stop the program with cli_build_web(cli_file)
    end
    if cli_target is "wasm"
        stop the program with cli_build_wasm(cli_file)
    end
    if cli_command is "test"
        if length of cli_paths is 0 # none named: every one here and in the folders inside
            set cli_sep to "/"
            if cli_host() is "windows"
                set cli_sep to "\\"
            end
            set cli_paths to cli_find_tests("", cli_sep, empty list)
            if length of cli_paths is 0
                say "moth: no tests found: name a file, or put tests in files ending in .test.moth" to the error output
                stop the program with 1
            end
        end
        stop the program with cli_test_all(cli_paths, cli_host(), cli_flags)
    end
    if cli_target is nothing
        set cli_target to cli_host()
    end
    if cli_command is "run"
        stop the program with cli_run(cli_file, cli_target, cli_flags, cli_passed)
    end
    if cli_command is "debug"
        stop the program with cli_debug(cli_file, cli_target, cli_flags, cli_passed)
    end
    if cli_command is "profile"
        stop the program with cli_profile(cli_file, cli_target, cli_flags, cli_passed, "moth-profiler.moth")
    end
    if cli_command is "coverage"
        stop the program with cli_profile(cli_file, cli_target, cli_flags, cli_passed, "moth-coverage.moth")
    end
    set cli_out to cli_out_for(cli_file, cli_target)
    if not cli_build(cli_file, cli_target, cli_flags, cli_out, yes) # a mistake in the program, or a file that can't be read: 1
        stop the program with 1
    end
    if not cli_signed(cli_out)
        stop the program with 1
    end
    if installer of cli_asked
        stop the program with cli_build_installer(cli_file, cli_target, cli_out)
    end
end

cli_main()
