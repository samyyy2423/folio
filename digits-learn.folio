# The digit reader taught with learn.folio: a network of 256 pixels in, a hidden layer, 10 chances out, from
# drawings digits.folio makes, in batches, with Adam; on the graphics card if there is one.
#
#     folio run --allow-libraries digits-learn.folio [card|processor] [hidden]
#
# On a GTX 1650, 10 rounds of 6,000 pictures take 0.11 s on the card, 99.4% right on 1,000 it hadn't seen; on
# the processor, 0.65 s.

use "math.folio"
use "digits.folio"
use "digit-shapes.folio"
use "learn.folio" as learn

set wanted to "card"
set hidden to 256
if length of arguments is at least 1
    set wanted to item 1 of arguments
end
if length of arguments is at least 2
    set hidden to number of (item 2 of arguments)
end
learn's use_card(wanted is "card")

set train_count to 6000
set test_count to 1000
set batch to 200
set rounds to 10

to example with digit
    set way to whole(random() * ways_of(digit)) + 1
    set drawn to picture_of(bent(digit, way), between(0.8, 2.2))
    return record with digit digit, pixels drawn
end

to drawings with count
    set made to empty list
    for each k from 1 to count
        add example(k - (whole((k - 1) / 10) * 10) - 1) to made
    end
    return made
end

set t to the clock
set training to drawings(train_count)
set testing to drawings(test_count)
say "drew " + (train_count + test_count) + " pictures in " + ((the clock - t) rounded) + " s"

# the batches, made once: their pixels as matrices, and their labels
set batches to empty list
set k to 1
repeat while k is at most train_count
    set rows to empty list
    set labels to empty list
    for each i from k to k + batch - 1
        add pixels of item i of training to rows
        add digit of item i of training to labels
    end
    add record with x learn's matrix(rows), labels labels to batches
    set k to k + batch
end
set test_rows to empty list
set test_labels to empty list
for each ex in testing
    add pixels of ex to test_rows
    add digit of ex to test_labels
end
set test_x to learn's matrix(test_rows)

set net to learn's network(list of 256, hidden, 10)
set opt to learn's adam(learn's parameters_of(net), 0.002)
set t to the clock
set loss_now to 0
for each round from 1 to rounds
    for each b in batches
        set loss to learn's cross_entropy(learn's forward(net, b's x), b's labels)
        learn's backward(loss)
        learn's step(opt)
    end
end
set loss to learn's cross_entropy(learn's forward(net, (item 1 of batches)'s x), (item 1 of batches)'s labels)
set loss_now to learn's value(loss)
learn's forget()
set took to the clock - t
set right to learn's accuracy(learn's forward(net, test_x), test_labels)
learn's forget()
say "on the card: " + learn's on_card() + ", hidden " + hidden
say rounds + " rounds of " + train_count + " pictures in " + took + " s (" + (took / (rounds * length of batches) * 1000) + " ms a batch of " + batch + ")"
say "loss " + loss_now + ", " + (right * 100) + "% right on " + test_count + " pictures it hadn't seen"
