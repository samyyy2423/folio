# The recipe box's own work: its database, its pages, made with page.moth, and what each request does.
# recipes.moth serves it, and kitchen.test.moth tests it with no network at all.

use "sqlite.moth" as sqlite
use "http.moth" as http
use "text.moth" as text
use "page.moth" as page

set kitchen_most_title to 80
set kitchen_most_text to 4000

# the site's look, after page.moth's own
set kitchen_css to "body \{ max-width: 48rem; }\nh1 \{ color: #7a3e0a; margin-bottom: .3rem; }\n.facts \{ color: #6b665c; margin-top: 0; }\n.menu a \{ color: #7a3e0a; }\n.footer \{ margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #e3dfd5; color: #6b665c; font-size: .9rem; }\n"

# the recipe box in a file, its table made, with three recipes in it, the first time
to open_kitchen with path
    set db to sqlite's open(path)
    sqlite's run(db, "create table if not exists recipes (id integer primary key autoincrement, title text not null, minutes integer not null, serves integer not null, ingredients text not null, steps text not null)")
    set counted to sqlite's query(db, "select count(*) as n from recipes")
    if item "n" of item 1 of counted is 0
        add_recipe(db, "Tomato soup", 30, 4, "1 kg ripe tomatoes\n1 onion\n2 cloves of garlic\n500 ml stock\nOlive oil, salt and pepper", "Soften the onion and garlic in a little oil.\nAdd the tomatoes and the stock, and simmer for 20 minutes.\nBlend until smooth, and season to taste.")
        add_recipe(db, "Lemon pancakes", 20, 2, "100 g flour\n1 egg\n250 ml milk\n1 lemon\nSugar", "Whisk the flour, egg and milk into a smooth batter.\nFry a ladle at a time in a hot pan, a minute on each side.\nServe with lemon juice and a little sugar.")
        add_recipe(db, "Chickpea curry", 40, 4, "2 tins of chickpeas\n1 tin of tomatoes\n1 tin of coconut milk\n1 onion\n2 tbsp curry paste\nRice, to serve", "Soften the onion, then stir in the curry paste for a minute.\nAdd the tomatoes, coconut milk and chickpeas.\nSimmer for 25 minutes, and serve with rice.")
    end
    return db
end

# a recipe put in, and its number
to add_recipe with db, title, minutes, serves, ingredients, steps
    sqlite's run_with(db, "insert into recipes (title, minutes, serves, ingredients, steps) values (?, ?, ?, ?, ?)", list of title, minutes, serves, ingredients, steps)
    return item "id" of item 1 of sqlite's query(db, "select last_insert_rowid() as id")
end

# the newest recipes, newest first
to newest_of with db, how_many
    return sqlite's query_with(db, "select id, title, minutes, serves from recipes order by id desc limit ?", list of how_many)
end

# the recipes whose name or ingredients have the words in them, by name; all of them for no words
to found_in with db, words
    set like to like_pattern(words)
    return sqlite's query_with(db, "select id, title, minutes, serves from recipes where title like ? escape '\\' or ingredients like ? escape '\\' order by title", list of like, like)
end

# a LIKE pattern that finds the words as they are: a % or _ in them is only itself
to like_pattern with words
    set out to "%"
    for each c in split words by ""
        if c is "%" or c is "_" or c is "\\"
            set out to out + "\\"
        end
        set out to out + c
    end
    return out + "%"
end

# the recipe with that number, or nothing
to recipe_of with db, wanted
    set rows to sqlite's query_with(db, "select id, title, minutes, serves, ingredients, steps from recipes where id = ?", list of wanted)
    if length of rows is 0
        return nothing
    end
    return item 1 of rows
end

# every recipe, as the JSON the site gives: its ingredients and steps as lists
to all_recipes with db
    set out to empty list
    for each row in sqlite's query(db, "select id, title, minutes, serves, ingredients, steps from recipes order by id")
        add (dictionary where "id" is item "id" of row, "title" is item "title" of row, "minutes" is item "minutes" of row, "serves" is item "serves" of row, "ingredients" is lines_of(item "ingredients" of row), "steps" is lines_of(item "steps" of row)) to out
    end
    return out
end

# text with no spaces or new lines at either end
to trimmed with words
    return text's replace_all("^\\s+|\\s+$", words, "")
end

# the lines of a text that have something on them, each trimmed (a browser ends a form's lines with \r\n)
to lines_of with words
    set out to empty list
    for each line in split words by "\n"
        set kept to trimmed(line)
        if kept is not ""
            add kept to out
        end
    end
    return out
end

# what a form sends, title=Soup&minutes=30, as a dictionary of its fields
to form_fields with body
    set fields to empty dictionary
    for each pair in split body by "&"
        set parts to split pair by "="
        if length of parts is 2
            set item (http's decoded(item 1 of parts)) of fields to http's decoded(item 2 of parts)
        end
    end
    return fields
end

# a field of the form, or "" if it wasn't sent
to field_of with fields, name
    if name is in fields
        return item name of fields
    end
    return ""
end

# what's wrong with a recipe from the form, or "" if nothing is
to problem_with with fields
    set title to trimmed(field_of(fields, "title"))
    if title is ""
        return "Please give the recipe a name."
    end
    if length of title is greater than kitchen_most_title
        return "A name can be at most " + kitchen_most_title + " letters."
    end
    if not counts(field_of(fields, "minutes"), 1440)
        return "Minutes is a whole number, from 1 to 1440."
    end
    if not counts(field_of(fields, "serves"), 100)
        return "Serves is a whole number, from 1 to 100."
    end
    for each name in list of "ingredients", "steps"
        set written to field_of(fields, name)
        if length of lines_of(written) is 0
            return "Please write the " + name + ", one to a line."
        end
        if length of written is greater than kitchen_most_text
            return "The " + name + " can be at most " + kitchen_most_text + " letters."
        end
    end
    return ""
end

# whether the text is a whole number from 1 to the highest
to counts with written, highest
    set words to trimmed(written)
    if not text's matches("[0-9]\{1,6}", words)
        return no
    end
    set n to number of words
    return n is at least 1 and n is at most highest
end

# a recipe from the form, which problem_with() found nothing wrong with, put in: its number
to add_from with db, fields
    set title to trimmed(field_of(fields, "title"))
    set minutes to number of trimmed(field_of(fields, "minutes"))
    set serves to number of trimmed(field_of(fields, "serves"))
    set ingredients to join lines_of(field_of(fields, "ingredients")) with "\n"
    set steps to join lines_of(field_of(fields, "steps")) with "\n"
    return add_recipe(db, title, minutes, serves, ingredients, steps)
end

# ---------- pages ----------

# a page of the site, with its menu at the top
to page_for with title
    set p to page's new(title + " · Recipe box")
    page's style(p, kitchen_css)
    set names to list of "Home", "Recipes", "Add one", "About"
    set addresses to list of "/", "/recipes", "/new", "/about"
    page's menu(p, names, addresses)
    return p
end

# the page, with the footer every page has, as HTML
to finished with p
    page's start(p, "footer")
    page's paragraph(p, "A Moth program: its pages made by page.moth, served by server.moth, and kept in SQLite.")
    page's finish(p)
    return page's html_of(p)
end

# how long a recipe takes, and how many it serves
to facts_of with recipe
    return (item "minutes" of recipe) + " minutes · serves " + (item "serves" of recipe)
end

# the form that finds recipes
to search_form with p, words
    page's start_form(p, "/recipes", "get")
    page's start(p, "row")
    page's text_box(p, "q", "A name or an ingredient", words)
    page's submit(p, "Find")
    page's finish(p)
    page's end_form(p)
end

# a list of recipes, each a link to its page
to recipe_links with p, recipes
    page's start_list(p)
    for each r in recipes
        page's list_link(p, (item "title" of r) + " · " + facts_of(r), "/recipes/" + (item "id" of r))
    end
    page's end_list(p)
end

to home_page with newest
    set p to page_for("Home")
    page's heading(p, "Recipe box")
    page's paragraph(p, "Good things to cook, kept in one place. Find one, or add your own.")
    search_form(p, "")
    page's subheading(p, "Newest")
    recipe_links(p, newest)
    return finished(p)
end

to list_page with recipes, words
    set p to page_for("Recipes")
    if words is ""
        page's heading(p, "Every recipe")
    else
        page's heading(p, "Recipes with “" + words + "”")
    end
    search_form(p, words)
    if length of recipes is 0
        page's paragraph(p, "Nothing has that in it. Try fewer words.")
    else
        recipe_links(p, recipes)
    end
    return finished(p)
end

to recipe_page with recipe
    set p to page_for(item "title" of recipe)
    page's heading(p, item "title" of recipe)
    page's start(p, "facts")
    page's paragraph(p, facts_of(recipe))
    page's finish(p)
    page's subheading(p, "Ingredients")
    page's start_list(p)
    for each line in lines_of(item "ingredients" of recipe)
        page's list_item(p, line)
    end
    page's end_list(p)
    page's subheading(p, "Method")
    page's start_list(p, yes)
    for each line in lines_of(item "steps" of recipe)
        page's list_item(p, line)
    end
    page's end_list(p)
    return finished(p)
end

# the form for a new recipe: with what was wrong, and what was written, when it's shown again
to new_page with problem, fields
    set p to page_for("Add a recipe")
    page's heading(p, "Add a recipe")
    if problem is not ""
        page's start(p, "mistake")
        page's paragraph(p, problem)
        page's finish(p)
    end
    page's start_form(p, "/new")
    page's text_box(p, "title", "Its name", field_of(fields, "title"))
    page's start(p, "row")
    page's text_box(p, "minutes", "Minutes", field_of(fields, "minutes"))
    page's text_box(p, "serves", "Serves", field_of(fields, "serves"))
    page's finish(p)
    page's text_area(p, "ingredients", "The ingredients, one to a line", field_of(fields, "ingredients"))
    page's text_area(p, "steps", "The steps, one to a line", field_of(fields, "steps"))
    page's submit(p, "Add it")
    page's end_form(p)
    return finished(p)
end

to about_page
    set p to page_for("About")
    page's heading(p, "About this site")
    page's paragraph(p, "This site is one Moth program. server.moth answers each request a browser makes; page.moth makes each page, a heading, a list or a form at a time, with every text made safe to show; and the recipes are kept in a SQLite database, in a file beside the program.")
    page's paragraph(p, "The same page.moth shows pages in Moth's playground, where a program is told what's clicked and typed on its page as it runs.")
    page's subheading(p, "Running it")
    page's code_block(p, "moth build recipes.moth --allow-libraries --allow-read --allow-write\nrecipes.exe")
    page's paragraph(p, "The recipes are JSON too, at /api/recipes.")
    return finished(p)
end

to not_found_page with where
    set p to page_for("Not here")
    page's heading(p, "Not here")
    page's paragraph(p, "There's nothing at " + where + ".")
    page's start_list(p)
    page's list_link(p, "Every recipe", "/recipes")
    page's end_list(p)
    return finished(p)
end

# ---------- requests ----------

# what the site sends back for a request
to answer_with with request, db
    set where to path of request
    set how to method of request
    if how is "GET" and where is "/"
        return home_page(newest_of(db, 3))
    else if how is "GET" and where is "/recipes"
        set words to trimmed(field_of(query of request, "q"))
        return list_page(found_in(db, words), words)
    else if how is "GET" and text's matches("/recipes/[0-9]\{1,9}", where)
        set parts to split where by "/"
        set wanted to number of item 3 of parts
        set recipe to recipe_of(db, wanted)
        if recipe is not nothing
            return recipe_page(recipe)
        end
    else if where is "/new"
        if how is "POST"
            set fields to form_fields(body of request)
            set problem to problem_with(fields)
            if problem is not ""
                return record with status 400, body new_page(problem, fields)
            end
            set made to add_from(db, fields)
            return record with status 303, headers (dictionary where "location" is "/recipes/" + made), body ""
        end
        return new_page("", empty dictionary)
    else if how is "GET" and where is "/about"
        return about_page()
    else if how is "GET" and where is "/api/recipes"
        return all_recipes(db)
    end
    return record with status 404, body not_found_page(where)
end
