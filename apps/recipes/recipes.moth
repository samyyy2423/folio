# A recipe box on the web, written in Moth: pages made with page.moth, served by server.moth, and kept in a
# SQLite database. Build it and run it, then open http://localhost:8080/:
#
#   moth build recipes.moth --allow-libraries --allow-read --allow-write
#   recipes.exe                  (./recipes on Linux; give a port after it for another one)

use "server.moth" as web
use "kitchen.moth" as kitchen

set recipes_port to 8080
if length of arguments is at least 1
    set recipes_port to number of item 1 of arguments
end
set recipes_db to kitchen's open_kitchen("recipes.db")

to answer with request
    return kitchen's answer_with(request, recipes_db)
end

say "The recipe box is at http://localhost:" + recipes_port + "/ (Ctrl+C stops it)"
web's serve(recipes_port, answer)
