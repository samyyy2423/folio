    "70,14 48,8 30,22 34,42 56,44 72,28 74,10 72,60 66,96",
    "70,22 50,6 30,16 30,38 52,46 70,30 72,12 74,56 64,84 44,96 24,88",
    "66,10 44,8 30,24 36,42 58,42 70,26 68,8 60,96")

# People write some digits wider than others: how much wider than its shape above each is drawn, on average.
set digit_widths to list of 1.2, 1, 1.15, 1.15, 1.2, 1.4, 1, 1, 1, 1

# One round of rounding a line's corners off (Chaikin's): each piece gives the points a quarter and three
# quarters of the way along it, and the two ends stay where they are.
to smoothed with points
    if length of points is less than 3
        return points
    end
    set made to list of item 1 of points
    for each k from 1 to length of points - 1
        set p to item k of points
        set q to item (k + 1) of points
        add record with x 0.75 * x of p + 0.25 * x of q, y 0.75 * y of p + 0.25 * y of q to made
        add record with x 0.25 * x of p + 0.75 * x of q, y 0.25 * y of p + 0.75 * y of q to made
    end
    add item (length of points) of points to made
    return made
end

# 1 in the middle of a shape (0) down to 0 at its edges (50 either way) and past them
to middle_weight with v
    set u to v / 50
    if u is greater than 1 or u is less than -1
        return 0
    end
    return 1 - u * u
end

# One way of writing `digit`, bent at random the way hands do. Its corners are moved about and then
# rounded off, once to three times, so no two have the same curves; its middle is pushed up, down or
# sideways, which changes how big its loops are; it sways in a wave; and it is stretched, slanted (to the
# right more often than the left, as most hands do), tilted, and its strokes don't quite meet. Strokes, as
# strokes_of in digits.folio gives them.
to bent with digit, way
    set ways to item (digit + 1) of shapes
    set strokes to strokes_of(item way of ways)
    set tilt to between(-0.3, 0.3)
    set slant to between(-0.65, 0.25)
    set wide to between(0.7, 1.3) * item (digit + 1) of digit_widths
    set tall to between(0.85, 1.15)
    set smoothings to item (whole(random() * 4) + 1) of (list of 1, 2, 2, 3)
    set sway_x to between(-9, 9)
    set sway_y to between(-9, 9)
    set waves_x to between(0.5, 1.5) * pi / 50
    set waves_y to between(0.5, 1.5) * pi / 50
    set start_x to between(0, 2 * pi)
    set start_y to between(0, 2 * pi)
    set push_x to between(-8, 8)
    set push_y to between(-12, 12)
    set c to cosine(tilt)
    set s to sine(tilt)
    set bent_strokes to empty list
    for each stroke in strokes
        set corners to empty list
        for each p in stroke
            add record with x x of p + between(-11, 11), y y of p + between(-11, 11) to corners
        end
        repeat smoothings times
            set corners to smoothed(corners)
        end
        set shift_x to between(-5, 5)
        set shift_y to between(-5, 5)
        set moved to empty list
        for each p in corners
            set px to x of p - 50
            set py to y of p - 50
            set px to px + push_x * middle_weight(px)
            set py to py + push_y * middle_weight(py)
            set qx to (px + sway_x * sine(py * waves_x + start_x)) * wide
            set qy to (py + sway_y * sine(px * waves_y + start_y)) * tall
            set qx to qx + slant * qy
            add record with x qx * c - qy * s + shift_x, y qx * s + qy * c + shift_y to moved
        end
        add moved to bent_strokes
    end
    return bent_strokes
end

# how many ways of writing `digit` there are
to ways_of with digit
    return length of item (digit + 1) of shapes
end
