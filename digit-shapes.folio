# The ten digits as a pen draws them, in the drawing format digits.folio reads (x and y from 0 to 100, y
# going down), with the common ways of writing some of them. digits-train.folio bends each one at random
# to make the pictures the network learns from.

set shapes to list of
    (list of "50,6 34,11 23,26 20,50 23,74 34,89 50,94 66,89 77,74 80,50 77,26 66,11 52,6", "50,6 38,14 32,34 31,58 36,82 50,94 64,82 69,58 68,34 62,14 50,6"),
    (list of "50,5 50,95", "34,20 52,5 52,95", "34,20 52,5 52,95;34,95 70,95"),
    (list of "22,26 30,12 48,5 66,10 77,24 72,42 52,62 22,94 82,94", "20,22 40,6 64,6 76,22 70,42 40,70 20,94 80,90", "24,28 34,10 54,5 72,14 74,32 58,52 30,80 22,94 40,86 60,88 82,92"),
    (list of "22,14 40,5 62,7 74,20 66,38 46,47 66,54 78,70 72,88 50,96 24,88", "20,6 76,6 46,40 66,46 78,64 72,86 50,96 22,88"),
    (list of "60,5 16,64 86,64;66,36 66,96", "26,5 20,60 84,60;66,8 66,96"),
    (list of "78,6 32,6 26,44 46,40 66,44 78,60 74,82 54,95 26,88", "30,6 26,44 46,40 66,44 78,60 74,82 54,95 26,88;30,6 78,6"),
    (list of "70,6 48,14 30,38 22,64 30,88 50,96 70,88 76,68 64,52 44,50 26,62", "66,6 40,30 26,58 28,84 48,96 70,86 74,64 56,52 36,58 28,70"),
    (list of "16,6 84,6 40,96", "16,6 84,6 40,96;36,52 72,52", "16,10 30,6 84,6 52,50 40,96"),
    (list of "50,48 30,36 28,16 50,5 72,16 70,36 50,48 26,64 24,85 50,96 76,85 74,64 50,48", "50,50 70,36 72,16 50,5 28,16 30,36 50,50 72,66 74,86 50,96 26,86 28,66 50,50"),
    (list of "74,28 62,8 40,6 26,20 28,40 46,48 66,42 74,28 72,96", "74,28 62,8 40,6 26,20 28,40 46,48 66,42 74,28 66,70 46,96", "74,30 60,8 36,8 26,24 34,42 56,44 74,30 74,60 70,96")

# One way of writing `digit`, bent at random the way hands do: tilted, slanted, stretched, a little shaky,
# and with its strokes not quite meeting. Strokes, as strokes_of in digits.folio gives them.
to bent with digit, way
    set ways to item (digit + 1) of shapes
    set strokes to strokes_of(item way of ways)
    set tilt to between(-0.3, 0.3)
    set slant to between(-0.4, 0.4)
    set wide to between(0.6, 1.3)
    set tall to between(0.8, 1.2)
    set c to cosine(tilt)
    set s to sine(tilt)
    set bent_strokes to empty list
    for each stroke in strokes
        set shift_x to between(-6, 6)
        set shift_y to between(-6, 6)
        set moved to empty list
        for each p in stroke
            set px to (x of p - 50) * wide
            set py to (y of p - 50) * tall
            set px to px + slant * py
            add record with x px * c - py * s + shift_x + between(-5, 5), y px * s + py * c + shift_y + between(-5, 5) to moved
        end
        add moved to bent_strokes
    end
    return bent_strokes
end

# how many ways of writing `digit` there are
to ways_of with digit
    return length of item (digit + 1) of shapes
end
