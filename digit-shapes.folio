    "20,6 76,6 46,40 66,46 78,64 72,86 50,96 22,88",
    "24,18 42,6 66,10 72,28 58,44 36,48 60,52 76,68 70,88 46,96 22,84",
    "30,12 50,5 66,14 62,32 44,42 68,50 80,70 68,90 44,96 20,86",
