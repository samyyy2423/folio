# Moth's compiler, written in Moth. It reads a Moth program and writes the same JavaScript as jit.js,
# byte for byte, and stops at the same mistakes with the same messages. mothCompiler() in moth.js runs
# it, and the tests check that it compiles itself into a compiler that does exactly the same.
#
# It has the parts the JavaScript compiler has: tokenize turns text into tokens, parse turns tokens into
# a syntax tree of records, the scope rules give every variable a slot, and the code writer turns the
# tree into JavaScript. A name a function sets belongs to the top level when the top level sets it too,
# so the names set out here at the top are never set anywhere else.

# ---------- small helpers ----------

to letters with text
    set found to empty list
    for each one in text
        add one to found
    end
    return found
end

to contains with things, wanted
    for each thing in things
        if thing is wanted
            return yes
        end
    end
    return no
end

to joined with things, separator
    set out to ""
    set first to yes
    for each thing in things
        if not first
            add separator to out
        end
        add thing to out
        set first to no
    end
    return out
end

# the item of `values` at the place `key` has in `known`, or nothing
to look_up with key, known, values
    for each n from 1 to length of known
        if item n of known is key
            return item n of values
        end
    end
    return nothing
end

# A mistake in the program being compiled, at a token or at a spot made by place().
to problem with at, reason
    return record with at at, reason reason
end

to place with line, col, file
    return record with type "", line line, col col, file file
end

# ---------- characters ----------

set capitals to letters("ABCDEFGHIJKLMNOPQRSTUVWXYZ")
set smalls to letters("abcdefghijklmnopqrstuvwxyz")
set symbols to letters("-+*/(),")
# symbols people type out of habit from other languages, and what Moth says instead
set hint_symbols to list of "=", "!", "<", ">", "%", "[", "]", "{", "}", "'", "."
set hint_texts to list of "to store a value write 'set x to 5', to compare write 'x is 5'", "write 'is not'",
    "write 'is less than'", "write 'is greater than'", "write 'is divisible by'",
    "make a list with 'list of 1, 2, 3'", "make a list with 'list of 1, 2, 3'",
    "blocks finish with 'end', not braces", "blocks finish with 'end', not braces",
    "put text in double quotes", "to get a field write 'name of person'"

to is_digit with c
    return c is at least "0" and c is at most "9"
end

to is_hex with c
    return is_digit(c) or (c is at least "a" and c is at most "f") or (c is at least "A" and c is at most "F")
end

to is_bit with c
    return c is "0" or c is "1"
end

to starts_word with c
    return (c is at least "a" and c is at most "z") or (c is at least "A" and c is at most "Z") or c is "_"
end

to in_word with c
    return starts_word(c) or is_digit(c)
end

to small with c
    if c is at least "A" and c is at most "Z"
        return look_up(c, capitals, smalls)
    end
    return c
end

# the folder a file is in, as its name has it: up to its last / or \, or "" for one in the program's own
to folder_of with name
    set cut to 0
    set k to 0
    for each c in name
        add 1 to k
        if c is "/" or c is "\\"
            set cut to k
        end
    end
    set made to ""
    set k to 0
    for each c in name
        add 1 to k
        if k is at most cut
            add c to made
        end
    end
    return made
end

# whether a package's name is one: letters, digits, '-', '_' and '.'
to package_name with name
    if name is ""
        return no
    end
    for each c in name
        if not (in_word(c) or c is "-" or c is ".")
            return no
        end
    end
    return yes
end

# what text can hold: any character but a control character, except tab
to fits_text with c
    return c is "\t" or c is at least " "
end

# How many columns a character takes, counted as JavaScript counts them: 2 for the characters past the
# first 65,536, which run from the first character below to the second, and are 4 bytes of UTF-8. Half of
# one on its own sorts among them, but is 1 column, and becomes 3 bytes, those of the replacement character.
to width with c
    if c is at least "𐀀" and c is at most "􏿿" and length of (c as bytes) is 4
        return 2
    end
    return 1
end

# ---------- tokens ----------

# what a mistake in a value inside text adds, for text written before there were values in it
set brace_hint to "to write a '{' itself, put '\\' before it"

# `file` names a file the program uses, for errors in it ("" for the program's own)
to tokenize with source, file
    return tokens_from(source, file, nothing)
end

# `begins`, for a value inside text ("Hi {name}"), is where it starts, as place gives it: its tokens are
# counted from there, and end with a '}'
to tokens_from with source, file, begins
    set chars to letters(source)
    add "" to chars # the end, so looking one past the last character is safe
    set tokens to empty list
    set line to 1
    set col to 1
    set nl to yes # does the next token start a new line?
    if begins is not nothing
        set line to line of begins
        set col to col of begins
        set nl to no
    end
    set k to 1
    repeat while item k of chars is not ""
        set c to item k of chars
        set start to col
        if c is at most " " # every control character counts as a space
            if c is "\n"
                add 1 to line
                set col to 1
                set nl to yes
            else
                add 1 to col
            end
            add 1 to k
        else if c is "#"
            repeat while item k of chars is not "\n" and item k of chars is not ""
                add width(item k of chars) to col
                add 1 to k
            end
        else if is_digit(c)
            set text to ""
            set next to item (k + 1) of chars
            if c is "0" and next is "x" and is_hex(item (k + 2) of chars) # 0xFF
                set text to "0x"
                set k to k + 2
                repeat while is_hex(item k of chars)
                    add item k of chars to text
                    add 1 to k
                end
            else if c is "0" and next is "b" and is_bit(item (k + 2) of chars) # 0b1010
                set text to "0b"
                set k to k + 2
                repeat while is_bit(item k of chars)
                    add item k of chars to text
                    add 1 to k
                end
            else
                repeat while is_digit(item k of chars)
                    add item k of chars to text
                    add 1 to k
                end
                if item k of chars is "." and is_digit(item (k + 1) of chars)
                    add "." to text
                    add 1 to k
                    repeat while is_digit(item k of chars)
                        add item k of chars to text
                        add 1 to k
                    end
                end
            end
            add record with type "number", value text, line line, col start, nl nl, file file to tokens # kept as written
            set col to start + length of text
            set nl to no
        else if starts_word(c)
            set text to ""
            set as_written to ""
            repeat while in_word(item k of chars)
                add small(item k of chars) to text
                add item k of chars to as_written
                add 1 to k
            end
            add record with type "word", value text, line line, col start, nl nl, file file, raw as_written to tokens
            set col to start + length of text
            set nl to no
        else if c is "\""
            set ends to text_end(chars, k)
            if brace of ends is not nothing
                fail with problem(place(line, col_at(chars, k, col, brace of ends), file), "this '{' has no '}' to end it (" + brace_hint + ")")
            end
            if k of ends is nothing
                fail with problem(place(line, start, file), "this text is missing its closing quote")
            end
            set text to "" # as it reads: what follows a backslash is the text's own
            set ti to k + 1
            repeat while ti is less than k of ends - 1
                set d to item ti of chars
                if d is "\\"
                    add 1 to ti
                    set d to item ti of chars
                    if d is "n"
                        set d to "\n"
                    else if d is "t"
                        set d to "\t"
                    end
                end
                add d to text
                add 1 to ti
            end
            set parts to text_parts(chars, k + 1, k of ends - 1, line, col + 1, file)
            add record with type "string", value text, line line, col start, nl nl, file file, parts parts to tokens
            set col to col_at(chars, k, col, k of ends)
            set k to k of ends
            set nl to no
        else if contains(symbols, c)
            add record with type c, value c, line line, col start, nl nl, file file to tokens
            add 1 to k
            add 1 to col
            set nl to no
        else if c is "'" and item (k + 1) of chars is "s" and not in_word(item (k + 2) of chars) # `math's sine`
            add record with type "'s", value "'s", line line, col start, nl nl, file file to tokens
            add 2 to k
            add 2 to col
            set nl to no
        else
            set hint to look_up(c, hint_symbols, hint_texts)
            if begins is not nothing
                set hint to brace_hint
            end
            if hint is nothing
                set hint to ""
            else
                set hint to " (" + hint + ")"
            end
            fail with problem(place(line, start, file), "I don't understand '" + c + "'" + hint)
        end
    end
    if begins is not nothing
        add record with type "}", value "}", line line, col col, nl yes, file file to tokens
    end
    add record with type "eof", value "", line line, col col, nl yes, file file to tokens
    return tokens
end

# a '{' right before one of these starts a value in text: a name, or a bracket
to starts_value with c
    return starts_word(c) or c is "("
end

# Text that starts with the quote at character k of chars: a record of `k`, the character just past its
# closing quote, and `brace`, the character of a value's '{' in it that nothing ends, or nothing; `k` is
# nothing too if the line ends first. A value ("Hi {name}") ends at its own '}', and can have text of its
# own inside it.
to text_end with chars, k
    set te_k to k + 1
    repeat while item te_k of chars is not "\""
        set te_c to item te_k of chars
        if te_c is "\\" and fits_text(item (te_k + 1) of chars)
            set te_k to te_k + 2
        else if not fits_text(te_c)
            return record with k nothing, brace nothing
        else if te_c is "{" and starts_value(item (te_k + 1) of chars)
            set te_value to value_end(chars, te_k)
            if brace of te_value is not nothing
                return te_value
            end
            set te_k to k of te_value + 1
        else
            add 1 to te_k
        end
    end
    return record with k te_k + 1, brace nothing
end

# The value in text whose '{' is character k of chars: a record of `k`, its '}', or `brace`, k itself, if
# nothing ends it, the text inside it included
to value_end with chars, k
    set ve_k to k + 1
    repeat while item ve_k of chars is not "}"
        set ve_c to item ve_k of chars
        if not fits_text(ve_c)
            return record with k nothing, brace k
        end
        if ve_c is "\""
            set ve_inside to text_end(chars, ve_k)
            if k of ve_inside is nothing
                return record with k nothing, brace k
            end
            set ve_k to k of ve_inside
        else
            add 1 to ve_k
        end
    end
    return record with k ve_k, brace nothing
end

# the column of character `there` of chars, on the line where character `here` is at column `here_col`
to col_at with chars, here, here_col, there
    set ca_col to here_col
    for each ca_k from here to there - 1
        add width(item ca_k of chars) to ca_col
    end
    return ca_col
end

# "Hi {name}!": text with values in it. A '{' right before a letter, '_' or '(' starts a value, which ends at
# its own '}'; any other '{' is itself, and so is '\{'. Gives the text and each value's tokens, in order, each
# a record of its text or its tokens, or nothing for text with no value in it. The text as written is chars
# `first` to just before `upto`, from column `col` of `line`.
to text_parts with chars, first, upto, line, col, file
    set parts to empty list
    set piece to "" # the text since the last value, as it reads
    set i to first
    repeat while i is less than upto
        set c to item i of chars
        if c is "\\"
            set c to item (i + 1) of chars
            if c is "n"
                set c to "\n"
            else if c is "t"
                set c to "\t"
            end
            add c to piece
            add width(item i of chars) + width(item (i + 1) of chars) to col
            set i to i + 2
        else if c is "{" and starts_value(item (i + 1) of chars)
            set closing to k of value_end(chars, i)
            if piece is not ""
                add (record with text piece, tokens nothing) to parts
                set piece to ""
            end
            set inside to ""
            for each j from i + 1 to closing - 1
                add item j of chars to inside
            end
            add (record with text nothing, tokens tokens_from(inside, file, place(line, col + 1, file))) to parts
            set col to col_at(chars, i, col, closing + 1)
            set i to closing + 1
        else
            add c to piece
            add width(c) to col
            add 1 to i
        end
    end
    if length of parts is 0
        return nothing
    end
    if piece is not ""
        add (record with text piece, tokens nothing) to parts
    end
    return parts
end

# ---------- syntax tree ----------

# words that start a statement or a value, so they can't name a variable
set reserved to list of "set", "add", "say", "if", "else", "end", "repeat", "while", "for", "to", "return", "and", "or",
    "not", "is", "yes", "no", "nothing", "list", "empty", "length", "item", "move", "turn", "pen", "record", "fail", "stop",
    "uppercase", "lowercase", "split", "join", "number", "position", "ask", "use", "try", "dictionary", "remove", "keys", "in",
    "byte", "bytes", "as", "shift", "read", "write", "arguments", "expect", "clear", "draw", "when", "every"
# the words that can carry a value on, as in `draw picture at 0, 0` (which draws the text `picture` holds):
# `draw picture` followed by any other word, or by text, a number or a bracket with a space before it (one
# with none calls `picture`), draws a picture from a file
set carry_on to list of "at", "of", "bit", "is", "and", "or", "in", "as", "bytes"
# The language's own functions, in Moth, put in a program that needs them as a file used as "the language" is
# (DESIGN §97): moth.js's LANGUAGE, which a test holds this to
set language_text to "# What some of Moth's statements are written with (DESIGN §97), put in a program that needs them, its names\n# kept apart as a file used as \"the language\" is\n\n# n as text, with exactly so many decimals, the last rounded a half away from 0, as n is shown\nto with_decimals with n as a number, places as a number\n    if not (places is divisible by 1) or places is less than 0 or places is greater than 100\n        fail with \"'with ... decimals' needs a whole number of decimals from 0 to 100, not \" + places\n    end\n    set written to \"\" + n\n    if written is \"Infinity\" or written is \"-Infinity\" or written is \"NaN\"\n        return written\n    end\n    set negative to n is less than 0\n    if negative\n        set written to \"\" + (0 - n)\n    end\n    set power to 0\n    set e_at to position of \"e\" in written\n    if e_at is greater than 0\n        set power_text to items (e_at + 1) to (length of written) of written\n        if item 1 of power_text is \"+\"\n            set power_text to items 2 to (length of power_text) of power_text\n        end\n        set power to number of power_text\n        set written to items 1 to (e_at - 1) of written\n    end\n    set dot to position of \".\" in written\n    set digits to written\n    set point to length of written\n    if dot is greater than 0\n        set digits to (items 1 to (dot - 1) of written) + (items (dot + 1) to (length of written) of written)\n        set point to dot - 1\n    end\n    set point to point + power\n    repeat while point is less than 1\n        set digits to \"0\" + digits\n        set point to point + 1\n    end\n    repeat while length of digits is less than point + places + 1\n        set digits to digits + \"0\"\n    end\n    set kept to items 1 to (point + places) of digits\n    if position of (item (point + places + 1) of digits) in \"56789\" is greater than 0\n        set kept to one_more(kept)\n        if length of kept is greater than point + places\n            set point to point + 1\n        end\n    end\n    set made to items 1 to point of kept\n    if places is greater than 0\n        set made to made + \".\" + (items (point + 1) to (point + places) of kept)\n    end\n    if negative and not_all_zero(made)\n        return \"-\" + made\n    end\n    return made\nend\n\n# whole number digits, one more\nto one_more with kept\n    set made to \"\"\n    set carrying to yes\n    set k to length of kept\n    repeat while k is at least 1\n        set d to item k of kept\n        if carrying and d is \"9\"\n            set made to \"0\" + made\n        else if carrying\n            set made to (item ((position of d in \"0123456789\") + 1) of \"0123456789\") + made\n            set carrying to no\n        else\n            set made to d + made\n        end\n        set k to k - 1\n    end\n    if carrying\n        return \"1\" + made\n    end\n    return made\nend\n\nto not_all_zero with made\n    for each c in made\n        if c is not \"0\" and c is not \".\"\n            return yes\n        end\n    end\n    return no\nend\n\n# a value as its kind shows it: the function in its shown field, if it has one, given it; or the value\nto shown with value\n    set shown_by to nothing\n    try\n        set shown_by to shown of value\n        a_function(shown_by)\n    if it fails\n        return value\n    end\n    return shown_by(value)\nend\n\nto a_function with f as a function\nend\n"
# in the order of BUILTINS in vm.js
set builtin_names to list of "uppercase", "lowercase", "split", "join", "number", "position", "keys", "bit and", "bit or", "bit xor",
    "shift left", "shift right", "bytes", "as bytes", "as text", "as hex", "as binary", "unit", "in", "table", "column", "total",
    "average", "largest", "smallest", "run program", "run program keeping", "order", "order by", "reverse order", "reverse order by",
    "save", "load", "as json", "json from", "send", "send with headers", "read with headers", "read bytes with headers", "ticked", "choice in list", "text in box", "slider value", "chosen file",
    "library call", "power", "items", "rounded down", "rounded up", "rounded", "remainder", "start", "wait for", "has ended",
    "start worker"
# whether a file `use` names could be outside the program's folder: from the top of a disk ("/x", "C:x"), or
# going up out of a folder ("../x")
to outside_folder with wanted
    set name_start to ""
    set name_second to ""
    set name_part to ""
    set goes_up to no
    set name_count to 0
    for each c in wanted
        add 1 to name_count
        if name_count is 1
            set name_start to c
        else if name_count is 2
            set name_second to c
        end
        if c is "/" or c is "\\"
            if name_part is ".."
                set goes_up to yes
            end
            set name_part to ""
        else
            add c to name_part
        end
    end
    if name_part is ".."
        set goes_up to yes
    end
    set from_top to name_start is "/" or name_start is "\\"
    set drive to name_second is ":" and name_start is not "" and position of name_start in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ" is greater than 0
    return goes_up or from_top or drive
end

# `total of prices`: these words and `of` work out something from a list
set aggregates to list of "total", "average", "largest", "smallest"
# the words of the units an amount can have (`5 km`), each way vm.js's UNITS writes them
set unit_words to list of "mm", "cm", "m", "km", "millimetre", "millimetres", "centimetre", "centimetres", "metre", "metres",
    "kilometre", "kilometres", "millimeter", "millimeters", "centimeter", "centimeters", "meter", "meters", "kilometer",
    "kilometers", "inch", "inches", "foot", "feet", "yard", "yards", "mile", "miles", "millisecond", "milliseconds", "second",
    "seconds", "minute", "minutes", "hour", "hours", "day", "days", "week", "weeks", "mg", "g", "kg", "milligram", "milligrams",
    "gram", "grams", "kilogram", "kilograms", "ounce", "ounces", "pound", "pounds", "tonne", "tonnes", "ml", "millilitre",
    "millilitres", "litre", "litres", "milliliter", "milliliters", "liter", "liters"
# how many milliseconds each unit of time is, for `every 2 seconds`
set time_units to dictionary where "millisecond" is 1, "milliseconds" is 1, "second" is 1000, "seconds" is 1000,
    "minute" is 60000, "minutes" is 60000, "hour" is 3600000, "hours" is 3600000, "day" is 86400000, "days" is 86400000,
    "week" is 604800000, "weeks" is 604800000
set bit_words to list of "and", "or", "xor" # `a bit and b`; `bit` alone is still a name
# a line that starts like a phrase but isn't one, which would otherwise be a call to a function nothing made
set phrase_hints to dictionary where "wait" is "to wait, say how long: 'wait 2 seconds'",
    "send" is "to send, say where: 'set reply to send data to \"https://...\"'",
    "save" is "to save a value, say where: 'save scores to \"scores.txt\"'",
    "start" is "to start a task, give it a function's call: 'start work(5)'"
# `the time`, `the date`, ... `the clock`, in the order of NOW_WORDS in vm.js
set now_words to list of "time", "date", "year", "month", "day", "hour", "minute", "second", "weekday", "clock"
# what an input can say it is, `with width as a number`, in the order of KINDS in vm.js
set kind_phrases to list of (list of "a", "number"), (list of "text"), (list of "yes", "or", "no"), (list of "a", "list"),
    (list of "a", "record"), (list of "a", "dictionary"), (list of "bytes"), (list of "a", "function")
set as_words to list of "bytes", "text", "hex", "binary", "json" # `block as text`
# what a library's function can take and give, in the order of LIBRARY_TYPES in moth.js, and what Moth
# checks each input is, as kind_phrases numbers them (-1 for anything)
set library_types to list of "a number", "a float", "a whole number", "a long whole number", "a pointer", "text", "wide text", "bytes",
    "yes or no", "a byte", "a signed byte", "a short whole number", "an unsigned short whole number", "an unsigned whole number",
    "an unsigned long whole number", "a list of numbers"
set library_kinds to list of 0, 0, 0, 0, -1, 1, 1, 6, 2, 0, 0, 0, 0, 0, 0, 3
# buttons and text boxes (DESIGN §36): `when enter is pressed in the text box "Name"`, `the text in the text box
# "Name"`, and the words that can follow a value, so `draw button at 0, 0` still draws a variable called button
set enter_phrase to list of "enter", "is", "pressed", "in", "the", "text", "box"
set text_in_box to list of "the", "text", "in", "the", "text", "box"
# checkboxes, text areas and lists (DESIGN §40)
set chosen_phrase to list of "an", "item", "is", "chosen", "in", "the", "list"
set text_in_area to list of "the", "text", "in", "the", "text", "area"
set choice_in_list to list of "the", "choice", "in", "the", "list"
# dropdowns, sliders and choosing a file (DESIGN §42)
set chosen_in_dropdown to list of "an", "item", "is", "chosen", "in", "the", "dropdown"
set choice_in_dropdown to list of "the", "choice", "in", "the", "dropdown"
set value_of_slider to list of "the", "value", "of", "the", "slider"
set choose_file to list of "choose", "a", "file", "to"
set after_a_value to list of "at", "of", "bytes", "as", "in", "bit", "is", "and", "or"
set comparison_phrases to list of "less than", "greater than", "at least", "at most", "divisible by"

# Each function the parser makes gets the next number (`order`), so the functions are numbered in the order
# they're written, in the files the program uses too: see made_order.
set functions_made to 0

# Every node is a record that keeps the token it came from (`at`), so mistakes can point at it.
# `reading` also carries, for tidying code, `layout`: how deep in blocks each statement starts, and each
# end, else and if it fails, by "line:col"; and `tight`: the pieces written with no space after them, a
# negating minus and a call's bracket, which only the parser can tell from the others. Both are
# dictionaries, or nothing when nothing is being tidied, and only the program's own file goes in them.
# `reading` is shared with the files the program uses: `files` (a list of records with a name and a text),
# `loaded` (every file read so far, since each is read once), and `open` (the files being read right now).
to parse with tokens, reading
    set depth_now to 0 # how many files are being read: the program's first (see fill_defaults)
    try
        set depth_now to depth of reading
    if it fails
    end
    if depth_now is 0
        set calls of reading to empty list
        set defines of reading to empty list
        set owns of reading to empty list
        set wants of reading to empty list
        set shows of reading to empty list
    end
    set depth of reading to depth_now + 1
    set orders_from to functions_made # functions are numbered on from here (see numbered)
    set pos to 1
    set aliases to empty list # the names this file used files and libraries `as`: `x's` is theirs, any other a value's
    set at_top to no # directly in the program, not in a block or a function
    set fn_depth to 0
    set loop_depth to 0 # loops around this spot, in this function: `stop` needs one
    set indexing to no # inside `item ... of`, where a name followed by `of` is the item number, not a field
    set converting to yes # `trip in miles`; not in `position of ... in`, whose `in` is its own
    set nesting to 0 # blocks around the statement being read, for `lay`
    set hoisted to empty list # functions the statement being read makes for its values (see unnamed)
    set unnamed_on_line to empty dictionary # how many each line has made, so each has a name of its own
    set hidden_on_line to empty dictionary # the same, for variables of the program's own (see hidden_name)
    set tight_marks to empty list # the marks tight made, in order, so a phrase that isn't one can take its own back

    # where a statement starts, and how deep it is, for tidying
    to lay with t
        if layout of reading is not nothing and file of t is ""
            set item (line of t + ":" + col of t) of (layout of reading) to nesting
        end
    end

    # a piece with no space after it, for tidying; gives it back, so it can mark one as it takes it
    to tight with t
        if t and tight of reading is not nothing and file of t is ""
            set mark_key to line of t + ":" + col of t
            if not (mark_key is in tight of reading)
                set item mark_key of (tight of reading) to yes
                add mark_key to tight_marks
            end
        end
        return t
    end

    # whether token i is a unit's word (`km`, `hours`), on the same line as what's before it
    to unit_at with i
        set unit_token to item i of tokens
        return type of unit_token is "word" and not nl of unit_token and contains(unit_words, value of unit_token)
    end

    to peek
        return item pos of tokens
    end

    to check with type
        return type of item pos of tokens is type
    end

    to match with type
        if check(type)
            set pos to pos + 1
            return item (pos - 1) of tokens
        end
        return no
    end

    to is_word with w
        return check("word") and value of peek() is w
    end

    # a call by a name, noted for the inputs it may leave out (see fill_defaults)
    to made_call with call_name, call_args, call_at
        set made_one to record with kind "call", name call_name, args call_args, at call_at
        set noted to calls of reading
        add made_one to noted
        return made_one
    end

    to word with w
        if is_word(w)
            set pos to pos + 1
            return item (pos - 1) of tokens
        end
        return no
    end

    to describe with t
        if type of t is "eof"
            return "the end of the code"
        end
        if type of t is "string"
            return "\"" + value of t + "\""
        end
        return "'" + value of t + "'"
    end

    to expected with what
        fail with problem(peek(), "expected " + what + " but found " + describe(peek()))
    end

    to expect_word with w
        set t to word(w)
        if not t
            expected("'" + w + "'")
        end
        return t
    end

    to word_at with i, w
        set ahead to item i of tokens
        return type of ahead is "word" and value of ahead is w
    end

    # `run program "git" with (list of "status")`: `run` alone is still a name
    to runs_program
        set after to item (pos + 1) of tokens
        return type of after is "word" and value of after is "program" and not nl of after
    end

    # `load "scores.txt"`, `load name`: `load` alone, or with `of` after it, is still a name
    to loads_file
        set after to item (pos + 1) of tokens
        if nl of after
            return no
        end
        return type of after is "string" or (type of after is "word" and not contains(reserved, value of after) and value of after is not "of")
    end

    # `send data to "https://..."`: `send` alone is still a name, and so is one not followed by a value and `to`
    # on its line
    to sends_data
        if nl of item (pos + 1) of tokens
            return no
        end
        set send_start to pos
        set sends to no
        try
            set pos to pos + 1
            expression()
            set sends to is_word("to") and not nl of peek()
        if it fails
            set sends to no
        end
        set pos to send_start
        return sends
    end

    # `json from reply`: `json` alone is still a name
    to json_from
        return word_at(pos + 1, "from") and not nl of item (pos + 1) of tokens
    end

    # ` with headers h`, after a site's address
    to with_headers
        if nl of peek() or not word_at(pos, "with") or not word_at(pos + 1, "headers") or nl of item (pos + 1) of tokens
            return no
        end
        set pos to pos + 2
        return yes
    end

    # A phrase that starts with a word that could be a name: `wait 2 seconds`, `save x to "f"`. It gives the
    # node, or nothing if this isn't the phrase after all, which makes the line a call again.
    to try_phrase with which, t
        set start to pos
        set marks_before to length of tight_marks
        set node to nothing
        try
            set pos to pos + 1
            if which is "wait"
                set node to wait_rest(t)
            else if which is "start" or which is "start value"
                set node to start_rest(which is "start")
            else if which is "items"
                set node to items_rest(t)
            else if which is "remainder"
                set node to remainder_rest(t)
            else
                set node to save_rest(t)
            end
        if it fails
            set node to nothing
        end
        if node is nothing
            set pos to start
            set kept_marks to empty list
            for each k from 1 to length of tight_marks
                if k is at most marks_before
                    add item k of tight_marks to kept_marks
                else
                    remove item k of tight_marks from (tight of reading)
                end
            end
            set tight_marks to kept_marks
        end
        return node
    end

    # A function with no name of its own, made before the statement it's in runs, with one that no name can be:
    # `function on line 3`, then `function on line 3 (2)`. Gives that name.
    to unnamed with what, fn_params, fn_body, t
        set line_key to what + " " + line of t
        set n to 1
        if line_key is in unnamed_on_line
            set n to item line_key of unnamed_on_line + 1
        end
        set item line_key of unnamed_on_line to n
        set named to what + " on line " + line of t
        if n is greater than 1
            set named to named + " (" + n + ")"
        end
        set fn_kinds to empty list
        for each p in fn_params
            add -1 to fn_kinds
        end
        add (record with kind "define", name named, params fn_params, kinds fn_kinds, body fn_body, at t, order 0, native nothing, defaults nothing,
            types nothing, gives nothing, made_kind nothing) to hoisted
        return named
    end

    # `list of x * 2 for each x in xs where x is greater than 1`: a call to a function, made before the statement,
    # that goes through what it's given, calling one function of x for each item (`list on line 3`) and, with
    # `where`, another that says whether to keep it, as each item's own input, so x is theirs alone
    # `value_fns`: the functions the item's value made, which are the first function's own.
    to built_list with value, value_fns, t
        set pos to pos + 2
        set variable to take_name("a variable name")
        expect_word("in")
        set over to expression()
        set outside_fns to hoisted
        set hoisted to empty list
        set keep to nothing
        if word("where")
            set keep to expression()
        end
        set keep_fns to hoisted
        set hoisted to outside_fns
        set each_body to value_fns
        add (record with kind "return", value value, at t) to each_body
        set each_fn to unnamed("list", (list of variable), each_body, t)
        set test_fn to nothing
        if keep is not nothing
            set test_body to keep_fns
            add (record with kind "return", value keep, at t) to test_body
            set test_fn to unnamed("test for the list", (list of variable), test_body, t)
        end
        set one_item to list of (record with kind "name", name "each item", at t)
        set adding to record with kind "add", name "the list made", value (record with kind "call", name each_fn, args one_item, at t), at t
        set loop_body to list of adding
        if test_fn is not nothing
            set kept_if to record with kind "if", cond (record with kind "call", name test_fn, args one_item, at t), then (list of adding), otherwise empty list, at t
            set loop_body to list of kept_if
        end
        set loop to record with kind "each", name "each item", over (record with kind "name", name "the items", at t), body loop_body, at t
        set start_made to record with kind "set", name "the list made", value (record with kind "list", items empty list, at t), at t
        set give_made to record with kind "return", value (record with kind "name", name "the list made", at t), at t
        set builder to unnamed("building the list", (list of "the items"), (list of start_made, loop, give_made), t)
        return made_call(builder, (list of over), t)
    end

    # `remainder of 17 divided by 5`
    to remainder_rest with t
        expect_word("of")
        set whole to additive()
        expect_word("divided")
        expect_word("by")
        set left_args to list of whole, postfix(unary())
        return record with kind "builtin", name "remainder", args left_args, at t
    end

    # `xs without repeats`: a call to a function, made before the statement, that adds each item it hasn't
    # already to a new list
    to without_repeats with over, t
        set one_item to record with kind "name", name "each item", at t
        set made_list to record with kind "name", name "the list made", at t
        set adding to record with kind "add", name "the list made", value one_item, at t
        set fresh to record with kind "compare", op "in", negate yes, left one_item, right made_list, at t
        set kept_if to record with kind "if", cond fresh, then (list of adding), otherwise empty list, at t
        set loop to record with kind "each", name "each item", over (record with kind "name", name "the items", at t), body (list of kept_if), at t
        set start_made to record with kind "set", name "the list made", value (record with kind "list", items empty list, at t), at t
        set give_made to record with kind "return", value made_list, at t
        set fn_name to unnamed("without repeats", (list of "the items"), (list of start_made, loop, give_made), t)
        return made_call(fn_name, (list of over), t)
    end

    # `items 2 to 4 of xs`
    to items_rest with t
        set outside to indexing
        set indexing to yes
        set slice_from to additive()
        expect_word("to")
        set slice_upto to additive()
        set indexing to outside
        expect_word("of")
        set slice_args to list of slice_from, slice_upto, unary()
        return record with kind "builtin", name "items", args slice_args, at t
    end

    # `start count(10)`: the builtin, "start" or, `on another core`, "start worker" (DESIGN §124), and the call;
    # or nothing if what follows `start` isn't one (or, for a line of its own, if anything follows it)
    to start_rest with whole_line
        set started to primary()
        if kind of started is not "call"
            return nothing
        end
        set which to "start"
        if words_at(pos, list of "on", "another", "core")
            set pos to pos + 3
            set which to "start worker"
        end
        if whole_line and not nl of peek()
            return nothing
        end
        return record with name which, call started
    end

    # `wait 2 seconds`, `wait n milliseconds`
    to wait_rest with t
        set amount to additive()
        set unit to 0
        if kind of amount is "builtin" and name of amount is "unit"
            set unit_word to value of item 2 of args of amount
            if unit_word is in time_units # `wait 2 seconds`: the number, and its unit
                set unit to item unit_word of time_units
                set amount to item 1 of args of amount
            end
        else if kind of amount is "negate" and kind of operand of amount is "builtin" and name of operand of amount is "unit"
            set unit_word to value of item 2 of args of operand of amount # `wait -2 seconds`, a mistake when it runs
            if unit_word is in time_units
                set unit to item unit_word of time_units
                set amount to record with kind "negate", operand item 1 of args of operand of amount, at at of amount
            end
        end
        if unit is 0
            if unit_at(pos) and value of peek() is in time_units # `wait n seconds`
                set unit to item (value of peek()) of time_units
                set pos to pos + 1
            else
                return nothing
            end
        end
        if not nl of peek()
            return nothing
        end
        return record with kind "wait", amount amount, unit unit, at t
    end

    # `save scores to "scores.txt"`: `write` of what `load` reads back
    to save_rest with t
        set value to expression()
        if not word("to")
            return nothing
        end
        set save_args to list of value
        set saved to record with kind "builtin", name "save", args save_args, at t
        return record with kind "write", value saved, target expression(), at t
    end

    # these words from token i on, on the line before them
    to words_at with i, wanted
        set ahead_at to i
        for each wanted_word in wanted
            if not word_at(ahead_at, wanted_word) or nl of item ahead_at of tokens
                return no
            end
            set ahead_at to ahead_at + 1
        end
        return yes
    end

    # a button's label can start at token i: a value there on the same line, where today `button` would end one
    to label_at with i
        set label_token to item i of tokens
        if nl of label_token
            return no
        end
        if type of label_token is "string" or type of label_token is "number"
            return yes
        end
        return type of label_token is "word" and not contains(after_a_value, value of label_token)
    end

    # `play note ...` and `play a beep`: `play` alone is still a name, and so are `note`, `a` and `beep`
    to plays_sound
        if not is_word("play") or nl of item (pos + 1) of tokens
            return no
        end
        if word_at(pos + 1, "note")
            return yes
        end
        return word_at(pos + 1, "a") and word_at(pos + 2, "beep") and not nl of item (pos + 2) of tokens
    end

    to take_name with what
        set t to peek()
        if type of t is not "word"
            expected(what)
        end
        if contains(reserved, value of t)
            fail with problem(t, "'" + value of t + "' is a Moth word, so it can't be used as " + what)
        end
        set pos to pos + 1
        return value of t
    end

    to more with opener
        if opener is nothing
            return not check("eof")
        end
        return not is_word("end") and not is_word("else")
    end

    # the line that starts a `try`'s handler: `if it fails`
    to is_if_it_fails
        if not is_word("if") or pos + 2 is greater than length of tokens
            return no
        end
        set next to item (pos + 1) of tokens
        set after to item (pos + 2) of tokens
        return type of next is "word" and value of next is "it" and type of after is "word" and value of after is "fails"
    end

    # the line that starts what a `try` does however it ends: `either way`, alone on its line
    to is_either_way
        if not is_word("either") or not word_at(pos + 1, "way")
            return no
        end
        if nl of item (pos + 1) of tokens
            return no
        end
        set ew_after to item (pos + 2) of tokens
        return type of ew_after is "eof" or nl of ew_after
    end

    # where a block's statements end, besides `end` and `else`: "try" for a try's, at `if it fails` or `either
    # way`; "handler" for its `if it fails`'s, at `either way`; "match" for a `when`'s, at the next `when`
    to ends_block with stop_at
        if stop_at is "try"
            return is_if_it_fails() or is_either_way()
        end
        if stop_at is "handler"
            return is_either_way()
        end
        return stop_at is "match" and is_word("when")
    end

    # `stop_at`: where else the block's statements end (see ends_block)
    to statements with opener, stop_at
        set body to empty list
        set outside_top to at_top
        set at_top to opener is nothing
        if opener is not nothing
            set nesting to nesting + 1
        end
        repeat while more(opener) and not ends_block(stop_at)
            if check("eof")
                fail with problem(peek(), "'" + value of opener + "' from line " + line of opener + " is missing its 'end'")
            end
            lay(peek())
            set made_before to hoisted
            set hoisted to empty list
            set made to statement()
            for each made_fn in hoisted # functions its values made, made before it runs
                add made_fn to body
            end
            set hoisted to made_before
            if kind of made is "use" or kind of made is "several" # the file's code, or what the statement is written as, in its place
                for each inner in body of made
                    add inner to body
                end
            else
                add made to body
            end
            if not nl of peek()
                expected("a new line")
            end
        end
        if opener is not nothing
            set nesting to nesting - 1
            lay(peek()) # the end, else or if it fails that closes the block
        end
        set at_top to outside_top
        return body
    end

    # The statements of a file the program uses, or none if it was read already. Used `as` a name, its own
    # names are kept apart (see prefixed), and it can be used again as another. Files are read once for each
    # set of names: a file that one used `as m` uses is m's own copy (`within` is then "m's "). A file's name
    # is from the folder of the file that uses it, the last one open, unless `from_top`, for a package's.
    to use_file with name_token, alias, from_top
        set wanted to value of name_token
        if outside_folder(wanted)
            fail with problem(name_token, "'" + wanted + "' isn't in the program's folder: 'use' only reads files there, or in folders inside it")
        end
        if not from_top and length of open of reading is greater than 0
            set wanted to folder_of(item (length of open of reading) of open of reading) + wanted
        end
        set within to within of reading
        set key to within + wanted
        if alias is not nothing
            set key to key + " as " + alias
        end
        if contains(open of reading, wanted)
            fail with problem(name_token, "'" + wanted + "' is already being read, so it can't be used here: files can't use each other in a circle")
        end
        if contains(loaded of reading, key)
            return empty list
        end
        set text to nothing
        for each f in files of reading
            if name of f is wanted
                set text to text of f
            end
        end
        if text is nothing
            fail with problem(name_token, "there is no file called '" + wanted + "'")
        end
        set loaded_now to loaded of reading
        add key to loaded_now
        set open_now to open of reading
        add wanted to open_now
        if alias is not nothing
            set within of reading to within + alias + "'s "
        end
        set inner to parse(tokenize(text, wanted), reading)
        set within of reading to within
        set open_now to open of reading # as the files it used left it
        set still_open to empty list # all but the last
        for each n from 1 to length of open_now - 1
            add item n of open_now to still_open
        end
        set open of reading to still_open
        if alias is not nothing
            return prefixed(inner, alias)
        end
        return inner
    end

    # `use the library "sqlite3" or "winsqlite3" as sqlite`, then a line for each of its functions the program
    # calls, and `end`, as moth.js's library reads it
    to library_use with t
        set pos to pos + 2
        if not at_top
            fail with problem(t, "'use the library' only works at the top level of a program")
        end
        set library_names to list of library_name()
        repeat while not nl of peek() and word("or")
            add library_name() to library_names
        end
        set alias to nothing
        if not nl of peek() and word("as")
            set alias to take_name("a name for the library")
            add alias to aliases
        end
        if not nl of peek()
            expected("a new line")
        end
        set nesting to nesting + 1
        set made to empty list
        set declared to record with structures empty dictionary, callbacks empty dictionary
        repeat while not is_word("end")
            if check("eof")
                fail with problem(peek(), "'use' from line " + line of t + " is missing its 'end'")
            end
            lay(peek())
            set line_kind to "function"
            if (is_word("structure") or is_word("callback")) and type of item (pos + 1) of tokens is "word"
                if is_word("structure") and word_at(pos + 2, "with")
                    set line_kind to "structure"
                else if is_word("callback") and type of item (pos + 2) of tokens is "("
                    set line_kind to "callback"
                end
            end
            if line_kind is "structure"
                library_structure(declared)
            else if line_kind is "callback"
                library_callback(declared)
            else
                add library_function(item 1 of library_names, declared) to made
            end
            if not nl of peek()
                expected("a new line")
            end
        end
        set nesting to nesting - 1
        lay(peek())
        set pos to pos + 1
        for each d in made
            set libraries of (native of d) to library_names
            set structures of (native of d) to structures of declared
            set callbacks of (native of d) to callbacks of declared
        end
        if alias is not nothing
            set made to prefixed(made, alias)
        end
        return record with kind "use", body made, at t
    end

    to library_name
        set name_token to match("string")
        if not name_token
            expected("a library's name in quotes, like \"sqlite3\"")
        end
        return value of name_token
    end

    # `structure point with x as a whole number, y as a whole number`, as moth.js's libraryStructure reads it
    to library_structure with declared
        set pos to pos + 1
        set structure_name to library_type_name("a name for the structure", declared)
        expect_word("with")
        set fields to empty list
        set field_names to empty list
        set another_field to yes
        repeat while another_field
            set field_at to peek()
            set field_name to take_name("a field's name")
            if contains(field_names, field_name)
                fail with problem(field_at, "'" + field_name + "' is already one of its fields")
            end
            add field_name to field_names
            expect_word("as")
            add (record with name field_name, type library_type(declared, "field")) to fields
            set another_field to match(",")
        end
        set item structure_name of (structures of declared) to fields
    end

    # `callback compare(a pointer, a pointer) gives a whole number`
    to library_callback with declared
        set pos to pos + 1
        set callback_name to library_type_name("a name for the callback", declared)
        tight(match("("))
        set callback_types to empty list
        if not match(")")
            add library_type(declared, "callback input") to callback_types
            repeat while match(",")
                add library_type(declared, "callback input") to callback_types
            end
            if not match(")")
                expected("')'")
            end
        end
        if length of callback_types is greater than 16
            fail with problem(peek(), "a callback can be given at most 16 inputs")
        end
        set callback_gives to nothing
        if not nl of peek() and word("gives")
            set callback_gives to library_type(declared, "callback result")
        end
        set item callback_name of (callbacks of declared) to record with types callback_types, gives callback_gives
    end

    # a structure's or callback's name: neither a Moth word nor one of the words for C's types, nor one before
    to library_type_name with what, declared
        set name_at to peek()
        set named to take_name(what)
        if contains((list of "number", "whole", "long", "pointer", "float"), named)
            fail with problem(name_at, "'" + named + "' is one of the words for what C takes, so it can't be used as " + what)
        end
        if named is in structures of declared or named is in callbacks of declared
            fail with problem(name_at, "'" + named + "' is already a structure or callback here")
        end
        return named
    end

    # `MessageBoxW(a pointer, wide text, wide text, a whole number) gives a whole number`, or with the name the
    # library has for it in quotes: `"remove" as remove_file(text) gives a whole number`
    to library_function with first, declared
        set t to peek()
        set symbol to nothing
        if check("string")
            set symbol to value of match("string")
            expect_word("as")
        else if check("word") # anything else isn't a name, which take_name says
            set symbol to raw of t
        end
        set fn_name to take_name("the name of one of the library's functions")
        if not tight(match("("))
            expected("'(' and what the function takes")
        end
        set types to empty list
        if not match(")")
            add library_type(declared, "input") to types
            repeat while match(",")
                add library_type(declared, "input") to types
            end
            if not match(")")
                expected("')'")
            end
        end
        if length of types is greater than 16
            fail with problem(t, "a library's function can take at most 16 inputs")
        end
        set gives to nothing
        if not nl of peek() and word("gives")
            set gives to library_type(declared, "result")
        end
        set params to empty list
        set kinds to empty list
        for each type_name in types
            add "input " + (length of params + 1) to params
            set type_kind to -1
            set n to 1
            repeat while n is at most length of library_types
                if item n of library_types is type_name
                    set type_kind to item n of library_kinds
                end
                add 1 to n
            end
            if library_named(type_name, callbacks of declared)
                set type_kind to 7
            end
            add type_kind to kinds
        end
        add 1 to functions_made
        set first_node to record with kind "value", type "string", value first, at t
        set call to record with kind "builtin", name "library call", args (list of first_node), at t
        set body to list of (record with kind "return", value call, at t)
        set native to record with symbol symbol, types types, gives gives, libraries (list of first), structures nothing, callbacks nothing
        return record with kind "define", name fn_name, params params, kinds kinds, body body, at t, order functions_made, native native,
            types nothing, gives nothing, made_kind nothing
    end

    # whether a type is `a ` and one of these names
    to library_named with type_name, names
        set type_text to "" + type_name
        if length of type_text is less than 3 or item 1 of type_text is not "a" or item 2 of type_text is not " "
            return no
        end
        set rest to ""
        for each k from 3 to length of type_text
            add item k of type_text to rest
        end
        return rest is in names
    end

    # what a library's function takes or gives (`where` it is), as C has it, as moth.js's libraryType reads it
    to library_type with declared, where
        set type_at to peek()
        set found to nothing
        for each type_name in library_types
            if found is nothing
                set type_words to split type_name by " "
                set fits to yes
                set i to 0
                for each w in type_words
                    if fits and not word_at(pos + i, w)
                        set fits to no
                    end
                    add 1 to i
                end
                if fits
                    set pos to pos + length of type_words
                    set found to type_name
                end
            end
        end
        if found is nothing
            if where is "field" and check("number") and word_at(pos + 1, "bytes")
                set count_text to value of peek()
                set count to number of count_text
                if position of "." in count_text is greater than 0 or count is less than 1 or count is greater than 65536
                    fail with problem(type_at, "a structure's bytes are a whole number of them, from 1 to 65536")
                end
                set found to "" + count + " bytes"
                set pos to pos + 2
            else if is_word("a") and library_named("a " + value of item (pos + 1) of tokens, structures of declared) or is_word("a") and library_named("a " + value of item (pos + 1) of tokens, callbacks of declared)
                set found to "a " + value of item (pos + 1) of tokens
                set pos to pos + 2
                if library_named(found, structures of declared) and (where is "input" or where is "result") and word_at(pos, "by") and word_at(pos + 1, "value")
                    set found to found + " by value" # the structure itself, not where it is (DESIGN §92)
                    set pos to pos + 2
                end
            else
                expected("what it takes or gives ('a number', 'a float', 'a whole number', 'a long whole number', 'a pointer', 'text', 'wide text', 'bytes', 'yes or no', 'a byte', 'a signed byte', 'a short whole number', 'an unsigned short whole number', 'an unsigned whole number', 'an unsigned long whole number' or 'a list of numbers', or a structure or callback)")
            end
        end
        set is_structure to library_named(found, structures of declared)
        set is_callback to library_named(found, callbacks of declared)
        if found is "bytes" and where is "result"
            fail with problem(type_at, "a library's function can't give bytes: it can give a pointer to them")
        end
        if found is "a list of numbers" and where is not "input"
            set listed_how to "a callback can't take or give"
            if where is "result"
                set listed_how to "a library's function can't give"
            else if where is "field"
                set listed_how to "a structure's field can't be"
            end
            fail with problem(type_at, listed_how + " a list of numbers: only a function's input can be one")
        end
        if found is "bytes" and where is "field"
            fail with problem(type_at, "a structure's field can't be bytes: say how many, as in '16 bytes', or take a pointer")
        end
        if found is "bytes" and where is not "input"
            fail with problem(type_at, "a callback can't be bytes: it can take a pointer")
        end
        if is_callback and where is not "input" and where is not "field"
            fail with problem(type_at, "only a function's input or a structure's field can be a callback")
        end
        if where is "callback result" and (found is "text" or found is "wide text")
            fail with problem(type_at, "a callback can't give " + found)
        end
        if where is "callback result" and is_structure
            fail with problem(type_at, "a callback can't give a structure")
        end
        return found
    end

    # `math's sine`: a name the file used `as math` makes
    to member with first
        if contains(aliases, first) and match("'s")
            return first + "'s " + take_name("a name")
        end
        return first
    end

    # Any other `x's` is the value's own: `rex's bark()` is bark(rex), a function given the value first, and
    # `rex's name` is name of rex, its field; one after another, `rex's owner's name`.
    to possessive with node
        set own_made to node
        repeat while check("'s")
            set pos to pos + 1
            set own_at to peek()
            set own_named to take_name("a function's or a field's name")
            if tight(match("("))
                set own_given to list of own_made
                for each own_one in arg_list()
                    add own_one to own_given
                end
                set own_made to made_call(own_named, own_given, own_at)
                set own_calls_made to owns of reading # a record's own function, if nothing else has its name (see own_calls)
                add own_made to own_calls_made
            else
                set own_made to record with kind "field", name own_named, subject own_made, at own_at
            end
        end
        return own_made
    end

    to block with opener
        if not nl of peek()
            expected("a new line")
        end
        return statements(opener, "")
    end

    to loop_body with opener
        set loop_depth to loop_depth + 1
        set body to block_end(opener)
        set loop_depth to loop_depth - 1
        return body
    end

    to block_end with opener
        set body to block(opener)
        expect_word("end")
        return body
    end

    # drawing: `move forward 10`, `turn left 90`, `pen up`, `pen color "red"`
    # built-in operations, by the word that starts them: the word after it ("" if none), then one input, or
    # two with a word between them
    to builtin_syntax with t
        if type of t is not "word"
            return nothing
        end
        if value of t is "uppercase" or value of t is "lowercase" or value of t is "number" or value of t is "keys"
            return list of "of"
        end
        if value of t is "split"
            return list of "", "by"
        end
        if value of t is "join"
            return list of "", "with"
        end
        if value of t is "position"
            return list of "of", "in"
        end
        return nothing
    end

    to turtle_words with t
        if type of t is not "word"
            return nothing
        end
        if value of t is "move"
            return list of "forward", "back", "to"
        end
        if value of t is "turn"
            return list of "left", "right"
        end
        if value of t is "pen"
            return list of "up", "down", "color", "width"
        end
        return nothing
    end

    to statement
        set t to peek()
        if word("set")
            if is_word("item") or is_word("byte")
                set target to primary()
                expect_word("to")
                return record with kind "setItem", target target, value expression(), at t
            end
            if words_at(pos, list of "the", "slider") # `set the slider "Volume" to 50`
                set pos to pos + 2
                set slider_label to additive()
                expect_word("to")
                set slider_items to list of slider_label, expression()
                return record with kind "turtle", action "set slider", value (record with kind "list", items slider_items, at t), at t
            end
            set variable to take_name("a variable name")
            if check(",") # `set a, b to pair`, `set a, b to b, a`: each name an item of what's after `to`
                set up_names to list of variable
                repeat while match(",")
                    add take_name("a variable name") to up_names
                end
                expect_word("to")
                set up_values to list of expression()
                repeat while match(",")
                    add expression() to up_values
                end
                set up_value to item 1 of up_values
                if length of up_values is greater than 1
                    set up_value to record with kind "list", items up_values, at t
                end
                return record with kind "several", body unpacked(up_names, up_value, t), at t
            end
            if check("'s") and not contains(aliases, variable) # `set rex's name to ...` changes a field
                set own_field to possessive(record with kind "name", name variable, at t)
                if kind of own_field is not "field"
                    fail with problem(at of own_field, "a call can't be given a value: set a field, as in 'set " + variable + "'s name to ...'")
                end
                expect_word("to")
                return record with kind "setField", name name of own_field, target subject of own_field, value expression(), at t
            end
            if word("of") # `set name of person to ...` changes a field
                set target to unary()
                expect_word("to")
                return record with kind "setField", name variable, target target, value expression(), at t
            end
            expect_word("to")
            return record with kind "set", name variable, value expression(), at t
        end
        if word("add")
            set value to expression()
            expect_word("to")
            return record with kind "add", value value, name take_name("a variable name"), at t
        end
        if word("say") # `say "oops" to the error output`
            set parts to empty list
            add expression() to parts
            repeat while not nl of peek() and not is_word("to")
                add expression() to parts
            end
            set said to record with kind "say", parts parts, errors no, at t
            set said_shows to shows of reading # a kind's `shown` shows its parts, if one has it (see language_text)
            add said to said_shows
            if nl of peek() or not word("to")
                return said
            end
            if not (is_word("the") and word_at(pos + 1, "error") and word_at(pos + 2, "output"))
                expected("'the error output'")
            end
            set pos to pos + 3
            set errors of said to yes
            return said
        end
        if word("if")
            return if_rest(t)
        end
        if word("repeat")
            if word("while")
                return record with kind "while", cond expression(), body loop_body(t), at t
            end
            set count to expression()
            expect_word("times")
            return record with kind "repeat", count count, body loop_body(t), at t
        end
        if word("for")
            expect_word("each")
            set variable to take_name("a variable name")
            set each_names to list of variable # `for each name, age in people`: each item's items
            repeat while match(",")
                add take_name("a variable name") to each_names
            end
            set counting to no
            if length of each_names is 1
                set counting to word("from")
            end
            if counting
                set start to expression()
                expect_word("to")
                set limit to expression()
                set by_token to no # `for each k from 10 to 1 by -2`
                if not nl of peek()
                    set by_token to word("by")
                end
                if by_token
                    set step to expression()
                    return stepped(variable, start, limit, step, loop_body(t), t, by_token)
                end
                return record with kind "count", name variable, start start, limit limit, body loop_body(t), at t
            end
            if not word("in")
                if length of each_names is 1
                    expected("'in' or 'from'")
                end
                expected("'in'")
            end
            set over to expression()
            set where_token to word("where") # `for each row in sales where price of row is greater than 10`
            set filter to nothing
            if where_token
                set filter to expression()
            end
            set body to loop_body(t)
            if where_token # the body runs only for the rows that pass
                set guarded to list of (record with kind "if", cond filter, then body, otherwise empty list, at where_token)
                set body to guarded
            end
            if length of each_names is 1
                return record with kind "each", name variable, over over, body body, at t
            end
            set each_one to hidden_name("each item", t)
            set each_body to unpacked(each_names, (record with kind "name", name each_one, at t), t)
            for each each_s in body
                add each_s to each_body
            end
            return record with kind "each", name each_one, over over, body each_body, at t
        end
        if word("to")
            set fn_name to take_name("a function name")
            set fn_inputs to inputs_of()
            set fn_gives to nothing
            if word("gives") # `to area with w, h gives a number`
                set fn_gives to gives_type()
            end
            set made to func(fn_name, params of fn_inputs, t)
            set kinds of made to kinds of fn_inputs
            set types of made to types of fn_inputs
            set gives of made to fn_gives
            set defaults of made to nothing
            if any_fallback of fn_inputs
                set defaults of made to fallbacks of fn_inputs
            end
            set made_defines to defines of reading
            add made to made_defines
            return made
        end
        if word("when") # `when a key is pressed with key`, `when the mouse is clicked with x and y`
            set start to pos
            set event to ""
            set gives to 0
            set label to nothing # the button or text box it waits for, worked out once, when it's set up
            if words_at(pos, list of "the", "button") # `when the button "Start" is clicked`
                set pos to pos + 2
                set label to additive()
                expect_word("is")
                expect_word("clicked")
                set phrase to "the button is clicked"
                set event to "button"
            else if words_at(pos, enter_phrase) # `when enter is pressed in the text box "Name" with words`
                set pos to pos + length of enter_phrase
                set label to additive()
                set phrase to "enter is pressed in the text box"
                set event to "enter"
                set gives to 1
            else if words_at(pos, list of "the", "checkbox") # `when the checkbox "Done" is clicked`
                set pos to pos + 2
                set label to additive()
                expect_word("is")
                expect_word("clicked")
                set phrase to "the checkbox is clicked"
                set event to "checkbox"
            else if words_at(pos, chosen_phrase) or words_at(pos, chosen_in_dropdown) # `when an item is chosen in the list "Fruits" with fruit`
                set pos to pos + length of chosen_phrase
                set phrase to "an item is chosen in the " + value of item (pos - 1) of tokens
                set label to additive()
                set event to "choice"
                set gives to 1
            else if words_at(pos, list of "the", "slider") # `when the slider "Volume" is moved with volume`
                set pos to pos + 2
                set label to additive()
                expect_word("is")
                expect_word("moved")
                set phrase to "the slider is moved"
                set event to "slider"
                set gives to 1
            else
                set words to empty list
                repeat while check("word") and not is_word("with") and not nl of peek()
                    add value of peek() to words
                    set pos to pos + 1
                end
                set phrase to joined(words, " ")
                if phrase is "a key is pressed"
                    set event to "key"
                    set gives to 1
                else if phrase is "the mouse is clicked"
                    set event to "click"
                    set gives to 2
                else if phrase is "the mouse is dragged"
                    set event to "drag"
                    set gives to 2
                end
            end
            if event is ""
                set pos to start
                expected("'a key is pressed', 'the mouse is clicked', 'the mouse is dragged', 'the button ... is clicked', 'enter is pressed in the text box ...', 'the checkbox ... is clicked', 'an item is chosen in the list ...' or 'the slider ... is moved'")
            end
            set params to empty list
            if gives is not 0 and word("with")
                add take_name("an input name") to params
                repeat while match(",") or word("and")
                    add take_name("an input name") to params
                end
            end
            if length of params is not 0 and length of params is not gives
                set values_given to gives + " values"
                set inputs_named to gives + " inputs"
                if gives is 1
                    set values_given to "1 value"
                    set inputs_named to "one input"
                end
                fail with problem(t, "'when " + phrase + "' gives " + values_given + ", so name " + inputs_named + " or none, not " + length of params)
            end
            if not at_top
                fail with problem(t, "'when' only works at the top level of a program")
            end
            return record with kind "when", event event, label label, fn func("when " + phrase, params, t), at t
        end
        if word("every") # `every 100 milliseconds`, `every 2 seconds`, `every 1 minute`: in milliseconds
            set interval to additive()
            set unit to 0
            if kind of interval is "builtin" and name of interval is "unit"
                set unit_word to value of item 2 of args of interval
                if unit_word is in time_units # `every 2 seconds`: the number, and its unit
                    set unit to item unit_word of time_units
                    set interval to item 1 of args of interval
                end
            end
            if unit is 0
                if unit_at(pos) and value of peek() is in time_units # `every n seconds`
                    set unit to item (value of peek()) of time_units
                    set pos to pos + 1
                else
                    expected("'milliseconds' or 'seconds'")
                end
            end
            if not at_top
                fail with problem(t, "'every' only works at the top level of a program")
            end
            return record with kind "every", interval interval, unit unit, fn func("every", empty list, t), at t
        end
        if word("return")
            if fn_depth is 0
                fail with problem(t, "'return' only works inside a function (one made with 'to')")
            end
            if nl of peek()
                return record with kind "return", value nothing, at t
            end
            return record with kind "return", value expression(), at t
        end
        if word("fail")
            expect_word("with")
            return record with kind "fail", value expression(), at t
        end
        if word("try")
            if not nl of peek()
                expected("a new line")
            end
            set body to statements(t, "try")
            set caught_name to nothing
            set try_handler to nothing
            if is_if_it_fails()
                set pos to pos + 3
                if word("with")
                    set caught_name to take_name("a variable name")
                end
                if not nl of peek()
                    expected("a new line")
                end
                set try_handler to statements(t, "handler")
            else if not is_either_way()
                expected("'if it fails'")
            end
            if not is_either_way()
                expect_word("end")
                return record with kind "try", body body, name caught_name, handler try_handler, at t
            end
            set pos to pos + 2
            return either_way(t, body, caught_name, try_handler, block_end(t))
        end
        if is_word("match") # `match command`, then `when "go"` lines: the first that fits runs (see matched)
            if not nl of item (pos + 1) of tokens
                if when_next()
                    set pos to pos + 1
                    return matched(t)
                end
            end
        end
        if is_word("kind") # `kind dog with name, sound or "woof"`, then the functions each dog has (see made_kind)
            if kind_next()
                set pos to pos + 1
                return made_kind(t)
            end
        end
        if word("use")
            if is_word("the") and not nl of peek() and word_at(pos + 1, "library")
                return library_use(t)
            end
            # `use the package "json" as json`: what `moth add` put in packages/json, its main file json.moth
            set a_package to is_word("the") and not nl of peek() and word_at(pos + 1, "package") and not nl of item (pos + 1) of tokens
            if a_package
                set pos to pos + 2
            end
            set name_token to match("string")
            if not name_token and a_package
                expected("a package's name in quotes, like \"json\"")
            else if not name_token
                expected("a file name in quotes, like \"shapes.moth\"")
            end
            if a_package and not package_name(value of name_token)
                fail with problem(name_token, "'" + value of name_token + "' isn't a package's name: letters, digits, '-', '_' and '.' make one")
            end
            set alias to nothing
            if word("as") # `use "math.moth" as math`
                if a_package
                    set alias to take_name("a name for the package")
                else
                    set alias to take_name("a name for the file")
                end
                add alias to aliases
            end
            if not at_top
                fail with problem(t, "'use' only works at the top level of a program")
            end
            if a_package
                set name_token to record with type "string", value "packages/" + value of name_token + "/" + value of name_token + ".moth",
                    line line of name_token, col col of name_token, nl nl of name_token, file file of name_token, parts nothing
            end
            return record with kind "use", body use_file(name_token, alias, a_package), at t
        end
        if word("stop")
            if is_word("the") and not nl of peek() and word_at(pos + 1, "program") # `stop the program`, `stop the program with 2`
                set pos to pos + 2
                set value to nothing
                if not nl of peek() and word("with")
                    set value to expression()
                end
                return record with kind "exit", value value, at t
            end
            if loop_depth is 0
                fail with problem(t, "'stop' only works inside a loop (one made with 'repeat' or 'for each')")
            end
            return record with kind "stop", at t
        end
        if word("remove") # `remove "Sam" from ages`, `remove the file "old.txt"`
            if is_word("the") and not nl of peek() and word_at(pos + 1, "file")
                set pos to pos + 2
                return record with kind "removeFile", target additive(), at t
            end
            set key to additive()
            expect_word("from")
            return record with kind "remove", key key, target unary(), at t
        end
        if word("expect") # `expect total(2, 3) is 5`
            return record with kind "expect", cond expression(), at t
        end
        if plays_sound() # `play note "C4" for 0.5 seconds`, `play note 440 for 200 milliseconds`, `play a beep`
            set pos to pos + 1
            if word("a")
                set pos to pos + 1
                return record with kind "play", note nothing, time nothing, unit 0, at t
            end
            set pos to pos + 1
            set note to additive()
            expect_word("for")
            # how long, as `every` takes it: `for 2 seconds`, `for n milliseconds`; and `for n * 100 milliseconds`
            # and `for -1 seconds` (which fails) too, the unit at the end counting what comes before it
            set time to additive()
            set unit to 0
            set found to timed(time)
            if found is not nothing
                set time to item 1 of found
                set unit to item 2 of found
            end
            if unit is 0
                if unit_at(pos) and value of peek() is in time_units # `for n seconds`
                    set unit to item (value of peek()) of time_units
                    set pos to pos + 1
                else
                    expected("'milliseconds' or 'seconds'")
                end
            end
            return record with kind "play", note note, time time, unit unit, at t
        end
        if word("write") # `write "hello" to "notes.txt"`
            set value to expression()
            expect_word("to")
            return record with kind "write", value value, target expression(), at t
        end
        set actions to turtle_words(t)
        if actions is not nothing
            set pos to pos + 1
            set action to ""
            for each a in actions
                if action is "" and is_word(a)
                    set action to a
                end
            end
            if action is ""
                set choices to empty list
                for each a in actions
                    add "'" + a + "'" to choices
                end
                expected(joined(choices, " or "))
            end
            set pos to pos + 1
            if action is "to" # `move to x, y`
                return record with kind "turtle", action action, value several(2, t), at t
            end
            if action is "up" or action is "down"
                return record with kind "turtle", action action, value nothing, at t
            end
            return record with kind "turtle", action action, value expression(), at t
        end
        if word("clear")
            if words_at(pos, list of "the", "text", "box") or words_at(pos, list of "the", "text", "area") # `clear the text box "Name"`: empties it
                set pos to pos + 3
                return record with kind "turtle", action "clear text box", value additive(), at t
            end
            return record with kind "turtle", action "clear", value nothing, at t # wipe the picture
        end
        if word("draw") # `draw box at x, y size w by h`, `draw circle at x, y size r`, `draw "hi" at x, y size 20`
            if is_word("chart") and type of item (pos + 1) of tokens is "word" and value of item (pos + 1) of tokens is "of" # `draw chart of sales`
                set pos to pos + 2
                return record with kind "turtle", action "chart", value column_or(yes), at t
            end
            set a_picture to no
            if is_word("picture")
                set next_one to item (pos + 1) of tokens
                set a_picture to type of next_one is "string" or type of next_one is "number"
                if type of next_one is "word" and not contains(carry_on, value of next_one)
                    set a_picture to yes
                end
                if type of next_one is "(" and col of next_one is greater than col of peek() + 7
                    set a_picture to yes
                end
                set a_picture to a_picture and not nl of next_one
            end
            if a_picture
                set pos to pos + 1 # `draw picture "cat.png" at x, y size w by h`: a file's name, or its bytes
                set coords to list of expression()
                expect_word("at")
                set spot to several(2, t)
                for each n in items of spot
                    add n to coords
                end
                if word("size")
                    add additive() to coords
                    expect_word("by")
                    add expression() to coords
                else
                    repeat 2 times
                        add record with kind "value", type "nothing", value nothing, at t to coords # no size: as big as it is
                    end
                end
                set listed to record with kind "list", items coords, at t
                return record with kind "turtle", action "picture", value listed, at t
            end
            # `draw button "Start" at x, y`, `draw text box "Name" at x, y`: a value straight after `button` (which
            # a name couldn't have) or `text box`
            set widget to ""
            if is_word("button") and label_at(pos + 1)
                set widget to "button"
            else if words_at(pos, list of "text", "box")
                set widget to "text box"
            else if is_word("checkbox") and label_at(pos + 1)
                set widget to "checkbox"
            end
            # `draw dropdown "Size" showing sizes at x, y`, `draw slider "Volume" from 0 to 100 at x, y`
            if (is_word("dropdown") or is_word("slider")) and label_at(pos + 1)
                set control to value of peek()
                set pos to pos + 1
                set control_items to list of additive()
                if control is "dropdown"
                    expect_word("showing")
                    add additive() to control_items
                else
                    expect_word("from")
                    add additive() to control_items
                    expect_word("to")
                    add additive() to control_items
                end
                expect_word("at")
                set control_spot to several(2, t)
                for each n in items of control_spot
                    add n to control_items
                end
                return record with kind "turtle", action control, value (record with kind "list", items control_items, at t), at t
            end
            # `draw text area "Notes" at x, y size w by h`, `draw list "Fruits" showing fruits at x, y size w by h`
            set tall to ""
            if words_at(pos, list of "text", "area")
                set tall to "text area"
            else if is_word("list") and label_at(pos + 1)
                set tall to "list"
            end
            if tall is not ""
                set pos to pos + 1
                if tall is "text area"
                    set pos to pos + 1
                end
                set tall_items to list of additive()
                if tall is "list"
                    expect_word("showing")
                    add additive() to tall_items
                end
                expect_word("at")
                set spot to several(2, t)
                for each n in items of spot
                    add n to tall_items
                end
                if word("size")
                    add additive() to tall_items
                    expect_word("by")
                    add expression() to tall_items
                else
                    repeat 2 times
                        add record with kind "value", type "nothing", value nothing, at t to tall_items # no size: the usual one
                    end
                end
                return record with kind "turtle", action tall, value (record with kind "list", items tall_items, at t), at t
            end
            if widget is not ""
                set pos to pos + 1
                if widget is "text box"
                    set pos to pos + 1
                end
                set widget_items to list of additive()
                expect_word("at")
                set spot to several(2, t)
                for each n in items of spot
                    add n to widget_items
                end
                return record with kind "turtle", action widget, value (record with kind "list", items widget_items, at t), at t
            end
            set shape to ""
            for each w in list of "box", "circle"
                if shape is "" and is_word(w) and type of item (pos + 1) of tokens is "word" and value of item (pos + 1) of tokens is "at"
                    set shape to w
                end
            end
            if shape is not ""
                set pos to pos + 2
                set spot to several(2, t)
                expect_word("size")
                set coords to items of spot
                if shape is "box"
                    add additive() to coords
                    expect_word("by")
                end
                add expression() to coords
                return record with kind "turtle", action shape, value spot, at t
            end
            set drawn_text to expression()
            expect_word("at")
            set spot to several(2, t)
            set coords to list of drawn_text
            for each n in items of spot
                add n to coords
            end
            if word("size")
                add expression() to coords
            else
                add record with kind "value", type "nothing", value nothing, at t to coords # no size: the usual one
            end
            set listed to record with kind "list", items coords, at t
            return record with kind "turtle", action "text", value listed, at t
        end
        if is_word("run") and runs_program()
            fail with problem(t, "'run program' gives back the number the program ended with, so it goes where a value goes: 'set code to run program ...'")
        end
        for each ticking in list of "tick", "untick" # `tick the checkbox "Done"`
            if is_word(ticking) and words_at(pos + 1, list of "the", "checkbox")
                set pos to pos + 3
                return record with kind "turtle", action ticking, value additive(), at t
            end
        end
        if is_word("send") and sends_data()
            fail with problem(t, "'send' gives back what the site replies, so it goes where a value goes: 'set reply to send ...'")
        end
        # `start count(10)`, a task whose call runs on a thread of its own (see "start" in vm.js), and `wait for
        # job`, done for what they do: `start` alone, or before a bracket, is still a name, and so is `wait`
        if is_word("start") and not nl of item (pos + 1) of tokens and type of item (pos + 1) of tokens is "word"
            set started to try_phrase("start", t)
            if started is not nothing
                set start_args to list of call of started
                return record with kind "do", value (record with kind "builtin", name name of started, args start_args, at t), at t
            end
        end
        if is_word("wait") and not nl of item (pos + 1) of tokens and word_at(pos + 1, "for")
            set pos to pos + 2
            set wait_args to list of expression()
            return record with kind "do", value (record with kind "builtin", name "wait for", args wait_args, at t), at t
        end
        if is_word("wait") and not nl of item (pos + 1) of tokens # `wait 2 seconds`: `wait` alone is still a name
            set waiting to try_phrase("wait", t)
            if waiting is not nothing
                return waiting
            end
        end
        if is_word("save") and not nl of item (pos + 1) of tokens # `save scores to "scores.txt"`
            set saving to try_phrase("save", t)
            if saving is not nothing
                return saving
            end
        end
        if type of t is "word" and not contains(reserved, value of t)
            # a line that starts with a name calls it: `greet "Sam"` or `greet("Sam")`
            set pos to pos + 1
            set called to member(value of t)
            if called is value of t and check("'s") # `rex's bark()`, or `rex's rename "Max"`
                set own_made to possessive(record with kind "name", name value of t, at t)
                if kind of own_made is "call"
                    return own_made
                end
                set own_given to list of subject of own_made
                if not nl of peek()
                    an_input(own_given)
                    repeat while match(",")
                        an_input(own_given)
                    end
                end
                return made_call(name of own_made, own_given, at of own_made)
            end
            if is_word("is")
                fail with problem(t, "to give '" + called + "' a value write 'set " + called + " to ...'")
            end
            set args to empty list
            if tight(match("("))
                set args to arg_list()
            else if not nl of peek()
                an_input(args)
                repeat while match(",")
                    an_input(args)
                end
            end
            return made_call(called, args, t)
        end
        fail with problem(t, "a line can't start with " + describe(t))
    end

    # the body of a function, made with `to`, or an app's handler (`when`, `every`), which starts outside any loop
    # What an input says it is, after its `as`, as moth.js's inputType has it: a record of its place in
    # kind_phrases (`kind`), which each call checks, and what it says beyond that, as written (`type`), which
    # only the checker reads, or nothing: `a dog` is checked as a record, `a list of numbers` as a list
    to input_type
        if words_at(pos, list of "a", "list", "of")
            set pos to pos + 3
            return record with kind 3, type "a list of " + list_holds()
        end
        set found to -1
        set n to 0
        for each phrase in kind_phrases
            set fits to yes
            set i to 0
            for each w in phrase
                if fits
                    set ahead to item (pos + i) of tokens
                    set fits to type of ahead is "word" and value of ahead is w
                end
                add 1 to i
            end
            if found is -1 and fits
                set found to n
            end
            add 1 to n
        end
        if found is not -1
            set pos to pos + length of item (found + 1) of kind_phrases
            return record with kind found, type nothing
        end
        set it_article to peek()
        set it_named to item (pos + 1) of tokens
        if (is_word("a") or is_word("an")) and not nl of it_named and type of it_named is "word" and not contains(reserved, value of it_named)
            set pos to pos + 2
            return record with kind 4, type value of it_article + " " + value of it_named
        end
        expected("what kind of value it is ('a number', 'text', 'yes or no', 'a list', 'a record', 'a dictionary', 'bytes' or 'a function', or a kind's name, like 'a dog')")
    end

    # what `a list of` holds, as moth.js's listHolds has it: `numbers`, `lists of numbers`, `dogs`...
    to list_holds
        if words_at(pos, list of "lists", "of")
            set pos to pos + 2
            return "lists of " + list_holds()
        end
        if words_at(pos, list of "yes", "or", "no")
            set pos to pos + 3
            return "yes or no"
        end
        set lh_t to peek()
        if nl of lh_t or type of lh_t is not "word" or (contains(reserved, value of lh_t) and value of lh_t is not "bytes")
            expected("what the list holds, like 'numbers', 'text' or 'dogs'")
        end
        set pos to pos + 1
        return value of lh_t
    end

    # what a function says it gives, after its `gives`, as moth.js's givesType has it
    to gives_type
        if word("nothing")
            return "nothing"
        end
        set gt_said to input_type()
        set gt_text to type of gt_said
        if gt_text is nothing
            set gt_text to (join item (kind of gt_said + 1) of kind_phrases with " ")
        end
        if not words_at(pos, list of "or", "nothing")
            return gt_text
        end
        set pos to pos + 2
        return gt_text + " or nothing"
    end

    to func with fn_name, params, t
        add 1 to functions_made
        set order to functions_made
        set outside_loops to loop_depth
        set fn_depth to fn_depth + 1
        set loop_depth to 0
        set body to block_end(t)
        set fn_depth to fn_depth - 1
        set loop_depth to outside_loops
        return record with kind "define", name fn_name, params params, kinds empty list, body body, at t, order order, native nothing,
            types nothing, gives nothing, made_kind nothing
    end

    to if_rest with t
        set cond to expression()
        set then to block(t)
        set otherwise to empty list
        if word("else")
            set else_if to no
            if not nl of peek() # an `if` on the next line starts a new if inside the else
                set else_if to word("if")
            end
            if else_if
                set nested to list of if_rest(else_if)
                return record with kind "if", cond cond, then then, otherwise nested, at t
            end
            set otherwise to block(t)
        end
        expect_word("end")
        return record with kind "if", cond cond, then then, otherwise otherwise, at t
    end

    to expression
        set left to and_part()
        set t to word("or")
        repeat while t
            set left to record with kind "or", left left, right and_part(), at t
            set t to word("or")
        end
        return left
    end

    to and_part
        set left to not_part()
        set t to word("and")
        repeat while t
            set left to record with kind "and", left left, right not_part(), at t
            set t to word("and")
        end
        return left
    end

    to not_part
        set t to word("not")
        if t
            return record with kind "not", operand not_part(), at t
        end
        return comparison()
    end

    to comparison
        set left to bitwise()
        if is_word("has") and not nl of peek() and word_at(pos + 1, "ended") # `job has ended`: whether a task is done
            set t to peek()
            set pos to pos + 2
            return record with kind "builtin", name "has ended", args (list of left), at t
        end
        return compared(left)
    end

    # `is`, `is not`, `is greater than`... and what's after it, with what's before it given
    to compared with left
        set t to word("is")
        if not t
            return left
        end
        set negated to no
        if word("not")
            set negated to yes
        end
        set phrase to ""
        if check("word") and type of item (pos + 1) of tokens is "word"
            set phrase to value of peek() + " " + value of item (pos + 1) of tokens
        end
        set op to "is"
        if contains(comparison_phrases, phrase)
            set pos to pos + 2
            set op to phrase
        else if word("in")
            set op to "in"
        end
        return record with kind "compare", op op, negate negated, left left, right bitwise(), at t
    end

    to bitwise
        set left to additive()
        repeat while is_word("bit") and type of item (pos + 1) of tokens is "word" and contains(bit_words, value of item (pos + 1) of tokens)
            set t to peek()
            set op_name to "bit " + value of item (pos + 1) of tokens
            set pos to pos + 2
            set inputs to list of left, additive()
            set left to record with kind "builtin", name op_name, args inputs, at t
        end
        return left
    end

    # `price in sales`, after `total of` and `draw chart of`: the price of each row; anything else is the rest,
    # a whole expression after `draw chart of`, one value after `total of`
    to column_or with whole
        set field_token to peek()
        if type of field_token is "word" and not contains(reserved, value of field_token) and type of item (pos + 1) of tokens is "word" and value of item (pos + 1) of tokens is "in"
            set pos to pos + 2
            set column_args to list of (record with kind "value", type "string", value value of field_token, at field_token)
            add column_rest(whole) to column_args
            return record with kind "builtin", name "column", args column_args, at field_token
        end
        return column_rest(whole)
    end

    to column_rest with whole
        if whole
            return expression()
        end
        return unary()
    end

    to additive
        set left to multiplicative()
        set t to match("+") or match("-")
        repeat while t
            set left to record with kind "math", op type of t, left left, right multiplicative(), at t
            set t to match("+") or match("-")
        end
        # `trip in miles`: an amount in another unit that measures the same
        repeat while converting and is_word("in") and unit_at(pos + 1)
            set in_token to peek()
            set unit_token to item (pos + 1) of tokens
            set pos to pos + 2
            set unit_args to list of left
            add (record with kind "value", type "string", value value of unit_token, at unit_token) to unit_args
            set left to record with kind "builtin", name "in", args unit_args, at in_token
        end
        # `names without repeats`: each item once, where it first is
        if is_word("without") and not nl of peek() and word_at(pos + 1, "repeats")
            set without_token to peek()
            set pos to pos + 2
            set left to without_repeats(left, without_token)
        end
        # `total / count rounded`, `x rounded down`, `x rounded up`: the whole sum; `rounded(x)` is still a call
        if is_word("rounded") and not nl of peek() and type of item (pos + 1) of tokens is not "("
            set round_token to peek()
            set pos to pos + 1
            set how to "rounded"
            if word("down")
                set how to "rounded down"
            else if word("up")
                set how to "rounded up"
            end
            set left to record with kind "builtin", name how, args (list of left), at round_token
        end
        # `price with 2 decimals`: the number as text with exactly so many decimals, by the language's own function
        if is_word("with") and not nl of peek() and pos + 2 is at most length of tokens
            set dec_next to item (pos + 1) of tokens
            set dec_after to item (pos + 2) of tokens
            if not nl of dec_next and (type of dec_next is "number" or type of dec_next is "word") and not nl of dec_after and (word_at(pos + 2, "decimals") or word_at(pos + 2, "decimal"))
                set dec_token to peek()
                set pos to pos + 1
                set dec_places to primary()
                set pos to pos + 1
                set dec_wants to wants of reading
                add "decimals" to dec_wants
                set left to made_call("the language's with_decimals", (list of left, dec_places), dec_token)
            end
        end
        # `scores in order`, `scores in reverse order`, `people in order by age`
        if converting and is_word("in") and not nl of item (pos + 1) of tokens and (word_at(pos + 1, "order") or (word_at(pos + 1, "reverse") and word_at(pos + 2, "order")))
            set in_token to peek()
            set pos to pos + 1
            set how to "order"
            if word("reverse")
                set how to "reverse order"
            end
            set pos to pos + 1
            if is_word("by") and not nl of item (pos + 1) of tokens
                set pos to pos + 1
                set field_token to peek()
                set order_args to list of left
                add (record with kind "value", type "string", value take_name("a field name"), at field_token) to order_args
                return record with kind "builtin", name how + " by", args order_args, at in_token
            end
            set order_args to list of left
            return record with kind "builtin", name how, args order_args, at in_token
        end
        return left
    end

    to multiplicative
        set left to postfix(unary())
        set t to match("*") or match("/")
        repeat while t
            set left to record with kind "math", op type of t, left left, right postfix(unary()), at t
            set t to match("*") or match("/")
        end
        return left
    end

    # `100 bytes`, `block as text`
    to postfix with e
        set going to yes
        repeat while going
            set t to peek()
            if is_word("to") and not nl of t and word_at(pos + 1, "the") and word_at(pos + 2, "power") and word_at(pos + 3, "of")
                set pos to pos + 4
                set inputs to list of e, postfix(unary())
                set e to record with kind "builtin", name "power", args inputs, at t
            else if word("bytes")
                set inputs to list of e
                set e to record with kind "builtin", name "bytes", args inputs, at t
            else if word("as")
                set to_word to ""
                for each w in as_words
                    if to_word is "" and is_word(w)
                        set to_word to w
                    end
                end
                if to_word is ""
                    expected("'bytes' or 'text' or 'hex' or 'binary' or 'json'")
                end
                set pos to pos + 1
                set inputs to list of e
                set e to record with kind "builtin", name "as " + to_word, args inputs, at t
            else
                set going to no
            end
        end
        return e
    end

    to unary
        set t to tight(match("-"))
        if t
            return record with kind "negate", operand unary(), at t
        end
        return primary()
    end

    to primary
        set t to peek()
        if match("number")
            set number_node to record with kind "value", type "number", value value of t, at t
            if not unit_at(pos)
                return number_node
            end
            set unit_token to peek() # `5 km`: an amount of a unit
            set pos to pos + 1
            set unit_args to list of number_node
            add (record with kind "value", type "string", value value of unit_token, at unit_token) to unit_args
            return record with kind "builtin", name "unit", args unit_args, at t
        end
        if match("string")
            if parts of t is not nothing
                return filled_in(t)
            end
            return record with kind "value", type type of t, value value of t, at t
        end
        if word("yes") or word("no")
            return record with kind "value", type value of t, value value of t is "yes", at t
        end
        if word("nothing")
            return record with kind "value", type "nothing", value nothing, at t
        end
        if word("list")
            expect_word("of")
            set items to empty list
            set fns_before to length of hoisted
            add expression() to items
            if is_word("for") and not nl of peek() and word_at(pos + 1, "each") # `list of x * 2 for each x in xs`
                set kept_fns to empty list
                set value_fns to empty list
                for each k from 1 to length of hoisted
                    if k is at most fns_before
                        add item k of hoisted to kept_fns
                    else
                        add item k of hoisted to value_fns
                    end
                end
                set hoisted to kept_fns
                return built_list(item 1 of items, value_fns, t)
            end
            repeat while match(",")
                add expression() to items
            end
            return record with kind "list", items items, at t
        end
        if word("record")
            expect_word("with")
            set fields to empty list
            set values to empty list
            add take_name("a field name") to fields
            add expression() to values
            repeat while match(",")
                add take_name("a field name") to fields
                add expression() to values
            end
            return record with kind "record", fields fields, values values, at t
        end
        if word("dictionary") # `dictionary where "Sam" is 20, "Ana" is 31`: its items are each key, then its value
            expect_word("where")
            set entries to empty list
            set going to yes
            repeat while going
                add additive() to entries
                expect_word("is")
                add expression() to entries
                set going to match(",")
            end
            return record with kind "dictionary", items entries, at t
        end
        if word("empty")
            if word("record")
                return record with kind "record", fields empty list, values empty list, at t
            end
            if word("dictionary")
                return record with kind "dictionary", items empty list, at t
            end
            if not word("list")
                expected("'list', 'record' or 'dictionary'")
            end
            return record with kind "list", items empty list, at t
        end
        if word("length")
            expect_word("of")
            return record with kind "length", subject unary(), at t
        end
        if word("ask") # `ask "How old are you? "`
            if word("for") # `ask for 64 bytes`: what follows is `64 bytes`, the builtin that makes bytes, with the count in it
                set ask_count to additive()
                if kind of ask_count is not "builtin" or name of ask_count is not "bytes"
                    fail with problem(at of ask_count, "say how many bytes, as in 'ask for 64 bytes'")
                end
                return record with kind "builtin", name "input bytes", args args of ask_count, at t
            end
            return record with kind "ask", question additive(), at t
        end
        if word("read") # `read "notes.txt"`, `read bytes "photo.png"`, `read table "sales.csv"`
            if is_word("the") and not nl of peek() and word_at(pos + 1, "folder") # `read the folder "tests"`
                set pos to pos + 2
                return record with kind "readFolder", subject additive(), at t
            end
            if word("table")
                set read_args to list of (record with kind "read", binary no, subject additive(), at t)
                return record with kind "builtin", name "table", args read_args, at t
            end
            set as_bytes to no
            if word("bytes")
                set as_bytes to yes
            end
            set read_subject to additive()
            if with_headers() # `read "https://..." with headers h`
                set read_name to "read with headers"
                if as_bytes
                    set read_name to "read bytes with headers"
                end
                set read_args to list of read_subject, additive()
                return record with kind "builtin", name read_name, args read_args, at t
            end
            return record with kind "read", binary as_bytes, subject read_subject, at t
        end
        if word("arguments")
            return record with kind "arguments", at t
        end
        if words_at(pos, text_in_box) or words_at(pos, text_in_area) # `the text in the text box "Name"`: what's typed in it
            set pos to pos + length of text_in_box
            return record with kind "builtin", name "text in box", args (list of unary()), at t
        end
        if words_at(pos, value_of_slider) # `the value of the slider "Volume"`
            set pos to pos + length of value_of_slider
            return record with kind "builtin", name "slider value", args (list of unary()), at t
        end
        if words_at(pos, choose_file) and (word_at(pos + 4, "open") or word_at(pos + 4, "save")) # `choose a file to open`: asked, see DESIGN §42
            set question to record with kind "value", type "string", value "Which file to " + value of item (pos + 4) of tokens + "?", at t
            set pos to pos + length of choose_file + 1
            set asked to record with kind "ask", question question, at t
            return record with kind "builtin", name "chosen file", args (list of asked), at t
        end
        if words_at(pos, choice_in_list) or words_at(pos, choice_in_dropdown) # `the choice in the list "Fruits"`: the item chosen, or nothing
            set pos to pos + length of choice_in_list
            return record with kind "builtin", name "choice in list", args (list of unary()), at t
        end
        if words_at(pos, list of "the", "checkbox") # `the checkbox "Done" is ticked`, or `is not ticked`
            set pos to pos + 2
            set ticked_node to record with kind "builtin", name "ticked", args (list of additive()), at t
            expect_word("is")
            set not_token to peek()
            if word("not")
                expect_word("ticked")
                return record with kind "not", operand ticked_node, at not_token
            end
            expect_word("ticked")
            return ticked_node
        end
        # `total of prices`, `average of price in sales`, `largest of`, `smallest of`
        if type of t is "word" and contains(aggregates, value of t) and type of item (pos + 1) of tokens is "word" and value of item (pos + 1) of tokens is "of"
            set pos to pos + 2
            set aggregate_args to list of column_or(no)
            return record with kind "builtin", name value of t, args aggregate_args, at t
        end
        if is_word("start") and not nl of item (pos + 1) of tokens and type of item (pos + 1) of tokens is "word" # `set job to start count(10)`
            set started to try_phrase("start value", t)
            if started is not nothing
                set start_args to list of call of started
                return record with kind "builtin", name name of started, args start_args, at t
            end
        end
        if is_word("wait") and not nl of item (pos + 1) of tokens and word_at(pos + 1, "for") # `set answer to wait for job`
            set pos to pos + 2
            set wait_args to list of unary()
            return record with kind "builtin", name "wait for", args wait_args, at t
        end
        if is_word("run") and runs_program() # `run program "tool.exe" with (list of "a") keeping its output`
            set pos to pos + 2
            set program to additive()
            set inputs to record with kind "list", items empty list, at t
            if not nl of peek() and word("with")
                set inputs to additive()
            end
            set run_name to "run program"
            if not nl of peek() and is_word("keeping") and word_at(pos + 1, "its") and word_at(pos + 2, "output")
                set pos to pos + 3
                set run_name to "run program keeping"
            end
            set run_args to list of program, inputs
            return record with kind "builtin", name run_name, args run_args, at t
        end
        # `the time`, `the date`, `the year` ... `the weekday`, `the clock`
        if is_word("the") and not nl of item (pos + 1) of tokens and type of item (pos + 1) of tokens is "word" and contains(now_words, value of item (pos + 1) of tokens)
            set pos to pos + 2
            return record with kind "now", which slot_of(now_words, value of item (pos - 1) of tokens) - 1, at t
        end
        if is_word("send") and sends_data() # `send data to "https://..."`, maybe `with headers h`
            set pos to pos + 1
            set send_body to expression()
            expect_word("to")
            set send_address to additive()
            if with_headers()
                set send_args to list of send_body, send_address, additive()
                return record with kind "builtin", name "send with headers", args send_args, at t
            end
            set send_args to list of send_body, send_address
            return record with kind "builtin", name "send", args send_args, at t
        end
        if is_word("json") and json_from() # `json from reply`: what JSON text says
            set pos to pos + 2
            set json_args to list of additive()
            return record with kind "builtin", name "json from", args json_args, at t
        end
        if is_word("load") and loads_file() # `load "scores.txt"`: a value `save` wrote, read back
            set pos to pos + 1
            set load_args to list of (record with kind "read", binary no, subject additive(), at t)
            return record with kind "builtin", name "load", args load_args, at t
        end
        # `random number from 1 to 6`: `random` alone is still a name (math.moth makes a function of it)
        if is_word("random") and type of item (pos + 1) of tokens is "word" and value of item (pos + 1) of tokens is "number" and type of item (pos + 2) of tokens is "word" and value of item (pos + 2) of tokens is "from"
            set pos to pos + 3
            set low to additive()
            expect_word("to")
            return record with kind "random", left low, right additive(), at t
        end
        set syntax to builtin_syntax(t)
        if syntax is not nothing
            set pos to pos + 1
            if item 1 of syntax is not ""
                expect_word(item 1 of syntax)
            end
            set inputs to empty list
            if length of syntax is 1
                add unary() to inputs
                return record with kind "builtin", name value of t, args inputs, at t
            end
            set was_converting to converting
            set converting to item 2 of syntax is not "in"
            add additive() to inputs
            set converting to was_converting
            expect_word(item 2 of syntax)
            add additive() to inputs
            return record with kind "builtin", name value of t, args inputs, at t
        end
        if word("shift") # `shift x left by 2`
            set shifted to additive()
            if not is_word("left") and not is_word("right")
                expected("'left' or 'right'")
            end
            set way to value of peek()
            set pos to pos + 1
            expect_word("by")
            set inputs to list of shifted, additive()
            return record with kind "builtin", name "shift " + way, args inputs, at t
        end
        if is_word("function") and (word_at(pos + 1, "with") or word_at(pos + 1, "gives")) and not nl of item (pos + 1) of tokens # `function with x gives x * 2`
            set pos to pos + 1
            set fn_params to empty list
            if word("with")
                set another to yes
                repeat while another
                    add take_name("an input name") to fn_params
                    set another to match(",") or word("and")
                end
            end
            expect_word("gives")
            set outside_fns to hoisted
            set hoisted to empty list
            set fn_value to expression()
            set fn_body to hoisted # functions its value makes are its own
            add (record with kind "return", value fn_value, at t) to fn_body
            set hoisted to outside_fns
            return record with kind "name", name unnamed("function", fn_params, fn_body, t), at t
        end
        if is_word("remainder") and word_at(pos + 1, "of") and not nl of item (pos + 1) of tokens # `remainder of 17 divided by 5`; else a field
            set left_over to try_phrase("remainder", t)
            if left_over is not nothing
                return left_over
            end
        end
        if is_word("items") and not nl of item (pos + 1) of tokens # `items 2 to 4 of xs`; `items` alone is still a name
            set outside to indexing
            set sliced to try_phrase("items", t)
            set indexing to outside
            if sliced is not nothing
                return sliced
            end
        end
        if word("item") or word("byte") # `byte 5 of block` is another way to say `item 5 of block`
            set outside to indexing
            set indexing to yes
            set index to additive()
            set indexing to outside
            expect_word("of")
            return record with kind "item", index index, subject unary(), at t
        end
        if match("(")
            set outside to indexing
            set was_converting to converting
            set indexing to no
            set converting to yes
            set inner to expression()
            set indexing to outside
            set converting to was_converting
            if not match(")")
                expected("')'")
            end
            return possessive(inner) # `(item 2 of dogs)'s name`
        end
        if type of t is "word" and not contains(reserved, value of t)
            set pos to pos + 1
            set full to member(value of t)
            if tight(match("("))
                return possessive(made_call(full, arg_list(), t))
            end
            if full is value of t and not indexing and word("of") # `name of person`
                return record with kind "field", name value of t, subject unary(), at t
            end
            return possessive(record with kind "name", name full, at t)
        end
        expected("a value")
    end

    # `2 seconds`, `n * 100 milliseconds`, `-1 seconds`: the value with the amount of time at its end made its
    # number, and how many milliseconds that amount's unit is; or nothing, if it doesn't end with an amount of time
    to timed with e
        if kind of e is "builtin" and name of e is "unit"
            set unit_word to value of item 2 of args of e
            if unit_word is in time_units
                return list of item 1 of args of e, item unit_word of time_units
            end
            return nothing
        end
        if kind of e is not "negate" and kind of e is not "math"
            return nothing
        end
        if kind of e is "negate"
            set inner to timed(operand of e)
            if inner is nothing
                return nothing
            end
            return list of (record with kind "negate", operand item 1 of inner, at at of e), item 2 of inner
        end
        set inner to timed(right of e)
        if inner is nothing
            return nothing
        end
        return list of (record with kind "math", op op of e, left left of e, right item 1 of inner, at at of e), item 2 of inner
    end

    # `n` values with commas between them, as a list: the x, y of `move to x, y` and the like
    to several with n, t
        set made to list of expression()
        repeat while length of made is less than n
            if not match(",")
                expected("','")
            end
            add expression() to made
        end
        return record with kind "list", items made, at t
    end

    # "Hi {name}!" is "Hi " + name + "!", which joins them as `say` does; text comes first, so "{a}{b}" is
    # text too. Each value is read from its own tokens, as if it were in brackets.
    to filled_in with t
        set fill_outside to list of tokens, pos, indexing, converting
        set filled to nothing
        if text of item 1 of parts of t is nothing
            set filled to record with kind "value", type "string", value "", at t
        end
        try
            for each fill_part in parts of t
                if text of fill_part is nothing
                    set tokens to tokens of fill_part
                    set pos to 1
                    set indexing to no
                    set converting to yes
                    set fill_piece to expression()
                    if not check("}")
                        fail with problem(peek(), "expected '}' but found " + describe(peek()) + " (" + brace_hint + ")")
                    end
                else
                    set fill_piece to record with kind "value", type "string", value text of fill_part, at t
                end
                if filled is nothing
                    set filled to fill_piece
                else
                    set filled to record with kind "math", op "+", left filled, right fill_piece, at t
                end
                if text of fill_part is nothing # a value in text: its kind's `shown`, if it has one
                    set fill_shows to shows of reading
                    add filled to fill_shows
                end
            end
        if it fails with why
            set tokens to item 1 of fill_outside
            set pos to item 2 of fill_outside
            set indexing to item 3 of fill_outside
            set converting to item 4 of fill_outside
            fail with why
        end
        set tokens to item 1 of fill_outside
        set pos to item 2 of fill_outside
        set indexing to item 3 of fill_outside
        set converting to item 4 of fill_outside
        return filled
    end

    to arg_list
        set outside to indexing
        set indexing to no
        set args to empty list
        set going to not check(")")
        repeat while going
            an_input(args)
            set going to match(",") and not check(")")
        end
        if not match(")")
            expected("')'")
        end
        set indexing to outside
        return args
    end

    # An input of a call, or one given by its name, `greet("Sam", greeting "Hi")`: a name with a value after it,
    # which fill_defaults puts in its place, as no call could have a name followed by a value before.
    to an_input with given_args
        set ni_value to expression()
        if kind of ni_value is "name"
            if not ("'s" is in name of ni_value) and not nl of peek() and not check(",") and not check(")")
                add (record with kind "named", name name of ni_value, value expression(), at at of ni_value) to given_args
                return nothing
            end
        end
        for each ni_one in given_args
            if kind of ni_one is "named"
                fail with problem(at of ni_value, "the inputs given in order come before those given by name")
            end
        end
        add ni_value to given_args
    end

    # A variable of the program's own, for what a statement is written as, with a name no program can write:
    # `the step on line 3`, in a file the program uses `the step on line 3 of shapes.moth`, then `(2)`, `(3)`...
    to hidden_name with what, t
        set hn_named to what + " on line " + line of t
        if file of t is not ""
            set hn_named to hn_named + " of " + file of t
        end
        set hn_n to 1
        if hn_named is in hidden_on_line
            set hn_n to item hn_named of hidden_on_line + 1
        end
        set item hn_named of hidden_on_line to hn_n
        if hn_n is greater than 1
            return hn_named + " (" + hn_n + ")"
        end
        return hn_named
    end

    # `set a, b to pair`: what's after `to` kept in a variable of its own, then each name its item, once there
    # are as many as names. Gives the statements.
    to unpacked with up_names, up_value, t
        set up_kept to hidden_name("the values", t)
        set up_made to list of (record with kind "set", name up_kept, value up_value, at t)
        set up_known to no
        if kind of up_value is "list"
            if length of items of up_value is length of up_names
                set up_known to yes
            end
        end
        if not up_known
            set up_text to record with kind "value", type "string", value "can't set " + length of up_names + " names from a list of ", at t
            set up_why to record with kind "math", op "+", left up_text, right (record with kind "length", subject (record with kind "name", name up_kept, at t), at t), at t
            set up_count to record with kind "length", subject (record with kind "name", name up_kept, at t), at t
            set up_test to record with kind "compare", op "is", negate yes, left up_count, right (record with kind "value", type "number", value "" + length of up_names, at t), at t
            add (record with kind "if", cond up_test, then (list of (record with kind "fail", value up_why, at t)), otherwise empty list, at t) to up_made
        end
        for each up_k from 1 to length of up_names
            set up_item to record with kind "item", index (record with kind "value", type "number", value "" + up_k, at t), subject (record with kind "name", name up_kept, at t), at t
            add (record with kind "set", name item up_k of up_names, value up_item, at t) to up_made
        end
        return up_made
    end

    # `for each k from 10 to 1 by -2`: a count from 0 to the steps there's room for, with k worked out from it
    # each time round, so a step that doesn't land on the end stops before it, as Python's range does
    to stepped with st_variable, st_from, st_to, st_step, st_body, t, by_token
        set st_start to hidden_name("the start", t)
        set st_size to hidden_name("the step", t)
        set st_count to hidden_name("the count", t)
        set st_left to record with kind "math", op "-", left st_to, right (record with kind "name", name st_start, at by_token), at by_token
        set st_ratio to record with kind "math", op "/", left st_left, right (record with kind "name", name st_size, at by_token), at by_token
        set st_steps to record with kind "builtin", name "rounded down", args (list of st_ratio), at by_token
        set st_zero to record with kind "compare", op "is", negate no, left (record with kind "name", name st_size, at by_token), right (record with kind "value", type "number", value "0", at by_token), at by_token
        set st_times to record with kind "math", op "*", left (record with kind "name", name st_count, at by_token), right (record with kind "name", name st_size, at by_token), at by_token
        set st_sum to record with kind "math", op "+", left (record with kind "name", name st_start, at by_token), right st_times, at by_token
        set st_loop_body to list of (record with kind "set", name st_variable, value st_sum, at by_token)
        for each st_s in st_body
            add st_s to st_loop_body
        end
        set st_made to list of (record with kind "set", name st_start, value st_from, at by_token)
        add (record with kind "set", name st_size, value st_step, at by_token) to st_made
        set st_fail to record with kind "fail", value (record with kind "value", type "string", value "'by' needs a step that isn't 0", at by_token), at by_token
        add (record with kind "if", cond st_zero, then (list of st_fail), otherwise empty list, at by_token) to st_made
        add (record with kind "count", name st_count, start (record with kind "value", type "number", value "0", at by_token), limit st_steps, body st_loop_body, at t) to st_made
        return record with kind "several", body st_made, at t
    end

    # whether how a try was left is `lb_how`
    to left_by with lb_leaving, lb_how, t
        return record with kind "compare", op "is", negate no, left (record with kind "name", name lb_leaving, at t), right (record with kind "value", type "string", value lb_how, at t), at t
    end

    # A try's statements, each `return` and each `stop` that leaves it made a note of how, then a stop of the
    # loop either_way puts it in; a loop with such a return in it stops the loop it's in after it, too.
    to ew_rewrite with rw_list, rw_in_loop, rw_left, rw_leaving, rw_giving, t
        set rw_made to empty list
        for each rw_s in rw_list
            set rw_what to kind of rw_s
            if rw_what is "return"
                set returns of rw_left to yes
                set rw_value to value of rw_s
                if rw_value is nothing
                    set rw_value to record with kind "value", type "nothing", value nothing, at at of rw_s
                end
                add (record with kind "set", name rw_giving, value rw_value, at at of rw_s) to rw_made
                add (record with kind "set", name rw_leaving, value (record with kind "value", type "string", value "return", at at of rw_s), at at of rw_s) to rw_made
                add (record with kind "stop", at at of rw_s) to rw_made
            else if rw_what is "stop" and not rw_in_loop
                set stops of rw_left to yes
                add (record with kind "set", name rw_leaving, value (record with kind "value", type "string", value "stop", at at of rw_s), at at of rw_s) to rw_made
                add (record with kind "stop", at at of rw_s) to rw_made
            else if rw_what is "if"
                set then of rw_s to ew_rewrite(then of rw_s, rw_in_loop, rw_left, rw_leaving, rw_giving, t)
                set otherwise of rw_s to ew_rewrite(otherwise of rw_s, rw_in_loop, rw_left, rw_leaving, rw_giving, t)
                add rw_s to rw_made
            else if rw_what is "try"
                set body of rw_s to ew_rewrite(body of rw_s, rw_in_loop, rw_left, rw_leaving, rw_giving, t)
                set handler of rw_s to ew_rewrite(handler of rw_s, rw_in_loop, rw_left, rw_leaving, rw_giving, t)
                add rw_s to rw_made
            else if rw_what is "while" or rw_what is "repeat" or rw_what is "count" or rw_what is "each"
                set rw_before to returns of rw_left
                set returns of rw_left to no
                set body of rw_s to ew_rewrite(body of rw_s, yes, rw_left, rw_leaving, rw_giving, t)
                set rw_returns to returns of rw_left
                set returns of rw_left to rw_before or rw_returns
                add rw_s to rw_made
                if rw_returns
                    add (record with kind "if", cond left_by(rw_leaving, "return", t), then (list of (record with kind "stop", at t)), otherwise empty list, at t) to rw_made
                end
            else
                add rw_s to rw_made
            end
        end
        return rw_made
    end

    # `try ... either way ... end`: what's after `either way` runs however the try's statements end, written in
    # what Moth has, as moth.js's eitherWay does
    to either_way with t, ew_body, ew_caught, ew_handler, ew_after
        set ew_failed to hidden_name("whether it failed", t)
        set ew_mistake to hidden_name("the mistake", t)
        set ew_leaving to hidden_name("how it left", t)
        set ew_giving to hidden_name("what it gave", t)
        set ew_left to record with returns no, stops no
        set ew_start to ew_body
        if ew_handler is not nothing
            set ew_start to list of (record with kind "try", body ew_body, name ew_caught, handler ew_handler, at t)
        end
        set ew_inner to ew_rewrite(ew_start, no, ew_left, ew_leaving, ew_giving, t)
        set ew_set_failed to record with kind "set", name ew_failed, value (record with kind "value", type "yes", value yes, at t), at t
        set ew_keeping to record with kind "try", body ew_inner, name ew_mistake, handler (list of ew_set_failed), at t
        set ew_made to list of (record with kind "set", name ew_failed, value (record with kind "value", type "no", value no, at t), at t)
        if returns of ew_left or stops of ew_left
            add (record with kind "set", name ew_leaving, value (record with kind "value", type "nothing", value nothing, at t), at t) to ew_made
            add (record with kind "repeat", count (record with kind "value", type "number", value "1", at t), body (list of ew_keeping), at t) to ew_made
        else
            add ew_keeping to ew_made
        end
        for each ew_s in ew_after
            add ew_s to ew_made
        end
        set ew_pass_on to record with kind "fail", value (record with kind "name", name ew_mistake, at t), at t
        add (record with kind "if", cond (record with kind "name", name ew_failed, at t), then (list of ew_pass_on), otherwise empty list, at t) to ew_made
        if returns of ew_left
            set ew_give to record with kind "return", value (record with kind "name", name ew_giving, at t), at t
            add (record with kind "if", cond left_by(ew_leaving, "return", t), then (list of ew_give), otherwise empty list, at t) to ew_made
        end
        if stops of ew_left
            add (record with kind "if", cond left_by(ew_leaving, "stop", t), then (list of (record with kind "stop", at t)), otherwise empty list, at t) to ew_made
        end
        return record with kind "several", body ew_made, at t
    end

    # A function's inputs, after its `with`, if it has one: each one's name, what it says it is (`with width as
    # a number`, or -1), and what it is when a call leaves it out (`greeting or "Hello"`, or nothing).
    to inputs_of
        set in_params to empty list
        set in_kinds to empty list
        set in_types to empty list
        set in_typed to no
        set in_fallbacks to empty list
        set in_any to no
        if word("with")
            set in_another to yes
            repeat while in_another
                set input_at to peek()
                add take_name("an input name") to in_params
                if word("as")
                    set in_said to input_type()
                    add kind of in_said to in_kinds
                    add type of in_said to in_types
                    if type of in_said is not nothing
                        set in_typed to yes
                    end
                else
                    add -1 to in_kinds
                    add nothing to in_types
                end
                set in_fallback to nothing
                if word("or")
                    set in_fallback to unary()
                    if not fallback_fits(in_fallback)
                        fail with problem(at of in_fallback, "an input's 'or' is what it is when a call leaves it out: a number, text, yes, no, nothing, or a list of them, written out")
                    end
                    set in_any to yes
                else if in_any
                    fail with problem(input_at, "'" + item (length of in_params) of in_params + "' needs an 'or' too, as an input before it has one")
                end
                add in_fallback to in_fallbacks
                set in_another to match(",") or word("and")
            end
        end
        if not in_typed
            set in_types to nothing # what the inputs say beyond kind_phrases, for the checker, if any says more
        end
        return record with params in_params, kinds in_kinds, types in_types, fallbacks in_fallbacks, any_fallback in_any
    end

    # whether `kind` starts a kind: a name after it, then `with` or `from` on the same line, or the line's end
    # and a `to` starting the next
    to kind_next
        set kn_named to item (pos + 1) of tokens
        set kn_after to item (pos + 2) of tokens
        if nl of kn_named or type of kn_named is not "word"
            return no
        end
        if contains(reserved, value of kn_named)
            return no
        end
        if type of kn_after is not "eof" and not nl of kn_after
            return type of kn_after is "word" and (value of kn_after is "with" or value of kn_after is "from")
        end
        return word_at(pos + 2, "to")
    end

    # `kind dog with name, sound or "woof"`, then the functions each dog has, as moth.js's madeKind makes it
    to made_kind with t
        set mk_name to take_name("a kind's name")
        set mk_inputs to inputs_of()
        set mk_params to params of mk_inputs
        if contains(mk_params, "kind")
            fail with problem(t, "a kind's inputs can't include one called 'kind', as that's the field that says which kind it is")
        end
        set mk_from to nothing
        if word("from")
            set mk_from to expression()
        end
        if not nl of peek()
            expected("a new line")
        end
        add mk_name to aliases # `dog's speak` is dog's function, as `math's sine` is math's
        set mk_fns to block_end(t)
        set mk_owns to empty list
        for each mk_d in mk_fns
            if kind of mk_d is not "define"
                fail with problem(at of mk_d, "a kind holds only its functions, each made with 'to'")
            end
            if contains(mk_params, name of mk_d)
                fail with problem(at of mk_d, "'" + name of mk_d + "' is one of the kind's inputs, so a function of it can't be called that too")
            end
            add (record with own name of mk_d, at at of mk_d) to mk_owns
            if name of mk_d is "shown" # say and values in text then go through it (see with_language)
                set mk_wants to wants of reading
                add "shown" to mk_wants
            end
            set name of mk_d to mk_name + "'s " + name of mk_d
        end
        set mk_made to hidden_name("the one made", t)
        set mk_start to mk_from
        if mk_start is nothing
            set mk_start to record with kind "record", fields (list of "kind"), values (list of (record with kind "value", type "string", value mk_name, at t)), at t
        end
        set mk_body to list of (record with kind "set", name mk_made, value mk_start, at t)
        if mk_from is not nothing
            add (record with kind "setField", name "kind", target (record with kind "name", name mk_made, at t), value (record with kind "value", type "string", value mk_name, at t), at t) to mk_body
        end
        for each mk_p in mk_params
            add (record with kind "setField", name mk_p, target (record with kind "name", name mk_made, at t), value (record with kind "name", name mk_p, at t), at t) to mk_body
        end
        for each mk_o in mk_owns
            set mk_fn_value to record with kind "name", name mk_name + "'s " + own of mk_o, at at of mk_o
            add (record with kind "setField", name own of mk_o, target (record with kind "name", name mk_made, at t), value mk_fn_value, at t) to mk_body
        end
        add (record with kind "return", value (record with kind "name", name mk_made, at t), at t) to mk_body
        set mk_maker to record with kind "define", name mk_name, params mk_params, kinds kinds of mk_inputs, body mk_body, at t, order 0, native nothing, defaults nothing,
            types types of mk_inputs, gives nothing, made_kind mk_name
        if any_fallback of mk_inputs
            set defaults of mk_maker to fallbacks of mk_inputs
        end
        set mk_defines to defines of reading
        add mk_maker to mk_defines
        set mk_all to empty list
        for each mk_d in mk_fns
            add mk_d to mk_all
        end
        add mk_maker to mk_all
        return record with kind "several", body mk_all, at t
    end

    # whether the line after this one starts with `when`, as a `match`'s first clause does
    to when_next
        set wn_i to pos + 1
        set wn_going to yes
        repeat while wn_going
            if type of item wn_i of tokens is "eof" or nl of item wn_i of tokens
                set wn_going to no
            else
                set wn_i to wn_i + 1
            end
        end
        return word_at(wn_i, "when")
    end

    # `match command` and its clauses: `when "go", "walk"` (or `when "go" or "walk"`), `when is greater than 5`,
    # then `else`, each an `if` of the value, kept in a variable of its own, the next clause in its `else`
    to matched with t
        set mt_subject to expression()
        if not nl of peek()
            expected("a new line")
        end
        set mt_kept to hidden_name("the value matched", t)
        set mt_clauses to empty list
        set nesting to nesting + 1
        repeat while is_word("when")
            set mt_w to peek()
            lay(mt_w)
            set pos to pos + 1
            set mt_cond to nothing
            if is_word("is")
                set mt_cond to compared(record with kind "name", name mt_kept, at mt_w)
            else
                set mt_values to list of bitwise()
                set mt_more to yes
                repeat while mt_more
                    if match(",")
                        add bitwise() to mt_values
                    else if word("or")
                        add bitwise() to mt_values
                    else
                        set mt_more to no
                    end
                end
                for each mt_v in mt_values
                    set mt_one to record with kind "compare", op "is", negate no, left (record with kind "name", name mt_kept, at mt_w), right mt_v, at mt_w
                    if mt_cond is nothing
                        set mt_cond to mt_one
                    else
                        set mt_cond to record with kind "or", left mt_cond, right mt_one, at mt_w
                    end
                end
            end
            if not nl of peek()
                expected("a new line")
            end
            add (record with kind "if", cond mt_cond, then statements(t, "match"), otherwise empty list, at mt_w) to mt_clauses
        end
        set mt_chain to empty list
        if word("else")
            set mt_chain to block(t)
        end
        set nesting to nesting - 1
        lay(peek())
        expect_word("end")
        set mt_k to length of mt_clauses
        repeat while mt_k is at least 1
            set mt_c to item mt_k of mt_clauses
            set otherwise of mt_c to mt_chain
            set mt_chain to list of mt_c
            set mt_k to mt_k - 1
        end
        set mt_made to list of (record with kind "set", name mt_kept, value mt_subject, at t)
        for each mt_s in mt_chain
            add mt_s to mt_made
        end
        return record with kind "several", body mt_made, at t
    end

    set made to statements(nothing, "")
    if depth of reading is 1
        set made to with_language(reading, made)
    end
    set depth of reading to depth of reading - 1
    if depth of reading is 0
        fill_defaults(reading)
        made_generators(reading, made)
        own_calls(reading, made)
        set counted to record with n orders_from
        numbered(made, counted)
        set functions_made to n of counted
    end
    return made
end

# The language's own functions (language_text), at the program's top, if it needs them: for `with 2 decimals`,
# or for a kind's `shown`, which every `say` and value in text then goes through, as moth.js's withLanguage has it
to with_language with reading, body
    if contains(wants of reading, "shown")
        for each wl_s in shows of reading
            if kind of wl_s is "say"
                set wl_parts to parts of wl_s
                set wl_made_parts to empty list
                for each wl_part in wl_parts
                    add (record with kind "call", name "the language's shown", args (list of wl_part), at at of wl_part) to wl_made_parts
                end
                set parts of wl_s to wl_made_parts
            else
                set wl_right to right of wl_s
                set right of wl_s to record with kind "call", name "the language's shown", args (list of wl_right), at at of wl_right
            end
        end
    end
    if length of wants of reading is 0
        return body
    end
    set wl_made to prefixed(parse(tokenize(language_text, "the language"), reading), "the language")
    for each wl_s in body
        add wl_s to wl_made
    end
    return wl_made
end

# `pet's speak(x)`, in a program that makes nothing called speak (no function, input or variable, in any
# file it uses): a call to a function made for it at the program's top, which calls the function pet's
# speak field holds, with pet first, so records can each have their own. If pet has no speak, it fails as
# a call to a function nobody made did.
to own_calls with reading, body
    if length of owns of reading is 0
        return nothing
    end
    set names to record with seen (empty dictionary), order (empty list)
    made_names(body, names)
    set helpers to empty list
    set on_line to empty dictionary
    for each call in owns of reading
        set own to name of call
        if not (own is in seen of names)
            set t to at of call
            set line_key to own + " " + line of t
            set n to 1
            if line_key is in on_line
                set n to item line_key of on_line + 1
            end
            set item line_key of on_line to n
            set helper to own + " of the record on line " + line of t
            if n is greater than 1
                set helper to helper + " (" + n + ")"
            end
            set params to list of "the record"
            set kinds to list of -1
            for each k from 2 to length of args of call
                add "input " + (k - 1) to params
                add -1 to kinds
            end
            set guess to closest(own, order of names)
            set why to "there is no function called '" + own + "'"
            if guess is not nothing
                set why to why + ". Did you mean '" + guess + "'?"
            end
            set the_record to record with kind "name", name "the record", at t
            set got to record with kind "set", name own, value (record with kind "field", name own, subject the_record, at t), at t
            set failed to record with kind "fail", value (record with kind "value", type "string", value why, at t), at t
            set tried to record with kind "try", body (list of got), name nothing, handler (list of failed), at t
            set inputs to empty list
            for each p in params
                add (record with kind "name", name p, at t) to inputs
            end
            set gave to record with kind "return", value (record with kind "call", name own, args inputs, at t), at t
            add (record with kind "define", name helper, params params, kinds kinds, body (list of tried, gave), at t, order 0, native nothing, defaults nothing,
                types nothing, gives nothing, made_kind nothing) to helpers
            set name of call to helper
        end
    end
    for each s in body
        add s to helpers
    end
    set k to 1
    for each s in helpers # the program's own list, so it's the one that has them
        if k is at most length of body
            set item k of body to s
        else
            add s to body
        end
        add 1 to k
    end
end

# every name the code makes: functions, their inputs, and variables, in the order they're written
to made_names with body, names
    for each s in body
        set what to kind of s
        set fn_made to nothing
        if what is "define"
            set fn_made to s
            note_name(names, name of s)
        else if what is "when" or what is "every"
            set fn_made to fn of s
        end
        if fn_made is not nothing
            for each p in params of fn_made
                note_name(names, p)
            end
            made_names(body of fn_made, names)
        end
        if what is "set" or what is "add" or what is "count" or what is "each"
            note_name(names, name of s)
        end
        if what is "try" and name of s is not nothing
            note_name(names, name of s)
        end
        if what is "if"
            made_names(then of s, names)
            made_names(otherwise of s, names)
        end
        if what is "while" or what is "repeat" or what is "count" or what is "each" or what is "try"
            made_names(body of s, names)
        end
        if what is "try"
            made_names(handler of s, names)
        end
    end
end

to note_name with names, n
    if not (n is in seen of names)
        set item n of (seen of names) to yes
        set in_order to order of names
        add n to in_order
    end
end

# Each function's number, in the order they're written, inside one another's too (see made_order): what
# scope.js counts. Not the order they're read in, since the functions a statement's values make go before it.
# On from the functions read before, so no two have the same number however many programs are read.
to numbered with body, count
    for each s in body
        set what to kind of s
        set fn_made to nothing
        if what is "define"
            set fn_made to s
        else if what is "when" or what is "every"
            set fn_made to fn of s
        end
        if fn_made is not nothing
            set n of count to n of count + 1
            set order of fn_made to n of count
            numbered(body of fn_made, count)
        end
        if what is "if"
            numbered(then of s, count)
            numbered(otherwise of s, count)
        end
        if what is "while" or what is "repeat" or what is "count" or what is "each" or what is "try"
            numbered(body of s, count)
        end
        if what is "try"
            numbered(handler of s, count)
        end
    end
end

# A call by a function's name that leaves inputs out, `greet("Sam")` for `to greet with name, greeting or
# "Hello"`, gets what each was given after its `or`, once the whole program is read, so every engine sees a
# call with all of them. A function made more than once with that name: its last. Through a value, a call
# needs them all.
to fill_defaults with reading
    set made_fns to empty dictionary
    for each f in defines of reading
        set item (name of f) of made_fns to f
    end
    for each call in calls of reading
        place_named(call, made_fns)
    end
    set with_defaults to empty dictionary
    for each f in defines of reading
        set item (name of f) of with_defaults to f
    end
    for each call in calls of reading
        if name of call is in with_defaults
            set f to item (name of call) of with_defaults
            set given to length of args of call
            if defaults of f is not nothing and given is less than length of params of f
                set fits to yes
                for each k from given + 1 to length of params of f
                    if item k of defaults of f is nothing
                        set fits to no
                    end
                end
                if fits
                    set call_args to args of call
                    for each k from given + 1 to length of params of f
                        add copied(item k of defaults of f) to call_args
                    end
                end
            end
        end
    end
end

# Inputs given by name, `greet("Sam", greeting "Hi")`, each put in its place, and each left out before one of
# them given what's after its `or`
to place_named with pn_call, made_fns
    set pn_in_order to empty list
    set pn_by_name to empty list
    for each pn_a in args of pn_call
        if kind of pn_a is "named"
            add pn_a to pn_by_name
        else
            add pn_a to pn_in_order
        end
    end
    if length of pn_by_name is 0
        return nothing
    end
    set pn_first to item 1 of pn_by_name
    if not (name of pn_call is in made_fns)
        fail with problem(at of pn_first, "'" + name of pn_call + "' isn't a function made with 'to' here, so its inputs can't be given by name")
    end
    set pn_f to item (name of pn_call) of made_fns
    set pn_placed to empty dictionary
    set pn_count to length of pn_in_order
    for each pn_k from 1 to length of pn_in_order
        set item pn_k of pn_placed to item pn_k of pn_in_order
    end
    for each pn_g in pn_by_name
        set pn_k to slot_of(params of pn_f, name of pn_g)
        if pn_k is 0
            fail with problem(at of pn_g, "'" + name of pn_call + "' has no input called '" + name of pn_g + "'")
        end
        if pn_k is in pn_placed
            fail with problem(at of pn_g, "'" + name of pn_g + "' is given twice")
        end
        set item pn_k of pn_placed to value of pn_g
        if pn_k is greater than pn_count
            set pn_count to pn_k
        end
    end
    set pn_filled to empty list
    for each pn_k from 1 to pn_count
        if pn_k is in pn_placed
            add item pn_k of pn_placed to pn_filled
        else
            set pn_default to nothing
            if defaults of pn_f is not nothing
                set pn_default to item pn_k of defaults of pn_f
            end
            if pn_default is nothing
                fail with problem(at of pn_first, "'" + name of pn_call + "' needs its input '" + item pn_k of params of pn_f + "' too, as it has no 'or'")
            end
            add copied(pn_default) to pn_filled
        end
    end
    set args of pn_call to pn_filled
end

# `give x` in a function, in a program that makes nothing called `give`: the function gives the list of every
# value it gave, in order, when it returns, as moth.js's madeGenerators makes it
to made_generators with reading, program
    set mg_fns to empty list
    for each mg_f in defines of reading
        if gives_in(body of mg_f)
            add mg_f to mg_fns
        end
    end
    if length of mg_fns is 0
        return nothing
    end
    set mg_names to record with seen (empty dictionary), order (empty list)
    made_names(program, mg_names)
    if "give" is in seen of mg_names
        return nothing
    end
    for each mg_f in mg_fns
        set mg_t to at of mg_f
        set mg_list to "the values given on line " + line of mg_t
        if file of mg_t is not ""
            set mg_list to mg_list + " of " + file of mg_t
        end
        given_walk(body of mg_f, mg_list)
        set mg_body to list of (record with kind "set", name mg_list, value (record with kind "list", items empty list, at mg_t), at mg_t)
        for each mg_s in body of mg_f
            add mg_s to mg_body
        end
        add (record with kind "return", value (record with kind "name", name mg_list, at mg_t), at mg_t) to mg_body
        set body of mg_f to mg_body
    end
end

# whether a statement is `give x`
to giving_one with s
    if kind of s is not "call"
        return no
    end
    return name of s is "give" and length of args of s is 1
end

# the blocks inside a statement, but a function's own
to blocks_in with s
    set bi_made to empty list
    set bi_what to kind of s
    if bi_what is "if"
        add then of s to bi_made
        add otherwise of s to bi_made
    else if bi_what is "while" or bi_what is "repeat" or bi_what is "count" or bi_what is "each"
        add body of s to bi_made
    else if bi_what is "try"
        add body of s to bi_made
        add handler of s to bi_made
    end
    return bi_made
end

# whether `give x` is in these statements, but not in a function made inside them
to gives_in with body
    for each gi_s in body
        if giving_one(gi_s)
            return yes
        end
        for each gi_inner in blocks_in(gi_s)
            if gives_in(gi_inner)
                return yes
            end
        end
    end
    return no
end

# each `give x` made an add to the list, and each `return` its return
to given_walk with body, gw_list
    for each gw_k from 1 to length of body
        set gw_s to item gw_k of body
        if giving_one(gw_s)
            set item gw_k of body to record with kind "add", value item 1 of args of gw_s, name gw_list, at at of gw_s
        else if kind of gw_s is "return"
            set gw_value to value of gw_s
            if gw_value is not nothing
                set gw_hidden to no
                if kind of gw_value is "name"
                    set gw_hidden to " on line " is in name of gw_value
                end
                if not gw_hidden
                    fail with problem(at of gw_value, "a function that gives its values with 'give' returns the list of them, so it can't return a value too")
                end
            end
            set item gw_k of body to record with kind "return", value (record with kind "name", name gw_list, at at of gw_s), at at of gw_s
        else
            for each gw_inner in blocks_in(gw_s)
                given_walk(gw_inner, gw_list)
            end
        end
    end
end

# a value written out after an input's `or`, made again for a call: a list's own items too
to copied with e
    if kind of e is "list"
        set made_items to empty list
        for each part in items of e
            add copied(part) to made_items
        end
        return record with kind "list", items made_items, at at of e
    end
    if kind of e is "negate"
        return record with kind "negate", operand copied(operand of e), at at of e
    end
    if kind of e is "dictionary"
        return record with kind "dictionary", items empty list, at at of e
    end
    if kind of e is "record"
        return record with kind "record", fields empty list, values empty list, at at of e
    end
    return record with kind "value", type type of e, value value of e, at at of e
end

# what can come after an input's `or`: a value written out, or a list of them
to fallback_fits with e
    set what to kind of e
    if what is "value"
        return yes
    end
    if what is "negate"
        return kind of operand of e is "value" and type of operand of e is "number"
    end
    if what is "list"
        for each part in items of e
            if not fallback_fits(part)
                return no
            end
        end
        return yes
    end
    if what is "dictionary"
        return length of items of e is 0
    end
    if what is "record"
        return length of fields of e is 0
    end
    return no
end

# ---------- which variable each name means ----------

set statement_words to list of "set", "add", "say", "if", "repeat", "for", "to", "return", "move", "turn", "pen", "fail", "stop", "use", "try", "remove", "write", "expect", "when", "every"

# Names each function changes. Inputs and functions made with `to` always belong to the function itself; a
# name it sets (or loops over, or adds to) belongs to the function too, unless a variable of that name is made
# above its `to` line, in the code around it (see new_scope).
to declarations with body, own, shared, adds
    for each s in body
        set what to kind of s
        if what is "define"
            add name of s to own
        end
        if what is "set" or what is "count" or what is "each" or (what is "try" and name of s is not nothing)
            add name of s to shared
        end
        if what is "add"
            add name of s to adds
        end
        if what is "if"
            declarations(then of s, own, shared, adds)
            declarations(otherwise of s, own, shared, adds)
        end
        if what is "while" or what is "repeat" or what is "count" or what is "each" or what is "try"
            declarations(body of s, own, shared, adds)
        end
        if what is "try"
            declarations(handler of s, own, shared, adds)
        end
    end
end

# `use "math.moth" as math`: each name in the file becomes `math's pi`, `math's sine`, which no name in the
# program can be, so the file keeps its own top level, as if it ran alone. A function's inputs, and the
# functions a function makes, are left alone, since nothing outside the function can reach them; every
# other name is renamed, so a variable only a function in the file sets stays that function's own, and a
# name the file never makes isn't the program's.
set named_kinds to list of "set", "add", "count", "each", "define", "call", "name", "try" # their `name` is a variable

to prefixed with body, alias
    rename_all(body, alias, empty list)
    return body
end

# whether a name is one of the language's own functions', which no file's alias renames
to language_name with n
    if length of n is less than 15
        return no
    end
    return items 1 to 15 of n is "the language's "
end

to rename_all with nodes, alias, hidden
    for each node in nodes
        rename(node, alias, hidden)
    end
end

# a function's code, where its inputs and the functions it makes hide the names around them
to rename_inside with d, alias, hidden
    set inside to empty list
    for each n in hidden
        add n to inside
    end
    for each p in params of d
        add p to inside
    end
    set own to empty list
    set shared to empty list
    set adds to empty list
    declarations(body of d, own, shared, adds)
    for each n in own
        add n to inside
    end
    rename_all(body of d, alias, inside)
end

# a node, and the nodes in it
to rename with node, alias, hidden
    if node is nothing
        return nothing
    end
    set what to kind of node
    if contains(named_kinds, what)
        if name of node is not nothing and not contains(hidden, name of node) and not language_name(name of node)
            set name of node to alias + "'s " + name of node
        end
    end
    if what is "define"
        rename_inside(node, alias, hidden)
    end
    if what is "set" or what is "add" or what is "return" or what is "fail" or what is "turtle"
        rename(value of node, alias, hidden)
    end
    if what is "setItem" or what is "setField" or what is "write"
        rename(target of node, alias, hidden)
        rename(value of node, alias, hidden)
    end
    if what is "remove"
        rename(key of node, alias, hidden)
        rename(target of node, alias, hidden)
    end
    if what is "say"
        rename_all(parts of node, alias, hidden)
    end
    if what is "if"
        rename(cond of node, alias, hidden)
        rename_all(then of node, alias, hidden)
        rename_all(otherwise of node, alias, hidden)
    end
    if what is "expect"
        rename(cond of node, alias, hidden)
    end
    if what is "do"
        rename(value of node, alias, hidden)
    end
    if what is "when" or what is "every" # a handler's name isn't a variable
        rename_inside(fn of node, alias, hidden)
    end
    if what is "every"
        rename(interval of node, alias, hidden)
    end
    if what is "when"
        rename(label of node, alias, hidden)
    end
    if what is "while"
        rename(cond of node, alias, hidden)
        rename_all(body of node, alias, hidden)
    end
    if what is "repeat"
        rename(count of node, alias, hidden)
        rename_all(body of node, alias, hidden)
    end
    if what is "count"
        rename(start of node, alias, hidden)
        rename(limit of node, alias, hidden)
        rename_all(body of node, alias, hidden)
    end
    if what is "each"
        rename(over of node, alias, hidden)
        rename_all(body of node, alias, hidden)
    end
    if what is "try"
        rename_all(body of node, alias, hidden)
        rename_all(handler of node, alias, hidden)
    end
    if what is "call" or what is "builtin"
        rename_all(args of node, alias, hidden)
    end
    if what is "named"
        rename(value of node, alias, hidden)
    end
    if what is "math" or what is "compare" or what is "or" or what is "and" or what is "random"
        rename(left of node, alias, hidden)
        rename(right of node, alias, hidden)
    end
    if what is "not" or what is "negate"
        rename(operand of node, alias, hidden)
    end
    if what is "list" or what is "dictionary"
        rename_all(items of node, alias, hidden)
    end
    if what is "record"
        rename_all(values of node, alias, hidden)
    end
    if what is "length" or what is "field" or what is "read" or what is "readFolder"
        rename(subject of node, alias, hidden)
    end
    if what is "item"
        rename(index of node, alias, hidden)
        rename(subject of node, alias, hidden)
    end
    if what is "ask"
        rename(question of node, alias, hidden)
    end
    if what is "exit"
        rename(value of node, alias, hidden)
    end
    if what is "removeFile"
        rename(target of node, alias, hidden)
    end
    if what is "wait"
        rename(amount of node, alias, hidden)
    end
    if what is "play"
        rename(note of node, alias, hidden)
        rename(time of node, alias, hidden)
    end
end

# A scope is one function (or the whole program): item n of its names is the name in slot n. The last
# slot with a name wins, as when a function has two inputs with the same name.
to slot_of with names, wanted
    set found to 0
    set n to 0
    for each candidate in names
        add 1 to n
        if candidate is wanted
            set found to n
        end
    end
    return found
end

# Where things are in one function's code (or the program's), in the order they're written: for each name
# it makes, the number of the last function made before that (0 if none), or a function's own number for
# its name (see func). So a name is made above a function when its number is less than the function's. A
# try's `with` name is made at its `if it fails`, after the try's code. Gives back the last function's number.
to made_order with body, made, last
    for each s in body
        set what to kind of s
        if what is "define"
            set last to order of s
        else if what is "when" or what is "every"
            set last to order of fn of s
        end
        if what is "define" or what is "set" or what is "count" or what is "each"
            first_made(made, name of s, last)
        end
        if what is "if"
            set last to made_order(then of s, made, last)
            set last to made_order(otherwise of s, made, last)
        end
        if what is "while" or what is "repeat" or what is "count" or what is "each" or what is "try"
            set last to made_order(body of s, made, last)
        end
        if what is "try"
            if name of s is not nothing
                first_made(made, name of s, last)
            end
            set last to made_order(handler of s, made, last)
        end
    end
    return last
end

to first_made with made, wanted, last
    if not (wanted is in made)
        set item wanted of made to last
    end
end

# `place` is the function's number (0 for the program). A name the function changes means a variable outside
# it only if the nearest function around it with a variable of that name (or the top level) makes it above
# the function's `to` line; otherwise the function gets a variable of its own.
to new_scope with parent, params, body, place
    set names to empty list
    set made to empty dictionary # see made_order: the inputs are made above everything
    for each p in params
        add p to names
        set item p of made to 0
    end
    made_order(body, made, 0)
    set own to empty list
    set shared to empty list
    set adds to empty list
    declarations(body, own, shared, adds)
    for each n in own
        if slot_of(names, n) is 0
            add n to names
        end
    end
    for each n in shared
        if slot_of(names, n) is 0 and not reaches(parent, place, n)
            add n to names
        end
    end
    # `add 1 to n` with no n anywhere is a name nothing sets; with one made below, it's this function's own
    for each n in adds
        if slot_of(names, n) is 0 and not reaches(parent, place, n) and parent is not nothing and resolve(parent, n) is not nothing
            add n to names
        end
    end
    set level to 0
    if parent is not nothing
        set level to level of parent + 1
    end
    return record with parent parent, names names, level level, temps 0, made made, place place
end

# whether a name the function numbered `place` changes means a variable in `outer`, or further out
to reaches with outer, place, wanted
    set here to outer
    set before to place
    repeat while here is not nothing
        if slot_of(names of here, wanted) is not 0
            set known to made of here
            return wanted is in known and item wanted of known is less than before
        end
        set before to place of here
        set here to parent of here
    end
    return no
end

# how many functions out a name lives, and which of that function's slots it is; nothing if it isn't anywhere
to resolve with scope, wanted
    set depth to 0
    set here to scope
    repeat while here is not nothing
        set slot to slot_of(names of here, wanted)
        if slot is not 0
            return record with depth depth, slot slot
        end
        set here to parent of here
        add 1 to depth
    end
    return nothing
end

# Edits needed to turn one word into another, counting a swap of two neighbours as one ("sya" -> "say").
to distance with a, b
    set xs to letters(a)
    set ys to letters(b)
    set n to length of xs
    set m to length of ys
    set d to empty list # row i + 1 holds the distances from the first i letters of a
    for each i from 0 to n
        set row to empty list
        for each j from 0 to m
            if i is 0
                add j to row
            else if j is 0
                add i to row
            else
                add 0 to row
            end
        end
        add row to d
    end
    for each i from 1 to n
        set above to item i of d
        set row to item (i + 1) of d
        for each j from 1 to m
            set cost to 1
            if item i of xs is item j of ys
                set cost to 0
            end
            set best to item (j + 1) of above + 1
            if item j of row + 1 is less than best
                set best to item j of row + 1
            end
            if item j of above + cost is less than best
                set best to item j of above + cost
            end
            if i is greater than 1 and j is greater than 1 and item i of xs is item (j - 1) of ys and item (i - 1) of xs is item j of ys
                if item (j - 1) of item (i - 1) of d + 1 is less than best
                    set best to item (j - 1) of item (i - 1) of d + 1
                end
            end
            set item (j + 1) of row to best
        end
    end
    return item (m + 1) of item (n + 1) of d
end

# The candidate a misspelled name most likely meant, or nothing if none is close: 1 edit for short names, 2 otherwise.
to closest with wanted, candidates
    set best to nothing
    set best_distance to 3
    if length of wanted is at most 3
        set best_distance to 2
    end
    for each candidate in candidates
        set gap to distance(wanted, candidate)
        if gap is less than best_distance
            set best to candidate
            set best_distance to gap
        end
    end
    return best
end

to no_value with wanted
    return "'" + wanted + "' has no value yet (give it one with 'set " + wanted + " to ...')"
end

# What to say when a name nothing ever sets is used. A line that starts with an unknown name may be a
# misspelled Moth word instead, like `sya "hi"`.
to undefined_message with scope, wanted, call, statement
    if call and wanted is in phrase_hints # a phrase missing its last part, like `wait 2`
        return "there is no function called '" + wanted + "' (" + item wanted of phrase_hints + ")"
    end
    if call and statement and wanted is "play" # `play beep`, `beep`: how a sound is made instead
        return "there is no function called 'play' (to make a sound, write 'play note \"C\" for 1 second' or 'play a beep')"
    end
    if call and statement and wanted is "beep"
        return "there is no function called 'beep' (to make one, write 'play a beep')"
    end
    set known to empty list
    set here to scope
    repeat while here is not nothing
        for each n in names of here
            add n to known
        end
        set here to parent of here
    end
    if statement
        for each w in statement_words
            add w to known
        end
    end
    set guess to closest(wanted, known)
    set message to no_value(wanted)
    set split_at to position of "'s " in wanted # `math's sine`: a name the file used `as math` makes
    if split_at is not 0
        set module to ""
        set member_name to ""
        set i to 0
        for each c in wanted
            add 1 to i
            if i is less than split_at
                add c to module
            else if i is greater than split_at + 2
                add c to member_name
            end
        end
        set message to "'" + module + "' has nothing called '" + member_name + "'"
    else if call
        set message to "there is no function called '" + wanted + "'"
    else if guess is not nothing
        set message to "'" + wanted + "' has no value yet"
    end
    if guess is not nothing
        return message + ". Did you mean '" + guess + "'?"
    end
    return message
end

# ---------- JavaScript ----------

set ats to empty list # every token an error can point at; a position in the code is its number here
set js_workers to no # whether the program starts a worker, so needs $globals
set event_names to list of "key", "click", "drag", "button", "enter", "checkbox", "choice", "slider" # in the order of EVENTS in vm.js
set turtle_actions to list of "forward", "back", "left", "right", "up", "down", "color", "width", "to", "clear", "box", "circle", "text",
    "chart", "picture", "button", "text box", "clear text box", "checkbox", "tick", "untick", "text area", "list", "dropdown", "slider",
    "set slider"
set math_signs to list of "+", "-", "*", "/"
set math_helpers to list of "add", "sub", "mul", "div"
set comparisons to list of "is", "less than", "greater than", "at least", "at most", "divisible by", "in"
set compare_helpers to list of "eq", "lt", "gt", "ge", "le", "dv", "isIn"

to remember with at
    add at to ats
    return length of ats - 1
end

# a JavaScript string, as JSON.stringify writes it (text holds no control characters but tab and new line)
to quote with text
    set out to "\""
    for each c in text
        if c is "\""
            add "\\\"" to out
        else if c is "\\"
            add "\\\\" to out
        else if c is "\n"
            add "\\n" to out
        else if c is "\t"
            add "\\t" to out
        else
            add c to out
        end
    end
    return out + "\""
end

to quote_list with things
    set quoted to empty list
    for each thing in things
        add quote(thing) to quoted
    end
    return "[" + joined(quoted, ",") + "]"
end

# a number as written, less leading zeros (JavaScript reads 07 as octal)
to strip_zeros with text
    set out to ""
    for each c in text
        if out is "0" and is_digit(c)
            set out to c
        else
            add c to out
        end
    end
    return out
end

# Each variable is a JavaScript `let` named after its slot, v<level>_<slot>.
to v with slot, level
    return "v" + level + "_" + slot
end

to ref with scope, wanted
    set found to resolve(scope, wanted)
    return v(slot of found, level of scope - depth of found)
end

to temp with scope
    set temps of scope to temps of scope + 1
    return "$t" + temps of scope
end

to undefined_name with scope, wanted, at, call, statement
    set message to undefined_message(scope, wanted, call, statement)
    return "fail(" + quote(message) + ", " + remember(at) + ")"
end

to js_block with scope, body
    set lines to empty list
    for each s in body
        add js_statement(scope, s) to lines
    end
    return joined(lines, "\n")
end

to js_list with scope, nodes
    set parts to empty list
    for each node in nodes
        add js_expr(scope, node) to parts
    end
    return joined(parts, ", ")
end

# Loops count a step at the end of each round, so `maxSteps` stops both engines at the same place.
to js_statement with scope, s
    set what to kind of s
    if what is "set"
        return ref(scope, name of s) + " = " + js_expr(scope, value of s) + ";"
    end
    if what is "setItem"
        set target to target of s
        set head to "{ const $r = itemRef(" + js_expr(scope, subject of target) + ", " + js_expr(scope, index of target) + ", "
        set k to remember(at of target)
        return head + k + "); put($r, " + js_expr(scope, value of s) + ", " + k + "); }"
    end
    if what is "add"
        set value to js_expr(scope, value of s)
        if resolve(scope, name of s) is nothing
            return value + ";\n" + undefined_name(scope, name of s, at of s, no, no) + ";"
        end
        set variable to ref(scope, name of s)
        return "{ const $v = " + value + "; " + variable + " = addInto(" + variable + ", $v, " + quote(name of s) + ", " + remember(at of s) + "); }"
    end
    if what is "say"
        set helper to "say"
        if errors of s
            set helper to "sayError"
        end
        return helper + "([" + js_list(scope, parts of s) + "]);"
    end
    if what is "exit"
        set exit_code to "0"
        if value of s is not nothing
            set exit_code to js_expr(scope, value of s)
        end
        return "exit(" + exit_code + ", " + remember(at of s) + ");"
    end
    if what is "if"
        return "if (truthy(" + js_expr(scope, cond of s) + ")) {\n" + js_block(scope, then of s) + "\n} else {\n" + js_block(scope, otherwise of s) + "\n}"
    end
    if what is "while"
        return "for (;;) {\nif (!truthy(" + js_expr(scope, cond of s) + ")) break;\n" + js_block(scope, body of s) + "\ntick(" + remember(at of s) + ");\n}"
    end
    if what is "repeat"
        set k to remember(at of s)
        return "for (let $n = checkRepeat(" + js_expr(scope, count of s) + ", " + k + "); $n > 0; $n--) {\n" + js_block(scope, body of s) + "\ntick(" + k + ");\n}"
    end
    if what is "count"
        set k to remember(at of s)
        set range to "checkRange(" + js_expr(scope, start of s) + ", " + js_expr(scope, limit of s) + ", " + k + ")"
        return "for (let [$i, $last] = " + range + "; atMost($i, $last); $i++) {\n" + ref(scope, name of s) + " = $i;\n" + js_block(scope, body of s) + "\ntick(" + k + ");\n}"
    end
    if what is "each"
        set k to remember(at of s)
        return "for (const $x of itemsOf(" + js_expr(scope, over of s) + ", " + k + ")) {\n" + ref(scope, name of s) + " = $x;\n" + js_block(scope, body of s) + "\ntick(" + k + ");\n}"
    end
    if what is "define"
        return ref(scope, name of s) + " = " + closure_code(scope, s) + ";"
    end
    if what is "when" # a handler is a function of its own, made and handed over, not kept in a variable
        if label of s is not nothing # and what it waits for
            set handler_code to closure_code(scope, fn of s)
            set handler_at to remember(at of s)
            return "handle(" + (slot_of(event_names, event of s) - 1) + ", " + handler_code + ", " + handler_at + ", " + js_expr(scope, label of s) + ");"
        end
        return "handle(" + (slot_of(event_names, event of s) - 1) + ", " + closure_code(scope, fn of s) + ", " + remember(at of s) + ");"
    end
    if what is "every"
        set interval to js_expr(scope, interval of s)
        return "every(" + interval + ", " + unit of s + ", " + closure_code(scope, fn of s) + ", " + remember(at of s) + ");"
    end
    if what is "return"
        if value of s is nothing
            return "return null;"
        end
        return "return " + js_expr(scope, value of s) + ";"
    end
    if what is "call"
        return js_call(scope, s, yes) + ";"
    end
    if what is "do" # a value done for what it does: `start count(10)`, `wait for job`
        return js_expr(scope, value of s) + ";"
    end
    if what is "turtle"
        set value to "null"
        if value of s is not nothing
            set value to js_expr(scope, value of s)
        end
        return "turtle(" + (slot_of(turtle_actions, action of s) - 1) + ", " + value + ", " + remember(at of s) + ");"
    end
    if what is "setField"
        set head to "{ const $o = recordFor(" + js_expr(scope, target of s) + ", " + quote(name of s) + ", " + remember(at of s) + "); $o["
        return head + quote(name of s) + "] = " + js_expr(scope, value of s) + "; }"
    end
    if what is "fail"
        return "failWith(" + js_expr(scope, value of s) + ", " + remember(at of s) + ");"
    end
    if what is "stop"
        return "break;"
    end
    if what is "remove"
        return "removeKey(" + js_expr(scope, key of s) + ", " + js_expr(scope, target of s) + ", " + remember(at of s) + ");"
    end
    if what is "write"
        return "write(" + js_expr(scope, value of s) + ", " + js_expr(scope, target of s) + ", " + remember(at of s) + ");"
    end
    if what is "removeFile"
        return "removeFile(" + js_expr(scope, target of s) + ", " + remember(at of s) + ");"
    end
    if what is "wait"
        return "wait(" + js_expr(scope, amount of s) + ", " + unit of s + ", " + remember(at of s) + ");"
    end
    if what is "play" # `play a beep` has no note, nothing that can go wrong, and no position
        if note of s is nothing
            return "beep();"
        end
        return "play(" + js_expr(scope, note of s) + ", " + js_expr(scope, time of s) + ", " + unit of s + ", " + remember(at of s) + ");"
    end
    if what is "expect"
        set c to cond of s
        if kind of c is not "compare"
            return "expectYes(" + js_expr(scope, c) + ", " + remember(at of s) + ");"
        end
        set negated to "false"
        if negate of c
            set negated to "true"
        end
        set head to "expect(" + quote(op of c) + ", " + negated + ", " + js_expr(scope, left of c) + ", "
        return head + js_expr(scope, right of c) + ", " + remember(at of s) + ");"
    end
    if what is "try" # the call depth when it began, so catching a mistake deep in calls can put it back
        set t to temp(scope)
        set body to js_block(scope, body of s)
        set keep to ""
        if name of s is not nothing
            set keep to ref(scope, name of s) + " = "
        end
        return t + " = depthNow();\ntry {\n" + body + "\n} catch ($e) {\n" + keep + "caught($e, " + t + ");\n" + js_block(scope, handler of s) + "\n}"
    end
end

# a Moth function, made from `to` (or a handler's `when`): a JavaScript function, and its name and inputs
to closure_code with scope, d
    set inner to function_code(scope, params of d, body of d, order of d)
    set inputs to empty list
    for each n from 1 to length of params of d
        add v(n, level of scope of inner) to inputs
    end
    set made to "fn(" # made inside another function, which a worker can't be given
    if level of scope is greater than 0
        set made to "fnIn("
    end
    set head to made + quote(name of d) + ", " + quote_list(params of d) + ", function (" + joined(inputs, ", ") + ") {\n"
    set typed to "" # what each input says it is, if any does
    for each k in kinds of d
        if k is not -1
            set typed to ", [" + joined(kinds of d, ", ") + "]"
        end
    end
    return head + code of inner + "\nreturn null;\n}" + typed + ")"
end

# The function is looked up before its inputs are worked out, and checked after, as in the VM.
to js_call with scope, e, statement
    if resolve(scope, name of e) is nothing
        return undefined_name(scope, name of e, at of e, yes, statement)
    end
    set k to remember(at of e)
    set f to "callable(" + ref(scope, name of e) + ", " + quote(name of e) + ", " + k + ")"
    set args to js_list(scope, args of e)
    if length of args of e is greater than 3
        return "callN(" + f + ", [" + args + "], " + quote(name of e) + ", " + k + ")"
    end
    if args is not ""
        set f to f + ", " + args
    end
    return "call" + length of args of e + "(" + f + ", " + quote(name of e) + ", " + k + ")"
end

to js_expr with scope, e
    set what to kind of e
    if what is "value"
        if type of e is "number"
            return strip_zeros(value of e)
        end
        if type of e is "string"
            return quote(value of e)
        end
        if type of e is "yes"
            return "true"
        end
        if type of e is "no"
            return "false"
        end
        return "null"
    end
    if what is "name"
        if resolve(scope, name of e) is nothing
            return undefined_name(scope, name of e, at of e, no, no)
        end
        set variable to ref(scope, name of e)
        return "(" + variable + " === UNSET ? unset(" + quote(name of e) + ", " + remember(at of e) + ") : " + variable + ")"
    end
    if what is "call"
        return js_call(scope, e, no)
    end
    if what is "math"
        set helper to look_up(op of e, math_signs, math_helpers)
        return helper + "(" + js_expr(scope, left of e) + ", " + js_expr(scope, right of e) + ", " + remember(at of e) + ")"
    end
    if what is "compare"
        set helper to look_up(op of e, comparisons, compare_helpers)
        set test to helper + "(" + js_expr(scope, left of e) + ", " + js_expr(scope, right of e) + ", " + remember(at of e) + ")"
        if negate of e
            return "!" + test
        end
        return test
    end
    if what is "and"
        set t to temp(scope)
        return "(truthy(" + t + " = " + js_expr(scope, left of e) + ") ? " + js_expr(scope, right of e) + " : " + t + ")"
    end
    if what is "or"
        set t to temp(scope)
        return "(truthy(" + t + " = " + js_expr(scope, left of e) + ") ? " + t + " : " + js_expr(scope, right of e) + ")"
    end
    if what is "not"
        return "!truthy(" + js_expr(scope, operand of e) + ")"
    end
    if what is "negate"
        return "neg(" + js_expr(scope, operand of e) + ", " + remember(at of e) + ")"
    end
    if what is "list"
        return "[" + js_list(scope, items of e) + "]"
    end
    if what is "length"
        return "lengthOf(" + js_expr(scope, subject of e) + ", " + remember(at of e) + ")"
    end
    if what is "item"
        return "item(" + js_expr(scope, subject of e) + ", " + js_expr(scope, index of e) + ", " + remember(at of e) + ")"
    end
    if what is "record"
        return "record(" + quote_list(fields of e) + ", [" + js_list(scope, values of e) + "])"
    end
    if what is "dictionary"
        return "dict([" + js_list(scope, items of e) + "], " + remember(at of e) + ")"
    end
    if what is "field"
        return "field(" + js_expr(scope, subject of e) + ", " + quote(name of e) + ", " + remember(at of e) + ")"
    end
    if what is "ask"
        return "ask(" + js_expr(scope, question of e) + ", " + remember(at of e) + ")"
    end
    if what is "read"
        set flag to "false"
        if binary of e
            set flag to "true"
        end
        return "read(" + js_expr(scope, subject of e) + ", " + flag + ", " + remember(at of e) + ")"
    end
    if what is "readFolder"
        return "readFolder(" + js_expr(scope, subject of e) + ", " + remember(at of e) + ")"
    end
    if what is "arguments"
        return "args()"
    end
    if what is "random"
        return "random(" + js_expr(scope, left of e) + ", " + js_expr(scope, right of e) + ", " + remember(at of e) + ")"
    end
    if what is "now"
        return "now(" + which of e + ")"
    end
    if what is "builtin" and name of e is "start worker" # the call, made on copies, with the program's variables swapped for them by $globals
        set call to item 1 of args of e
        if resolve(scope, name of call) is nothing
            return undefined_name(scope, name of call, at of call, yes, no)
        end
        set k to remember(at of call)
        set js_workers to yes
        set f to "callable(" + ref(scope, name of call) + ", " + quote(name of call) + ", " + k + ")"
        return "worker(" + f + ", [" + js_list(scope, args of call) + "], " + quote(name of call) + ", " + k + ", $globals)"
    end
    if what is "builtin"
        return "builtin(" + (slot_of(builtin_names, name of e) - 1) + ", [" + js_list(scope, args of e) + "], " + remember(at of e) + ")"
    end
end

# One function (or the whole program) as the body of a JavaScript function: its variables, the
# temporaries `and` and `or` used, then its statements.
to function_code with parent, params, body, place
    set scope to new_scope(parent, params, body, place)
    set statements to js_block(scope, body)
    set locals to empty list
    for each slot from length of params + 1 to length of names of scope # the inputs are the parameters
        add v(slot, level of scope) + " = UNSET" to locals
    end
    for each n from 1 to temps of scope
        add "$t" + n to locals
    end
    if length of locals is 0
        return record with scope scope, code statements
    end
    return record with scope scope, code "let " + joined(locals, ", ") + ";\n" + statements
end

# Moth source, and the files it may use (records with a name and a text); out come the JavaScript (for
# fromJs() in jit.js), the tokens its positions point at, and the names of the top-level variables, whose
# values the JavaScript returns.
to compile with source, files
    set ats to empty list
    set js_workers to no
    set reading to record with files files, loaded empty list, open empty list, within "", layout nothing, tight nothing
    set main to function_code(nothing, empty list, parse(tokenize(source, ""), reading), 0)
    set slots to empty list
    for each slot from 1 to length of names of scope of main
        add v(slot, 0) to slots
    end
    set swapping to "" # for a program that starts a worker: the program's variables, given, and others put in their place
    if js_workers
        set swapping to "function $globals($s) {\nconst $o = [" + joined(slots, ", ") + "];\nif ($s) [" + joined(slots, ", ") + "] = $s;\nreturn $o;\n}\n"
    end
    return record with js code of main + "\n" + swapping + "return [" + joined(slots, ", ") + "];", ats ats, names names of scope of main
end

# ---------- bytecode ----------

# The other back end: the bytecode moth.js's compiler makes for its virtual machine, as text. Instruction
# for instruction and constant for constant it is what that compiler makes; the Rust engine Moth had until
# 1.5 ran it too, so it could run Moth's compiler compiling itself, with no JavaScript anywhere.

# each instruction's number, in the order of OPCODES in vm.js
set op_get to 0
set op_set to 1
set op_const to 2
set op_jump to 3
set op_jump_if_false to 4
set op_compare to 5
set op_add to 6
set op_sub to 7
set op_mul to 8
set op_div to 9
set op_call to 10
set op_get_fn to 11
set op_return to 12
set op_pop to 13
set op_and to 14
set op_or to 15
set op_neg to 16
set op_not to 17
set op_list to 18
set op_length to 19
set op_item to 20
set op_item_ref to 21
set op_set_item to 22
set op_add_to to 23
set op_say to 24
set op_check_repeat to 25
set op_repeat_next to 26
set op_check_range to 27
set op_range_next to 28
set op_iter to 29
set op_iter_next to 30
set op_make_fn to 31
set op_undefined to 32
set op_halt to 33
set op_turtle to 35
set op_record to 36
set op_field to 37
set op_record_ref to 38
set op_set_field to 39
set op_fail to 40
set op_builtin to 41
set op_ask to 42
set op_try to 43
set op_end_try to 44
set op_caught to 45
set op_dict to 46
set op_remove to 47
set op_read to 48
set op_write to 49
set op_arguments to 50
set op_expect to 51
set op_random to 52
set op_handle to 53
set op_every to 54
set op_say_error to 55
set op_exit to 56
set op_remove_file to 57
set op_now to 58
set op_wait to 59
set op_read_folder to 60
set op_play to 61
set math_ops to list of op_add, op_sub, op_mul, op_div # for math_signs

# The function being compiled: its scope (as the JavaScript back end has it), its code, its constants,
# where each instruction came from, the loops around the code being compiled (innermost first), and the
# `try`s around it in this function.
to bytecode_function with outer, name, params, kinds, body, place
    set parent_scope to nothing
    if outer is not nothing
        set parent_scope to scope of outer
    end
    set fc to record with scope new_scope(parent_scope, params, body, place), name name, params params, kinds kinds, code empty list, consts empty list, places empty list, loops nothing, tries 0
    for each s in body
        bytecode_statement(fc, s)
    end
    if outer is nothing
        emit(fc, nothing, list of op_halt)
    else
        set k to constant(fc, record with what "nothing", value nothing)
        emit(fc, nothing, list of op_const, k, op_return)
    end
    return fc
end

# an instruction and its operands; where it came from is kept at its own place
to emit with fc, at, codes
    set code to code of fc
    set places to places of fc
    add at to places
    for each n from 2 to length of codes
        add nothing to places
    end
    for each c in codes
        add c to code
    end
end

to constant with fc, made
    set consts to consts of fc
    add made to consts
    return length of consts - 1
end

to text_constant with fc, text
    return constant(fc, record with what "text", value text)
end

to code_length with fc
    return length of code of fc
end

# a jump whose target comes later: where to put it, for patch
to jump with fc, at, op, target
    emit(fc, at, list of op, target)
    return code_length(fc) - 1
end

to patch with fc, i
    set item (i + 1) of code of fc to code_length(fc)
end

to undefined_code with fc, wanted, at, call, statement
    set message to undefined_message(scope of fc, wanted, call, statement)
    emit(fc, at, list of op_undefined, text_constant(fc, message))
end

to load with fc, wanted, at
    set found to resolve(scope of fc, wanted)
    if found is nothing
        undefined_code(fc, wanted, at, no, no)
    else
        emit(fc, at, list of op_get, depth of found, slot of found, text_constant(fc, wanted))
    end
end

to store with fc, wanted, at
    set found to resolve(scope of fc, wanted)
    emit(fc, at, list of op_set, depth of found, slot of found)
end

# a loop's body: `state` is how many values the loop keeps on the stack while it runs, which a `stop` takes off
to loop_statements with fc, body, state
    set loops of fc to record with state state, stops empty list, tries tries of fc, outer loops of fc
    for each s in body
        bytecode_statement(fc, s)
    end
end

to patch_stops with fc
    for each i in stops of loops of fc
        patch(fc, i)
    end
    set loops of fc to outer of loops of fc
end

to looped with fc, s, loop_name, next, state
    set top to code_length(fc)
    set exit to jump(fc, at of s, next, -1)
    if loop_name is not nothing
        store(fc, loop_name, at of s)
    end
    loop_statements(fc, body of s, state)
    jump(fc, at of s, op_jump, top)
    patch(fc, exit)
    patch_stops(fc)
end

to bytecode_call with fc, e, statement
    set found to resolve(scope of fc, name of e)
    if found is nothing
        undefined_code(fc, name of e, at of e, yes, statement)
    else
        emit(fc, at of e, list of op_get_fn, depth of found, slot of found, text_constant(fc, name of e))
    end
    for each arg in args of e
        bytecode_expr(fc, arg)
    end
    emit(fc, at of e, list of op_call, length of args of e, text_constant(fc, name of e))
end

to bytecode_child with fc, d
    set made to bytecode_function(fc, name of d, params of d, kinds of d, body of d, order of d)
    return constant(fc, record with what "function", value made)
end

to bytecode_statement with fc, s
    set what to kind of s
    if what is "set"
        bytecode_expr(fc, value of s)
        store(fc, name of s, at of s)
    else if what is "setItem"
        set target to target of s
        bytecode_expr(fc, subject of target)
        bytecode_expr(fc, index of target)
        emit(fc, at of target, list of op_item_ref)
        bytecode_expr(fc, value of s)
        emit(fc, at of target, list of op_set_item)
    else if what is "add"
        bytecode_expr(fc, value of s)
        set found to resolve(scope of fc, name of s)
        if found is nothing
            undefined_code(fc, name of s, at of s, no, no)
        else
            emit(fc, at of s, list of op_add_to, depth of found, slot of found, text_constant(fc, name of s))
        end
    else if what is "say"
        for each part in parts of s
            bytecode_expr(fc, part)
        end
        set say_op to op_say
        if errors of s
            set say_op to op_say_error
        end
        emit(fc, at of s, list of say_op, length of parts of s)
    else if what is "exit"
        if value of s is nothing
            emit(fc, at of s, list of op_const, constant(fc, record with what "number", value "0"))
        else
            bytecode_expr(fc, value of s)
        end
        emit(fc, at of s, list of op_exit)
    else if what is "if"
        bytecode_expr(fc, cond of s)
        set to_else to jump(fc, at of s, op_jump_if_false, -1)
        for each inner in then of s
            bytecode_statement(fc, inner)
        end
        set to_end to jump(fc, at of s, op_jump, -1)
        patch(fc, to_else)
        for each inner in otherwise of s
            bytecode_statement(fc, inner)
        end
        patch(fc, to_end)
    else if what is "while"
        set top to code_length(fc)
        bytecode_expr(fc, cond of s)
        set exit to jump(fc, at of s, op_jump_if_false, -1)
        loop_statements(fc, body of s, 0)
        jump(fc, at of s, op_jump, top)
        patch(fc, exit)
        patch_stops(fc)
    else if what is "repeat"
        bytecode_expr(fc, count of s)
        emit(fc, at of s, list of op_check_repeat)
        looped(fc, s, nothing, op_repeat_next, 1)
    else if what is "count"
        bytecode_expr(fc, start of s)
        bytecode_expr(fc, limit of s)
        emit(fc, at of s, list of op_check_range)
        looped(fc, s, name of s, op_range_next, 2)
    else if what is "each"
        bytecode_expr(fc, over of s)
        emit(fc, at of s, list of op_iter)
        looped(fc, s, name of s, op_iter_next, 1)
    else if what is "define"
        emit(fc, at of s, list of op_make_fn, bytecode_child(fc, s))
        store(fc, name of s, at of s)
    else if what is "when" and label of s is not nothing # the button or text box it waits for, under it
        set d to fn of s
        set made to bytecode_function(fc, name of d, params of d, kinds of d, body of d, order of d)
        bytecode_expr(fc, label of s)
        emit(fc, at of s, list of op_make_fn, constant(fc, record with what "function", value made))
        emit(fc, at of s, list of op_handle, slot_of(event_names, event of s) - 1)
    else if what is "when" # a handler is a function of its own, made and handed over, not kept in a variable
        emit(fc, at of s, list of op_make_fn, bytecode_child(fc, fn of s))
        emit(fc, at of s, list of op_handle, slot_of(event_names, event of s) - 1)
    else if what is "every"
        set d to fn of s
        set made to bytecode_function(fc, name of d, params of d, kinds of d, body of d, order of d)
        bytecode_expr(fc, interval of s)
        emit(fc, at of s, list of op_make_fn, constant(fc, record with what "function", value made))
        emit(fc, at of s, list of op_every, unit of s)
    else if what is "return"
        if value of s is nothing
            emit(fc, at of s, list of op_const, constant(fc, record with what "nothing", value nothing))
        else
            bytecode_expr(fc, value of s)
        end
        emit(fc, at of s, list of op_return)
    else if what is "call"
        bytecode_call(fc, s, yes)
        emit(fc, at of s, list of op_pop)
    else if what is "do" # a value done for what it does: `start count(10)`, `wait for job`
        bytecode_expr(fc, value of s)
        emit(fc, at of s, list of op_pop)
    else if what is "turtle"
        if value of s is not nothing
            bytecode_expr(fc, value of s)
        end
        emit(fc, at of s, list of op_turtle, slot_of(turtle_actions, action of s) - 1)
    else if what is "setField"
        bytecode_expr(fc, target of s)
        emit(fc, at of s, list of op_record_ref, text_constant(fc, name of s))
        bytecode_expr(fc, value of s)
        emit(fc, at of s, list of op_set_field, text_constant(fc, name of s))
    else if what is "fail"
        bytecode_expr(fc, value of s)
        emit(fc, at of s, list of op_fail)
    else if what is "remove"
        bytecode_expr(fc, key of s)
        bytecode_expr(fc, target of s)
        emit(fc, at of s, list of op_remove)
    else if what is "write"
        bytecode_expr(fc, value of s)
        bytecode_expr(fc, target of s)
        emit(fc, at of s, list of op_write)
    else if what is "removeFile"
        bytecode_expr(fc, target of s)
        emit(fc, at of s, list of op_remove_file)
    else if what is "wait"
        bytecode_expr(fc, amount of s)
        emit(fc, at of s, list of op_wait, unit of s)
    else if what is "play" # the note, then how long, unless it's a beep
        if note of s is not nothing
            bytecode_expr(fc, note of s)
            bytecode_expr(fc, time of s)
        end
        emit(fc, at of s, list of op_play, unit of s)
    else if what is "expect" # a comparison keeps both its sides, to say what they were
        set c to cond of s
        if kind of c is "compare"
            bytecode_expr(fc, left of c)
            bytecode_expr(fc, right of c)
            set negated to 0
            if negate of c
                set negated to 1
            end
            emit(fc, at of s, list of op_expect, slot_of(comparisons, op of c) - 1, negated)
        else
            bytecode_expr(fc, c)
            emit(fc, at of s, list of op_expect, -1, 0)
        end
    else if what is "try"
        set to_handler to jump(fc, at of s, op_try, -1)
        set tries of fc to tries of fc + 1
        for each inner in body of s
            bytecode_statement(fc, inner)
        end
        set tries of fc to tries of fc - 1
        emit(fc, at of s, list of op_end_try)
        set to_end to jump(fc, at of s, op_jump, -1)
        patch(fc, to_handler)
        emit(fc, at of s, list of op_caught)
        if name of s is not nothing
            store(fc, name of s, at of s)
        else
            emit(fc, at of s, list of op_pop)
        end
        for each inner in handler of s
            bytecode_statement(fc, inner)
        end
        patch(fc, to_end)
    else if what is "stop" # leave the tries inside the loop, take its own values off the stack, and jump to its end
        set innermost to loops of fc
        for each n from tries of innermost to tries of fc - 1
            emit(fc, at of s, list of op_end_try)
        end
        repeat state of innermost times
            emit(fc, at of s, list of op_pop)
        end
        set stops to stops of innermost
        add jump(fc, at of s, op_jump, -1) to stops
    end
end

to bytecode_list with fc, nodes
    for each node in nodes
        bytecode_expr(fc, node)
    end
end

to bytecode_expr with fc, e
    set what to kind of e
    if what is "value"
        set literal to record with what type of e, value nothing
        if type of e is "number"
            set value of literal to value of e # as written, so it reads back exactly
        else if type of e is "string"
            set what of literal to "text"
            set value of literal to value of e
        end
        emit(fc, at of e, list of op_const, constant(fc, literal))
    else if what is "name"
        load(fc, name of e, at of e)
    else if what is "call"
        bytecode_call(fc, e, no)
    else if what is "math"
        bytecode_expr(fc, left of e)
        bytecode_expr(fc, right of e)
        emit(fc, at of e, list of look_up(op of e, math_signs, math_ops))
    else if what is "compare"
        bytecode_expr(fc, left of e)
        bytecode_expr(fc, right of e)
        emit(fc, at of e, list of op_compare, slot_of(comparisons, op of e) - 1)
        if negate of e
            emit(fc, at of e, list of op_not)
        end
    else if what is "and" or what is "or"
        bytecode_expr(fc, left of e)
        set op to op_or
        if what is "and"
            set op to op_and
        end
        set to_end to jump(fc, at of e, op, -1)
        bytecode_expr(fc, right of e)
        patch(fc, to_end)
    else if what is "not"
        bytecode_expr(fc, operand of e)
        emit(fc, at of e, list of op_not)
    else if what is "negate"
        bytecode_expr(fc, operand of e)
        emit(fc, at of e, list of op_neg)
    else if what is "list"
        bytecode_list(fc, items of e)
        emit(fc, at of e, list of op_list, length of items of e)
    else if what is "length"
        bytecode_expr(fc, subject of e)
        emit(fc, at of e, list of op_length)
    else if what is "item"
        bytecode_expr(fc, subject of e)
        bytecode_expr(fc, index of e)
        emit(fc, at of e, list of op_item)
    else if what is "record"
        bytecode_list(fc, values of e)
        emit(fc, at of e, list of op_record, constant(fc, record with what "fields", value fields of e))
    else if what is "dictionary"
        bytecode_list(fc, items of e)
        emit(fc, at of e, list of op_dict, length of items of e)
    else if what is "field"
        bytecode_expr(fc, subject of e)
        emit(fc, at of e, list of op_field, text_constant(fc, name of e))
    else if what is "ask"
        bytecode_expr(fc, question of e)
        emit(fc, at of e, list of op_ask)
    else if what is "read"
        bytecode_expr(fc, subject of e)
        set flag to 0
        if binary of e
            set flag to 1
        end
        emit(fc, at of e, list of op_read, flag)
    else if what is "readFolder"
        bytecode_expr(fc, subject of e)
        emit(fc, at of e, list of op_read_folder)
    else if what is "arguments"
        emit(fc, at of e, list of op_arguments)
    else if what is "random"
        bytecode_expr(fc, left of e)
        bytecode_expr(fc, right of e)
        emit(fc, at of e, list of op_random)
    else if what is "now"
        emit(fc, at of e, list of op_now, which of e)
    else if what is "builtin"
        bytecode_list(fc, args of e)
        emit(fc, at of e, list of op_builtin, slot_of(builtin_names, name of e) - 1)
    end
end

# where an instruction came from, as the text has it: line:col, line:col:"file", or - for nowhere
to place_text with at
    if at is nothing
        return "-"
    end
    if file of at is ""
        return "" + line of at + ":" + col of at
    end
    return "" + line of at + ":" + col of at + ":" + quote(file of at)
end

# a line of the text: a word, then each piece after a space
to text_line with head, pieces
    set out to head
    for each piece in pieces
        add " " + piece to out
    end
    return out
end

to function_lines with fc, lines
    add "function " + quote(name of fc) to lines
    set quoted to empty list
    for each p in params of fc
        add quote(p) to quoted
    end
    add text_line("params", quoted) to lines
    set quoted to empty list # what each input says it is, -1 for one that doesn't
    set i to 0
    for each p in params of fc
        add 1 to i
        set k to -1
        if i is at most length of kinds of fc
            set k to item i of kinds of fc
        end
        add "" + k to quoted
    end
    add text_line("kinds", quoted) to lines
    set quoted to empty list
    for each n in names of scope of fc
        add quote(n) to quoted
    end
    add text_line("names", quoted) to lines
    add text_line("code", code of fc) to lines
    set where to empty list
    for each at in places of fc
        add place_text(at) to where
    end
    add text_line("at", where) to lines
    for each c in consts of fc
        set made to what of c
        if made is "number"
            add "const number " + value of c to lines
        else if made is "text"
            add "const text " + quote(value of c) to lines
        else if made is "fields"
            set quoted to empty list
            for each f in value of c
                add quote(f) to quoted
            end
            add text_line("const fields", quoted) to lines
        else if made is "function"
            add "const function" to lines
            function_lines(value of c, lines)
        else
            add "const " + made to lines # nothing, yes or no
        end
    end
    add "end" to lines
end

# Moth source, and the files it may use (records with a name and a text); out comes its bytecode, as text
to compile_bytecode with source, files
    set reading to record with files files, loaded empty list, open empty list, within "", layout nothing, tight nothing
    set main to bytecode_function(nothing, "main", empty list, empty list, parse(tokenize(source, ""), reading), 0)
    set lines to list of "moth bytecode 2"
    function_lines(main, lines)
    return joined(lines, "\n") + "\n"
end
