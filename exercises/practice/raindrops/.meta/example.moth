to convert with n
    set sounds to ""
    if n is divisible by 3
        add "Pling" to sounds
    end
    if n is divisible by 5
        add "Plang" to sounds
    end
    if n is divisible by 7
        add "Plong" to sounds
    end
    if sounds is ""
        return "" + n
    end
    return sounds
end
