# clock's tests, from Exercism's problem-specifications (canonical-data.json, MIT): run them with
# `moth test clock.test.moth`

use "clock.moth" as clock

to test_create_a_new_clock_with_an_initial_time_on_the_hour
    expect "{clock's create(8, 0)}" is "08:00"
end

to test_create_a_new_clock_with_an_initial_time_past_the_hour
    expect "{clock's create(11, 9)}" is "11:09"
end

to test_create_a_new_clock_with_an_initial_time_midnight_is_zero_hours
    expect "{clock's create(24, 0)}" is "00:00"
end

to test_create_a_new_clock_with_an_initial_time_hour_rolls_over
    expect "{clock's create(25, 0)}" is "01:00"
end

to test_create_a_new_clock_with_an_initial_time_hour_rolls_over_continuously
    expect "{clock's create(100, 0)}" is "04:00"
end

to test_create_a_new_clock_with_an_initial_time_sixty_minutes_is_next_hour
    expect "{clock's create(1, 60)}" is "02:00"
end

to test_create_a_new_clock_with_an_initial_time_minutes_roll_over
    expect "{clock's create(0, 160)}" is "02:40"
end

to test_create_a_new_clock_with_an_initial_time_minutes_roll_over_continuously
    expect "{clock's create(0, 1723)}" is "04:43"
end

to test_create_a_new_clock_with_an_initial_time_hour_and_minutes_roll_over
    expect "{clock's create(25, 160)}" is "03:40"
end

to test_create_a_new_clock_with_an_initial_time_hour_and_minutes_roll_over_continuously
    expect "{clock's create(201, 3001)}" is "11:01"
end

to test_create_a_new_clock_with_an_initial_time_hour_and_minutes_roll_over_to_exactly_midnight
    expect "{clock's create(72, 8640)}" is "00:00"
end

to test_create_a_new_clock_with_an_initial_time_negative_hour
    expect "{clock's create(-1, 15)}" is "23:15"
end

to test_create_a_new_clock_with_an_initial_time_negative_hour_rolls_over
    expect "{clock's create(-25, 0)}" is "23:00"
end

to test_create_a_new_clock_with_an_initial_time_negative_hour_rolls_over_continuously
    expect "{clock's create(-91, 0)}" is "05:00"
end

to test_create_a_new_clock_with_an_initial_time_negative_minutes
    expect "{clock's create(1, -40)}" is "00:20"
end

to test_create_a_new_clock_with_an_initial_time_negative_minutes_roll_over
    expect "{clock's create(1, -160)}" is "22:20"
end

to test_create_a_new_clock_with_an_initial_time_negative_minutes_roll_over_continuously
    expect "{clock's create(1, -4820)}" is "16:40"
end

to test_create_a_new_clock_with_an_initial_time_negative_sixty_minutes_is_previous_hour
    expect "{clock's create(2, -60)}" is "01:00"
end

to test_create_a_new_clock_with_an_initial_time_negative_hour_and_minutes_both_roll_over
    expect "{clock's create(-25, -160)}" is "20:20"
end

to test_create_a_new_clock_with_an_initial_time_negative_hour_and_minutes_both_roll_over_continuously
    expect "{clock's create(-121, -5810)}" is "22:10"
end

to test_add_minutes_add_minutes
    expect "{clock's add_minutes(clock's create(10, 0), 3)}" is "10:03"
end

to test_add_minutes_add_no_minutes
    expect "{clock's add_minutes(clock's create(6, 41), 0)}" is "06:41"
end

to test_add_minutes_add_to_next_hour
    expect "{clock's add_minutes(clock's create(0, 45), 40)}" is "01:25"
end

to test_add_minutes_add_more_than_one_hour
    expect "{clock's add_minutes(clock's create(10, 0), 61)}" is "11:01"
end

to test_add_minutes_add_more_than_two_hours_with_carry
    expect "{clock's add_minutes(clock's create(0, 45), 160)}" is "03:25"
end

to test_add_minutes_add_across_midnight
    expect "{clock's add_minutes(clock's create(23, 59), 2)}" is "00:01"
end

to test_add_minutes_add_more_than_one_day_1500_min_25_hrs
    expect "{clock's add_minutes(clock's create(5, 32), 1500)}" is "06:32"
end

to test_add_minutes_add_more_than_two_days
    expect "{clock's add_minutes(clock's create(1, 1), 3500)}" is "11:21"
end

to test_subtract_minutes_subtract_minutes
    expect "{clock's subtract_minutes(clock's create(10, 3), 3)}" is "10:00"
end

to test_subtract_minutes_subtract_to_previous_hour
    expect "{clock's subtract_minutes(clock's create(10, 3), 30)}" is "09:33"
end

to test_subtract_minutes_subtract_more_than_an_hour
    expect "{clock's subtract_minutes(clock's create(10, 3), 70)}" is "08:53"
end

to test_subtract_minutes_subtract_across_midnight
    expect "{clock's subtract_minutes(clock's create(0, 3), 4)}" is "23:59"
end

to test_subtract_minutes_subtract_more_than_two_hours
    expect "{clock's subtract_minutes(clock's create(0, 0), 160)}" is "21:20"
end

to test_subtract_minutes_subtract_more_than_two_hours_with_borrow
    expect "{clock's subtract_minutes(clock's create(6, 15), 160)}" is "03:35"
end

to test_subtract_minutes_subtract_more_than_one_day_1500_min_25_hrs
    expect "{clock's subtract_minutes(clock's create(5, 32), 1500)}" is "04:32"
end

to test_subtract_minutes_subtract_more_than_two_days
    expect "{clock's subtract_minutes(clock's create(2, 20), 3000)}" is "00:20"
end

to test_compare_two_clocks_for_equality_clocks_with_same_time
    expect clock's equal(clock's create(15, 37), clock's create(15, 37))
end

to test_compare_two_clocks_for_equality_clocks_a_minute_apart
    expect not clock's equal(clock's create(15, 36), clock's create(15, 37))
end

to test_compare_two_clocks_for_equality_clocks_an_hour_apart
    expect not clock's equal(clock's create(14, 37), clock's create(15, 37))
end

to test_compare_two_clocks_for_equality_clocks_with_hour_overflow
    expect clock's equal(clock's create(10, 37), clock's create(34, 37))
end

to test_compare_two_clocks_for_equality_clocks_with_hour_overflow_by_several_days
    expect clock's equal(clock's create(3, 11), clock's create(99, 11))
end

to test_compare_two_clocks_for_equality_clocks_with_negative_hour
    expect clock's equal(clock's create(22, 40), clock's create(-2, 40))
end

to test_compare_two_clocks_for_equality_clocks_with_negative_hour_that_wraps
    expect clock's equal(clock's create(17, 3), clock's create(-31, 3))
end

to test_compare_two_clocks_for_equality_clocks_with_negative_hour_that_wraps_multiple_times
    expect clock's equal(clock's create(13, 49), clock's create(-83, 49))
end

to test_compare_two_clocks_for_equality_clocks_with_minute_overflow
    expect clock's equal(clock's create(0, 1), clock's create(0, 1441))
end

to test_compare_two_clocks_for_equality_clocks_with_minute_overflow_by_several_days
    expect clock's equal(clock's create(2, 2), clock's create(2, 4322))
end

to test_compare_two_clocks_for_equality_clocks_with_negative_minute
    expect clock's equal(clock's create(2, 40), clock's create(3, -20))
end

to test_compare_two_clocks_for_equality_clocks_with_negative_minute_that_wraps
    expect clock's equal(clock's create(4, 10), clock's create(5, -1490))
end

to test_compare_two_clocks_for_equality_clocks_with_negative_minute_that_wraps_multiple_times
    expect clock's equal(clock's create(6, 15), clock's create(6, -4305))
end

to test_compare_two_clocks_for_equality_clocks_with_negative_hours_and_minutes
    expect clock's equal(clock's create(7, 32), clock's create(-12, -268))
end

to test_compare_two_clocks_for_equality_clocks_with_negative_hours_and_minutes_that_wrap
    expect clock's equal(clock's create(18, 7), clock's create(-54, -11513))
end

to test_compare_two_clocks_for_equality_full_clock_and_zeroed_clock
    expect clock's equal(clock's create(24, 0), clock's create(0, 0))
end
