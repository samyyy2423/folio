use "clock.folio" as exercise

to test_on_the_hour
    expect exercise's clock_at(8, 0) is "08:00"
end

to test_past_the_hour
    expect exercise's clock_at(11, 9) is "11:09"
end

to test_midnight_is_zero
    expect exercise's clock_at(24, 0) is "00:00"
end

to test_hours_and_minutes_roll_over
    expect exercise's clock_at(25, 160) is "03:40"
end

to test_less_than_zero
    expect exercise's clock_at(1, -40) is "00:20"
    expect exercise's clock_at(-25, -160) is "20:20"
end

to test_adding_and_taking
    expect exercise's plus_minutes(10, 0, 3) is "10:03"
    expect exercise's plus_minutes(23, 59, 2) is "00:01"
    expect exercise's plus_minutes(0, 3, -4) is "23:59"
end
