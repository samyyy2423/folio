# armstrong-numbers's tests, from Exercism's problem-specifications (canonical-data.json, MIT): run them with
# `moth test armstrong_numbers.test.moth`

use "armstrong_numbers.moth" as armstrong_numbers

to test_zero_is_an_armstrong_number
    expect armstrong_numbers's is_armstrong_number(0)
end

to test_single_digit_numbers_are_armstrong_numbers
    expect armstrong_numbers's is_armstrong_number(5)
end

to test_there_are_no_two_digit_armstrong_numbers
    expect not armstrong_numbers's is_armstrong_number(10)
end

to test_three_digit_number_that_is_an_armstrong_number
    expect armstrong_numbers's is_armstrong_number(153)
end

to test_three_digit_number_that_is_not_an_armstrong_number
    expect not armstrong_numbers's is_armstrong_number(100)
end

to test_four_digit_number_that_is_an_armstrong_number
    expect armstrong_numbers's is_armstrong_number(9474)
end

to test_four_digit_number_that_is_not_an_armstrong_number
    expect not armstrong_numbers's is_armstrong_number(9475)
end

to test_seven_digit_number_that_is_an_armstrong_number
    expect armstrong_numbers's is_armstrong_number(9926315)
end

to test_seven_digit_number_that_is_not_an_armstrong_number
    expect not armstrong_numbers's is_armstrong_number(9926314)
end
