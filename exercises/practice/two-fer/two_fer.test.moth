# two-fer's tests, from Exercism's problem-specifications (canonical-data.json, MIT): run them with
# `moth test two_fer.test.moth`

use "two_fer.moth" as two_fer

to test_no_name_given
    expect two_fer's two_fer() is "One for you, one for me."
end

to test_a_name_given
    expect two_fer's two_fer("Alice") is "One for Alice, one for me."
end

to test_another_name_given
    expect two_fer's two_fer("Bob") is "One for Bob, one for me."
end
