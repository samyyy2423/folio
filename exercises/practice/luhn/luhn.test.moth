# luhn's tests, from Exercism's problem-specifications (canonical-data.json, MIT): run them with
# `moth test luhn.test.moth`

use "luhn.moth" as luhn

to test_single_digit_strings_can_not_be_valid
    expect not luhn's valid("1")
end

to test_a_single_zero_is_invalid
    expect not luhn's valid("0")
end

to test_a_simple_valid_sin_that_remains_valid_if_reversed
    expect luhn's valid("059")
end

to test_a_simple_valid_sin_that_becomes_invalid_if_reversed
    expect luhn's valid("59")
end

to test_a_valid_canadian_sin
    expect luhn's valid("055 444 285")
end

to test_invalid_canadian_sin
    expect not luhn's valid("055 444 286")
end

to test_invalid_credit_card
    expect not luhn's valid("8273 1232 7352 0569")
end

to test_invalid_long_number_with_an_even_remainder
    expect not luhn's valid("1 2345 6789 1234 5678 9012")
end

to test_invalid_long_number_with_a_remainder_divisible_by_5
    expect not luhn's valid("1 2345 6789 1234 5678 9013")
end

to test_valid_number_with_an_even_number_of_digits
    expect luhn's valid("095 245 88")
end

to test_valid_number_with_an_odd_number_of_spaces
    expect luhn's valid("234 567 891 234")
end

to test_valid_strings_with_a_non_digit_added_at_the_end_become_invalid
    expect not luhn's valid("059a")
end

to test_valid_strings_with_punctuation_included_become_invalid
    expect not luhn's valid("055-444-285")
end

to test_valid_strings_with_symbols_included_become_invalid
    expect not luhn's valid("055# 444$ 285")
end

to test_single_zero_with_space_is_invalid
    expect not luhn's valid(" 0")
end

to test_more_than_a_single_zero_is_valid
    expect luhn's valid("0000 0")
end

to test_input_digit_9_is_correctly_converted_to_output_digit_9
    expect luhn's valid("091")
end

to test_very_long_input_is_valid
    expect luhn's valid("9999999999 9999999999 9999999999 9999999999")
end

to test_valid_luhn_with_an_odd_number_of_digits_and_non_zero_first_digit
    expect luhn's valid("109")
end

to test_using_ascii_value_for_non_doubled_non_digit_isn_t_allowed
    expect not luhn's valid("055b 444 285")
end

to test_using_ascii_value_for_doubled_non_digit_isn_t_allowed
    expect not luhn's valid(":9")
end

to test_non_numeric_non_space_char_in_the_middle_with_a_sum_that_s_divisible_by_10_isn_t_allowed
    expect not luhn's valid("59%59")
end
