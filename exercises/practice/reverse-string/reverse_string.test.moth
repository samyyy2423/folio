# reverse-string's tests, from Exercism's problem-specifications (canonical-data.json, MIT): run them with
# `moth test reverse_string.test.moth`

use "reverse_string.moth" as reverse_string

to test_an_empty_string
    expect reverse_string's reverse("") is ""
end

to test_a_word
    expect reverse_string's reverse("robot") is "tobor"
end

to test_a_capitalized_word
    expect reverse_string's reverse("Ramen") is "nemaR"
end

to test_a_sentence_with_punctuation
    expect reverse_string's reverse("I'm hungry!") is "!yrgnuh m'I"
end

to test_a_palindrome
    expect reverse_string's reverse("racecar") is "racecar"
end

to test_an_even_sized_word
    expect reverse_string's reverse("drawer") is "reward"
end

to test_wide_characters
    expect reverse_string's reverse("子猫") is "猫子"
end
