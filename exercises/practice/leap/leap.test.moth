# leap's tests, from Exercism's problem-specifications (canonical-data.json, MIT): run them with
# `moth test leap.test.moth`

use "leap.moth" as leap

to test_year_not_divisible_by_4_in_common_year
    expect not leap's leap_year(2015)
end

to test_year_divisible_by_2_not_divisible_by_4_in_common_year
    expect not leap's leap_year(1970)
end

to test_year_divisible_by_4_not_divisible_by_100_in_leap_year
    expect leap's leap_year(1996)
end

to test_year_divisible_by_4_and_5_is_still_a_leap_year
    expect leap's leap_year(1960)
end

to test_year_divisible_by_100_not_divisible_by_400_in_common_year
    expect not leap's leap_year(2100)
end

to test_year_divisible_by_100_but_not_by_3_is_still_not_a_leap_year
    expect not leap's leap_year(1900)
end

to test_year_divisible_by_400_is_leap_year
    expect leap's leap_year(2000)
end

to test_year_divisible_by_400_but_not_by_125_is_still_a_leap_year
    expect leap's leap_year(2400)
end

to test_year_divisible_by_200_not_divisible_by_400_in_common_year
    expect not leap's leap_year(1800)
end
