to steps with n
    if n is at most 0
        fail with "only positive whole numbers are allowed"
    end
    set count to 0
    repeat while n is not 1
        if n is divisible by 2
            set n to n / 2
        else
            set n to 3 * n + 1
        end
        add 1 to count
    end
    return count
end
