use "collatz_conjecture.folio" as exercise

to test_one
    expect exercise's steps(1) is 0
end

to test_even_and_odd
    expect exercise's steps(12) is 9
end

to test_large
    expect exercise's steps(1000000) is 152
end

to test_zero
    try
        exercise's steps(0)
        expect no
    if it fails with why
        expect why is "only positive whole numbers are allowed"
    end
end
