# matching-brackets's tests, from Exercism's problem-specifications (canonical-data.json, MIT): run them with
# `moth test matching_brackets.test.moth`

use "matching_brackets.moth" as matching_brackets

to test_paired_square_brackets
    expect matching_brackets's is_paired("[]")
end

to test_empty_string
    expect matching_brackets's is_paired("")
end

to test_unpaired_brackets
    expect not matching_brackets's is_paired("[[")
end

to test_wrong_ordered_brackets
    expect not matching_brackets's is_paired("}\{")
end

to test_wrong_closing_bracket
    expect not matching_brackets's is_paired("\{]")
end

to test_paired_with_whitespace
    expect matching_brackets's is_paired("\{ }")
end

to test_partially_paired_brackets
    expect not matching_brackets's is_paired("\{[])")
end

to test_simple_nested_brackets
    expect matching_brackets's is_paired("\{[]}")
end

to test_several_paired_brackets
    expect matching_brackets's is_paired("\{}[]")
end

to test_paired_and_nested_brackets
    expect matching_brackets's is_paired("([\{}(\{}[])])")
end

to test_unopened_closing_brackets
    expect not matching_brackets's is_paired("\{[)][]}")
end

to test_unpaired_and_nested_brackets
    expect not matching_brackets's is_paired("([\{])")
end

to test_paired_and_wrong_nested_brackets
    expect not matching_brackets's is_paired("[(\{]})")
end

to test_paired_and_wrong_nested_brackets_but_innermost_are_correct
    expect not matching_brackets's is_paired("[(\{}])")
end

to test_paired_and_incomplete_brackets
    expect not matching_brackets's is_paired("\{}[")
end

to test_too_many_closing_brackets
    expect not matching_brackets's is_paired("[]]")
end

to test_early_unexpected_brackets
    expect not matching_brackets's is_paired(")()")
end

to test_early_mismatched_brackets
    expect not matching_brackets's is_paired("\{)()")
end

to test_math_expression
    expect matching_brackets's is_paired("(((185 + 223.85) * 15) - 543)/2")
end

to test_complex_latex_expression
    expect matching_brackets's is_paired("\\left(\\begin\{array}\{cc} \\frac\{1}\{3} & x\\\\ \\mathrm\{e}^\{x} &... x^2 \\end\{array}\\right)")
end
