  "key_features": [
    {
      "title": "Reads like English",
      "content": "Programs say what they do: set, say, for each, repeat while, to ... with.",
      "icon": "easy"
    },
    {
      "title": "Fast",
      "content": "moth build compiles to machine code for Windows and Linux, as fast as C.",
      "icon": "fast"
    },
    {
      "title": "No dependencies",
      "content": "One program, with a standard library from JSON to web servers built in.",
      "icon": "batteries-included"
    },
    {
      "title": "Clear mistakes",
      "content": "Every error says what went wrong, where, in plain words.",
      "icon": "helpful"
    },
    {
      "title": "Tested",
      "content": "Tests are functions, expect says what should be so, and moth test runs them.",
      "icon": "safe"
    },
    {
      "title": "Everywhere",
      "content": "The same program runs in the browser's playground and as a native program.",
      "icon": "cross-platform"
    }
