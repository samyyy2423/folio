# Teaches the digit reader in digits.folio, from digits it draws itself, and says what it learned as Folio:
#
#     folio build digits-train.folio
#     digits-train > digits-model.folio
#
# It draws a digit (digit-shapes.folio), reads it, and corrects itself, 400,000 times, and never sees the
# same drawing twice. Its progress comes out as lines starting with #, so the whole output is a Folio file.

use "math.folio"
use "digits.folio"
use "digit-shapes.folio"

set lessons to 400000 # drawings to learn from
set first_rate to 0.02 # how big a step each correction takes, at first
set last_rate to 0.002 # and at the end

# a picture to learn from: one way of writing a digit, bent at random, drawn with a random pen
to example with digit
    set way to whole(random() * ways_of(digit)) + 1
    set drawn to picture_of(bent(digit, way), between(1.1, 1.7))
    return record with digit digit, pixels drawn, inked inked_of(drawn)
end

to random_weights with count, size
    set made to empty list
    repeat count times
        add between(0 - size, size) to made
    end
    return made
end

to zeros with count
    set made to empty list
    repeat count times
        add 0 to made
    end
    return made
end

# One step of learning from one picture: work out the chances, then move every weight a little against
# its share of the error (backpropagation). Says whether the guess was right before the step.
to learn with weights, ex, rate
    set pixels to pixels of ex
    set found to strongest(matched(pixels, inked of ex, weights))
    set values to values of found
    set lit to lit of found
    set hidden to hidden_from(values, lit, weights)
    set chances to chances_for_hidden(hidden, weights)
    set right to likeliest(chances) is digit of ex

    # the ten answers: each one's error is its chance, less 1 for the right one
    set ow to output_weights of weights
    set ob to output_bias of weights
    set hidden_blame to zeros(hidden_size)
    for each d from 1 to 10
        set g to item d of chances
        if d - 1 is digit of ex
            set g to g - 1
        end
        set row to (d - 1) * hidden_size
        for each j from 1 to hidden_size
            set item j of hidden_blame to item j of hidden_blame + g * item (row + j) of ow
            set item (row + j) of ow to item (row + j) of ow - rate * g * item j of hidden
        end
        set item d of ob to item d of ob - rate * g
    end

    # the hidden neurons: one that didn't fire changed nothing
    set hw to hidden_weights of weights
    set hb to hidden_bias of weights
    set blame to zeros(features)
    for each j from 1 to hidden_size
        if item j of hidden is greater than 0
            set g to item j of hidden_blame
            set item j of hb to item j of hb - rate * g
            set row to (j - 1) * features
            for each k in lit
                set item k of blame to item k of blame + g * item (row + k) of hw
                set item (row + k) of hw to item (row + k) of hw - rate * g * item k of values
            end
        end
    end

    # the patterns: only the place that was the strongest of its four is to blame, for the pixels under it
    set pw to pattern_weights of weights
    set pb to pattern_bias of weights
    for each k in lit
        set g to item k of blame
        set place to item k of (from of found) - 1
        set f to floor(place / (places * places))
        set place to place - f * places * places
        set top to floor(place / places)
        set left to place - top * places
        set item (f + 1) of pb to item (f + 1) of pb - rate * g
        for each down from 0 to patch - 1
            for each across from 0 to patch - 1
                set ink_here to item ((top + down) * side + left + across + 1) of pixels
                if ink_here is greater than 0
                    set spot to f * patch * patch + down * patch + across + 1
                    set item spot of pw to item spot of pw - rate * g * ink_here
                end
            end
        end
    end
    return right
end

# a list as a line of Folio, each number to 4 decimals
to say_list with label, numbers
    set text to ""
    for each v in numbers
        if text is not ""
            add ", " to text
        end
        add floor(v * 10000 + 0.5) / 10000 to text
    end
    say "set " label " to list of " text
end

to teach
    say "# Weights for the digit reader in digits.folio, learned by digits-train.folio."
    set weights to record with pattern_weights random_weights(patterns * patch * patch, sqrt(6 / (patch * patch + patterns * patch * patch / 4))),
        pattern_bias zeros(patterns),
        hidden_weights random_weights(features * hidden_size, sqrt(6 / (features + hidden_size))), hidden_bias zeros(hidden_size),
        output_weights random_weights(10 * hidden_size, sqrt(6 / (hidden_size + 10))), output_bias zeros(10)
    set right to 0
    set stretch to lessons / 10 # it says how it's doing ten times
    for each lesson from 1 to lessons
        set rate to first_rate + (last_rate - first_rate) * (lesson - 1) / lessons
        if learn(weights, example(whole(random() * 10)), rate)
            add 1 to right
        end
        if lesson is divisible by stretch
            say "# after " lesson " drawings: " whole(right / stretch * 100 + 0.5) "% of the last " stretch " right, before learning from each"
            set right to 0
        end
    end
    say_list("model_pattern_weights", pattern_weights of weights)
    say_list("model_pattern_bias", pattern_bias of weights)
    say_list("model_hidden_weights", hidden_weights of weights)
    say_list("model_hidden_bias", hidden_bias of weights)
    say_list("model_output_weights", output_weights of weights)
    say_list("model_output_bias", output_bias of weights)
    say "set model to record with pattern_weights model_pattern_weights, pattern_bias model_pattern_bias, hidden_weights model_hidden_weights, hidden_bias model_hidden_bias, output_weights model_output_weights, output_bias model_output_bias"
end

teach
