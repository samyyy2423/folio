{
  "name": "folio",
  "displayName": "Folio",
  "description": "Folio, the programming language that reads like plain English: colours, problems as you type, Format Document, the outline, Go to Definition, hovers, completion, a debugger, and Run and Build",
  "version": "0.1.0",
  "publisher": "samyyy2423",
  "license": "Apache-2.0",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#120e0a",
    "theme": "dark"
  },
  "homepage": "https://samyyy2423.github.io/folio/",
  "bugs": {
    "url": "https://github.com/samyyy2423/folio/issues"
  },
  "qna": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/samyyy2423/folio",
    "directory": "editors/vscode"
  },
  "keywords": [
    "folio",
    "plain english",
    "english",
    "beginners",
    "learn to code",
    "teaching",
    "language server",
    "lsp",
    "debugger",
    "formatter",
    "native",
    "compiler"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Formatters",
    "Linters",
    "Snippets",
    "Education"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a folder you haven't trusted, the extension uses the folio.path from your own settings, not the folder's, so opening a folder can't choose a program for it to run.",
      "restrictedConfigurations": [
        "folio.path"
      ]
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:folio",
    "onDebugResolve:folio"
  ],
  "contributes": {
    "languages": [
      {
        "id": "folio",
        "aliases": [
          "Folio",
          "folio"
        ],
        "extensions": [
          ".folio"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "folio",
        "scopeName": "source.folio",
        "path": "./syntaxes/folio.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "folio",
        "path": "./snippets/folio.json"
      }
    ],
    "commands": [
      {
        "command": "folio.run",
        "title": "Run this file",
        "category": "Folio"
      },
      {
        "command": "folio.debug",
        "title": "Debug this file",
        "category": "Folio"
      },
      {
        "command": "folio.build",
        "title": "Build this file",
        "category": "Folio"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "folio.run",
          "when": "resourceLangId == folio"
        },
        {
          "command": "folio.debug",
          "when": "resourceLangId == folio"
        }
      ],
      "commandPalette": [
        {
          "command": "folio.run",
          "when": "editorLangId == folio"
        },
        {
          "command": "folio.debug",
          "when": "editorLangId == folio"
        },
        {
          "command": "folio.build",
          "when": "editorLangId == folio"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "folio",
        "required": [
          "command",
          "file"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "run",
              "build"
            ],
            "description": "folio run or folio build."
          },
          "file": {
            "type": "string",
            "description": "The Folio file, from the workspace's folder."
          }
        }
      }
    ],
    "configuration": {
      "title": "Folio",
      "properties": {
        "folio.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where `folio`, Folio's command line, is: the path to `folio.exe` on Windows or `folio` on Linux, or to the folder it's in. Leave it empty to use the `folio` on your PATH. Run, Build, the debugger and the language server all use it."
        },
        "folio.languageServer": {
          "type": "boolean",
          "default": true,
          "description": "Start Folio's language server (folio lsp) for the outline, Go to Definition in the file and the files it uses, hovers and completion. Without it, the outline and Go to Definition find the file's functions by their lines."
        }
      }
    },
    "breakpoints": [
      {
        "language": "folio"
      }
    ],
    "debuggers": [
      {
        "type": "folio",
        "label": "Folio",
        "languages": [
          "folio"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The Folio file to debug.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The program's arguments.",
                "default": []
              },
              "allow": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "What it may do without asking: --allow-read, --allow-write, --allow-net, --allow-run, --allow-libraries or --allow-all.",
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop before the first line runs.",
                "default": false
              },
              "folioPath": {
                "type": "string",
                "description": "The folio to debug with, if it isn't the one folio.path or the PATH has."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "folio",
            "request": "launch",
            "name": "Debug this file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Folio: Debug a file",
            "description": "Debug a Folio program",
            "body": {
              "type": "folio",
              "request": "launch",
              "name": "Debug ${1:program}",
              "program": "^\"\\${workspaceFolder}/${1:program}.folio\""
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node make-vsix.mjs --engine"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "ovsx": "1.3.0"
  }
}
