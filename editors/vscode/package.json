{
  "name": "moth",
  "displayName": "Moth",
  "description": "Moth, the programming language that reads like plain English: colours, problems as you type, Format Document, the outline, Go to Definition, hovers, completion, a debugger, and Run and Build",
  "version": "0.1.0",
  "publisher": "samyyy2423",
  "license": "Apache-2.0",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#120e0a",
    "theme": "dark"
  },
  "homepage": "https://samyyy2423.github.io/moth/",
  "bugs": {
    "url": "https://github.com/samyyy2423/moth/issues"
  },
  "qna": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/samyyy2423/moth",
    "directory": "editors/vscode"
  },
  "keywords": [
    "moth",
    "plain english",
    "english",
    "beginners",
    "learn to code",
    "teaching",
    "language server",
    "lsp",
    "debugger",
    "formatter",
    "native",
    "compiler"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Formatters",
    "Linters",
    "Snippets",
    "Education"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a folder you haven't trusted, the extension uses the moth.path from your own settings, not the folder's, so opening a folder can't choose a program for it to run.",
      "restrictedConfigurations": [
        "moth.path"
      ]
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:moth",
    "onDebugResolve:moth"
  ],
  "contributes": {
    "languages": [
      {
        "id": "moth",
        "aliases": [
          "Moth",
          "moth"
        ],
        "extensions": [
          ".moth"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "moth",
        "scopeName": "source.moth",
        "path": "./syntaxes/moth.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "moth",
        "path": "./snippets/moth.json"
      }
    ],
    "commands": [
      {
        "command": "moth.run",
        "title": "Run this file",
        "category": "Moth"
      },
      {
        "command": "moth.debug",
        "title": "Debug this file",
        "category": "Moth"
      },
      {
        "command": "moth.build",
        "title": "Build this file",
        "category": "Moth"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "moth.run",
          "when": "resourceLangId == moth"
        },
        {
          "command": "moth.debug",
          "when": "resourceLangId == moth"
        }
      ],
      "commandPalette": [
        {
          "command": "moth.run",
          "when": "editorLangId == moth"
        },
        {
          "command": "moth.debug",
          "when": "editorLangId == moth"
        },
        {
          "command": "moth.build",
          "when": "editorLangId == moth"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "moth",
        "required": [
          "command",
          "file"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "run",
              "build"
            ],
            "description": "moth run or moth build."
          },
          "file": {
            "type": "string",
            "description": "The Moth file, from the workspace's folder."
          }
        }
      }
    ],
    "configuration": {
      "title": "Moth",
      "properties": {
        "moth.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where `moth`, Moth's command line, is: the path to `moth.exe` on Windows or `moth` on Linux, or to the folder it's in. Leave it empty to use the `moth` on your PATH. Run, Build, the debugger and the language server all use it."
        },
        "moth.languageServer": {
          "type": "boolean",
          "default": true,
          "description": "Start Moth's language server (moth lsp) for the outline, Go to Definition in the file and the files it uses, hovers and completion. Without it, the outline and Go to Definition find the file's functions by their lines."
        }
      }
    },
    "breakpoints": [
      {
        "language": "moth"
      }
    ],
    "debuggers": [
      {
        "type": "moth",
        "label": "Moth",
        "languages": [
          "moth"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The Moth file to debug.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The program's arguments.",
                "default": []
              },
              "allow": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "What it may do without asking: --allow-read, --allow-write, --allow-net, --allow-run, --allow-libraries or --allow-all.",
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop before the first line runs.",
                "default": false
              },
              "mothPath": {
                "type": "string",
                "description": "The moth to debug with, if it isn't the one moth.path or the PATH has."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "moth",
            "request": "launch",
            "name": "Debug this file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Moth: Debug a file",
            "description": "Debug a Moth program",
            "body": {
              "type": "moth",
              "request": "launch",
              "name": "Debug ${1:program}",
              "program": "^\"\\${workspaceFolder}/${1:program}.moth\""
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node make-vsix.mjs --engine"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "ovsx": "1.3.0"
  }
}
