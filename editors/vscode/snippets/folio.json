{
  "function": {
    "prefix": "to",
    "body": [
      "to ${1:name} with ${2:input}",
      "    $0",
      "end"
    ],
    "description": "A function"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:x is 1}",
      "    $0",
      "end"
    ],
    "description": "Do something only if"
  },
  "if else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:x is 1}",
      "    $2",
      "else",
      "    $0",
      "end"
    ],
    "description": "One thing or another"
  },
  "repeat": {
    "prefix": "repeat",
    "body": [
      "repeat ${1:3} times",
      "    $0",
      "end"
    ],
    "description": "Do something a number of times"
  },
  "repeat while": {
    "prefix": "while",
    "body": [
      "repeat while ${1:x is less than 10}",
      "    $0",
      "end"
    ],
    "description": "Do something while it's so"
  },
  "for each": {
    "prefix": "for",
    "body": [
      "for each ${1:item} in ${2:items}",
      "    $0",
      "end"
    ],
    "description": "Each item of a list, or each key of a dictionary"
  },
  "count": {
    "prefix": "foreach",
    "body": [
      "for each ${1:i} from ${2:1} to ${3:10}",
      "    $0",
      "end"
    ],
    "description": "Count from one number to another"
  },
  "try": {
    "prefix": "try",
    "body": [
      "try",
      "    $1",
      "if it fails with ${2:why}",
      "    $0",
      "end"
    ],
    "description": "Catch a mistake and carry on"
  },
  "test": {
    "prefix": "test",
    "body": [
      "to test_${1:name}",
      "    expect ${0:1 + 1 is 2}",
      "end"
    ],
    "description": "A test the test runner runs"
  }
}
