{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Folio",
  "scopeName": "source.folio",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#text"
    },
    {
      "include": "#number"
    },
    {
      "include": "#define"
    },
    {
      "include": "#call"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#possessive"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.folio",
      "match": "#.*$"
    },
    "text": {
      "name": "string.quoted.double.folio",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.folio"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.folio"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.folio",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.folio",
          "contentName": "source.folio",
          "begin": "\\{(?=[A-Za-z_(])",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.folio"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.folio"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "number": {
      "name": "constant.numeric.folio",
      "match": "\\b(?:0x[0-9A-Fa-f]+|0b[01]+|[0-9]+(?:\\.[0-9]+)?)\\b"
    },
    "define": {
      "match": "(?i)^\\s*(to)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.folio"
        },
        "2": {
          "name": "entity.name.function.folio"
        }
      }
    },
    "constant": {
      "name": "constant.language.folio",
      "match": "(?i)\\b(?:yes|no|nothing)\\b"
    },
    "keyword": {
      "name": "keyword.control.folio",
      "match": "(?i)\\b(?:set|add|say|if|else|end|repeat|while|for|to|return|and|or|not|is|list|empty|length|item|move|turn|pen|record|dictionary|where|remove|keys|byte|bytes|as|hex|binary|shift|bit|xor|read|write|arguments|expect|clear|draw|box|circle|button|random|when|every|milliseconds|seconds|pressed|clicked|dragged|mouse|key|fail|stop|ask|use|try|fails|uppercase|lowercase|split|join|number|position|by|times|each|in|from|with|than|at|least|most|divisible|of|forward|back|left|right|up|down|color|width|table|total|average|largest|smallest|chart|picture|play|note|beep|send|json|headers|checkbox|tick|untick|area|showing|choice|ticked|dropdown|slider|moved|choose|library|gives|package|function|power|items|rounded|remainder|divided|without|repeats)\\b"
    },
    "call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.folio"
        }
      }
    },
    "possessive": {
      "name": "keyword.operator.possessive.folio",
      "match": "'s\\b"
    },
    "operator": {
      "name": "keyword.operator.arithmetic.folio",
      "match": "[-+*/]"
    }
  }
}
