    const record = this.temp(); // a name given twice: the later value wins, in the place of the first\\n        this.e(\\\"call\\\", R.newRecord).e(\\\"local.set\\\", record);\\n        e.fields.forEach((field, i) => \{\\n          this.e(\\\"local.get\\\", record).e(\\\"i32.const\\\", this.id(field));\\n          this.expr(e.values[i]);\\n          this.e(\\\"call\\\", R.setField);\\n        });\\n        this.e(\\\"local.get\\\", record);\\n        return;\\n      }\\n      case \\\"dictionary\\\":\\n        for (const x of e.items) this.expr(x);\\n        this.e(\\\"array.new_fixed\\\", T.items, e.items.length).e(\\\"i32.const\\\", e.items.length).e(\\\"struct.new\\\", T.list);\\n        this.e(\\\"i32.const\\\", this.pos(e.at)).e(\\\"call\\\", im.dict);\\n        return;\\n      case \\\"field\\\":\\n        this.expr(e.of);\\n        this.e(\\\"i32.const\\\", this.id(e.name)).e(\\\"i32.const\\\", this.pos(e.at)).e(\\\"call\\\", R.field);\\n        return;\\n      case \\\"ask\\\":\\n        this.expr(e.question);\\n        this.e(\\\"i32.const\\\", this.pos(e.at)).e(\\\"call\\\", im.ask);\\n        return;\\n      case \\\"read\\\":\\n        this.expr(e.of);\\n        this.e(\\\"i32.const\\\", e.bytes ? 1 : 0).e(\\\"i32.const\\\", this.pos(e.at)).e(\\\"call\\\", im.read);\\n        return;\\n      case \\\"readFolder\\\":\\n        this.expr(e.of);\\n        this.e(\\\"i32.const\\\", this.pos(e.at)).e(\\\"call\\\", im.readFolder);\\n        return;\\n      case \\\"arguments\\\":\\n        this.e(\\\"call\\\", im.args);\\n        return;\\n      case \\\"random\\\":\\n        this.expr(e.left);\\n        this.expr(e.right);\\n        this.e(\\\"i32.const\\\", this.pos(e.at)).e(\\\"call\\\", im.random);\\n        return;\\n      case \\\"now\\\":\\n        this.e(\\\"i32.const\\\", e.which).e(\\\"call\\\", im.now);\\n        return;\\n      case \\\"builtin\\\": \{\\n        const index = BUILTINS.findIndex((b) => b.name === e.name);\\n        const bits = BIT_BUILTINS.indexOf(e.name);\\n        if (bits >= 0) \{ // see R.bits\\n          for (const arg of e.args) this.expr(arg);\\n          this.e(\\\"i32.const\\\", bits).e(\\\"i32.const\\\", index).e(\\\"i32.const\\\", this.pos(e.at)).e(\\\"call\\\", R.bits);\\n          return;\\n        }\\n        if (e.name === \\\"remainder\\\") \{ // see R.rem\\n          for (const arg of e.args) this.expr(arg);\\n          this.e(\\\"i32.const\\\", index).e(\\\"i32.const\\\", this.pos(e.at)).e(\\\"call\\\", R.rem);\\n          return;\\n        }\\n        if (ROUNDINGS.includes(e.name)) \{ // see R.rnd\\n          this.expr(e.args[0]);\\n          this.e(\\\"i32.const\\\", ROUNDINGS.indexOf(e.name)).e(\\\"i32.const\\\", index).e(\\\"i32.const\\\", this.pos(e.at)).e(\\\"call\\\", R.rnd);\\n          return;\\n        }\\n        if (e.name === \\\"bytes\\\") \{\\n          this.expr(e.args[0]);\\n          this.e(\\\"i32.const\\\", index).e(\\\"i32.const\\\", this.pos(e.at)).e(\\\"call\\\", R.newBytes);\\n          return;\\n        }\\n        if (e.name === \\\"start worker\\\") return this.startWorker(e.args[0]);\\n        this.e(\\\"i32.const\\\", index).note(e.name);\\n        for (const arg of e.args) this.expr(arg);\\n        this.e(\\\"array.new_fixed\\\", T.items, e.args.length).e(\\\"i32.const\\\", e.args.length).e(\\\"struct.new\\\", T.list);\\n        this.e(\\\"i32.const\\\", this.pos(e.at));\\n        this.handingOver(() => this.e(\\\"call\\\", im.builtin)); // `start` runs a function\\n        return;\\n      }\\n    }\\n  }\\n}\\n\\n// ---------- the whole module, and running it ----------\\n\\nexport function compileToWasmModule(program) \{\\n  const m = new Module();\\n  const T = declareTypes(m);\\n  const im = \{};\\n  for (const [label, [params, results]] of Object.entries(IMPORTS)) im[label] = m.import(\\\"moth\\\", label, m.funcType(params, results));\\n  const R = declareRuntime(m, T, im);\\n  declareExports(m, T, R);\\n\\n  const names = [];\\n  const nameIds = new Map();\\n  const messages = [];\\n  const numbers = new Map();\\n  const texts = new Map();\\n  const named = (name, global) => ((m.globalNames[global] = name), global);\\n  const ctx = \{\\n    m, T, R, im, ats: [], names, messages, captured: findCaptured(program),\\n    kinds: [null], // what the inputs of each function whose inputs say so are (see closure())\\n    unset: named(\\\"unset\\\", m.global(ref(T.unset), false, new Code().emit(\\\"struct.new\\\", T.unset))),\\n    left: named(\\\"left\\\", m.global(I32, true, new Code().emit(\\\"i32.const\\\", 0))),\\n    maxSteps: named(\\\"maxSteps\\\", m.global(F64, true, new Code().emit(\\\"f64.const\\\", Infinity))),\\n    depth: named(\\\"depth\\\", m.global(I32, true, new Code().emit(\\\"i32.const\\\", 0))),\\n    calls: named(\\\"calls\\\", m.global(ref(T.ids), false, new Code().emit(\\\"i32.const\\\", 2 * MAX_DEPTH).emit(\\\"array.new_default\\\", T.ids))), // see call()\\n    init: m.func(\\\"init\\\", [], []), // makes the text the program holds\\n    texts: [],\\n    id(name) \{\\n      if (!nameIds.has(name)) nameIds.set(name, names.push(name) - 1);\\n      return nameIds.get(name);\\n    },\\n    message: (text) => messages.push(text) - 1,\\n    number(value) \{\\n      const key = String(value);\\n      if (!numbers.has(key)) numbers.set(key, named(`number$\{numbers.size}`, m.global(ref(T.num), false, new Code().emit(\\\"f64.const\\\", value).emit(\\\"struct.new\\\", T.num))));\\n      return numbers.get(key);\\n    },\\n    text(value) \{\\n      if (!texts.has(value)) \{\\n        const global = named(`text$\{texts.size}`, m.global(refNull(T.text), true, new Code().emit(\\\"ref.null\\\", T.text)));\\n        texts.set(value, global);\\n        ctx.init.code.emit(\\\"i32.const\\\", ctx.texts.push(value) - 1).emit(\\\"call\\\", im.text).emit(\\\"struct.new\\\", T.text).emit(\\\"global.set\\\", global);\\n      }\\n      return texts.get(value);\\n    },\\n  };\\n  const main = new WasmCompiler(null, \\\"main\\\", [], program, ctx);\\n  m.export(\\\"main\\\", main.f.index);\\n  // the calls in progress, for a mistake's trail: how many, and for each (outermost first), where it was made\\n  // and the name of its function\\n  for (const [label, params, write] of [\\n    [\\\"callDepth\\\", [], (c) => c.emit(\\\"global.get\\\", ctx.depth)],\\n    [\\\"callSite\\\", [I32], (c) => c.emit(\\\"global.get\\\", ctx.calls).emit(\\\"local.get\\\", 0).emit(\\\"i32.const\\\", 1).emit(\\\"i32.shl\\\").emit(\\\"array.get\\\", T.ids)],\\n    [\\\"callName\\\", [I32], (c) => c.emit(\\\"global.get\\\", ctx.calls).emit(\\\"local.get\\\", 0).emit(\\\"i32.const\\\", 1).emit(\\\"i32.shl\\\").emit(\\\"i32.const\\\", 1).emit(\\\"i32.add\\\").emit(\\\"array.get\\\", T.ids)],\\n  ]) \{\\n    const f = m.func(label, params, [I32]);\\n    write(f.code);\\n    m.export(label, f.index);\\n  }\\n  // an app's handler, called from outside with its inputs (as many as it takes: 0, 1 or 2); and its steps\\n  // and depth from 0 before each\\n  const invoke = m.func(\\\"invoke\\\", [EQ, EQ, EQ], [EQ]);\\n  for (const n of [0, 1, 2]) \{\\n    const c = invoke.code;\\n    c.emit(\\\"local.get\\\", 0).emit(\\\"ref.cast\\\", T.closure).emit(\\\"struct.get\\\", T.closure, 2).emit(\\\"i32.const\\\", n).emit(\\\"i32.eq\\\").emit(\\\"if\\\");\\n    c.emit(\\\"local.get\\\", 0).emit(\\\"ref.cast\\\", T.closure).emit(\\\"struct.get\\\", T.closure, 1);\\n    for (let i = 1; i <= n; i++) c.emit(\\\"local.get\\\", i);\\n    c.emit(\\\"local.get\\\", 0).emit(\\\"ref.cast\\\", T.closure).emit(\\\"struct.get\\\", T.closure, 0).emit(\\\"ref.cast\\\", T.fn(n)).emit(\\\"call_ref\\\", T.fn(n)).emit(\\\"return\\\").emit(\\\"end\\\");\\n  }\\n  invoke.code.emit(\\\"ref.null\\\", \\\"eq\\\");\\n  m.export(\\\"invoke\\\", invoke.index);\\n  const restart = m.func(\\\"restart\\\", [], []);\\n  restart.code.emit(\\\"call\\\", ctx.im.grant).emit(\\\"global.set\\\", ctx.left).emit(\\\"i32.const\\\", 0).emit(\\\"global.set\\\", ctx.depth);\\n  m.export(\\\"restart\\\", restart.index);\\n  return \{ bytes: m.encode(), listing: m.listing(ctx.init.index), ats: ctx.ats, names, messages, texts: ctx.texts, kinds: ctx.kinds };\\n}\\n\\n// Compiles a parsed program: \{ bytes, listing, run(print, draw, maxSteps) }, like jit() in jit.js.\\nexport function wasm(program) \{\\n  return wasmProgram(compileToWasmModule(program));\\n}\\n\\n// A module and what running it needs to know, as compileToWasmModule gives them (or wasm.moth, the same back\\n// end written in Moth), made ready to run.\\nexport function wasmProgram(made, module = new WebAssembly.Module(made.bytes)) \{\\n  return \{ ...made, run: (print, draw, maxSteps, ask, disk, args, random, host, printError, clock, play) => instantiate(module, made, print, draw, maxSteps, ask, disk, args, random, host, printError, clock, play).main(maxSteps) };\\n}\\n\\n// A module `moth build --target wasm` made (wasm_with_details in wasm.moth): its bytes, with what running it needs\\n// as JSON in its custom section \\\"moth\\\", made ready to run as wasmProgram makes one.\\nexport function wasmFile(bytes) \{\\n  const module = new WebAssembly.Module(bytes);\\n  const [section] = WebAssembly.Module.customSections(module, \\\"moth\\\");\\n  if (!section) throw new Error(\\\"this module wasn't made by moth build --target wasm: it has no section called moth\\\");\\n  const details = JSON.parse(new TextDecoder().decode(section));\\n  const ats = details.ats.map(([line, col, file]) => (\{ line, col, file: file || undefined }));\\n  return wasmProgram(\{ ...details, bytes, ats }, module);\\n}\\n\\n// The JavaScript side of a run: the imports, and moving values in and out of the module.\\nfunction instantiate(module, \{ ats, names, messages, texts, kinds }, print, draw, maxSteps, answer, disk, args = [], chance = seeded(), host = \{ handlers: [] }, printError = console.error, clock = fakeClock(), play = () => \{}) \{\\n  // Every mistake made is kept, for a `try`: JavaScript's exceptions cross WebAssembly, but only JavaScript can\\n  // tell which ones it was. A `fail with` keeps its value as WebAssembly holds it, so catching it keeps it whole.\\n  let lastError = null;\\n  let caughtError = null;\\n  let granted = 0; // the steps given so far, of maxSteps (see refill)\\n  let failing;\\n  const throwing = (err) => \{\\n    lastError = err;\\n    throw err;\\n  };\\n  const trail = () => \{\\n    const calls = [];\\n    for (let i = x.callDepth() - 1; i >= 0; i--) calls.push(\{ name: names[x.callName(i)], at: ats[x.callSite(i)] });\\n    return trailOf(calls);\\n  };\\n  const errors = ats.map((at) => (message, value) => \{\\n    const err = new MothError(at, message, value, trail());\\n    err.wasm = failing;\\n    failing = undefined;\\n    throwing(err);\\n  });\\n  const turtle = new Turtle(draw);\\n  host.turtle = turtle;\\n  let x = null; // the module's exports, once it exists\\n\\n  function toJs(v, seen = new Map()) \{\\n    if (v === null) return null;\\n    if (typeof v === \\\"number\\\") return v === 1 ? true : v === 0 ? false : v; // i31 values reach JavaScript as numbers: 1 and 0 are yes and no\\n    if (seen.has(v)) return seen.get(v);\\n    switch (x.tag(v)) \{\\n      case TAGS.number:\\n        return x.num(v);\\n      case TAGS.text:\\n        return x.textValue(v);\\n      case TAGS.list: \{\\n        const list = [];\\n        seen.set(v, list);\\n        const n = x.listLength(v);\\n        let i = 0;\\n        if (n > 0 && x.listText(v, 0) !== null) \{ // a list of text, most likely: each text in one call\\n          for (; i < n; i++) \{\\n            const text = x.listText(v, i);\\n            list.push(text !== null ? text : toJs(x.listItem(v, i), seen));\\n          }\\n        }\\n        for (; i < n; i++) list.push(toJs(x.listItem(v, i), seen));\\n        return list;\\n      }\\n      case TAGS.record: \{\\n        const record = makeRecord([], []);\\n        seen.set(v, record);\\n        for (let i = 0, n = x.recordSize(v); i < n; i++) record[names[x.recordKey(v, i)]] = toJs(x.recordValue(v, i), seen);\\n        return record;\\n      }\\n      case TAGS.function:\\n        return new Closure(\{ name: names[x.functionName(v)], params: Array(x.functionInputs(v)) }, null);\\n      case TAGS.dictionary: \{\\n        const dictionary = new Map();\\n        seen.set(v, dictionary);\\n        for (const [key, value] of x.hostValue(v)) dictionary.set(key, toJs(value, seen));\\n        return dictionary;\\n      }\\n      case TAGS.quantity:\\n        return new Quantity(x.qtyAmount(v), x.qtyUnit(v));\\n      case TAGS.bytes: \{ // a copy, made byte by byte\\n        const bytes = new Uint8Array(x.bytesLength(v));\\n        for (let i = 0; i < bytes.length; i++) bytes[i] = x.byteAt(v, i);\\n        return bytes;\\n      }\\n      default:\\n        return UNSET;\\n    }\\n  }\\n\\n  // A dictionary's own Map, whose values stay the module's, so changing it changes the dictionary; any other\\n  // value as JavaScript (bytes as a copy). For checks that only need to see the dictionary, not what is in it.\\n  const rawOf = (v) => (v !== null && typeof v !== \\\"number\\\" && x.tag(v) === TAGS.dictionary ? x.hostValue(v) : toJs(v));\\n\\n  // only new values come back from JavaScript (text, and the letters of a text), never a list it changed\\n  function toWasm(v) \{\\n    if (v === null) return null;\\n    if (typeof v === \\\"boolean\\\") return v ? 1 : 0;\\n    if (typeof v === \\\"number\\\") return x.makeNum(v);\\n    if (typeof v === \\\"string\\\") return x.makeText(v);\\n    if (isQuantity(v)) return x.makeQty(v.amount, v.unit);\\n    if (isRecord(v)) \{ // a table's row: its fields by the module's ids for their names, new names given new ones\\n      const record = x.makeRecord();\\n      for (const name of Object.keys(v)) \{\\n        let id = names.indexOf(name);\\n        if (id < 0) id = names.push(name) - 1;\\n        x.putField(record, id, toWasm(v[name]));\\n      }\\n      return record;\\n    }\\n    if (v instanceof Map) return x.makeHost(new Map([...v].map(([key, value]) => [key, toWasm(value)])), TAGS.dictionary);\\n    if (v instanceof Uint8Array) \{\\n      const bytes = x.makeBytes(v.length); // all 0 to start with\\n      for (let i = 0; i < v.length; i++) if (v[i]) x.setByte(bytes, i, v[i]);\\n      return bytes;\\n    }\\n    const list = x.newList();\\n    for (const item of v) x.listPush(list, toWasm(item));\\n    return list;\\n  }\\n\\n  // A copy of a value for a worker, made in the module (see workerCopy in vm.js, which this follows): lists,\\n  // records, dictionaries and bytes made again; a function made at the top of a file, text, numbers and\\n  // amounts as they are, as they never change\\n  function workerCopy(v, depth = 0) \{\\n    if (v === null || typeof v === \\\"number\\\") return v;\\n    const tag = x.tag(v);\\n    if (tag === TAGS.number || tag === TAGS.text || tag === TAGS.quantity || tag === TAGS.unset) return v;\\n    if (depth >= DEEPEST_COPY) throw new CantCopy(tooDeepToCopy);\\n    switch (tag) \{\\n      case TAGS.list: \{\\n        const list = x.newList();\\n        for (let i = 0, n = x.listLength(v); i < n; i++) x.listPush(list, workerCopy(x.listItem(v, i), depth + 1));\\n        return list;\\n      }\\n      case TAGS.record: \{\\n        const record = x.makeRecord();\\n        for (let i = 0, n = x.recordSize(v); i < n; i++) x.putField(record, x.recordKey(v, i), workerCopy(x.recordValue(v, i), depth + 1));\\n        return record;\\n      }\\n      case TAGS.function:\\n        if (!x.functionAtTop(v)) throw new CantCopy(madeInside(names[x.functionName(v)]));\\n        return v;\\n      case TAGS.dictionary:\\n        return x.makeHost(new Map([...x.hostValue(v)].map(([key, value]) => [key, workerCopy(value, depth + 1)])), TAGS.dictionary);\\n      default: \{\\n        const bytes = x.makeBytes(x.bytesLength(v));\\n        for (let i = 0, n = x.bytesLength(v); i < n; i++) x.setByte(bytes, i, x.byteAt(v, i));\\n        return bytes;\\n      }\\n    }\\n  }\\n  const workers = []; // for each worker running, its function and the program's variables it swapped for copies\\n  const workerDone = (result) => \{\\n    const [f, saved] = workers.pop();\\n    saved.forEach((value, i) => x.setScopeSlot(f, i, value));\\n    leaveWorker();\\n    return toWasm(workerEnded(result));\\n  };\\n  const WAIT_FOR = BUILTINS.findIndex((b) => b.name === \\\"wait for\\\");\\n\\n  const imports = \{\\n    workerBegin: (f, list, name, k) => \{\\n      workerRoom(errors[k]);\\n      try \{\\n        if (!x.functionAtTop(f)) throw new CantCopy(madeInside(names[x.functionName(f)]));\\n        const given = x.newList();\\n        for (let i = 0, n = x.listLength(list); i < n; i++) x.listPush(given, workerCopy(x.listItem(list, i)));\\n        const saved = Array.from(\{ length: x.scopeSize(f) }, (_, i) => x.scopeSlot(f, i));\\n        const fresh = saved.map((value) => \{ // slot 0 is no variable's, so it holds the module's own \\\"no value yet\\\"\\n          try \{\\n            return workerCopy(value);\\n          } catch (err) \{\\n            if (!(err instanceof CantCopy)) throw err;\\n            return saved[0];\\n          }\\n        });\\n        fresh.forEach((value, i) => x.setScopeSlot(f, i, value));\\n        workers.push([f, saved]);\\n        enterWorker();\\n        return given;\\n      } catch (err) \{\\n        if (!(err instanceof CantCopy)) throw err;\\n        errors[k](err.message);\\n      }\\n    },\\n    workerGave: (gave) => \{\\n      try \{\\n        return workerDone(\{ gave: workerCopy(gave) });\\n      } catch (err) \{\\n        if (!(err instanceof CantCopy)) throw err;\\n        return workerDone(\{ failed: x.makeText(err.message) });\\n      }\\n    },\\n    workerFailed: () => \{\\n      const value = caughtError.wasm !== undefined ? caughtError.wasm : toWasm(caughtValue(caughtError));\\n      try \{\\n        return workerDone(\{ failed: workerCopy(value) });\\n      } catch (err) \{\\n        if (!(err instanceof CantCopy)) throw err;\\n        return workerDone(\{ failed: x.makeText(err.message) });\\n      }\\n    },\\n    say: (parts) => print(toJs(parts).map((p) => show(p)).join(\\\"\\\")),\\n    sayError: (parts) => printError(toJs(parts).map((p) => show(p)).join(\\\"\\\")),\\n    exit: (code, k) => throwing(new Ended(exitCode(toJs(code), errors[k]))), // kept as the last thing thrown, which no `try` catches\\n    fail: (message, k) => errors[k](messages[message]),\\n    unset: (name, k) => errors[k](noValue(names[name])),\\n    plus: (a, b, k) => toWasm(plus(toJs(a), toJs(b), errors[k])),\\n    arithmetic: (op, a, b, k) => toWasm(arithmetic(MATH[op], toJs(a), toJs(b), errors[k])),\\n    negate: (v, k) => toWasm(negate(toJs(v), errors[k])),\\n    compare: (op, a, b, k) => (compare(COMPARE_OPS[op], toJs(a), COMPARE_OPS[op] === \\\"in\\\" ? rawOf(b) : toJs(b), errors[k]) ? 1 : 0),\\n    remainder: (a, b) => a % b,\\n    numberOrder: (a, b) => \{\\n      const order = numberOrder(a, b);\\n      return Number.isNaN(order) ? 2 : order;\\n    },\\n    divisible: (a, b) => (divisible(a, b) ? 1 : 0),\\n    equal: (a, b) => (equal(toJs(a), toJs(b)) ? 1 : 0),\\n    sameText: (a, b) => (a === b ? 1 : 0),\\n    concat: (a, b) => a + b,\\n    textNum: (a, n) => a + show(n),\\n    numText: (n, b) => show(n) + b,\\n    text: (i) => texts[i],\\n    lengthOf: (v, k) => lengthOf(rawOf(v), errors[k]),\\n    item: (target, n, k) => \{ // a list's items are found in WebAssembly, so a list here is a mistake\\n      const [seq, i] = item(rawOf(target), toJs(n), false, errors[k]);\\n      return seq instanceof Map ? seq.get(i) : toWasm(seq[i]);\\n    },\\n    itemRef: (target, n, k) => \{\\n      item(rawOf(target), toJs(n), true, errors[k]);\\n    },\\n    put: (target, n, value, k) => \{ // only for a mistake: R.put does the rest\\n      const [seq, i] = item(rawOf(target), toJs(n), true, errors[k]);\\n      putItem(seq, i, seq instanceof Map ? value : toJs(value), errors[k]);\\n    },\\n    dictGetText: (map, key, k) => (map.has(key) ? map.get(key) : item(map, key, false, errors[k])),\\n    dictGetNum: (map, key, k) => (map.has(canon(key)) ? map.get(canon(key)) : item(map, key, false, errors[k])), // keys to 15 digits\\n    dictSetText: (map, key, value) => void map.set(key, value),\\n    dictSetNum: (map, key, value) => void map.set(canon(key), value),\\n    dictHasText: (map, key) => (map.has(key) ? 1 : 0),\\n    dictHasNum: (map, key) => (map.has(canon(key)) ? 1 : 0),\\n    dict: (list, k) => x.makeHost(makeDictionary(Array.from(\{ length: x.listLength(list) }, (_, i) => x.listItem(list, i)), errors[k], toJs), TAGS.dictionary),\\n    remove: (key, target, k) => removeKey(toJs(key), rawOf(target), errors[k]),\\n    addInto: (current, value, name, k) => toWasm(addInto(toJs(current), toJs(value), names[name], errors[k])),\\n    checkRepeat: (n, k) => checkRepeat(toJs(n), errors[k]), // a count that's whole to 15 digits comes back whole\\n    checkRange: (from, to, k) => checkRange(toJs(from), toJs(to), errors[k]),\\n    itemsOf: (v, k) => toWasm(itemsOf(rawOf(v), errors[k])),\\n    callable: (f, name, k) => callable(toJs(f), names[name], errors[k]),\\n    checkInputs: (f, argc, name, k) => checkInputs(toJs(f), argc, names[name], errors[k]),\\n    // input i of a function whose inputs say what they are: its kind from its tag, so a big list isn't copied\\n    checkKind: (id, i, v, name, k) => \{\\n      const wanted = kinds[id].kinds[i];\\n      const kind = v === null ? \\\"nothing\\\" : typeof v === \\\"number\\\" ? (v === 0 || v === 1 ? \\\"yes/no\\\" : \\\"a number\\\") : TAG_KINDS[x.tag(v)];\\n      if (wanted >= 0 && kind !== KIND_TAGS[wanted]) errors[k](`'$\{names[name]}' needs $\{kinds[id].params[i]} to be $\{KINDS[wanted]}, not $\{kind}`);\\n    },\\n    stopped: (k) => \{\\n      const err = new MothError(ats[k], stoppedMessage(maxSteps), undefined, trail());\\n      err.final = true; // no try catches it\\n      throwing(err);\\n    },\\n    // a step past those given so far: up to 2^30 more, of maxSteps, this one among them; or, with none left, stopped\\n    refill: (k) => \{\\n      if (granted >= maxSteps) imports.stopped(k);\\n      const more = Math.min(maxSteps - granted, 2 ** 30);\\n      granted += more;\\n      return more - 1;\\n    },\\n    grant: () => \{\\n      granted = Math.min(maxSteps, 2 ** 30);\\n      return granted;\\n    },\\n    tooDeep: () => \{\\n      throw new TooDeep();\\n    },\\n    turtle: (action, value, k) => turtle.act(action, toJs(value), errors[k], disk),\\n    field: (r, name, k) => fieldOf(toJs(r), names[name], errors[k]),\\n    recordFor: (r, name, k) => recordFor(toJs(r), names[name], errors[k]),\\n    failWith: (value, k) => \{\\n      failing = value;\\n      failWith(toJs(value), errors[k]);\\n    },\\n    tryStart: () => \{\\n      lastError = null;\\n    },\\n    caught: () => \{\\n      [caughtError, lastError] = [lastError, null];\\n      return catchable(caughtError) ? 1 : 0;\\n    },\\n    caughtValue: () => (caughtError.wasm !== undefined ? caughtError.wasm : toWasm(caughtValue(caughtError))),\\n    builtin: (i, args, k) => \{\\n      const given = toJs(args);\\n      const worker = i === WAIT_FOR ? workerResult(given[0]) : null;\\n      if (worker) \{ // what a worker gave is kept as the module made it (see imports.workerGave)\\n        workerTaken(worker);\\n        if (Object.hasOwn(worker, \\\"failed\\\")) \{\\n          failing = worker.failed;\\n          failWith(toJs(worker.failed), errors[k]);\\n        }\\n        return worker.gave;\\n      }\\n      return toWasm(BUILTINS[i].run(given, errors[k], turtle, disk));\\n    },\\n    ask: (question, k) => toWasm(askFor(toJs(question), answer, errors[k])),\\n    read: (name, asBytes, k) => toWasm(readFile(toJs(name), asBytes === 1, disk, errors[k])),\\n    write: (value, name, k) => writeFile(toJs(value), toJs(name), disk, errors[k]),\\n    removeFile: (name, k) => removeFile(toJs(name), disk, errors[k]),\\n    readFolder: (name, k) => toWasm(readFolder(toJs(name), disk, errors[k])),\\n    args: () => toWasm(args),\\n    random: (low, high, k) => toWasm(randomWhole(toJs(low), toJs(high), chance, errors[k])),\\n    now: (which) => toWasm(nowValue(which, clock)),\\n    wait: (amount, unit, k) => waitFor(toJs(amount), unit, clock, errors[k]),\\n    handle: (event, closure) => void host.handlers.push(\{ event: EVENTS[event], closure }),\\n    handleLabel: (event, closure, k, label) => void host.handlers.push(\{ event: EVENTS[event], label: show(toJs(label)), closure }),\\n    every: (interval, unit, closure, k) => void host.handlers.push(\{ event: \\\"every\\\", interval: everyInterval(toJs(interval), unit, errors[k]), closure }),\\n    expect: (op, negate, a, b, k) => expectThat(COMPARE_OPS[op], negate === 1, toJs(a), toJs(b), errors[k]),\\n    expectYes: (value, k) => expectYes(toJs(value), errors[k]),\\n    play: (note, time, unit, k) => play(soundOf(toJs(note), toJs(time), unit, errors[k])),\\n    beep: () => play(\{ ...BEEP }),\\n  };\\n  x = new WebAssembly.Instance(module, \{ moth: imports }).exports;\\n  host.call = (handler, inputs) => \{\\n    granted = 0; // each handler's call has steps of its own\\n    x.restart();\\n    const [a = null, b = null] = inputs.map(toWasm);\\n    x.invoke(handler.closure, a, b);\\n  };\\n  return x;\\n}\\n\",\"checker.js\":\"// The checker: finds mistakes without running the program. It only speaks when it is sure, and it says\\n// what running would say: each \\\"will fail\\\" warning comes from the VM's own checks (vm.js), run on sample\\n// values of the types it worked out, so its message is the exact error that line would stop with.\\n//\\n// It works the types out twice (DESIGN §107). Once from what is sure: values written out, what each operation\\n// and builtin gives, an input whose `as` each call checks, what a kind makes, what a function returns. A\\n// check that fails on those types \\\"fails\\\": that line stops the program whenever it runs. Then again, adding\\n// what the code says of itself that no run checks: `with pet as a dog` (each call checks only that it's a\\n// record), `as a list of numbers` (only that it's a list), `gives a number`. A check that fails only on those\\n// \\\"doesn't fit\\\": the code goes against what it says. Code that says nothing gets the same types both times,\\n// so it gets no \\\"doesn't fit\\\": it stays as dynamic as it was.\\nimport \{ Scope } from \\\"./scope.js\\\";\\nimport \{ Turtle, TURTLE_ACTIONS, BUILTINS, plus, arithmetic, negate, lengthOf, compare, item, addInto, checkRepeat, checkRange, itemsOf,\\n  callable, checkInputs, checkKinds, makeRecord, fieldOf, recordFor, removeKey, readFile, writeFile, randomWhole, everyInterval, Closure,\\n  Quantity, isQuantity, measureOf, unitNamed, UNITS, MEASURE_TYPES, MEASURES, exitCode, removeFile, NOW_WORDS, waitFor, fakeClock, readFolder, soundOf,\\n  KINDS, closest, isRecord, isDictionary, isBytes } from \\\"./vm.js\\\";\\n\\n// A stand-in value for each type. Only checks that depend on the type alone use these; a check that\\n// depends on the value itself (like dividing by zero) only runs when the code has that value written out.\\nexport const SAMPLES = \{ number: 1, text: \\\"a\\\", \\\"yes/no\\\": true, nothing: null, list: [], record: makeRecord([], []), dictionary: new Map(), bytes: new Uint8Array(0),\\n  function: new Closure(\{ name: \\\"f\\\", params: [] }, null),\\n  // an amount of each measure: 1 m, 1 second, 1 g, 1 litre\\n  ...Object.fromEntries(MEASURE_TYPES.map((type, measure) => [type, new Quantity(1, UNITS.findIndex((u) => u[2] === measure && u[3] === 1))])) };\\n// a sample of a type of its own, as a rule can change the one it's given (`add` puts an item in a list)\\nexport const sampleOf = (type) => (type === \\\"list\\\" ? [] : type === \\\"record\\\" ? makeRecord([], []) : type === \\\"dictionary\\\" ? new Map()\\n  : type === \\\"bytes\\\" ? new Uint8Array(0) : SAMPLES[type]);\\n// the type of what an operation on samples gave: a number, text, or an amount of some measure\\nconst resultType = (v) => (typeof v === \\\"number\\\" ? \\\"number\\\" : typeof v === \\\"string\\\" ? \\\"text\\\" : isQuantity(v) ? MEASURE_TYPES[measureOf(v)] : null);\\n// what `a op b` gives, for an op of + - * / and a and b two of SAMPLES' types: what the same operation on\\n// samples gives (2 km * 3 is a distance, 2 km / 1 km a number), or null if it fails, which a check says\\nexport function resultTypeOf(op, a, b) \{\\n  if (op === \\\"+\\\" && (a === \\\"text\\\" || b === \\\"text\\\")) return \\\"text\\\";\\n  try \{\\n    return resultType(op === \\\"+\\\" ? plus(SAMPLES[a], SAMPLES[b], found) : arithmetic(op, SAMPLES[a], SAMPLES[b], found));\\n  } catch (error) \{\\n    if (error instanceof Found) return null;\\n    throw error;\\n  }\\n}\\n// what an amount of the unit `word` (written out, as `5 km` and `in miles` have it) measures\\nconst unitType = (word) => MEASURE_TYPES[UNITS[unitNamed(word)][2]];\\n// what an input that says what it is (`as a number`) holds, by its number in vm.js's KINDS\\nconst KIND_TYPES = [\\\"number\\\", \\\"text\\\", \\\"yes/no\\\", \\\"list\\\", \\\"record\\\", \\\"dictionary\\\", \\\"bytes\\\", \\\"function\\\"];\\nconst literalType = (v) => (v === null ? \\\"nothing\\\" : typeof v === \\\"boolean\\\" ? \\\"yes/no\\\" : typeof v === \\\"string\\\" ? \\\"text\\\" : \\\"number\\\");\\n// the statements after which nothing in the same block runs, as a warning names them\\nconst ENDINGS = new Map([[\\\"return\\\", \\\"return\\\"], [\\\"fail\\\", \\\"fail\\\"], [\\\"stop\\\", \\\"stop\\\"], [\\\"exit\\\", \\\"stop the program\\\"]]);\\n\\n// ---------- types beyond SAMPLES' (DESIGN §107) ----------\\n// A type is text: one of SAMPLES' keys, or \\\"record:dog\\\", a record the kind dog makes, or \\\"list:number\\\", a list\\n// whose every item is a number (\\\"list:list:text\\\", \\\"list:record:dog\\\"...). `undefined` means nothing known yet,\\n// `null` could be several.\\nconst base = (t) => (typeof t !== \\\"string\\\" ? t : t.startsWith(\\\"record:\\\") ? \\\"record\\\" : t.startsWith(\\\"list:\\\") ? \\\"list\\\" : t);\\nconst holds = (t) => (typeof t === \\\"string\\\" && t.startsWith(\\\"list:\\\") ? t.slice(5) : null); // what each item of a list is, if known\\n// what a variable is, given two things it can be: the same, or one that says less about it, or could be several\\nfunction join(a, b) \{\\n  if (a === undefined) return b;\\n  if (b === undefined || a === b) return a;\\n  if (a === null || b === null || base(a) !== base(b)) return null;\\n  if (base(a) === \\\"list\\\") \{\\n    const items = join(holds(a) ?? null, holds(b) ?? null);\\n    return items === null ? \\\"list\\\" : `list:$\{items}`;\\n  }\\n  return base(a); // two kinds of record are still a record\\n}\\nconst plural = (name) => (/[^aeiou]y$/.test(name) ? `$\{name.slice(0, -1)}ies` : /(s|x|z|ch|sh)$/.test(name) ? `$\{name}es` : `$\{name}s`);\\n// a type as a message says it: \\\"a number\\\", \\\"text\\\", \\\"a dog\\\", \\\"a list of numbers\\\"\\nfunction described(t) \{\\n  if (t.startsWith(\\\"record:\\\")) return `$\{/^[aeiou]/.test(t.slice(7)) ? \\\"an\\\" : \\\"a\\\"} $\{t.slice(7)}`;\\n  if (t.startsWith(\\\"list:\\\")) return `a list of $\{each(t.slice(5))}`;\\n  if (MEASURE_TYPES.includes(t)) return MEASURES[MEASURE_TYPES.indexOf(t)];\\n  return \{ number: \\\"a number\\\", list: \\\"a list\\\", record: \\\"a record\\\", dictionary: \\\"a dictionary\\\", function: \\\"a function\\\" }[t] ?? t;\\n}\\n// the items of a list of t, as `a list of` says them: \\\"numbers\\\", \\\"text\\\", \\\"dogs\\\", \\\"lists of numbers\\\"\\nfunction each(t) \{\\n  if (t.startsWith(\\\"record:\\\")) return plural(t.slice(7));\\n  if (t.startsWith(\\\"list:\\\")) return `lists of $\{each(t.slice(5))}`;\\n  if (MEASURE_TYPES.includes(t)) return plural(t);\\n  return \{ number: \\\"numbers\\\", \\\"yes/no\\\": \\\"yes or no\\\", list: \\\"lists\\\", record: \\\"records\\\", dictionary: \\\"dictionaries\\\", function: \\\"functions\\\" }[t] ?? t;\\n}\\nconst ITEM_WORDS = \{ numbers: \\\"number\\\", text: \\\"text\\\", \\\"yes or no\\\": \\\"yes/no\\\", lists: \\\"list\\\", records: \\\"record\\\", dictionaries: \\\"dictionary\\\", bytes: \\\"bytes\\\", functions: \\\"function\\\" };\\n\\nclass Found \{\\n  constructor(message) \{\\n    this.message = message;\\n  }\\n}\\nconst found = (message) => \{\\n  throw new Found(message);\\n};\\n\\n// ---------- the rules (DESIGN §107) ----------\\n// Each check the checker makes of values, as a rule: given what's fixed at its spot (an operator, a name, a\\n// unit) and a value for each operand, it throws Found with the message running would stop with, or doesn't.\\n// The checker runs each on a value of the type it worked out for each operand (SAMPLES', or the value itself\\n// where it's written out); make-checker-rules.mjs runs each on every type, for moth check.\\nconst typeOfValue = (v) => (v === null ? \\\"nothing\\\" : typeof v === \\\"boolean\\\" ? \\\"yes/no\\\" : typeof v === \\\"string\\\" ? \\\"text\\\" : typeof v === \\\"number\\\" ? \\\"number\\\"\\n  : Array.isArray(v) ? \\\"list\\\" : isRecord(v) ? \\\"record\\\" : isDictionary(v) ? \\\"dictionary\\\" : isBytes(v) ? \\\"bytes\\\" : v instanceof Closure ? \\\"function\\\"\\n    : MEASURE_TYPES[measureOf(v)]);\\nconst PICTURE = TURTLE_ACTIONS.indexOf(\\\"picture\\\");\\nexport const RULES = \{\\n  setItem: (_, v) => Array.isArray(v) || isBytes(v) || item(v, 1, true, found),\\n  add: ([name], current, value) => addInto(current, value, name, found),\\n  count: (_, from, to) => checkRange(from, to, found),\\n  each: (_, list) => itemsOf(list, found),\\n  every: ([unit], interval) => typeof interval === \\\"number\\\" || everyInterval(interval, unit, found),\\n  exit: (_, v) => exitCode(v, found),\\n  remove: (_, target) => isDictionary(target) || removeKey(\\\"a\\\", target, found),\\n  compare: ([op], a, b) => compare(op, a, b, found),\\n  write: (_, name) => typeof name === \\\"string\\\" || writeFile(null, name, null, found),\\n  removeFile: (_, name) => typeof name === \\\"string\\\" || removeFile(name, null, found),\\n  wait: ([unit], amount) => waitFor(amount, unit, fakeClock(), found),\\n  setField: ([field], target) => isRecord(target) || recordFor(target, field, found),\\n  note: (_, note) => soundOf(note, 1, 1000, found), // when how long isn't known: the note can still be wrong on its own\\n  play: ([unit], note, time) => soundOf(note, time, unit, found),\\n  picture: (_, file) => typeof file === \\\"string\\\" || isBytes(file) || new Turtle().act(PICTURE, [file, 0, 0, null, null], found),\\n  turtle: ([action], value) => new Turtle().act(action, value, found),\\n  math: ([op], a, b) => (op !== \\\"+\\\" ? arithmetic(op, a, b, found) : (typeof a === \\\"number\\\" && typeof b === \\\"number\\\") || plus(a, b, found)),\\n  negate: (_, v) => negate(v, found),\\n  field: ([field], record) => isRecord(record) || fieldOf(record, field, found),\\n  length: (_, v) => lengthOf(v, found),\\n  random: (_, low, high) => (typeof low === \\\"number\\\" && typeof high === \\\"number\\\") || randomWhole(low, high, Math.random, found),\\n  read: ([bytes], name) => typeof name === \\\"string\\\" || readFile(name, bytes, null, found),\\n  readFolder: (_, name) => typeof name === \\\"string\\\" || readFolder(name, null, found),\\n  builtin: ([name], ...args) => \{ // only an input known to be the wrong kind is certain to fail; what the values are is left to run time\\n    const builtin = BUILTINS.find((b) => b.name === name);\\n    if (args.some((v, i) => !builtin.needs[i].includes(typeOfValue(v)))) builtin.run(args, found);\\n  },\\n  item: (_, v) => Array.isArray(v) || isBytes(v) || typeof v === \\\"string\\\" || isDictionary(v) || item(v, 1, false, found),\\n};\\n// What a rule takes in place of SAMPLES' value, where one would fail: a note, and how long it plays.\\nexport const FINE = \{ note: [\{ text: \\\"C\\\", number: 440 }], play: [\{ text: \\\"C\\\", number: 440 }, \{ number: 1 }] };\\n// Other values of the types a program can write out, to try in place of SAMPLES' (see dependsOn).\\nexport const PROBES = \{ number: [0, -1, 2, 1.5, -0.5, 7, 20, 59, 61, 255, 256, 20000.5, 1e21], text: [\\\"\\\", \\\"C\\\", \\\"C4\\\", \\\"H\\\", \\\"5\\\", \\\"km\\\", \\\"x y\\\", \\\"rest\\\"],\\n  \\\"yes/no\\\": [false] };\\n\\n// what a rule does with these values: the message it stops with, or \\\"\\\" if it doesn't\\nexport function outcome(name, args, values) \{\\n  try \{\\n    RULES[name](args, ...values);\\n    return \\\"\\\";\\n  } catch (err) \{\\n    if (err instanceof Found) return err.message;\\n    throw err;\\n  }\\n}\\n\\n// The operands of rule `name` whose value, not just type, can change what it does: for each, whether another\\n// value of its type (PROBES') than the one the rule is given for it (SAMPLES', or FINE's) does something else.\\n// Where a value written out is one of those, moth check leaves the rule out, as it knows types, not values.\\nexport function dependsOn(name, args, types) \{\\n  const tried = (vs) => \{ // a value no program could give there (a unit's word that isn't one) does something else too\\n    try \{\\n      return outcome(name, args, vs);\\n    } catch \{\\n      return null;\\n    }\\n  };\\n  const values = (i, v) => types.map((t, j) => (j === i ? v : FINE[name]?.[j]?.[t] ?? sampleOf(t)));\\n  const usual = tried(values(-1));\\n  return types.map((t, i) => (PROBES[t] ?? []).some((v) => tried(values(i, v)) !== usual));\\n}\\n\\n// One function (or the program). Types are worked out for the whole program at once: a variable's type is\\n// what every `set` of it agrees on.\\nclass Checker extends Scope \{\\n  constructor(parent, name, params, body, all, def = \{ kinds: [] }) \{\\n    super(parent, name, params, body);\\n    this.all = all;\\n    this.id = all.scopes++;\\n    this.def = def; // the `define` this function is, if it is one: its kinds, types, gives and madeKind\\n    this.maybeSkipped = 0; // inside the right side of `and`/`or`, which might not run, so nothing is certain\\n    this.returns = []; // what each `return` gives, for what a call of this function gives\\n    // inputs could be anything, but one that says what it is is that: each call checks it before the function\\n    // runs; and what it says beyond that is what it is, where the code is taken at its word\\n    params.forEach((p, i) => \{\\n      const key = this.source(p, () => (def.kinds[i] >= 0 ? KIND_TYPES[def.kinds[i]] : null));\\n      if (def.types?.[i]) all.declared.set(key, () => this.typeNamed(def.types[i], def.at));\\n    });\\n    if (def.gives) all.gives.set(def, () => this.typeNamed(def.gives, def.at));\\n    this.block(body);\\n    this.endsOpen = !ends(body); // whether it can reach its end, and give nothing there\\n    // what a call of it gives, worked out with the variables' types: what its returns give, and nothing at its end\\n    this.returnKey = `returns $\{this.id}`;\\n    all.sources.set(this.returnKey, [...this.returns, ...(this.endsOpen ? [() => \\\"nothing\\\"] : [])]);\\n    if (def.gives && this.endsOpen) \{\\n      this.typeCheck(def.at, () => \{\\n        const wanted = all.gives.get(def)();\\n        if (wanted !== \\\"nothing\\\" && !wanted?.startsWith(\\\"maybe:\\\")) found(`'$\{name}' must give $\{def.gives}, but it can reach its end without giving anything`);\\n      });\\n    }\\n  }\\n\\n  key(name) \{\\n    let [depth, slot] = this.resolve(name);\\n    let scope = this;\\n    while (depth--) scope = scope.parent;\\n    return `$\{scope.id}:$\{slot}`;\\n  }\\n\\n  source(name, type) \{\\n    const key = this.key(name);\\n    if (!this.all.sources.has(key)) this.all.sources.set(key, []);\\n    this.all.sources.get(key).push(type);\\n    return key;\\n  }\\n\\n  slotType(key) \{\\n    return this.all.types[this.all.mode].get(key);\\n  }\\n\\n  // `valued`: the problem rests on a value written out, not only on types, so moth check doesn't find it (see\\n  // dependsOn); it's kept where JSON and the tests that compare don't see it\\n  warn(at, kind, message, valued = false) \{\\n    if (at.file && kind === \\\"unused\\\") return; // a file the program uses can make more than this program needs\\n    const warning = \{ line: at.line, col: at.col, kind, message, ...(at.file && \{ file: at.file }) };\\n    if (valued) Object.defineProperty(warning, \\\"valued\\\", \{ value: true });\\n    this.all.warnings.push(warning);\\n  }\\n\\n  // Runs `test` once the types are known, first on what's sure, then on what the code says too: if it throws\\n  // the first time, this spot will fail whenever it runs; if only the second, it doesn't fit what the code says.\\n  willFail(at, test, valued = false) \{\\n    if (this.maybeSkipped) return;\\n    this.all.checks.push(() => \{\\n      for (const mode of [\\\"sure\\\", \\\"said\\\"]) \{\\n        this.all.mode = mode;\\n        try \{\\n          test();\\n        } catch (err) \{\\n          if (!(err instanceof Found)) throw err;\\n          return this.warn(at, mode === \\\"sure\\\" ? \\\"fails\\\" : \\\"doesn't fit\\\", err.message, valued || err.valued);\\n        }\\n      }\\n    });\\n  }\\n\\n  // Checks RULES[name] at `at`, with `args`, on the values of the expressions `operands`, once each one's type\\n  // is known (or only those `needs` says)\\n  rule(at, name, args, operands, needs = operands.map(() => true)) \{\\n    const types = operands.map((e) => this.type(e));\\n    this.willFail(at, () => \{\\n      const known = types.map((t) => t());\\n      if (known.every((t, i) => !needs[i] || this.known(t))) this.apply(name, args, operands, known);\\n    });\\n  }\\n\\n  // runs RULES[name] on a value for each operand: the value written out, or one of the type worked out for it\\n  apply(name, args, operands, types) \{\\n    const written = operands.map((e) => this.written(e));\\n    const values = types.map((t, i) => (written[i] !== undefined ? written[i] : FINE[name]?.[i]?.[base(t)] ?? sampleOf(base(t))));\\n    try \{\\n      RULES[name](args, ...values);\\n    } catch (err) \{\\n      if (!(err instanceof Found)) throw err;\\n      const depends = dependsOn(name, args, types.map(base));\\n      err.valued = written.some((w, i) => w !== undefined && depends[i]);\\n      throw err;\\n    }\\n  }\\n\\n  // the value an expression has where it's written out: a number, text, yes, no or nothing, or a number with a\\n  // `-` before it; undefined for any other\\n  written(e) \{\\n    if (e.kind === \\\"value\\\") return e.value;\\n    if (e.kind === \\\"negate\\\" && e.operand.kind === \\\"value\\\" && typeof e.operand.value === \\\"number\\\") return -e.operand.value;\\n    return undefined;\\n  }\\n\\n  // Runs `test` once the types are known, on what the code says too: if it throws, the code doesn't fit what\\n  // it says of itself (a `return` that gives what its `gives` doesn't). No run checks this, so it's never \\\"fails\\\".\\n  typeCheck(at, test) \{\\n    this.all.checks.push(() => \{\\n      this.all.mode = \\\"said\\\";\\n      try \{\\n        test();\\n      } catch (err) \{\\n        if (!(err instanceof Found)) throw err;\\n        this.warn(at, \\\"doesn't fit\\\", err.message);\\n      }\\n    });\\n  }\\n\\n  // The type an input's `as`, or a `gives`, names, as written: \\\"a number\\\", \\\"a dog\\\", \\\"a list of numbers\\\", or\\n  // \\\"a dog or nothing\\\", which is \\\"maybe:record:dog\\\" and says too little to check anything by but a `return`.\\n  // `at` is where a kind it names that the program doesn't make is said to be wrong, once.\\n  typeNamed(words, at) \{\\n    if (words === \\\"nothing\\\") return \\\"nothing\\\";\\n    if (words.endsWith(\\\" or nothing\\\")) \{\\n      const inner = this.typeNamed(words.slice(0, -11), at);\\n      return inner === \\\"nothing\\\" ? inner : `maybe:$\{inner}`;\\n    }\\n    const kind = KINDS.indexOf(words);\\n    if (kind >= 0) return KIND_TYPES[kind];\\n    if (words.startsWith(\\\"a list of \\\")) \{\\n      const items = this.itemsNamed(words.slice(10), at);\\n      return items === null ? \\\"list\\\" : `list:$\{items}`;\\n    }\\n    return this.kindNamed(words.replace(/^an? /, \\\"\\\"), at, false) ?? \\\"record\\\";\\n  }\\n\\n  itemsNamed(words, at) \{\\n    if (words.startsWith(\\\"lists of \\\")) \{\\n      const items = this.itemsNamed(words.slice(9), at);\\n      return items === null ? \\\"list\\\" : `list:$\{items}`;\\n    }\\n    if (Object.hasOwn(ITEM_WORDS, words) || words === \\\"texts\\\") return ITEM_WORDS[words] ?? \\\"text\\\";\\n    return this.kindNamed(words, at, true);\\n  }\\n\\n  // \\\"record:dog\\\", for a kind the program makes called `name` (or, `many`, the kind `name` is more than one\\n  // of: dogs, boxes, puppies), or null, having said there's none\\n  kindNamed(name, at, many) \{\\n    const kinds = this.all.kinds;\\n    const singular = !many ? [name] : [name, name.replace(/s$/, \\\"\\\"), name.replace(/es$/, \\\"\\\"), name.replace(/ies$/, \\\"y\\\")];\\n    const kind = singular.find((n) => kinds.has(n));\\n    if (kind) return `record:$\{kind}`;\\n    const key = `$\{at.line}:$\{at.col}:$\{name}`;\\n    if (!this.all.unknownKinds.has(key)) \{\\n      this.all.unknownKinds.add(key);\\n      const guess = closest(singular.at(-1), [...kinds.keys()]) ?? closest(name, [...kinds.keys()]);\\n      this.warn(at, \\\"doesn't fit\\\", `there is no kind called '$\{name}'$\{guess ? `. Did you mean '$\{guess}'?` : \\\"\\\"}`);\\n    }\\n    return null;\\n  }\\n\\n  // What we can know about an expression: its type (a function, since types settle later) and its value, if written out.\\n  type(e) \{\\n    switch (e.kind) \{\\n      case \\\"value\\\": \{\\n        const t = literalType(e.value);\\n        return () => t;\\n      }\\n      case \\\"name\\\": \{\\n        const key = this.resolve(e.name) && this.key(e.name);\\n        return () => (key ? this.slotType(key) : null);\\n      }\\n      case \\\"math\\\": \{\\n        const [left, right] = [this.type(e.left), this.type(e.right)];\\n        return () => \{\\n          const [a, b] = [base(left()), base(right())];\\n          if (a === undefined || b === undefined) return undefined;\\n          if (e.op === \\\"+\\\" && (a === \\\"text\\\" || b === \\\"text\\\")) return \\\"text\\\";\\n          return this.known(a, b) ? resultTypeOf(e.op, a, b) : null;\\n        };\\n      }\\n      case \\\"compare\\\":\\n      case \\\"not\\\":\\n        return () => \\\"yes/no\\\";\\n      case \\\"negate\\\": \{ // a number, or an amount (which keeps its unit); fails on anything else\\n        const operand = this.type(e.operand);\\n        return () => \{\\n          const t = base(operand());\\n          return MEASURE_TYPES.includes(t) ? t : t === null ? null : t === undefined ? undefined : \\\"number\\\";\\n        };\\n      }\\n      case \\\"length\\\":\\n      case \\\"random\\\":\\n        return () => \\\"number\\\";\\n      case \\\"now\\\": // `the time`, `the date` and `the weekday` are text; the rest are numbers\\n        return () => ([\\\"time\\\", \\\"date\\\", \\\"weekday\\\"].includes(NOW_WORDS[e.which]) ? \\\"text\\\" : \\\"number\\\");\\n      case \\\"builtin\\\": \{\\n        if (e.name === \\\"unit\\\" || e.name === \\\"in\\\") return () => unitType(e.args[1].value); // `5 km`, `trip in miles`\\n        const \{ gives } = BUILTINS.find((b) => b.name === e.name);\\n        return () => gives;\\n      }\\n      case \\\"ask\\\":\\n        return () => \\\"text\\\";\\n      case \\\"read\\\":\\n        return () => (e.bytes ? \\\"bytes\\\" : \\\"text\\\");\\n      case \\\"arguments\\\":\\n      case \\\"readFolder\\\":\\n      case \\\"list\\\":\\n        return () => \\\"list\\\";\\n      case \\\"record\\\":\\n        return () => \\\"record\\\";\\n      case \\\"dictionary\\\":\\n        return () => \\\"dictionary\\\";\\n      case \\\"field\\\": \{ // a field of a record a kind makes is what the kind's input says it is\\n        const of = this.type(e.of);\\n        return () => this.fieldType(of(), e.name);\\n      }\\n      case \\\"item\\\": \{ // where the code says what a list holds, an item of it is that\\n        const of = this.type(e.of);\\n        return () => (of() === undefined ? undefined : this.all.mode === \\\"said\\\" ? holds(of()) : null);\\n      }\\n      case \\\"call\\\":\\n        return this.callType(e);\\n      default: // and/or: could be anything\\n        return () => null;\\n    }\\n  }\\n\\n  // what a call gives: what a kind makes, or what a function returns, where the name is a function made once\\n  // and never anything else; and, where the code is taken at its word, what its `gives` says\\n  callType(e) \{\\n    if (!this.resolve(e.name)) return () => null;\\n    const key = this.key(e.name);\\n    return () => \{\\n      const made = this.all.defines.get(key);\\n      if (made?.length !== 1 || this.all.sources.get(key).length !== 1) return null;\\n      const [\{ define, checker }] = made;\\n      if (define.madeKind) return `record:$\{define.madeKind}`;\\n      if (this.all.mode === \\\"said\\\" && define.gives) \{\\n        const said = this.all.gives.get(define)();\\n        return said?.startsWith(\\\"maybe:\\\") ? null : said;\\n      }\\n      return this.slotType(checker.returnKey);\\n    };\\n  }\\n\\n  // what field `name` of a value of type `of` is: for a record the kind K makes, what K's input says it is, or\\n  // a function for one of K's own; null where it can't be known, or where anything in the program changes it\\n  fieldType(of, name) \{\\n    if (of === undefined) return undefined;\\n    const kind = typeof of === \\\"string\\\" && of.startsWith(\\\"record:\\\") && this.all.kinds.get(of.slice(7));\\n    if (!kind || this.all.fieldsSet.has(name)) return null;\\n    if (name === \\\"kind\\\") return \\\"text\\\";\\n    for (let k = kind, seen = 0; k && seen < 100; k = this.all.kinds.get(this.parentKind(k)), seen++) \{\\n      const \{ define } = k;\\n      const i = define.params.indexOf(name);\\n      if (i >= 0) return define.kinds[i] < 0 ? null : this.all.mode === \\\"said\\\" && define.types?.[i] ? this.typeNamed(define.types[i], define.at) : KIND_TYPES[define.kinds[i]];\\n      if (k.owns.includes(name)) return \\\"function\\\";\\n    }\\n    return null;\\n  }\\n\\n  // the kind a kind is made from (`kind puppy with name from dog(name)`), if it's made from one\\n  parentKind(kind) \{\\n    return kind?.from ? this.all.makers.get(kind.from) : undefined;\\n  }\\n\\n  // every field a record the kind K makes has, in the order it has them, or null if that can't be known\\n  fieldsOf(name, seen = new Set()) \{\\n    const kind = this.all.kinds.get(name);\\n    if (!kind || seen.has(name)) return null;\\n    seen.add(name);\\n    const [start, ...rest] = kind.define.body;\\n    let fields;\\n    if (start.value.kind === \\\"record\\\") fields = [...start.value.fields];\\n    else if (this.parentKind(kind)) fields = this.fieldsOf(this.parentKind(kind), seen);\\n    if (!fields) return null;\\n    for (const s of rest) if (s.kind === \\\"setField\\\" && !fields.includes(s.name)) fields.push(s.name);\\n    return fields;\\n  }\\n\\n  sample(e, type = base(this.type(e)())) \{\\n    return e.kind === \\\"value\\\" ? e.value : SAMPLES[type];\\n  }\\n\\n  known(...types) \{\\n    return types.every((t) => t !== undefined && t !== null && base(t) !== \\\"function\\\");\\n  }\\n\\n  // whether a value of type `t` is what `wanted` (a type typeNamed made) says: yes, no, or null if it can't be known\\n  fits(t, wanted) \{\\n    if (t === undefined || t === null || wanted === undefined || wanted === null) return null;\\n    if (wanted.startsWith(\\\"maybe:\\\")) return t === \\\"nothing\\\" ? true : this.fits(t, wanted.slice(6));\\n    if (base(t) !== base(wanted)) return false;\\n    if (wanted.startsWith(\\\"record:\\\")) \{\\n      if (!t.startsWith(\\\"record:\\\")) return null; // a record that may be one\\n      for (let k = t.slice(7), seen = 0; k && seen < 100; k = this.parentKind(this.all.kinds.get(k)), seen++) if (k === wanted.slice(7)) return true;\\n      return false;\\n    }\\n    if (wanted.startsWith(\\\"list:\\\")) return t.startsWith(\\\"list:\\\") ? this.fits(t.slice(5), wanted.slice(5)) : null;\\n    return true;\\n  }\\n\\n  block(body) \{\\n    for (const [i, s] of body.entries()) \{\\n      this.statement(s);\\n      if (ENDINGS.has(s.kind) && body[i + 1]) \{\\n        this.warn(body[i + 1].at, \\\"never runs\\\", `this line can never run, because '$\{ENDINGS.get(s.kind)}' comes first`);\\n        break;\\n      }\\n    }\\n  }\\n\\n  undefinedName(name, at, options) \{\\n    if (!this.maybeSkipped) this.warn(at, \\\"fails\\\", this.undefinedMessage(name, options));\\n  }\\n\\n  statement(s) \{\\n    switch (s.kind) \{\\n      case \\\"set\\\": \{\\n        this.expr(s.value);\\n        const key = this.source(s.name, this.type(s.value));\\n        if (!this.all.made.has(key)) this.all.made.set(key, \{ at: s.at, message: `'$\{s.name}' is set but never used` });\\n        return;\\n      }\\n      case \\\"setItem\\\": \{\\n        const target = s.target.of;\\n        this.expr(target);\\n        this.expr(s.target.index);\\n        this.expr(s.value);\\n        this.rule(s.target.at, \\\"setItem\\\", [], [target]);\\n        return;\\n      }\\n      case \\\"add\\\": \{\\n        this.expr(s.value);\\n        if (!this.resolve(s.name)) return this.undefinedName(s.name, s.at);\\n        const key = this.key(s.name);\\n        this.all.used.add(key);\\n        const value = this.type(s.value);\\n        this.source(s.name, () => \{\\n          const [current, v] = [this.slotType(key), value()];\\n          if (base(current) === \\\"list\\\") return holds(current) && this.fits(v, holds(current)) === false ? \\\"list\\\" : current;\\n          if (current === \\\"text\\\") return current;\\n          if (current === \\\"number\\\" && v === \\\"number\\\") return \\\"number\\\";\\n          if (MEASURE_TYPES.includes(current) && v === current) return current; // `add 300 m to trip`\\n          // an add that will fail doesn't change the type: the program stops there\\n          return current === undefined || v === undefined || this.known(current, v) ? undefined : null;\\n        });\\n        this.rule(s.at, \\\"add\\\", [s.name], [\{ kind: \\\"name\\\", name: s.name, at: s.at }, s.value]);\\n        this.willFail(s.at, () => \{ // and what the code says a list holds is all it gets\\n          const [current, v] = [this.slotType(key), value()];\\n          if (this.known(current, v) && holds(current) && this.fits(v, holds(current)) === false) found(`can't add $\{described(v)} to $\{described(current)}`);\\n        });\\n        return;\\n      }\\n      case \\\"say\\\":\\n        for (const part of s.parts) this.expr(part);\\n        return;\\n      case \\\"if\\\":\\n        this.expr(s.cond);\\n        this.block(s.then);\\n        this.block(s.otherwise);\\n        return;\\n      case \\\"while\\\":\\n        this.expr(s.cond);\\n        this.block(s.body);\\n        return;\\n      case \\\"repeat\\\":\\n        this.expr(s.count);\\n        if (s.count.kind === \\\"value\\\") this.willFail(s.at, () => checkRepeat(s.count.value, found), true);\\n        this.block(s.body);\\n        return;\\n      case \\\"count\\\": \{\\n        this.expr(s.from);\\n        this.expr(s.to);\\n        this.source(s.name, () => \\\"number\\\");\\n        this.rule(s.at, \\\"count\\\", [], [s.from, s.to]);\\n        this.block(s.body);\\n        return;\\n      }\\n      case \\\"each\\\": \{\\n        this.expr(s.list);\\n        const list = this.type(s.list);\\n        // a list's items could be anything, unless the code says what it holds\\n        this.source(s.name, () => (list() === undefined ? undefined : list() === \\\"text\\\" ? \\\"text\\\" : this.all.mode === \\\"said\\\" ? holds(list()) : null));\\n        this.rule(s.at, \\\"each\\\", [], [s.list]);\\n        this.block(s.body);\\n        return;\\n      }\\n      case \\\"define\\\": \{\\n        const key = this.source(s.name, () => \\\"function\\\");\\n        const isTest = !this.parent && s.name.startsWith(\\\"test_\\\"); // the test runner, test() in moth.js, calls it\\n        if (!this.all.made.has(key) && !isTest) this.all.made.set(key, \{ at: s.at, message: `'$\{s.name}' is made but never used` });\\n        if (s.madeKind) \{ // what a record the kind makes holds: its maker's inputs, its own functions, and what it's made from\\n          const from = s.body[0].value.kind === \\\"call\\\" ? s.body[0].value.name : null;\\n          const owns = s.body.filter((b) => b.kind === \\\"setField\\\" && b.value.kind === \\\"name\\\" && b.value.name === `$\{s.name}'s $\{b.name}`).map((b) => b.name);\\n          if (!this.all.kinds.has(s.madeKind)) this.all.kinds.set(s.madeKind, \{ define: s, from, owns });\\n          this.all.makers.set(s.name, s.madeKind);\\n        }\\n        const checker = new Checker(this, s.name, s.params, s.body, this.all, s);\\n        this.all.defines.set(key, [...(this.all.defines.get(key) ?? []), \{ define: s, checker }]);\\n        return;\\n      }\\n      case \\\"every\\\": \{ // how often must be a number\\n        this.expr(s.interval);\\n        this.rule(s.at, \\\"every\\\", [s.unit], [s.interval]);\\n        new Checker(this, s.fn.name, s.fn.params, s.fn.body, this.all);\\n        return;\\n      }\\n      case \\\"when\\\":\\n        if (s.label) this.expr(s.label); // the button or text box it waits for\\n        new Checker(this, s.fn.name, s.fn.params, s.fn.body, this.all);\\n        return;\\n      case \\\"return\\\": \{\\n        if (s.value) this.expr(s.value);\\n        const type = s.value ? this.type(s.value) : () => \\\"nothing\\\";\\n        this.returns.push(type);\\n        const \{ gives } = this.def;\\n        if (gives) \{ // what it gives must be what it says it gives\\n          this.typeCheck(s.at, () => \{\\n            if (this.fits(type(), this.all.gives.get(this.def)()) === false) found(`'$\{this.fn.name}' must give $\{gives}, not $\{described(type())}`);\\n          });\\n        }\\n        return;\\n      }\\n      case \\\"fail\\\": // stopping on purpose is not a mistake\\n        this.expr(s.value);\\n        return;\\n      case \\\"stop\\\":\\n        return;\\n      case \\\"exit\\\": \{ // the number it stops with must be a whole number from 0 to 255\\n        if (!s.value) return;\\n        this.expr(s.value);\\n        this.rule(s.at, \\\"exit\\\", [], [s.value]);\\n        return;\\n      }\\n      case \\\"remove\\\": \{ // which keys a dictionary has isn't known, so only removing from something else is certain to fail\\n        this.expr(s.key);\\n        this.expr(s.target);\\n        this.rule(s.at, \\\"remove\\\", [], [s.target]);\\n        return;\\n      }\\n      case \\\"expect\\\": \{ // whether it is so is up to the values; only comparing kinds that can't be compared is certain to fail\\n        const c = s.cond;\\n        if (c.kind !== \\\"compare\\\") return this.expr(c);\\n        this.expr(c.left);\\n        this.expr(c.right);\\n        if (c.op !== \\\"is\\\") this.rule(s.at, \\\"compare\\\", [c.op], [c.left, c.right]);\\n        return;\\n      }\\n      case \\\"write\\\": \{ // whether the file can be written isn't known, so only a name that isn't text is certain to fail\\n        this.expr(s.value);\\n        this.expr(s.target);\\n        this.rule(s.at, \\\"write\\\", [], [s.target]);\\n        return;\\n      }\\n      case \\\"removeFile\\\": \{ // as with `write`, only a name that isn't text is certain to fail\\n        this.expr(s.target);\\n        this.rule(s.at, \\\"removeFile\\\", [], [s.target]);\\n        return;\\n      }\\n      case \\\"wait\\\": \{ // how long must be a number of 0 or more\\n        this.expr(s.amount);\\n        this.rule(s.at, \\\"wait\\\", [s.unit], [s.amount]);\\n        return;\\n      }\\n      case \\\"try\\\": // inside it, a mistake is caught, so nothing in it is certain to stop the program\\n        this.maybeSkipped++;\\n        this.block(s.body);\\n        this.maybeSkipped--;\\n        if (s.name) this.source(s.name, () => null); // a message, or whatever `fail with` gave\\n        this.block(s.handler);\\n        return;\\n      case \\\"setField\\\": \{\\n        this.expr(s.target);\\n        this.expr(s.value);\\n        if (!this.def.madeKind) this.all.fieldsSet.add(s.name); // a record's field can then be anything\\n        this.rule(s.at, \\\"setField\\\", [s.name], [s.target]);\\n        return;\\n      }\\n      case \\\"call\\\":\\n        this.call(s, true);\\n        return;\\n      case \\\"do\\\":\\n        this.expr(s.value);\\n        return;\\n      case \\\"play\\\": \{ // a note or a time of the wrong kind fails, and so does one written out wrong\\n        if (!s.note) return; // a beep\\n        this.expr(s.note);\\n        this.expr(s.time);\\n        const [note, time] = [this.type(s.note), this.type(s.time)];\\n        this.willFail(s.at, () => \{ // the value written out (`\\\"H\\\"`, `-1`), or one of the type that can't fail (FINE)\\n          if (!this.known(note())) return;\\n          if (!this.known(time())) return this.apply(\\\"note\\\", [], [s.note], [note()]);\\n          this.apply(\\\"play\\\", [s.unit], [s.note, s.time], [note(), time()]);\\n        });\\n        return;\\n      }\\n      case \\\"turtle\\\": \{\\n        if (!s.value) return;\\n        this.expr(s.value);\\n        const action = TURTLE_ACTIONS.indexOf(s.action);\\n        if (s.action === \\\"picture\\\") \{ // whether a file is a picture isn't known: only what is neither a name nor bytes is sure to fail\\n          this.rule(s.at, \\\"picture\\\", [], [s.value.items[0]]);\\n          return;\\n        }\\n        if (s.value.kind === \\\"list\\\" && s.action !== \\\"forward\\\") return; // `move to`, `draw ...`: what's in the list isn't known\\n        // the width check depends on the value, so it only runs when the width is written out\\n        if (s.action === \\\"width\\\" ? s.value.kind === \\\"value\\\" : true) this.rule(s.at, \\\"turtle\\\", [action], [s.value]);\\n        return;\\n      }\\n    }\\n  }\\n\\n  call(e, statement = false) \{\\n    if (!this.resolve(e.name)) return this.undefinedName(e.name, e.at, \{ call: true, statement });\\n    const key = this.key(e.name);\\n    this.all.used.add(key);\\n    for (const arg of e.args) this.expr(arg);\\n    const types = e.args.map((arg) => this.type(arg));\\n    this.willFail(e.at, () => \{\\n      const type = this.slotType(key);\\n      if (this.known(type)) callable(SAMPLES[base(type)], e.name, found); // not a function at all\\n      const made = this.all.defines.get(key);\\n      // the number of inputs is only certain when the name is a function made exactly once, and never anything else\\n      if (type === \\\"function\\\" && made?.length === 1 && this.all.sources.get(key).length === 1) \{\\n        const [\{ define }] = made;\\n        const \{ params, kinds } = define;\\n        checkInputs(\{ fn: \{ params } }, e.args.length, e.name, found);\\n        // and an input that says what it is must get that, where the checker knows what it gets\\n        const sure = kinds.map((k, i) => (types[i]() === undefined || types[i]() === null ? -1 : k));\\n        checkKinds(\{ fn: \{ params, kinds: sure } }, e.args.map((arg, i) => (sure[i] >= 0 ? this.sample(arg, base(types[i]())) : null)), e.name, found);\\n        // what it says beyond that, which no run checks, is checked by what the code says too\\n        if (this.all.mode === \\\"said\\\" && define.types) \{\\n          define.types.forEach((words, i) => \{\\n            if (words && this.fits(types[i](), this.typeNamed(words, define.at)) === false) found(`'$\{e.name}' needs $\{params[i]} to be $\{words}, not $\{described(types[i]())}`);\\n          });\\n        }\\n      }\\n      this.ownCall(e, types);\\n    });\\n  }\\n\\n  // `rex's speak()`, where rex is surely a dog: dog has no `speak`, and nothing gives a record one (see ownCalls in moth.js)\\n  ownCall(e, types) \{\\n    const helper = this.all.defines.get(this.key(e.name))?.[0]?.define;\\n    const tried = helper?.params[0] === \\\"the record\\\" && helper.body[0]?.kind === \\\"try\\\" ? helper.body[0] : null;\\n    const kind = tried && types[0]?.();\\n    if (typeof kind !== \\\"string\\\" || !kind.startsWith(\\\"record:\\\")) return;\\n    const own = tried.body[0].name;\\n    const fields = this.fieldsOf(kind.slice(7));\\n    if (fields && !fields.includes(own) && !this.all.fieldsSet.has(own)) found(tried.handler[0].value.value);\\n  }\\n\\n  expr(e) \{\\n    switch (e.kind) \{\\n      case \\\"name\\\":\\n        if (this.resolve(e.name)) this.all.used.add(this.key(e.name));\\n        else this.undefinedName(e.name, e.at);\\n        return;\\n      case \\\"call\\\":\\n        return this.call(e);\\n      case \\\"math\\\": \{\\n        this.expr(e.left);\\n        this.expr(e.right);\\n        this.rule(e.at, \\\"math\\\", [e.op], [e.left, e.right]);\\n        return;\\n      }\\n      case \\\"compare\\\": \{\\n        this.expr(e.left);\\n        this.expr(e.right);\\n        if (e.op !== \\\"is\\\") this.rule(e.at, \\\"compare\\\", [e.op], [e.left, e.right]);\\n        return;\\n      }\\n      case \\\"and\\\":\\n      case \\\"or\\\":\\n        this.expr(e.left);\\n        this.maybeSkipped++;\\n        this.expr(e.right);\\n        this.maybeSkipped--;\\n        return;\\n      case \\\"not\\\":\\n        return this.expr(e.operand);\\n      case \\\"negate\\\": \{\\n        this.expr(e.operand);\\n        this.rule(e.at, \\\"negate\\\", [], [e.operand]);\\n        return;\\n      }\\n      case \\\"list\\\":\\n        for (const x of e.items) this.expr(x);\\n        return;\\n      case \\\"record\\\":\\n        for (const value of e.values) this.expr(value);\\n        return;\\n      case \\\"dictionary\\\":\\n        for (const x of e.items) this.expr(x);\\n        return;\\n      case \\\"field\\\": \{ // which fields a record has isn't known, so only taking a field of something else is certain to fail\\n        this.expr(e.of);\\n        const type = this.type(e.of);\\n        this.willFail(e.at, () => \{\\n          const t = type();\\n          if (!this.known(t)) return;\\n          if (base(t) !== \\\"record\\\") this.apply(\\\"field\\\", [e.name], [e.of], [t]);\\n          // but a record a kind makes has the fields the kind gives it, and only those, unless something adds one\\n          const fields = t.startsWith(\\\"record:\\\") && this.fieldsOf(t.slice(7));\\n          if (fields && !fields.includes(e.name) && !this.all.fieldsSet.has(e.name)) fieldOf(makeRecord(fields, fields), e.name, found);\\n        });\\n        return;\\n      }\\n      case \\\"length\\\": \{\\n        this.expr(e.of);\\n        this.rule(e.at, \\\"length\\\", [], [e.of]);\\n        return;\\n      }\\n      case \\\"ask\\\":\\n        this.expr(e.question);\\n        return;\\n      case \\\"now\\\":\\n        return;\\n      case \\\"random\\\": \{ // only numbers that aren't numbers at all are certain to fail\\n        this.expr(e.left);\\n        this.expr(e.right);\\n        this.rule(e.at, \\\"random\\\", [], [e.left, e.right]);\\n        return;\\n      }\\n      case \\\"read\\\": \{ // as with `write`, only a name that isn't text is certain to fail\\n        this.expr(e.of);\\n        this.rule(e.at, \\\"read\\\", [e.bytes], [e.of]);\\n        return;\\n      }\\n      case \\\"readFolder\\\": \{ // as with `read`, only a name that isn't text is certain to fail\\n        this.expr(e.of);\\n        this.rule(e.at, \\\"readFolder\\\", [], [e.of]);\\n        return;\\n      }\\n      case \\\"builtin\\\": \{ // fails when an input is known to be the wrong kind; what the values are is left to run time\\n        for (const arg of e.args) this.expr(arg);\\n        this.rule(e.at, \\\"builtin\\\", [e.name], e.args);\\n        return;\\n      }\\n      case \\\"item\\\": \{\\n        this.expr(e.of);\\n        this.expr(e.index);\\n        // which keys a dictionary has isn't known, so only taking an item of what's none of these is certain to fail\\n        this.rule(e.at, \\\"item\\\", [], [e.of]);\\n        // and the index is only certain when it is written out; the length of the list never is\\n        const type = this.type(e.of);\\n        if (e.index.kind === \\\"value\\\") \{\\n          this.willFail(e.at, () => \{\\n            const [t, n] = [base(type()), e.index.value];\\n            if ((t === \\\"list\\\" || t === \\\"text\\\" || t === \\\"bytes\\\") && !(typeof n === \\\"number\\\" && Number.isInteger(n) && n >= 1)) item(t === \\\"text\\\" ? \\\"x\\\" : [\\\"x\\\"], n, false, found);\\n          }, true);\\n        }\\n        return;\\n      }\\n    }\\n  }\\n}\\n\\n// whether a block can't reach its end: its last statement returns, fails or stops the program, or is an `if`\\n// whose every way does (a loop around a `return` may still end, so it doesn't count)\\nfunction ends(body) \{\\n  const last = body.at(-1);\\n  if (!last) return false;\\n  if (last.kind === \\\"return\\\" || last.kind === \\\"fail\\\" || last.kind === \\\"exit\\\") return true;\\n  if (last.kind === \\\"if\\\") return ends(last.then) && ends(last.otherwise);\\n  if (last.kind === \\\"several\\\") return ends(last.body);\\n  return false;\\n}\\n\\n// Every problem in a parsed program, in order: \{ line, col, kind, message }, where kind is \\\"fails\\\" (this\\n// line stops the program whenever it runs), \\\"doesn't fit\\\" (it goes against what the code says of itself),\\n// \\\"never runs\\\", or \\\"unused\\\".\\nexport function check(program) \{\\n  const all = \{ scopes: 0, sources: new Map(), types: \{ sure: new Map(), said: new Map() }, mode: \\\"sure\\\", checks: [], warnings: [], used: new Set(),\\n    made: new Map(), defines: new Map(), declared: new Map(), gives: new Map(), kinds: new Map(), makers: new Map(), fieldsSet: new Set(),\\n    unknownKinds: new Set() };\\n  new Checker(null, \\\"main\\\", [], program, all);\\n  // Work out every variable's type: repeat until nothing changes. A type can only go from unknown, to one\\n  // type, to one that says less, to \\\"could be several\\\", so this stops after a few rounds. Then again, with\\n  // what the code says of itself, where an input that says what it is is that.\\n  for (const mode of [\\\"sure\\\", \\\"said\\\"]) \{\\n    all.mode = mode;\\n    const types = all.types[mode];\\n    for (let changed = true; changed; ) \{\\n      changed = false;\\n      for (const [key, sources] of all.sources) \{\\n        let type;\\n        if (mode === \\\"said\\\" && all.declared.has(key)) type = all.declared.get(key)();\\n        else for (const source of sources) type = join(type, source());\\n        if (type !== types.get(key)) \{\\n          types.set(key, type);\\n          changed = true;\\n        }\\n      }\\n    }\\n  }\\n  all.mode = \\\"said\\\";\\n  for (const gives of all.gives.values()) gives(); // a kind a `gives` names that the program doesn't make\\n  for (const run of all.checks) run();\\n  for (const [key, \{ at, message }] of all.made) \{\\n    if (!all.used.has(key) && !at.file) all.warnings.push(\{ line: at.line, col: at.col, kind: \\\"unused\\\", message }); // a used file can make more than one program needs\\n  }\\n  const seen = new Set();\\n  return all.warnings\\n    .filter((w) => !seen.has(`$\{w.line}:$\{w.col}:$\{w.message}`) && seen.add(`$\{w.line}:$\{w.col}:$\{w.message}`))\\n    .sort((a, b) => a.line - b.line || a.col - b.col);\\n}\\n\",\"moth.js\":\"// Moth: a small programming language that reads like plain English.\\n// Source text -> tokens -> syntax tree -> bytecode (this file) -> the virtual machine (vm.js).\\n\\nimport \{ MothError, Ended, fail, closest, startTasks, seeded, fakeClock, NOW_WORDS, EVENTS, KINDS, Turtle, callFunction, makeRecord, catchable, caughtValue, COMPARISONS, COMPARE_OPS, OP, OPCODES, TURTLE_ACTIONS, BUILTINS, UNSET, Closure, Machine, execute, isRecord, UNITS, unitNamed } from \\\"./vm.js\\\";\\nimport \{ Scope, declarations } from \\\"./scope.js\\\";\\nimport \{ jit, fromJs, TooDeep } from \\\"./jit.js\\\";\\nimport \{ wasm, wasmProgram, wasmFile, compileToWasmModule } from \\\"./wasm.js\\\";\\nimport \{ check as checkProgram } from \\\"./checker.js\\\";\\n\\nexport \{ MothError, excerpt, describeTrail, seeded, soundSamples, soundWav, SOUND_RATE } from \\\"./vm.js\\\";\\n\\n// ---------- tokens ----------\\n\\n// Every control character counts as a space (as in Wirth's compilers), and text holds any character but a\\n// control character other than tab (\\\\n makes a new line). Rules this small let the compiler written in Moth,\\n// which has no character codes, follow them exactly. Of text this finds only the opening quote: textEnd finds\\n// where it ends, as text can be inside text.\\nconst TOKEN = /([\\\\0-\\\\x20]+)|(#[^\\\\n]*)|(0x[\\\\da-fA-F]+|0b[01]+|\\\\d+(?:\\\\.\\\\d+)?)|([A-Za-z_]\\\\w*)|(\\\")|([-+*/(),]|'s(?!\\\\w))/y;\\nconst ESCAPES = \{ n: \\\"\\\\n\\\", t: \\\"\\\\t\\\" };\\nconst unescape = (raw) => raw.replace(/\\\\\\\\(.)/gs, (_, c) => ESCAPES[c] ?? c);\\nconst fitsText = (c) => c !== undefined && !/[\\\\0-\\\\x08\\\\n-\\\\x1f]/.test(c);\\n// a '\{' right before one of these starts a value in text: a name, or a bracket\\nconst startsValue = (c) => c !== undefined && /[A-Za-z_(]/.test(c);\\n// what a mistake in a value inside text adds, for text written before there were values in it\\nconst BRACE_HINT = \\\"to write a '\{' itself, put '\\\\\\\\' before it\\\";\\n// symbols people type out of habit from other languages, and what Moth says instead\\nconst HINTS = \{\\n  \\\"=\\\": \\\"to store a value write 'set x to 5', to compare write 'x is 5'\\\",\\n  \\\"!\\\": \\\"write 'is not'\\\",\\n  \\\"<\\\": \\\"write 'is less than'\\\",\\n  \\\">\\\": \\\"write 'is greater than'\\\",\\n  \\\"%\\\": \\\"write 'is divisible by'\\\",\\n  \\\"[\\\": \\\"make a list with 'list of 1, 2, 3'\\\",\\n  \\\"]\\\": \\\"make a list with 'list of 1, 2, 3'\\\",\\n  \\\"\{\\\": \\\"blocks finish with 'end', not braces\\\",\\n  \\\"}\\\": \\\"blocks finish with 'end', not braces\\\",\\n  \\\"'\\\": \\\"put text in double quotes\\\",\\n  \\\".\\\": \\\"to get a field write 'name of person'\\\",\\n};\\n\\n// Text that starts with the quote at `at`: `\{ end }`, just past its closing quote, or what's missing, `\{ quote:\\n// true }` if the line ends first, or `\{ brace }`, the '\{' of a value in it that never ends. A value\\n// (\\\"Hi \{name}\\\") ends at its own '}', and can have text of its own inside it.\\nfunction textEnd(src, at) \{\\n  for (let i = at + 1; ; ) \{\\n    const c = src[i];\\n    if (c === '\\\"') return \{ end: i + 1 };\\n    if (c === \\\"\\\\\\\\\\\" && fitsText(src[i + 1])) i += 2;\\n    else if (!fitsText(c)) return \{ quote: true };\\n    else if (c === \\\"\{\\\" && startsValue(src[i + 1])) \{\\n      const value = valueEnd(src, i);\\n      if (value.brace !== undefined) return value;\\n      i = value.end + 1;\\n    } else i++;\\n  }\\n}\\n\\n// The value in text whose '\{' is at `at`: `\{ end }`, its '}', or `\{ brace: at }` if nothing ends it, the text\\n// inside it included.\\nfunction valueEnd(src, at) \{\\n  for (let i = at + 1; ; ) \{\\n    const c = src[i];\\n    if (c === \\\"}\\\") return \{ end: i };\\n    if (!fitsText(c)) return \{ brace: at };\\n    if (c !== '\\\"') i++;\\n    else \{\\n      const inside = textEnd(src, i);\\n      if (inside.end === undefined) return \{ brace: at };\\n      i = inside.end;\\n    }\\n  }\\n}\\n\\n// `file` names a file the program uses, for errors in it; the program's own file has none. `start`, for a\\n// value inside text (\\\"Hi \{name}\\\"), is where it starts: its tokens are counted from there, and end with a '}'.\\nfunction tokenize(src, file, start) \{\\n  const tokens = [];\\n  let line = start ? start.line : 1;\\n  let lineStart = start ? 1 - start.col : 0;\\n  let nl = !start; // does the next token start a new line?\\n  const place = (i) => (file ? \{ line, col: i - lineStart + 1, file } : \{ line, col: i - lineStart + 1 });\\n  for (let at = 0; at < src.length; at = TOKEN.lastIndex) \{\\n    TOKEN.lastIndex = at;\\n    const m = TOKEN.exec(src);\\n    const where = place(at);\\n    if (!m) \{\\n      const c = String.fromCodePoint(src.codePointAt(at)); // a whole emoji, not half of one\\n      const hint = start ? BRACE_HINT : HINTS[c];\\n      fail(where, `I don't understand '$\{c}'$\{start || Object.hasOwn(HINTS, c) ? ` ($\{hint})` : \\\"\\\"}`);\\n    }\\n    let [text, space, comment, number, word, string] = m;\\n    if (string) \{\\n      const \{ end, brace } = textEnd(src, at);\\n      if (brace !== undefined) fail(place(brace), `this '\{' has no '}' to end it ($\{BRACE_HINT})`);\\n      if (end === undefined) fail(where, \\\"this text is missing its closing quote\\\");\\n      text = src.slice(at, end);\\n    }\\n    if (space || comment) \{\\n      const newlines = text.split(\\\"\\\\n\\\").length - 1;\\n      if (newlines) \{\\n        line += newlines;\\n        lineStart = at + text.lastIndexOf(\\\"\\\\n\\\") + 1;\\n        nl = true;\\n      }\\n      continue;\\n    }\\n    const [type, value] = number\\n      ? [\\\"number\\\", Number(number)]\\n      : word\\n        ? [\\\"word\\\", word.toLowerCase()]\\n        : string\\n          ? [\\\"string\\\", unescape(text.slice(1, -1))]\\n          : [text, text];\\n    const token = \{ type, value, ...where, nl };\\n    if (word) token.raw = word; // as written: a library's function is named in its own case (see library)\\n    if (number) token.text = number; // as written, for messages and the JIT\\n    if (string) \{\\n      const parts = textParts(src, at + 1, at + text.length - 1, place, file);\\n      if (parts) token.parts = parts;\\n      TOKEN.lastIndex = at + text.length; // past the text, which reading a value in it moved\\n    }\\n    tokens.push(token);\\n    nl = false;\\n  }\\n  if (start) tokens.push(\{ type: \\\"}\\\", value: \\\"}\\\", line, col: src.length - lineStart + 1, nl: true, ...(file && \{ file }) });\\n  tokens.push(\{ type: \\\"eof\\\", value: \\\"\\\", line, col: src.length - lineStart + 1, nl: true, ...(file && \{ file }) });\\n  return tokens;\\n}\\n\\n// \\\"Hi \{name}!\\\": text with values in it. A '\{' right before a letter, '_' or '(' starts a value, which ends at\\n// its own '}'; any other '\{' is itself, and so is '\\\\\{'. Gives the text and each value's tokens, in order, or\\n// nothing for text with no value in it. The text as written is `src` from `from` to just before `upto`.\\nfunction textParts(src, from, upto, place, file) \{\\n  const parts = [];\\n  let last = from; // where the text not yet in parts starts\\n  for (let i = from; i < upto; i++) \{\\n    if (src[i] === \\\"\\\\\\\\\\\") i++;\\n    else if (src[i] === \\\"\{\\\" && startsValue(src[i + 1])) \{\\n      const \{ end } = valueEnd(src, i);\\n      if (i > last) parts.push(unescape(src.slice(last, i)));\\n      const \{ line, col } = place(i + 1);\\n      parts.push(tokenize(src.slice(i + 1, end), file, \{ line, col }));\\n      last = end + 1;\\n      i = end;\\n    }\\n  }\\n  if (!parts.length) return null;\\n  if (last < upto) parts.push(unescape(src.slice(last, upto)));\\n  return parts;\\n}\\n\\n// ---------- syntax tree ----------\\n\\n// words that start a statement or a value, so they can't name a variable\\nconst RESERVED = new Set([\\n  \\\"set\\\", \\\"add\\\", \\\"say\\\", \\\"if\\\", \\\"else\\\", \\\"end\\\", \\\"repeat\\\", \\\"while\\\", \\\"for\\\", \\\"to\\\", \\\"return\\\", \\\"and\\\", \\\"or\\\", \\\"not\\\", \\\"is\\\", \\\"yes\\\", \\\"no\\\",\\n  \\\"nothing\\\", \\\"list\\\", \\\"empty\\\", \\\"length\\\", \\\"item\\\", \\\"move\\\", \\\"turn\\\", \\\"pen\\\", \\\"record\\\", \\\"fail\\\", \\\"stop\\\",\\n  \\\"uppercase\\\", \\\"lowercase\\\", \\\"split\\\", \\\"join\\\", \\\"number\\\", \\\"position\\\", \\\"ask\\\", \\\"use\\\", \\\"try\\\", \\\"dictionary\\\", \\\"remove\\\", \\\"keys\\\", \\\"in\\\",\\n  \\\"byte\\\", \\\"bytes\\\", \\\"as\\\", \\\"shift\\\", \\\"read\\\", \\\"write\\\", \\\"arguments\\\", \\\"expect\\\", \\\"clear\\\", \\\"draw\\\", \\\"when\\\", \\\"every\\\"]);\\n// built-in operations (BUILTINS in vm.js), by the word that starts them: the word after it, if any, then\\n// either one input, or two with a word between them: `uppercase of x`, `split x by \\\",\\\"`, `position of \\\"a\\\" in x`\\n// the folder a file is in, as its name has it: up to its last / or \\\\, or \\\"\\\" for one in the program's own\\nconst folderOf = (name) => name.slice(0, Math.max(name.lastIndexOf(\\\"/\\\"), name.lastIndexOf(\\\"\\\\\\\\\\\")) + 1);\\n// whether a file `use` names could be outside the program's folder: from the top of a disk (\\\"/x\\\", \\\"C:x\\\"), or\\n// going up out of a folder (\\\"../x\\\")\\nconst outsideFolder = (name) => /^[/\\\\\\\\]|^[A-Za-z]:/.test(name) || name.split(/[/\\\\\\\\]/).includes(\\\"..\\\");\\nconst AGGREGATES = [\\\"total\\\", \\\"average\\\", \\\"largest\\\", \\\"smallest\\\"]; // `total of prices`: these words and `of` work out something from a list\\nconst BUILTIN_SYNTAX = new Map([[\\\"uppercase\\\", [\\\"of\\\"]], [\\\"lowercase\\\", [\\\"of\\\"]], [\\\"number\\\", [\\\"of\\\"]], [\\\"split\\\", [null, \\\"by\\\"]],\\n  [\\\"join\\\", [null, \\\"with\\\"]], [\\\"position\\\", [\\\"of\\\", \\\"in\\\"]], [\\\"keys\\\", [\\\"of\\\"]]]);\\n// `a bit and b`, `a bit or b`, `a bit xor b`; `bit` alone is still a name\\nconst BIT_WORDS = [\\\"and\\\", \\\"or\\\", \\\"xor\\\"];\\n// what `as` turns a value into: `block as text`, `\\\"hi\\\" as bytes`, `255 as hex`\\nconst AS_WORDS = [\\\"bytes\\\", \\\"text\\\", \\\"hex\\\", \\\"binary\\\", \\\"json\\\"];\\n// what `when` can wait for, and how many values each gives its handler\\nconst EVENT_PHRASES = new Map([[\\\"a key is pressed\\\", \{ event: \\\"key\\\", gives: 1 }], [\\\"the mouse is clicked\\\", \{ event: \\\"click\\\", gives: 2 }],\\n  [\\\"the mouse is dragged\\\", \{ event: \\\"drag\\\", gives: 2 }]]);\\n// buttons and text boxes (DESIGN §36): `when enter is pressed in the text box \\\"Name\\\"`, `the text in the text box\\n// \\\"Name\\\"`, and the words that can follow a value, so `draw button at 0, 0` still draws a variable called button\\nconst ENTER_PHRASE = [\\\"enter\\\", \\\"is\\\", \\\"pressed\\\", \\\"in\\\", \\\"the\\\", \\\"text\\\", \\\"box\\\"];\\nconst TEXT_IN_BOX = [\\\"the\\\", \\\"text\\\", \\\"in\\\", \\\"the\\\", \\\"text\\\", \\\"box\\\"];\\n// checkboxes, text areas and lists (DESIGN §40)\\nconst CHOSEN_PHRASE = [\\\"an\\\", \\\"item\\\", \\\"is\\\", \\\"chosen\\\", \\\"in\\\", \\\"the\\\", \\\"list\\\"];\\nconst TEXT_IN_AREA = [\\\"the\\\", \\\"text\\\", \\\"in\\\", \\\"the\\\", \\\"text\\\", \\\"area\\\"];\\nconst CHOICE_IN_LIST = [\\\"the\\\", \\\"choice\\\", \\\"in\\\", \\\"the\\\", \\\"list\\\"];\\n// dropdowns, sliders and choosing a file (DESIGN §42)\\nconst CHOSEN_IN_DROPDOWN = [\\\"an\\\", \\\"item\\\", \\\"is\\\", \\\"chosen\\\", \\\"in\\\", \\\"the\\\", \\\"dropdown\\\"];\\nconst CHOICE_IN_DROPDOWN = [\\\"the\\\", \\\"choice\\\", \\\"in\\\", \\\"the\\\", \\\"dropdown\\\"];\\nconst VALUE_OF_SLIDER = [\\\"the\\\", \\\"value\\\", \\\"of\\\", \\\"the\\\", \\\"slider\\\"];\\nconst CHOOSE_FILE = [\\\"choose\\\", \\\"a\\\", \\\"file\\\", \\\"to\\\"];\\nconst AFTER_A_VALUE = [\\\"at\\\", \\\"of\\\", \\\"bytes\\\", \\\"as\\\", \\\"in\\\", \\\"bit\\\", \\\"is\\\", \\\"and\\\", \\\"or\\\"];\\n// drawing: `move forward 10`, `turn left 90`, `pen up`, `pen color \\\"red\\\"`\\nconst TURTLE_WORDS = new Map([[\\\"move\\\", [\\\"forward\\\", \\\"back\\\", \\\"to\\\"]], [\\\"turn\\\", [\\\"left\\\", \\\"right\\\"]], [\\\"pen\\\", [\\\"up\\\", \\\"down\\\", \\\"color\\\", \\\"width\\\"]]]);\\n// the words that can carry a value on, as in `draw picture at 0, 0` (which draws the text `picture` holds):\\n// `draw picture` followed by any other word, or by text, a number or a bracket with a space before it (one\\n// with none calls `picture`), draws a picture from a file\\nconst CARRY_ON = [\\\"at\\\", \\\"of\\\", \\\"bit\\\", \\\"is\\\", \\\"and\\\", \\\"or\\\", \\\"in\\\", \\\"as\\\", \\\"bytes\\\"];\\n\\n// The language's own functions, in Moth, put in a program that needs them as a file used as \\\"the language\\\" is\\n// (DESIGN §97); compiler.moth has the same text, and a test holds them to each other.\\nexport const LANGUAGE = `# What some of Moth's statements are written with (DESIGN §97), put in a program that needs them, its names\\n# kept apart as a file used as \\\"the language\\\" is\\n\\n# n as text, with exactly so many decimals, the last rounded a half away from 0, as n is shown\\nto with_decimals with n as a number, places as a number\\n    if not (places is divisible by 1) or places is less than 0 or places is greater than 100\\n        fail with \\\"'with ... decimals' needs a whole number of decimals from 0 to 100, not \\\" + places\\n    end\\n    set written to \\\"\\\" + n\\n    if written is \\\"Infinity\\\" or written is \\\"-Infinity\\\" or written is \\\"NaN\\\"\\n        return written\\n    end\\n    set negative to n is less than 0\\n    if negative\\n        set written to \\\"\\\" + (0 - n)\\n    end\\n    set power to 0\\n    set e_at to position of \\\"e\\\" in written\\n    if e_at is greater than 0\\n        set power_text to items (e_at + 1) to (length of written) of written\\n        if item 1 of power_text is \\\"+\\\"\\n            set power_text to items 2 to (length of power_text) of power_text\\n        end\\n        set power to number of power_text\\n        set written to items 1 to (e_at - 1) of written\\n    end\\n    set dot to position of \\\".\\\" in written\\n    set digits to written\\n    set point to length of written\\n    if dot is greater than 0\\n        set digits to (items 1 to (dot - 1) of written) + (items (dot + 1) to (length of written) of written)\\n        set point to dot - 1\\n    end\\n    set point to point + power\\n    repeat while point is less than 1\\n        set digits to \\\"0\\\" + digits\\n        set point to point + 1\\n    end\\n    repeat while length of digits is less than point + places + 1\\n        set digits to digits + \\\"0\\\"\\n    end\\n    set kept to items 1 to (point + places) of digits\\n    if position of (item (point + places + 1) of digits) in \\\"56789\\\" is greater than 0\\n        set kept to one_more(kept)\\n        if length of kept is greater than point + places\\n            set point to point + 1\\n        end\\n    end\\n    set made to items 1 to point of kept\\n    if places is greater than 0\\n        set made to made + \\\".\\\" + (items (point + 1) to (point + places) of kept)\\n    end\\n    if negative and not_all_zero(made)\\n        return \\\"-\\\" + made\\n    end\\n    return made\\nend\\n\\n# whole number digits, one more\\nto one_more with kept\\n    set made to \\\"\\\"\\n    set carrying to yes\\n    set k to length of kept\\n    repeat while k is at least 1\\n        set d to item k of kept\\n        if carrying and d is \\\"9\\\"\\n            set made to \\\"0\\\" + made\\n        else if carrying\\n            set made to (item ((position of d in \\\"0123456789\\\") + 1) of \\\"0123456789\\\") + made\\n            set carrying to no\\n        else\\n            set made to d + made\\n        end\\n        set k to k - 1\\n    end\\n    if carrying\\n        return \\\"1\\\" + made\\n    end\\n    return made\\nend\\n\\nto not_all_zero with made\\n    for each c in made\\n        if c is not \\\"0\\\" and c is not \\\".\\\"\\n            return yes\\n        end\\n    end\\n    return no\\nend\\n\\n# a value as its kind shows it: the function in its shown field, if it has one, given it; or the value\\nto shown with value\\n    set shown_by to nothing\\n    try\\n        set shown_by to shown of value\\n        a_function(shown_by)\\n    if it fails\\n        return value\\n    end\\n    return shown_by(value)\\nend\\n\\nto a_function with f as a function\\nend\\n`;\\n\\n// Every node keeps the token it came from (`at`), so errors can point at it. `reading` is shared with the\\n// files the program uses: `files` gives a file's text by name, `loaded` is every file read so far (each is read\\n// once), and `open` the files being read right now, to catch two that use each other.\\nfunction parse(tokens, reading = \{ loaded: new Set(), open: [] }) \{\\n  if (!reading.depth) [reading.calls, reading.defines, reading.owns, reading.wants, reading.shows] = [[], [], [], new Set(), []]; // see fillDefaults, ownCalls and LANGUAGE\\n  reading.depth = (reading.depth ?? 0) + 1;\\n  let pos = 0;\\n  const aliases = new Set(); // the names this file used files and libraries `as`: `x's` is theirs, and any other `x's` a value's\\n  let atTop = false; // directly in the program, not in a block or a function\\n  let fnDepth = 0;\\n  let loopDepth = 0; // loops around this spot, in this function: `stop` needs one\\n  let indexing = false; // inside `item ... of`, where a name followed by `of` is the item number, not a field\\n  let hoisted = []; // functions the statement being read makes for its values (see unnamed)\\n  const unnamedOnLine = new Map(); // how many each line has made, so each has a name of its own\\n  let converting = true; // `trip in miles`; not in `position of ... in`, whose `in` is its own\\n  const unitAt = (i) => tokens[i].type === \\\"word\\\" && !tokens[i].nl && unitNamed(tokens[i].value) !== undefined;\\n  const peek = () => tokens[pos];\\n  const check = (type) => tokens[pos].type === type;\\n  const match = (type) => check(type) && tokens[pos++];\\n  const isWord = (w) => check(\\\"word\\\") && tokens[pos].value === w;\\n  // a call by a name, noted for the inputs it may leave out, or give by name (see fillDefaults)\\n  const madeCall = (name, args, at) => \{\\n    const made = \{ kind: \\\"call\\\", name, args, at };\\n    reading.calls.push(made);\\n    return made;\\n  };\\n  const word = (w) => isWord(w) && tokens[pos++];\\n  const describe = (t) => (t.type === \\\"eof\\\" ? \\\"the end of the code\\\" : t.type === \\\"string\\\" ? `\\\"$\{t.value}\\\"` : `'$\{t.text ?? t.value}'`);\\n  const expected = (what) => fail(peek(), `expected $\{what} but found $\{describe(peek())}`);\\n  const expectWord = (w) => word(w) || expected(`'$\{w}'`);\\n  const wordAt = (i, w) => tokens[i].type === \\\"word\\\" && tokens[i].value === w;\\n  // `run program \\\"git\\\" with (list of \\\"status\\\")`: `run` alone is still a name\\n  const runsProgram = () => wordAt(pos + 1, \\\"program\\\") && !tokens[pos + 1].nl;\\n  // `load \\\"scores.txt\\\"`, `load name`: `load` alone, or with `of` after it, is still a name\\n  const loadsFile = () => !tokens[pos + 1].nl && (tokens[pos + 1].type === \\\"string\\\"\\n    || (tokens[pos + 1].type === \\\"word\\\" && !RESERVED.has(tokens[pos + 1].value) && tokens[pos + 1].value !== \\\"of\\\"));\\n  // A phrase that starts with a word that could be a name: `wait 2 seconds`, `save x to \\\"f\\\"`. `parsed` reads the\\n  // rest, and gives a node, or nothing if this isn't the phrase after all, which makes the line a call again.\\n  function phrase(parsed) \{\\n    const [start, marks] = [pos, tightMarks.length];\\n    let node = null;\\n    try \{\\n      pos++;\\n      node = parsed();\\n    } catch (err) \{\\n      if (!(err instanceof MothError)) throw err;\\n    }\\n    if (!node) \{\\n      pos = start;\\n      for (const key of tightMarks.splice(marks)) reading.tight.delete(key);\\n    }\\n    return node;\\n  }\\n  // these words from token i on, on the line before them\\n  const wordsAt = (i, words) => words.every((w, k) => wordAt(i + k, w) && !tokens[i + k].nl);\\n  // `start count(10) on another core`: a worker, with memory of its own, not a task (DESIGN §124)\\n  const onAnotherCore = () => \{\\n    if (!wordsAt(pos, [\\\"on\\\", \\\"another\\\", \\\"core\\\"])) return false;\\n    pos += 3;\\n    return true;\\n  };\\n  // a button's label can start at token i: a value there on the same line, where today `button` would end one\\n  const labelAt = (i) => !tokens[i].nl && (tokens[i].type === \\\"string\\\" || tokens[i].type === \\\"number\\\"\\n    || (tokens[i].type === \\\"word\\\" && !AFTER_A_VALUE.includes(tokens[i].value)));\\n  // `send data to \\\"https://...\\\"`: `send` alone is still a name, and so is one not followed by a value and `to`\\n  // on its line\\n  const sendsData = () => \{\\n    if (tokens[pos + 1].nl) return false;\\n    const start = pos;\\n    const found = phrase(() => (expression(), isWord(\\\"to\\\") && !peek().nl ? true : null));\\n    pos = start;\\n    return Boolean(found);\\n  };\\n  // `json from reply`: `json` alone is still a name\\n  const jsonFrom = () => wordAt(pos + 1, \\\"from\\\") && !tokens[pos + 1].nl;\\n  // ` with headers h`, after a site's address\\n  const withHeaders = () => !peek().nl && wordsAt(pos, [\\\"with\\\", \\\"headers\\\"]) && ((pos += 2), true);\\n  // `play note ...` and `play a beep`: `play` alone is still a name, and so are `note`, `a` and `beep`\\n  const playsSound = () => isWord(\\\"play\\\") && !tokens[pos + 1].nl\\n    && (wordAt(pos + 1, \\\"note\\\") || (wordAt(pos + 1, \\\"a\\\") && wordAt(pos + 2, \\\"beep\\\") && !tokens[pos + 2].nl));\\n\\n  function name(what) \{\\n    const t = peek();\\n    if (t.type !== \\\"word\\\") expected(what);\\n    if (RESERVED.has(t.value)) fail(t, `'$\{t.value}' is a Moth word, so it can't be used as $\{what}`);\\n    pos++;\\n    return t.value;\\n  }\\n\\n  // the line that starts a `try`'s handler: `if it fails`\\n  const isIfItFails = () => isWord(\\\"if\\\") && tokens[pos + 1].type === \\\"word\\\" && tokens[pos + 1].value === \\\"it\\\"\\n    && tokens[pos + 2]?.type === \\\"word\\\" && tokens[pos + 2].value === \\\"fails\\\";\\n  // the line that starts what a `try` does however it ends: `either way`, alone on its line\\n  const isEitherWay = () => isWord(\\\"either\\\") && wordAt(pos + 1, \\\"way\\\") && !tokens[pos + 1].nl && (tokens[pos + 2].type === \\\"eof\\\" || tokens[pos + 2].nl);\\n  // where a block's statements end, besides `end` and `else`: \\\"try\\\" for a try's, at `if it fails` or `either\\n  // way`; \\\"handler\\\" for its `if it fails`'s, at `either way`; \\\"match\\\" for a `when`'s, at the next `when`\\n  const endsBlock = (stopAt) => (stopAt === \\\"try\\\" ? isIfItFails() || isEitherWay() : stopAt === \\\"handler\\\" ? isEitherWay() : stopAt === \\\"match\\\" && isWord(\\\"when\\\"));\\n\\n  // For format(): how deep in blocks each statement starts, and each end, else and if it fails, by \\\"line:col\\\";\\n  // and the pieces written with no space after them: a negating minus, and a call's bracket (no space before)\\n  let nesting = 0;\\n  const lay = (t) => reading.layout && !t.file && reading.layout.set(`$\{t.line}:$\{t.col}`, nesting);\\n  const tightMarks = []; // the marks tight made, in order, so a phrase that isn't one can take its own back\\n  const tight = (t) => \{\\n    const key = t && `$\{t.line}:$\{t.col}`;\\n    if (reading.tight && t && !t.file && !reading.tight.has(key)) \{\\n      reading.tight.add(key);\\n      tightMarks.push(key);\\n    }\\n    return t;\\n  };\\n\\n  // `stopAt`: where else the block's statements end (see endsBlock)\\n  function statements(opener, stopAt = \\\"\\\") \{\\n    const body = [];\\n    const outside = atTop;\\n    atTop = !opener;\\n    if (opener) nesting++;\\n    while (opener ? !isWord(\\\"end\\\") && !isWord(\\\"else\\\") && !endsBlock(stopAt) : !check(\\\"eof\\\")) \{\\n      if (check(\\\"eof\\\")) fail(peek(), `'$\{opener.value}' from line $\{opener.line} is missing its 'end'`);\\n      lay(peek());\\n      const madeBefore = hoisted;\\n      hoisted = [];\\n      const s = statement();\\n      body.push(...hoisted); // functions its values made, made before it runs\\n      hoisted = madeBefore;\\n      if (s.kind === \\\"use\\\" || s.kind === \\\"several\\\") body.push(...s.body); // the file's code, or what the statement is written as, in its place\\n      else body.push(s);\\n      if (!peek().nl) expected(\\\"a new line\\\");\\n    }\\n    if (opener) \{\\n      nesting--;\\n      lay(peek()); // the end, else or if it fails that closes the block\\n    }\\n    atTop = outside;\\n    return body;\\n  }\\n\\n  // The statements of a file the program uses, or none if it was read already. Used `as` a name, its own\\n  // names are kept apart (see prefixed), and it can be used again as another. Files are read once for each\\n  // set of names: a file that one used `as m` uses is m's own copy (`within` is then \\\"m's \\\"), and the\\n  // program can still use the same file for itself. A file's name is from the folder of the file that uses\\n  // it, unless `fromTop`, for a package's, which is from the program's.\\n  function useFile(nameToken, alias, fromTop = false) \{\\n    const written = nameToken.value;\\n    if (outsideFolder(written)) fail(nameToken, `'$\{written}' isn't in the program's folder: 'use' only reads files there, or in folders inside it`);\\n    const name = fromTop ? written : (reading.folder ?? \\\"\\\") + written; // `folder`: the using file's\\n    const within = reading.within ?? \\\"\\\";\\n    const key = `$\{within}$\{name}$\{alias ? ` as $\{alias}` : \\\"\\\"}`;\\n    if (reading.open.includes(name)) fail(nameToken, `'$\{name}' is already being read, so it can't be used here: files can't use each other in a circle`);\\n    if (reading.loaded.has(key)) return [];\\n    const text = reading.files?.(name);\\n    if (typeof text !== \\\"string\\\") fail(nameToken, `there is no file called '$\{name}'`);\\n    reading.loaded.add(key);\\n    reading.open.push(name);\\n    if (alias) reading.within = `$\{within}$\{alias}'s `;\\n    const folder = reading.folder;\\n    reading.folder = folderOf(name);\\n    const body = parse(tokenize(text, name), reading);\\n    reading.within = within;\\n    reading.folder = folder;\\n    reading.open.pop();\\n    return alias ? prefixed(body, alias) : body;\\n  }\\n\\n  // `use the library \\\"sqlite3\\\" or \\\"winsqlite3\\\" as sqlite`, then a line for each of its functions the program\\n  // calls, and `end`: each a function of the program's, whose inputs say what they are as Moth has it (see\\n  // LIBRARY_TYPES). Only a program moth build makes can call them (see \\\"library call\\\" in vm.js); used `as` a\\n  // name, they're that name's, as a file's are.\\n  function library(t) \{\\n    pos += 2;\\n    if (!atTop) fail(t, \\\"'use the library' only works at the top level of a program\\\");\\n    const libraryName = () => match(\\\"string\\\")?.value ?? expected(\\\"a library's name in quotes, like \\\\\\\"sqlite3\\\\\\\"\\\");\\n    const names = [libraryName()];\\n    while (!peek().nl && word(\\\"or\\\")) names.push(libraryName());\\n    const alias = !peek().nl && word(\\\"as\\\") ? name(\\\"a name for the library\\\") : null;\\n    if (alias) aliases.add(alias);\\n    if (!peek().nl) expected(\\\"a new line\\\");\\n    nesting++;\\n    const body = [];\\n    const made = \{ structures: \{}, callbacks: \{} }; // the block's own, which its lines after them can use\\n    while (!isWord(\\\"end\\\")) \{\\n      if (check(\\\"eof\\\")) fail(peek(), `'use' from line $\{t.line} is missing its 'end'`);\\n      lay(peek());\\n      if (isWord(\\\"structure\\\") && tokens[pos + 1].type === \\\"word\\\" && wordAt(pos + 2, \\\"with\\\")) libraryStructure(made);\\n      else if (isWord(\\\"callback\\\") && tokens[pos + 1].type === \\\"word\\\" && tokens[pos + 2].type === \\\"(\\\") libraryCallback(made);\\n      else body.push(libraryFunction(names[0], made));\\n      if (!peek().nl) expected(\\\"a new line\\\");\\n    }\\n    nesting--;\\n    lay(peek());\\n    pos++;\\n    for (const d of body) Object.assign(d.native, \{ libraries: names, ...made });\\n    return \{ kind: \\\"use\\\", body: alias ? prefixed(body, alias) : body, at: t };\\n  }\\n\\n  // `structure point with x as a whole number, y as a whole number`: a C struct, whose fields are a record's,\\n  // laid out as C lays them out; one of its fields can be another, `N bytes`, or a callback\\n  function libraryStructure(made) \{\\n    pos++;\\n    const structure = libraryTypeName(\\\"a name for the structure\\\", made);\\n    expectWord(\\\"with\\\");\\n    const fields = [];\\n    do \{\\n      const at = peek();\\n      const field = name(\\\"a field's name\\\");\\n      if (fields.some((f) => f.name === field)) fail(at, `'$\{field}' is already one of its fields`);\\n      expectWord(\\\"as\\\");\\n      fields.push(\{ name: field, type: libraryType(made, \\\"field\\\") });\\n    } while (match(\\\",\\\"));\\n    made.structures[structure] = fields;\\n  }\\n\\n  // `callback compare(a pointer, a pointer) gives a whole number`: a function of the program's, given for an\\n  // input of this kind, which C calls back\\n  function libraryCallback(made) \{\\n    pos++;\\n    const callback = libraryTypeName(\\\"a name for the callback\\\", made);\\n    tight(match(\\\"(\\\"));\\n    const types = [];\\n    if (!match(\\\")\\\")) \{\\n      do types.push(libraryType(made, \\\"callback input\\\")); while (match(\\\",\\\"));\\n      match(\\\")\\\") || expected(\\\"')'\\\");\\n    }\\n    if (types.length > 16) fail(peek(), \\\"a callback can be given at most 16 inputs\\\");\\n    made.callbacks[callback] = \{ types, gives: !peek().nl && word(\\\"gives\\\") ? libraryType(made, \\\"callback result\\\") : null };\\n  }\\n\\n  // a structure's or callback's name: neither a Moth word nor one of the words for C's types, nor one before\\n  function libraryTypeName(what, made) \{\\n    const t = peek();\\n    const named = name(what);\\n    if ([\\\"number\\\", \\\"whole\\\", \\\"long\\\", \\\"pointer\\\", \\\"float\\\"].includes(named)) fail(t, `'$\{named}' is one of the words for what C takes, so it can't be used as $\{what}`);\\n    if (Object.hasOwn(made.structures, named) || Object.hasOwn(made.callbacks, named)) fail(t,`'$\{named}' is already a structure or callback here`);\\n    return named;\\n  }\\n\\n  // `MessageBoxW(a pointer, wide text, wide text, a whole number) gives a whole number`, or with the name the\\n  // library has for it in quotes, for one Moth can't use: `\\\"remove\\\" as remove_file(text) gives a whole number`\\n  function libraryFunction(first, made) \{\\n    const t = peek();\\n    let symbol;\\n    if (check(\\\"string\\\")) \{\\n      symbol = match(\\\"string\\\").value;\\n      expectWord(\\\"as\\\");\\n    } else symbol = t.raw;\\n    const fnName = name(\\\"the name of one of the library's functions\\\");\\n    tight(match(\\\"(\\\")) || expected(\\\"'(' and what the function takes\\\");\\n    const types = [];\\n    if (!match(\\\")\\\")) \{\\n      do types.push(libraryType(made, \\\"input\\\")); while (match(\\\",\\\"));\\n      match(\\\")\\\") || expected(\\\"')'\\\");\\n    }\\n    if (types.length > 16) fail(t, \\\"a library's function can take at most 16 inputs\\\");\\n    const gives = !peek().nl && word(\\\"gives\\\") ? libraryType(made, \\\"result\\\") : null;\\n    const call = \{ kind: \\\"builtin\\\", name: \\\"library call\\\", args: [\{ kind: \\\"value\\\", value: first, at: t }], at: t };\\n    return \{\\n      kind: \\\"define\\\", name: fnName, params: types.map((_, i) => `input $\{i + 1}`), body: [\{ kind: \\\"return\\\", value: call, at: t }], at: t,\\n      kinds: types.map((type) => LIBRARY_TYPES[type] ?? (type.startsWith(\\\"a \\\") && Object.hasOwn(made.callbacks, type.slice(2)) ? 7 : -1)),\\n      native: \{ symbol, types, gives, libraries: [first] },\\n    };\\n  }\\n\\n  // what a library's function takes or gives (`where` it is), as C has it: `a whole number` is an int, `wide\\n  // text` wchar_t*; or a structure or callback the block has, `a point`, or in a structure, `32 bytes`\\n  function libraryType(made, where) \{\\n    const t = peek();\\n    let type = Object.keys(LIBRARY_TYPES).find((k) => k.split(\\\" \\\").every((w, i) => wordAt(pos + i, w)));\\n    if (type !== undefined) pos += type.split(\\\" \\\").length;\\n    else if (where === \\\"field\\\" && check(\\\"number\\\") && wordAt(pos + 1, \\\"bytes\\\")) \{\\n      const n = tokens[pos].value;\\n      if (!Number.isInteger(n) || n < 1 || n > 65536) fail(t, \\\"a structure's bytes are a whole number of them, from 1 to 65536\\\");\\n      type = `$\{n} bytes`;\\n      pos += 2;\\n    } else if (isWord(\\\"a\\\") && tokens[pos + 1].type === \\\"word\\\" && (Object.hasOwn(made.structures, tokens[pos + 1].value) || Object.hasOwn(made.callbacks, tokens[pos + 1].value))) \{\\n      type = `a $\{tokens[pos + 1].value}`;\\n      pos += 2;\\n      // the structure itself, not where it is (DESIGN §92)\\n      if (Object.hasOwn(made.structures, type.slice(2)) && (where === \\\"input\\\" || where === \\\"result\\\") && wordAt(pos, \\\"by\\\") && wordAt(pos + 1, \\\"value\\\")) \{\\n        type += \\\" by value\\\";\\n        pos += 2;\\n      }\\n    } else expected(`what it takes or gives ($\{Object.keys(LIBRARY_TYPES).map((k) => `'$\{k}'`).join(\\\", \\\").replace(/, ([^,]*)$/, \\\" or $1\\\")}, or a structure or callback)`);\\n    const structure = type.startsWith(\\\"a \\\") && Object.hasOwn(made.structures, type.slice(2));\\n    const callback = type.startsWith(\\\"a \\\") && Object.hasOwn(made.callbacks, type.slice(2));\\n    const wrong = (why) => fail(t, why);\\n    if (type === \\\"bytes\\\" && where === \\\"result\\\") wrong(\\\"a library's function can't give bytes: it can give a pointer to them\\\");\\n    if (type === \\\"a list of numbers\\\" && where !== \\\"input\\\") wrong(`$\{where === \\\"result\\\" ? \\\"a library's function can't give\\\" : where === \\\"field\\\" ? \\\"a structure's field can't be\\\" : \\\"a callback can't take or give\\\"} a list of numbers: only a function's input can be one`);\\n    if (type === \\\"bytes\\\" && where !== \\\"input\\\") wrong(`$\{where === \\\"field\\\" ? \\\"a structure's field\\\" : \\\"a callback\\\"} can't be bytes: $\{where === \\\"field\\\" ? \\\"say how many, as in '16 bytes', or\\\" : \\\"it can\\\"} take a pointer`);\\n    if (callback && where !== \\\"input\\\" && where !== \\\"field\\\") wrong(\\\"only a function's input or a structure's field can be a callback\\\");\\n    if ((type === \\\"text\\\" || type === \\\"wide text\\\" || structure) && where === \\\"callback result\\\") wrong(`a callback can't give $\{type === \\\"text\\\" || type === \\\"wide text\\\" ? type : \\\"a structure\\\"}`);\\n    return type;\\n  }\\n\\n  // `math's sine`: a name the file used `as math` makes\\n  const member = (first) => (aliases.has(first) && match(\\\"'s\\\") ? `$\{first}'s $\{name(\\\"a name\\\")}` : first);\\n\\n  // Any other `x's` is the value's own: `rex's bark()` is bark(rex), a function given the value first, and\\n  // `rex's name` is name of rex, its field; one after another, `rex's owner's name`.\\n  function possessive(node) \{\\n    while (check(\\\"'s\\\")) \{\\n      pos++;\\n      const t = peek();\\n      const named = name(\\\"a function's or a field's name\\\");\\n      if (tight(match(\\\"(\\\"))) \{\\n        node = madeCall(named, [node, ...argList()], t);\\n        reading.owns.push(node); // a record's own function, if nothing else has its name (see ownCalls)\\n      } else node = \{ kind: \\\"field\\\", name: named, of: node, at: t };\\n    }\\n    return node;\\n  }\\n\\n  function block(opener) \{\\n    if (!peek().nl) expected(\\\"a new line\\\");\\n    return statements(opener);\\n  }\\n\\n  function loopBody(opener) \{\\n    loopDepth++;\\n    const body = blockEnd(opener);\\n    loopDepth--;\\n    return body;\\n  }\\n\\n  function blockEnd(opener) \{\\n    const body = block(opener);\\n    expectWord(\\\"end\\\");\\n    return body;\\n  }\\n\\n  function statement() \{\\n    const t = peek();\\n    if (word(\\\"set\\\")) \{\\n      if (isWord(\\\"item\\\") || isWord(\\\"byte\\\")) \{\\n        const target = primary();\\n        expectWord(\\\"to\\\");\\n        return \{ kind: \\\"setItem\\\", target, value: expression(), at: t };\\n      }\\n      if (wordsAt(pos, [\\\"the\\\", \\\"slider\\\"])) \{ // `set the slider \\\"Volume\\\" to 50`\\n        pos += 2;\\n        const label = additive();\\n        expectWord(\\\"to\\\");\\n        return \{ kind: \\\"turtle\\\", action: \\\"set slider\\\", value: \{ kind: \\\"list\\\", items: [label, expression()], at: t }, at: t };\\n      }\\n      const variable = name(\\\"a variable name\\\");\\n      if (check(\\\",\\\")) \{ // `set a, b to pair`, `set a, b to b, a`: each name an item of what's after `to`\\n        const names = [variable];\\n        while (match(\\\",\\\")) names.push(name(\\\"a variable name\\\"));\\n        expectWord(\\\"to\\\");\\n        const values = [expression()];\\n        while (match(\\\",\\\")) values.push(expression());\\n        return \{ kind: \\\"several\\\", body: unpacked(names, values.length > 1 ? \{ kind: \\\"list\\\", items: values, at: t } : values[0], t), at: t };\\n      }\\n      if (check(\\\"'s\\\") && !aliases.has(variable)) \{ // `set rex's name to ...` changes a field\\n        const field = possessive(\{ kind: \\\"