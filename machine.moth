# Machine code from Moth, written in Moth. compile_machine() turns a program into the bytes of a program of
# its own, for Windows or Linux on x86-64, with no other tool: it reads the program with compiler.moth's
# tokenizer, parser and scope rules, writes every instruction's bytes itself, and wraps them in the file
# the system runs, PE for Windows and ELF for Linux.
#
# It takes all of Moth but its newest phrases: `the time` and the rest of the clock, `wait`, `in order`,
# `save` and `load`. Those, a hex or binary number past 2^53, and a function too big for its frame stop with
# a mistake that says they can't become machine code yet. What it makes does just what the JavaScript engine
# does: numbers are shown and compared to 15 digits, and a mistake says the same thing, points at the same
# spot, and lists the same calls.

use "compiler.moth" as front

# ---------- registers, conditions and values ----------

set rax to 0
set rcx to 1
set rdx to 2
set rbx to 3
set rsp to 4
set rbp to 5
set rsi to 6
set rdi to 7
set r8 to 8
set r9 to 9
set r10 to 10
set r11 to 11
set r12 to 12
set r13 to 13
set r14 to 14
set r15 to 15 # how many calls are in progress, all through the program
set xmm0 to 0
set xmm1 to 1
set xmm2 to 2
set xmm3 to 3
set xmm4 to 4
set xmm5 to 5
set xmm6 to 6
set xmm7 to 7
# the conditions a jump can test, as x86 numbers them
set cc_b to 2
set cc_ae to 3
set cc_e to 4
set cc_ne to 5
set cc_be to 6
set cc_a to 7
set cc_s to 8
set cc_ns to 9
set cc_p to 10
set cc_np to 11
set cc_l to 12
set cc_ge to 13
set cc_le to 14
set cc_g to 15

# A value is 8 bytes. A number is itself; nothing, no and yes are NaNs that arithmetic never makes, so a sum
# is one instruction and only a result that is NaN needs a closer look. A variable with no value yet holds
# another such NaN, and a function's name holds one more once its `to` has run.
set bits_nothing to list of 1, 0, 0, 0, 0, 0, 248, 127
set bits_no to list of 2, 0, 0, 0, 0, 0, 248, 127
set bits_yes to list of 3, 0, 0, 0, 0, 0, 248, 127
set bits_unset to list of 4, 0, 0, 0, 0, 0, 248, 127
# A value in memory is a pointer with its kind in the top 16 bits, which make it a NaN no arithmetic makes
# either: text, a list, a record, a dictionary, bytes or a function.
set kind_text to 65529
set kind_list to 65530
set kind_record to 65531
set kind_dict to 65532
set kind_bytes to 65533
set kind_function to 65534
set kind_tags to list of 0, kind_text, 0, kind_list, kind_record, kind_dict, kind_bytes, kind_function # by what an input says it is
set tag_text to list of 0, 0, 0, 0, 0, 0, 0xF9, 0xFF
set tag_list to list of 0, 0, 0, 0, 0, 0, 0xFA, 0xFF
set tag_record to list of 0, 0, 0, 0, 0, 0, 0xFB, 0xFF
set tag_dict to list of 0, 0, 0, 0, 0, 0, 0xFC, 0xFF
set tag_bytes to list of 0, 0, 0, 0, 0, 0, 0xFD, 0xFF
set tag_function to list of 0, 0, 0, 0, 0, 0, 0xFE, 0xFF

set out_cap to 65536 # bytes of output kept before they are written
set limbs to 20 # 64-bit pieces of a big whole number: room for 10^340 times 2^54
set stack_size to 268435456 # 256 MB: 100,000 calls in progress, each with up to 2 KB
set wide_cap to 16384 # UTF-16 units written to a console at a time
set max_text to 536870888 # JavaScript's longest text, in UTF-16 units: a longer one is a mistake there, so here too
set too_big to "a value got too big to fit in memory"
set frame_limit to 2048
set deepest to 100000 # calls in progress at once, as every engine allows
set kind_names to list of "a number", "text", "yes or no", "a list", "a record", "a dictionary", "bytes", "a function"

# ---------- bytes ----------

to put8 with out, v
    set u to v
    if u is less than 0
        set u to u + 256
    end
    add u bit and 255 to out
end

to put16 with out, v
    add v bit and 255 to out
    add (shift v right by 8) bit and 255 to out
end

to put32 with out, v
    set u to v
    if u is less than 0
        set u to u + 4294967296
    end
    repeat 4 times
        add u bit and 255 to out
        set u to shift u right by 8
    end
end

# a whole number from 0 to 2^53
to put64 with out, v
    put32(out, v bit and 4294967295)
    put32(out, shift v right by 32)
end

to put_all with out, more
    for each b in more
        add b to out
    end
end

to patch32 with out, at, v
    set four to empty list
    put32(four, v)
    for each k from 1 to 4
        set item (at + k) of out to item k of four
    end
end

to bytes_of with v
    set out to empty list
    put64(out, v)
    return out
end

to align_up with value, alignment
    set extra to value bit and (alignment - 1)
    if extra is 0
        return value
    end
    return value + alignment - extra
end

to pad_to with out, alignment
    repeat while (length of out) bit and (alignment - 1) is not 0
        add 0 to out
    end
end

# The 8 bytes of the double a number is, worked out with exact steps: halving and doubling, and a
# subtraction to compare, since Moth's own comparisons round to 15 digits.
to double_bytes with v
    set out to empty list
    if v is 0
        repeat 8 times
            add 0 to out
        end
        return out
    end
    if v - v is not 0 # too big for a double: infinity
        return list of 0, 0, 0, 0, 0, 0, 240, 127
    end
    set power to 1
    set e to 0
    repeat while v - power * 2 is at least 0
        set power to power * 2
        add 1 to e
    end
    repeat while v - power is less than 0
        set power to power / 2
        set e to e - 1
    end
    set field to e + 1023
    set mant to v
    if e is less than -1022 # subnormal: a whole number of 2^-1074
        set field to 0
        repeat 1074 times
            set mant to mant * 2
        end
    else
        set mant to v / power
        repeat 52 times
            set mant to mant * 2
        end
        set mant to mant - 4503599627370496
    end
    repeat 6 times
        add mant bit and 255 to out
        set mant to shift mant right by 8
    end
    add mant + (field bit and 15) * 16 to out
    add shift field right by 4 to out
    return out
end

# a number as the program wrote it: digits, maybe a point, or 0x and 0b whole numbers
to literal_bytes with written, at
    set chars to front's letters(written)
    if length of chars is at least 2 and item 1 of chars is "0" and (item 2 of chars is "x" or item 2 of chars is "b")
        set base to 16
        if item 2 of chars is "b"
            set base to 2
        end
        set v to 0
        for each n from 3 to length of chars
            set digit to (position of item n of chars in "0123456789abcdef") - 1
            if digit is -1
                set digit to (position of item n of chars in "ABCDEF") + 9
            end
            set v to v * base + digit
            if v is at least 9007199254740992
                not_yet(at, "a hex or binary number this big")
            end
        end
        return double_bytes(v)
    end
    return double_bytes(number of written)
end

# ---------- the assembler ----------
# Code goes into `hot`, and what only runs when something goes wrong into `cold`, which ends up after it,
# out of the way. A label names a place in the code or the data, and a fixup is a 32-bit distance to one,
# filled in once everything has its place.

to new_asm
    set made to record with hot empty list, cold empty list, code nothing, buffer "hot", rodata empty list, data empty list,
        bss 0, labels empty dictionary, fixups empty list, count 0, texts empty dictionary, numbers empty dictionary,
        absolutes empty list, text_objects empty dictionary, more_imports empty list, pad no, net no, units no,
        charts no, pictures no, widgets no, sends no, controls no, files no, window no, libraries no,
        library_blocks empty dictionary, library_structs empty dictionary, struct_jobs empty list,
        library_callbacks empty dictionary, callback_jobs empty list, shipping nothing, task_runtime no, threading no,
        workers no,
        guarded empty list, released empty list, last_store nothing, field_spots 0, last_word no, own_kernels empty dictionary
    set code of made to hot of made
    return made
end

to use_hot with a
    set code of a to hot of a
    set buffer of a to "hot"
end

to use_cold with a
    set code of a to cold of a
    set buffer of a to "cold"
end

# into the cold code; gives where it was, for leave_cold
to enter_cold with a
    set was to buffer of a
    use_cold(a)
    return was
end

to leave_cold with a, was
    if was is "hot"
        use_hot(a)
    end
end

to new_label with a
    set count of a to count of a + 1
    return "L" + count of a
end

to mark with a, name
    set table to labels of a
    if name is in table # two routines of one name: the second would win, silently
        fail with "machine.moth marks '" + name + "' twice"
    end
    set item name of table to record with section buffer of a, at length of code of a
    set last_store of a to nothing
end

to fixup with a, name, addend, extra
    set code to code of a
    set fixes to fixups of a
    add record with buffer buffer of a, at length of code, label name, addend addend, finish length of code + 4 + extra to fixes
    put32(code, 0)
end

to rodata_here with a, name
    set table to labels of a
    set item name of table to record with section "rodata", at length of rodata of a
end

to data_here with a, name
    set table to labels of a
    set item name of table to record with section "data", at length of data of a
end

# zeroed memory that takes no room in the file
to reserve with a, name, size, alignment
    set start to align_up(bss of a, alignment)
    set table to labels of a
    set item name of table to record with section "bss", at start
    set bss of a to start + size
end

# the 8-byte address of `name` (plus `addend`) goes at `at` in the read-only data ("rodata") or the data
to absolute with a, section, at, name, addend
    set fixes to absolutes of a
    add record with section section, at at, label name, addend addend to fixes
end

# a text the program writes, as a value in the read-only data: its length in bytes and in characters, then
# where its bytes are, which is just after; once each
to text_object with a, t
    set known to text_objects of a
    if t is in known
        return item t of known
    end
    set ro to rodata of a
    pad_to(ro, 16)
    set name to "X" + length of ro
    rodata_here(a, name)
    set raw_bytes to t as bytes
    put64(ro, length of raw_bytes)
    put64(ro, length of t)
    absolute(a, "rodata", length of ro, name, 24)
    put64(ro, 0)
    put_all(ro, raw_bytes)
    set item t of known to name
    return name
end

to load_text with a, x, t
    lea(a, rax, rip(text_object(a, t)))
    movi64(a, rcx, tag_text)
    alu(a, "or", rax, rcx)
    movq_xr(a, x, rax)
end

# a text's UTF-8 bytes in the read-only data, once each: its label and how many bytes
to text_place with a, t
    set known to texts of a
    if t is in known
        return item t of known
    end
    set ro to rodata of a
    set start to length of ro
    for each b in t as bytes
        add b to ro
    end
    set name to "T" + start
    set table to labels of a
    set item name of table to record with section "rodata", at start
    set made to record with label name, size length of ro - start
    set item t of known to made
    return made
end

# 8 bytes in the read-only data, once each: their label
to number_place with a, eight
    set key to ""
    for each b in eight
        set key to key + b + ","
    end
    set known to numbers of a
    if key is in known
        return item key of known
    end
    set ro to rodata of a
    pad_to(ro, 8)
    set name to "N" + length of ro
    rodata_here(a, name)
    put_all(ro, eight)
    set item key of known to name
    return name
end

# ---------- instructions ----------

to reg_at with n
    return record with mode "reg", r n
end

to mem with n, offset
    return record with mode "base", r n, disp offset
end

to rip with name
    return record with mode "rip", label name, addend 0
end

to rip_plus with name, addend
    return record with mode "rip", label name, addend addend
end

to imm8 with v
    set out to empty list
    put8(out, v)
    return out
end

to imm32 with v
    set out to empty list
    put32(out, v)
    return out
end

to raw with a, codes
    put_all(code of a, codes)
end

# An instruction with a ModRM byte: `pre` are the prefixes before REX (0x66, 0xF2, 0xF3), `wide` is REX.W,
# `ops` the opcode, `reg` the ModRM reg field (a register, or the opcode's extension), `rm` the other operand
# (reg_at, mem or rip), and `imm` the bytes after it.
to enc with a, pre, wide, ops, reg, rm, imm
    set code to code of a
    put_all(code, pre)
    set rex to 0
    if wide
        set rex to 8
    end
    if reg is at least 8
        set rex to rex + 4
    end
    set low to 5
    if mode of rm is not "rip"
        set low to r of rm bit and 7
        if r of rm is at least 8
            set rex to rex + 1
        end
    end
    if rex is not 0
        add 64 + rex to code
    end
    put_all(code, ops)
    set field to (reg bit and 7) * 8
    if mode of rm is "reg"
        add 192 + field + low to code
    else if mode of rm is "rip"
        add field + 5 to code
        fixup(a, label of rm, addend of rm, length of imm)
    else
        set offset to disp of rm
        set md to 128
        if offset is 0 and low is not 5
            set md to 0
        else if offset is at least -128 and offset is at most 127
            set md to 64
        end
        add md + field + low to code
        if low is 4
            add 36 to code # a SIB byte: rsp or r12, with no index
        end
        if md is 64
            put8(code, offset)
        else if md is 128
            put32(code, offset)
        end
    end
    put_all(code, imm)
end

to mov_rr with a, dst, src
    enc(a, empty list, yes, (list of 0x89), src, reg_at(dst), empty list)
end

to mov32_rr with a, dst, src
    enc(a, empty list, no, (list of 0x89), src, reg_at(dst), empty list)
end

to load with a, dst, at
    enc(a, empty list, yes, (list of 0x8B), dst, at, empty list)
end

to store with a, at, src
    enc(a, empty list, yes, (list of 0x89), src, at, empty list)
end

to load32 with a, dst, at
    enc(a, empty list, no, (list of 0x8B), dst, at, empty list)
end

to store32 with a, at, src
    enc(a, empty list, no, (list of 0x89), src, at, empty list)
end

to load8 with a, dst, at
    enc(a, empty list, no, (list of 0x0F, 0xB6), dst, at, empty list)
end

# the low byte of al, cl, dl or bl
to store8 with a, at, src
    enc(a, empty list, no, (list of 0x88), src, at, empty list)
end

to store8i with a, at, v
    enc(a, empty list, no, (list of 0xC6), 0, at, imm8(v))
end

to storei with a, at, v
    enc(a, empty list, yes, (list of 0xC7), 0, at, imm32(v))
end

# a register gets v, from -2^31 to 2^32 - 1
to movi with a, dst, v
    if v is at least 0 and v is less than 4294967296
        set code to code of a
        if dst is at least 8
            add 0x41 to code
        end
        add 0xB8 + (dst bit and 7) to code
        put32(code, v)
    else
        enc(a, empty list, yes, (list of 0xC7), 0, reg_at(dst), imm32(v))
    end
end

to movi64 with a, dst, eight
    set code to code of a
    add 0x48 + (shift dst right by 3) to code
    add 0xB8 + (dst bit and 7) to code
    put_all(code, eight)
end

to lea with a, dst, at
    enc(a, empty list, yes, (list of 0x8D), dst, at, empty list)
end

set alu_codes to dictionary where "add" is 0, "or" is 1, "adc" is 2, "sbb" is 3, "and" is 4, "sub" is 5, "xor" is 6, "cmp" is 7

to alu with a, op, dst, src
    enc(a, empty list, yes, (list of (item op of alu_codes) * 8 + 1), src, reg_at(dst), empty list)
end

to alu_load with a, op, dst, at
    enc(a, empty list, yes, (list of (item op of alu_codes) * 8 + 3), dst, at, empty list)
end

to alu_store with a, op, at, src
    enc(a, empty list, yes, (list of (item op of alu_codes) * 8 + 1), src, at, empty list)
end

to alu_at with a, op, at, v
    if v is at least -128 and v is at most 127
        enc(a, empty list, yes, (list of 0x83), item op of alu_codes, at, imm8(v))
    else
        enc(a, empty list, yes, (list of 0x81), item op of alu_codes, at, imm32(v))
    end
end

to alui with a, op, dst, v
    alu_at(a, op, reg_at(dst), v)
end

to test_rr with a, x, y
    enc(a, empty list, yes, (list of 0x85), y, reg_at(x), empty list)
end

to test32 with a, x
    enc(a, empty list, no, (list of 0x85), x, reg_at(x), empty list)
end

set shift_codes to dictionary where "shl" is 4, "shr" is 5, "sar" is 7

to shifti with a, op, dst, n
    enc(a, empty list, yes, (list of 0xC1), item op of shift_codes, reg_at(dst), imm8(n))
end

to shift_cl with a, op, dst
    enc(a, empty list, yes, (list of 0xD3), item op of shift_codes, reg_at(dst), empty list)
end

to shld_cl with a, dst, src
    enc(a, empty list, yes, (list of 0x0F, 0xA5), src, reg_at(dst), empty list)
end

to imul_rr with a, dst, src
    enc(a, empty list, yes, (list of 0x0F, 0xAF), dst, reg_at(src), empty list)
end

to imul_ri with a, dst, src, v
    enc(a, empty list, yes, (list of 0x69), dst, reg_at(src), imm32(v))
end

set unary_codes to dictionary where "not" is 2, "neg" is 3, "mul" is 4, "div" is 6, "idiv" is 7

to unary with a, op, dst
    enc(a, empty list, yes, (list of 0xF7), item op of unary_codes, reg_at(dst), empty list)
end

to inc_r with a, dst
    enc(a, empty list, yes, (list of 0xFF), 0, reg_at(dst), empty list)
end

to dec_r with a, dst
    enc(a, empty list, yes, (list of 0xFF), 1, reg_at(dst), empty list)
end

set bit_codes to dictionary where "bts" is 5, "btr" is 6, "btc" is 7

to bit_op with a, op, dst, n
    enc(a, empty list, yes, (list of 0x0F, 0xBA), item op of bit_codes, reg_at(dst), imm8(n))
end

to push_r with a, n
    if n is at least 8
        raw(a, list of 0x41)
    end
    raw(a, list of 0x50 + (n bit and 7))
end

to pop_r with a, n
    if n is at least 8
        raw(a, list of 0x41)
    end
    raw(a, list of 0x58 + (n bit and 7))
end

to call_to with a, name
    raw(a, list of 0xE8)
    fixup(a, name, 0, 0)
end

to call_import with a, name
    enc(a, empty list, no, (list of 0xFF), 2, rip(name), empty list)
end

to call_r with a, r
    enc(a, empty list, no, (list of 0xFF), 2, reg_at(r), empty list)
end

to push_i32 with a, v
    raw(a, list of 0x68)
    put32(code of a, v)
end

to jmp_r with a, r
    enc(a, empty list, no, (list of 0xFF), 4, reg_at(r), empty list)
end

to jmp_to with a, name
    raw(a, list of 0xE9)
    fixup(a, name, 0, 0)
end

to jcc with a, cc, name
    raw(a, list of 0x0F, 0x80 + cc)
    fixup(a, name, 0, 0)
end

to ret with a
    raw(a, list of 0xC3)
end

# the low byte of al, cl, dl or bl gets 1 if the condition holds, else 0
to setcc with a, cc, dst
    enc(a, empty list, no, (list of 0x0F, 0x90 + cc), 0, reg_at(dst), empty list)
end

to movzx8 with a, dst, src
    enc(a, empty list, no, (list of 0x0F, 0xB6), dst, reg_at(src), empty list)
end

to rep_movsb with a
    raw(a, list of 0xF3, 0xA4)
end

to rep_stosb with a
    raw(a, list of 0xF3, 0xAA)
end

to rep_movsq with a
    raw(a, list of 0xF3, 0x48, 0xA5)
end

to rep_stosq with a
    raw(a, list of 0xF3, 0x48, 0xAB)
end

# SSE2, on the xmm registers
to sse with a, pre, op, x, at
    enc(a, (list of pre), no, (list of 0x0F, op), x, at, empty list)
end

# A load of what the instruction just before stored, from where it stored it, with nothing that can jump
# in between (a label marked there forgets it), is the register it was stored from: no load at all, or a
# move between registers.
to movsd_load with a, x, at
    set was to last_store of a
    if was is not nothing and buffer of was is buffer of a and at of was is length of code of a and same_place(place of was, at)
        if x of was is not x
            movapd(a, x, x of was)
        end
        return nothing
    end
    sse(a, 0xF2, 0x10, x, at)
end

to movsd_store with a, at, x
    sse(a, 0xF2, 0x11, x, at)
    set last_store of a to record with buffer buffer of a, at length of code of a, place at, x x
end

to same_place with p, q
    if mode of p is not mode of q
        return no
    end
    if mode of p is "base"
        return r of p is r of q and disp of p is disp of q
    end
    if mode of p is "rip"
        return label of p is label of q and addend of p is addend of q
    end
    return no
end

to movapd with a, x, y
    sse(a, 0x66, 0x28, x, reg_at(y))
end

set sse_codes to dictionary where "+" is 0x58, "*" is 0x59, "-" is 0x5C, "/" is 0x5E, "max" is 0x5F

to sse_math with a, op, x, at
    sse(a, 0xF2, item op of sse_codes, x, at)
end

to ucomisd with a, x, at
    sse(a, 0x66, 0x2E, x, at)
end

to movq_xr with a, x, src
    enc(a, (list of 0x66), yes, (list of 0x0F, 0x6E), x, reg_at(src), empty list)
end

to movq_rx with a, dst, x
    enc(a, (list of 0x66), yes, (list of 0x0F, 0x7E), x, reg_at(dst), empty list)
end

to cvtsi2sd with a, x, src
    enc(a, (list of 0xF2), yes, (list of 0x0F, 0x2A), x, reg_at(src), empty list)
end

to cvttsd2si with a, dst, x
    enc(a, (list of 0xF2), yes, (list of 0x0F, 0x2C), dst, reg_at(x), empty list)
end

# rsi and rcx: a text's bytes and how many
to point_at_text with a, t
    set placed to text_place(a, t)
    lea(a, rsi, rip(label of placed))
    movi(a, rcx, size of placed)
end

to load_bits with a, x, eight
    movsd_load(a, x, rip(number_place(a, eight)))
end

to andpd with a, x, at
    sse(a, 0x66, 0x54, x, at)
end

# 16 bytes in the read-only data, on a 16-byte boundary as andpd needs: every bit but the sign of each half;
# once
to abs_mask with a
    set known to numbers of a
    if "abs" is in known
        return item "abs" of known
    end
    set ro to rodata of a
    pad_to(ro, 16)
    set name to "N" + length of ro
    rodata_here(a, name)
    repeat 2 times
        put_all(ro, list of 255, 255, 255, 255, 255, 255, 255, 127)
    end
    set item "abs" of known to name
    return name
end

# ---------- the runtime: output ----------
# Every program carries these. Output collects in out_buf and is written when it fills, at the end, before a
# mistake, and after every line when it goes to a terminal, so each line shows as it is said.

to emit_output with a
    # rt_out_text: rsi, rcx: these bytes go out
    set fits to new_label(a)
    mark(a, "rt_out_text")
    load(a, rax, rip("out_len"))
    mov_rr(a, rdx, rax)
    alu(a, "add", rdx, rcx)
    alui(a, "cmp", rdx, out_cap)
    jcc(a, cc_be, fits)
    push_r(a, rsi)
    push_r(a, rcx)
    call_to(a, "rt_flush_out")
    pop_r(a, rcx)
    pop_r(a, rsi)
    alui(a, "cmp", rcx, out_cap)
    jcc(a, cc_be, fits)
    mov_rr(a, rdx, rcx) # more than the buffer holds: straight out
    movi(a, rdi, 1)
    jmp_to(a, "rt_write")
    mark(a, fits)
    load(a, rax, rip("out_len"))
    lea(a, rdi, rip("out_buf"))
    alu(a, "add", rdi, rax)
    alu(a, "add", rax, rcx)
    store(a, rip("out_len"), rax)
    rep_movsb(a)
    ret(a)

    # rt_out_line: the end of a line
    set spare to new_label(a)
    set now to new_label(a)
    mark(a, "rt_out_line")
    load(a, rax, rip("out_len"))
    alui(a, "cmp", rax, out_cap)
    jcc(a, cc_b, spare)
    call_to(a, "rt_flush_out")
    movi(a, rax, 0)
    mark(a, spare)
    lea(a, rdx, rip("out_buf"))
    alu(a, "add", rdx, rax)
    store8i(a, mem(rdx, 0), 10)
    inc_r(a, rax)
    store(a, rip("out_len"), rax)
    load(a, rcx, rip("out_tty"))
    test_rr(a, rcx, rcx)
    jcc(a, cc_ne, now)
    alui(a, "cmp", rax, out_cap / 2)
    jcc(a, cc_ae, now)
    ret(a)
    mark(a, now)
    jmp_to(a, "rt_flush_out")

    # rt_flush_out: write what has collected
    set idle to new_label(a)
    mark(a, "rt_flush_out")
    load(a, rdx, rip("out_len"))
    test_rr(a, rdx, rdx)
    jcc(a, cc_e, idle)
    lea(a, rsi, rip("out_buf"))
    movi(a, rdi, 1)
    call_to(a, "rt_write")
    storei(a, rip("out_len"), 0)
    mark(a, idle)
    ret(a)
end

# ---------- the runtime: numbers as text ----------
# As JavaScript's Number::toString shows them, after rounding to 15 significant digits (vm.js's canon): a
# whole number below 2^53 as its digits; another number from its first 16 digits, worked out exactly with
# 128-bit sums, or for one below 2^-68 with big whole numbers; and a whole number from 2^53 up with the
# fewest digits that read back as it (Steele and White's method, as Burger and Dybvig put it), also with
# big whole numbers.

# rax a whole number from 0 to 2^64 - 1: rax gets a tenth of it, rounded down, and rdx what's left over, as
# `div` by 10 would, but with a multiplication: by 2^67 / 10, rounded up, then the top 67 bits (exact for
# every such number). Uses rcx and r9.
to tenth with a
    mov_rr(a, r9, rax)
    movi64(a, rcx, list of 0xCD, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC)
    unary(a, "mul", rcx)
    shifti(a, "shr", rdx, 3)
    mov_rr(a, rax, rdx)
    imul_ri(a, rcx, rdx, 10)
    mov_rr(a, rdx, r9)
    alu(a, "sub", rdx, rcx)
end

to emit_numbers with a
    # rt_digits: rax: a whole number's digits go in dbuf; rcx: how many
    set again to new_label(a)
    mark(a, "rt_digits")
    push_r(a, rdi)
    lea(a, rsi, rip_plus("dbuf", 40))
    mov_rr(a, r8, rsi)
    mark(a, again)
    tenth(a)
    alui(a, "add", rdx, 48)
    dec_r(a, rsi)
    store8(a, mem(rsi, 0), rdx)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, again)
    mov_rr(a, rcx, r8)
    alu(a, "sub", rcx, rsi)
    push_r(a, rcx)
    lea(a, rdi, rip("dbuf"))
    rep_movsb(a)
    pop_r(a, rcx)
    pop_r(a, rdi)
    ret(a)

    # rt_layout: the rcx digits in dbuf, with the point rdx digits in, as JavaScript lays them out, at rdi
    set fewer to new_label(a)
    set small to new_label(a)
    set power to new_label(a)
    set exponent to new_label(a)
    set positive to new_label(a)
    mark(a, "rt_layout")
    alu(a, "cmp", rdx, rcx)
    jcc(a, cc_l, fewer)
    alui(a, "cmp", rdx, 21)
    jcc(a, cc_g, power)
    lea(a, rsi, rip("dbuf")) # 1200: the digits, then zeros
    mov_rr(a, r8, rdx)
    alu(a, "sub", r8, rcx)
    rep_movsb(a)
    mov_rr(a, rcx, r8)
    movi(a, rax, 48)
    rep_stosb(a)
    ret(a)
    mark(a, fewer)
    alui(a, "cmp", rdx, 0)
    jcc(a, cc_le, small)
    lea(a, rsi, rip("dbuf")) # 12.5: some digits, a point, the rest
    mov_rr(a, r8, rcx)
    alu(a, "sub", r8, rdx)
    mov_rr(a, rcx, rdx)
    rep_movsb(a)
    store8i(a, mem(rdi, 0), 46)
    inc_r(a, rdi)
    mov_rr(a, rcx, r8)
    rep_movsb(a)
    ret(a)
    mark(a, small)
    alui(a, "cmp", rdx, -6)
    jcc(a, cc_le, power)
    store8i(a, mem(rdi, 0), 48) # 0.005: a point, zeros, the digits
    store8i(a, mem(rdi, 1), 46)
    alui(a, "add", rdi, 2)
    mov_rr(a, r8, rcx)
    mov_rr(a, rcx, rdx)
    unary(a, "neg", rcx)
    movi(a, rax, 48)
    rep_stosb(a)
    lea(a, rsi, rip("dbuf"))
    mov_rr(a, rcx, r8)
    rep_movsb(a)
    ret(a)
    mark(a, power)
    lea(a, rsi, rip("dbuf")) # 1.5e+21: a digit, maybe a point and the rest, e and the power of ten
    load8(a, rax, mem(rsi, 0))
    store8(a, mem(rdi, 0), rax)
    inc_r(a, rsi)
    inc_r(a, rdi)
    alui(a, "cmp", rcx, 1)
    jcc(a, cc_e, exponent)
    store8i(a, mem(rdi, 0), 46)
    inc_r(a, rdi)
    dec_r(a, rcx)
    rep_movsb(a)
    mark(a, exponent)
    store8i(a, mem(rdi, 0), 101)
    store8i(a, mem(rdi, 1), 43)
    mov_rr(a, rax, rdx)
    dec_r(a, rax)
    test_rr(a, rax, rax)
    jcc(a, cc_ns, positive)
    store8i(a, mem(rdi, 1), 45)
    unary(a, "neg", rax)
    mark(a, positive)
    alui(a, "add", rdi, 2)
    call_to(a, "rt_digits")
    lea(a, rsi, rip("dbuf"))
    rep_movsb(a)
    ret(a)

    # rt_fmt: rax, rdi: a number's bits, shown at rdi
    set nan to new_label(a)
    set infinite to new_label(a)
    set zero to new_label(a)
    set plus to new_label(a)
    set fraction to new_label(a)
    set big to new_label(a)
    set strip to new_label(a)
    set stripped to new_label(a)
    set below to new_label(a)
    set smallest to new_label(a)
    mark(a, "rt_fmt")
    mov_rr(a, rdx, rax)
    shifti(a, "shl", rdx, 1)
    movi64(a, rcx, list of 0, 0, 0, 0, 0, 0, 0xE0, 0xFF)
    alu(a, "cmp", rdx, rcx)
    jcc(a, cc_a, nan)
    jcc(a, cc_e, infinite)
    test_rr(a, rdx, rdx)
    jcc(a, cc_e, zero)
    test_rr(a, rax, rax)
    jcc(a, cc_ns, plus)
    store8i(a, mem(rdi, 0), 45)
    inc_r(a, rdi)
    bit_op(a, "btr", rax, 63)
    mark(a, plus)
    movq_xr(a, xmm0, rax)
    movi64(a, rcx, list of 0, 0, 0, 0, 0, 0, 0x40, 0x43) # 2^53
    movq_xr(a, xmm1, rcx)
    ucomisd(a, xmm0, reg_at(xmm1))
    jcc(a, cc_ae, big)
    cvttsd2si(a, rcx, xmm0)
    cvtsi2sd(a, xmm1, rcx)
    ucomisd(a, xmm0, reg_at(xmm1))
    jcc(a, cc_ne, fraction)
    mov_rr(a, rax, rcx)
    call_to(a, "rt_digits")
    lea(a, rsi, rip("dbuf"))
    rep_movsb(a)
    ret(a)
    mark(a, fraction)
    movq_rx(a, rax, xmm0)
    shifti(a, "shr", rax, 52)
    alui(a, "cmp", rax, 1)
    jcc(a, cc_be, smallest)
    push_r(a, rdi)
    call_to(a, "rt_dec15")
    push_r(a, rdx)
    call_to(a, "rt_digits")
    pop_r(a, rdx)
    pop_r(a, rdi)
    lea(a, rsi, rip("dbuf"))
    mark(a, strip) # 15 digits, less the zeros at the end
    alui(a, "cmp", rcx, 1)
    jcc(a, cc_be, stripped)
    mov_rr(a, rax, rsi)
    alu(a, "add", rax, rcx)
    load8(a, rax, mem(rax, -1))
    alui(a, "cmp", rax, 48)
    jcc(a, cc_ne, stripped)
    dec_r(a, rcx)
    jmp_to(a, strip)
    mark(a, stripped)
    jmp_to(a, "rt_layout")
    mark(a, smallest)
    push_r(a, rdi)
    call_to(a, "rt_canon_double")
    call_to(a, "rt_shortest")
    pop_r(a, rdi)
    jmp_to(a, "rt_layout")
    mark(a, big)
    push_r(a, rdi)
    movq_rx(a, rax, xmm0)
    call_to(a, "rt_shortest")
    pop_r(a, rdi)
    jmp_to(a, "rt_layout")
    mark(a, nan)
    point_at_text(a, "NaN")
    rep_movsb(a)
    ret(a)
    mark(a, infinite)
    test_rr(a, rax, rax)
    jcc(a, cc_s, below)
    point_at_text(a, "Infinity")
    rep_movsb(a)
    ret(a)
    mark(a, below)
    point_at_text(a, "-Infinity")
    rep_movsb(a)
    ret(a)
    mark(a, zero)
    store8i(a, mem(rdi, 0), 48)
    inc_r(a, rdi)
    ret(a)

    # rt_dec15: xmm0, a number above 0 that isn't whole: rax gets its first 15 significant digits, rounded
    # (half up, as toPrecision rounds), and rdx where the point goes: x is 0.ddd... times 10^rdx
    set tiny to new_label(a)
    set high to new_label(a)
    set ready to new_label(a)
    set fraction_only to new_label(a)
    set whole_count to new_label(a)
    set some_whole to new_label(a)
    set more to new_label(a)
    set last to new_label(a)
    set leading to new_label(a)
    set first to new_label(a)
    mark(a, "rt_dec15")
    movq_rx(a, rax, xmm0)
    mov_rr(a, rcx, rax)
    shifti(a, "shr", rcx, 52)
    alui(a, "cmp", rcx, 955) # below 2^-68
    jcc(a, cc_b, tiny)
    push_r(a, r12)
    push_r(a, r13)
    cvttsd2si(a, r8, xmm0) # the whole part, then the rest as a 128-bit number of 2^-120ths
    cvtsi2sd(a, xmm1, r8)
    movapd(a, xmm2, xmm0)
    sse_math(a, "-", xmm2, reg_at(xmm1))
    movq_rx(a, rax, xmm2)
    mov_rr(a, rcx, rax)
    shifti(a, "shr", rcx, 52)
    alui(a, "sub", rcx, 955)
    movi64(a, rdx, list of 255, 255, 255, 255, 255, 255, 15, 0)
    alu(a, "and", rax, rdx)
    bit_op(a, "bts", rax, 52)
    alui(a, "cmp", rcx, 64)
    jcc(a, cc_ae, high)
    movi(a, r12, 0)
    mov_rr(a, r11, rax)
    shld_cl(a, r12, r11)
    shift_cl(a, "shl", r11)
    jmp_to(a, ready)
    mark(a, high)
    alui(a, "sub", rcx, 64)
    mov_rr(a, r12, rax)
    shift_cl(a, "shl", r12)
    movi(a, r11, 0)
    mark(a, ready)
    test_rr(a, r8, r8)
    jcc(a, cc_e, fraction_only)
    mov_rr(a, rax, r8) # how many digits the whole part has
    movi(a, r10, 0)
    movi(a, r9, 10)
    mark(a, whole_count)
    inc_r(a, r10)
    movi(a, rdx, 0)
    unary(a, "div", r9)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, whole_count)
    alui(a, "cmp", r10, 16)
    jcc(a, cc_b, some_whole)
    mov_rr(a, rax, r8) # 16 whole digits: the 16th decides
    movi(a, rdx, 0)
    unary(a, "div", r9)
    mov_rr(a, r9, rax)
    mov_rr(a, rax, rdx)
    pop_r(a, r13)
    pop_r(a, r12)
    jmp_to(a, "rt_round15")
    mark(a, some_whole)
    mov_rr(a, r9, r8)
    movi(a, r13, 15)
    alu(a, "sub", r13, r10)
    jmp_to(a, more)
    mark(a, fraction_only)
    movi(a, r10, 0)
    mark(a, leading)
    next_digit(a)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, first)
    dec_r(a, r10)
    jmp_to(a, leading)
    mark(a, first)
    mov_rr(a, r9, rax)
    movi(a, r13, 14)
    mark(a, more)
    test_rr(a, r13, r13)
    jcc(a, cc_e, last)
    next_digit(a)
    imul_ri(a, r9, r9, 10)
    alu(a, "add", r9, rax)
    dec_r(a, r13)
    jmp_to(a, more)
    mark(a, last)
    next_digit(a)
    pop_r(a, r13)
    pop_r(a, r12)
    jmp_to(a, "rt_round15")
    mark(a, tiny)
    jmp_to(a, "rt_tiny15")

    # rt_round15: r9 is 15 digits, r10 where the point goes, rax the 16th digit: rounded, into rax and rdx
    set kept to new_label(a)
    mark(a, "rt_round15")
    alui(a, "cmp", rax, 5)
    jcc(a, cc_b, kept)
    inc_r(a, r9)
    movi64(a, rax, bytes_of(1000000000000000))
    alu(a, "cmp", r9, rax)
    jcc(a, cc_ne, kept)
    movi64(a, r9, bytes_of(100000000000000))
    inc_r(a, r10)
    mark(a, kept)
    mov_rr(a, rax, r9)
    mov_rr(a, rdx, r10)
    ret(a)

    # rt_tiny15: the same for a number below 2^-68, as big whole numbers: x is R / S, and each digit is how
    # many times S goes into R
    set subnormal to new_label(a)
    set scaled to new_label(a)
    set grow to new_label(a)
    set digit to new_label(a)
    set count_off to new_label(a)
    set got to new_label(a)
    mark(a, "rt_tiny15")
    push_r(a, rbx)
    movq_rx(a, rax, xmm0)
    mov_rr(a, rcx, rax)
    shifti(a, "shr", rcx, 52)
    movi64(a, rdx, list of 255, 255, 255, 255, 255, 255, 15, 0)
    alu(a, "and", rax, rdx)
    movi(a, rdx, 1074)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, subnormal)
    bit_op(a, "bts", rax, 52)
    movi(a, rdx, 1075)
    alu(a, "sub", rdx, rcx)
    mark(a, subnormal)
    push_r(a, rdx)
    lea(a, rdi, rip("big_r"))
    call_to(a, "big_set")
    pop_r(a, rcx)
    lea(a, rdi, rip("big_s"))
    call_to(a, "big_pow2")
    movi(a, r10, 1)
    mark(a, grow) # R times 10 until it's at least S: each time, the point moves one further out
    lea(a, rdi, rip("big_r"))
    lea(a, rsi, rip("big_s"))
    call_to(a, "big_cmp")
    jcc(a, cc_ae, scaled)
    lea(a, rdi, rip("big_r"))
    call_to(a, "big_mul10")
    dec_r(a, r10)
    jmp_to(a, grow)
    mark(a, scaled)
    movi(a, r9, 0)
    movi(a, r11, 16)
    mark(a, digit)
    movi(a, rbx, 0)
    mark(a, count_off)
    lea(a, rdi, rip("big_r"))
    lea(a, rsi, rip("big_s"))
    call_to(a, "big_cmp")
    jcc(a, cc_b, got)
    lea(a, rdi, rip("big_r"))
    lea(a, rsi, rip("big_s"))
    call_to(a, "big_sub")
    inc_r(a, rbx)
    jmp_to(a, count_off)
    mark(a, got)
    dec_r(a, r11)
    set sixteenth to new_label(a)
    jcc(a, cc_e, sixteenth)
    imul_ri(a, r9, r9, 10)
    alu(a, "add", r9, rbx)
    lea(a, rdi, rip("big_r"))
    call_to(a, "big_mul10")
    jmp_to(a, digit)
    mark(a, sixteenth)
    mov_rr(a, rax, rbx)
    pop_r(a, rbx)
    jmp_to(a, "rt_round15")

    # rt_canon_double: xmm0, a number above 0 that isn't whole: rax gets the double nearest its value to 15
    # digits, D * 10^p. With p from -22 up, D and 10^-p are both exact, so one division rounds it right. Below
    # that, it is f * 2^e for the f closest to D * 2^-e / 10^-p, worked out with big whole numbers, at the
    # scale of the number itself, or the one next to it if f leaves it.
    set fast_div to new_label(a)
    set fast_done to new_label(a)
    set slow to new_label(a)
    set normal to new_label(a)
    set scaled to new_label(a)
    set rescale to new_label(a)
    set upward to new_label(a)
    set raise_f to new_label(a)
    set downward to new_label(a)
    set lower_f to new_label(a)
    set settled to new_label(a)
    set tens to new_label(a)
    set not_subnormal to new_label(a)
    set out to new_label(a)
    mark(a, "rt_canon_double")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    movsd_store(a, rip("cd_x"), xmm0)
    call_to(a, "rt_dec15")
    mov_rr(a, r14, rax)
    mov_rr(a, rbx, rdx)
    alui(a, "sub", rbx, 15)
    alui(a, "cmp", rbx, -22)
    jcc(a, cc_l, slow)
    cvtsi2sd(a, xmm0, r14)
    test_rr(a, rbx, rbx)
    jcc(a, cc_s, fast_div)
    mov_rr(a, rcx, rbx)
    shifti(a, "shl", rcx, 3)
    lea(a, rax, rip("pow10"))
    alu(a, "add", rax, rcx)
    sse_math(a, "*", xmm0, mem(rax, 0))
    jmp_to(a, fast_done)
    mark(a, fast_div)
    mov_rr(a, rcx, rbx)
    unary(a, "neg", rcx)
    shifti(a, "shl", rcx, 3)
    lea(a, rax, rip("pow10"))
    alu(a, "add", rax, rcx)
    sse_math(a, "/", xmm0, mem(rax, 0))
    mark(a, fast_done)
    movq_rx(a, rax, xmm0)
    jmp_to(a, out)
    mark(a, slow)
    load(a, rax, rip("cd_x"))
    mov_rr(a, rcx, rax)
    shifti(a, "shr", rcx, 52)
    movi64(a, rdx, list of 255, 255, 255, 255, 255, 255, 15, 0)
    alu(a, "and", rax, rdx)
    mov_rr(a, r12, rax)
    movi(a, r13, -1074)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, normal)
    bit_op(a, "bts", r12, 52)
    mov_rr(a, r13, rcx)
    alui(a, "sub", r13, 1075)
    mark(a, normal)
    lea(a, rdi, rip("big_s")) # S: 10^-p
    movi(a, rax, 1)
    call_to(a, "big_set")
    mark(a, tens)
    lea(a, rdi, rip("big_s"))
    call_to(a, "big_mul10")
    inc_r(a, rbx)
    jcc(a, cc_ne, tens)
    mark(a, rescale) # R: D * 2^(1 - e)
    lea(a, rdi, rip("big_r"))
    movi(a, rcx, 1)
    alu(a, "sub", rcx, r13)
    call_to(a, "big_pow2")
    lea(a, rdi, rip("big_r"))
    mov_rr(a, rsi, r14)
    call_to(a, "big_mul")
    mark(a, upward) # up while the value is past f + 1/2: (2f + 1) * S below R
    times_odd(a, 1)
    jcc(a, cc_b, raise_f)
    jcc(a, cc_ne, downward)
    mov_rr(a, rax, r12) # halfway: to the even one
    alui(a, "and", rax, 1)
    jcc(a, cc_e, settled)
    inc_r(a, r12)
    jmp_to(a, settled)
    mark(a, raise_f)
    inc_r(a, r12)
    jmp_to(a, upward)
    mark(a, downward) # down while it's short of f - 1/2
    test_rr(a, r12, r12)
    jcc(a, cc_e, settled)
    times_odd(a, -1)
    jcc(a, cc_a, lower_f)
    jcc(a, cc_ne, settled)
    mov_rr(a, rax, r12)
    alui(a, "and", rax, 1)
    jcc(a, cc_e, settled)
    mark(a, lower_f)
    dec_r(a, r12)
    jmp_to(a, downward)
    mark(a, settled) # f out of its 53 bits: the scale next to it
    movi64(a, rax, list of 0, 0, 0, 0, 0, 0, 0x20, 0) # 2^53
    alu(a, "cmp", r12, rax)
    jcc(a, cc_b, scaled)
    shifti(a, "shr", r12, 1)
    inc_r(a, r13)
    jmp_to(a, rescale)
    mark(a, scaled)
    movi64(a, rax, bytes_of(4503599627370496))
    alu(a, "cmp", r12, rax)
    jcc(a, cc_ae, not_subnormal)
    alui(a, "cmp", r13, -1074)
    jcc(a, cc_le, not_subnormal)
    shifti(a, "shl", r12, 1)
    dec_r(a, r13)
    jmp_to(a, rescale)
    mark(a, not_subnormal)
    mov_rr(a, rax, r12)
    movi64(a, rcx, bytes_of(4503599627370496))
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_b, out) # a subnormal's bits are its f
    alu(a, "sub", rax, rcx)
    mov_rr(a, rcx, r13)
    alui(a, "add", rcx, 1075)
    shifti(a, "shl", rcx, 52)
    alu(a, "or", rax, rcx)
    mark(a, out)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    emit_shortest(a)
end

# compares (2f + side) * S, f being r12, with R
to times_odd with a, side
    lea(a, rdi, rip("big_t"))
    lea(a, rsi, rip("big_s"))
    call_to(a, "big_copy")
    mov_rr(a, rsi, r12)
    alu(a, "add", rsi, rsi)
    alui(a, "add", rsi, side)
    lea(a, rdi, rip("big_t"))
    call_to(a, "big_mul")
    lea(a, rdi, rip("big_t"))
    lea(a, rsi, rip("big_r"))
    call_to(a, "big_cmp")
end

# rax gets the next digit of the 128-bit fraction in r12 (high) and r11 (low), which keeps the rest
to next_digit with a
    mov_rr(a, rax, r11)
    movi(a, rcx, 10)
    unary(a, "mul", rcx)
    mov_rr(a, r11, rax)
    imul_ri(a, r12, r12, 10)
    alu(a, "add", r12, rdx)
    mov_rr(a, rax, r12)
    shifti(a, "shr", rax, 56)
    movi64(a, rcx, list of 255, 255, 255, 255, 255, 255, 255, 0)
    alu(a, "and", r12, rcx)
end

# rt_shortest: rax, a number above 0: dbuf gets the fewest digits that read back as it, rcx how many, rdx
# where the point goes. The number is R / S, and M+ and M- are how far each way a number can be
# and still read back as it, all doubled so they're whole.
to emit_shortest with a
    set ordinary to new_label(a)
    set scaled to new_label(a)
    set fix to new_label(a)
    set bump to new_label(a)
    set fixed to new_label(a)
    set gen to new_label(a)
    set divide to new_label(a)
    set divided to new_label(a)
    set low_yes to new_label(a)
    set low_done to new_label(a)
    set high_yes to new_label(a)
    set high_done to new_label(a)
    set low to new_label(a)
    set up to new_label(a)
    set emit_last to new_label(a)
    set subnormal to new_label(a)
    set exponent to new_label(a)
    set negative to new_label(a)
    set set_up to new_label(a)
    set shrink_test to new_label(a)
    set shrink to new_label(a)
    mark(a, "rt_shortest")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    mov_rr(a, rcx, rax)
    shifti(a, "shr", rcx, 52)
    movi64(a, rdx, list of 255, 255, 255, 255, 255, 255, 15, 0)
    alu(a, "and", rax, rdx)
    mov_rr(a, r12, rax) # what's below the leading bit: 0 for a power of two
    mov_rr(a, rbx, rax) # rbx: the whole number f, and x is f * 2^e
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, subnormal)
    bit_op(a, "bts", rbx, 52)
    jmp_to(a, exponent)
    mark(a, subnormal)
    movi(a, rcx, 1)
    mark(a, exponent)
    alui(a, "sub", rcx, 1075)
    mov_rr(a, r13, rcx)
    mov_rr(a, r14, rbx) # r14: 1 if f is even, so a number exactly halfway reads back as x
    alui(a, "and", r14, 1)
    alui(a, "xor", r14, 1)
    test_rr(a, r13, r13)
    jcc(a, cc_s, negative)
    test_rr(a, r12, r12)
    jcc(a, cc_ne, ordinary)
    lea(a, rdi, rip("big_r")) # a power of two: the next number down is closer than the next one up
    mov_rr(a, rcx, r13)
    alui(a, "add", rcx, 2)
    call_to(a, "big_pow2")
    lea(a, rdi, rip("big_r"))
    mov_rr(a, rsi, rbx)
    call_to(a, "big_mul")
    lea(a, rdi, rip("big_s"))
    movi(a, rax, 4)
    call_to(a, "big_set")
    lea(a, rdi, rip("big_mp"))
    mov_rr(a, rcx, r13)
    inc_r(a, rcx)
    call_to(a, "big_pow2")
    lea(a, rdi, rip("big_mm"))
    mov_rr(a, rcx, r13)
    call_to(a, "big_pow2")
    jmp_to(a, scaled)
    mark(a, ordinary)
    lea(a, rdi, rip("big_r"))
    mov_rr(a, rcx, r13)
    inc_r(a, rcx)
    call_to(a, "big_pow2")
    lea(a, rdi, rip("big_r"))
    mov_rr(a, rsi, rbx)
    call_to(a, "big_mul")
    lea(a, rdi, rip("big_s"))
    movi(a, rax, 2)
    call_to(a, "big_set")
    lea(a, rdi, rip("big_mp"))
    mov_rr(a, rcx, r13)
    call_to(a, "big_pow2")
    lea(a, rdi, rip("big_mm"))
    mov_rr(a, rcx, r13)
    call_to(a, "big_pow2")
    jmp_to(a, scaled)
    mark(a, negative) # below 2^53 and not whole: R = 2f and S = 2^(1 - e), or twice both for a power of two
    movi(a, r9, 1)
    movi(a, r10, 1)
    alui(a, "cmp", r13, -1074)
    jcc(a, cc_e, set_up)
    test_rr(a, r12, r12)
    jcc(a, cc_ne, set_up)
    movi(a, r9, 2)
    mark(a, set_up)
    lea(a, rdi, rip("big_r"))
    mov_rr(a, rax, rbx)
    call_to(a, "big_set")
    lea(a, rdi, rip("big_r"))
    mov_rr(a, rsi, r9)
    alu(a, "add", rsi, rsi)
    call_to(a, "big_mul")
    lea(a, rdi, rip("big_s"))
    mov_rr(a, rcx, r9)
    alu(a, "sub", rcx, r13)
    call_to(a, "big_pow2")
    lea(a, rdi, rip("big_mp"))
    mov_rr(a, rax, r9)
    call_to(a, "big_set")
    lea(a, rdi, rip("big_mm"))
    mov_rr(a, rax, r10)
    call_to(a, "big_set")
    mark(a, scaled)
    movi(a, r12, 0) # r12 counts the digits before the point
    mark(a, shrink_test) # R, M+ and M- times 10 while ten times R + M+ is short of S
    high_test_tenfold(a)
    jcc(a, cc_b, shrink)
    jcc(a, cc_ne, fix)
    test_rr(a, r14, r14)
    jcc(a, cc_ne, fix)
    mark(a, shrink)
    lea(a, rdi, rip("big_r"))
    call_to(a, "big_mul10")
    lea(a, rdi, rip("big_mp"))
    call_to(a, "big_mul10")
    lea(a, rdi, rip("big_mm"))
    call_to(a, "big_mul10")
    dec_r(a, r12)
    jmp_to(a, shrink_test)
    mark(a, fix) # S times 10 while R + M+ reaches it
    high_test(a)
    jcc(a, cc_a, bump)
    jcc(a, cc_ne, fixed)
    test_rr(a, r14, r14)
    jcc(a, cc_e, fixed)
    mark(a, bump)
    lea(a, rdi, rip("big_s"))
    call_to(a, "big_mul10")
    inc_r(a, r12)
    jmp_to(a, fix)
    mark(a, fixed)
    movi(a, r13, 0) # r13 counts the digits made
    mark(a, gen)
    lea(a, rdi, rip("big_r"))
    call_to(a, "big_mul10")
    lea(a, rdi, rip("big_mp"))
    call_to(a, "big_mul10")
    lea(a, rdi, rip("big_mm"))
    call_to(a, "big_mul10")
    movi(a, rbx, 0)
    mark(a, divide)
    lea(a, rdi, rip("big_r"))
    lea(a, rsi, rip("big_s"))
    call_to(a, "big_cmp")
    jcc(a, cc_b, divided)
    lea(a, rdi, rip("big_r"))
    lea(a, rsi, rip("big_s"))
    call_to(a, "big_sub")
    inc_r(a, rbx)
    jmp_to(a, divide)
    mark(a, divided)
    lea(a, rdi, rip("big_r")) # low: R is within M- of 0 (R <= M- when halfway counts)
    lea(a, rsi, rip("big_mm"))
    call_to(a, "big_cmp")
    movi(a, r9, 0)
    jcc(a, cc_b, low_yes)
    jcc(a, cc_ne, low_done)
    test_rr(a, r14, r14)
    jcc(a, cc_e, low_done)
    mark(a, low_yes)
    movi(a, r9, 1)
    mark(a, low_done)
    high_test(a) # high: R + M+ reaches S
    movi(a, r10, 0)
    jcc(a, cc_a, high_yes)
    jcc(a, cc_ne, high_done)
    test_rr(a, r14, r14)
    jcc(a, cc_e, high_done)
    mark(a, high_yes)
    movi(a, r10, 1)
    mark(a, high_done)
    test_rr(a, r9, r9)
    jcc(a, cc_ne, low)
    test_rr(a, r10, r10)
    jcc(a, cc_ne, up)
    put_digit(a)
    jmp_to(a, gen)
    mark(a, low)
    test_rr(a, r10, r10)
    jcc(a, cc_e, emit_last)
    lea(a, rdi, rip("big_t")) # both: the digit nearer x, and the even one at a tie
    lea(a, rsi, rip("big_r"))
    call_to(a, "big_copy")
    lea(a, rdi, rip("big_t"))
    lea(a, rsi, rip("big_r"))
    call_to(a, "big_add")
    lea(a, rdi, rip("big_t"))
    lea(a, rsi, rip("big_s"))
    call_to(a, "big_cmp")
    jcc(a, cc_b, emit_last)
    jcc(a, cc_a, up)
    mov_rr(a, rax, rbx)
    alui(a, "and", rax, 1)
    jcc(a, cc_e, emit_last)
    mark(a, up)
    inc_r(a, rbx)
    mark(a, emit_last)
    put_digit(a)
    mov_rr(a, rcx, r13)
    mov_rr(a, rdx, r12)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
end

# compares ten times R + M+ with S, for the jumps after
to high_test_tenfold with a
    lea(a, rdi, rip("big_t"))
    lea(a, rsi, rip("big_r"))
    call_to(a, "big_copy")
    lea(a, rdi, rip("big_t"))
    lea(a, rsi, rip("big_mp"))
    call_to(a, "big_add")
    lea(a, rdi, rip("big_t"))
    call_to(a, "big_mul10")
    lea(a, rdi, rip("big_t"))
    lea(a, rsi, rip("big_s"))
    call_to(a, "big_cmp")
end

# compares R + M+ with S, for the jumps after
to high_test with a
    lea(a, rdi, rip("big_t"))
    lea(a, rsi, rip("big_r"))
    call_to(a, "big_copy")
    lea(a, rdi, rip("big_t"))
    lea(a, rsi, rip("big_mp"))
    call_to(a, "big_add")
    lea(a, rdi, rip("big_t"))
    lea(a, rsi, rip("big_s"))
    call_to(a, "big_cmp")
end

# the digit in rbx goes at place r13 of dbuf
to put_digit with a
    lea(a, rax, rip("dbuf"))
    alu(a, "add", rax, r13)
    alui(a, "add", rbx, 48)
    store8(a, mem(rax, 0), rbx)
    inc_r(a, r13)
end

# Big whole numbers, `limbs` 64-bit pieces each, lowest first. They use rax, rcx, rdx, rsi, rdi and r8.
to emit_bignums with a
    mark(a, "big_set") # rdi = rax
    mov_rr(a, rdx, rax)
    mov_rr(a, rsi, rdi)
    movi(a, rax, 0)
    movi(a, rcx, limbs)
    rep_stosq(a)
    store(a, mem(rsi, 0), rdx)
    ret(a)

    mark(a, "big_pow2") # rdi = 2^rcx
    mov_rr(a, rdx, rcx)
    mov_rr(a, rsi, rdi)
    movi(a, rax, 0)
    movi(a, rcx, limbs)
    rep_stosq(a)
    mov_rr(a, rcx, rdx)
    shifti(a, "shr", rdx, 6)
    alui(a, "and", rcx, 63)
    movi(a, rax, 1)
    shift_cl(a, "shl", rax)
    shifti(a, "shl", rdx, 3)
    alu(a, "add", rsi, rdx)
    store(a, mem(rsi, 0), rax)
    ret(a)

    mark(a, "big_mul10") # rdi times 10
    movi(a, rsi, 10)
    set times to new_label(a)
    mark(a, "big_mul") # rdi times rsi
    movi(a, r8, 0)
    movi(a, rcx, limbs)
    mark(a, times)
    load(a, rax, mem(rdi, 0))
    unary(a, "mul", rsi)
    alu(a, "add", rax, r8)
    alui(a, "adc", rdx, 0)
    store(a, mem(rdi, 0), rax)
    mov_rr(a, r8, rdx)
    alui(a, "add", rdi, 8)
    dec_r(a, rcx)
    jcc(a, cc_ne, times)
    ret(a)

    set adding to new_label(a)
    mark(a, "big_add") # rdi plus rsi
    movi(a, rcx, limbs)
    raw(a, list of 0xF8) # clc
    mark(a, adding)
    load(a, rax, mem(rsi, 0))
    alu_store(a, "adc", mem(rdi, 0), rax)
    lea(a, rsi, mem(rsi, 8))
    lea(a, rdi, mem(rdi, 8))
    dec_r(a, rcx)
    jcc(a, cc_ne, adding)
    ret(a)

    set taking to new_label(a)
    mark(a, "big_sub") # rdi less rsi, which is no bigger
    movi(a, rcx, limbs)
    raw(a, list of 0xF8)
    mark(a, taking)
    load(a, rax, mem(rsi, 0))
    alu_store(a, "sbb", mem(rdi, 0), rax)
    lea(a, rsi, mem(rsi, 8))
    lea(a, rdi, mem(rdi, 8))
    dec_r(a, rcx)
    jcc(a, cc_ne, taking)
    ret(a)

    set looking to new_label(a)
    set decided to new_label(a)
    mark(a, "big_cmp") # rdi against rsi, for an unsigned jump after
    alui(a, "add", rdi, 8 * (limbs - 1))
    alui(a, "add", rsi, 8 * (limbs - 1))
    movi(a, rcx, limbs)
    mark(a, looking)
    load(a, rax, mem(rdi, 0))
    alu_load(a, "cmp", rax, mem(rsi, 0))
    jcc(a, cc_ne, decided)
    alui(a, "sub", rdi, 8)
    alui(a, "sub", rsi, 8)
    dec_r(a, rcx)
    jcc(a, cc_ne, looking)
    alu(a, "cmp", rax, rax)
    mark(a, decided)
    ret(a)

    mark(a, "big_copy") # rdi gets rsi
    movi(a, rcx, limbs)
    rep_movsq(a)
    ret(a)
end

# ---------- the runtime: comparing, as vm.js's numberOrder does ----------
# Two numbers compare as their values to 15 significant digits do, so 0.1 + 0.2 is 0.3. That takes work
# only for two numbers that aren't both whole and are close enough that 15 digits might not tell them
# apart; then each becomes 17 decimal digits and a power of ten, which compare exactly.

to emit_compares with a
    set unordered to new_label(a)
    set equal to new_label(a)
    set near to new_label(a)
    set plain to new_label(a)
    set less to new_label(a)
    set a_whole to new_label(a)
    set canon to new_label(a)
    set nearer to new_label(a)
    set further to new_label(a)
    set greater to new_label(a)
    set decimal to new_label(a)
    mark(a, "rt_order") # xmm0 against xmm1, neither nothing, yes nor no: rax is 0 if equal, 1 if less, 2 if
    # greater, 3 if either is NaN
    ucomisd(a, xmm0, reg_at(xmm1))
    jcc(a, cc_p, unordered)
    jcc(a, cc_e, equal)
    movapd(a, xmm2, xmm0) # how far apart, against 1e-14 of the bigger
    sse_math(a, "-", xmm2, reg_at(xmm1))
    movq_rx(a, rax, xmm2)
    bit_op(a, "btr", rax, 63)
    movq_xr(a, xmm2, rax)
    movq_rx(a, rax, xmm0)
    bit_op(a, "btr", rax, 63)
    movq_xr(a, xmm3, rax)
    movq_rx(a, rax, xmm1)
    bit_op(a, "btr", rax, 63)
    movq_xr(a, xmm4, rax)
    sse_math(a, "max", xmm3, reg_at(xmm4))
    sse_math(a, "*", xmm3, rip(number_place(a, double_bytes(number of "0.00000000000001"))))
    ucomisd(a, xmm2, reg_at(xmm3))
    jcc(a, cc_be, near)
    mark(a, plain)
    ucomisd(a, xmm0, reg_at(xmm1))
    jcc(a, cc_b, less)
    movi(a, rax, 2)
    ret(a)
    mark(a, less)
    movi(a, rax, 1)
    ret(a)
    mark(a, equal)
    movi(a, rax, 0)
    ret(a)
    mark(a, unordered)
    movi(a, rax, 3)
    ret(a)
    mark(a, near) # an infinity is itself to 15 digits, and so is a whole number
    movi64(a, rcx, list of 0, 0, 0, 0, 0, 0, 0xE0, 0xFF)
    movq_rx(a, rax, xmm0)
    shifti(a, "shl", rax, 1)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_ae, plain)
    movq_rx(a, rax, xmm1)
    shifti(a, "shl", rax, 1)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_ae, plain)
    is_whole(a, xmm0, a_whole)
    jmp_to(a, canon)
    mark(a, a_whole)
    is_whole(a, xmm1, plain)
    mark(a, canon) # the same sign, and neither is 0
    movsd_store(a, rip("o_a"), xmm0)
    movsd_store(a, rip("o_b"), xmm1)
    movq_rx(a, rax, xmm0)
    bit_op(a, "btr", rax, 63)
    shifti(a, "shr", rax, 52)
    alui(a, "cmp", rax, 1)
    jcc(a, cc_a, decimal)
    movq_rx(a, rax, xmm1)
    bit_op(a, "btr", rax, 63)
    shifti(a, "shr", rax, 52)
    alui(a, "cmp", rax, 1)
    jcc(a, cc_a, decimal)
    small_canon(a, xmm0, "o_ma")
    small_canon(a, xmm1, "o_na")
    load(a, rax, rip("o_ma"))
    load(a, rdx, rip("o_na"))
    movsd_load(a, xmm0, rip("o_a"))
    movsd_load(a, xmm1, rip("o_b"))
    alu(a, "cmp", rax, rdx)
    jcc(a, cc_b, nearer)
    jcc(a, cc_a, further)
    movi(a, rax, 0)
    ret(a)
    mark(a, decimal)
    movq_rx(a, rax, xmm0)
    bit_op(a, "btr", rax, 63)
    movq_xr(a, xmm0, rax)
    call_to(a, "rt_dec17")
    store(a, rip("o_ma"), rax)
    store(a, rip("o_na"), rdx)
    movsd_load(a, xmm0, rip("o_b"))
    movq_rx(a, rax, xmm0)
    bit_op(a, "btr", rax, 63)
    movq_xr(a, xmm0, rax)
    call_to(a, "rt_dec17")
    load(a, r8, rip("o_na"))
    alu(a, "cmp", r8, rdx)
    jcc(a, cc_l, nearer)
    jcc(a, cc_g, further)
    load(a, r8, rip("o_ma"))
    alu(a, "cmp", r8, rax)
    jcc(a, cc_b, nearer)
    jcc(a, cc_a, further)
    movsd_load(a, xmm0, rip("o_a"))
    movsd_load(a, xmm1, rip("o_b"))
    movi(a, rax, 0)
    ret(a)
    mark(a, nearer) # a is nearer 0 than b
    movsd_load(a, xmm0, rip("o_a"))
    movsd_load(a, xmm1, rip("o_b"))
    movq_rx(a, rax, xmm0)
    test_rr(a, rax, rax)
    jcc(a, cc_s, greater)
    movi(a, rax, 1)
    ret(a)
    mark(a, further)
    movsd_load(a, xmm0, rip("o_a"))
    movsd_load(a, xmm1, rip("o_b"))
    movq_rx(a, rax, xmm0)
    test_rr(a, rax, rax)
    jcc(a, cc_s, less)
    mark(a, greater)
    movi(a, rax, 2)
    ret(a)

    # rt_dec17: xmm0, a number above 0 (below 2^53 if whole): rax gets 17 decimal digits of its value to 15
    # digits, and rdx where the point goes
    set counting to new_label(a)
    set widen to new_label(a)
    set widened to new_label(a)
    mark(a, "rt_dec17")
    is_whole(a, xmm0, counting)
    call_to(a, "rt_dec15")
    imul_ri(a, rax, rax, 100)
    ret(a)
    mark(a, counting)
    cvttsd2si(a, r9, xmm0)
    mov_rr(a, rax, r9)
    movi(a, r10, 0)
    movi(a, r11, 10)
    set count_digits to new_label(a)
    mark(a, count_digits)
    inc_r(a, r10)
    movi(a, rdx, 0)
    unary(a, "div", r11)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, count_digits)
    mov_rr(a, rax, r9)
    mov_rr(a, rcx, r10)
    mark(a, widen)
    alui(a, "cmp", rcx, 17)
    jcc(a, cc_ae, widened)
    imul_ri(a, rax, rax, 10)
    inc_r(a, rcx)
    jmp_to(a, widen)
    mark(a, widened)
    mov_rr(a, rdx, r10)
    ret(a)

    # The comparisons, on any two values in xmm0 and xmm1: rax is 1 if it holds, 0 if not, or 2 for a
    # mistake, with the two values in err_a and err_b, and err_why 1 for dividing by zero.
    for each test in list of "lt", "gt", "ge", "le"
        set wrong to new_label(a)
        set odd to new_label(a)
        set decided to new_label(a)
        set not_before to new_label(a)
        mark(a, "rt_cmp_" + test)
        odd_jump(a, xmm0, odd)
        odd_jump(a, xmm1, odd)
        call_to(a, "rt_order")
        mark(a, decided)
        if test is "lt"
            alui(a, "cmp", rax, 1)
            setcc(a, cc_e, rax)
        else if test is "gt"
            alui(a, "cmp", rax, 2)
            setcc(a, cc_e, rax)
        else if test is "ge" # equal or greater: 0 or 2
            alui(a, "and", rax, 1)
            setcc(a, cc_e, rax)
        else
            alui(a, "cmp", rax, 2)
            setcc(a, cc_b, rax)
        end
        movzx8(a, rax, rax)
        ret(a)
        mark(a, odd) # two texts compare as their UTF-16 does
        if units of a # two amounts of one measure, in the first's unit
            set not_amounts to new_label(a)
            call_to(a, "rt_q_pair")
            test_rr(a, rax, rax)
            jcc(a, cc_ne, not_amounts)
            call_to(a, "rt_order")
            jmp_to(a, decided)
            mark(a, not_amounts)
        end
        movq_rx(a, rax, xmm0)
        shifti(a, "shr", rax, 48)
        alui(a, "cmp", rax, kind_text)
        jcc(a, cc_ne, wrong)
        movq_rx(a, rax, xmm1)
        shifti(a, "shr", rax, 48)
        alui(a, "cmp", rax, kind_text)
        jcc(a, cc_ne, wrong)
        movq_rx(a, rax, xmm0)
        movq_rx(a, rdx, xmm1)
        call_to(a, "rt_text_order")
        alui(a, "cmp", rax, -1) # as rt_order has it: 1 before, 0 the same, 2 after
        jcc(a, cc_ne, not_before)
        movi(a, rax, 1)
        jmp_to(a, decided)
        mark(a, not_before)
        alu(a, "add", rax, rax)
        jmp_to(a, decided)
        mark(a, wrong)
        cmp_mistake(a, 0)
    end

    # `is`: numbers as rt_order has them, anything else as rt_equal does
    set odd to new_label(a)
    mark(a, "rt_cmp_is")
    odd_jump(a, xmm0, odd)
    odd_jump(a, xmm1, odd)
    call_to(a, "rt_order")
    test_rr(a, rax, rax)
    setcc(a, cc_e, rax)
    movzx8(a, rax, rax)
    ret(a)
    mark(a, odd)
    movq_rx(a, rax, xmm0)
    movq_rx(a, rdx, xmm1)
    jmp_to(a, "rt_equal")

    # `is divisible by`: whole numbers by their remainder, anything else by whether a / b is whole to 15 digits
    set wrong to new_label(a)
    set by_zero to new_label(a)
    set general to new_label(a)
    set huge to new_label(a)
    set holds to new_label(a)
    set fails to new_label(a)
    set rem_loop to new_label(a)
    set b_whole to new_label(a)
    set a_ok to new_label(a)
    mark(a, "rt_cmp_div")
    odd_jump(a, xmm0, wrong)
    odd_jump(a, xmm1, wrong)
    movq_rx(a, rax, xmm1)
    shifti(a, "shl", rax, 1)
    jcc(a, cc_e, by_zero)
    finite_jump(a, xmm0, general)
    finite_jump(a, xmm1, general)
    is_whole(a, xmm0, a_ok)
    jmp_to(a, general)
    mark(a, a_ok)
    is_whole(a, xmm1, b_whole)
    jmp_to(a, general)
    mark(a, b_whole)
    movi64(a, rcx, list of 0, 0, 0, 0, 0, 0, 0x40, 0x43) # both below 2^53: a 64-bit remainder
    movq_rx(a, rax, xmm0)
    bit_op(a, "btr", rax, 63)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_ae, huge)
    movq_rx(a, rax, xmm1)
    bit_op(a, "btr", rax, 63)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_ae, huge)
    cvttsd2si(a, rax, xmm0)
    cvttsd2si(a, rcx, xmm1)
    raw(a, list of 0x48, 0x99) # cqo
    unary(a, "idiv", rcx)
    test_rr(a, rdx, rdx)
    jcc(a, cc_e, holds)
    jmp_to(a, fails)
    mark(a, huge) # bigger: the x87's exact remainder
    movsd_store(a, rip("o_a"), xmm0)
    movsd_store(a, rip("o_b"), xmm1)
    enc(a, empty list, no, (list of 0xDD), 0, rip("o_b"), empty list) # fld b
    enc(a, empty list, no, (list of 0xDD), 0, rip("o_a"), empty list) # fld a
    mark(a, rem_loop)
    raw(a, list of 0xD9, 0xF8) # fprem
    raw(a, list of 0xDF, 0xE0) # fnstsw ax
    raw(a, list of 0xF6, 0xC4, 0x04) # test ah, 4: not finished yet
    jcc(a, cc_ne, rem_loop)
    enc(a, empty list, no, (list of 0xDD), 3, rip("o_ma"), empty list) # fstp the remainder
    raw(a, list of 0xDD, 0xD8) # fstp st(0)
    load(a, rax, rip("o_ma"))
    shifti(a, "shl", rax, 1)
    jcc(a, cc_e, holds)
    jmp_to(a, fails)
    mark(a, general)
    movapd(a, xmm2, xmm0)
    sse_math(a, "/", xmm2, reg_at(xmm1))
    finite_jump(a, xmm2, fails)
    movapd(a, xmm0, xmm2)
    movq_rx(a, rax, xmm0)
    bit_op(a, "btr", rax, 63)
    movq_xr(a, xmm0, rax)
    is_whole(a, xmm0, holds)
    call_to(a, "rt_canon_int")
    ret(a)
    mark(a, holds)
    movi(a, rax, 1)
    ret(a)
    mark(a, fails)
    movi(a, rax, 0)
    ret(a)
    mark(a, wrong)
    cmp_mistake(a, 0)
    mark(a, by_zero)
    cmp_mistake(a, 1)

    # rt_canon_int: xmm0, a number above 0 that isn't whole: rax is 1 if it is whole to 15 digits, with rcx
    # that whole number, else 0
    set big_enough to new_label(a)
    set not_whole to new_label(a)
    set tens to new_label(a)
    set times_one to new_label(a)
    mark(a, "rt_canon_int")
    call_to(a, "rt_dec15")
    alui(a, "cmp", rdx, 15)
    jcc(a, cc_ge, big_enough)
    alui(a, "cmp", rdx, 1)
    jcc(a, cc_l, not_whole)
    movi(a, rcx, 15)
    alu(a, "sub", rcx, rdx)
    movi(a, r8, 1)
    mark(a, tens)
    imul_ri(a, r8, r8, 10)
    dec_r(a, rcx)
    jcc(a, cc_ne, tens)
    movi(a, rdx, 0)
    unary(a, "div", r8)
    test_rr(a, rdx, rdx)
    jcc(a, cc_ne, not_whole)
    mov_rr(a, rcx, rax)
    movi(a, rax, 1)
    ret(a)
    mark(a, big_enough)
    mov_rr(a, rcx, rax)
    alui(a, "cmp", rdx, 15)
    jcc(a, cc_e, times_one)
    imul_ri(a, rcx, rcx, 10)
    mark(a, times_one)
    movi(a, rax, 1)
    ret(a)
    mark(a, not_whole)
    movi(a, rax, 0)
    ret(a)

    # rt_repeat: xmm0, how many times a `repeat` goes round, which must be whole to 15 digits and 0 or
    # more: xmm0 gets it, and rax 0, or rax is 2 for a mistake
    set bad to new_label(a)
    set whole_count to new_label(a)
    mark(a, "rt_repeat")
    movsd_store(a, rip("err_a"), xmm0)
    odd_jump(a, xmm0, bad)
    finite_jump(a, xmm0, bad)
    movq_rx(a, rax, xmm0)
    test_rr(a, rax, rax)
    jcc(a, cc_s, whole_count)
    is_whole(a, xmm0, whole_count)
    call_to(a, "rt_canon_int")
    test_rr(a, rax, rax)
    jcc(a, cc_e, bad)
    cvtsi2sd(a, xmm0, rcx)
    movi(a, rax, 0)
    ret(a)
    mark(a, whole_count) # whole, or below 0
    movsd_load(a, xmm0, rip("err_a"))
    movi(a, rax, 0)
    movq_xr(a, xmm1, rax)
    ucomisd(a, xmm0, reg_at(xmm1))
    jcc(a, cc_b, bad)
    is_whole(a, xmm0, "rt_ok0")
    jmp_to(a, bad)
    mark(a, "rt_ok0")
    movi(a, rax, 0)
    ret(a)
    mark(a, bad)
    movi(a, rax, 2)
    ret(a)

    # rt_any_odd: rax is 1 if xmm2 or xmm1 isn't a plain number
    set found to new_label(a)
    mark(a, "rt_any_odd")
    odd_jump(a, xmm2, found)
    odd_jump(a, xmm1, found)
    movi(a, rax, 0)
    ret(a)
    mark(a, found)
    movi(a, rax, 1)
    ret(a)
end

# the bits of a number's double to 15 digits (from o_a or o_b, as xmm x says), saved in `into`; a
# whole number is itself
to small_canon with a, x, into
    set whole to new_label(a)
    set saved to new_label(a)
    if x is xmm0
        movsd_load(a, xmm0, rip("o_a"))
    else
        movsd_load(a, xmm0, rip("o_b"))
    end
    movq_rx(a, rax, xmm0)
    bit_op(a, "btr", rax, 63)
    movq_xr(a, xmm0, rax)
    is_whole(a, xmm0, whole)
    call_to(a, "rt_canon_double")
    jmp_to(a, saved)
    mark(a, whole)
    movq_rx(a, rax, xmm0)
    mark(a, saved)
    store(a, rip(into), rax)
end

# jumps if xmm x holds nothing, yes or no; uses rax and rcx
to special_jump with a, x, name
    movq_rx(a, rax, x)
    movi64(a, rcx, bits_nothing)
    alu(a, "sub", rax, rcx)
    alui(a, "cmp", rax, 3)
    jcc(a, cc_b, name)
end

# jumps if xmm x is an infinity or NaN; uses rax and rcx
to finite_jump with a, x, name
    movq_rx(a, rax, x)
    shifti(a, "shl", rax, 1)
    movi64(a, rcx, list of 0, 0, 0, 0, 0, 0, 0xE0, 0xFF)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_ae, name)
end

# jumps if xmm x, a finite number, is whole; uses rax, rcx and xmm4
to is_whole with a, x, name
    movq_rx(a, rax, x)
    bit_op(a, "btr", rax, 63)
    movi64(a, rcx, list of 0, 0, 0, 0, 0, 0, 0x30, 0x43) # 2^52 and up are all whole
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_ae, name)
    cvttsd2si(a, rax, x)
    cvtsi2sd(a, xmm4, rax)
    ucomisd(a, x, reg_at(xmm4))
    jcc(a, cc_e, name)
end

to cmp_mistake with a, why
    movsd_store(a, rip("err_a"), xmm0)
    movsd_store(a, rip("err_b"), xmm1)
    storei(a, rip("err_why"), why)
    movi(a, rax, 2)
    ret(a)
end

# ---------- the runtime: mistakes ----------
# A mistake is written as `moth run` writes it: where, what, the line with the spot marked, and the calls in
# progress. The code that finds it calls rt_e_start with the record of where, adds what to say with
# rt_e_text, rt_e_kind and rt_e_shown, and jumps to rt_e_end. Each frame keeps the number of the call that
# made it just under where rbp points, so rt_e_end can walk them.

to emit_mistakes with a
    mark(a, "rt_e_start") # rsi: where it happened: "file:line:col: " then "\n" and the line
    store(a, rip("err_site"), rsi)
    call_to(a, "rt_b_reset")
    load(a, rsi, rip("err_site"))
    load32(a, rcx, mem(rsi, 0))
    store(a, rip("reason_at"), rcx)
    alui(a, "add", rsi, 4)
    mark(a, "rt_e_text") # rsi, rcx: these bytes
    jmp_to(a, "rt_b_bytes")

    set kind_nothing to new_label(a)
    set kind_bool to new_label(a)
    set in_memory to new_label(a)
    mark(a, "rt_e_kind") # rax: what kind of value it is
    movi64(a, rcx, bits_nothing)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_e, kind_nothing)
    inc_r(a, rcx)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_e, kind_bool)
    inc_r(a, rcx)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_e, kind_bool)
    if units of a # an amount: what it measures
        mov_rr(a, rdx, rax)
        shifti(a, "shr", rdx, 48)
        alui(a, "cmp", rdx, kind_quantity)
        jcc(a, cc_e, "rt_q_kind")
    end
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_text)
    jcc(a, cc_ae, in_memory)
    point_at_text(a, "a number")
    jmp_to(a, "rt_b_bytes")
    mark(a, kind_nothing)
    point_at_text(a, "nothing")
    jmp_to(a, "rt_b_bytes")
    mark(a, kind_bool)
    point_at_text(a, "yes/no")
    jmp_to(a, "rt_b_bytes")
    mark(a, in_memory)
    set n to kind_text
    for each word in list of "text", "a list", "a record", "a dictionary", "bytes", "a function"
        set other to new_label(a)
        alui(a, "cmp", rax, n)
        jcc(a, cc_ne, other)
        point_at_text(a, word)
        jmp_to(a, "rt_b_bytes")
        mark(a, other)
        add 1 to n
    end
    point_at_text(a, "a value")
    jmp_to(a, "rt_b_bytes")

    mark(a, "rt_e_shown") # rax, rdx: a value as `say` shows it, rdx 1 inside a list
    jmp_to(a, "rt_b_value")

    mark(a, "rt_e_plain") # rax: a whole number's digits
    call_to(a, "rt_digits")
    lea(a, rsi, rip("dbuf"))
    jmp_to(a, "rt_b_bytes")

    set first_group to new_label(a)
    set groups to new_label(a)
    set grouped to new_label(a)
    mark(a, "rt_e_grouped") # rax: a whole number with commas, as toLocaleString writes it
    call_to(a, "rt_digits")
    mov_rr(a, r9, rcx)
    mov_rr(a, rax, rcx)
    movi(a, rdx, 0)
    movi(a, r8, 3)
    unary(a, "div", r8)
    test_rr(a, rdx, rdx)
    jcc(a, cc_ne, first_group)
    movi(a, rdx, 3)
    mark(a, first_group)
    lea(a, r10, rip("dbuf"))
    mov_rr(a, rsi, r10)
    mov_rr(a, rcx, rdx)
    alu(a, "sub", r9, rdx)
    alu(a, "add", r10, rdx)
    call_to(a, "rt_b_bytes")
    mark(a, groups)
    test_rr(a, r9, r9)
    jcc(a, cc_e, grouped)
    movi(a, rax, 44)
    call_to(a, "rt_b_byte")
    mov_rr(a, rsi, r10)
    movi(a, rcx, 3)
    alui(a, "sub", r9, 3)
    alui(a, "add", r10, 3)
    call_to(a, "rt_b_bytes")
    jmp_to(a, groups)
    mark(a, grouped)
    ret(a)

    set walk to new_label(a)
    set fresh to new_label(a)
    set first to new_label(a)
    set onward to new_label(a)
    set walked to new_label(a)
    set counted to new_label(a)
    set close to new_label(a)
    set one_line to new_label(a)
    set skip to new_label(a)
    set uncaught to new_label(a)
    set as_text to new_label(a)
    set unwind to new_label(a)
    mark(a, "rt_e_end")
    load(a, rax, rip("try_top")) # inside a try: what failed, or the mistake's message, goes to its `if it fails`
    test_rr(a, rax, rax)
    jcc(a, cc_e, uncaught)
    storei(a, rip("err_fake_fn"), 0)
    load(a, rcx, rip("fail_has"))
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, as_text)
    storei(a, rip("fail_has"), 0)
    movsd_load(a, xmm0, rip("fail_val"))
    jmp_to(a, unwind)
    mark(a, as_text)
    load(a, rsi, rip("b_ptr"))
    alu_load(a, "add", rsi, rip("reason_at"))
    load(a, rcx, rip("b_len"))
    alu_load(a, "sub", rcx, rip("reason_at"))
    call_to(a, "rt_text_from")
    movq_xr(a, xmm0, rax)
    mark(a, unwind) # back to the try's frame and stack, and on to its handler
    mark(a, "rt_e_unwind")
    load(a, rax, rip("try_top"))
    load(a, r15, mem(rax, 0))
    load(a, rbp, mem(rax, 8))
    load(a, rcx, mem(rax, 16))
    load(a, rdx, mem(rax, 24))
    store(a, rip("try_top"), rdx)
    lea(a, rsp, mem(rax, 32))
    jmp_r(a, rcx)
    mark(a, uncaught)
    load(a, rsi, rip("err_site")) # the line, then as much of its marker as comes before the spot, then ^
    load32(a, rax, mem(rsi, 0))
    alu(a, "add", rsi, rax)
    alui(a, "add", rsi, 4)
    load32(a, rax, mem(rsi, 8))
    push_r(a, rax)
    load(a, rsi, mem(rsi, 0))
    push_r(a, rsi)
    load32(a, rcx, mem(rsi, 0))
    alui(a, "add", rsi, 4)
    call_to(a, "rt_e_text")
    pop_r(a, rsi)
    load32(a, rax, mem(rsi, 0))
    alu(a, "add", rsi, rax)
    alui(a, "add", rsi, 8)
    pop_r(a, rcx)
    call_to(a, "rt_e_text")
    point_at_text(a, "^")
    call_to(a, "rt_e_text")
    mov_rr(a, rbx, rbp) # the calls in progress, innermost first, one line for a run of the same call
    set real_frames to new_label(a)
    load(a, rax, rip("err_fake_fn")) # in a function put in line: first a frame as its call would have made,
    test_rr(a, rax, rax) # going back to a call's number, as after a call, and on to the frame it was in
    jcc(a, cc_e, real_frames)
    dec_r(a, rax)
    load(a, rdx, rip("err_fake_site"))
    shifti(a, "shl", rdx, 8)
    alui(a, "or", rdx, 0xA9)
    lea(a, rcx, rip("err_fake_mark"))
    store(a, mem(rcx, 0), rdx)
    alui(a, "sub", rsp, 24)
    store(a, mem(rsp, 0), rax)
    store(a, mem(rsp, 8), rbp)
    store(a, mem(rsp, 16), rcx)
    lea(a, rbx, mem(rsp, 8))
    mark(a, real_frames)
    movi(a, r12, -1)
    movi(a, r13, 0)
    movi(a, r14, 0)
    storei(a, rip("t_prev_fn"), 0)
    mark(a, walk)
    load(a, rcx, mem(rbx, 8)) # where it was called from: the number after where it goes back to
    movi(a, rax, -1)
    load8(a, rdx, mem(rcx, 0))
    alui(a, "cmp", rdx, 0xA9)
    jcc(a, cc_ne, walked)
    load32s(a, rax, mem(rcx, 1))
    alui(a, "cmp", rax, -1)
    jcc(a, cc_e, walked)
    load(a, rcx, mem(rbx, -8)) # and the function's name
    shifti(a, "shl", rcx, 3)
    lea(a, rdx, rip("fn_names"))
    alu(a, "add", rdx, rcx)
    load(a, rcx, mem(rdx, 0))
    alu(a, "cmp", rax, r12)
    jcc(a, cc_ne, fresh)
    alu_load(a, "cmp", rcx, rip("t_prev_fn"))
    jcc(a, cc_ne, fresh)
    inc_r(a, r13)
    jmp_to(a, onward)
    mark(a, fresh)
    test_rr(a, r13, r13)
    jcc(a, cc_e, first)
    push_r(a, rax)
    push_r(a, rcx)
    call_to(a, one_line)
    pop_r(a, rcx)
    pop_r(a, rax)
    mark(a, first)
    mov_rr(a, r12, rax)
    store(a, rip("t_prev_fn"), rcx)
    movi(a, r13, 1)
    mark(a, onward)
    load(a, rbx, mem(rbx, 0))
    jmp_to(a, walk)
    mark(a, walked)
    test_rr(a, r13, r13)
    jcc(a, cc_e, counted)
    call_to(a, one_line)
    mark(a, counted)
    alui(a, "cmp", r14, 10)
    jcc(a, cc_be, close)
    point_at_text(a, "\n  ... and ")
    call_to(a, "rt_e_text")
    mov_rr(a, rax, r14)
    alui(a, "sub", rax, 10)
    call_to(a, "rt_e_plain")
    point_at_text(a, " more")
    call_to(a, "rt_e_text")
    mark(a, close)
    point_at_text(a, "\n")
    call_to(a, "rt_e_text")
    call_to(a, "rt_flush_out")
    movi(a, rdi, 2)
    load(a, rsi, rip("b_ptr"))
    load(a, rdx, rip("b_len"))
    call_to(a, "rt_write")
    if last_word of a # the debugger stopped where it went wrong, then what the profiler found, up to the mistake
        call_to(a, "rt_dbg_failed")
        call_to(a, "rt_flush_out")
        call_to(a, "rt_last_word")
        call_to(a, "rt_flush_out")
    end
    movi(a, rcx, 1)
    jmp_to(a, "rt_exit")
    mark(a, one_line) # the call r12 to the function named t_prev_fn, r13 times in a row; the first 10 are shown
    alui(a, "cmp", r14, 10)
    jcc(a, cc_ae, skip)
    point_at_text(a, "\n  in '")
    call_to(a, "rt_e_text")
    load(a, rax, rip("t_prev_fn"))
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    call_to(a, "rt_e_text")
    point_at_text(a, "', ")
    call_to(a, "rt_e_text")
    lea(a, rdx, rip("site_table"))
    mov_rr(a, rax, r12)
    shifti(a, "shl", rax, 3)
    alu(a, "add", rdx, rax)
    load(a, rax, mem(rdx, 0))
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    call_to(a, "rt_e_text")
    alui(a, "cmp", r13, 1)
    jcc(a, cc_be, skip)
    point_at_text(a, " (")
    call_to(a, "rt_e_text")
    mov_rr(a, rax, r13)
    call_to(a, "rt_e_grouped")
    point_at_text(a, " times)")
    call_to(a, "rt_e_text")
    mark(a, skip)
    inc_r(a, r14)
    ret(a)
end

# ---------- the runtime: memory ----------
# Values that live in memory come from rt_alloc, and memory no value can reach any more is given back by a
# garbage collector, so a program that makes and drops values all the time, as a compiler does, runs in the
# memory its live values need.
#
# Blocks come in 38 sizes, from 16 bytes to 32 KB; a page of 64 KB holds blocks of one size, and anything
# bigger gets whole pages of its own. A bitmap beside the memory, one bit for each 16 bytes, says where a
# block that's been handed out starts, and another marks what the collector finds. The collector looks
# for values everywhere they can be: the stack, the registers, the program's variables and the runtime's
# own, and every word of every block it finds that can hold values. Any word that could be where a block
# is counts, tagged as a value or not, so code in the middle of making a list never loses it; nothing
# moves, so whatever points at a block keeps pointing at it. What it doesn't find is zeroed and handed
# out again, and a page with nothing left on it goes back to be used for anything.
#
# All of it sits in one stretch of address space taken at the start, given memory as it's needed: 64 GB
# for blocks, then the two bitmaps, 32 bytes about each page (what it holds), and room for the collector's
# own list of blocks still to look through.

set gc_page to 65536
set gc_heap_size to 68719476736 # 64 GB
set gc_abits_at to gc_heap_size # which 16 bytes start a block
set gc_mbits_at to gc_heap_size + 536870912 # which blocks the collector found
set gc_info_at to gc_heap_size + 1073741824 # 32 bytes for each page
set gc_marks_at to gc_heap_size + 2147483648 # blocks found but not yet looked through
set gc_reserved to gc_heap_size + 2147483648 + 4294967296 + 65536
set gc_chunk to 67108864 # memory is asked for 64 MB at a time
set gc_first_run to 67108864 # the first collection after 64 MB of pages
set gc_sizes to list of 16, 32, 48, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 384, 448, 512, 640, 768, 896, 1024,
    1280, 1536, 1792, 2048, 2560, 3072, 3584, 4096, 5120, 6144, 7168, 8192, 9360, 10912, 13104, 16384, 21840, 32768

to movi_big with a, r, v
    set eight to empty list
    put64(eight, v)
    movi64(a, r, eight)
end

# the carry flag gets bit r of the bits starting at `at`; bts sets it as well, btr clears it
to bt_at with a, at, r
    enc(a, empty list, yes, (list of 0x0F, 0xA3), r, at, empty list)
end

to bts_at with a, at, r
    enc(a, empty list, yes, (list of 0x0F, 0xAB), r, at, empty list)
end

to btr_at with a, at, r
    enc(a, empty list, yes, (list of 0x0F, 0xB3), r, at, empty list)
end

# the tables of block sizes: for each size up to 32 KB in 16-byte steps, its size's number; each size; and
# how many blocks of it a page holds
to emit_gc_tables with a
    set ro to rodata of a
    rodata_here(a, "gc_size_class")
    set sc_class to 0
    for each sc_g from 0 to 2048
        repeat while item (sc_class + 1) of gc_sizes is less than sc_g * 16
            add 1 to sc_class
        end
        add sc_class to ro
    end
    pad_to(ro, 8)
    rodata_here(a, "gc_class_size")
    for each sc_size in gc_sizes
        put64(ro, sc_size)
    end
    rodata_here(a, "gc_class_count")
    for each sc_size in gc_sizes
        set sc_fit to 0
        repeat while (sc_fit + 1) * sc_size is at most gc_page
            add 1 to sc_fit
        end
        put64(ro, sc_fit)
    end
end

to emit_memory with a, target
    emit_alloc(a)
    emit_pages(a)
    emit_collect(a)
    emit_os_memory(a, target)
end

to emit_alloc with a
    # rt_alloc: rcx: a zeroed block of at least that many bytes, 16-aligned, in rax, which may hold values;
    # rt_alloc_raw: the same for bytes that are never values, which the collector doesn't look through.
    # Every other register is kept.
    set common to new_label(a)
    set sized to new_label(a)
    set take to new_label(a)
    set refill to new_label(a)
    set big to new_label(a)
    mark(a, "rt_alloc_raw")
    push_r(a, r8)
    movi(a, r8, 1)
    jmp_to(a, common)
    mark(a, "rt_alloc")
    push_r(a, r8)
    movi(a, r8, 0)
    mark(a, common)
    push_r(a, rcx)
    push_r(a, rdx)
    alui(a, "add", rcx, 15)
    shifti(a, "shr", rcx, 4) # in 16-byte steps
    jcc(a, cc_ne, sized)
    movi(a, rcx, 1)
    mark(a, sized)
    alui(a, "cmp", rcx, 2048)
    jcc(a, cc_a, big)
    lea(a, rdx, rip("gc_size_class"))
    alu(a, "add", rdx, rcx)
    load8(a, rdx, mem(rdx, 0))
    shifti(a, "shl", rdx, 1)
    alu(a, "add", rdx, r8)
    shifti(a, "shl", rdx, 3)
    lea(a, rax, rip("gc_free"))
    alu(a, "add", rdx, rax) # where the first free block of that size is
    load(a, rax, mem(rdx, 0))
    test_rr(a, rax, rax)
    jcc(a, cc_e, refill)
    mark(a, take)
    load(a, rcx, mem(rax, 0))
    store(a, mem(rdx, 0), rcx)
    storei(a, mem(rax, 0), 0)
    mov_rr(a, rcx, rax)
    alu_load(a, "sub", rcx, rip("gc_base"))
    shifti(a, "shr", rcx, 4)
    load(a, rdx, rip("gc_abits"))
    bts_at(a, mem(rdx, 0), rcx)
    pop_r(a, rdx)
    pop_r(a, rcx)
    pop_r(a, r8)
    ret(a)
    mark(a, refill)
    call_to(a, "rt_gc_refill")
    load(a, rax, mem(rdx, 0))
    jmp_to(a, take)
    mark(a, big)
    call_to(a, "rt_gc_large")
    pop_r(a, rdx)
    pop_r(a, rcx)
    pop_r(a, r8)
    ret(a)

    # rt_block_size: rcx bytes: how big the block rt_alloc gives for them is, in rcx; every other register
    # is kept
    set whole_pages to new_label(a)
    set some to new_label(a)
    mark(a, "rt_block_size")
    push_r(a, rdx)
    alui(a, "add", rcx, 15)
    shifti(a, "shr", rcx, 4)
    jcc(a, cc_ne, some)
    movi(a, rcx, 1)
    mark(a, some)
    alui(a, "cmp", rcx, 2048)
    jcc(a, cc_a, whole_pages)
    lea(a, rdx, rip("gc_size_class"))
    alu(a, "add", rdx, rcx)
    load8(a, rcx, mem(rdx, 0))
    shifti(a, "shl", rcx, 3)
    lea(a, rdx, rip("gc_class_size"))
    alu(a, "add", rdx, rcx)
    load(a, rcx, mem(rdx, 0))
    pop_r(a, rdx)
    ret(a)
    mark(a, whole_pages)
    shifti(a, "shl", rcx, 4)
    alui(a, "add", rcx, 65535)
    alui(a, "and", rcx, -65536)
    pop_r(a, rdx)
    ret(a)

    # rt_bytes: rcx: room for that many bytes of a text, in rax; rt_bytes_room: the same with rdx bytes more
    # to grow into. Every other register is kept. They come in a block of their own, after how many of its
    # bytes are used and how many it has room for, so a text that ends where its block's used bytes end can
    # grow in place.
    mark(a, "rt_bytes")
    push_r(a, rdx)
    movi(a, rdx, 0)
    call_to(a, "rt_bytes_room")
    pop_r(a, rdx)
    ret(a)
    mark(a, "rt_bytes_room")
    push_r(a, rcx)
    push_r(a, r8)
    mov_rr(a, r8, rcx)
    alu(a, "add", rcx, rdx)
    alui(a, "add", rcx, 16)
    call_to(a, "rt_alloc_raw")
    store(a, mem(rax, 0), r8)
    call_to(a, "rt_block_size")
    alui(a, "sub", rcx, 16)
    store(a, mem(rax, 8), rcx)
    alui(a, "add", rax, 16)
    pop_r(a, r8)
    pop_r(a, rcx)
    ret(a)

    # rt_tail_block: rax a text, untagged: the block its bytes are in, in rax, if they start it and end
    # where its used bytes do, so more can go straight after them; else 0. Every other register is kept.
    set not_tail to new_label(a)
    mark(a, "rt_tail_block")
    push_r(a, rcx)
    push_r(a, rdx)
    push_r(a, r8)
    load(a, rdx, mem(rax, 16))
    load(a, rcx, mem(rax, 0))
    alui(a, "sub", rdx, 16)
    mov_rr(a, rax, rdx)
    alui(a, "and", rax, 15)
    jcc(a, cc_ne, not_tail)
    mov_rr(a, rax, rdx)
    alu_load(a, "sub", rax, rip("gc_base"))
    load(a, r8, rip("gc_pages"))
    shifti(a, "shl", r8, 16)
    alu(a, "cmp", rax, r8)
    jcc(a, cc_ae, not_tail) # not in the memory blocks come from: one of the program's own texts
    shifti(a, "shr", rax, 4)
    load(a, r8, rip("gc_abits"))
    bt_at(a, mem(r8, 0), rax)
    jcc(a, cc_ae, not_tail)
    alu_load(a, "cmp", rcx, mem(rdx, 0))
    jcc(a, cc_ne, not_tail)
    mov_rr(a, rax, rdx)
    pop_r(a, r8)
    pop_r(a, rdx)
    pop_r(a, rcx)
    ret(a)
    mark(a, not_tail)
    movi(a, rax, 0)
    pop_r(a, r8)
    pop_r(a, rdx)
    pop_r(a, rcx)
    ret(a)
end

to emit_pages with a
    # rt_gc_refill: rdx where the first free block of a size is, when there's none: more, after collecting
    # if enough pages have been taken since the last time, else from a new page. Every register but rax
    # is kept.
    set fresh to new_label(a)
    set filled to new_label(a)
    set linking to new_label(a)
    set linked to new_label(a)
    mark(a, "rt_gc_refill")
    for each r in list of rbx, rcx, rdx, rsi, rdi, r8, r9, r10
        push_r(a, r)
    end
    mov_rr(a, rbx, rdx)
    load(a, rax, rip("gc_since"))
    alu_load(a, "cmp", rax, rip("gc_threshold"))
    jcc(a, cc_b, fresh)
    call_to(a, "rt_collect")
    load(a, rax, mem(rbx, 0))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, filled)
    mark(a, fresh)
    movi(a, rcx, 1)
    call_to(a, "rt_gc_pages")
    mov_rr(a, rcx, rbx) # which size, and whether its blocks hold values
    lea(a, rdx, rip("gc_free"))
    alu(a, "sub", rcx, rdx)
    shifti(a, "shr", rcx, 3)
    mov_rr(a, r8, rcx)
    alui(a, "and", r8, 1)
    shifti(a, "shr", rcx, 1)
    mov_rr(a, rdx, rax) # the page holds blocks of that size
    shifti(a, "shl", rdx, 5)
    alu_load(a, "add", rdx, rip("gc_info"))
    mov_rr(a, r9, rcx)
    shifti(a, "shl", r9, 8)
    alu(a, "or", r9, r8)
    shifti(a, "shl", r9, 8)
    alui(a, "or", r9, 1)
    store(a, mem(rdx, 0), r9)
    mov_rr(a, rsi, rax)
    shifti(a, "shl", rsi, 16)
    alu_load(a, "add", rsi, rip("gc_base"))
    shifti(a, "shl", rcx, 3)
    lea(a, r9, rip("gc_class_size"))
    alu(a, "add", r9, rcx)
    load(a, r9, mem(r9, 0))
    lea(a, r10, rip("gc_class_count"))
    alu(a, "add", r10, rcx)
    load(a, r10, mem(r10, 0))
    movi(a, rax, 0) # each block points at the next, the first first
    mov_rr(a, rdi, r10)
    dec_r(a, rdi)
    imul_rr(a, rdi, r9)
    alu(a, "add", rdi, rsi)
    mark(a, linking)
    store(a, mem(rdi, 0), rax)
    mov_rr(a, rax, rdi)
    alu(a, "cmp", rdi, rsi)
    jcc(a, cc_e, linked)
    alu(a, "sub", rdi, r9)
    jmp_to(a, linking)
    mark(a, linked)
    store(a, mem(rbx, 0), rax)
    mark(a, filled)
    for each r in list of r10, r9, r8, rdi, rsi, rdx, rcx, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_gc_large: rcx 16-byte steps, more than a page of blocks holds, and r8 1 if they never hold values:
    # whole pages of their own, zeroed, in rax; every other register is kept
    set taken to new_label(a)
    set rest_pages to new_label(a)
    set paged to new_label(a)
    mark(a, "rt_gc_large")
    for each r in list of rbx, rcx, rdx, rsi
        push_r(a, r)
    end
    load(a, rax, rip("gc_since"))
    alu_load(a, "cmp", rax, rip("gc_threshold"))
    jcc(a, cc_b, taken)
    call_to(a, "rt_collect")
    mark(a, taken)
    shifti(a, "shl", rcx, 4)
    alui(a, "add", rcx, 65535)
    shifti(a, "shr", rcx, 16)
    mov_rr(a, rbx, rcx)
    call_to(a, "rt_gc_pages")
    mov_rr(a, rdx, rax)
    shifti(a, "shl", rdx, 5)
    alu_load(a, "add", rdx, rip("gc_info"))
    mov_rr(a, rsi, r8)
    shifti(a, "shl", rsi, 8)
    alui(a, "or", rsi, 2)
    store(a, mem(rdx, 0), rsi)
    store(a, mem(rdx, 8), rbx)
    movi(a, rcx, 1) # the pages after it say where it starts
    mark(a, rest_pages)
    alu(a, "cmp", rcx, rbx)
    jcc(a, cc_ae, paged)
    alui(a, "add", rdx, 32)
    storei(a, mem(rdx, 0), 3)
    store(a, mem(rdx, 8), rax)
    inc_r(a, rcx)
    jmp_to(a, rest_pages)
    mark(a, paged)
    mov_rr(a, rcx, rax)
    shifti(a, "shl", rcx, 12)
    load(a, rdx, rip("gc_abits"))
    bts_at(a, mem(rdx, 0), rcx)
    shifti(a, "shl", rax, 16)
    alu_load(a, "add", rax, rip("gc_base"))
    for each r in list of rsi, rdx, rcx, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_gc_pages: rcx pages next to each other, zeroed: the first one's number, in rax. From the free runs
    # of pages, the first that's long enough, else new ones. Every other register is kept.
    set walk to new_label(a)
    set fits to new_label(a)
    set whole to new_label(a)
    set clean to new_label(a)
    set bump to new_label(a)
    set enough to new_label(a)
    set got to new_label(a)
    mark(a, "rt_gc_pages")
    for each r in list of rbx, rcx, rdx, rsi, rdi, r8
        push_r(a, r)
    end
    mov_rr(a, r8, rcx)
    lea(a, rbx, rip("gc_runs")) # where the link to the run looked at is
    mark(a, walk)
    load(a, rax, mem(rbx, 0))
    test_rr(a, rax, rax)
    jcc(a, cc_e, bump)
    dec_r(a, rax)
    mov_rr(a, rdx, rax)
    shifti(a, "shl", rdx, 5)
    alu_load(a, "add", rdx, rip("gc_info"))
    load(a, rcx, mem(rdx, 16))
    alu(a, "cmp", rcx, r8)
    jcc(a, cc_ae, fits)
    lea(a, rbx, mem(rdx, 24))
    jmp_to(a, walk)
    mark(a, fits)
    jcc(a, cc_e, whole)
    mov_rr(a, rsi, rax) # the rest of the run, after the pages taken
    alu(a, "add", rsi, r8)
    mov_rr(a, rdi, rsi)
    shifti(a, "shl", rdi, 5)
    alu_load(a, "add", rdi, rip("gc_info"))
    alu(a, "sub", rcx, r8)
    store(a, mem(rdi, 16), rcx)
    load(a, rcx, mem(rdx, 24))
    store(a, mem(rdi, 24), rcx)
    inc_r(a, rsi)
    store(a, mem(rbx, 0), rsi)
    jmp_to(a, clean)
    mark(a, whole)
    load(a, rcx, mem(rdx, 24))
    store(a, mem(rbx, 0), rcx)
    mark(a, clean) # used before: zeroed now
    push_r(a, rax)
    mov_rr(a, rdi, rax)
    shifti(a, "shl", rdi, 16)
    alu_load(a, "add", rdi, rip("gc_base"))
    mov_rr(a, rcx, r8)
    shifti(a, "shl", rcx, 13)
    movi(a, rax, 0)
    rep_stosq(a)
    pop_r(a, rax)
    jmp_to(a, got)
    mark(a, bump) # new pages, with memory from the system if there isn't enough yet
    load(a, rax, rip("gc_pages"))
    mov_rr(a, rcx, rax)
    alu(a, "add", rcx, r8)
    mov_rr(a, rdx, rcx)
    shifti(a, "shl", rdx, 16)
    alu_load(a, "cmp", rdx, rip("gc_committed"))
    jcc(a, cc_be, enough)
    call_to(a, "rt_gc_commit")
    mark(a, enough)
    store(a, rip("gc_pages"), rcx)
    mark(a, got)
    mov_rr(a, rcx, r8)
    shifti(a, "shl", rcx, 16)
    alu_store(a, "add", rip("gc_since"), rcx)
    for each r in list of r8, rdi, rsi, rdx, rcx, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_gc_commit: rdx bytes of blocks from the start: memory for them, and for what's kept about them, 64
    # MB at a time; every register is kept
    set room to new_label(a)
    mark(a, "rt_gc_commit")
    for each r in list of rax, rbx, rcx, rdx, rsi
        push_r(a, r)
    end
    alui(a, "add", rdx, gc_chunk - 1)
    alui(a, "and", rdx, 0 - gc_chunk)
    movi_big(a, rax, gc_heap_size)
    alu(a, "cmp", rdx, rax)
    jcc(a, cc_be, room)
    jmp_to(a, "rt_out_of_memory")
    mark(a, room)
    mov_rr(a, rbx, rdx)
    load(a, rsi, rip("gc_committed"))
    mov_rr(a, rcx, rsi) # the blocks
    alu_load(a, "add", rcx, rip("gc_base"))
    mov_rr(a, rdx, rbx)
    alu(a, "sub", rdx, rsi)
    call_to(a, "rt_os_commit")
    for each bits in list of "gc_abits", "gc_mbits" # their bits, one for each 16 bytes
        mov_rr(a, rcx, rsi)
        shifti(a, "shr", rcx, 7)
        alu_load(a, "add", rcx, rip(bits))
        mov_rr(a, rdx, rbx)
        alu(a, "sub", rdx, rsi)
        shifti(a, "shr", rdx, 7)
        call_to(a, "rt_os_commit")
    end
    mov_rr(a, rcx, rsi) # 32 bytes for each page
    shifti(a, "shr", rcx, 11)
    alu_load(a, "add", rcx, rip("gc_info"))
    mov_rr(a, rdx, rbx)
    alu(a, "sub", rdx, rsi)
    shifti(a, "shr", rdx, 11)
    call_to(a, "rt_os_commit")
    store(a, rip("gc_committed"), rbx)
    for each r in list of rsi, rdx, rcx, rbx, rax
        pop_r(a, r)
    end
    ret(a)

    # rt_gc_init: the address space for all of it; before anything else runs
    mark(a, "rt_gc_init")
    movi_big(a, rcx, gc_reserved)
    call_to(a, "rt_os_reserve")
    alui(a, "add", rax, 65535)
    alui(a, "and", rax, -65536)
    store(a, rip("gc_base"), rax)
    for each part in list of (list of "gc_abits", gc_abits_at), (list of "gc_mbits", gc_mbits_at),
        (list of "gc_info", gc_info_at), (list of "gc_marks", gc_marks_at)
        movi_big(a, rcx, item 2 of part)
        alu(a, "add", rcx, rax)
        store(a, rip(item 1 of part), rcx)
    end
    load(a, rcx, rip("gc_marks"))
    store(a, rip("gc_marks_end"), rcx)
    storei(a, rip("gc_threshold"), gc_first_run)
    ret(a)

    # rt_gc_more_marks: room for more blocks still to look through; every register is kept
    set marks_room to new_label(a)
    mark(a, "rt_gc_more_marks")
    for each r in list of rax, rcx, rdx
        push_r(a, r)
    end
    load(a, rcx, rip("gc_marks_end"))
    load(a, rax, rip("gc_marks"))
    movi_big(a, rdx, 4294967296 - 16777216)
    alu(a, "add", rax, rdx)
    alu(a, "cmp", rcx, rax)
    jcc(a, cc_be, marks_room)
    jmp_to(a, "rt_out_of_memory")
    mark(a, marks_room)
    movi(a, rdx, 16777216)
    call_to(a, "rt_os_commit")
    alu_store(a, "add", rip("gc_marks_end"), rdx)
    for each r in list of rdx, rcx, rax
        pop_r(a, r)
    end
    ret(a)

    mark(a, "rt_out_of_memory")
    if is_library(a) # a mistake for the call in progress, not the process's end
        lea(a, rax, rip(text_object(a, too_big)))
        movi64(a, rcx, tag_text)
        alu(a, "or", rax, rcx)
        jmp_to(a, "rt_lib_stopped")
    end
    call_to(a, "rt_flush_out")
    point_at_text(a, "a value got too big to fit in memory\n")
    mov_rr(a, rdx, rcx)
    movi(a, rdi, 2)
    call_to(a, "rt_write")
    movi(a, rcx, 1)
    jmp_to(a, "rt_exit")
end

to emit_collect with a
    # rt_collect: every block a value can still be reached from is kept, and the rest given back. Every
    # register is kept. While it runs: r9 is where blocks start, r10 how far they go, r11 where what's kept
    # about pages is, rbx and r14 the two bitmaps, r12 and r13 the bottom and top of the blocks found but
    # not looked through yet.
    set tracing to new_label(a)
    set traced to new_label(a)
    set small_one to new_label(a)
    set sized_one to new_label(a)
    set at_least to new_label(a)
    mark(a, "rt_collect")
    for each r in list of rax, rbx, rcx, rdx, rsi, rdi, rbp, r8, r9, r10, r11, r12, r13, r14, r15
        push_r(a, r)
    end
    alui(a, "sub", rsp, 128) # the xmm registers, so the stack holds every value there is
    for each k from 0 to 15
        movsd_store(a, mem(rsp, 8 * k), k)
    end
    storei(a, rip("gc_live"), 0)
    storei(a, rip("la_ptr"), 0) # a text rt_letter_at remembers may be gone, and its place another's
    load(a, r9, rip("gc_base"))
    load(a, r10, rip("gc_pages"))
    shifti(a, "shl", r10, 16)
    load(a, r11, rip("gc_info"))
    load(a, rbx, rip("gc_abits"))
    load(a, r14, rip("gc_mbits"))
    load(a, r12, rip("gc_marks"))
    mov_rr(a, r13, r12)
    mov_rr(a, rsi, rsp)
    load(a, rdi, rip("stack_top"))
    call_to(a, "rt_gc_scan")
    lea(a, rsi, rip("globals"))
    lea(a, rdi, rip("globals_end"))
    call_to(a, "rt_gc_scan")
    lea(a, rsi, rip("gc_roots_from"))
    lea(a, rdi, rip("gc_roots_to"))
    call_to(a, "rt_gc_scan")
    if task_runtime of a # each other thread's stack, from its registers' copies up (see rt_gil_out)
        set thr_loop to new_label(a)
        set thr_next to new_label(a)
        set thr_done to new_label(a)
        storei(a, rip("gc_thr_i"), 0)
        mark(a, thr_loop)
        load(a, rax, rip("gc_thr_i"))
        alui(a, "cmp", rax, thr_max)
        jcc(a, cc_ae, thr_done)
        imul_ri(a, rax, rax, thr_size)
        lea(a, rdx, rip("thr_slots"))
        alu(a, "add", rax, rdx)
        load(a, rcx, mem(rax, thr_state))
        alui(a, "cmp", rcx, 1)
        jcc(a, cc_ne, thr_next)
        load(a, rcx, mem(rax, thr_holding))
        test_rr(a, rcx, rcx)
        jcc(a, cc_ne, thr_next)
        load(a, rsi, mem(rax, thr_saved))
        test_rr(a, rsi, rsi)
        jcc(a, cc_e, thr_next)
        load(a, rdi, mem(rax, thr_top))
        call_to(a, "rt_gc_scan")
        mark(a, thr_next)
        load(a, rax, rip("gc_thr_i"))
        inc_r(a, rax)
        store(a, rip("gc_thr_i"), rax)
        jmp_to(a, thr_loop)
        mark(a, thr_done)
    end
    mark(a, tracing) # each block found: through it, if it can hold values
    alu(a, "cmp", r13, r12)
    jcc(a, cc_e, traced)
    alui(a, "sub", r13, 8)
    load(a, rax, mem(r13, 0))
    mov_rr(a, rdx, rax)
    shifti(a, "shr", rdx, 16)
    shifti(a, "shl", rdx, 5)
    alu(a, "add", rdx, r11)
    load8(a, r8, mem(rdx, 0))
    alui(a, "cmp", r8, 1)
    jcc(a, cc_e, small_one)
    load(a, rcx, mem(rdx, 8))
    shifti(a, "shl", rcx, 16)
    jmp_to(a, sized_one)
    mark(a, small_one)
    load8(a, r8, mem(rdx, 2))
    shifti(a, "shl", r8, 3)
    lea(a, rcx, rip("gc_class_size"))
    alu(a, "add", rcx, r8)
    load(a, rcx, mem(rcx, 0))
    mark(a, sized_one)
    alu_store(a, "add", rip("gc_live"), rcx)
    load8(a, r8, mem(rdx, 1))
    test_rr(a, r8, r8)
    jcc(a, cc_ne, tracing)
    mov_rr(a, rsi, rax)
    alu(a, "add", rsi, r9)
    mov_rr(a, rdi, rsi)
    alu(a, "add", rdi, rcx)
    call_to(a, "rt_gc_scan")
    jmp_to(a, tracing)
    mark(a, traced)
    call_to(a, "rt_gc_sweep")
    load(a, rax, rip("gc_live")) # the next time after as much again as is live, and at least 64 MB
    alui(a, "cmp", rax, gc_first_run)
    jcc(a, cc_ae, at_least)
    movi(a, rax, gc_first_run)
    mark(a, at_least)
    store(a, rip("gc_threshold"), rax)
    storei(a, rip("gc_since"), 0)
    for each k from 0 to 15
        movsd_load(a, k, mem(rsp, 8 * k))
    end
    alui(a, "add", rsp, 128)
    for each r in list of r15, r14, r13, r12, r11, r10, r9, r8, rbp, rdi, rsi, rdx, rcx, rbx, rax
        pop_r(a, r)
    end
    ret(a)

    # rt_gc_scan: rsi to rdi, 8 bytes at a time: each that could be where a block is, a value tagged as
    # one or an address, marks the block and adds it to those to look through, if it wasn't marked yet.
    # Uses rax, rcx, rdx, rsi, rbp, r8 and r15.
    set word to new_label(a)
    set address to new_label(a)
    set small_block to new_label(a)
    set large_block to new_label(a)
    set found to new_label(a)
    set pushed_room to new_label(a)
    set scanned to new_label(a)
    mark(a, "rt_gc_scan")
    mark(a, word)
    alu(a, "cmp", rsi, rdi)
    jcc(a, cc_ae, scanned)
    load(a, rax, mem(rsi, 0))
    alui(a, "add", rsi, 8)
    mov_rr(a, rdx, rax)
    shifti(a, "shr", rdx, 48)
    jcc(a, cc_e, address)
    alui(a, "sub", rdx, kind_text)
    if units of a # amounts are in memory too
        alui(a, "cmp", rdx, kind_quantity - kind_text)
    else
        alui(a, "cmp", rdx, kind_function - kind_text)
    end
    jcc(a, cc_a, word)
    untag(a, rax)
    mark(a, address)
    alu(a, "sub", rax, r9)
    alu(a, "cmp", rax, r10)
    jcc(a, cc_ae, word)
    mov_rr(a, rcx, rax)
    shifti(a, "shr", rcx, 16)
    mov_rr(a, rdx, rcx)
    shifti(a, "shl", rdx, 5)
    alu(a, "add", rdx, r11)
    load8(a, r8, mem(rdx, 0))
    alui(a, "cmp", r8, 1)
    jcc(a, cc_e, small_block)
    alui(a, "cmp", r8, 2)
    jcc(a, cc_e, large_block)
    alui(a, "cmp", r8, 3)
    jcc(a, cc_ne, word)
    load(a, rcx, mem(rdx, 8)) # in the middle of a big block: where it starts
    mark(a, large_block)
    mov_rr(a, rax, rcx)
    shifti(a, "shl", rax, 16)
    jmp_to(a, found)
    mark(a, small_block) # which block of the page
    load8(a, r8, mem(rdx, 2))
    shifti(a, "shl", r8, 3)
    lea(a, r15, rip("gc_class_size"))
    alu(a, "add", r15, r8)
    load(a, r15, mem(r15, 0))
    lea(a, rbp, rip("gc_class_count"))
    alu(a, "add", rbp, r8)
    load(a, rbp, mem(rbp, 0))
    mov_rr(a, r8, rcx)
    alui(a, "and", rax, 65535)
    movi(a, rdx, 0)
    unary(a, "div", r15)
    alu(a, "cmp", rax, rbp)
    jcc(a, cc_ae, word)
    imul_rr(a, rax, r15)
    shifti(a, "shl", r8, 16)
    alu(a, "add", rax, r8)
    mark(a, found) # rax: where the block starts, from where blocks do
    mov_rr(a, rcx, rax)
    shifti(a, "shr", rcx, 4)
    bt_at(a, mem(rbx, 0), rcx)
    jcc(a, cc_ae, word) # not a block that's been handed out
    bts_at(a, mem(r14, 0), rcx)
    jcc(a, cc_b, word) # found already
    alu_load(a, "cmp", r13, rip("gc_marks_end"))
    jcc(a, cc_b, pushed_room)
    mov_rr(a, rcx, r13)
    call_to(a, "rt_gc_more_marks")
    mark(a, pushed_room)
    store(a, mem(r13, 0), rax)
    alui(a, "add", r13, 8)
    jmp_to(a, word)
    mark(a, scanned)
    ret(a)

    # rt_gc_sweep: every page, in order: a big block not found gives its pages back; a page of small blocks
    # with none found goes back whole; on any other, each block not found is zeroed and becomes free. The
    # pages that go back join the runs of free pages next to them. r15 is the page, r13 the first page of
    # the run being made (or -1) and r12 where the link to it goes.
    set page_loop to new_label(a)
    set pages_done to new_label(a)
    set free_page to new_label(a)
    set large_page to new_label(a)
    set large_dead to new_label(a)
    set free_pages to new_label(a)
    set small_page to new_label(a)
    set any_found to new_label(a)
    set some_found to new_label(a)
    set block_loop to new_label(a)
    set block_free to new_label(a)
    set block_kept to new_label(a)
    set page_swept to new_label(a)
    set run_open to new_label(a)
    set run_none to new_label(a)
    mark(a, "rt_gc_sweep")
    lea(a, rdi, rip("gc_free"))
    movi(a, rcx, 2 * length of gc_sizes)
    movi(a, rax, 0)
    rep_stosq(a)
    storei(a, rip("gc_runs"), 0)
    lea(a, r12, rip("gc_runs"))
    movi(a, r13, -1)
    movi(a, r15, 0)
    mark(a, page_loop)
    alu_load(a, "cmp", r15, rip("gc_pages"))
    jcc(a, cc_ae, pages_done)
    mov_rr(a, rdx, r15)
    shifti(a, "shl", rdx, 5)
    alu(a, "add", rdx, r11)
    load8(a, rax, mem(rdx, 0))
    alui(a, "cmp", rax, 1)
    jcc(a, cc_e, small_page)
    alui(a, "cmp", rax, 2)
    jcc(a, cc_e, large_page)
    mark(a, free_page) # free already: part of a run
    alui(a, "cmp", r13, -1)
    jcc(a, cc_ne, run_open)
    mov_rr(a, r13, r15)
    mark(a, run_open)
    inc_r(a, r15)
    jmp_to(a, page_loop)
    mark(a, large_page)
    load(a, rcx, mem(rdx, 8))
    mov_rr(a, rax, r15)
    shifti(a, "shl", rax, 12)
    bt_at(a, mem(r14, 0), rax)
    jcc(a, cc_ae, large_dead)
    call_to(a, "rt_gc_end_run")
    alu(a, "add", r15, rcx)
    jmp_to(a, page_loop)
    mark(a, large_dead)
    btr_at(a, mem(rbx, 0), rax)
    alui(a, "cmp", r13, -1)
    jcc(a, cc_ne, free_pages)
    mov_rr(a, r13, r15)
    mark(a, free_pages)
    storei(a, mem(rdx, 0), 0)
    alui(a, "add", rdx, 32)
    inc_r(a, r15)
    dec_r(a, rcx)
    jcc(a, cc_ne, free_pages)
    jmp_to(a, page_loop)
    mark(a, small_page) # any block on it found?
    mov_rr(a, rsi, r15)
    shifti(a, "shl", rsi, 9)
    alu(a, "add", rsi, r14)
    movi(a, rcx, 64)
    movi(a, rax, 0)
    mark(a, any_found)
    alu_load(a, "or", rax, mem(rsi, 0))
    alui(a, "add", rsi, 8)
    dec_r(a, rcx)
    jcc(a, cc_ne, any_found)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, some_found)
    mov_rr(a, rdi, r15) # none: the whole page goes back
    shifti(a, "shl", rdi, 9)
    alu(a, "add", rdi, rbx)
    movi(a, rcx, 64)
    rep_stosq(a)
    storei(a, mem(rdx, 0), 0)
    jmp_to(a, free_page)
    mark(a, some_found)
    call_to(a, "rt_gc_end_run")
    load8(a, rcx, mem(rdx, 2)) # its size, and whether it holds values: which free list
    load8(a, rax, mem(rdx, 1))
    mov_rr(a, r8, rcx)
    shifti(a, "shl", r8, 1)
    alu(a, "add", r8, rax)
    shifti(a, "shl", r8, 3)
    lea(a, rax, rip("gc_free"))
    alu(a, "add", r8, rax)
    shifti(a, "shl", rcx, 3)
    lea(a, rbp, rip("gc_class_size"))
    alu(a, "add", rbp, rcx)
    load(a, rbp, mem(rbp, 0))
    lea(a, rax, rip("gc_class_count"))
    alu(a, "add", rax, rcx)
    load(a, rax, mem(rax, 0))
    mov_rr(a, rdx, r15) # rdx: the page; rsi: its last block
    shifti(a, "shl", rdx, 16)
    alu(a, "add", rdx, r9)
    mov_rr(a, rsi, rax)
    dec_r(a, rsi)
    imul_rr(a, rsi, rbp)
    alu(a, "add", rsi, rdx)
    load(a, r10, mem(r8, 0))
    mark(a, block_loop)
    mov_rr(a, rax, rsi)
    alu(a, "sub", rax, r9)
    shifti(a, "shr", rax, 4)
    bt_at(a, mem(r14, 0), rax)
    jcc(a, cc_b, block_kept)
    bt_at(a, mem(rbx, 0), rax)
    jcc(a, cc_ae, block_free)
    btr_at(a, mem(rbx, 0), rax)
    mov_rr(a, rdi, rsi)
    mov_rr(a, rcx, rbp)
    shifti(a, "shr", rcx, 3)
    movi(a, rax, 0)
    rep_stosq(a)
    mark(a, block_free)
    store(a, mem(rsi, 0), r10)
    mov_rr(a, r10, rsi)
    mark(a, block_kept)
    alu(a, "cmp", rsi, rdx)
    jcc(a, cc_e, page_swept)
    alu(a, "sub", rsi, rbp)
    jmp_to(a, block_loop)
    mark(a, page_swept)
    store(a, mem(r8, 0), r10)
    inc_r(a, r15)
    jmp_to(a, page_loop)
    mark(a, pages_done)
    call_to(a, "rt_gc_end_run")
    mov_rr(a, rdi, r14) # nothing is found, for next time
    load(a, rcx, rip("gc_pages"))
    shifti(a, "shl", rcx, 6)
    movi(a, rax, 0)
    rep_stosq(a)
    ret(a)

    # rt_gc_end_run: the run of free pages being made, if there is one, ends before page r15; keeps every
    # register but r12 and r13
    mark(a, "rt_gc_end_run")
    alui(a, "cmp", r13, -1)
    jcc(a, cc_e, run_none)
    push_r(a, rax)
    push_r(a, rcx)
    mov_rr(a, rax, r13)
    shifti(a, "shl", rax, 5)
    alu(a, "add", rax, r11)
    mov_rr(a, rcx, r15)
    alu(a, "sub", rcx, r13)
    store(a, mem(rax, 16), rcx)
    storei(a, mem(rax, 24), 0)
    lea(a, rcx, mem(r13, 1))
    store(a, mem(r12, 0), rcx)
    lea(a, r12, mem(rax, 24))
    movi(a, r13, -1)
    pop_r(a, rcx)
    pop_r(a, rax)
    mark(a, run_none)
    ret(a)
end

# rt_os_reserve: rcx bytes of address space, with no memory yet, in rax; rt_os_commit: memory for rdx
# bytes from rcx. Both keep every other register, and stop the program if the system says no.
to emit_os_memory with a, target
    set refused to new_label(a)
    for each which in list of "rt_os_reserve", "rt_os_commit"
        mark(a, which)
        for each r in list of rcx, rdx, rsi, rdi, r8, r9, r10, r11
            push_r(a, r)
        end
        if target is "windows"
            push_r(a, rbp)
            mov_rr(a, rbp, rsp)
            alui(a, "and", rsp, -16)
            alui(a, "sub", rsp, 96)
            for each k from 0 to 5
                movsd_store(a, mem(rsp, 32 + 8 * k), k)
            end
            if which is "rt_os_reserve"
                mov_rr(a, rdx, rcx)
                movi(a, rcx, 0)
                movi(a, r8, 0x2000) # MEM_RESERVE
                movi(a, r9, 1) # PAGE_NOACCESS
            else
                movi(a, r8, 0x1000) # MEM_COMMIT
                movi(a, r9, 4) # PAGE_READWRITE
            end
            call_import(a, "imp_VirtualAlloc")
            for each k from 0 to 5
                movsd_load(a, k, mem(rsp, 32 + 8 * k))
            end
            mov_rr(a, rsp, rbp)
            pop_r(a, rbp)
            test_rr(a, rax, rax)
            jcc(a, cc_e, refused)
        else
            if which is "rt_os_reserve"
                mov_rr(a, rsi, rcx)
                movi(a, rdi, 0)
                movi(a, rdx, 0) # PROT_NONE
                movi(a, r10, 0x4022) # MAP_PRIVATE, MAP_ANONYMOUS and MAP_NORESERVE
                movi(a, r8, -1)
                movi(a, r9, 0)
                movi(a, rax, 9) # mmap
                raw(a, list of 0x0F, 0x05)
                alui(a, "cmp", rax, -4096)
                jcc(a, cc_a, refused)
            else
                mov_rr(a, rdi, rcx)
                mov_rr(a, rsi, rdx)
                movi(a, rdx, 3) # PROT_READ and PROT_WRITE
                movi(a, rax, 10) # mprotect
                raw(a, list of 0x0F, 0x05)
                test_rr(a, rax, rax)
                jcc(a, cc_ne, refused)
            end
        end
        for each r in list of r11, r10, r9, r8, rdi, rsi, rdx, rcx
            pop_r(a, r)
        end
        ret(a)
    end
    mark(a, refused)
    jmp_to(a, "rt_out_of_memory")
end

# ---------- the runtime: the builder, and showing values ----------
# What `say` says, text that `+` joins, and a mistake's message are all put together in one builder, which
# grows as it needs to. Nothing that uses it runs Moth code while it does, so one is enough.

to emit_builder with a
    mark(a, "rt_b_reset")
    storei(a, rip("b_len"), 0)
    ret(a)

    # rt_b_room: rcx: room for that many more bytes; every register but rax is kept
    set roomy to new_label(a)
    set doubled to new_label(a)
    set least to new_label(a)
    mark(a, "rt_b_room")
    load(a, rax, rip("b_len"))
    alu(a, "add", rax, rcx)
    alu_load(a, "cmp", rax, rip("b_cap"))
    jcc(a, cc_be, roomy)
    for each r in list of rcx, rdx, rsi, rdi
        push_r(a, r)
    end
    mov_rr(a, rdx, rax)
    load(a, rax, rip("b_cap"))
    alu(a, "add", rax, rax)
    alu(a, "cmp", rax, rdx)
    jcc(a, cc_ae, doubled)
    mov_rr(a, rax, rdx)
    mark(a, doubled)
    alui(a, "cmp", rax, 4096)
    jcc(a, cc_ae, least)
    movi(a, rax, 4096)
    mark(a, least)
    store(a, rip("b_cap"), rax)
    mov_rr(a, rcx, rax)
    call_to(a, "rt_alloc_raw")
    mov_rr(a, rdi, rax)
    load(a, rsi, rip("b_ptr"))
    load(a, rcx, rip("b_len"))
    rep_movsb(a)
    store(a, rip("b_ptr"), rax)
    for each r in list of rdi, rsi, rdx, rcx
        pop_r(a, r)
    end
    mark(a, roomy)
    ret(a)

    # rt_b_bytes: rsi, rcx: these bytes; uses rax, rcx, rsi and rdi
    mark(a, "rt_b_bytes")
    call_to(a, "rt_b_room")
    load(a, rdi, rip("b_ptr"))
    load(a, rax, rip("b_len"))
    alu(a, "add", rdi, rax)
    alu(a, "add", rax, rcx)
    store(a, rip("b_len"), rax)
    jmp_to(a, "rt_copy")

    # rt_b_byte: the byte in al; uses rax, rcx and rdi
    mark(a, "rt_b_byte")
    push_r(a, rax)
    movi(a, rcx, 1)
    call_to(a, "rt_b_room")
    pop_r(a, rax)
    load(a, rdi, rip("b_ptr"))
    load(a, rcx, rip("b_len"))
    alu(a, "add", rdi, rcx)
    store8(a, mem(rdi, 0), rax)
    inc_r(a, rcx)
    store(a, rip("b_len"), rcx)
    ret(a)

    # rt_b_chars: rsi, rcx: how many characters those UTF-8 bytes are, in rax; uses rcx, rdx and rsi
    set counting to new_label(a)
    set follower to new_label(a)
    set counted to new_label(a)
    # Eight at a time first: a byte that follows another in a character is 10xxxxxx, so its top bit and not
    # the one below it; those top bits, one in each byte, added up by a multiplication into the top byte,
    # are how many of the eight aren't a character's first.
    set eights to new_label(a)
    mark(a, "rt_b_chars")
    movi(a, rax, 0)
    push_r(a, r8)
    mark(a, eights)
    alui(a, "cmp", rcx, 8)
    jcc(a, cc_b, counting)
    load(a, rdx, mem(rsi, 0))
    mov_rr(a, r8, rdx)
    shifti(a, "shl", r8, 1)
    unary(a, "not", r8)
    alu(a, "and", rdx, r8)
    shifti(a, "shr", rdx, 7)
    movi64(a, r8, list of 1, 1, 1, 1, 1, 1, 1, 1)
    alu(a, "and", rdx, r8)
    imul_rr(a, rdx, r8)
    shifti(a, "shr", rdx, 56)
    alui(a, "add", rax, 8)
    alu(a, "sub", rax, rdx)
    alui(a, "add", rsi, 8)
    alui(a, "sub", rcx, 8)
    jmp_to(a, eights)
    mark(a, counting)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, counted)
    load8(a, rdx, mem(rsi, 0))
    alui(a, "and", rdx, 0xC0)
    alui(a, "cmp", rdx, 0x80)
    jcc(a, cc_e, follower)
    inc_r(a, rax)
    mark(a, follower)
    inc_r(a, rsi)
    dec_r(a, rcx)
    jmp_to(a, counting)
    mark(a, counted)
    pop_r(a, r8)
    ret(a)

    # rt_text_from: rsi, rcx: a new text of those bytes, in rax; rt_text_from_room: with rdx bytes more to
    # grow into
    mark(a, "rt_text_from")
    movi(a, rdx, 0)
    mark(a, "rt_text_from_room")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    mov_rr(a, r12, rsi)
    mov_rr(a, r13, rcx)
    call_to(a, "rt_bytes_room")
    mov_rr(a, rbx, rax)
    mov_rr(a, rdi, rax)
    mov_rr(a, rsi, r12)
    mov_rr(a, rcx, r13)
    rep_movsb(a)
    mov_rr(a, rsi, r12)
    mov_rr(a, rcx, r13)
    call_to(a, "rt_b_chars")
    mov_rr(a, r12, rax)
    movi(a, rcx, 24)
    call_to(a, "rt_alloc")
    store(a, mem(rax, 0), r13)
    store(a, mem(rax, 8), r12)
    store(a, mem(rax, 16), rbx)
    movi64(a, rcx, tag_text)
    alu(a, "or", rax, rcx)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_copy: rcx bytes from rsi to rdi, which end up past them; short ones eight at a time, as `rep movsb`
    # takes a while to start
    set copy_big to new_label(a)
    set copy_eights to new_label(a)
    set copy_bytes to new_label(a)
    set copied to new_label(a)
    mark(a, "rt_copy")
    alui(a, "cmp", rcx, 64)
    jcc(a, cc_ae, copy_big)
    mark(a, copy_eights)
    alui(a, "cmp", rcx, 8)
    jcc(a, cc_b, copy_bytes)
    load(a, rax, mem(rsi, 0))
    store(a, mem(rdi, 0), rax)
    alui(a, "add", rsi, 8)
    alui(a, "add", rdi, 8)
    alui(a, "sub", rcx, 8)
    jmp_to(a, copy_eights)
    mark(a, copy_bytes)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, copied)
    load8(a, rax, mem(rsi, 0))
    store8(a, mem(rdi, 0), rax)
    inc_r(a, rsi)
    inc_r(a, rdi)
    dec_r(a, rcx)
    jmp_to(a, copy_bytes)
    mark(a, copy_big)
    rep_movsb(a)
    mark(a, copied)
    ret(a)

    mark(a, "rt_b_text") # the builder's bytes as a new text, in rax
    load(a, rsi, rip("b_ptr"))
    load(a, rcx, rip("b_len"))
    jmp_to(a, "rt_text_from")

    mark(a, "rt_say_end") # what the builder holds, as a line of output; rax is 0, or 3 if it's too long
    set line_fits to new_label(a)
    call_to(a, "rt_b_fits")
    test_rr(a, rax, rax)
    jcc(a, cc_e, line_fits)
    ret(a)
    mark(a, line_fits)
    load(a, rsi, rip("b_ptr"))
    load(a, rcx, rip("b_len"))
    call_to(a, "rt_out_text")
    call_to(a, "rt_out_line")
    movi(a, rax, 0)
    ret(a)

    # rt_say_error_end: the same, as a line of the error output, which goes out at once, after what the output
    # has waiting, so the two come in the order they were said
    set error_line_fits to new_label(a)
    mark(a, "rt_say_error_end")
    call_to(a, "rt_b_fits")
    test_rr(a, rax, rax)
    jcc(a, cc_e, error_line_fits)
    ret(a)
    mark(a, error_line_fits)
    movi(a, rax, 10)
    call_to(a, "rt_b_byte")
    call_to(a, "rt_flush_out")
    movi(a, rdi, 2)
    load(a, rsi, rip("b_ptr"))
    load(a, rdx, rip("b_len"))
    call_to(a, "rt_write")
    movi(a, rax, 0)
    ret(a)

    # rt_join: xmm2 and xmm1 shown and joined, as `+` joins text, into xmm0, with rax 0, or 3 if that's longer
    # than JavaScript's longest text. When the first is text whose bytes end where its block's used bytes
    # do, and there's room, the second goes straight after them, and the new text shares them; a long text
    # made anew gets half as much room again, so text that keeps growing is copied a few times, not each
    # time.
    set general to new_label(a)
    set redo to new_label(a)
    set fits_after to new_label(a)
    set too_long to new_label(a)
    set short_join to new_label(a)
    # rt_join, two texts, or text and a whole number below 10^15, whose digits are written out as a text of
    # their own in jn_head and jn_buf, and not so long together that they could be past JavaScript's
    # longest: the second's bytes after the first's, in the first's block if it ends it and has room, else in
    # a new one with room to grow, as below; the characters, the two counts added up
    set by_builder to new_label(a)
    set not_joined to new_label(a)
    set new_room to new_label(a)
    set small_room to new_label(a)
    set made_bytes to new_label(a)
    set first_text to new_label(a)
    set second_text to new_label(a)
    set sides_known to new_label(a)
    mark(a, "rt_join")
    for each r in list of rbx, r12, r13, rsi, rdi
        push_r(a, r)
    end
    movq_rx(a, rbx, xmm2) # the first and the second, which the collector sees in these registers
    mov_rr(a, rdx, rbx)
    shifti(a, "shr", rdx, 48)
    alui(a, "cmp", rdx, kind_text)
    jcc(a, cc_e, first_text)
    small_digits(a, xmm2, not_joined) # a number first: the second must be text
    lea(a, rbx, rip("jn_head"))
    movq_rx(a, r12, xmm1)
    mov_rr(a, rdx, r12)
    shifti(a, "shr", rdx, 48)
    alui(a, "cmp", rdx, kind_text)
    jcc(a, cc_ne, not_joined)
    untag(a, r12)
    jmp_to(a, sides_known)
    mark(a, first_text)
    untag(a, rbx)
    movq_rx(a, r12, xmm1)
    mov_rr(a, rdx, r12)
    shifti(a, "shr", rdx, 48)
    alui(a, "cmp", rdx, kind_text)
    jcc(a, cc_e, second_text)
    small_digits(a, xmm1, not_joined)
    lea(a, r12, rip("jn_head"))
    jmp_to(a, sides_known)
    mark(a, second_text)
    untag(a, r12)
    mark(a, sides_known)
    load(a, rcx, mem(rbx, 0))
    alu_load(a, "add", rcx, mem(r12, 0))
    alui(a, "cmp", rcx, max_text)
    jcc(a, cc_a, not_joined)
    mov_rr(a, rax, rbx)
    call_to(a, "rt_tail_block")
    test_rr(a, rax, rax)
    jcc(a, cc_e, new_room)
    load(a, rcx, mem(rax, 0))
    alu_load(a, "add", rcx, mem(r12, 0))
    alu_load(a, "cmp", rcx, mem(rax, 8))
    jcc(a, cc_a, new_room)
    load(a, rdi, mem(rax, 0)) # in place: after the first's bytes, which are the block's last
    store(a, mem(rax, 0), rcx)
    alu(a, "add", rdi, rax)
    alui(a, "add", rdi, 16)
    load(a, rsi, mem(r12, 16))
    load(a, rcx, mem(r12, 0))
    call_to(a, "rt_copy")
    load(a, r13, mem(rbx, 16))
    jmp_to(a, made_bytes)
    mark(a, new_room)
    load(a, rcx, mem(rbx, 0))
    alu_load(a, "add", rcx, mem(r12, 0))
    movi(a, rdx, 0)
    alui(a, "cmp", rcx, 256)
    jcc(a, cc_b, small_room)
    mov_rr(a, rdx, rcx)
    shifti(a, "shr", rdx, 1)
    mark(a, small_room)
    call_to(a, "rt_bytes_room")
    mov_rr(a, r13, rax)
    mov_rr(a, rdi, rax)
    load(a, rsi, mem(rbx, 16))
    load(a, rcx, mem(rbx, 0))
    call_to(a, "rt_copy")
    load(a, rsi, mem(r12, 16))
    load(a, rcx, mem(r12, 0))
    call_to(a, "rt_copy")
    mark(a, made_bytes)
    movi(a, rcx, 24)
    call_to(a, "rt_alloc")
    load(a, rcx, mem(rbx, 0))
    alu_load(a, "add", rcx, mem(r12, 0))
    store(a, mem(rax, 0), rcx)
    load(a, rcx, mem(rbx, 8))
    alu_load(a, "add", rcx, mem(r12, 8))
    store(a, mem(rax, 8), rcx)
    store(a, mem(rax, 16), r13)
    movi64(a, rcx, tag_text)
    alu(a, "or", rax, rcx)
    movq_xr(a, xmm0, rax)
    for each r in list of rdi, rsi, r13, r12, rbx
        pop_r(a, r)
    end
    movi(a, rax, 0)
    ret(a)
    mark(a, not_joined)
    for each r in list of rdi, rsi, r13, r12, rbx
        pop_r(a, r)
    end
    mark(a, by_builder)
    movsd_store(a, rip("j_a"), xmm2)
    movsd_store(a, rip("j_b"), xmm1)
    call_to(a, "rt_b_reset")
    movq_rx(a, rax, xmm2)
    mov_rr(a, rdx, rax)
    shifti(a, "shr", rdx, 48)
    alui(a, "cmp", rdx, kind_text)
    jcc(a, cc_ne, general)
    untag(a, rax)
    call_to(a, "rt_tail_block")
    test_rr(a, rax, rax)
    jcc(a, cc_e, general)
    load(a, rax, rip("j_b"))
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    load(a, rax, rip("j_a")) # past the longest text?
    untag(a, rax)
    load(a, rcx, mem(rax, 0))
    alu_load(a, "add", rcx, rip("b_len"))
    alui(a, "cmp", rcx, max_text)
    jcc(a, cc_be, fits_after)
    load(a, rsi, mem(rax, 16))
    load(a, rcx, mem(rax, 0))
    call_to(a, "rt_units")
    push_r(a, rax)
    load(a, rsi, rip("b_ptr"))
    load(a, rcx, rip("b_len"))
    call_to(a, "rt_units")
    pop_r(a, rcx)
    alu(a, "add", rax, rcx)
    alui(a, "cmp", rax, max_text)
    jcc(a, cc_a, too_long)
    mark(a, fits_after)
    load(a, rax, rip("j_a"))
    untag(a, rax)
    call_to(a, "rt_tail_block")
    test_rr(a, rax, rax)
    jcc(a, cc_e, redo)
    load(a, rcx, rip("b_len"))
    load(a, rdx, mem(rax, 0))
    alu(a, "add", rdx, rcx)
    alu_load(a, "cmp", rdx, mem(rax, 8))
    jcc(a, cc_a, redo)
    load(a, rdi, mem(rax, 0))
    store(a, mem(rax, 0), rdx)
    alu(a, "add", rdi, rax)
    alui(a, "add", rdi, 16)
    load(a, rsi, rip("b_ptr"))
    rep_movsb(a)
    load(a, rsi, rip("b_ptr"))
    load(a, rcx, rip("b_len"))
    call_to(a, "rt_b_chars")
    mov_rr(a, r8, rax)
    movi(a, rcx, 24)
    call_to(a, "rt_alloc")
    load(a, rdx, rip("j_a"))
    untag(a, rdx)
    load(a, rcx, mem(rdx, 0))
    alu_load(a, "add", rcx, rip("b_len"))
    store(a, mem(rax, 0), rcx)
    load(a, rcx, mem(rdx, 8))
    alu(a, "add", rcx, r8)
    store(a, mem(rax, 8), rcx)
    load(a, rcx, mem(rdx, 16))
    store(a, mem(rax, 16), rcx)
    movi64(a, rcx, tag_text)
    alu(a, "or", rax, rcx)
    movq_xr(a, xmm0, rax)
    movi(a, rax, 0)
    ret(a)
    mark(a, redo)
    call_to(a, "rt_b_reset")
    mark(a, general)
    load(a, rax, rip("j_a"))
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    load(a, rax, rip("j_b"))
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    call_to(a, "rt_b_fits")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, too_long)
    load(a, rsi, rip("b_ptr"))
    load(a, rcx, rip("b_len"))
    movi(a, rdx, 0)
    alui(a, "cmp", rcx, 256)
    jcc(a, cc_b, short_join)
    mov_rr(a, rdx, rcx)
    shifti(a, "shr", rdx, 1)
    mark(a, short_join)
    call_to(a, "rt_text_from_room")
    movq_xr(a, xmm0, rax)
    movi(a, rax, 0)
    ret(a)
    mark(a, too_long)
    movi(a, rax, 3)
    ret(a)

    # rt_b_fits: rax is 0 if what the builder holds is no longer than JavaScript's longest text, else 3
    set fine to new_label(a)
    mark(a, "rt_b_fits")
    load(a, rcx, rip("b_len"))
    alui(a, "cmp", rcx, max_text)
    jcc(a, cc_be, fine)
    load(a, rsi, rip("b_ptr"))
    call_to(a, "rt_units")
    alui(a, "cmp", rax, max_text)
    jcc(a, cc_be, fine)
    movi(a, rax, 3)
    ret(a)
    mark(a, fine)
    movi(a, rax, 0)
    ret(a)

    # rt_units: rsi, rcx: how many UTF-16 units those UTF-8 bytes are, in rax: one for each character, and
    # one more for each past U+FFFF; uses rcx, rdx and rsi
    set unit_loop to new_label(a)
    set unit_follower to new_label(a)
    set unit_done to new_label(a)
    mark(a, "rt_units")
    movi(a, rax, 0)
    mark(a, unit_loop)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, unit_done)
    load8(a, rdx, mem(rsi, 0))
    alui(a, "cmp", rdx, 0xF0)
    jcc(a, cc_b, unit_follower)
    inc_r(a, rax)
    mark(a, unit_follower)
    alui(a, "and", rdx, 0xC0)
    alui(a, "cmp", rdx, 0x80)
    set not_lead to new_label(a)
    jcc(a, cc_e, not_lead)
    inc_r(a, rax)
    mark(a, not_lead)
    inc_r(a, rsi)
    dec_r(a, rcx)
    jmp_to(a, unit_loop)
    mark(a, unit_done)
    ret(a)

    # rt_plus: if xmm2 or xmm1 is text, they join into xmm0 and rax is 1 (or 3 if too long); else rax is 0,
    # and both are kept
    set joining to new_label(a)
    mark(a, "rt_plus")
    movq_rx(a, rax, xmm2)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_text)
    jcc(a, cc_e, joining)
    movq_rx(a, rax, xmm1)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_text)
    jcc(a, cc_e, joining)
    movi(a, rax, 0)
    ret(a)
    set joined to new_label(a)
    mark(a, joining)
    call_to(a, "rt_join")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, joined)
    movi(a, rax, 1)
    mark(a, joined)
    ret(a)

    emit_show(a)
end

# rt_b_value: rax, rdx: a value as `say` shows it goes in the builder; with rdx 1 it is inside a list, where
# text shows in quotes, as JSON writes it. A list inside itself shows as [...]. rbx and r12 to r15 are kept.
to emit_show with a
    set odd to new_label(a)
    set done to new_label(a)
    set said_nothing to new_label(a)
    set said_no to new_label(a)
    set said_yes to new_label(a)
    set said_text to new_label(a)
    set said_list to new_label(a)
    set quoted to new_label(a)
    set each_byte to new_label(a)
    set closing to new_label(a)
    set plain_byte to new_label(a)
    set unicode to new_label(a)
    set look to new_label(a)
    set fresh to new_label(a)
    set inside to new_label(a)
    set items_loop to new_label(a)
    set no_comma to new_label(a)
    set items_done to new_label(a)
    set shown_in to new_label(a)
    set said_record to new_label(a)
    set said_dict to new_label(a)
    mark(a, "rt_b_value")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    mov_rr(a, rbx, rax)
    mov_rr(a, r12, rdx)
    movq_xr(a, xmm0, rax)
    odd_jump(a, xmm0, odd)
    movi(a, rcx, 32) # a number
    call_to(a, "rt_b_room")
    load(a, rdi, rip("b_ptr"))
    alu_load(a, "add", rdi, rip("b_len"))
    mov_rr(a, rax, rbx)
    call_to(a, "rt_fmt")
    alu_load(a, "sub", rdi, rip("b_ptr"))
    store(a, rip("b_len"), rdi)
    jmp_to(a, done)
    mark(a, odd)
    movi64(a, rcx, bits_nothing)
    alu(a, "cmp", rbx, rcx)
    jcc(a, cc_e, said_nothing)
    inc_r(a, rcx)
    alu(a, "cmp", rbx, rcx)
    jcc(a, cc_e, said_no)
    inc_r(a, rcx)
    alu(a, "cmp", rbx, rcx)
    jcc(a, cc_e, said_yes)
    mov_rr(a, r13, rbx)
    untag(a, r13)
    mov_rr(a, rax, rbx)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_text)
    jcc(a, cc_e, said_text)
    alui(a, "cmp", rax, kind_list)
    jcc(a, cc_e, said_list)
    alui(a, "cmp", rax, kind_record)
    jcc(a, cc_e, said_list)
    alui(a, "cmp", rax, kind_dict)
    jcc(a, cc_e, said_list)
    alui(a, "cmp", rax, kind_bytes)
    set said_bytes to new_label(a)
    jcc(a, cc_e, said_bytes)
    alui(a, "cmp", rax, kind_function)
    set said_function to new_label(a)
    jcc(a, cc_e, said_function)
    if units of a # an amount: `5.3 km`
        set not_amount to new_label(a)
        alui(a, "cmp", rax, kind_quantity)
        jcc(a, cc_ne, not_amount)
        mov_rr(a, rax, r13)
        call_to(a, "rt_q_show")
        jmp_to(a, done)
        mark(a, not_amount)
    end
    b_text(a, "<internal>")
    jmp_to(a, done)
    mark(a, said_function)
    b_text(a, "<function ")
    load(a, rax, mem(r13, 16))
    load(a, rax, mem(rax, 8))
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    call_to(a, "rt_b_bytes")
    movi(a, rax, 62)
    call_to(a, "rt_b_byte")
    jmp_to(a, done)
    mark(a, said_bytes)
    movi(a, rax, 40)
    call_to(a, "rt_b_byte")
    load(a, rax, mem(r13, 0))
    call_to(a, "rt_e_plain")
    b_text(a, " byte")
    load(a, rax, mem(r13, 0))
    alui(a, "cmp", rax, 1)
    set one_byte to new_label(a)
    jcc(a, cc_e, one_byte)
    movi(a, rax, 115)
    call_to(a, "rt_b_byte")
    mark(a, one_byte)
    load(a, rax, mem(r13, 0))
    test_rr(a, rax, rax)
    set bytes_close to new_label(a)
    jcc(a, cc_e, bytes_close)
    b_text(a, ": ")
    movi(a, r14, 0)
    set bytes_loop to new_label(a)
    set no_sep to new_label(a)
    mark(a, bytes_loop)
    alu_load(a, "cmp", r14, mem(r13, 0))
    jcc(a, cc_ae, bytes_close)
    test_rr(a, r14, r14)
    jcc(a, cc_e, no_sep)
    b_text(a, ", ")
    mark(a, no_sep)
    load(a, rax, mem(r13, 8))
    alu(a, "add", rax, r14)
    load8(a, rax, mem(rax, 0))
    call_to(a, "rt_e_plain")
    inc_r(a, r14)
    jmp_to(a, bytes_loop)
    mark(a, bytes_close)
    movi(a, rax, 41)
    call_to(a, "rt_b_byte")
    jmp_to(a, done)
    mark(a, said_nothing)
    b_text(a, "nothing")
    jmp_to(a, done)
    mark(a, said_no)
    b_text(a, "no")
    jmp_to(a, done)
    mark(a, said_yes)
    b_text(a, "yes")
    jmp_to(a, done)
    mark(a, said_text)
    test_rr(a, r12, r12)
    jcc(a, cc_ne, quoted)
    load(a, rcx, mem(r13, 0))
    load(a, rsi, mem(r13, 16))
    call_to(a, "rt_b_bytes")
    jmp_to(a, done)
    mark(a, quoted)
    movi(a, rax, 34)
    call_to(a, "rt_b_byte")
    movi(a, r14, 0)
    mark(a, each_byte)
    alu_load(a, "cmp", r14, mem(r13, 0))
    jcc(a, cc_ae, closing)
    load(a, rax, mem(r13, 16))
    alu(a, "add", rax, r14)
    load8(a, rax, mem(rax, 0))
    inc_r(a, r14)
    for each escape in list of (list of 34, "\\\""), (list of 92, "\\\\"), (list of 8, "\\b"), (list of 12, "\\f"),
        (list of 10, "\\n"), (list of 13, "\\r"), (list of 9, "\\t")
        set other to new_label(a)
        alui(a, "cmp", rax, item 1 of escape)
        jcc(a, cc_ne, other)
        b_text(a, item 2 of escape)
        jmp_to(a, each_byte)
        mark(a, other)
    end
    alui(a, "cmp", rax, 32)
    jcc(a, cc_b, unicode)
    mark(a, plain_byte)
    call_to(a, "rt_b_byte")
    jmp_to(a, each_byte)
    mark(a, unicode) # another control character: \u and four hex digits
    push_r(a, rax)
    b_text(a, "\\u00")
    pop_r(a, rax)
    push_r(a, rax)
    shifti(a, "shr", rax, 4)
    hex_digit(a)
    pop_r(a, rax)
    alui(a, "and", rax, 15)
    hex_digit(a)
    jmp_to(a, each_byte)
    mark(a, closing)
    movi(a, rax, 34)
    call_to(a, "rt_b_byte")
    jmp_to(a, done)
    mark(a, said_list)
    load(a, rax, rip("showing")) # already being shown, further out?
    mark(a, look)
    test_rr(a, rax, rax)
    jcc(a, cc_e, fresh)
    alu_load(a, "cmp", r13, mem(rax, 8))
    jcc(a, cc_e, inside)
    load(a, rax, mem(rax, 0))
    jmp_to(a, look)
    mark(a, inside)
    mov_rr(a, rax, rbx)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_list)
    set paren to new_label(a)
    jcc(a, cc_ne, paren)
    b_text(a, "[...]")
    jmp_to(a, done)
    mark(a, paren)
    b_text(a, "(...)")
    jmp_to(a, done)
    mark(a, fresh)
    push_r(a, r13)
    load(a, rax, rip("showing"))
    push_r(a, rax)
    store(a, rip("showing"), rsp)
    mov_rr(a, rax, rbx)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_record)
    jcc(a, cc_e, said_record)
    alui(a, "cmp", rax, kind_dict)
    jcc(a, cc_e, said_dict)
    movi(a, rax, 91)
    call_to(a, "rt_b_byte")
    movi(a, r14, 0)
    mark(a, items_loop)
    alu_load(a, "cmp", r14, mem(r13, 0))
    jcc(a, cc_ae, items_done)
    test_rr(a, r14, r14)
    jcc(a, cc_e, no_comma)
    b_text(a, ", ")
    mark(a, no_comma)
    load(a, rax, mem(r13, 16))
    mov_rr(a, rcx, r14)
    shifti(a, "shl", rcx, 3)
    alu(a, "add", rax, rcx)
    load(a, rax, mem(rax, 0))
    movi(a, rdx, 1)
    call_to(a, "rt_b_value")
    inc_r(a, r14)
    jmp_to(a, items_loop)
    mark(a, items_done)
    movi(a, rax, 93)
    call_to(a, "rt_b_byte")
    mark(a, shown_in)
    pop_r(a, rax)
    store(a, rip("showing"), rax)
    pop_r(a, rax)
    jmp_to(a, done)
    mark(a, said_record) # (record with name "Sam", age 20)
    load(a, rax, mem(r13, 0))
    test_rr(a, rax, rax)
    set some_fields to new_label(a)
    jcc(a, cc_ne, some_fields)
    b_text(a, "(empty record)")
    jmp_to(a, shown_in)
    mark(a, some_fields)
    b_text(a, "(record with ")
    movi(a, r14, 0)
    set fields_loop to new_label(a)
    set fields_done to new_label(a)
    set field_comma to new_label(a)
    mark(a, fields_loop)
    alu_load(a, "cmp", r14, mem(r13, 0))
    jcc(a, cc_ae, fields_done)
    test_rr(a, r14, r14)
    jcc(a, cc_e, field_comma)
    b_text(a, ", ")
    mark(a, field_comma)
    mov_rr(a, rax, r14)
    shifti(a, "shl", rax, 4)
    alu_load(a, "add", rax, mem(r13, 16))
    push_r(a, rax)
    load(a, rax, mem(rax, 0))
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    call_to(a, "rt_b_bytes")
    movi(a, rax, 32)
    call_to(a, "rt_b_byte")
    pop_r(a, rax)
    load(a, rax, mem(rax, 8))
    movi(a, rdx, 1)
    call_to(a, "rt_b_value")
    inc_r(a, r14)
    jmp_to(a, fields_loop)
    mark(a, fields_done)
    movi(a, rax, 41)
    call_to(a, "rt_b_byte")
    jmp_to(a, shown_in)
    mark(a, said_dict) # (dictionary where "Sam" is 20)
    load(a, rax, mem(r13, 0))
    test_rr(a, rax, rax)
    set some_keys to new_label(a)
    jcc(a, cc_ne, some_keys)
    b_text(a, "(empty dictionary)")
    jmp_to(a, shown_in)
    mark(a, some_keys)
    b_text(a, "(dictionary where ")
    movi(a, r14, 0)
    movi(a, r12, 0) # how many shown so far
    set entries_loop to new_label(a)
    set entries_done to new_label(a)
    set entry_comma to new_label(a)
    mark(a, entries_loop)
    alu_load(a, "cmp", r14, mem(r13, 8))
    jcc(a, cc_ae, entries_done)
    mov_rr(a, rax, r14)
    imul_ri(a, rax, rax, 24)
    alu_load(a, "add", rax, mem(r13, 24))
    inc_r(a, r14)
    movi64(a, rcx, bits_unset)
    alu_load(a, "cmp", rcx, mem(rax, 0))
    jcc(a, cc_e, entries_loop)
    test_rr(a, r12, r12)
    jcc(a, cc_e, entry_comma)
    push_r(a, rax)
    b_text(a, ", ")
    pop_r(a, rax)
    mark(a, entry_comma)
    inc_r(a, r12)
    push_r(a, rax)
    load(a, rax, mem(rax, 0))
    movi(a, rdx, 1)
    call_to(a, "rt_b_value")
    b_text(a, " is ")
    pop_r(a, rax)
    load(a, rax, mem(rax, 8))
    movi(a, rdx, 1)
    call_to(a, "rt_b_value")
    jmp_to(a, entries_loop)
    mark(a, entries_done)
    movi(a, rax, 41)
    call_to(a, "rt_b_byte")
    jmp_to(a, shown_in)
    mark(a, done)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
end

# the hex digit for the number in rax goes in the builder
to hex_digit with a
    set letter to new_label(a)
    set put to new_label(a)
    alui(a, "cmp", rax, 10)
    jcc(a, cc_ae, letter)
    alui(a, "add", rax, 48)
    jmp_to(a, put)
    mark(a, letter)
    alui(a, "add", rax, 87)
    mark(a, put)
    call_to(a, "rt_b_byte")
end

to b_text with a, t
    point_at_text(a, t)
    call_to(a, "rt_b_bytes")
end

# ---------- the runtime: text and lists ----------
# A text is 24 bytes: how many bytes, how many characters, and where its UTF-8 bytes are, which may be
# shared with a longer text. A list is 24 bytes too: how many items, room for how many, and where they are.

to emit_sequences with a
    # rt_decode: rsi: the character starting there, as a number, in rax; uses rcx and rdx
    set decoded to new_label(a)
    set three to new_label(a)
    set four to new_label(a)
    set tail to new_label(a)
    set tail_loop to new_label(a)
    mark(a, "rt_decode")
    load8(a, rax, mem(rsi, 0))
    alui(a, "cmp", rax, 0x80)
    jcc(a, cc_b, decoded)
    alui(a, "cmp", rax, 0xE0)
    jcc(a, cc_ae, three)
    alui(a, "and", rax, 31)
    movi(a, rcx, 1)
    jmp_to(a, tail)
    mark(a, three)
    alui(a, "cmp", rax, 0xF0)
    jcc(a, cc_ae, four)
    alui(a, "and", rax, 15)
    movi(a, rcx, 2)
    jmp_to(a, tail)
    mark(a, four)
    alui(a, "and", rax, 7)
    movi(a, rcx, 3)
    mark(a, tail)
    push_r(a, rsi)
    mark(a, tail_loop)
    inc_r(a, rsi)
    shifti(a, "shl", rax, 6)
    load8(a, rdx, mem(rsi, 0))
    alui(a, "and", rdx, 63)
    alu(a, "or", rax, rdx)
    dec_r(a, rcx)
    jcc(a, cc_ne, tail_loop)
    pop_r(a, rsi)
    mark(a, decoded)
    ret(a)

    # rt_text_order: rax, rdx, two texts: rax is -1, 0 or 1 as the first comes before, with or after the
    # second, comparing them as JavaScript does, by their UTF-16
    set scan to new_label(a)
    set prefix to new_label(a)
    set diff to new_label(a)
    set decode to new_label(a)
    set before to new_label(a)
    set after to new_label(a)
    set ordered to new_label(a)
    set shorter to new_label(a)
    mark(a, "rt_text_order")
    push_r(a, rbx)
    push_r(a, r12)
    mov_rr(a, r8, rax)
    untag(a, r8)
    mov_rr(a, r9, rdx)
    untag(a, r9)
    load(a, rsi, mem(r8, 16))
    load(a, rdi, mem(r9, 16))
    load(a, rcx, mem(r8, 0))
    alu_load(a, "cmp", rcx, mem(r9, 0))
    jcc(a, cc_be, shorter)
    load(a, rcx, mem(r9, 0))
    mark(a, shorter)
    movi(a, r10, 0)
    mark(a, scan)
    alu(a, "cmp", r10, rcx)
    jcc(a, cc_ae, prefix)
    mov_rr(a, rax, rsi)
    alu(a, "add", rax, r10)
    load8(a, rax, mem(rax, 0))
    mov_rr(a, rdx, rdi)
    alu(a, "add", rdx, r10)
    load8(a, rdx, mem(rdx, 0))
    alu(a, "cmp", rax, rdx)
    jcc(a, cc_ne, diff)
    inc_r(a, r10)
    jmp_to(a, scan)
    mark(a, prefix)
    load(a, rax, mem(r8, 0))
    alu_load(a, "cmp", rax, mem(r9, 0))
    jcc(a, cc_b, before)
    jcc(a, cc_a, after)
    movi(a, rax, 0)
    jmp_to(a, ordered)
    mark(a, diff) # back to where that character starts
    test_rr(a, r10, r10)
    jcc(a, cc_e, decode)
    mov_rr(a, rax, rsi)
    alu(a, "add", rax, r10)
    load8(a, rax, mem(rax, 0))
    alui(a, "and", rax, 0xC0)
    alui(a, "cmp", rax, 0x80)
    jcc(a, cc_ne, decode)
    dec_r(a, r10)
    jmp_to(a, diff)
    mark(a, decode)
    push_r(a, rsi)
    alu(a, "add", rsi, r10)
    call_to(a, "rt_decode")
    mov_rr(a, rbx, rax)
    pop_r(a, rsi)
    push_r(a, rsi)
    mov_rr(a, rsi, rdi)
    alu(a, "add", rsi, r10)
    call_to(a, "rt_decode")
    mov_rr(a, r12, rax)
    pop_r(a, rsi)
    utf16_key(a, rbx)
    utf16_key(a, r12)
    alu(a, "cmp", rbx, r12)
    jcc(a, cc_b, before)
    mark(a, after)
    movi(a, rax, 1)
    jmp_to(a, ordered)
    mark(a, before)
    movi(a, rax, -1)
    mark(a, ordered)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_equal: rax, rdx: rax is 1 if the two values are the same, as `is` has it, else 0. A list is the same
    # as another with the same items; one that holds itself counts as the same where it comes round again.
    set a_odd to new_label(a)
    set both to new_label(a)
    set texts to new_label(a)
    set lists to new_label(a)
    set look to new_label(a)
    set next_pair to new_label(a)
    set fresh to new_label(a)
    set each to new_label(a)
    set all_same to new_label(a)
    set differ to new_label(a)
    set unwind to new_label(a)
    set records to new_label(a)
    set dicts to new_label(a)
    set same to new_label(a)
    set different to new_label(a)
    set out to new_label(a)
    mark(a, "rt_equal")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    mov_rr(a, rbx, rax)
    mov_rr(a, r12, rdx)
    movq_xr(a, xmm0, rbx)
    movq_xr(a, xmm1, r12)
    odd_jump(a, xmm0, a_odd)
    odd_jump(a, xmm1, different)
    call_to(a, "rt_order")
    test_rr(a, rax, rax)
    setcc(a, cc_e, rax)
    movzx8(a, rax, rax)
    jmp_to(a, out)
    mark(a, a_odd)
    odd_jump(a, xmm1, both)
    jmp_to(a, different)
    mark(a, both)
    alu(a, "cmp", rbx, r12)
    jcc(a, cc_e, same)
    mov_rr(a, rax, rbx)
    shifti(a, "shr", rax, 48)
    mov_rr(a, rdx, r12)
    shifti(a, "shr", rdx, 48)
    alu(a, "cmp", rax, rdx)
    jcc(a, cc_ne, different)
    alui(a, "cmp", rax, kind_text)
    jcc(a, cc_e, texts)
    alui(a, "cmp", rax, kind_list)
    jcc(a, cc_e, lists)
    alui(a, "cmp", rax, kind_record)
    jcc(a, cc_e, lists)
    alui(a, "cmp", rax, kind_dict)
    jcc(a, cc_e, lists)
    alui(a, "cmp", rax, kind_bytes)
    set byte_arrays to new_label(a)
    jcc(a, cc_e, byte_arrays)
    if units of a # two amounts: of one measure, and the same amount in the first's unit to 15 digits
        set not_amounts to new_label(a)
        alui(a, "cmp", rax, kind_quantity)
        jcc(a, cc_ne, not_amounts)
        movq_xr(a, xmm0, rbx)
        movq_xr(a, xmm1, r12)
        call_to(a, "rt_q_pair")
        test_rr(a, rax, rax)
        jcc(a, cc_ne, different)
        call_to(a, "rt_order")
        test_rr(a, rax, rax)
        setcc(a, cc_e, rax)
        movzx8(a, rax, rax)
        jmp_to(a, out)
        mark(a, not_amounts)
    end
    jmp_to(a, different)
    mark(a, byte_arrays)
    untag(a, rbx)
    untag(a, r12)
    load(a, rcx, mem(rbx, 0))
    alu_load(a, "cmp", rcx, mem(r12, 0))
    jcc(a, cc_ne, different)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, same)
    load(a, rsi, mem(rbx, 8))
    load(a, rdi, mem(r12, 8))
    raw(a, list of 0xF3, 0xA6)
    jcc(a, cc_ne, different)
    jmp_to(a, same)
    mark(a, texts)
    untag(a, rbx)
    untag(a, r12)
    load(a, rcx, mem(rbx, 0))
    alu_load(a, "cmp", rcx, mem(r12, 0))
    jcc(a, cc_ne, different)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, same)
    load(a, rsi, mem(rbx, 16))
    load(a, rdi, mem(r12, 16))
    raw(a, list of 0xF3, 0xA6) # repe cmpsb
    jcc(a, cc_ne, different)
    jmp_to(a, same)
    mark(a, lists)
    mov_rr(a, r13, rbx)
    untag(a, r13)
    mov_rr(a, r14, r12)
    untag(a, r14)
    load(a, rax, rip("comparing"))
    mark(a, look)
    test_rr(a, rax, rax)
    jcc(a, cc_e, fresh)
    alu_load(a, "cmp", r13, mem(rax, 8))
    jcc(a, cc_ne, next_pair)
    alu_load(a, "cmp", r14, mem(rax, 16))
    jcc(a, cc_e, same)
    mark(a, next_pair)
    load(a, rax, mem(rax, 0))
    jmp_to(a, look)
    mark(a, fresh)
    load(a, rax, mem(r13, 0))
    alu_load(a, "cmp", rax, mem(r14, 0))
    jcc(a, cc_ne, different)
    push_r(a, r14)
    push_r(a, r13)
    load(a, rax, rip("comparing"))
    push_r(a, rax)
    store(a, rip("comparing"), rsp)
    movi(a, rbx, 0)
    mov_rr(a, rax, r12)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_record)
    jcc(a, cc_e, records)
    alui(a, "cmp", rax, kind_dict)
    jcc(a, cc_e, dicts)
    mark(a, each)
    alu_load(a, "cmp", rbx, mem(r13, 0))
    jcc(a, cc_ae, all_same)
    mov_rr(a, rcx, rbx)
    shifti(a, "shl", rcx, 3)
    load(a, rax, mem(r13, 16))
    alu(a, "add", rax, rcx)
    load(a, rax, mem(rax, 0))
    load(a, rdx, mem(r14, 16))
    alu(a, "add", rdx, rcx)
    load(a, rdx, mem(rdx, 0))
    call_to(a, "rt_equal")
    test_rr(a, rax, rax)
    jcc(a, cc_e, differ)
    inc_r(a, rbx)
    jmp_to(a, each)
    mark(a, records) # each field of one is in the other, with the same value
    alu_load(a, "cmp", rbx, mem(r13, 0))
    jcc(a, cc_ae, all_same)
    mov_rr(a, rcx, rbx)
    shifti(a, "shl", rcx, 4)
    alu_load(a, "add", rcx, mem(r13, 16))
    push_r(a, rcx)
    load(a, rdx, mem(rcx, 0))
    mov_rr(a, rax, r14)
    call_to(a, "rt_record_find")
    pop_r(a, rcx)
    test_rr(a, rax, rax)
    jcc(a, cc_e, differ)
    load(a, rdx, mem(rax, 8))
    load(a, rax, mem(rcx, 8))
    call_to(a, "rt_equal")
    test_rr(a, rax, rax)
    jcc(a, cc_e, differ)
    inc_r(a, rbx)
    jmp_to(a, records)
    mark(a, dicts) # each key of one is in the other, with the same value
    alu_load(a, "cmp", rbx, mem(r13, 8))
    jcc(a, cc_ae, all_same)
    mov_rr(a, rcx, rbx)
    imul_ri(a, rcx, rcx, 24)
    alu_load(a, "add", rcx, mem(r13, 24))
    inc_r(a, rbx)
    movi64(a, rax, bits_unset)
    alu_load(a, "cmp", rax, mem(rcx, 0))
    jcc(a, cc_e, dicts)
    push_r(a, rcx)
    load(a, rdx, mem(rcx, 0))
    load(a, r8, mem(rcx, 16))
    mov_rr(a, rax, r14)
    call_to(a, "rt_dict_find")
    pop_r(a, rcx)
    test_rr(a, rax, rax)
    jcc(a, cc_e, differ)
    load(a, rdx, mem(rax, 8))
    load(a, rax, mem(rcx, 8))
    call_to(a, "rt_equal")
    test_rr(a, rax, rax)
    jcc(a, cc_e, differ)
    jmp_to(a, dicts)
    mark(a, all_same)
    movi(a, r12, 1)
    jmp_to(a, unwind)
    mark(a, differ)
    movi(a, r12, 0)
    mark(a, unwind)
    pop_r(a, rax)
    store(a, rip("comparing"), rax)
    pop_r(a, rax)
    pop_r(a, rax)
    mov_rr(a, rax, r12)
    jmp_to(a, out)
    mark(a, same)
    movi(a, rax, 1)
    jmp_to(a, out)
    mark(a, different)
    movi(a, rax, 0)
    mark(a, out)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_contains: rax, rdx, two texts: rax is 1 if the second has the first in it
    set yes_found to new_label(a)
    set not_found to new_label(a)
    set start_at to new_label(a)
    mark(a, "rt_contains")
    mov_rr(a, r8, rax)
    untag(a, r8)
    mov_rr(a, r9, rdx)
    untag(a, r9)
    load(a, rcx, mem(r8, 0))
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, yes_found)
    load(a, r10, mem(r9, 0))
    alu(a, "cmp", r10, rcx)
    jcc(a, cc_b, not_found)
    alu(a, "sub", r10, rcx)
    movi(a, r11, 0)
    mark(a, start_at)
    alu(a, "cmp", r11, r10)
    jcc(a, cc_a, not_found)
    load(a, rsi, mem(r9, 16))
    alu(a, "add", rsi, r11)
    load(a, rdi, mem(r8, 16))
    load(a, rcx, mem(r8, 0))
    raw(a, list of 0xF3, 0xA6)
    jcc(a, cc_e, yes_found)
    inc_r(a, r11)
    jmp_to(a, start_at)
    mark(a, yes_found)
    movi(a, rax, 1)
    ret(a)
    mark(a, not_found)
    movi(a, rax, 0)
    ret(a)

    # rt_cmp_in: xmm0 is in xmm1: an item of a list, or text in text
    set in_list to new_label(a)
    set in_text to new_label(a)
    set wrong to new_label(a)
    set looking to new_label(a)
    set found to new_label(a)
    set missing to new_label(a)
    set list_out to new_label(a)
    mark(a, "rt_cmp_in")
    movq_rx(a, rax, xmm1)
    mov_rr(a, rdx, rax)
    shifti(a, "shr", rdx, 48)
    alui(a, "cmp", rdx, kind_list)
    jcc(a, cc_e, in_list)
    alui(a, "cmp", rdx, kind_text)
    jcc(a, cc_e, in_text)
    alui(a, "cmp", rdx, kind_dict)
    set in_dict to new_label(a)
    jcc(a, cc_e, in_dict)
    alui(a, "cmp", rdx, kind_bytes)
    set in_bytes to new_label(a)
    jcc(a, cc_e, in_bytes)
    jmp_to(a, wrong)
    set not_byte to new_label(a)
    set byte_seek to new_label(a)
    mark(a, in_bytes) # a number that, to 15 digits, is one of the bytes
    odd_jump(a, xmm0, not_byte)
    movsd_store(a, rip("keep"), xmm1)
    movq_rx(a, rax, xmm0)
    movsd_store(a, rip("keep2"), xmm0)
    finite_jump(a, xmm0, not_byte)
    set whole_byte to new_label(a)
    is_whole(a, xmm0, whole_byte)
    movq_rx(a, rax, xmm0)
    bit_op(a, "btr", rax, 63)
    movq_xr(a, xmm0, rax)
    call_to(a, "rt_canon_int")
    test_rr(a, rax, rax)
    jcc(a, cc_e, not_byte)
    load(a, rax, rip("keep2"))
    test_rr(a, rax, rax)
    jcc(a, cc_s, not_byte)
    jmp_to(a, byte_seek)
    mark(a, whole_byte)
    movsd_load(a, xmm0, rip("keep2"))
    ucomisd(a, xmm0, rip(number_place(a, double_bytes(0))))
    jcc(a, cc_b, not_byte)
    ucomisd(a, xmm0, rip(number_place(a, double_bytes(255))))
    jcc(a, cc_a, not_byte)
    cvttsd2si(a, rcx, xmm0)
    mark(a, byte_seek)
    load(a, rax, rip("keep"))
    untag(a, rax)
    load(a, rsi, mem(rax, 8))
    load(a, rdx, mem(rax, 0))
    set seek_loop to new_label(a)
    mark(a, seek_loop)
    test_rr(a, rdx, rdx)
    jcc(a, cc_e, not_byte)
    load8(a, rax, mem(rsi, 0))
    alu(a, "cmp", rax, rcx)
    set byte_found to new_label(a)
    jcc(a, cc_e, byte_found)
    inc_r(a, rsi)
    dec_r(a, rdx)
    jmp_to(a, seek_loop)
    mark(a, byte_found)
    movi(a, rax, 1)
    ret(a)
    mark(a, not_byte)
    movi(a, rax, 0)
    ret(a)
    set no_key to new_label(a)
    mark(a, in_dict) # a key of it, if it can be one
    movsd_store(a, rip("keep"), xmm1)
    movq_rx(a, rax, xmm0)
    call_to(a, "rt_key")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, no_key)
    load(a, rax, rip("keep"))
    untag(a, rax)
    call_to(a, "rt_dict_find")
    test_rr(a, rax, rax)
    setcc(a, cc_ne, rax)
    movzx8(a, rax, rax)
    ret(a)
    mark(a, no_key)
    movi(a, rax, 0)
    ret(a)
    mark(a, in_list)
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    movq_rx(a, r12, xmm0)
    mov_rr(a, r13, rax)
    untag(a, r13)
    movi(a, rbx, 0)
    mark(a, looking)
    alu_load(a, "cmp", rbx, mem(r13, 0))
    jcc(a, cc_ae, missing)
    load(a, rdx, mem(r13, 16))
    mov_rr(a, rcx, rbx)
    shifti(a, "shl", rcx, 3)
    alu(a, "add", rdx, rcx)
    load(a, rdx, mem(rdx, 0))
    mov_rr(a, rax, r12)
    call_to(a, "rt_equal")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, found)
    inc_r(a, rbx)
    jmp_to(a, looking)
    mark(a, found)
    movi(a, rax, 1)
    jmp_to(a, list_out)
    mark(a, missing)
    movi(a, rax, 0)
    mark(a, list_out)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
    mark(a, in_text)
    movq_rx(a, rax, xmm0)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_text)
    jcc(a, cc_ne, wrong)
    movq_rx(a, rax, xmm0)
    movq_rx(a, rdx, xmm1)
    jmp_to(a, "rt_contains")
    mark(a, wrong)
    cmp_mistake(a, 0)

    # rt_length: xmm0: how many characters a text has, or items a list, into xmm0; rax is 0, or 2 for a
    # mistake, with the value in err_a
    set of_text to new_label(a)
    set of_list to new_label(a)
    set counted to new_label(a)
    mark(a, "rt_length")
    movsd_store(a, rip("err_a"), xmm0)
    movq_rx(a, rax, xmm0)
    mov_rr(a, rdx, rax)
    shifti(a, "shr", rdx, 48)
    untag(a, rax)
    alui(a, "cmp", rdx, kind_text)
    jcc(a, cc_e, of_text)
    alui(a, "cmp", rdx, kind_list)
    jcc(a, cc_e, of_list)
    alui(a, "cmp", rdx, kind_dict)
    jcc(a, cc_e, of_list) # a dictionary's count of keys is where a list's count of items is
    alui(a, "cmp", rdx, kind_bytes)
    jcc(a, cc_e, of_list) # and so is bytes' count of bytes
    movi(a, rax, 2)
    ret(a)
    mark(a, of_text)
    load(a, rax, mem(rax, 8))
    jmp_to(a, counted)
    mark(a, of_list)
    load(a, rax, mem(rax, 0))
    mark(a, counted)
    cvtsi2sd(a, xmm0, rax)
    movi(a, rax, 0)
    ret(a)

    # rt_index: xmm1, an item's number, which must be whole to 15 digits: rax 0, with the whole number in rcx
    # and xmm1; or rax 1
    set bad to new_label(a)
    set whole to new_label(a)
    set positive to new_label(a)
    set huge to new_label(a)
    set tiny to new_label(a)
    mark(a, "rt_index")
    odd_jump(a, xmm1, bad)
    finite_jump(a, xmm1, bad)
    is_whole(a, xmm1, whole)
    movq_rx(a, rax, xmm1)
    push_r(a, rax)
    bit_op(a, "btr", rax, 63)
    movq_xr(a, xmm0, rax)
    call_to(a, "rt_canon_int")
    pop_r(a, r8)
    test_rr(a, rax, rax)
    jcc(a, cc_e, bad)
    test_rr(a, r8, r8)
    jcc(a, cc_ns, positive)
    unary(a, "neg", rcx)
    mark(a, positive)
    cvtsi2sd(a, xmm1, rcx)
    movi(a, rax, 0)
    ret(a)
    mark(a, whole) # a number past 2^62 is past every list's end, or before its start
    ucomisd(a, xmm1, rip(number_place(a, list of 0, 0, 0, 0, 0, 0, 0xD0, 0x43)))
    jcc(a, cc_ae, huge)
    ucomisd(a, xmm1, rip(number_place(a, list of 0, 0, 0, 0, 0, 0, 0xD0, 0xC3)))
    jcc(a, cc_be, tiny)
    cvttsd2si(a, rcx, xmm1)
    movi(a, rax, 0)
    ret(a)
    mark(a, huge)
    movi(a, rcx, 1)
    shifti(a, "shl", rcx, 62)
    movi(a, rax, 0)
    ret(a)
    mark(a, tiny)
    movi(a, rcx, 1)
    shifti(a, "shl", rcx, 62)
    unary(a, "neg", rcx)
    movi(a, rax, 0)
    ret(a)
    mark(a, bad)
    movi(a, rax, 1)
    ret(a)

    # rt_seq_index: xmm0 a list or text, xmm1 an item's number, rdx 1 to change it: rax 0 with the number
    # (from 1) in rcx; or rax 2 for a mistake, with err_why saying which (see rt_why_item)
    set kind_ok to new_label(a)
    set cant_change to new_label(a)
    set whole_index to new_label(a)
    set text_length to new_label(a)
    set compare_length to new_label(a)
    set low to new_label(a)
    set high to new_label(a)
    set failed to new_label(a)
    set not_dict to new_label(a)
    set key_fine to new_label(a)
    set dict_ok to new_label(a)
    mark(a, "rt_seq_index")
    movsd_store(a, rip("err_a"), xmm0)
    movsd_store(a, rip("err_b"), xmm1)
    store(a, rip("seq_writing"), rdx)
    movq_rx(a, rax, xmm0)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_dict)
    jcc(a, cc_ne, not_dict)
    movq_rx(a, rax, xmm1) # a dictionary: the key must be text or a number, and there unless it's being set
    call_to(a, "rt_key")
    test_rr(a, rax, rax)
    jcc(a, cc_e, key_fine)
    storei(a, rip("err_why"), 8)
    jmp_to(a, failed)
    mark(a, key_fine)
    load(a, rcx, rip("seq_writing"))
    test_rr(a, rcx, rcx)
    jcc(a, cc_ne, dict_ok)
    load(a, rax, rip("err_a"))
    untag(a, rax)
    call_to(a, "rt_dict_find")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, dict_ok)
    storei(a, rip("err_why"), 7)
    jmp_to(a, failed)
    mark(a, dict_ok)
    store(a, rip("found_entry"), rax)
    movsd_load(a, xmm0, rip("err_a"))
    movsd_load(a, xmm1, rip("err_b"))
    movi(a, rax, 0)
    ret(a)
    mark(a, not_dict)
    load(a, rdx, rip("seq_writing"))
    movq_rx(a, rax, xmm0)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_list)
    jcc(a, cc_e, kind_ok)
    alui(a, "cmp", rax, kind_bytes)
    jcc(a, cc_e, kind_ok)
    test_rr(a, rdx, rdx)
    jcc(a, cc_ne, cant_change)
    alui(a, "cmp", rax, kind_text)
    jcc(a, cc_e, kind_ok)
    storei(a, rip("err_why"), 3)
    jmp_to(a, failed)
    mark(a, cant_change)
    storei(a, rip("err_why"), 2)
    jmp_to(a, failed)
    mark(a, kind_ok)
    call_to(a, "rt_index")
    test_rr(a, rax, rax)
    jcc(a, cc_e, whole_index)
    storei(a, rip("err_why"), 4)
    jmp_to(a, failed)
    mark(a, whole_index)
    movsd_store(a, rip("err_b"), xmm1)
    alui(a, "cmp", rcx, 1)
    jcc(a, cc_l, low)
    load(a, rax, rip("err_a"))
    mov_rr(a, rdx, rax)
    shifti(a, "shr", rdx, 48)
    untag(a, rax)
    alui(a, "cmp", rdx, kind_text)
    jcc(a, cc_e, text_length)
    load(a, r8, mem(rax, 0)) # a list's items or bytes' bytes
    jmp_to(a, compare_length)
    mark(a, text_length)
    load(a, r8, mem(rax, 8))
    mark(a, compare_length)
    alu(a, "cmp", rcx, r8)
    jcc(a, cc_g, high)
    movsd_load(a, xmm0, rip("err_a"))
    movi(a, rax, 0)
    ret(a)
    mark(a, low)
    storei(a, rip("err_why"), 5)
    jmp_to(a, failed)
    mark(a, high)
    store(a, rip("err_len"), r8)
    storei(a, rip("err_why"), 6)
    mark(a, failed)
    movi(a, rax, 2)
    ret(a)

    # rt_item: xmm0's item xmm1 into xmm0; rax as rt_seq_index's
    set of_chars to new_label(a)
    set of_dict to new_label(a)
    mark(a, "rt_item")
    movi(a, rdx, 0)
    call_to(a, "rt_seq_index")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, "rt_item_out")
    movq_rx(a, rax, xmm0)
    mov_rr(a, rdx, rax)
    shifti(a, "shr", rdx, 48)
    untag(a, rax)
    alui(a, "cmp", rdx, kind_dict)
    jcc(a, cc_e, of_dict)
    alui(a, "cmp", rdx, kind_text)
    jcc(a, cc_e, of_chars)
    alui(a, "cmp", rdx, kind_bytes)
    set of_bytes to new_label(a)
    jcc(a, cc_e, of_bytes)
    load(a, rax, mem(rax, 16))
    dec_r(a, rcx)
    shifti(a, "shl", rcx, 3)
    alu(a, "add", rax, rcx)
    movsd_load(a, xmm0, mem(rax, 0))
    movi(a, rax, 0)
    mark(a, "rt_item_out")
    ret(a)
    mark(a, of_chars)
    call_to(a, "rt_char_at")
    movq_xr(a, xmm0, rax)
    movi(a, rax, 0)
    ret(a)
    mark(a, of_dict)
    load(a, rax, rip("found_entry"))
    movsd_load(a, xmm0, mem(rax, 8))
    movi(a, rax, 0)
    ret(a)
    mark(a, of_bytes)
    load(a, rax, mem(rax, 8))
    alu(a, "add", rax, rcx)
    load8(a, rax, mem(rax, -1))
    cvtsi2sd(a, xmm0, rax)
    movi(a, rax, 0)
    ret(a)

    # rt_item_ref: checks that item xmm1 of xmm0 can be changed: rax as rt_seq_index's, with the item's
    # number in xmm1 and xmm0 kept
    mark(a, "rt_item_ref")
    movi(a, rdx, 1)
    jmp_to(a, "rt_seq_index")

    # rt_set_item: item xmm1 of the list or dictionary xmm0, which rt_item_ref has checked, gets xmm2; rax
    # is 0
    set set_list to new_label(a)
    mark(a, "rt_set_item")
    movq_rx(a, rax, xmm0)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_dict)
    jcc(a, cc_ne, set_list)
    movsd_store(a, rip("keep"), xmm0) # rt_key can use any of the xmm registers
    movsd_store(a, rip("keep2"), xmm2)
    movq_rx(a, rax, xmm1)
    call_to(a, "rt_key")
    load(a, r10, rip("keep2"))
    load(a, rax, rip("keep"))
    untag(a, rax)
    call_to(a, "rt_dict_set")
    movi(a, rax, 0)
    ret(a)
    mark(a, set_list)
    movq_rx(a, rax, xmm0)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_bytes)
    set set_array to new_label(a)
    jcc(a, cc_ne, set_array)
    movsd_store(a, rip("keep"), xmm0)
    cvttsd2si(a, rax, xmm1)
    store(a, rip("keep2"), rax)
    call_to(a, "rt_byte")
    test_rr(a, rax, rax)
    set byte_fits to new_label(a)
    jcc(a, cc_e, byte_fits)
    ret(a)
    mark(a, byte_fits)
    load(a, rax, rip("keep"))
    untag(a, rax)
    load(a, rax, mem(rax, 8))
    alu_load(a, "add", rax, rip("keep2"))
    store8(a, mem(rax, -1), rcx)
    movi(a, rax, 0)
    ret(a)
    mark(a, set_array)
    movq_rx(a, rax, xmm0)
    untag(a, rax)
    cvttsd2si(a, rcx, xmm1)
    dec_r(a, rcx)
    shifti(a, "shl", rcx, 3)
    load(a, rax, mem(rax, 16))
    alu(a, "add", rax, rcx)
    movsd_store(a, mem(rax, 0), xmm2)
    movi(a, rax, 0)
    ret(a)

    # rt_char_at: rax a text (untagged), rcx a character's number (from 1): that character, as a text that
    # shares its bytes, in rax. Of a text whose letters are a byte each, right there; else counted, from the
    # letter rt_letter_at's memory has when it's the same bytes and not past this one (see rt_letter_at),
    # which it then remembers; uses r8 to r11
    set seek to new_label(a)
    set not_lead to new_label(a)
    set at_char to new_label(a)
    set counted to new_label(a)
    mark(a, "rt_char_at")
    load(a, rsi, mem(rax, 16))
    load(a, r11, mem(rax, 0)) # how many bytes it has
    alu_load(a, "cmp", r11, mem(rax, 8))
    jcc(a, cc_ne, counted)
    lea(a, rsi, mem(rsi, -1))
    alu(a, "add", rsi, rcx) # a byte a letter: the letter's own
    jmp_to(a, "rt_char_view")
    mark(a, counted)
    movi(a, r8, 0) # the byte it's at
    movi(a, r9, 0) # the letters started before it
    load(a, r10, rip("la_ptr"))
    alu(a, "cmp", r10, rsi)
    jcc(a, cc_ne, seek)
    load(a, r10, rip("la_letters"))
    alu(a, "cmp", rcx, r10)
    jcc(a, cc_b, seek) # before the letter it remembers: from the start
    load(a, r10, rip("la_byte"))
    alu(a, "cmp", r10, r11)
    jcc(a, cc_ae, seek) # past this text's end: another, shorter view of the bytes
    mov_rr(a, r8, r10)
    load(a, r9, rip("la_letters"))
    dec_r(a, r9)
    mark(a, seek)
    mov_rr(a, rax, rsi)
    alu(a, "add", rax, r8)
    load8(a, r10, mem(rax, 0))
    alui(a, "and", r10, 0xC0)
    alui(a, "cmp", r10, 0x80)
    jcc(a, cc_e, not_lead)
    inc_r(a, r9)
    alu(a, "cmp", r9, rcx)
    jcc(a, cc_e, at_char)
    mark(a, not_lead)
    inc_r(a, r8)
    jmp_to(a, seek)
    mark(a, at_char)
    store(a, rip("la_ptr"), rsi)
    store(a, rip("la_letters"), rcx)
    store(a, rip("la_byte"), r8)
    alu(a, "add", rsi, r8)
    jmp_to(a, "rt_char_view")

    # rt_char_view: rsi, a character's first byte: that character as a text, in rax; uses rcx and rdx
    mark(a, "rt_char_view")
    char_size(a)
    movi(a, rcx, 24)
    call_to(a, "rt_alloc")
    store(a, mem(rax, 0), rdx)
    storei(a, mem(rax, 8), 1)
    store(a, mem(rax, 16), rsi)
    movi64(a, rcx, tag_text)
    alu(a, "or", rax, rcx)
    ret(a)

    # rt_items: xmm0: what `for each` goes through, as items in rdx (rcx of them), a copy so that changing the
    # list doesn't change them; rax is 0, or 2 for a mistake, with the value in err_a
    set list_items to new_label(a)
    set text_items to new_label(a)
    set each_char to new_label(a)
    set chars_done to new_label(a)
    mark(a, "rt_items")
    movsd_store(a, rip("err_a"), xmm0)
    movq_rx(a, rax, xmm0)
    mov_rr(a, rdx, rax)
    shifti(a, "shr", rdx, 48)
    untag(a, rax)
    alui(a, "cmp", rdx, kind_list)
    jcc(a, cc_e, list_items)
    alui(a, "cmp", rdx, kind_text)
    jcc(a, cc_e, text_items)
    alui(a, "cmp", rdx, kind_dict)
    jcc(a, cc_e, "rt_items_keys")
    alui(a, "cmp", rdx, kind_bytes)
    jcc(a, cc_e, "rt_items_bytes")
    movi(a, rax, 2)
    ret(a)
    set byte_loop to new_label(a)
    set bytes_done to new_label(a)
    mark(a, "rt_items_bytes") # bytes: each as a number
    push_r(a, rbx)
    mov_rr(a, rbx, rax)
    load(a, rcx, mem(rbx, 0))
    shifti(a, "shl", rcx, 3)
    call_to(a, "rt_alloc")
    mov_rr(a, rdx, rax)
    load(a, rsi, mem(rbx, 8))
    load(a, rcx, mem(rbx, 0))
    mov_rr(a, rdi, rax)
    mark(a, byte_loop)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, bytes_done)
    load8(a, rax, mem(rsi, 0))
    cvtsi2sd(a, xmm0, rax)
    movsd_store(a, mem(rdi, 0), xmm0)
    inc_r(a, rsi)
    alui(a, "add", rdi, 8)
    dec_r(a, rcx)
    jmp_to(a, byte_loop)
    mark(a, bytes_done)
    load(a, rcx, mem(rbx, 0))
    pop_r(a, rbx)
    movi(a, rax, 0)
    ret(a)
    mark(a, "rt_items_keys") # a dictionary's keys
    call_to(a, "rt_dict_keys")
    movi(a, rax, 0)
    ret(a)
    mark(a, list_items)
    push_r(a, rbx)
    push_r(a, r12)
    mov_rr(a, rbx, rax)
    load(a, rcx, mem(rbx, 0))
    mov_rr(a, r12, rcx)
    shifti(a, "shl", rcx, 3)
    call_to(a, "rt_alloc")
    mov_rr(a, rdi, rax)
    load(a, rsi, mem(rbx, 16))
    mov_rr(a, rcx, r12)
    rep_movsq(a)
    mov_rr(a, rdx, rax)
    mov_rr(a, rcx, r12)
    pop_r(a, r12)
    pop_r(a, rbx)
    movi(a, rax, 0)
    ret(a)
    mark(a, text_items)
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    mov_rr(a, rbx, rax)
    load(a, rcx, mem(rbx, 8))
    mov_rr(a, r12, rcx)
    shifti(a, "shl", rcx, 3)
    call_to(a, "rt_alloc")
    mov_rr(a, r13, rax)
    mov_rr(a, r14, rax)
    load(a, rsi, mem(rbx, 16))
    load(a, rbx, mem(rbx, 0))
    alu(a, "add", rbx, rsi) # where the bytes end
    mark(a, each_char)
    alu(a, "cmp", rsi, rbx)
    jcc(a, cc_ae, chars_done)
    call_to(a, "rt_char_view")
    store(a, mem(r14, 0), rax)
    alui(a, "add", r14, 8)
    alu(a, "add", rsi, rdx)
    jmp_to(a, each_char)
    mark(a, chars_done)
    mov_rr(a, rdx, r13)
    mov_rr(a, rcx, r12)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    movi(a, rax, 0)
    ret(a)

    # rt_list_make: rcx values, from rsi up, the last first (as they were pushed): a new list of them in rax
    set least to new_label(a)
    set copying to new_label(a)
    set made to new_label(a)
    mark(a, "rt_list_make")
    push_r(a, rbx)
    push_r(a, r12)
    mov_rr(a, rbx, rcx)
    mov_rr(a, r12, rsi)
    movi(a, rcx, 24)
    call_to(a, "rt_alloc")
    mov_rr(a, r9, rax)
    mov_rr(a, rcx, rbx)
    alui(a, "cmp", rcx, 4)
    jcc(a, cc_ae, least)
    movi(a, rcx, 4)
    mark(a, least)
    store(a, mem(r9, 8), rcx)
    shifti(a, "shl", rcx, 3)
    call_to(a, "rt_alloc")
    store(a, mem(r9, 16), rax)
    store(a, mem(r9, 0), rbx)
    mov_rr(a, rdi, rax)
    mov_rr(a, rcx, rbx)
    mov_rr(a, rsi, rbx)
    shifti(a, "shl", rsi, 3)
    alu(a, "add", rsi, r12)
    mark(a, copying)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, made)
    alui(a, "sub", rsi, 8)
    load(a, rax, mem(rsi, 0))
    store(a, mem(rdi, 0), rax)
    alui(a, "add", rdi, 8)
    dec_r(a, rcx)
    jmp_to(a, copying)
    mark(a, made)
    mov_rr(a, rax, r9)
    movi64(a, rcx, tag_list)
    alu(a, "or", rax, rcx)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_list_push: rax a list, rdx a value: the value goes at its end, with twice the room when it's full
    set room to new_label(a)
    mark(a, "rt_list_push")
    untag(a, rax)
    load(a, rcx, mem(rax, 0))
    alu_load(a, "cmp", rcx, mem(rax, 8))
    jcc(a, cc_b, room)
    push_r(a, rsi)
    push_r(a, rdi)
    mov_rr(a, r8, rax)
    load(a, rcx, mem(r8, 8))
    alu(a, "add", rcx, rcx)
    store(a, mem(r8, 8), rcx)
    shifti(a, "shl", rcx, 3)
    call_to(a, "rt_alloc")
    mov_rr(a, rdi, rax)
    load(a, rsi, mem(r8, 16))
    load(a, rcx, mem(r8, 0))
    rep_movsq(a)
    store(a, mem(r8, 16), rax)
    mov_rr(a, rax, r8)
    pop_r(a, rdi)
    pop_r(a, rsi)
    mark(a, room)
    load(a, rcx, mem(rax, 0))
    load(a, r8, mem(rax, 16))
    mov_rr(a, r9, rcx)
    shifti(a, "shl", r9, 3)
    alu(a, "add", r8, r9)
    store(a, mem(r8, 0), rdx)
    inc_r(a, rcx)
    store(a, mem(rax, 0), rcx)
    ret(a)

    # rt_add_into: `add xmm1 to` a variable holding xmm0, which is in memory: text grows, a list gets it at its
    # end. xmm0 gets what the variable holds after; rax is 0, or 2 with err_a and err_b for a mistake, or 3
    # for text too long
    set grow_text to new_label(a)
    set grow_list to new_label(a)
    mark(a, "rt_add_into")
    movq_rx(a, rax, xmm0)
    mov_rr(a, rdx, rax)
    shifti(a, "shr", rdx, 48)
    alui(a, "cmp", rdx, kind_text)
    jcc(a, cc_e, grow_text)
    alui(a, "cmp", rdx, kind_list)
    jcc(a, cc_e, grow_list)
    set add_wrong to new_label(a)
    if units of a # an amount gets one of the same measure, in its unit
        alui(a, "cmp", rdx, kind_quantity)
        jcc(a, cc_ne, add_wrong)
        movq_rx(a, r11, xmm0)
        call_to(a, "rt_q_pair")
        test_rr(a, rax, rax)
        jcc(a, cc_ne, add_wrong)
        sse_math(a, "+", xmm0, reg_at(xmm1))
        mov_rr(a, rax, r11)
        untag(a, rax)
        load(a, rcx, mem(rax, 8))
        call_to(a, "rt_q_make")
        movi(a, rax, 0)
        ret(a)
    end
    mark(a, add_wrong)
    movsd_store(a, rip("err_a"), xmm1)
    movsd_store(a, rip("err_b"), xmm0)
    movi(a, rax, 2)
    ret(a)
    mark(a, grow_text)
    movapd(a, xmm2, xmm0)
    jmp_to(a, "rt_join")
    mark(a, grow_list)
    movsd_store(a, rip("keep"), xmm0)
    movq_rx(a, rdx, xmm1)
    call_to(a, "rt_list_push")
    movsd_load(a, xmm0, rip("keep"))
    movi(a, rax, 0)
    ret(a)

    # rt_why_item: what was wrong with an item, from err_why, err_a (what it was of), err_b (its number) and
    # err_len, into the builder
    set why_3 to new_label(a)
    set why_4 to new_label(a)
    set why_5 to new_label(a)
    set why_6 to new_label(a)
    set of_list to new_label(a)
    set counted to new_label(a)
    set one to new_label(a)
    mark(a, "rt_why_item")
    load(a, rax, rip("err_why"))
    alui(a, "cmp", rax, 10)
    jcc(a, cc_ae, "rt_why_builtin")
    alui(a, "cmp", rax, 7)
    jcc(a, cc_ae, "rt_why_key")
    alui(a, "cmp", rax, 3)
    jcc(a, cc_e, why_3)
    alui(a, "cmp", rax, 4)
    jcc(a, cc_e, why_4)
    alui(a, "cmp", rax, 5)
    jcc(a, cc_e, why_5)
    alui(a, "cmp", rax, 6)
    jcc(a, cc_e, why_6)
    b_text(a, "can only change items of a list, dictionary or bytes, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, why_3)
    b_text(a, "can only take an item of a list, text, dictionary or bytes, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, why_4)
    b_text(a, "item numbers must be whole numbers, not ")
    load(a, rax, rip("err_b"))
    movi(a, rdx, 1)
    jmp_to(a, "rt_b_value")
    mark(a, why_5)
    b_text(a, "there is no item ")
    load(a, rax, rip("err_b"))
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    b_text(a, ", items are counted from 1")
    ret(a)
    mark(a, why_6)
    b_text(a, "there is no item ")
    load(a, rax, rip("err_b"))
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    load(a, rax, rip("err_a"))
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_list)
    jcc(a, cc_e, of_list)
    alui(a, "cmp", rax, kind_bytes)
    set of_bytes to new_label(a)
    jcc(a, cc_e, of_bytes)
    b_text(a, ", the text only has ")
    load(a, rax, rip("err_len"))
    call_to(a, "rt_e_plain")
    b_text(a, " letter")
    jmp_to(a, counted)
    mark(a, of_bytes)
    b_text(a, ", there are only ")
    load(a, rax, rip("err_len"))
    call_to(a, "rt_e_plain")
    b_text(a, " byte")
    jmp_to(a, counted)
    mark(a, of_list)
    b_text(a, ", the list only has ")
    load(a, rax, rip("err_len"))
    call_to(a, "rt_e_plain")
    b_text(a, " item")
    mark(a, counted)
    load(a, rax, rip("err_len"))
    alui(a, "cmp", rax, 1)
    jcc(a, cc_e, one)
    movi(a, rax, 115)
    call_to(a, "rt_b_byte")
    mark(a, one)
    ret(a)
end

# rdx gets how many bytes the UTF-8 character at rsi has
to char_size with a
    set sized to new_label(a)
    load8(a, rdx, mem(rsi, 0))
    alui(a, "cmp", rdx, 0x80)
    movi(a, rdx, 1)
    jcc(a, cc_b, sized)
    load8(a, rdx, mem(rsi, 0))
    alui(a, "cmp", rdx, 0xE0)
    movi(a, rdx, 2)
    jcc(a, cc_b, sized)
    load8(a, rdx, mem(rsi, 0))
    alui(a, "cmp", rdx, 0xF0)
    movi(a, rdx, 3)
    jcc(a, cc_b, sized)
    movi(a, rdx, 4)
    mark(a, sized)
end

# turns the character number in register r into one that sorts as UTF-16 does: those from U+E000 to U+FFFF
# come after the ones past U+FFFF, whose first UTF-16 unit is below U+E000
to utf16_key with a, r
    set kept to new_label(a)
    alui(a, "cmp", r, 0xE000)
    jcc(a, cc_b, kept)
    alui(a, "cmp", r, 0x10000)
    jcc(a, cc_ae, kept)
    alui(a, "add", r, 0x110000)
    mark(a, kept)
end

# jumps if xmm x is a value in memory; uses rax
to pointer_jump with a, x, name
    movq_rx(a, rax, x)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_text)
    jcc(a, cc_ae, name)
end

# jumps if xmm x isn't a plain number: nothing, yes, no, or a value in memory; uses rax and rcx
to odd_jump with a, x, name
    special_jump(a, x, name)
    pointer_jump(a, x, name)
end

# the pointer in a value's bits, in register r: its low 48 bits
to untag with a, r
    shifti(a, "shl", r, 16)
    shifti(a, "shr", r, 16)
end

# ---------- the runtime: records and dictionaries ----------
# A record is 24 bytes: how many fields, room for how many, and where they are: each a field's name (one of
# the program's texts, so two names are the same exactly when they are the same text) and its value. A
# dictionary is 48 bytes: how many keys it has, how many entries it has used and has room for, where they
# are, and an index to find them: each entry is a key, its value and the key's hash, in the order keys were
# added, and a removed one keeps its place with no value yet as its key. A number key is the number to 15
# digits, as the engines' keys are.

to emit_records with a
    # rt_record_make: rcx fields, their values from rsi up (the last first), and their names from rdx up:
    # a new record, in rax
    set filling to new_label(a)
    set filled to new_label(a)
    mark(a, "rt_record_make")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    mov_rr(a, rbx, rcx)
    mov_rr(a, r12, rsi)
    mov_rr(a, r13, rdx)
    movi(a, rcx, 24)
    call_to(a, "rt_alloc")
    mov_rr(a, r14, rax)
    mov_rr(a, rcx, rbx)
    alui(a, "add", rcx, 4)
    store(a, mem(r14, 8), rcx)
    shifti(a, "shl", rcx, 4)
    call_to(a, "rt_alloc")
    store(a, mem(r14, 16), rax)
    mov_rr(a, rsi, rbx) # the values, first to last
    shifti(a, "shl", rsi, 3)
    alu(a, "add", r12, rsi)
    mark(a, filling)
    test_rr(a, rbx, rbx)
    jcc(a, cc_e, filled)
    alui(a, "sub", r12, 8)
    mov_rr(a, rax, r14)
    load(a, rdx, mem(r13, 0))
    load(a, r8, mem(r12, 0))
    call_to(a, "rt_record_put")
    alui(a, "add", r13, 8)
    dec_r(a, rbx)
    jmp_to(a, filling)
    mark(a, filled)
    mov_rr(a, rax, r14)
    movi64(a, rcx, tag_record)
    alu(a, "or", rax, rcx)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_record_new: the same, for fields whose names all differ, as a record made in the program's own words
    # has them: one block, the record and room for its fields after it, which are put straight in
    set new_filling to new_label(a)
    set new_filled to new_label(a)
    mark(a, "rt_record_new")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    mov_rr(a, rbx, rcx)
    mov_rr(a, r12, rsi)
    mov_rr(a, r13, rdx)
    inc_r(a, rcx) # room for one more, as a field's often added; more, and they move to a block of their own
    shifti(a, "shl", rcx, 4)
    alui(a, "add", rcx, 32)
    call_to(a, "rt_alloc")
    store(a, mem(rax, 0), rbx)
    mov_rr(a, rcx, rbx)
    inc_r(a, rcx)
    store(a, mem(rax, 8), rcx)
    lea(a, rdi, mem(rax, 32))
    store(a, mem(rax, 16), rdi)
    mov_rr(a, rcx, rbx) # the values, first to last
    shifti(a, "shl", rcx, 3)
    alu(a, "add", r12, rcx)
    mark(a, new_filling)
    test_rr(a, rbx, rbx)
    jcc(a, cc_e, new_filled)
    alui(a, "sub", r12, 8)
    load(a, rcx, mem(r13, 0))
    store(a, mem(rdi, 0), rcx)
    load(a, rcx, mem(r12, 0))
    store(a, mem(rdi, 8), rcx)
    alui(a, "add", r13, 8)
    alui(a, "add", rdi, 16)
    dec_r(a, rbx)
    jmp_to(a, new_filling)
    mark(a, new_filled)
    movi64(a, rcx, tag_record)
    alu(a, "or", rax, rcx)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_record_find: rax a record (untagged), rdx a field's name: where that field's pair is, in rax, or 0
    set seek to new_label(a)
    set none to new_label(a)
    mark(a, "rt_record_find")
    load(a, rcx, mem(rax, 0))
    load(a, rax, mem(rax, 16))
    mark(a, seek)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, none)
    alu_load(a, "cmp", rdx, mem(rax, 0))
    jcc(a, cc_e, "rt_record_found")
    alui(a, "add", rax, 16)
    dec_r(a, rcx)
    jmp_to(a, seek)
    mark(a, none)
    movi(a, rax, 0)
    mark(a, "rt_record_found")
    ret(a)

    # rt_record_put: rax a record (untagged), rdx a field's name, r8 its value: changes it, or adds it at the
    # end; keeps rbx and r12 to r15
    set found to new_label(a)
    set room to new_label(a)
    mark(a, "rt_record_put")
    push_r(a, rax)
    call_to(a, "rt_record_find")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, found)
    pop_r(a, rax)
    load(a, rcx, mem(rax, 0))
    alu_load(a, "cmp", rcx, mem(rax, 8))
    jcc(a, cc_b, room)
    mov_rr(a, r9, rax) # twice the room
    load(a, rcx, mem(r9, 8))
    alu(a, "add", rcx, rcx)
    store(a, mem(r9, 8), rcx)
    shifti(a, "shl", rcx, 4)
    call_to(a, "rt_alloc")
    push_r(a, rsi)
    push_r(a, rdi)
    mov_rr(a, rdi, rax)
    load(a, rsi, mem(r9, 16))
    load(a, rcx, mem(r9, 0))
    alu(a, "add", rcx, rcx)
    rep_movsq(a)
    pop_r(a, rdi)
    pop_r(a, rsi)
    store(a, mem(r9, 16), rax)
    mov_rr(a, rax, r9)
    mark(a, room)
    load(a, rcx, mem(rax, 0))
    mov_rr(a, r9, rcx)
    shifti(a, "shl", r9, 4)
    alu_load(a, "add", r9, mem(rax, 16))
    store(a, mem(r9, 0), rdx)
    store(a, mem(r9, 8), r8)
    inc_r(a, rcx)
    store(a, mem(rax, 0), rcx)
    ret(a)
    mark(a, found)
    store(a, mem(rax, 8), r8)
    pop_r(a, rax)
    ret(a)

    # rt_field: xmm0's field rdx into xmm0; rax is 0, or 2 for a mistake (err_why 1: not a record; 2: no
    # such field), with the record in err_a and the name in err_field
    set not_record to new_label(a)
    set missing to new_label(a)
    mark(a, "rt_field")
    movsd_store(a, rip("err_a"), xmm0)
    store(a, rip("err_field"), rdx)
    movq_rx(a, rax, xmm0)
    mov_rr(a, rcx, rax)
    shifti(a, "shr", rcx, 48)
    alui(a, "cmp", rcx, kind_record)
    jcc(a, cc_ne, not_record)
    untag(a, rax)
    call_to(a, "rt_record_find")
    test_rr(a, rax, rax)
    jcc(a, cc_e, missing)
    movsd_load(a, xmm0, mem(rax, 8))
    movi(a, rax, 0)
    ret(a)
    mark(a, not_record)
    storei(a, rip("err_why"), 1)
    movi(a, rax, 2)
    ret(a)
    mark(a, missing)
    storei(a, rip("err_why"), 2)
    movi(a, rax, 2)
    ret(a)

    # rt_field_noted: as rt_field, and where the field was among the record's, 16 bytes each, goes where r10
    # points, for that `x of p` to look first next time (see gen_field)
    mark(a, "rt_field_noted")
    movsd_store(a, rip("err_a"), xmm0)
    store(a, rip("err_field"), rdx)
    movq_rx(a, rax, xmm0)
    mov_rr(a, rcx, rax)
    shifti(a, "shr", rcx, 48)
    alui(a, "cmp", rcx, kind_record)
    jcc(a, cc_ne, not_record)
    untag(a, rax)
    load(a, r9, mem(rax, 16))
    call_to(a, "rt_record_find")
    test_rr(a, rax, rax)
    jcc(a, cc_e, missing)
    mov_rr(a, rcx, rax)
    alu(a, "sub", rcx, r9)
    store(a, mem(r10, 0), rcx)
    movsd_load(a, xmm0, mem(rax, 8))
    movi(a, rax, 0)
    ret(a)

    # rt_record_ref: checks that field rdx of xmm0 can be changed: rax 0, or 2 with err_why 3
    set changeable to new_label(a)
    mark(a, "rt_record_ref")
    movsd_store(a, rip("err_a"), xmm0)
    store(a, rip("err_field"), rdx)
    movq_rx(a, rax, xmm0)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_record)
    jcc(a, cc_e, changeable)
    storei(a, rip("err_why"), 3)
    movi(a, rax, 2)
    ret(a)
    mark(a, changeable)
    movi(a, rax, 0)
    ret(a)

    # rt_set_field: field rdx of the record xmm0 gets xmm2
    mark(a, "rt_set_field")
    movq_rx(a, rax, xmm0)
    untag(a, rax)
    movq_rx(a, r8, xmm2)
    jmp_to(a, "rt_record_put")

    # rt_set_field_noted: as rt_set_field, and where the field is now among the record's goes where r10
    # points (see gen_field)
    mark(a, "rt_set_field_noted")
    movq_rx(a, rax, xmm0)
    untag(a, rax)
    movq_rx(a, r8, xmm2)
    push_r(a, rax)
    push_r(a, rdx)
    push_r(a, r10)
    call_to(a, "rt_record_put")
    pop_r(a, r10)
    pop_r(a, rdx)
    pop_r(a, rax)
    load(a, r9, mem(rax, 16))
    call_to(a, "rt_record_find")
    alu(a, "sub", rax, r9)
    store(a, mem(r10, 0), rax)
    ret(a)

    # rt_why_field: what was wrong with a field, into the builder
    set why_2 to new_label(a)
    set why_3 to new_label(a)
    set no_guess to new_label(a)
    mark(a, "rt_why_field")
    load(a, rax, rip("err_why"))
    alui(a, "cmp", rax, 2)
    jcc(a, cc_e, why_2)
    alui(a, "cmp", rax, 3)
    jcc(a, cc_e, why_3)
    b_text(a, "can't take '")
    field_name(a)
    b_text(a, "' of ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, why_3)
    b_text(a, "can only change '")
    field_name(a)
    b_text(a, "' of a record, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, why_2)
    b_text(a, "this record has no '")
    field_name(a)
    b_text(a, "'")
    push_r(a, rbx) # the closest of its fields' names
    load(a, rbx, rip("err_a"))
    untag(a, rbx)
    load(a, rcx, mem(rbx, 0))
    shifti(a, "shl", rcx, 3)
    call_to(a, "rt_alloc")
    mov_rr(a, rdi, rax)
    load(a, rsi, mem(rbx, 16))
    load(a, rcx, mem(rbx, 0))
    set names_loop to new_label(a)
    set names_done to new_label(a)
    mark(a, names_loop)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, names_done)
    load(a, rdx, mem(rsi, 0))
    store(a, mem(rdi, 0), rdx)
    alui(a, "add", rsi, 16)
    alui(a, "add", rdi, 8)
    dec_r(a, rcx)
    jmp_to(a, names_loop)
    mark(a, names_done)
    mov_rr(a, rsi, rax)
    load(a, rcx, mem(rbx, 0))
    load(a, rdx, rip("err_field"))
    pop_r(a, rbx)
    call_to(a, "rt_closest")
    test_rr(a, rax, rax)
    jcc(a, cc_e, no_guess)
    push_r(a, rax)
    b_text(a, ". Did you mean '")
    pop_r(a, rax)
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    call_to(a, "rt_b_bytes")
    b_text(a, "'?")
    mark(a, no_guess)
    ret(a)

    # ---- dictionaries ----

    # rt_key: rax a value: as a dictionary's key in rdx, with its hash in r8, and rax 0; or rax 2 if it's
    # neither text nor a number, with it in err_b
    set text_key to new_label(a)
    set hashed to new_label(a)
    set zero_key to new_label(a)
    set nan_key to new_label(a)
    set whole_key to new_label(a)
    set bad_key to new_label(a)
    set positive_key to new_label(a)
    mark(a, "rt_key")
    mov_rr(a, rdx, rax)
    movq_xr(a, xmm0, rax)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_text)
    jcc(a, cc_e, text_key)
    special_jump(a, xmm0, bad_key)
    pointer_jump(a, xmm0, bad_key)
    movq_rx(a, rax, xmm0) # a number, to 15 digits: 0 for -0, one NaN for every NaN
    mov_rr(a, rcx, rax)
    shifti(a, "shl", rcx, 1)
    jcc(a, cc_e, zero_key)
    movi64(a, r8, list of 0, 0, 0, 0, 0, 0, 0xE0, 0xFF)
    alu(a, "cmp", rcx, r8)
    jcc(a, cc_a, nan_key)
    jcc(a, cc_e, whole_key)
    movq_rx(a, rax, xmm0)
    is_whole(a, xmm0, whole_key)
    push_r(a, rdx)
    movq_rx(a, rax, xmm0)
    bit_op(a, "btr", rax, 63)
    movq_xr(a, xmm0, rax)
    call_to(a, "rt_canon_double")
    pop_r(a, rdx)
    test_rr(a, rdx, rdx)
    jcc(a, cc_ns, positive_key)
    bit_op(a, "bts", rax, 63)
    mark(a, positive_key)
    mov_rr(a, rdx, rax)
    jmp_to(a, whole_key)
    mark(a, zero_key)
    movi(a, rdx, 0)
    jmp_to(a, whole_key)
    mark(a, nan_key)
    movi64(a, rdx, list of 0, 0, 0, 0, 0, 0, 0xF8, 0x7F)
    mark(a, whole_key)
    mov_rr(a, r8, rdx)
    jmp_to(a, hashed)
    mark(a, text_key) # FNV-1a over its bytes
    mov_rr(a, rax, rdx)
    untag(a, rax)
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    movi64(a, r8, list of 0x25, 0x23, 0x22, 0x84, 0xE4, 0x9C, 0xF2, 0xCB)
    movi64(a, r9, list of 0xB3, 0x01, 0, 0, 0, 0x01, 0, 0)
    set fnv to new_label(a)
    mark(a, fnv)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, hashed)
    load8(a, rax, mem(rsi, 0))
    alu(a, "xor", r8, rax)
    imul_rr(a, r8, r9)
    inc_r(a, rsi)
    dec_r(a, rcx)
    jmp_to(a, fnv)
    mark(a, hashed) # every bit reaches the low ones the index uses (murmur3's last mix)
    mov_rr(a, rax, r8)
    shifti(a, "shr", rax, 33)
    alu(a, "xor", r8, rax)
    movi64(a, r9, list of 0xCD, 0x8C, 0x55, 0xED, 0xD7, 0xAF, 0x51, 0xFF)
    imul_rr(a, r8, r9)
    mov_rr(a, rax, r8)
    shifti(a, "shr", rax, 33)
    alu(a, "xor", r8, rax)
    movi(a, rax, 0)
    ret(a)
    mark(a, bad_key)
    movq_rx(a, rax, xmm0)
    store(a, rip("err_b"), rax)
    movi(a, rax, 2)
    ret(a)

    # rt_dict_new: an empty dictionary, untagged, in rax
    mark(a, "rt_dict_new")
    push_r(a, rbx)
    movi(a, rcx, 48)
    call_to(a, "rt_alloc")
    mov_rr(a, rbx, rax)
    storei(a, mem(rbx, 16), 8)
    movi(a, rcx, 192)
    call_to(a, "rt_alloc")
    store(a, mem(rbx, 24), rax)
    storei(a, mem(rbx, 32), 16)
    movi(a, rcx, 128)
    call_to(a, "rt_alloc_raw")
    store(a, mem(rbx, 40), rax)
    mov_rr(a, rax, rbx)
    pop_r(a, rbx)
    ret(a)

    # rt_dict_find: rax a dictionary (untagged), rdx a key, r8 its hash: its entry in rax, or 0, with the
    # index's slot for it in r9; keeps rdx and r8
    set probe to new_label(a)
    set empty_slot to new_label(a)
    set next_slot to new_label(a)
    set same_key to new_label(a)
    mark(a, "rt_dict_find")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    mov_rr(a, rbx, rax)
    load(a, r12, mem(rbx, 32))
    dec_r(a, r12) # the index's mask
    mov_rr(a, r13, r8)
    alu(a, "and", r13, r12)
    mark(a, probe)
    mov_rr(a, r9, r13)
    shifti(a, "shl", r9, 3)
    alu_load(a, "add", r9, mem(rbx, 40))
    load(a, rax, mem(r9, 0))
    test_rr(a, rax, rax)
    jcc(a, cc_e, empty_slot)
    dec_r(a, rax)
    imul_ri(a, rax, rax, 24)
    alu_load(a, "add", rax, mem(rbx, 24))
    alu_load(a, "cmp", r8, mem(rax, 16))
    jcc(a, cc_ne, next_slot)
    push_r(a, rax)
    push_r(a, r9)
    push_r(a, rdx)
    push_r(a, r8)
    load(a, rax, mem(rax, 0))
    call_to(a, "rt_same_key")
    mov_rr(a, rcx, rax)
    pop_r(a, r8)
    pop_r(a, rdx)
    pop_r(a, r9)
    pop_r(a, rax)
    test_rr(a, rcx, rcx)
    jcc(a, cc_ne, same_key)
    mark(a, next_slot)
    inc_r(a, r13)
    alu(a, "and", r13, r12)
    jmp_to(a, probe)
    mark(a, empty_slot)
    movi(a, rax, 0)
    mark(a, same_key)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_same_key: rax, rdx, two keys: rax 1 if they're the same
    set same_bits to new_label(a)
    set not_same to new_label(a)
    mark(a, "rt_same_key")
    alu(a, "cmp", rax, rdx)
    jcc(a, cc_e, same_bits)
    mov_rr(a, rcx, rax)
    shifti(a, "shr", rcx, 48)
    alui(a, "cmp", rcx, kind_text)
    jcc(a, cc_ne, not_same)
    mov_rr(a, rcx, rdx)
    shifti(a, "shr", rcx, 48)
    alui(a, "cmp", rcx, kind_text)
    jcc(a, cc_ne, not_same)
    jmp_to(a, "rt_equal")
    mark(a, same_bits)
    movi(a, rax, 1)
    ret(a)
    mark(a, not_same)
    movi(a, rax, 0)
    ret(a)

    # rt_dict_set: rax a dictionary (untagged), rdx a key, r8 its hash, r10 the value: changes it, or adds it
    # at the end; keeps rbx and r12 to r15
    set exists to new_label(a)
    set entries_room to new_label(a)
    set index_room to new_label(a)
    mark(a, "rt_dict_set")
    push_r(a, rbx)
    mov_rr(a, rbx, rax)
    call_to(a, "rt_dict_find")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, exists)
    load(a, rcx, mem(rbx, 8)) # room for another entry?
    alu_load(a, "cmp", rcx, mem(rbx, 16))
    jcc(a, cc_b, entries_room)
    push_r(a, rdx)
    push_r(a, rsi)
    push_r(a, rdi)
    load(a, rcx, mem(rbx, 16))
    alu(a, "add", rcx, rcx)
    store(a, mem(rbx, 16), rcx)
    imul_ri(a, rcx, rcx, 24)
    call_to(a, "rt_alloc")
    mov_rr(a, rdi, rax)
    load(a, rsi, mem(rbx, 24))
    load(a, rcx, mem(rbx, 8))
    imul_ri(a, rcx, rcx, 3)
    rep_movsq(a)
    store(a, mem(rbx, 24), rax)
    pop_r(a, rdi)
    pop_r(a, rsi)
    pop_r(a, rdx)
    mark(a, entries_room)
    load(a, rcx, mem(rbx, 8)) # an index at most half full
    inc_r(a, rcx)
    alu(a, "add", rcx, rcx)
    alu_load(a, "cmp", rcx, mem(rbx, 32))
    jcc(a, cc_be, index_room)
    push_r(a, rdx)
    push_r(a, r8)
    push_r(a, r10)
    mov_rr(a, rax, rbx)
    call_to(a, "rt_dict_reindex")
    pop_r(a, r10)
    pop_r(a, r8)
    pop_r(a, rdx)
    mov_rr(a, rax, rbx)
    call_to(a, "rt_dict_find")
    mark(a, index_room)
    load(a, rcx, mem(rbx, 8))
    mov_rr(a, rax, rcx)
    inc_r(a, rax)
    store(a, mem(r9, 0), rax)
    store(a, mem(rbx, 8), rax)
    imul_ri(a, rcx, rcx, 24)
    alu_load(a, "add", rcx, mem(rbx, 24))
    store(a, mem(rcx, 0), rdx)
    store(a, mem(rcx, 8), r10)
    store(a, mem(rcx, 16), r8)
    load(a, rax, mem(rbx, 0))
    inc_r(a, rax)
    store(a, mem(rbx, 0), rax)
    pop_r(a, rbx)
    ret(a)
    mark(a, exists)
    store(a, mem(rax, 8), r10)
    pop_r(a, rbx)
    ret(a)

    # rt_dict_reindex: rax a dictionary (untagged): an index twice the size, of the entries it has
    set each_entry to new_label(a)
    set indexed to new_label(a)
    set skip_entry to new_label(a)
    set place_entry to new_label(a)
    mark(a, "rt_dict_reindex")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    mov_rr(a, rbx, rax)
    load(a, rcx, mem(rbx, 32))
    alu(a, "add", rcx, rcx)
    store(a, mem(rbx, 32), rcx)
    shifti(a, "shl", rcx, 3)
    call_to(a, "rt_alloc_raw")
    store(a, mem(rbx, 40), rax)
    movi(a, r12, 0)
    mark(a, each_entry)
    alu_load(a, "cmp", r12, mem(rbx, 8))
    jcc(a, cc_ae, indexed)
    mov_rr(a, rax, r12)
    imul_ri(a, rax, rax, 24)
    alu_load(a, "add", rax, mem(rbx, 24))
    movi64(a, rcx, bits_unset)
    alu_load(a, "cmp", rcx, mem(rax, 0))
    jcc(a, cc_e, skip_entry)
    load(a, r13, mem(rax, 16)) # its hash: the first empty slot from there
    load(a, rcx, mem(rbx, 32))
    dec_r(a, rcx)
    alu(a, "and", r13, rcx)
    mark(a, place_entry)
    mov_rr(a, rax, r13)
    shifti(a, "shl", rax, 3)
    alu_load(a, "add", rax, mem(rbx, 40))
    alu_at(a, "cmp", mem(rax, 0), 0)
    set slot_free to new_label(a)
    jcc(a, cc_e, slot_free)
    inc_r(a, r13)
    alu(a, "and", r13, rcx)
    jmp_to(a, place_entry)
    mark(a, slot_free)
    mov_rr(a, rcx, r12)
    inc_r(a, rcx)
    store(a, mem(rax, 0), rcx)
    mark(a, skip_entry)
    inc_r(a, r12)
    jmp_to(a, each_entry)
    mark(a, indexed)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_dict_make: rcx values from rsi up, the last first: keys and values in turn, as a new dictionary in
    # rax; or rax 2 for a key that is neither text nor a number, with it in err_b
    set pairs_loop to new_label(a)
    set pairs_done to new_label(a)
    set bad_pair to new_label(a)
    mark(a, "rt_dict_make")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    mov_rr(a, r12, rcx)
    mov_rr(a, r13, rsi)
    mov_rr(a, rax, rcx)
    shifti(a, "shl", rax, 3)
    alu(a, "add", r13, rax) # just past the first value
    call_to(a, "rt_dict_new")
    mov_rr(a, rbx, rax)
    mark(a, pairs_loop)
    test_rr(a, r12, r12)
    jcc(a, cc_e, pairs_done)
    load(a, rax, mem(r13, -8))
    call_to(a, "rt_key")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, bad_pair)
    load(a, r10, mem(r13, -16))
    mov_rr(a, rax, rbx)
    call_to(a, "rt_dict_set")
    alui(a, "sub", r13, 16)
    alui(a, "sub", r12, 2)
    jmp_to(a, pairs_loop)
    mark(a, pairs_done)
    mov_rr(a, rax, rbx)
    movi64(a, rcx, tag_dict)
    alu(a, "or", rax, rcx)
    movq_xr(a, xmm0, rax)
    movi(a, rax, 0)
    mark(a, bad_pair)
    load(a, rcx, rip("err_b"))
    store(a, rip("err_a"), rcx)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_dict_keys: rax a dictionary (untagged): its keys, in the order they were added, from rdx (rcx of them)
    set keys_loop to new_label(a)
    set keys_done to new_label(a)
    set removed to new_label(a)
    mark(a, "rt_dict_keys")
    push_r(a, rbx)
    push_r(a, r12)
    mov_rr(a, rbx, rax)
    load(a, rcx, mem(rbx, 0))
    shifti(a, "shl", rcx, 3)
    call_to(a, "rt_alloc")
    mov_rr(a, rdi, rax)
    mov_rr(a, r12, rax)
    load(a, rsi, mem(rbx, 24))
    load(a, rcx, mem(rbx, 8))
    movi64(a, r8, bits_unset)
    mark(a, keys_loop)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, keys_done)
    load(a, rax, mem(rsi, 0))
    alu(a, "cmp", rax, r8)
    jcc(a, cc_e, removed)
    store(a, mem(rdi, 0), rax)
    alui(a, "add", rdi, 8)
    mark(a, removed)
    alui(a, "add", rsi, 24)
    dec_r(a, rcx)
    jmp_to(a, keys_loop)
    mark(a, keys_done)
    mov_rr(a, rdx, r12)
    load(a, rcx, mem(rbx, 0))
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_keys: xmm0: `keys of` it, a new list, into xmm0; rax 0, or 2 with it in err_a
    set of_dict to new_label(a)
    mark(a, "rt_keys")
    movsd_store(a, rip("err_a"), xmm0)
    movq_rx(a, rax, xmm0)
    mov_rr(a, rcx, rax)
    shifti(a, "shr", rcx, 48)
    alui(a, "cmp", rcx, kind_dict)
    jcc(a, cc_e, of_dict)
    movi(a, rax, 2)
    ret(a)
    mark(a, of_dict)
    untag(a, rax)
    call_to(a, "rt_dict_keys")
    jmp_to(a, "rt_list_of")

    # rt_list_of: rdx items (rcx of them), which become a list's own, into xmm0; rax is 0
    set enough_room to new_label(a)
    mark(a, "rt_list_of")
    push_r(a, rbx)
    mov_rr(a, rbx, rcx)
    movi(a, rcx, 24)
    call_to(a, "rt_alloc")
    store(a, mem(rax, 0), rbx)
    store(a, mem(rax, 16), rdx)
    alui(a, "cmp", rbx, 1)
    jcc(a, cc_ae, enough_room) # a list with room for none would never grow
    movi(a, rbx, 1)
    push_r(a, rax)
    movi(a, rcx, 8)
    call_to(a, "rt_alloc")
    mov_rr(a, rdx, rax)
    pop_r(a, rax)
    store(a, mem(rax, 16), rdx)
    mark(a, enough_room)
    store(a, mem(rax, 8), rbx)
    movi64(a, rcx, tag_list)
    alu(a, "or", rax, rcx)
    movq_xr(a, xmm0, rax)
    pop_r(a, rbx)
    movi(a, rax, 0)
    ret(a)

    # rt_remove: `remove xmm0 from xmm1`: rax 0, or 2 with err_why (9: not a dictionary; 8: a bad key;
    # 7: no such key), err_a the dictionary and err_b the key
    set is_dict to new_label(a)
    set key_ok to new_label(a)
    set gone to new_label(a)
    mark(a, "rt_remove")
    movsd_store(a, rip("err_a"), xmm1)
    movsd_store(a, rip("err_b"), xmm0)
    movq_rx(a, rax, xmm1)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_dict)
    jcc(a, cc_e, is_dict)
    storei(a, rip("err_why"), 9)
    movi(a, rax, 2)
    ret(a)
    mark(a, is_dict)
    movq_rx(a, rax, xmm0)
    call_to(a, "rt_key")
    test_rr(a, rax, rax)
    jcc(a, cc_e, key_ok)
    storei(a, rip("err_why"), 8)
    movi(a, rax, 2)
    ret(a)
    mark(a, key_ok)
    load(a, rax, rip("err_a"))
    untag(a, rax)
    push_r(a, rax)
    call_to(a, "rt_dict_find")
    pop_r(a, rcx)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, gone)
    storei(a, rip("err_why"), 7)
    movi(a, rax, 2)
    ret(a)
    mark(a, gone)
    movi64(a, rdx, bits_unset)
    store(a, mem(rax, 0), rdx)
    load(a, rax, mem(rcx, 0))
    dec_r(a, rax)
    store(a, mem(rcx, 0), rax)
    movi(a, rax, 0)
    ret(a)

    # rt_why_key: 7: no such key, with the closest text key; 8: a bad key; 9: not a dictionary
    set why_8 to new_label(a)
    set why_9 to new_label(a)
    set no_suggestion to new_label(a)
    mark(a, "rt_why_key")
    load(a, rax, rip("err_why"))
    alui(a, "cmp", rax, 8)
    jcc(a, cc_e, why_8)
    alui(a, "cmp", rax, 9)
    jcc(a, cc_e, why_9)
    b_text(a, "there is no ")
    load(a, rax, rip("err_b"))
    movi(a, rdx, 1)
    call_to(a, "rt_b_value")
    b_text(a, " in this dictionary")
    load(a, rax, rip("err_b")) # text: its closest text key
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_text)
    jcc(a, cc_ne, no_suggestion)
    load(a, rax, rip("err_a"))
    untag(a, rax)
    call_to(a, "rt_dict_keys")
    mov_rr(a, rsi, rdx) # just the text ones, untagged
    mov_rr(a, rdi, rdx)
    mov_rr(a, r9, rcx)
    movi(a, r10, 0)
    set filter_loop to new_label(a)
    set filtered to new_label(a)
    set not_text to new_label(a)
    mark(a, filter_loop)
    test_rr(a, r9, r9)
    jcc(a, cc_e, filtered)
    load(a, rax, mem(rsi, 0))
    mov_rr(a, r8, rax)
    shifti(a, "shr", r8, 48)
    alui(a, "cmp", r8, kind_text)
    jcc(a, cc_ne, not_text)
    untag(a, rax)
    store(a, mem(rdi, 0), rax)
    alui(a, "add", rdi, 8)
    inc_r(a, r10)
    mark(a, not_text)
    alui(a, "add", rsi, 8)
    dec_r(a, r9)
    jmp_to(a, filter_loop)
    mark(a, filtered)
    mov_rr(a, rsi, rdx)
    mov_rr(a, rcx, r10)
    load(a, rdx, rip("err_b"))
    untag(a, rdx)
    call_to(a, "rt_closest")
    test_rr(a, rax, rax)
    jcc(a, cc_e, no_suggestion)
    push_r(a, rax)
    b_text(a, ". Did you mean ")
    pop_r(a, rax)
    movi64(a, rcx, tag_text)
    alu(a, "or", rax, rcx)
    movi(a, rdx, 1)
    call_to(a, "rt_b_value")
    b_text(a, "?")
    mark(a, no_suggestion)
    ret(a)
    mark(a, why_8)
    b_text(a, "a dictionary's keys are text or numbers, not ")
    load(a, rax, rip("err_b"))
    jmp_to(a, "rt_e_kind")
    mark(a, why_9)
    b_text(a, "can only remove from a dictionary, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")

    emit_closest(a)
end

# the field's name in err_field goes in the builder
to field_name with a
    load(a, rax, rip("err_field"))
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    call_to(a, "rt_b_bytes")
end

# ---------- the runtime: the name a misspelled one most likely meant ----------

# rt_closest: rdx a text (untagged), rsi texts (untagged, rcx of them): the one it's closest to, in rax, or
# 0 if none is close: 1 edit for 3 UTF-16 units or fewer, else 2, counting a swap of two neighbours as one
to emit_closest with a
    set each_one to new_label(a)
    set done to new_label(a)
    set not_better to new_label(a)
    set short to new_label(a)
    mark(a, "rt_closest")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    mov_rr(a, r12, rsi)
    mov_rr(a, r13, rcx)
    mov_rr(a, rax, rdx)
    call_to(a, "rt_utf16")
    store(a, rip("cl_a"), rax)
    store(a, rip("cl_n"), rcx)
    movi(a, rbx, 2) # the best distance so far, plus one
    alui(a, "cmp", rcx, 3)
    jcc(a, cc_be, short)
    movi(a, rbx, 3)
    mark(a, short)
    movi(a, r14, 0)
    mark(a, each_one)
    test_rr(a, r13, r13)
    jcc(a, cc_e, done)
    load(a, rax, mem(r12, 0))
    call_to(a, "rt_utf16")
    store(a, rip("cl_b"), rax)
    store(a, rip("cl_m"), rcx)
    call_to(a, "rt_distance")
    alu(a, "cmp", rax, rbx)
    jcc(a, cc_ae, not_better)
    mov_rr(a, rbx, rax)
    load(a, r14, mem(r12, 0))
    mark(a, not_better)
    alui(a, "add", r12, 8)
    dec_r(a, r13)
    jmp_to(a, each_one)
    mark(a, done)
    mov_rr(a, rax, r14)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_utf16: rax a text (untagged): its UTF-16 units, 8 bytes each, from rax, rcx of them
    set units_loop to new_label(a)
    set units_done to new_label(a)
    set one_unit to new_label(a)
    mark(a, "rt_utf16")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    mov_rr(a, rbx, rax)
    load(a, rcx, mem(rbx, 0))
    shifti(a, "shl", rcx, 4)
    call_to(a, "rt_alloc")
    mov_rr(a, r12, rax)
    mov_rr(a, rdi, rax)
    load(a, rsi, mem(rbx, 16))
    load(a, r13, mem(rbx, 0))
    alu(a, "add", r13, rsi)
    mark(a, units_loop)
    alu(a, "cmp", rsi, r13)
    jcc(a, cc_ae, units_done)
    push_r(a, rdi)
    call_to(a, "rt_decode")
    pop_r(a, rdi)
    char_size(a)
    alu(a, "add", rsi, rdx)
    alui(a, "cmp", rax, 0x10000)
    jcc(a, cc_b, one_unit)
    alui(a, "sub", rax, 0x10000) # two units: the high and low surrogates
    mov_rr(a, rcx, rax)
    shifti(a, "shr", rcx, 10)
    alui(a, "add", rcx, 0xD800)
    store(a, mem(rdi, 0), rcx)
    alui(a, "add", rdi, 8)
    alui(a, "and", rax, 0x3FF)
    alui(a, "add", rax, 0xDC00)
    mark(a, one_unit)
    store(a, mem(rdi, 0), rax)
    alui(a, "add", rdi, 8)
    jmp_to(a, units_loop)
    mark(a, units_done)
    mov_rr(a, rcx, rdi)
    alu(a, "sub", rcx, r12)
    shifti(a, "shr", rcx, 3)
    mov_rr(a, rax, r12)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_distance: the edits from the units at cl_a (cl_n of them) to those at cl_b (cl_m), in rax
    set rows to new_label(a)
    set cols to new_label(a)
    set row_loop to new_label(a)
    set col_loop to new_label(a)
    set col_done to new_label(a)
    set row_done to new_label(a)
    set no_swap to new_label(a)
    mark(a, "rt_distance")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    load(a, rcx, rip("cl_n")) # a table of (n + 1) rows of (m + 1)
    inc_r(a, rcx)
    load(a, rax, rip("cl_m"))
    inc_r(a, rax)
    store(a, rip("cl_w"), rax)
    imul_rr(a, rcx, rax)
    shifti(a, "shl", rcx, 3)
    call_to(a, "rt_alloc_raw")
    store(a, rip("cl_d"), rax)
    movi(a, r12, 0) # d[i][0] = i
    mark(a, rows)
    alu_load(a, "cmp", r12, rip("cl_n"))
    jcc(a, cc_a, cols)
    mov_rr(a, rax, r12)
    movi(a, rdx, 0)
    cell_at(a)
    store(a, mem(rax, 0), r12)
    inc_r(a, r12)
    jmp_to(a, rows)
    mark(a, cols)
    movi(a, r13, 0) # d[0][j] = j
    set cols_loop to new_label(a)
    set cols_done to new_label(a)
    mark(a, cols_loop)
    alu_load(a, "cmp", r13, rip("cl_m"))
    jcc(a, cc_a, cols_done)
    movi(a, rax, 0)
    mov_rr(a, rdx, r13)
    cell_at(a)
    store(a, mem(rax, 0), r13)
    inc_r(a, r13)
    jmp_to(a, cols_loop)
    mark(a, cols_done)
    movi(a, r12, 1)
    mark(a, row_loop)
    alu_load(a, "cmp", r12, rip("cl_n"))
    jcc(a, cc_a, row_done)
    movi(a, r13, 1)
    mark(a, col_loop)
    alu_load(a, "cmp", r13, rip("cl_m"))
    jcc(a, cc_a, col_done)
    unit_of(a, "cl_a", r12, 1, r8) # a[i - 1]
    unit_of(a, "cl_b", r13, 1, r9) # b[j - 1]
    movi(a, r10, 0) # the cost of changing one into the other
    alu(a, "cmp", r8, r9)
    set same_unit to new_label(a)
    jcc(a, cc_e, same_unit)
    movi(a, r10, 1)
    mark(a, same_unit)
    mov_rr(a, rax, r12) # d[i - 1][j - 1] + cost
    dec_r(a, rax)
    mov_rr(a, rdx, r13)
    dec_r(a, rdx)
    cell_at(a)
    load(a, r14, mem(rax, 0))
    alu(a, "add", r14, r10)
    mov_rr(a, rax, r12) # d[i - 1][j] + 1
    dec_r(a, rax)
    mov_rr(a, rdx, r13)
    cell_at(a)
    load(a, rbx, mem(rax, 0))
    inc_r(a, rbx)
    min_into(a, r14, rbx)
    mov_rr(a, rax, r12) # d[i][j - 1] + 1
    mov_rr(a, rdx, r13)
    dec_r(a, rdx)
    cell_at(a)
    load(a, rbx, mem(rax, 0))
    inc_r(a, rbx)
    min_into(a, r14, rbx)
    alui(a, "cmp", r12, 1) # a swap of two neighbours
    jcc(a, cc_be, no_swap)
    alui(a, "cmp", r13, 1)
    jcc(a, cc_be, no_swap)
    unit_of(a, "cl_b", r13, 2, r10) # a[i - 1] is b[j - 2]
    alu(a, "cmp", r8, r10)
    jcc(a, cc_ne, no_swap)
    unit_of(a, "cl_a", r12, 2, r10) # and a[i - 2] is b[j - 1]
    alu(a, "cmp", r10, r9)
    jcc(a, cc_ne, no_swap)
    mov_rr(a, rax, r12)
    alui(a, "sub", rax, 2)
    mov_rr(a, rdx, r13)
    alui(a, "sub", rdx, 2)
    cell_at(a)
    load(a, rbx, mem(rax, 0))
    inc_r(a, rbx)
    min_into(a, r14, rbx)
    mark(a, no_swap)
    mov_rr(a, rax, r12)
    mov_rr(a, rdx, r13)
    cell_at(a)
    store(a, mem(rax, 0), r14)
    inc_r(a, r13)
    jmp_to(a, col_loop)
    mark(a, col_done)
    inc_r(a, r12)
    jmp_to(a, row_loop)
    mark(a, row_done)
    load(a, rax, rip("cl_n"))
    load(a, rdx, rip("cl_m"))
    cell_at(a)
    load(a, rax, mem(rax, 0))
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
end

# rax gets where d[rax][rdx] is in the table at cl_d, whose rows are cl_w long; uses rcx
to cell_at with a
    load(a, rcx, rip("cl_w"))
    imul_rr(a, rax, rcx)
    alu(a, "add", rax, rdx)
    shifti(a, "shl", rax, 3)
    alu_load(a, "add", rax, rip("cl_d"))
end

# register into gets unit k - back of the units at `units`, k in register r
to unit_of with a, units, r, back, into
    mov_rr(a, into, r)
    alui(a, "sub", into, back)
    shifti(a, "shl", into, 3)
    alu_load(a, "add", into, rip(units))
    load(a, into, mem(into, 0))
end

# register x gets the smaller of x and y
to min_into with a, x, y
    set kept to new_label(a)
    alu(a, "cmp", x, y)
    jcc(a, cc_be, kept)
    mov_rr(a, x, y)
    mark(a, kept)
end

# ---------- the runtime: bytes, and the helpers ----------
# Bytes are 16 bytes: how many, and where they are. Each helper takes its inputs in xmm0 and xmm1 and gives
# what it makes in xmm0, with rax 0; or rax 2 for a mistake, with err_why saying which (see rt_why_builtin),
# err_a and err_b the values, and err_what the helper's name, as its messages say it.

to emit_builtins with a
    # rt_bytes_new: rcx bytes, all 0, untagged in rax
    mark(a, "rt_bytes_new")
    push_r(a, rbx)
    mov_rr(a, rbx, rcx)
    movi(a, rcx, 16)
    call_to(a, "rt_alloc")
    store(a, mem(rax, 0), rbx)
    push_r(a, rax)
    mov_rr(a, rcx, rbx)
    call_to(a, "rt_alloc_raw")
    mov_rr(a, rcx, rax)
    pop_r(a, rax)
    store(a, mem(rax, 8), rcx)
    pop_r(a, rbx)
    ret(a)

    # rt_need_text: xmm register x must be text, or it is mistake 10 for the helper named r8
    # (written inline by need_text)

    # rt_bits: xmm1, as `bit and` and the others want it: a whole number from 0 to 2^53 - 1, to 15 digits,
    # in rcx with rax 0; or rax 2 (err_why 11 or 12) for the helper named r8
    set bad to new_label(a)
    set too_many to new_label(a)
    set whole to new_label(a)
    set fine to new_label(a)
    mark(a, "rt_bits")
    movsd_store(a, rip("err_a"), xmm1)
    store(a, rip("err_what"), r8)
    odd_jump(a, xmm1, bad)
    finite_jump(a, xmm1, bad)
    movq_rx(a, rax, xmm1)
    test_rr(a, rax, rax)
    jcc(a, cc_s, whole) # below 0: whole or not, a mistake (but -0 is 0)
    is_whole(a, xmm1, whole)
    movapd(a, xmm0, xmm1)
    call_to(a, "rt_canon_int")
    test_rr(a, rax, rax)
    jcc(a, cc_e, bad)
    cvtsi2sd(a, xmm1, rcx)
    movsd_store(a, rip("err_b"), xmm1)
    jmp_to(a, fine)
    mark(a, whole)
    movsd_load(a, xmm1, rip("err_a"))
    movsd_store(a, rip("err_b"), xmm1)
    movi(a, rax, 0)
    movq_xr(a, xmm2, rax)
    ucomisd(a, xmm1, reg_at(xmm2))
    jcc(a, cc_b, bad)
    is_whole(a, xmm1, fine)
    jmp_to(a, bad)
    mark(a, fine) # xmm1 and err_b: the whole number
    ucomisd(a, xmm1, rip(number_place(a, double_bytes(9007199254740991))))
    jcc(a, cc_a, too_many)
    cvttsd2si(a, rcx, xmm1)
    movi(a, rax, 0)
    ret(a)
    mark(a, bad)
    storei(a, rip("err_why"), 11)
    movi(a, rax, 2)
    ret(a)
    mark(a, too_many)
    storei(a, rip("err_why"), 12)
    movi(a, rax, 2)
    ret(a)

    # `bit and`, `bit or`, `bit xor`
    for each op in list of "and", "or", "xor"
        set fail_first to new_label(a)
        mark(a, "rt_bit_" + op)
        movsd_store(a, rip("keep"), xmm1)
        movapd(a, xmm1, xmm0)
        lea(a, r8, rip(text_object(a, "'bit " + op + "'")))
        call_to(a, "rt_bits")
        test_rr(a, rax, rax)
        jcc(a, cc_ne, fail_first)
        push_r(a, rcx)
        movsd_load(a, xmm1, rip("keep"))
        lea(a, r8, rip(text_object(a, "'bit " + op + "'")))
        call_to(a, "rt_bits")
        pop_r(a, rdx)
        test_rr(a, rax, rax)
        jcc(a, cc_ne, fail_first)
        alu(a, op, rdx, rcx)
        cvtsi2sd(a, xmm0, rdx)
        mark(a, fail_first)
        ret(a)
    end

    # `shift x left by n`, `shift x right by n`
    for each way in list of "left", "right"
        set out to new_label(a)
        set big_shift to new_label(a)
        set zero_x to new_label(a)
        mark(a, "rt_shift_" + way)
        movsd_store(a, rip("keep"), xmm1)
        movapd(a, xmm1, xmm0)
        lea(a, r8, rip(text_object(a, "'shift'")))
        call_to(a, "rt_bits")
        test_rr(a, rax, rax)
        jcc(a, cc_ne, out)
        push_r(a, rcx)
        movsd_store(a, rip("keep2"), xmm1)
        movsd_load(a, xmm1, rip("keep"))
        lea(a, r8, rip(text_object(a, "'shift ... by'")))
        call_to(a, "rt_bits")
        pop_r(a, rdx) # rdx the number, rcx how far
        test_rr(a, rax, rax)
        jcc(a, cc_ne, out)
        if way is "right"
            alui(a, "cmp", rcx, 63)
            jcc(a, cc_a, big_shift)
            shift_cl(a, "shr", rdx)
            cvtsi2sd(a, xmm0, rdx)
            movi(a, rax, 0)
            ret(a)
            mark(a, big_shift)
            movi(a, rax, 0)
            movq_xr(a, xmm0, rax)
            ret(a)
        else
            test_rr(a, rdx, rdx)
            jcc(a, cc_e, zero_x)
            alui(a, "cmp", rcx, 53) # past 2^53 - 1: a mistake
            jcc(a, cc_ae, big_shift)
            mov_rr(a, rax, rdx)
            shift_cl(a, "shl", rax)
            mov_rr(a, r8, rax)
            shift_cl(a, "shr", r8)
            alu(a, "cmp", r8, rdx)
            jcc(a, cc_ne, big_shift)
            movi64(a, r8, bytes_of(9007199254740991))
            alu(a, "cmp", rax, r8)
            jcc(a, cc_a, big_shift)
            cvtsi2sd(a, xmm0, rax)
            movi(a, rax, 0)
            ret(a)
            mark(a, zero_x)
            movi(a, rax, 0)
            movq_xr(a, xmm0, rax)
            ret(a)
            mark(a, big_shift)
            movsd_load(a, xmm0, rip("keep2"))
            movsd_store(a, rip("err_a"), xmm0)
            movsd_store(a, rip("err_b"), xmm1)
            storei(a, rip("err_why"), 13)
            movi(a, rax, 2)
        end
        mark(a, out)
        ret(a)
    end

    # `position of part in whole`: where part first is, counted in characters from 1, or 0
    set found to new_label(a)
    set none to new_label(a)
    set start_at to new_label(a)
    mark(a, "rt_position")
    need_text(a, xmm0, "'position of'")
    need_text(a, xmm1, "'position of ... in'")
    movq_rx(a, r8, xmm0)
    untag(a, r8)
    movq_rx(a, r9, xmm1)
    untag(a, r9)
    load(a, r10, mem(r9, 0))
    alu_load(a, "sub", r10, mem(r8, 0))
    jcc(a, cc_b, none)
    movi(a, r11, 0)
    mark(a, start_at)
    alu(a, "cmp", r11, r10)
    jcc(a, cc_a, none)
    load(a, rcx, mem(r8, 0))
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, found)
    load(a, rsi, mem(r9, 16))
    alu(a, "add", rsi, r11)
    load(a, rdi, mem(r8, 16))
    raw(a, list of 0xF3, 0xA6)
    jcc(a, cc_e, found)
    inc_r(a, r11)
    jmp_to(a, start_at)
    mark(a, found) # the characters before it, plus one
    load(a, rsi, mem(r9, 16))
    mov_rr(a, rcx, r11)
    call_to(a, "rt_b_chars")
    inc_r(a, rax)
    cvtsi2sd(a, xmm0, rax)
    movi(a, rax, 0)
    ret(a)
    mark(a, none)
    movi(a, rax, 0)
    movq_xr(a, xmm0, rax)
    ret(a)

    # `split text by by`: the pieces between each by, or with by "" each character
    set by_chars to new_label(a)
    set scan to new_label(a)
    set cut to new_label(a)
    set last_piece to new_label(a)
    set next_byte to new_label(a)
    mark(a, "rt_split")
    need_text(a, xmm0, "'split'")
    need_text(a, xmm1, "'split ... by'")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    movq_rx(a, rbx, xmm0)
    untag(a, rbx)
    movq_rx(a, r12, xmm1)
    untag(a, r12)
    alu_at(a, "cmp", mem(r12, 0), 0)
    jcc(a, cc_e, by_chars)
    movi(a, rsi, 0) # a new list
    movi(a, rcx, 0)
    call_to(a, "rt_list_make")
    store(a, rip("split_list"), rax)
    movi(a, r13, 0) # where this piece starts
    movi(a, r14, 0) # where to look for `by`
    mark(a, scan)
    load(a, rax, mem(rbx, 0))
    alu_load(a, "sub", rax, mem(r12, 0))
    alu(a, "cmp", r14, rax)
    jcc(a, cc_g, last_piece)
    load(a, rsi, mem(rbx, 16))
    alu(a, "add", rsi, r14)
    load(a, rdi, mem(r12, 16))
    load(a, rcx, mem(r12, 0))
    raw(a, list of 0xF3, 0xA6)
    jcc(a, cc_e, cut)
    mark(a, next_byte)
    inc_r(a, r14)
    jmp_to(a, scan)
    mark(a, cut)
    split_piece(a, rbx, r13, r14)
    mov_rr(a, r13, r14)
    alu_load(a, "add", r13, mem(r12, 0))
    mov_rr(a, r14, r13)
    jmp_to(a, scan)
    mark(a, last_piece)
    load(a, r14, mem(rbx, 0))
    split_piece(a, rbx, r13, r14)
    load(a, rax, rip("split_list"))
    movq_xr(a, xmm0, rax)
    set split_done to new_label(a)
    jmp_to(a, split_done)
    mark(a, by_chars)
    movq_xr(a, xmm0, rbx)
    movq_rx(a, rax, xmm0)
    movi64(a, rcx, tag_text)
    alu(a, "or", rax, rcx)
    movq_xr(a, xmm0, rax)
    call_to(a, "rt_items")
    call_to(a, "rt_list_of")
    mark(a, split_done)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    movi(a, rax, 0)
    ret(a)

    # `join list with by`: each item shown, with by between them
    set not_list to new_label(a)
    set joining to new_label(a)
    set joined to new_label(a)
    set no_by to new_label(a)
    mark(a, "rt_join_list")
    movq_rx(a, rax, xmm0)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_list)
    jcc(a, cc_ne, not_list)
    need_text(a, xmm1, "'join ... with'")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    movq_rx(a, rbx, xmm0)
    untag(a, rbx)
    movq_rx(a, r12, xmm1)
    untag(a, r12)
    call_to(a, "rt_b_reset")
    movi(a, r13, 0)
    mark(a, joining)
    alu_load(a, "cmp", r13, mem(rbx, 0))
    jcc(a, cc_ae, joined)
    test_rr(a, r13, r13)
    jcc(a, cc_e, no_by)
    load(a, rcx, mem(r12, 0))
    load(a, rsi, mem(r12, 16))
    call_to(a, "rt_b_bytes")
    mark(a, no_by)
    load(a, rax, mem(rbx, 16))
    mov_rr(a, rcx, r13)
    shifti(a, "shl", rcx, 3)
    alu(a, "add", rax, rcx)
    load(a, rax, mem(rax, 0))
    set shown_item to new_label(a)
    set next_item to new_label(a)
    mov_rr(a, rdx, rax) # text, as it is
    shifti(a, "shr", rdx, 48)
    alui(a, "cmp", rdx, kind_text)
    jcc(a, cc_ne, shown_item)
    untag(a, rax)
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    call_to(a, "rt_b_bytes")
    jmp_to(a, next_item)
    mark(a, shown_item)
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    mark(a, next_item)
    inc_r(a, r13)
    jmp_to(a, joining)
    mark(a, joined)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    call_to(a, "rt_b_fits")
    test_rr(a, rax, rax)
    set fits to new_label(a)
    jcc(a, cc_e, fits)
    storei(a, rip("err_why"), 19)
    movi(a, rax, 2)
    ret(a)
    mark(a, fits)
    call_to(a, "rt_b_text")
    movq_xr(a, xmm0, rax)
    movi(a, rax, 0)
    ret(a)
    mark(a, not_list)
    movsd_store(a, rip("err_a"), xmm0)
    storei(a, rip("err_why"), 14)
    movi(a, rax, 2)
    ret(a)

    # `number of`: a number is itself; text that reads as one, as JavaScript's Number() reads Moth's
    # numbers: space either side, maybe a minus, digits, maybe a point and digits
    set not_number to new_label(a)
    mark(a, "rt_number")
    odd_jump(a, xmm0, "rt_number_odd")
    movi(a, rax, 0)
    ret(a)
    mark(a, "rt_number_odd")
    movsd_store(a, rip("err_a"), xmm0)
    if units of a # an amount: the number alone
        set not_amount to new_label(a)
        movq_rx(a, rax, xmm0)
        shifti(a, "shr", rax, 48)
        alui(a, "cmp", rax, kind_quantity)
        jcc(a, cc_ne, not_amount)
        movq_rx(a, rax, xmm0)
        untag(a, rax)
        movsd_load(a, xmm0, mem(rax, 0))
        movi(a, rax, 0)
        ret(a)
        mark(a, not_amount)
    end
    need_text(a, xmm0, "'number of'")
    movq_rx(a, rax, xmm0)
    untag(a, rax)
    call_to(a, "rt_parse_number")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, not_number)
    movi(a, rax, 0)
    ret(a)
    mark(a, not_number)
    storei(a, rip("err_why"), 15)
    movi(a, rax, 2)
    ret(a)

    # `n bytes`: that many, all 0
    set count_ok to new_label(a)
    set bad_count to new_label(a)
    set huge_count to new_label(a)
    mark(a, "rt_bytes_of")
    movsd_store(a, rip("err_a"), xmm0)
    odd_jump(a, xmm0, bad_count)
    finite_jump(a, xmm0, bad_count)
    movq_rx(a, rax, xmm0)
    test_rr(a, rax, rax)
    set signed to new_label(a)
    jcc(a, cc_s, signed)
    is_whole(a, xmm0, count_ok)
    call_to(a, "rt_canon_int")
    test_rr(a, rax, rax)
    jcc(a, cc_e, bad_count)
    cvtsi2sd(a, xmm0, rcx)
    jmp_to(a, count_ok)
    mark(a, signed)
    movi(a, rax, 0)
    movq_xr(a, xmm1, rax)
    ucomisd(a, xmm0, reg_at(xmm1))
    jcc(a, cc_b, bad_count)
    is_whole(a, xmm0, count_ok)
    jmp_to(a, bad_count)
    mark(a, count_ok)
    ucomisd(a, xmm0, rip(number_place(a, double_bytes(4294967296))))
    jcc(a, cc_a, huge_count)
    cvttsd2si(a, rcx, xmm0)
    call_to(a, "rt_bytes_new")
    movi64(a, rcx, tag_bytes)
    alu(a, "or", rax, rcx)
    movq_xr(a, xmm0, rax)
    movi(a, rax, 0)
    ret(a)
    mark(a, bad_count)
    storei(a, rip("err_why"), 16)
    movi(a, rax, 2)
    ret(a)
    mark(a, huge_count)
    storei(a, rip("err_why"), 19)
    movi(a, rax, 2)
    ret(a)

    # `as bytes`: text's UTF-8, a copy of bytes, or a list of bytes
    set from_text to new_label(a)
    set from_bytes to new_label(a)
    set from_list to new_label(a)
    set copy_into to new_label(a)
    set list_loop to new_label(a)
    set list_done to new_label(a)
    set bad_source to new_label(a)
    mark(a, "rt_as_bytes")
    movq_rx(a, rax, xmm0)
    mov_rr(a, rdx, rax)
    shifti(a, "shr", rdx, 48)
    untag(a, rax)
    alui(a, "cmp", rdx, kind_text)
    jcc(a, cc_e, from_text)
    alui(a, "cmp", rdx, kind_bytes)
    jcc(a, cc_e, from_bytes)
    alui(a, "cmp", rdx, kind_list)
    jcc(a, cc_e, from_list)
    jmp_to(a, bad_source)
    mark(a, from_text) # text and bytes alike: how many, and where
    load(a, rsi, mem(rax, 16))
    jmp_to(a, copy_into)
    mark(a, from_bytes)
    load(a, rsi, mem(rax, 8))
    mark(a, copy_into)
    push_r(a, rsi)
    load(a, rcx, mem(rax, 0))
    push_r(a, rcx)
    call_to(a, "rt_bytes_new")
    pop_r(a, rcx)
    pop_r(a, rsi)
    load(a, rdi, mem(rax, 8))
    rep_movsb(a)
    movi64(a, rcx, tag_bytes)
    alu(a, "or", rax, rcx)
    movq_xr(a, xmm0, rax)
    movi(a, rax, 0)
    ret(a)
    mark(a, from_list)
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    mov_rr(a, rbx, rax)
    load(a, rcx, mem(rbx, 0))
    call_to(a, "rt_bytes_new")
    mov_rr(a, r12, rax)
    movi(a, r13, 0)
    mark(a, list_loop)
    alu_load(a, "cmp", r13, mem(rbx, 0))
    jcc(a, cc_ae, list_done)
    load(a, rax, mem(rbx, 16))
    mov_rr(a, rcx, r13)
    shifti(a, "shl", rcx, 3)
    alu(a, "add", rax, rcx)
    movsd_load(a, xmm2, mem(rax, 0))
    call_to(a, "rt_byte")
    test_rr(a, rax, rax)
    set list_bad to new_label(a)
    jcc(a, cc_ne, list_bad)
    load(a, rax, mem(r12, 8))
    alu(a, "add", rax, r13)
    store8(a, mem(rax, 0), rcx)
    inc_r(a, r13)
    jmp_to(a, list_loop)
    mark(a, list_done)
    mov_rr(a, rax, r12)
    movi64(a, rcx, tag_bytes)
    alu(a, "or", rax, rcx)
    movq_xr(a, xmm0, rax)
    movi(a, rax, 0)
    mark(a, list_bad)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
    mark(a, bad_source)
    movsd_store(a, rip("err_a"), xmm0)
    storei(a, rip("err_why"), 18)
    movi(a, rax, 2)
    ret(a)

    # rt_byte: xmm2 as a byte, a whole number from 0 to 255 to 15 digits, in rcx with rax 0; or rax 2 (17)
    set byte_bad to new_label(a)
    set byte_whole to new_label(a)
    set byte_ok to new_label(a)
    mark(a, "rt_byte")
    movsd_store(a, rip("err_a"), xmm2)
    odd_jump(a, xmm2, byte_bad)
    finite_jump(a, xmm2, byte_bad)
    movq_rx(a, rax, xmm2)
    test_rr(a, rax, rax)
    jcc(a, cc_s, byte_whole)
    is_whole(a, xmm2, byte_whole)
    movapd(a, xmm0, xmm2)
    call_to(a, "rt_canon_int")
    test_rr(a, rax, rax)
    jcc(a, cc_e, byte_bad)
    cvtsi2sd(a, xmm2, rcx)
    jmp_to(a, byte_ok)
    mark(a, byte_whole)
    movsd_load(a, xmm2, rip("err_a"))
    is_whole(a, xmm2, byte_ok)
    jmp_to(a, byte_bad)
    mark(a, byte_ok)
    ucomisd(a, xmm2, rip(number_place(a, double_bytes(0))))
    jcc(a, cc_b, byte_bad)
    ucomisd(a, xmm2, rip(number_place(a, double_bytes(255))))
    jcc(a, cc_a, byte_bad)
    cvttsd2si(a, rcx, xmm2)
    movi(a, rax, 0)
    ret(a)
    mark(a, byte_bad)
    storei(a, rip("err_why"), 17)
    movi(a, rax, 2)
    ret(a)

    # `as text`: bytes read as UTF-8, a mistake in it as U+FFFD and a byte order mark at the start dropped;
    # anything else as `say` shows it
    set decode_bytes to new_label(a)
    set not_digits to new_label(a)
    mark(a, "rt_as_text")
    small_digits(a, xmm0, not_digits) # a whole number below 10^15: its digits, written straight out
    load(a, rsi, rip_plus("jn_head", 16))
    load(a, rcx, rip("jn_head"))
    call_to(a, "rt_text_from")
    movq_xr(a, xmm0, rax)
    movi(a, rax, 0)
    ret(a)
    mark(a, not_digits)
    movq_rx(a, rax, xmm0)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_bytes)
    jcc(a, cc_e, decode_bytes)
    call_to(a, "rt_b_reset")
    movq_rx(a, rax, xmm0)
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    set shown_fits to new_label(a)
    call_to(a, "rt_b_fits")
    test_rr(a, rax, rax)
    jcc(a, cc_e, shown_fits)
    storei(a, rip("err_why"), 19)
    movi(a, rax, 2)
    ret(a)
    mark(a, shown_fits)
    call_to(a, "rt_b_text")
    movq_xr(a, xmm0, rax)
    movi(a, rax, 0)
    ret(a)
    mark(a, decode_bytes)
    movq_rx(a, rax, xmm0)
    untag(a, rax)
    call_to(a, "rt_decode_utf8")
    call_to(a, "rt_b_text")
    movq_xr(a, xmm0, rax)
    movi(a, rax, 0)
    ret(a)

    # `as hex`, `as binary`
    for each base in list of 16, 2
        set word to "hex"
        if base is 2
            set word to "binary"
        end
        set digit_loop to new_label(a)
        set digits_out to new_label(a)
        mark(a, "rt_as_" + word)
        movapd(a, xmm1, xmm0)
        lea(a, r8, rip(text_object(a, "'as " + word + "'")))
        call_to(a, "rt_bits")
        test_rr(a, rax, rax)
        jcc(a, cc_ne, digits_out)
        mov_rr(a, rax, rcx)
        lea(a, rdi, rip_plus("dbuf", 64)) # backwards from the end of dbuf, then into the builder
        movi(a, r8, base)
        mark(a, digit_loop)
        movi(a, rdx, 0)
        unary(a, "div", r8)
        mov_rr(a, rcx, rdx)
        alui(a, "add", rcx, 48)
        alui(a, "cmp", rdx, 10)
        set decimal to new_label(a)
        jcc(a, cc_b, decimal)
        alui(a, "add", rcx, 39)
        mark(a, decimal)
        dec_r(a, rdi)
        store8(a, mem(rdi, 0), rcx)
        test_rr(a, rax, rax)
        jcc(a, cc_ne, digit_loop)
        mov_rr(a, rsi, rdi)
        lea(a, rcx, rip_plus("dbuf", 64))
        alu(a, "sub", rcx, rdi)
        call_to(a, "rt_text_from")
        movq_xr(a, xmm0, rax)
        movi(a, rax, 0)
        mark(a, digits_out)
        ret(a)
    end

    emit_utf8(a)
    emit_parse_number(a)

    # rt_why_builtin: what was wrong, from err_why, into the builder
    set w11 to new_label(a)
    set w12 to new_label(a)
    set w13 to new_label(a)
    set w14 to new_label(a)
    set w15 to new_label(a)
    set w16 to new_label(a)
    set w17 to new_label(a)
    set w18 to new_label(a)
    set w19 to new_label(a)
    set w20 to new_label(a)
    set w21 to new_label(a)
    set w22 to new_label(a)
    set w24 to new_label(a)
    set w25 to new_label(a)
    set w26 to new_label(a)
    set w27 to new_label(a)
    set w28 to new_label(a)
    mark(a, "rt_why_builtin")
    load(a, rax, rip("err_why"))
    for each pair in list of (list of 11, w11), (list of 12, w12), (list of 13, w13), (list of 14, w14), (list of 15, w15),
        (list of 16, w16), (list of 17, w17), (list of 18, w18), (list of 19, w19), (list of 20, w20), (list of 21, w21),
        (list of 22, w22), (list of 24, w24), (list of 25, w25), (list of 26, w26), (list of 27, w27), (list of 28, w28)
        alui(a, "cmp", rax, item 1 of pair)
        jcc(a, cc_e, item 2 of pair)
    end
    what_name(a) # 10: needs text
    b_text(a, " needs text, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, w11)
    what_name(a)
    b_text(a, " needs whole numbers of 0 or more, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_described")
    mark(a, w12)
    what_name(a)
    b_text(a, " works on numbers up to 9007199254740991, not ")
    load(a, rax, rip("err_b"))
    movi(a, rdx, 0)
    jmp_to(a, "rt_b_value")
    mark(a, w13)
    load(a, rax, rip("err_a"))
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    b_text(a, " shifted left by ")
    load(a, rax, rip("err_b"))
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    b_text(a, " is too big: bits work on numbers up to 9007199254740991")
    ret(a)
    mark(a, w14)
    b_text(a, "'join' needs a list, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, w15)
    load(a, rax, rip("err_a"))
    movi(a, rdx, 1)
    call_to(a, "rt_b_value")
    b_text(a, " isn't a number")
    ret(a)
    mark(a, w16)
    b_text(a, "'bytes' needs a whole number in front of it, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_described")
    mark(a, w17)
    b_text(a, "a byte is a whole number from 0 to 255, not ")
    load(a, rax, rip("err_a"))
    movi(a, rdx, 1)
    jmp_to(a, "rt_b_value")
    mark(a, w18)
    b_text(a, "'as bytes' needs text, a list or bytes, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, w19)
    b_text(a, too_big)
    ret(a)
    mark(a, w20)
    b_text(a, "'to the power of' needs a number, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, w21)
    b_text(a, "'to the power of' needs a whole number, not ")
    load(a, rax, rip("err_a"))
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    b_text(a, ": math.moth's power(x, y) takes any")
    ret(a)
    mark(a, w22)
    b_text(a, "can't raise 0 to a power below 0")
    ret(a)
    for each pair in list of (list of w24, "'rounded down'"), (list of w25, "'rounded up'"), (list of w26, "'rounded'"),
        (list of w27, "'remainder of'")
        mark(a, item 1 of pair)
        b_text(a, item 2 of pair + " needs a number, not ")
        load(a, rax, rip("err_a"))
        jmp_to(a, "rt_e_kind")
    end
    mark(a, w28)
    b_text(a, "can't divide by zero")
    ret(a)

    # rt_described: rax: a number shown, anything else as its kind
    set as_kind to new_label(a)
    mark(a, "rt_described")
    movq_xr(a, xmm0, rax)
    odd_jump(a, xmm0, as_kind)
    movq_rx(a, rax, xmm0)
    movi(a, rdx, 0)
    jmp_to(a, "rt_b_value")
    mark(a, as_kind)
    movq_rx(a, rax, xmm0)
    jmp_to(a, "rt_e_kind")

    # rt_slice: items xmm1 to xmm2 of xmm0, a list, text or bytes, as vm.js's slice has them: rax 0 with them in
    # xmm0, a new list or bytes, or text that's a view of the same bytes; or 2 with err_why 23 (not a list,
    # text or bytes, err_a) or rt_item's 4 (not a whole number, err_b), 5 (before 1, err_b) or 6 (past the
    # end, err_a, err_b and err_len). Keeps rbx and r12 to r15, rsi and rdi. The frame: the value, to, from's place, to's
    # place, and from as it shows.
    set i_kind_ok to new_label(a)
    set i_not_whole to new_label(a)
    set i_empty to new_label(a)
    set i_before to new_label(a)
    set i_past to new_label(a)
    set i_text to new_label(a)
    set i_bytes to new_label(a)
    set i_out to new_label(a)
    set i_wrong to new_label(a)
    set i_cap to new_label(a)
    set i_ascii to new_label(a)
    set i_viewed to new_label(a)
    set i_empty_text to new_label(a)
    set i_empty_bytes to new_label(a)
    set i_len_text to new_label(a)
    set i_have_len to new_label(a)
    mark(a, "rt_slice")
    for each r in list of rbx, r12, r13, rsi, rdi
        push_r(a, r)
    end
    alui(a, "sub", rsp, 40)
    movsd_store(a, mem(rsp, 0), xmm0)
    movsd_store(a, mem(rsp, 8), xmm2)
    movq_rx(a, rax, xmm0)
    mov_rr(a, rdx, rax)
    shifti(a, "shr", rdx, 48)
    alui(a, "cmp", rdx, kind_list)
    jcc(a, cc_e, i_kind_ok)
    alui(a, "cmp", rdx, kind_text)
    jcc(a, cc_e, i_kind_ok)
    alui(a, "cmp", rdx, kind_bytes)
    jcc(a, cc_e, i_kind_ok)
    movsd_store(a, rip("err_a"), xmm0)
    storei(a, rip("err_why"), 23)
    jmp_to(a, i_wrong)
    mark(a, i_kind_ok)
    movsd_store(a, rip("err_b"), xmm1) # from: a whole number, to 15 digits
    call_to(a, "rt_index")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, i_not_whole)
    store(a, mem(rsp, 16), rcx)
    movsd_store(a, mem(rsp, 32), xmm1) # as it shows, should it be before 1
    movsd_load(a, xmm1, mem(rsp, 8)) # to
    movsd_store(a, rip("err_b"), xmm1)
    call_to(a, "rt_index")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, i_not_whole)
    store(a, mem(rsp, 24), rcx)
    movsd_store(a, mem(rsp, 8), xmm1)
    load(a, r8, mem(rsp, 16))
    alu(a, "cmp", rcx, r8)
    jcc(a, cc_l, i_empty) # to before from: none
    alui(a, "cmp", r8, 1)
    jcc(a, cc_l, i_before)
    load(a, rax, mem(rsp, 0)) # how many it has
    mov_rr(a, rdx, rax)
    shifti(a, "shr", rdx, 48)
    untag(a, rax)
    alui(a, "cmp", rdx, kind_text)
    jcc(a, cc_e, i_len_text)
    load(a, r9, mem(rax, 0))
    jmp_to(a, i_have_len)
    mark(a, i_len_text)
    load(a, r9, mem(rax, 8))
    mark(a, i_have_len)
    alu(a, "cmp", rcx, r9)
    jcc(a, cc_g, i_past)
    mov_rr(a, r12, rcx) # how many it gives
    alu(a, "sub", r12, r8)
    inc_r(a, r12)
    alui(a, "cmp", rdx, kind_text)
    jcc(a, cc_e, i_text)
    alui(a, "cmp", rdx, kind_bytes)
    jcc(a, cc_e, i_bytes)
    movi(a, rcx, 24) # a list: a new one, its items copied
    call_to(a, "rt_alloc")
    mov_rr(a, rbx, rax)
    mov_rr(a, rcx, r12)
    alui(a, "cmp", rcx, 4)
    jcc(a, cc_ae, i_cap)
    movi(a, rcx, 4)
    mark(a, i_cap)
    store(a, mem(rbx, 8), rcx)
    shifti(a, "shl", rcx, 3)
    call_to(a, "rt_alloc")
    store(a, mem(rbx, 16), rax)
    store(a, mem(rbx, 0), r12)
    mov_rr(a, rdi, rax)
    load(a, rsi, mem(rsp, 0))
    untag(a, rsi)
    load(a, rsi, mem(rsi, 16))
    load(a, rax, mem(rsp, 16))
    dec_r(a, rax)
    shifti(a, "shl", rax, 3)
    alu(a, "add", rsi, rax)
    mov_rr(a, rcx, r12)
    rep_movsq(a)
    movi64(a, rcx, tag_list)
    alu(a, "or", rbx, rcx)
    movq_xr(a, xmm0, rbx)
    jmp_to(a, i_out)
    mark(a, i_text) # text: a view of its bytes, from the first letter's first byte to the last's last
    load(a, rax, mem(rsp, 0))
    untag(a, rax)
    load(a, rsi, mem(rax, 16))
    load(a, r13, mem(rax, 0))
    load(a, r8, mem(rsp, 16))
    dec_r(a, r8)
    load(a, r9, mem(rsp, 24))
    alu_load(a, "cmp", r13, mem(rax, 8))
    jcc(a, cc_e, i_ascii) # a byte to a letter
    mov_rr(a, rcx, r8)
    call_to(a, "rt_letter_at")
    mov_rr(a, r8, rax)
    load(a, rcx, mem(rsp, 24))
    call_to(a, "rt_letter_at")
    mov_rr(a, r9, rax)
    mark(a, i_ascii)
    alu(a, "add", rsi, r8)
    mov_rr(a, rbx, r9)
    alu(a, "sub", rbx, r8)
    mark(a, i_viewed)
    movi(a, rcx, 24)
    call_to(a, "rt_alloc")
    store(a, mem(rax, 0), rbx)
    store(a, mem(rax, 8), r12)
    store(a, mem(rax, 16), rsi)
    movi64(a, rcx, tag_text)
    alu(a, "or", rax, rcx)
    movq_xr(a, xmm0, rax)
    jmp_to(a, i_out)
    mark(a, i_bytes) # bytes: new ones, copied
    mov_rr(a, rcx, r12)
    call_to(a, "rt_bytes_new")
    mov_rr(a, rbx, rax)
    load(a, rdi, mem(rbx, 8))
    load(a, rsi, mem(rsp, 0))
    untag(a, rsi)
    load(a, rsi, mem(rsi, 8))
    load(a, rax, mem(rsp, 16))
    dec_r(a, rax)
    alu(a, "add", rsi, rax)
    mov_rr(a, rcx, r12)
    call_to(a, "rt_copy")
    movi64(a, rcx, tag_bytes)
    alu(a, "or", rbx, rcx)
    movq_xr(a, xmm0, rbx)
    jmp_to(a, i_out)
    mark(a, i_empty) # none, of the same kind
    load(a, rax, mem(rsp, 0))
    mov_rr(a, rdx, rax)
    shifti(a, "shr", rdx, 48)
    movi(a, r12, 0)
    alui(a, "cmp", rdx, kind_text)
    jcc(a, cc_e, i_empty_text)
    alui(a, "cmp", rdx, kind_bytes)
    jcc(a, cc_e, i_empty_bytes)
    movi(a, rcx, 0)
    call_to(a, "rt_list_make")
    movq_xr(a, xmm0, rax)
    jmp_to(a, i_out)
    mark(a, i_empty_text)
    untag(a, rax)
    load(a, rsi, mem(rax, 16))
    movi(a, rbx, 0)
    jmp_to(a, i_viewed)
    mark(a, i_empty_bytes)
    movi(a, rcx, 0)
    call_to(a, "rt_bytes_new")
    movi64(a, rcx, tag_bytes)
    alu(a, "or", rax, rcx)
    movq_xr(a, xmm0, rax)
    mark(a, i_out)
    movi(a, rax, 0)
    alui(a, "add", rsp, 40)
    for each r in list of rdi, rsi, r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)
    mark(a, i_not_whole) # err_b, as it was given
    storei(a, rip("err_why"), 4)
    jmp_to(a, i_wrong)
    mark(a, i_before)
    movsd_load(a, xmm1, mem(rsp, 32))
    movsd_store(a, rip("err_b"), xmm1)
    storei(a, rip("err_why"), 5)
    jmp_to(a, i_wrong)
    mark(a, i_past)
    store(a, rip("err_len"), r9)
    movsd_load(a, xmm1, mem(rsp, 8))
    movsd_store(a, rip("err_b"), xmm1)
    movsd_load(a, xmm0, mem(rsp, 0))
    movsd_store(a, rip("err_a"), xmm0)
    storei(a, rip("err_why"), 6)
    mark(a, i_wrong)
    movi(a, rax, 2)
    alui(a, "add", rsp, 40)
    for each r in list of rdi, rsi, r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_letter_at: rsi a text's bytes, r13 how many, rcx a number of letters: where that many letters end,
    # in bytes, in rax (r13 if past them); uses rdx, r10 and r11. It remembers the last it found (la_ptr,
    # la_letters, la_byte: letter la_letters, from 1, starts at byte la_byte) and, for the same bytes and a
    # letter that far or further, counts on from there, as rt_char_at does, so going through a long text a
    # letter at a time takes as long as the text is, not that squared. The collector makes it forget, as a
    # text's bytes may be another's after it.
    set la_seek to new_label(a)
    set la_follow to new_label(a)
    set la_found to new_label(a)
    set la_kept to new_label(a)
    mark(a, "rt_letter_at")
    movi(a, rax, 0)
    movi(a, r10, 0) # letters started
    load(a, r11, rip("la_ptr"))
    alu(a, "cmp", r11, rsi)
    jcc(a, cc_ne, la_seek)
    load(a, r11, rip("la_letters"))
    dec_r(a, r11) # the letters before the one it remembers
    alu(a, "cmp", rcx, r11)
    jcc(a, cc_b, la_seek) # fewer than that: from the start
    load(a, rdx, rip("la_byte"))
    alu(a, "cmp", rdx, r13)
    jcc(a, cc_ae, la_seek) # past this text's end: another, shorter view of the bytes
    mov_rr(a, r10, r11)
    mov_rr(a, rax, rdx)
    mark(a, la_seek)
    alu(a, "cmp", rax, r13)
    jcc(a, cc_ae, la_found)
    mov_rr(a, r11, rsi)
    alu(a, "add", r11, rax)
    load8(a, rdx, mem(r11, 0))
    alui(a, "and", rdx, 0xC0)
    alui(a, "cmp", rdx, 0x80)
    jcc(a, cc_e, la_follow)
    alu(a, "cmp", r10, rcx) # a letter's first byte, past that many: here
    jcc(a, cc_e, la_found)
    inc_r(a, r10)
    mark(a, la_follow)
    inc_r(a, rax)
    jmp_to(a, la_seek)
    mark(a, la_found)
    alu(a, "cmp", rax, r13)
    jcc(a, cc_ae, la_kept) # the end: nothing to remember
    store(a, rip("la_ptr"), rsi)
    lea(a, r11, mem(r10, 1)) # the letter that starts here
    store(a, rip("la_letters"), r11)
    store(a, rip("la_byte"), rax)
    mark(a, la_kept)
    ret(a)

    # rt_why_slice: what was wrong with `items ... of`, into the builder
    set why_items_kind to new_label(a)
    mark(a, "rt_why_slice")
    load(a, rax, rip("err_why"))
    alui(a, "cmp", rax, 23)
    jcc(a, cc_e, why_items_kind)
    jmp_to(a, "rt_why_item")
    mark(a, why_items_kind)
    b_text(a, "can only take items of a list, text or bytes, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")

    # rt_power: xmm0 to the power of xmm1, a whole number to 15 digits (rt_index's), by squaring as vm.js's
    # power does, the same multiplications in the same order; rax 0, or 2 with err_why 20 (not a number,
    # err_a), 21 (not a whole number, err_a) or 22 (0 to a power below 0)
    set p_bad_x to new_label(a)
    set p_bad_n to new_label(a)
    set p_frac to new_label(a)
    set p_zero to new_label(a)
    set p_up to new_label(a)
    set p_loop to new_label(a)
    set p_skip to new_label(a)
    set p_looped to new_label(a)
    set p_done to new_label(a)
    set p_nonzero to new_label(a)
    mark(a, "rt_power")
    special_jump(a, xmm0, p_bad_x)
    pointer_jump(a, xmm0, p_bad_x)
    special_jump(a, xmm1, p_bad_n)
    pointer_jump(a, xmm1, p_bad_n)
    alui(a, "sub", rsp, 16)
    movsd_store(a, mem(rsp, 0), xmm0)
    movsd_store(a, mem(rsp, 8), xmm1) # rt_index doesn't keep it, and a mistake says it
    call_to(a, "rt_index") # rcx the whole number, past 2^62 as 2^62
    movsd_load(a, xmm2, mem(rsp, 0))
    movsd_load(a, xmm1, mem(rsp, 8))
    alui(a, "add", rsp, 16)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, p_frac)
    movapd(a, xmm3, xmm2)
    load_bits(a, xmm0, double_bytes(1))
    mov_rr(a, rdx, rcx)
    mov_rr(a, r8, rcx)
    test_rr(a, r8, r8)
    jcc(a, cc_ns, p_up)
    unary(a, "neg", r8)
    mark(a, p_up)
    test_rr(a, rdx, rdx) # 0 to a power below 0
    jcc(a, cc_ns, p_loop)
    ucomisd(a, xmm3, rip(number_place(a, double_bytes(0))))
    jcc(a, cc_p, p_loop)
    jcc(a, cc_e, p_zero)
    mark(a, p_loop)
    test_rr(a, r8, r8)
    jcc(a, cc_e, p_looped)
    mov_rr(a, r9, r8)
    alui(a, "and", r9, 1)
    jcc(a, cc_e, p_skip)
    sse_math(a, "*", xmm0, reg_at(xmm2))
    mark(a, p_skip)
    shifti(a, "shr", r8, 1)
    test_rr(a, r8, r8)
    jcc(a, cc_e, p_looped)
    sse_math(a, "*", xmm2, reg_at(xmm2))
    jmp_to(a, p_loop)
    mark(a, p_looped)
    test_rr(a, rdx, rdx)
    jcc(a, cc_ns, p_done)
    load_bits(a, xmm1, double_bytes(1))
    sse_math(a, "/", xmm1, reg_at(xmm0))
    movapd(a, xmm0, xmm1)
    mark(a, p_done)
    movi(a, rax, 0)
    ret(a)
    mark(a, p_bad_x)
    movsd_store(a, rip("err_a"), xmm0)
    storei(a, rip("err_why"), 20)
    movi(a, rax, 2)
    ret(a)
    mark(a, p_bad_n)
    movsd_store(a, rip("err_a"), xmm1)
    storei(a, rip("err_why"), 20)
    movi(a, rax, 2)
    ret(a)
    mark(a, p_frac)
    movsd_store(a, rip("err_a"), xmm1)
    storei(a, rip("err_why"), 21)
    movi(a, rax, 2)
    ret(a)
    mark(a, p_zero)
    storei(a, rip("err_why"), 22)
    movi(a, rax, 2)
    ret(a)

    # rt_canon_any: xmm0 to 15 digits, as vm.js's canon: a whole number, an infinity or NaN is itself, and
    # anything else keeps its sign; uses rax, rcx, xmm4, and what rt_canon_double does
    set c_same to new_label(a)
    mark(a, "rt_canon_any")
    ucomisd(a, xmm0, reg_at(xmm0))
    jcc(a, cc_p, c_same)
    finite_jump(a, xmm0, c_same)
    is_whole(a, xmm0, c_same)
    movq_rx(a, rax, xmm0)
    push_r(a, rax)
    bit_op(a, "btr", rax, 63)
    movq_xr(a, xmm0, rax)
    call_to(a, "rt_canon_double")
    pop_r(a, rcx)
    shifti(a, "shr", rcx, 63)
    shifti(a, "shl", rcx, 63)
    alu(a, "or", rax, rcx)
    movq_xr(a, xmm0, rax)
    mark(a, c_same)
    ret(a)

    # rt_round_down, rt_round_up, rt_round_near: xmm0 a whole number, from it to 15 digits (vm.js's rounded),
    # or mistake 24, 25 or 26 if it isn't a number
    for each way in list of (list of "rt_round_down", 24), (list of "rt_round_up", 25), (list of "rt_round_near", 26)
        set r_bad to new_label(a)
        set r_same to new_label(a)
        set r_keep to new_label(a)
        set r_up to new_label(a)
        mark(a, item 1 of way)
        odd_jump(a, xmm0, r_bad)
        call_to(a, "rt_canon_any")
        ucomisd(a, xmm0, reg_at(xmm0))
        jcc(a, cc_p, r_same)
        finite_jump(a, xmm0, r_same)
        is_whole(a, xmm0, r_same)
        if item 2 of way is 24
            floor_sd(a, xmm0, xmm0)
        else if item 2 of way is 25
            ceil_sd(a, xmm0, xmm0)
        else # the size's whole part, and one more if what's left is a half or more, with the sign put back
            movq_rx(a, r8, xmm0)
            movq_rx(a, rax, xmm0)
            bit_op(a, "btr", rax, 63)
            movq_xr(a, xmm1, rax)
            floor_sd(a, xmm2, xmm1)
            movapd(a, xmm3, xmm1)
            sse_math(a, "-", xmm3, reg_at(xmm2))
            ucomisd(a, xmm3, rip(number_place(a, double_bytes(0.5))))
            jcc(a, cc_b, r_keep)
            sse_math(a, "+", xmm2, rip(number_place(a, double_bytes(1))))
            mark(a, r_keep)
            test_rr(a, r8, r8)
            jcc(a, cc_ns, r_up)
            movq_rx(a, rax, xmm2)
            bit_op(a, "bts", rax, 63)
            movq_xr(a, xmm2, rax)
            mark(a, r_up)
            movapd(a, xmm0, xmm2)
        end
        sse_math(a, "+", xmm0, rip(number_place(a, double_bytes(0)))) # never -0
        mark(a, r_same)
        movi(a, rax, 0)
        ret(a)
        mark(a, r_bad)
        movsd_store(a, rip("err_a"), xmm0)
        storei(a, rip("err_why"), item 2 of way)
        movi(a, rax, 2)
        ret(a)
    end

    # rt_remainder: xmm0 what's left of xmm0 divided by xmm1, with xmm1's sign, as vm.js works it out: of
    # two whole numbers, exactly, by idiv below 2^53 and the x87's remainder above; else 0 if `is divisible
    # by` says so, and a - b * (a / b to 15 digits, rounded down); mistake 27 or 28
    set m_bad_a to new_label(a)
    set m_bad_b to new_label(a)
    set m_zero to new_label(a)
    set m_none to new_label(a)
    set m_general to new_label(a)
    set m_a_whole to new_label(a)
    set m_both to new_label(a)
    set m_huge to new_label(a)
    set m_int_done to new_label(a)
    set m_rem_loop to new_label(a)
    set m_huge_done to new_label(a)
    set m_nothing_left to new_label(a)
    mark(a, "rt_remainder")
    odd_jump(a, xmm0, m_bad_a)
    odd_jump(a, xmm1, m_bad_b)
    movq_rx(a, rax, xmm1)
    shifti(a, "shl", rax, 1)
    jcc(a, cc_e, m_zero)
    finite_jump(a, xmm0, m_general)
    finite_jump(a, xmm1, m_general)
    is_whole(a, xmm0, m_a_whole)
    jmp_to(a, m_general)
    mark(a, m_a_whole)
    is_whole(a, xmm1, m_both)
    jmp_to(a, m_general)
    mark(a, m_both)
    movi64(a, rcx, list of 0, 0, 0, 0, 0, 0, 0x40, 0x43) # both below 2^53: a 64-bit remainder
    movq_rx(a, rax, xmm0)
    bit_op(a, "btr", rax, 63)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_ae, m_huge)
    movq_rx(a, rax, xmm1)
    bit_op(a, "btr", rax, 63)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_ae, m_huge)
    cvttsd2si(a, rax, xmm0)
    cvttsd2si(a, rcx, xmm1)
    raw(a, list of 0x48, 0x99) # cqo
    unary(a, "idiv", rcx)
    test_rr(a, rdx, rdx)
    jcc(a, cc_e, m_nothing_left)
    mov_rr(a, rax, rdx)
    alu(a, "xor", rax, rcx)
    jcc(a, cc_ns, m_int_done) # the same sign as the divisor already
    alu(a, "add", rdx, rcx)
    mark(a, m_int_done)
    cvtsi2sd(a, xmm0, rdx)
    movi(a, rax, 0)
    ret(a)
    mark(a, m_huge) # bigger: the x87's exact remainder, which has the sign of a
    movsd_store(a, rip("o_a"), xmm0)
    movsd_store(a, rip("o_b"), xmm1)
    enc(a, empty list, no, (list of 0xDD), 0, rip("o_b"), empty list) # fld b
    enc(a, empty list, no, (list of 0xDD), 0, rip("o_a"), empty list) # fld a
    mark(a, m_rem_loop)
    raw(a, list of 0xD9, 0xF8) # fprem
    raw(a, list of 0xDF, 0xE0) # fnstsw ax
    raw(a, list of 0xF6, 0xC4, 0x04) # test ah, 4: not finished yet
    jcc(a, cc_ne, m_rem_loop)
    enc(a, empty list, no, (list of 0xDD), 3, rip("o_ma"), empty list) # fstp the remainder
    raw(a, list of 0xDD, 0xD8) # fstp st(0)
    load(a, rax, rip("o_ma"))
    mov_rr(a, rcx, rax)
    shifti(a, "shl", rcx, 1)
    jcc(a, cc_e, m_nothing_left)
    movq_xr(a, xmm0, rax)
    movq_rx(a, rcx, xmm1)
    alu(a, "xor", rax, rcx)
    jcc(a, cc_ns, m_huge_done)
    sse_math(a, "+", xmm0, reg_at(xmm1))
    mark(a, m_huge_done)
    movi(a, rax, 0)
    ret(a)
    mark(a, m_nothing_left)
    load_bits(a, xmm0, double_bytes(0))
    movi(a, rax, 0)
    ret(a)
    mark(a, m_general)
    alui(a, "sub", rsp, 16)
    movsd_store(a, mem(rsp, 0), xmm0)
    movsd_store(a, mem(rsp, 8), xmm1)
    call_to(a, "rt_cmp_div")
    alui(a, "cmp", rax, 1)
    jcc(a, cc_e, m_none)
    movsd_load(a, xmm0, mem(rsp, 0))
    sse_math(a, "/", xmm0, mem(rsp, 8))
    call_to(a, "rt_canon_any")
    floor_sd(a, xmm0, xmm0)
    sse_math(a, "*", xmm0, mem(rsp, 8))
    movsd_load(a, xmm1, mem(rsp, 0))
    sse_math(a, "-", xmm1, reg_at(xmm0))
    movapd(a, xmm0, xmm1)
    alui(a, "add", rsp, 16)
    movi(a, rax, 0)
    ret(a)
    mark(a, m_none)
    alui(a, "add", rsp, 16)
    load_bits(a, xmm0, double_bytes(0))
    movi(a, rax, 0)
    ret(a)
    mark(a, m_bad_a)
    movsd_store(a, rip("err_a"), xmm0)
    storei(a, rip("err_why"), 27)
    movi(a, rax, 2)
    ret(a)
    mark(a, m_bad_b)
    movsd_store(a, rip("err_a"), xmm1)
    storei(a, rip("err_why"), 27)
    movi(a, rax, 2)
    ret(a)
    mark(a, m_zero)
    storei(a, rip("err_why"), 28)
    movi(a, rax, 2)
    ret(a)
end

# xmm x must be text, or the helper returns mistake 10, the helper being `what`; uses rax
to need_text with a, x, what
    set fine to new_label(a)
    movq_rx(a, rax, x)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_text)
    jcc(a, cc_e, fine)
    movsd_store(a, rip("err_a"), x)
    lea(a, rax, rip(text_object(a, what)))
    store(a, rip("err_what"), rax)
    storei(a, rip("err_why"), 10)
    movi(a, rax, 2)
    ret(a)
    mark(a, fine)
end

# the helper's name in err_what goes in the builder
to what_name with a
    load(a, rax, rip("err_what"))
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    call_to(a, "rt_b_bytes")
end

# a piece of the text at register t, from byte `from` to byte `upto`, goes at the end of split_list
to split_piece with a, t, from, upto
    load(a, rsi, mem(t, 16))
    alu(a, "add", rsi, from)
    mov_rr(a, rcx, upto)
    alu(a, "sub", rcx, from)
    call_to(a, "rt_text_from")
    mov_rr(a, rdx, rax)
    load(a, rax, rip("split_list"))
    call_to(a, "rt_list_push")
end

# rt_decode_utf8: rax bytes (untagged): read as UTF-8 into the builder, as TextDecoder does: each byte of
# what can't be UTF-8, a sequence that stops early, a surrogate or a character past U+10FFFF, as U+FFFD,
# one for each of its maximal parts; a byte order mark at the start is dropped
to emit_utf8 with a
    set loop to new_label(a)
    set done to new_label(a)
    set ascii to new_label(a)
    set bad to new_label(a)
    set need to new_label(a)
    set follow to new_label(a)
    set good to new_label(a)
    set two to new_label(a)
    set three to new_label(a)
    mark(a, "rt_decode_utf8")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    call_to(a, "rt_b_reset")
    load(a, rbx, mem(rax, 8)) # where the bytes are
    load(a, r12, mem(rax, 0))
    alu(a, "add", r12, rbx) # where they end
    mov_rr(a, rax, r12) # a byte order mark first?
    alu(a, "sub", rax, rbx)
    alui(a, "cmp", rax, 3)
    jcc(a, cc_b, loop)
    load8(a, rax, mem(rbx, 0))
    alui(a, "cmp", rax, 0xEF)
    jcc(a, cc_ne, loop)
    load8(a, rax, mem(rbx, 1))
    alui(a, "cmp", rax, 0xBB)
    jcc(a, cc_ne, loop)
    load8(a, rax, mem(rbx, 2))
    alui(a, "cmp", rax, 0xBF)
    jcc(a, cc_ne, loop)
    alui(a, "add", rbx, 3)
    mark(a, loop)
    alu(a, "cmp", rbx, r12)
    jcc(a, cc_ae, done)
    load8(a, rax, mem(rbx, 0))
    alui(a, "cmp", rax, 0x80)
    jcc(a, cc_b, ascii)
    # the lead byte: how many follow (r13), and the range the first of them must be in (r14 low, rcx high)
    movi(a, r14, 0x80)
    movi(a, rcx, 0xBF)
    alui(a, "cmp", rax, 0xC2)
    jcc(a, cc_b, bad)
    alui(a, "cmp", rax, 0xE0)
    jcc(a, cc_b, two)
    alui(a, "cmp", rax, 0xF0)
    jcc(a, cc_b, three)
    alui(a, "cmp", rax, 0xF5)
    jcc(a, cc_ae, bad)
    movi(a, r13, 3)
    set f0 to new_label(a)
    alui(a, "cmp", rax, 0xF0)
    jcc(a, cc_ne, f0)
    movi(a, r14, 0x90)
    mark(a, f0)
    alui(a, "cmp", rax, 0xF4)
    jcc(a, cc_ne, need)
    movi(a, rcx, 0x8F)
    jmp_to(a, need)
    mark(a, two)
    movi(a, r13, 1)
    jmp_to(a, need)
    mark(a, three)
    movi(a, r13, 2)
    set e0 to new_label(a)
    alui(a, "cmp", rax, 0xE0)
    jcc(a, cc_ne, e0)
    movi(a, r14, 0xA0)
    mark(a, e0)
    alui(a, "cmp", rax, 0xED)
    jcc(a, cc_ne, need)
    movi(a, rcx, 0x9F)
    mark(a, need) # the bytes that follow, each 0x80 to 0xBF, the first in its own range
    movi(a, r8, 1)
    mark(a, follow)
    alu(a, "cmp", r8, r13)
    jcc(a, cc_a, good)
    mov_rr(a, rax, rbx)
    alu(a, "add", rax, r8)
    alu(a, "cmp", rax, r12)
    jcc(a, cc_ae, "rt_utf8_short")
    load8(a, rax, mem(rax, 0))
    alu(a, "cmp", rax, r14)
    jcc(a, cc_b, "rt_utf8_short")
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_a, "rt_utf8_short")
    movi(a, r14, 0x80)
    movi(a, rcx, 0xBF)
    inc_r(a, r8)
    jmp_to(a, follow)
    mark(a, "rt_utf8_short") # the maximal part so far: r8 bytes, one U+FFFD
    b_text(a, "�")
    alu(a, "add", rbx, r8)
    jmp_to(a, loop)
    mark(a, good)
    mov_rr(a, rsi, rbx)
    mov_rr(a, rcx, r13)
    inc_r(a, rcx)
    alu(a, "add", rbx, rcx)
    call_to(a, "rt_b_bytes")
    jmp_to(a, loop)
    mark(a, bad)
    b_text(a, "�")
    inc_r(a, rbx)
    jmp_to(a, loop)
    mark(a, ascii)
    call_to(a, "rt_b_byte")
    inc_r(a, rbx)
    jmp_to(a, loop)
    mark(a, done)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_decode_bytes: rsi, rcx: those bytes read as UTF-8 into the builder, as rt_decode_utf8 reads them, but
    # with a byte order mark at the start kept, as Rust's from_utf8_lossy and Node's toString keep it
    mark(a, "rt_decode_bytes")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    call_to(a, "rt_b_reset")
    mov_rr(a, rbx, rsi)
    mov_rr(a, r12, rcx)
    alu(a, "add", r12, rbx)
    jmp_to(a, loop)
end

# rt_parse_number: rax text (untagged): as a number in xmm0 with rax 0, or rax 1 if it isn't one. The
# digits, with the point taken out, are a whole number N and the number is N * 10^-k: for N up to 2^53
# and k up to 22 one exact division does it; anything else is worked out with big whole numbers.
to emit_parse_number with a
    set trim_start to new_label(a)
    set trim_end to new_label(a)
    set trimmed to new_label(a)
    set no_minus to new_label(a)
    set whole_digits to new_label(a)
    set after_whole to new_label(a)
    set fraction_digits to new_label(a)
    set after_fraction to new_label(a)
    set not_a_number to new_label(a)
    set exact to new_label(a)
    set slow to new_label(a)
    set signed to new_label(a)
    set out to new_label(a)
    mark(a, "rt_parse_number")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    load(a, rbx, mem(rax, 16)) # rbx .. r12: the text, less white space either side
    load(a, r12, mem(rax, 0))
    alu(a, "add", r12, rbx)
    mark(a, trim_start)
    alu(a, "cmp", rbx, r12)
    jcc(a, cc_ae, not_a_number)
    mov_rr(a, rsi, rbx)
    call_to(a, "rt_space_at")
    test_rr(a, rax, rax)
    jcc(a, cc_e, trim_end)
    alu(a, "add", rbx, rax)
    jmp_to(a, trim_start)
    mark(a, trim_end)
    alu(a, "cmp", r12, rbx)
    jcc(a, cc_be, not_a_number)
    mov_rr(a, rsi, r12)
    call_to(a, "rt_space_before")
    test_rr(a, rax, rax)
    jcc(a, cc_e, trimmed)
    alu(a, "sub", r12, rax)
    jmp_to(a, trim_end)
    mark(a, trimmed)
    movi(a, r13, 0) # 1 for a minus
    load8(a, rax, mem(rbx, 0))
    alui(a, "cmp", rax, 45)
    jcc(a, cc_ne, no_minus)
    movi(a, r13, 1)
    inc_r(a, rbx)
    mark(a, no_minus)
    store(a, rip("pn_start"), rbx) # the digits, and whether there's a point
    movi(a, r14, 0) # how many digits after the point
    movi(a, r9, 0) # how many digits before it
    mark(a, whole_digits)
    alu(a, "cmp", rbx, r12)
    jcc(a, cc_ae, after_whole)
    load8(a, rax, mem(rbx, 0))
    alui(a, "cmp", rax, 46)
    jcc(a, cc_e, after_whole)
    alui(a, "sub", rax, 48)
    alui(a, "cmp", rax, 9)
    jcc(a, cc_a, not_a_number)
    inc_r(a, r9)
    inc_r(a, rbx)
    jmp_to(a, whole_digits)
    mark(a, after_whole)
    test_rr(a, r9, r9)
    jcc(a, cc_e, not_a_number)
    alu(a, "cmp", rbx, r12)
    jcc(a, cc_ae, after_fraction)
    inc_r(a, rbx) # the point: digits must follow
    mark(a, fraction_digits)
    alu(a, "cmp", rbx, r12)
    jcc(a, cc_ae, after_fraction)
    load8(a, rax, mem(rbx, 0))
    alui(a, "sub", rax, 48)
    alui(a, "cmp", rax, 9)
    jcc(a, cc_a, not_a_number)
    inc_r(a, r14)
    inc_r(a, rbx)
    jmp_to(a, fraction_digits)
    mark(a, after_fraction)
    load(a, rax, rip("pn_start")) # a point with nothing after it isn't a number
    alu(a, "add", rax, r9)
    alu(a, "cmp", rax, r12)
    set point_ok to new_label(a)
    jcc(a, cc_e, point_ok)
    test_rr(a, r14, r14)
    jcc(a, cc_e, not_a_number)
    mark(a, point_ok)
    # N from the digits, at most 40 significant ones, and E: -k, plus one for each digit left out. One that
    # isn't 0 adds a last digit 1 to N, so it rounds as the whole number would.
    lea(a, rdi, rip("big_n"))
    movi(a, rax, 0)
    call_to(a, "big_set")
    movi(a, r9, 0) # significant digits so far
    mov_rr(a, r10, r14) # E
    unary(a, "neg", r10)
    movi(a, r11, 0) # 1 if a digit left out isn't 0
    load(a, rsi, rip("pn_start"))
    set digit_loop to new_label(a)
    set digits_done to new_label(a)
    set left_out to new_label(a)
    set kept_digit to new_label(a)
    mark(a, digit_loop)
    alu(a, "cmp", rsi, r12)
    jcc(a, cc_ae, digits_done)
    load8(a, rax, mem(rsi, 0))
    inc_r(a, rsi)
    alui(a, "cmp", rax, 46)
    jcc(a, cc_e, digit_loop)
    alui(a, "sub", rax, 48)
    test_rr(a, r9, r9) # a leading 0 counts for nothing
    jcc(a, cc_ne, kept_digit)
    test_rr(a, rax, rax)
    jcc(a, cc_e, digit_loop)
    mark(a, kept_digit)
    alui(a, "cmp", r9, 40)
    jcc(a, cc_ae, left_out)
    inc_r(a, r9)
    big_digit(a)
    jmp_to(a, digit_loop)
    mark(a, left_out)
    inc_r(a, r10)
    test_rr(a, rax, rax)
    jcc(a, cc_e, digit_loop)
    movi(a, r11, 1)
    jmp_to(a, digit_loop)
    mark(a, digits_done)
    test_rr(a, r11, r11)
    set no_marker to new_label(a)
    jcc(a, cc_e, no_marker)
    movi(a, rax, 1)
    big_digit(a)
    inc_r(a, r9)
    dec_r(a, r10)
    mark(a, no_marker)
    store(a, rip("pn_e10"), r10)
    store(a, rip("pn_digits"), r9)
    # N fits 53 bits and E is from -22 to 22: one exact step
    lea(a, rax, rip("big_n"))
    for each limb from 1 to limbs - 1
        alu_at(a, "cmp", mem(rax, 8 * limb), 0)
        jcc(a, cc_ne, slow)
    end
    load(a, rax, mem(rax, 0))
    movi64(a, rcx, list of 0, 0, 0, 0, 0, 0, 0x20, 0)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_a, slow)
    alui(a, "cmp", r10, 22)
    jcc(a, cc_g, slow)
    alui(a, "cmp", r10, -22)
    jcc(a, cc_l, slow)
    cvtsi2sd(a, xmm0, rax)
    set times_power to new_label(a)
    test_rr(a, r10, r10)
    jcc(a, cc_ns, times_power)
    unary(a, "neg", r10)
    shifti(a, "shl", r10, 3)
    lea(a, rax, rip("pow10"))
    alu(a, "add", rax, r10)
    sse_math(a, "/", xmm0, mem(rax, 0))
    jmp_to(a, signed)
    mark(a, times_power)
    shifti(a, "shl", r10, 3)
    lea(a, rax, rip("pow10"))
    alu(a, "add", rax, r10)
    sse_math(a, "*", xmm0, mem(rax, 0))
    jmp_to(a, signed)
    mark(a, slow)
    call_to(a, "rt_big_to_double")
    mark(a, signed)
    test_rr(a, r13, r13)
    jcc(a, cc_e, exact)
    movq_rx(a, rax, xmm0)
    bit_op(a, "btc", rax, 63)
    movq_xr(a, xmm0, rax)
    mark(a, exact)
    movi(a, rax, 0)
    jmp_to(a, out)
    mark(a, not_a_number)
    movi(a, rax, 1)
    mark(a, out)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # big_add_small: rdi plus rax (below 2^64)
    set carrying to new_label(a)
    set added to new_label(a)
    mark(a, "big_add_small")
    movi(a, rcx, limbs)
    alu_store(a, "add", mem(rdi, 0), rax)
    mark(a, carrying)
    jcc(a, cc_ae, added)
    alui(a, "add", rdi, 8)
    dec_r(a, rcx)
    jcc(a, cc_e, added)
    alu_at(a, "add", mem(rdi, 0), 1)
    jmp_to(a, carrying)
    mark(a, added)
    ret(a)

    # rt_space_at: rsi: how many bytes the JavaScript white space character there takes, or 0
    # rt_space_before: rsi: the same for the one just before it
    set not_space to new_label(a)
    mark(a, "rt_space_at")
    push_r(a, rsi)
    call_to(a, "rt_decode")
    pop_r(a, rsi)
    push_r(a, rax)
    char_size(a)
    pop_r(a, rax)
    space_test(a, not_space)
    mov_rr(a, rax, rdx)
    ret(a)
    mark(a, not_space)
    movi(a, rax, 0)
    ret(a)
    set back_up to new_label(a)
    mark(a, "rt_space_before")
    push_r(a, rsi)
    mark(a, back_up)
    dec_r(a, rsi)
    load8(a, rax, mem(rsi, 0))
    alui(a, "and", rax, 0xC0)
    alui(a, "cmp", rax, 0x80)
    jcc(a, cc_e, back_up)
    call_to(a, "rt_space_at")
    pop_r(a, rsi)
    ret(a)

    # rt_big_to_double: big_n times 10^-pn_k, the double nearest it, into xmm0: a first guess on the x87,
    # with its 64-bit precision, then f * 2^e moved one at a time until (2f - 1) / 2 and (2f + 1) / 2 times
    # 2^e are on either side of it, exactly, with big whole numbers
    emit_big_to_double(a)
end

# jumps to `name` unless the character number in rax is JavaScript white space
to space_test with a, name
    set yes_space to new_label(a)
    for each cp in list of 9, 10, 11, 12, 13, 32, 0xA0, 0x1680, 0x2028, 0x2029, 0x202F, 0x205F, 0x3000, 0xFEFF
        alui(a, "cmp", rax, cp)
        jcc(a, cc_e, yes_space)
    end
    alui(a, "cmp", rax, 0x2000)
    jcc(a, cc_b, name)
    alui(a, "cmp", rax, 0x200A)
    jcc(a, cc_a, name)
    mark(a, yes_space)
end

# N (big_n) times 10, plus the digit in rax; keeps r9 to r11 and rsi
to big_digit with a
    push_r(a, rsi)
    push_r(a, rax)
    lea(a, rdi, rip("big_n"))
    call_to(a, "big_mul10")
    pop_r(a, rax)
    lea(a, rdi, rip("big_n"))
    call_to(a, "big_add_small")
    pop_r(a, rsi)
end
# rt_big_to_double: big_n is N above 0, pn_e10 is E and pn_digits how many digits N has: the double nearest
# N * 10^E, into xmm0. A first guess comes from the x87, whose 64-bit precision puts it within a step of
# the answer; then f * 2^e moves a step at a time until N * 10^E is between (2f - 1) and (2f + 1) times
# 2^(e - 1), which big whole numbers check exactly: A = 2N * 10^max(E, 0) * 2^max(-e, 0) against
# B = c * 10^max(-E, 0) * 2^max(e, 0), for c = 2f + 1 and 2f - 1.
to emit_big_to_double with a
    set infinite to new_label(a)
    set zero to new_label(a)
    set pow_loop to new_label(a)
    set pow_skip to new_label(a)
    set pow_done to new_label(a)
    set divide to new_label(a)
    set guessed to new_label(a)
    set have_guess to new_label(a)
    set ten_loop to new_label(a)
    set tens_done to new_label(a)
    set q_loop to new_label(a)
    set q_done to new_label(a)
    set rescale to new_label(a)
    set upward to new_label(a)
    set raise_f to new_label(a)
    set downward to new_label(a)
    set lower_f to new_label(a)
    set settled to new_label(a)
    set scaled to new_label(a)
    set not_subnormal to new_label(a)
    set bits_ready to new_label(a)
    set out to new_label(a)
    set a_ready to new_label(a)
    mark(a, "rt_big_to_double")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    load(a, rax, rip("pn_digits")) # past what a double can hold either way
    alu_load(a, "add", rax, rip("pn_e10"))
    alui(a, "cmp", rax, 310)
    jcc(a, cc_g, infinite)
    alui(a, "cmp", rax, -325)
    jcc(a, cc_l, zero)
    enc(a, empty list, no, (list of 0xD9), 7, rip("x87_cw"), empty list) # fnstcw: keep the x87's own setting
    enc(a, empty list, no, (list of 0xD9), 5, rip(number_place(a, list of 0x7F, 0x03, 0, 0, 0, 0, 0, 0)), empty list) # fldcw: 64-bit precision
    raw(a, list of 0xD9, 0xEE) # fldz: N, 32 bits at a time from the top
    for each k from 0 to 2 * limbs - 1
        set half to 2 * limbs - 1 - k
        enc(a, empty list, no, (list of 0xDC), 1, rip(number_place(a, double_bytes(4294967296))), empty list) # fmul 2^32
        load32(a, rax, rip_plus("big_n", 4 * half))
        store(a, rip("x87_tmp"), rax)
        enc(a, empty list, no, (list of 0xDF), 5, rip("x87_tmp"), empty list) # fild qword
        raw(a, list of 0xDE, 0xC1) # faddp
    end
    load(a, rax, rip("pn_e10")) # 10^|E|, by squaring
    mov_rr(a, rbx, rax)
    test_rr(a, rax, rax)
    jcc(a, cc_ns, pow_loop)
    unary(a, "neg", rax)
    mark(a, pow_loop)
    raw(a, list of 0xD9, 0xE8) # fld1: the power
    storei(a, rip("x87_tmp"), 10)
    enc(a, empty list, no, (list of 0xDF), 5, rip("x87_tmp"), empty list) # fild 10: what it's raised by
    set squaring to new_label(a)
    mark(a, squaring)
    test_rr(a, rax, rax)
    jcc(a, cc_e, pow_done)
    mov_rr(a, rcx, rax)
    alui(a, "and", rcx, 1)
    jcc(a, cc_e, pow_skip)
    raw(a, list of 0xDC, 0xC9) # fmul st(1), st(0)
    mark(a, pow_skip)
    raw(a, list of 0xD8, 0xC8) # fmul st(0), st(0)
    shifti(a, "shr", rax, 1)
    jmp_to(a, squaring)
    mark(a, pow_done)
    raw(a, list of 0xDD, 0xD8) # fstp st(0): now N, then the power
    test_rr(a, rbx, rbx)
    jcc(a, cc_s, divide)
    raw(a, list of 0xDE, 0xC9) # fmulp
    jmp_to(a, guessed)
    mark(a, divide)
    raw(a, list of 0xDE, 0xF9) # fdivp: N over the power
    mark(a, guessed)
    enc(a, empty list, no, (list of 0xDD), 3, rip("x87_tmp"), empty list) # fstp qword: the guess, as a double
    enc(a, empty list, no, (list of 0xD9), 5, rip("x87_cw"), empty list) # fldcw: the x87's setting back
    load(a, rax, rip("x87_tmp"))
    mov_rr(a, rcx, rax) # f in r12, e in r13
    shifti(a, "shr", rcx, 52)
    movi64(a, rdx, list of 255, 255, 255, 255, 255, 255, 15, 0)
    alu(a, "and", rax, rdx)
    mov_rr(a, r12, rax)
    movi(a, r13, -1074)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, have_guess)
    alui(a, "cmp", rcx, 2047)
    set finite_guess to new_label(a)
    jcc(a, cc_ne, finite_guess)
    movi64(a, r12, bytes_of(9007199254740991)) # an infinity: start from the biggest double
    movi(a, r13, 971)
    jmp_to(a, have_guess)
    mark(a, finite_guess)
    bit_op(a, "bts", r12, 52)
    mov_rr(a, r13, rcx)
    alui(a, "sub", r13, 1075)
    mark(a, have_guess)
    lea(a, rdi, rip("big_mp")) # 2N * 10^max(E, 0)
    lea(a, rsi, rip("big_n"))
    call_to(a, "big_copy")
    lea(a, rdi, rip("big_mp"))
    movi(a, rsi, 2)
    call_to(a, "big_mul")
    load(a, rbx, rip("pn_e10"))
    mark(a, ten_loop)
    test_rr(a, rbx, rbx)
    jcc(a, cc_le, tens_done)
    lea(a, rdi, rip("big_mp"))
    call_to(a, "big_mul10")
    dec_r(a, rbx)
    jmp_to(a, ten_loop)
    mark(a, tens_done)
    lea(a, rdi, rip("big_mm")) # 10^max(-E, 0)
    movi(a, rax, 1)
    call_to(a, "big_set")
    load(a, rbx, rip("pn_e10"))
    mark(a, q_loop)
    test_rr(a, rbx, rbx)
    jcc(a, cc_ge, q_done)
    lea(a, rdi, rip("big_mm"))
    call_to(a, "big_mul10")
    inc_r(a, rbx)
    jmp_to(a, q_loop)
    mark(a, q_done)
    mark(a, rescale) # A at this scale
    lea(a, rdi, rip("big_r"))
    lea(a, rsi, rip("big_mp"))
    call_to(a, "big_copy")
    test_rr(a, r13, r13)
    jcc(a, cc_ns, a_ready)
    lea(a, rdi, rip("big_r"))
    mov_rr(a, rcx, r13)
    unary(a, "neg", rcx)
    call_to(a, "big_shl")
    mark(a, a_ready)
    mark(a, upward) # up while it's past f + 1/2
    against(a, 1)
    jcc(a, cc_a, raise_f)
    jcc(a, cc_ne, downward)
    mov_rr(a, rax, r12) # halfway: to the even one
    alui(a, "and", rax, 1)
    jcc(a, cc_e, settled)
    inc_r(a, r12)
    jmp_to(a, settled)
    mark(a, raise_f)
    inc_r(a, r12)
    movi64(a, rax, list of 0, 0, 0, 0, 0, 0, 0x20, 0)
    alu(a, "cmp", r12, rax)
    jcc(a, cc_b, upward)
    jmp_to(a, settled)
    mark(a, downward) # down while it's short of f - 1/2
    test_rr(a, r12, r12)
    jcc(a, cc_e, settled)
    against(a, -1)
    jcc(a, cc_b, lower_f)
    jcc(a, cc_ne, settled)
    mov_rr(a, rax, r12)
    alui(a, "and", rax, 1)
    jcc(a, cc_e, settled)
    mark(a, lower_f)
    dec_r(a, r12)
    jmp_to(a, downward)
    mark(a, settled) # f out of its 53 bits: the scale next to it
    movi64(a, rax, list of 0, 0, 0, 0, 0, 0, 0x20, 0)
    alu(a, "cmp", r12, rax)
    jcc(a, cc_b, scaled)
    shifti(a, "shr", r12, 1)
    inc_r(a, r13)
    alui(a, "cmp", r13, 971)
    jcc(a, cc_g, infinite)
    jmp_to(a, rescale)
    mark(a, scaled)
    movi64(a, rax, bytes_of(4503599627370496))
    alu(a, "cmp", r12, rax)
    jcc(a, cc_ae, not_subnormal)
    alui(a, "cmp", r13, -1074)
    jcc(a, cc_le, not_subnormal)
    shifti(a, "shl", r12, 1)
    dec_r(a, r13)
    jmp_to(a, rescale)
    mark(a, not_subnormal)
    mov_rr(a, rax, r12)
    movi64(a, rcx, bytes_of(4503599627370496))
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_b, bits_ready) # a subnormal's bits are its f
    alu(a, "sub", rax, rcx)
    mov_rr(a, rcx, r13)
    alui(a, "add", rcx, 1075)
    shifti(a, "shl", rcx, 52)
    alu(a, "or", rax, rcx)
    mark(a, bits_ready)
    movq_xr(a, xmm0, rax)
    jmp_to(a, out)
    mark(a, infinite)
    movi64(a, rax, list of 0, 0, 0, 0, 0, 0, 0xF0, 0x7F)
    movq_xr(a, xmm0, rax)
    jmp_to(a, out)
    mark(a, zero)
    movi(a, rax, 0)
    movq_xr(a, xmm0, rax)
    mark(a, out)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # big_shl: rdi times 2^rcx
    set limb_loop to new_label(a)
    set have_low to new_label(a)
    mark(a, "big_shl")
    push_r(a, rbx)
    mov_rr(a, rdx, rcx)
    shifti(a, "shr", rdx, 6) # whole limbs
    alui(a, "and", rcx, 63) # and bits
    movi(a, r8, limbs - 1)
    mark(a, limb_loop)
    mov_rr(a, r9, r8) # the limb that moves here, and the one below it
    alu(a, "sub", r9, rdx)
    movi(a, rax, 0)
    movi(a, rbx, 0)
    test_rr(a, r9, r9)
    jcc(a, cc_s, have_low)
    mov_rr(a, r10, r9)
    shifti(a, "shl", r10, 3)
    alu(a, "add", r10, rdi)
    load(a, rax, mem(r10, 0))
    test_rr(a, r9, r9)
    jcc(a, cc_e, have_low)
    load(a, rbx, mem(r10, -8))
    mark(a, have_low)
    shld_cl(a, rax, rbx)
    mov_rr(a, r10, r8)
    shifti(a, "shl", r10, 3)
    alu(a, "add", r10, rdi)
    store(a, mem(r10, 0), rax)
    dec_r(a, r8)
    jcc(a, cc_ns, limb_loop)
    pop_r(a, rbx)
    ret(a)
end

# compares A (big_r) with B for c = 2f + side, f in r12 and e in r13: B is big_mm * c * 2^max(e, 0), in
# big_t; flags for an unsigned jump after
to against with a, side
    set no_shift to new_label(a)
    lea(a, rdi, rip("big_t"))
    lea(a, rsi, rip("big_mm"))
    call_to(a, "big_copy")
    mov_rr(a, rsi, r12)
    alu(a, "add", rsi, rsi)
    alui(a, "add", rsi, side)
    lea(a, rdi, rip("big_t"))
    call_to(a, "big_mul")
    test_rr(a, r13, r13)
    jcc(a, cc_le, no_shift)
    lea(a, rdi, rip("big_t"))
    mov_rr(a, rcx, r13)
    call_to(a, "big_shl")
    mark(a, no_shift)
    lea(a, rdi, rip("big_r"))
    lea(a, rsi, rip("big_t"))
    call_to(a, "big_cmp")
end

# ---------- the runtime: functions as values ----------
# A function value is 24 bytes: where its code is, the variables it was made among (the environment of the
# function it was made in, or 0 at the top level), and a description of it: how many inputs, its name, and
# for each input what it must be (-1 for anything) and its name. An environment is the variables of a
# function that makes functions, kept in memory so the functions it makes can still reach them after it
# returns: the environment it was made in, then a slot for each variable.

to emit_functions with a
    # rt_closure: rcx code, rdx environment, r8 description: a new function value, in rax
    mark(a, "rt_closure")
    push_r(a, rcx)
    movi(a, rcx, 24)
    call_to(a, "rt_alloc")
    pop_r(a, rcx)
    store(a, mem(rax, 0), rcx)
    store(a, mem(rax, 8), rdx)
    store(a, mem(rax, 16), r8)
    movi64(a, rcx, tag_function)
    alu(a, "or", rax, rcx)
    ret(a)

    # rt_env_new: rcx variables, none with a value yet, and rdx the environment further out: a new
    # environment, in rax
    mark(a, "rt_env_new")
    push_r(a, rdi)
    push_r(a, rcx)
    push_r(a, rdx)
    inc_r(a, rcx)
    shifti(a, "shl", rcx, 3)
    call_to(a, "rt_alloc")
    pop_r(a, rdx)
    pop_r(a, rcx)
    store(a, mem(rax, 0), rdx)
    push_r(a, rax)
    lea(a, rdi, mem(rax, 8))
    movi64(a, rax, bits_unset)
    rep_stosq(a)
    pop_r(a, rax)
    pop_r(a, rdi)
    ret(a)

    # rt_fits_kind: rax a value, rdx what an input says it is (0 a number, 1 text, 2 yes or no, 3 a list, 4 a
    # record, 5 a dictionary, 6 bytes, 7 a function): rax is 1 if it is that
    set number_kind to new_label(a)
    set yes_no_kind to new_label(a)
    set fits to new_label(a)
    set fits_not to new_label(a)
    mark(a, "rt_fits_kind")
    test_rr(a, rdx, rdx)
    jcc(a, cc_e, number_kind)
    alui(a, "cmp", rdx, 2)
    jcc(a, cc_e, yes_no_kind)
    lea(a, rcx, rip("kind_tag_table")) # in memory: its tag
    shifti(a, "shl", rdx, 3)
    alu(a, "add", rcx, rdx)
    shifti(a, "shr", rax, 48)
    alu_load(a, "cmp", rax, mem(rcx, 0))
    jcc(a, cc_e, fits)
    jmp_to(a, fits_not)
    mark(a, number_kind)
    movq_xr(a, xmm0, rax)
    odd_jump(a, xmm0, fits_not)
    jmp_to(a, fits)
    mark(a, yes_no_kind)
    movi64(a, rcx, bits_no)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_e, fits)
    inc_r(a, rcx)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_e, fits)
    mark(a, fits_not)
    movi(a, rax, 0)
    ret(a)
    mark(a, fits)
    movi(a, rax, 1)
    ret(a)

    # rt_check_call: rax a function value, rsi its inputs (the last first, rcx of them): rax 0 if they're as
    # many as it has and each what it says it is; else 2, with err_why 1 (how many, wanted in err_len and
    # given in err_got) or 2 (what one is: its value in err_a, its name in err_field, its kind in err_kind)
    set counted to new_label(a)
    set each_input to new_label(a)
    set next_input to new_label(a)
    set inputs_fine to new_label(a)
    mark(a, "rt_check_call")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    untag(a, rax)
    load(a, rbx, mem(rax, 16)) # its description
    store(a, rip("err_got"), rcx)
    load(a, rax, mem(rbx, 0))
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_e, counted)
    store(a, rip("err_len"), rax)
    storei(a, rip("err_why"), 1)
    movi(a, rax, 2)
    jmp_to(a, inputs_fine)
    mark(a, counted)
    mov_rr(a, r12, rsi)
    mov_rr(a, r13, rcx)
    movi(a, r14, 0)
    mark(a, each_input)
    alu(a, "cmp", r14, r13)
    jcc(a, cc_ae, "rt_check_ok")
    mov_rr(a, rax, r14)
    shifti(a, "shl", rax, 4)
    alu(a, "add", rax, rbx)
    load(a, rdx, mem(rax, 16))
    alui(a, "cmp", rdx, -1)
    jcc(a, cc_e, next_input)
    mov_rr(a, rcx, r13) # input r14 (from 0) is at rsi + 8 * (n - 1 - r14)
    alu(a, "sub", rcx, r14)
    dec_r(a, rcx)
    shifti(a, "shl", rcx, 3)
    alu(a, "add", rcx, r12)
    load(a, rax, mem(rcx, 0))
    push_r(a, rax)
    push_r(a, rdx)
    call_to(a, "rt_fits_kind")
    pop_r(a, rdx)
    pop_r(a, rcx)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, next_input)
    store(a, rip("err_a"), rcx)
    store(a, rip("err_kind"), rdx)
    mov_rr(a, rax, r14)
    shifti(a, "shl", rax, 4)
    alu(a, "add", rax, rbx)
    load(a, rax, mem(rax, 24))
    store(a, rip("err_field"), rax)
    storei(a, rip("err_why"), 2)
    movi(a, rax, 2)
    jmp_to(a, inputs_fine)
    mark(a, next_input)
    inc_r(a, r14)
    jmp_to(a, each_input)
    mark(a, "rt_check_ok")
    movi(a, rax, 0)
    mark(a, inputs_fine)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_why_call: what was wrong with a call to the function named err_what, into the builder
    set kind_wrong to new_label(a)
    set one_input to new_label(a)
    mark(a, "rt_why_call")
    load(a, rax, rip("err_why"))
    alui(a, "cmp", rax, 2)
    jcc(a, cc_e, kind_wrong)
    b_text(a, "'")
    what_name(a)
    b_text(a, "' needs ")
    load(a, rax, rip("err_len"))
    call_to(a, "rt_e_plain")
    b_text(a, " input")
    load(a, rax, rip("err_len"))
    alui(a, "cmp", rax, 1)
    jcc(a, cc_e, one_input)
    movi(a, rax, 115)
    call_to(a, "rt_b_byte")
    mark(a, one_input)
    b_text(a, " but got ")
    load(a, rax, rip("err_got"))
    jmp_to(a, "rt_e_plain")
    mark(a, kind_wrong)
    b_text(a, "'")
    what_name(a)
    b_text(a, "' needs ")
    load(a, rax, rip("err_field"))
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    call_to(a, "rt_b_bytes")
    b_text(a, " to be ")
    lea(a, rax, rip("kind_phrase_table"))
    load(a, rcx, rip("err_kind"))
    shifti(a, "shl", rcx, 3)
    alu(a, "add", rax, rcx)
    load(a, rax, mem(rax, 0))
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    call_to(a, "rt_b_bytes")
    b_text(a, ", not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
end

# ---------- the runtime: amounts with units ----------
# `5 km`, as vm.js's Quantity has it: an amount of a unit, 16 bytes that never change, the amount and which
# of vm.js's UNITS it is in, with a kind of its own. A program with no amount in it gets none of this, and is
# the same bytes it was before amounts could become machine code; one with an amount in it is written a
# second time, knowing that, so the slow paths of its arithmetic look for amounts too (see compile_allowing).

set kind_quantity to 65535
set tag_quantity to list of 0, 0, 0, 0, 0, 0, 0xFF, 0xFF
# vm.js's MEASURES and UNITS: each unit as it is written for one and for many, what it measures, and how many
# of that measure's base unit (a metre, a second, a gram, a litre) it is
set measure_words to list of "a distance", "a time", "a weight", "a volume"
set unit_rows to list of (list of "mm", "mm", 0, 0.001), (list of "cm", "cm", 0, 0.01), (list of "m", "m", 0, 1),
    (list of "km", "km", 0, 1000), (list of "millimetre", "millimetres", 0, 0.001),
    (list of "centimetre", "centimetres", 0, 0.01), (list of "metre", "metres", 0, 1),
    (list of "kilometre", "kilometres", 0, 1000), (list of "millimeter", "millimeters", 0, 0.001),
    (list of "centimeter", "centimeters", 0, 0.01), (list of "meter", "meters", 0, 1),
    (list of "kilometer", "kilometers", 0, 1000), (list of "inch", "inches", 0, 0.0254), (list of "foot", "feet", 0, 0.3048),
    (list of "yard", "yards", 0, 0.9144), (list of "mile", "miles", 0, 1609.344),
    (list of "millisecond", "milliseconds", 1, 0.001), (list of "second", "seconds", 1, 1),
    (list of "minute", "minutes", 1, 60), (list of "hour", "hours", 1, 3600), (list of "day", "days", 1, 86400),
    (list of "week", "weeks", 1, 604800), (list of "mg", "mg", 2, 0.001), (list of "g", "g", 2, 1),
    (list of "kg", "kg", 2, 1000), (list of "milligram", "milligrams", 2, 0.001), (list of "gram", "grams", 2, 1),
    (list of "kilogram", "kilograms", 2, 1000), (list of "ounce", "ounces", 2, 28.349523125),
    (list of "pound", "pounds", 2, 453.59237), (list of "tonne", "tonnes", 2, 1000000), (list of "ml", "ml", 3, 0.001),
    (list of "millilitre", "millilitres", 3, 0.001), (list of "litre", "litres", 3, 1),
    (list of "milliliter", "milliliters", 3, 0.001), (list of "liter", "liters", 3, 1)

# which of unit_rows a unit's word is, from 0
to unit_slot with unit_word
    set unit_at to 0
    for each row in unit_rows
        if item 1 of row is unit_word or item 2 of row is unit_word
            return unit_at
        end
        add 1 to unit_at
    end
    return -1
end

# register dst: where the unit numbered in register r has its row of unit_table; r is kept
to unit_row with a, dst, r
    lea(a, dst, rip("unit_table"))
    shifti(a, "shl", r, 5)
    alu(a, "add", dst, r)
    shifti(a, "shr", r, 5)
end

# an amount the program writes, `5 km`, in the read-only data, once each: its label. It is never changed, and
# the collector only looks where blocks are, so it can stay there.
to quantity_place with a, eight, slot
    set key to "q" + slot + ":"
    for each b in eight
        set key to key + b + ","
    end
    set known to numbers of a
    if key is in known
        return item key of known
    end
    set ro to rodata of a
    pad_to(ro, 16)
    set name to "Q" + length of ro
    rodata_here(a, name)
    put_all(ro, eight)
    put64(ro, slot)
    set item key of known to name
    return name
end

to emit_units with a
    set word_objects to empty list # each unit's two words, and each measure's name, as texts of the program's
    for each row in unit_rows
        add text_object(a, item 1 of row) to word_objects
        add text_object(a, item 2 of row) to word_objects
    end
    set measure_objects to empty list
    for each measure in measure_words
        add text_object(a, measure) to measure_objects
    end
    set ro to rodata of a
    pad_to(ro, 8)
    rodata_here(a, "unit_table") # 32 bytes for each unit: how many of the base unit, what it measures, its words
    set n to 0
    for each row in unit_rows
        put_all(ro, double_bytes(item 4 of row))
        put64(ro, item 3 of row)
        for each k from 1 to 2
            absolute(a, "rodata", length of ro, item (2 * n + k) of word_objects, 0)
            put64(ro, 0)
        end
        add 1 to n
    end
    table_of_texts(a, "measure_table", measure_objects)

    # rt_q_make: xmm0 an amount and rcx a unit: an amount of that unit, new, in xmm0; keeps every register but
    # rax and rcx
    mark(a, "rt_q_make")
    push_r(a, rcx)
    movi(a, rcx, 16)
    call_to(a, "rt_alloc_raw")
    pop_r(a, rcx)
    movsd_store(a, mem(rax, 0), xmm0)
    store(a, mem(rax, 8), rcx)
    movi64(a, rcx, tag_quantity)
    alu(a, "or", rax, rcx)
    movq_xr(a, xmm0, rax)
    ret(a)

    # rt_q_amount_in: rax an amount (untagged) and rcx a unit of the same measure: how much of that unit it is,
    # in xmm0, as vm.js's amountIn works it out; uses rdx and r8
    set as_is to new_label(a)
    mark(a, "rt_q_amount_in")
    movsd_load(a, xmm0, mem(rax, 0))
    load(a, rdx, mem(rax, 8))
    alu(a, "cmp", rdx, rcx)
    jcc(a, cc_e, as_is)
    unit_row(a, r8, rdx)
    sse_math(a, "*", xmm0, mem(r8, 0))
    unit_row(a, r8, rcx)
    sse_math(a, "/", xmm0, mem(r8, 0))
    mark(a, as_is)
    ret(a)

    # rt_q_measure: rax a value: what it measures (0 to 3, as measure_words has them) in rax if it is an
    # amount, else -1; keeps every register but rdx
    set not_amount to new_label(a)
    mark(a, "rt_q_measure")
    mov_rr(a, rdx, rax)
    shifti(a, "shr", rdx, 48)
    alui(a, "cmp", rdx, kind_quantity)
    jcc(a, cc_ne, not_amount)
    untag(a, rax)
    load(a, rax, mem(rax, 8))
    unit_row(a, rdx, rax)
    load(a, rax, mem(rdx, 8))
    ret(a)
    mark(a, not_amount)
    movi(a, rax, -1)
    ret(a)

    # rt_q_pair: xmm0 and xmm1: if both are amounts of one measure, xmm0 gets the first's amount and xmm1 the
    # second's in the first's unit, with rax 0; else rax 1, and both are kept. Uses rcx, rdx and r8 to r10.
    set not_pair to new_label(a)
    mark(a, "rt_q_pair")
    movq_rx(a, rax, xmm1)
    call_to(a, "rt_q_measure")
    mov_rr(a, r9, rax)
    movq_rx(a, rax, xmm0)
    call_to(a, "rt_q_measure")
    alui(a, "cmp", rax, -1)
    jcc(a, cc_e, not_pair)
    alu(a, "cmp", rax, r9)
    jcc(a, cc_ne, not_pair)
    movq_rx(a, r10, xmm0)
    untag(a, r10)
    movq_rx(a, rax, xmm1)
    untag(a, rax)
    load(a, rcx, mem(r10, 8))
    call_to(a, "rt_q_amount_in")
    movapd(a, xmm1, xmm0)
    movsd_load(a, xmm0, mem(r10, 0))
    movi(a, rax, 0)
    ret(a)
    mark(a, not_pair)
    movi(a, rax, 1)
    ret(a)

    # rt_q_in: xmm0 a value and rcx a unit: the value `in` that unit, a new amount in xmm0, with rax 0; or rax 2
    # if it isn't an amount of what the unit measures, with it in err_a
    set wrong_measure to new_label(a)
    mark(a, "rt_q_in")
    movsd_store(a, rip("err_a"), xmm0)
    push_r(a, rcx)
    movq_rx(a, rax, xmm0)
    call_to(a, "rt_q_measure")
    pop_r(a, rcx)
    unit_row(a, rdx, rcx)
    alu_load(a, "cmp", rax, mem(rdx, 8))
    jcc(a, cc_ne, wrong_measure)
    movq_rx(a, rax, xmm0)
    untag(a, rax)
    call_to(a, "rt_q_amount_in")
    call_to(a, "rt_q_make")
    movi(a, rax, 0)
    ret(a)
    mark(a, wrong_measure)
    movi(a, rax, 2)
    ret(a)

    # rt_q_negate: xmm0 a value that isn't a number: if it is an amount, its negative, new, in xmm0 with rax 1;
    # else rax 0, and xmm0 is kept
    set not_negated to new_label(a)
    mark(a, "rt_q_negate")
    movq_rx(a, rax, xmm0)
    call_to(a, "rt_q_measure")
    alui(a, "cmp", rax, -1)
    jcc(a, cc_e, not_negated)
    movq_rx(a, rax, xmm0)
    untag(a, rax)
    load(a, rcx, mem(rax, 8))
    load(a, rax, mem(rax, 0))
    bit_op(a, "btc", rax, 63)
    movq_xr(a, xmm0, rax)
    call_to(a, "rt_q_make")
    movi(a, rax, 1)
    ret(a)
    mark(a, not_negated)
    movi(a, rax, 0)
    ret(a)

    # rt_q_math: rcx what (0 for +, 1 for -, 2 for *, 3 for /), and xmm2 and xmm1 the two sides, when they
    # aren't both numbers: what vm.js's plus and arithmetic make of amounts, in xmm0 with rax 1; or rax 0 if
    # they aren't amounts it works on, or 2 for dividing by zero, with xmm1 and xmm2 kept
    set q_times to new_label(a)
    set q_over to new_label(a)
    set q_none to new_label(a)
    set q_zero to new_label(a)
    set q_done to new_label(a)
    set q_out to new_label(a)
    set q_minus to new_label(a)
    set q_summed to new_label(a)
    set q_number_first to new_label(a)
    set q_by_amount to new_label(a)
    set q_by_ready to new_label(a)
    set q_divide to new_label(a)
    mark(a, "rt_q_math")
    push_r(a, rbx)
    mov_rr(a, rbx, rcx)
    alui(a, "cmp", rbx, 2)
    jcc(a, cc_e, q_times)
    jcc(a, cc_a, q_over)
    movapd(a, xmm0, xmm2) # + and -: two amounts of one measure, in the first's unit
    call_to(a, "rt_q_pair")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, q_none)
    test_rr(a, rbx, rbx)
    jcc(a, cc_ne, q_minus)
    sse_math(a, "+", xmm0, reg_at(xmm1))
    jmp_to(a, q_summed)
    mark(a, q_minus)
    sse_math(a, "-", xmm0, reg_at(xmm1))
    mark(a, q_summed)
    movq_rx(a, rax, xmm2)
    untag(a, rax)
    load(a, rcx, mem(rax, 8))
    call_to(a, "rt_q_make")
    jmp_to(a, q_done)
    mark(a, q_times) # an amount times a number, either way round
    movq_rx(a, rax, xmm2)
    call_to(a, "rt_q_measure")
    alui(a, "cmp", rax, -1)
    jcc(a, cc_e, q_number_first)
    odd_jump(a, xmm1, q_none)
    movq_rx(a, rax, xmm2)
    untag(a, rax)
    movsd_load(a, xmm0, mem(rax, 0))
    sse_math(a, "*", xmm0, reg_at(xmm1))
    load(a, rcx, mem(rax, 8))
    call_to(a, "rt_q_make")
    jmp_to(a, q_done)
    mark(a, q_number_first)
    odd_jump(a, xmm2, q_none)
    movq_rx(a, rax, xmm1)
    call_to(a, "rt_q_measure")
    alui(a, "cmp", rax, -1)
    jcc(a, cc_e, q_none)
    movq_rx(a, rax, xmm1)
    untag(a, rax)
    movapd(a, xmm0, xmm2)
    sse_math(a, "*", xmm0, mem(rax, 0))
    load(a, rcx, mem(rax, 8))
    call_to(a, "rt_q_make")
    jmp_to(a, q_done)
    mark(a, q_over) # an amount over a number, which gives an amount, or over one of the same measure, a number
    movq_rx(a, rax, xmm2)
    call_to(a, "rt_q_measure")
    alui(a, "cmp", rax, -1)
    jcc(a, cc_e, q_none)
    movapd(a, xmm0, xmm2)
    odd_jump(a, xmm1, q_by_amount)
    movapd(a, xmm3, xmm1)
    movi(a, rbx, 0)
    movq_rx(a, rax, xmm2)
    untag(a, rax)
    movsd_load(a, xmm0, mem(rax, 0))
    jmp_to(a, q_by_ready)
    mark(a, q_by_amount)
    call_to(a, "rt_q_pair")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, q_none)
    movapd(a, xmm3, xmm1)
    movi(a, rbx, 1)
    mark(a, q_by_ready) # xmm0 the amount, xmm3 what it's divided by
    load_bits(a, xmm4, double_bytes(0))
    ucomisd(a, xmm3, reg_at(xmm4))
    jcc(a, cc_p, q_divide)
    jcc(a, cc_e, q_zero)
    mark(a, q_divide)
    sse_math(a, "/", xmm0, reg_at(xmm3))
    test_rr(a, rbx, rbx)
    jcc(a, cc_ne, q_done)
    movq_rx(a, rax, xmm2)
    untag(a, rax)
    load(a, rcx, mem(rax, 8))
    call_to(a, "rt_q_make")
    mark(a, q_done)
    movi(a, rax, 1)
    jmp_to(a, q_out)
    mark(a, q_zero)
    movi(a, rax, 2)
    jmp_to(a, q_out)
    mark(a, q_none)
    movi(a, rax, 0)
    mark(a, q_out)
    pop_r(a, rbx)
    ret(a)

    # rt_q_word: rax an amount (untagged): the word its unit is written with, for one if its amount is 1 or -1
    # to 15 digits, else for many, as a text (untagged) in rax; uses rcx, rdx, rsi, rdi, r8 to r11 and xmm0 to
    # xmm4
    set many to new_label(a)
    set worded to new_label(a)
    mark(a, "rt_q_word")
    push_r(a, rbx)
    mov_rr(a, rbx, rax)
    movsd_load(a, xmm0, mem(rbx, 0))
    abs_sd(a, xmm0)
    load_bits(a, xmm1, double_bytes(1))
    call_to(a, "rt_order")
    load(a, rcx, mem(rbx, 8))
    unit_row(a, rdx, rcx)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, many)
    load(a, rax, mem(rdx, 16))
    jmp_to(a, worded)
    mark(a, many)
    load(a, rax, mem(rdx, 24))
    mark(a, worded)
    pop_r(a, rbx)
    ret(a)

    # rt_q_show: rax an amount (untagged), as `say` shows it, into the builder: its amount, then its unit's word
    mark(a, "rt_q_show")
    push_r(a, rbx)
    mov_rr(a, rbx, rax)
    movi(a, rcx, 32)
    call_to(a, "rt_b_room")
    load(a, rdi, rip("b_ptr"))
    alu_load(a, "add", rdi, rip("b_len"))
    load(a, rax, mem(rbx, 0))
    call_to(a, "rt_fmt")
    alu_load(a, "sub", rdi, rip("b_ptr"))
    store(a, rip("b_len"), rdi)
    movi(a, rax, 32)
    call_to(a, "rt_b_byte")
    mov_rr(a, rax, rbx)
    call_to(a, "rt_q_word")
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    pop_r(a, rbx)
    jmp_to(a, "rt_b_bytes")

    # rt_q_kind: rax an amount: what it measures, as vm.js's kindOf says it, into the builder
    mark(a, "rt_q_kind")
    call_to(a, "rt_q_measure")
    shifti(a, "shl", rax, 3)
    lea(a, rcx, rip("measure_table"))
    alu(a, "add", rax, rcx)
    load(a, rax, mem(rax, 0))
    load(a, rcx, mem(rax, 0))
    load(a, rsi, mem(rax, 16))
    jmp_to(a, "rt_b_bytes")
end

# ---------- the runtime: tables ----------
# `read table "sales.csv"`, as vm.js's tableOf makes one: a list of records, one for each row after the first,
# whose cells name the fields. Two records' fields are the same field when their names are the same text, so
# a name a table makes is the program's own text of it if the program has one, or else one made the first
# time and kept for the next (rt_field_name). Then `price in sales`, and `total of`, `average of`, `largest
# of` and `smallest of`, which work on any list. Only a program that uses one of them gets this code.

set table_words to list of "total", "average", "largest", "smallest"

# register dst: item k of the list (untagged) in register list_reg, where k is in register index_reg, which is
# kept
to item_at with a, dst, list_reg, index_reg
    load(a, dst, mem(list_reg, 16))
    shifti(a, "shl", index_reg, 3)
    alu(a, "add", dst, index_reg)
    shifti(a, "shr", index_reg, 3)
    load(a, dst, mem(dst, 0))
end

# jumps to `label` if the row in register r (a list of texts, untagged) is a blank line: one cell, and that
# empty; uses rcx
to blank_row_jump with a, r, label
    set not_blank to new_label(a)
    alu_at(a, "cmp", mem(r, 0), 1)
    jcc(a, cc_a, not_blank)
    load(a, rcx, mem(r, 16))
    load(a, rcx, mem(rcx, 0))
    untag(a, rcx)
    alu_at(a, "cmp", mem(rcx, 0), 0)
    jcc(a, cc_e, label)
    mark(a, not_blank)
end

to emit_tables with a
    # rt_field_name: rsi and rcx, a field's name as bytes: the one text there is for it, untagged, in rax; the
    # program's own, or one made the first time a table named it, kept in tb_names. Keeps rbx and r12 to r15.
    set own_loop to new_label(a)
    set own_next to new_label(a)
    set made_loop to new_label(a)
    set made_next to new_label(a)
    set make_it to new_label(a)
    set have_list to new_label(a)
    set name_found to new_label(a)
    mark(a, "rt_field_name")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    mov_rr(a, r12, rsi)
    mov_rr(a, r13, rcx)
    lea(a, rbx, rip("text_table"))
    load(a, r14, mem(rbx, 0))
    alui(a, "add", rbx, 8)
    mark(a, own_loop) # the program's texts
    test_rr(a, r14, r14)
    jcc(a, cc_e, made_loop)
    load(a, rax, mem(rbx, 0))
    alu_load(a, "cmp", r13, mem(rax, 0))
    jcc(a, cc_ne, own_next)
    mov_rr(a, rsi, r12)
    load(a, rdi, mem(rax, 16))
    mov_rr(a, rcx, r13)
    raw(a, list of 0xF3, 0xA6) # repe cmpsb
    jcc(a, cc_e, name_found)
    mark(a, own_next)
    alui(a, "add", rbx, 8)
    dec_r(a, r14)
    jmp_to(a, own_loop)
    mark(a, made_loop) # the ones tables made
    load(a, rbx, rip("tb_names"))
    test_rr(a, rbx, rbx)
    jcc(a, cc_e, make_it)
    untag(a, rbx)
    movi(a, r14, 0)
    set made_each to new_label(a)
    mark(a, made_each)
    alu_load(a, "cmp", r14, mem(rbx, 0))
    jcc(a, cc_ae, make_it)
    item_at(a, rax, rbx, r14)
    untag(a, rax)
    alu_load(a, "cmp", r13, mem(rax, 0))
    jcc(a, cc_ne, made_next)
    mov_rr(a, rsi, r12)
    load(a, rdi, mem(rax, 16))
    mov_rr(a, rcx, r13)
    raw(a, list of 0xF3, 0xA6)
    jcc(a, cc_e, name_found)
    mark(a, made_next)
    inc_r(a, r14)
    jmp_to(a, made_each)
    mark(a, make_it) # new: made, and kept
    mov_rr(a, rsi, r12)
    mov_rr(a, rcx, r13)
    call_to(a, "rt_text_from")
    mov_rr(a, rbx, rax)
    load(a, rax, rip("tb_names"))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, have_list)
    movi(a, rcx, 0)
    call_to(a, "rt_list_make")
    store(a, rip("tb_names"), rax)
    mark(a, have_list)
    mov_rr(a, rdx, rbx)
    call_to(a, "rt_list_push")
    mov_rr(a, rax, rbx)
    untag(a, rax)
    mark(a, name_found)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_tb_cell: what the builder holds, a cell, goes at the end of the row tb_row, and the builder starts
    # again; rt_tb_row: tb_row goes at the end of tb_rows, and a new row starts. Both keep rbx and r12 to r15.
    mark(a, "rt_tb_cell")
    call_to(a, "rt_b_text")
    mov_rr(a, rdx, rax)
    load(a, rax, rip("tb_row"))
    call_to(a, "rt_list_push")
    jmp_to(a, "rt_b_reset")
    mark(a, "rt_tb_row")
    load(a, rdx, rip("tb_row"))
    load(a, rax, rip("tb_rows"))
    call_to(a, "rt_list_push")
    movi(a, rcx, 0)
    call_to(a, "rt_list_make")
    store(a, rip("tb_row"), rax)
    ret(a)

    # rt_tb_name: rax a header's cell (untagged), r12 which (from 0), tb_fields the names of the ones before
    # it: its field's name, as tableOf makes it, untagged in rax. Letters in lower case, a run of anything
    # but a to z, digits and _ one _, and none at either end; column_ and its number if that leaves nothing,
    # or column_ before it if it starts with a digit; then _ and its number as often as an earlier one has it.
    set name_loop to new_label(a)
    set name_good to new_label(a)
    set name_next to new_label(a)
    set name_done to new_label(a)
    set not_upper to new_label(a)
    set trim_front to new_label(a)
    set trim_back to new_label(a)
    set trimmed to new_label(a)
    set not_empty to new_label(a)
    set plain_name to new_label(a)
    set named to new_label(a)
    set seek_taken to new_label(a)
    set taken to new_label(a)
    set unique to new_label(a)
    mark(a, "rt_tb_name")
    push_r(a, rbx)
    mov_rr(a, rbx, rax)
    call_to(a, "rt_b_reset")
    movi(a, r8, 0) # where in the cell
    movi(a, r9, 0) # 1 in a run of what becomes _
    mark(a, name_loop)
    alu_load(a, "cmp", r8, mem(rbx, 0))
    jcc(a, cc_ae, name_done)
    load(a, rsi, mem(rbx, 16))
    alu(a, "add", rsi, r8)
    load8(a, rax, mem(rsi, 0))
    lea(a, rdx, mem(rax, -65))
    alui(a, "cmp", rdx, 25)
    jcc(a, cc_a, not_upper)
    alui(a, "add", rax, 32)
    mark(a, not_upper)
    lea(a, rdx, mem(rax, -97))
    alui(a, "cmp", rdx, 25)
    jcc(a, cc_be, name_good)
    lea(a, rdx, mem(rax, -48))
    alui(a, "cmp", rdx, 9)
    jcc(a, cc_be, name_good)
    alui(a, "cmp", rax, 95)
    jcc(a, cc_e, name_good)
    test_rr(a, r9, r9)
    jcc(a, cc_ne, name_next)
    movi(a, r9, 1)
    movi(a, rax, 95)
    call_to(a, "rt_b_byte")
    jmp_to(a, name_next)
    mark(a, name_good)
    movi(a, r9, 0)
    call_to(a, "rt_b_byte")
    mark(a, name_next)
    inc_r(a, r8)
    jmp_to(a, name_loop)
    mark(a, name_done) # without the _ at either end, as a text for now
    load(a, rsi, rip("b_ptr"))
    load(a, rcx, rip("b_len"))
    movi(a, r8, 0)
    mark(a, trim_front)
    alu(a, "cmp", r8, rcx)
    jcc(a, cc_ae, trim_back)
    mov_rr(a, rax, rsi)
    alu(a, "add", rax, r8)
    load8(a, rax, mem(rax, 0))
    alui(a, "cmp", rax, 95)
    jcc(a, cc_ne, trim_back)
    inc_r(a, r8)
    jmp_to(a, trim_front)
    mark(a, trim_back)
    alu(a, "cmp", rcx, r8)
    jcc(a, cc_be, trimmed)
    mov_rr(a, rax, rsi)
    alu(a, "add", rax, rcx)
    load8(a, rax, mem(rax, -1))
    alui(a, "cmp", rax, 95)
    jcc(a, cc_ne, trimmed)
    dec_r(a, rcx)
    jmp_to(a, trim_back)
    mark(a, trimmed)
    alu(a, "add", rsi, r8)
    alu(a, "sub", rcx, r8)
    call_to(a, "rt_text_from")
    mov_rr(a, rbx, rax)
    untag(a, rbx)
    call_to(a, "rt_b_reset")
    alu_at(a, "cmp", mem(rbx, 0), 0)
    jcc(a, cc_ne, not_empty)
    b_text(a, "column_")
    lea(a, rax, mem(r12, 1))
    call_to(a, "rt_e_plain")
    jmp_to(a, named)
    mark(a, not_empty)
    load(a, rsi, mem(rbx, 16))
    load8(a, rax, mem(rsi, 0))
    lea(a, rdx, mem(rax, -48))
    alui(a, "cmp", rdx, 9)
    jcc(a, cc_a, plain_name)
    b_text(a, "column_")
    mark(a, plain_name)
    load(a, rcx, mem(rbx, 0))
    load(a, rsi, mem(rbx, 16))
    call_to(a, "rt_b_bytes")
    mark(a, named) # an earlier field has it: _ and this one's number after it, until none has
    load(a, rsi, rip("b_ptr"))
    load(a, rcx, rip("b_len"))
    call_to(a, "rt_field_name")
    load(a, rcx, rip("tb_fields"))
    movi(a, rdx, 0)
    mark(a, seek_taken)
    alu(a, "cmp", rdx, r12)
    jcc(a, cc_ae, unique)
    mov_rr(a, r8, rdx)
    shifti(a, "shl", r8, 3)
    alu(a, "add", r8, rcx)
    alu_load(a, "cmp", rax, mem(r8, 0))
    jcc(a, cc_e, taken)
    inc_r(a, rdx)
    jmp_to(a, seek_taken)
    mark(a, taken)
    movi(a, rax, 95)
    call_to(a, "rt_b_byte")
    lea(a, rax, mem(r12, 1))
    call_to(a, "rt_e_plain")
    jmp_to(a, named)
    mark(a, unique)
    pop_r(a, rbx)
    ret(a)

    # rt_table: xmm0 a CSV file's text: its table, a new list of records, in xmm0 with rax 0. Cells in quotes
    # can hold commas, line breaks and "" for a quote; a blank line is no row; a cell that is a number is that
    # number, an empty one (or one its row is missing) nothing, and any other text.
    set cells_loop to new_label(a)
    set cells_done to new_label(a)
    set plain to new_label(a)
    set not_quote to new_label(a)
    set keep_char to new_label(a)
    set close_quote to new_label(a)
    set cell_end to new_label(a)
    set row_end to new_label(a)
    set row_end_cr to new_label(a)
    set next_char to new_label(a)
    set last_row to new_label(a)
    set rows_made to new_label(a)
    set seek_head to new_label(a)
    set got_head to new_label(a)
    set no_head to new_label(a)
    set heads_loop to new_label(a)
    set heads_done to new_label(a)
    set data_loop to new_label(a)
    set data_done to new_label(a)
    set fields_loop to new_label(a)
    set fields_done to new_label(a)
    set no_value to new_label(a)
    set as_text to new_label(a)
    set put_value to new_label(a)
    set table_out to new_label(a)
    mark(a, "rt_table")
    need_text(a, xmm0, "'read table'")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    movq_rx(a, rbx, xmm0) # rbx the text, r12 where in it
    untag(a, rbx)
    movi(a, rcx, 0)
    call_to(a, "rt_list_make")
    store(a, rip("tb_rows"), rax)
    movi(a, rcx, 0)
    call_to(a, "rt_list_make")
    store(a, rip("tb_row"), rax)
    storei(a, rip("tb_quoted"), 0)
    call_to(a, "rt_b_reset")
    movi(a, r12, 0)
    mark(a, cells_loop) # first its rows, each a list of its cells' texts
    alu_load(a, "cmp", r12, mem(rbx, 0))
    jcc(a, cc_ae, cells_done)
    load(a, rsi, mem(rbx, 16))
    alu(a, "add", rsi, r12)
    load8(a, rax, mem(rsi, 0))
    load(a, rcx, rip("tb_quoted"))
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, plain)
    alui(a, "cmp", rax, 34) # in quotes: "" is a quote, and " alone ends them
    jcc(a, cc_ne, keep_char)
    lea(a, rcx, mem(r12, 1))
    alu_load(a, "cmp", rcx, mem(rbx, 0))
    jcc(a, cc_ae, close_quote)
    load8(a, rcx, mem(rsi, 1))
    alui(a, "cmp", rcx, 34)
    jcc(a, cc_ne, close_quote)
    inc_r(a, r12)
    jmp_to(a, keep_char)
    mark(a, close_quote)
    storei(a, rip("tb_quoted"), 0)
    jmp_to(a, next_char)
    mark(a, plain)
    alui(a, "cmp", rax, 34) # a quote at the start of a cell
    jcc(a, cc_ne, not_quote)
    load(a, rcx, rip("b_len"))
    test_rr(a, rcx, rcx)
    jcc(a, cc_ne, keep_char)
    storei(a, rip("tb_quoted"), 1)
    jmp_to(a, next_char)
    mark(a, not_quote)
    alui(a, "cmp", rax, 44)
    jcc(a, cc_e, cell_end)
    alui(a, "cmp", rax, 10)
    jcc(a, cc_e, row_end)
    alui(a, "cmp", rax, 13)
    jcc(a, cc_e, row_end_cr)
    mark(a, keep_char)
    call_to(a, "rt_b_byte")
    jmp_to(a, next_char)
    mark(a, cell_end)
    call_to(a, "rt_tb_cell")
    jmp_to(a, next_char)
    mark(a, row_end_cr) # \r\n is one line break
    call_to(a, "rt_tb_cell")
    call_to(a, "rt_tb_row")
    lea(a, rcx, mem(r12, 1))
    alu_load(a, "cmp", rcx, mem(rbx, 0))
    jcc(a, cc_ae, next_char)
    load(a, rsi, mem(rbx, 16))
    alu(a, "add", rsi, rcx)
    load8(a, rax, mem(rsi, 0))
    alui(a, "cmp", rax, 10)
    jcc(a, cc_ne, next_char)
    inc_r(a, r12)
    jmp_to(a, next_char)
    mark(a, row_end)
    call_to(a, "rt_tb_cell")
    call_to(a, "rt_tb_row")
    mark(a, next_char)
    inc_r(a, r12)
    jmp_to(a, cells_loop)
    mark(a, cells_done) # the last row, unless a line break ended it
    load(a, rax, rip("b_len"))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, last_row)
    load(a, rax, rip("tb_row"))
    untag(a, rax)
    alu_at(a, "cmp", mem(rax, 0), 0)
    jcc(a, cc_e, rows_made)
    mark(a, last_row)
    call_to(a, "rt_tb_cell")
    call_to(a, "rt_tb_row")
    mark(a, rows_made) # the first row that isn't a blank line names the fields
    load(a, r13, rip("tb_rows"))
    untag(a, r13)
    movi(a, rcx, 0)
    call_to(a, "rt_list_make")
    store(a, rip("tb_out"), rax)
    movi(a, r12, 0)
    mark(a, seek_head)
    alu_load(a, "cmp", r12, mem(r13, 0))
    jcc(a, cc_ae, data_done)
    item_at(a, r14, r13, r12)
    untag(a, r14)
    blank_row_jump(a, r14, no_head)
    jmp_to(a, got_head)
    mark(a, no_head)
    inc_r(a, r12)
    jmp_to(a, seek_head)
    mark(a, got_head) # r14 the header, r12 which row it is
    store(a, rip("tb_at"), r12)
    load(a, rcx, mem(r14, 0))
    shifti(a, "shl", rcx, 3)
    call_to(a, "rt_alloc")
    store(a, rip("tb_fields"), rax)
    movi(a, r12, 0)
    mark(a, heads_loop)
    alu_load(a, "cmp", r12, mem(r14, 0))
    jcc(a, cc_ae, heads_done)
    item_at(a, rax, r14, r12)
    untag(a, rax)
    call_to(a, "rt_tb_name")
    load(a, rcx, rip("tb_fields"))
    mov_rr(a, rdx, r12)
    shifti(a, "shl", rdx, 3)
    alu(a, "add", rcx, rdx)
    store(a, mem(rcx, 0), rax)
    inc_r(a, r12)
    jmp_to(a, heads_loop)
    mark(a, heads_done)
    load(a, r12, rip("tb_at"))
    mark(a, data_loop) # each row after it that isn't a blank line, as a record
    inc_r(a, r12)
    alu_load(a, "cmp", r12, mem(r13, 0))
    jcc(a, cc_ae, data_done)
    item_at(a, rbx, r13, r12)
    untag(a, rbx)
    blank_row_jump(a, rbx, data_loop)
    movi(a, rcx, 24)
    call_to(a, "rt_alloc")
    store(a, rip("tb_rec"), rax)
    load(a, rcx, mem(r14, 0))
    alui(a, "add", rcx, 4)
    store(a, mem(rax, 8), rcx)
    shifti(a, "shl", rcx, 4)
    call_to(a, "rt_alloc")
    load(a, rdx, rip("tb_rec"))
    store(a, mem(rdx, 16), rax)
    storei(a, rip("tb_j"), 0)
    mark(a, fields_loop)
    load(a, rcx, rip("tb_j"))
    alu_load(a, "cmp", rcx, mem(r14, 0))
    jcc(a, cc_ae, fields_done)
    alu_load(a, "cmp", rcx, mem(rbx, 0))
    jcc(a, cc_ae, no_value)
    item_at(a, rdx, rbx, rcx)
    mov_rr(a, rax, rdx)
    untag(a, rax)
    alu_at(a, "cmp", mem(rax, 0), 0)
    jcc(a, cc_e, no_value)
    push_r(a, rdx)
    call_to(a, "rt_parse_number")
    pop_r(a, rdx)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, put_value)
    movq_rx(a, rdx, xmm0)
    jmp_to(a, put_value)
    mark(a, no_value)
    movi64(a, rdx, bits_nothing)
    mark(a, put_value) # rdx the value, beside its field's name
    load(a, rax, rip("tb_rec"))
    load(a, r8, mem(rax, 16))
    load(a, rcx, rip("tb_j"))
    mov_rr(a, r9, rcx)
    shifti(a, "shl", r9, 4)
    alu(a, "add", r8, r9)
    load(a, r10, rip("tb_fields"))
    shifti(a, "shl", rcx, 3)
    alu(a, "add", r10, rcx)
    load(a, r10, mem(r10, 0))
    store(a, mem(r8, 0), r10)
    store(a, mem(r8, 8), rdx)
    alu_at(a, "add", rip("tb_j"), 1)
    jmp_to(a, fields_loop)
    mark(a, fields_done)
    load(a, rax, rip("tb_rec"))
    load(a, rcx, mem(r14, 0))
    store(a, mem(rax, 0), rcx)
    movi64(a, rcx, tag_record)
    alu(a, "or", rax, rcx)
    mov_rr(a, rdx, rax)
    load(a, rax, rip("tb_out"))
    call_to(a, "rt_list_push")
    jmp_to(a, data_loop)
    mark(a, data_done)
    movsd_load(a, xmm0, rip("tb_out"))
    for each slot_name in list of "tb_rows", "tb_row", "tb_out", "tb_rec", "tb_fields"
        storei(a, rip(slot_name), 0)
    end
    movi(a, rax, 0)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_column: xmm0 a list of records, rdx a field's name: each one's field, a new list, in xmm0 with rax 0;
    # or rax 2, with err_why 94 for what isn't a list, or rt_field's for a row
    set column_list to new_label(a)
    set column_loop to new_label(a)
    set column_done to new_label(a)
    set column_out to new_label(a)
    mark(a, "rt_column")
    store(a, rip("err_field"), rdx)
    movsd_store(a, rip("err_a"), xmm0)
    movq_rx(a, rax, xmm0)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_list)
    jcc(a, cc_e, column_list)
    storei(a, rip("err_why"), 94)
    movi(a, rax, 2)
    ret(a)
    mark(a, column_list)
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    movq_rx(a, rbx, xmm0)
    untag(a, rbx)
    mov_rr(a, r13, rdx)
    movi(a, rcx, 0)
    call_to(a, "rt_list_make")
    mov_rr(a, r14, rax)
    movi(a, r12, 0)
    mark(a, column_loop)
    alu_load(a, "cmp", r12, mem(rbx, 0))
    jcc(a, cc_ae, column_done)
    item_at(a, rax, rbx, r12)
    movq_xr(a, xmm0, rax)
    mov_rr(a, rdx, r13)
    call_to(a, "rt_field")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, column_out)
    movq_rx(a, rdx, xmm0)
    mov_rr(a, rax, r14)
    call_to(a, "rt_list_push")
    inc_r(a, r12)
    jmp_to(a, column_loop)
    mark(a, column_done)
    movq_xr(a, xmm0, r14)
    movi(a, rax, 0)
    mark(a, column_out)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_total, rt_average, rt_largest, rt_smallest: xmm0 a list: what vm.js makes of the items in it that
    # aren't nothing, as a spreadsheet skips empty cells, in xmm0 with rax 0; or rax 2 with err_why 90 to 96
    # and err_what the phrase's name
    set not_list to new_label(a)
    for each table_word in table_words
        mark(a, "rt_" + table_word)
        lea(a, rax, rip(text_object(a, "'" + table_word + " of'")))
        store(a, rip("err_what"), rax)
        movsd_store(a, rip("err_a"), xmm0)
        movq_rx(a, rax, xmm0)
        shifti(a, "shr", rax, 48)
        alui(a, "cmp", rax, kind_list)
        jcc(a, cc_ne, not_list)
        movi(a, rcx, 0)
        if table_word is "average" or table_word is "smallest"
            movi(a, rcx, 1)
        end
        if table_word is "total" or table_word is "average"
            jmp_to(a, "rt_tb_sum")
        else
            jmp_to(a, "rt_tb_best")
        end
    end
    mark(a, not_list)
    storei(a, rip("err_why"), 90)
    movi(a, rax, 2)
    ret(a)

    # rt_tb_sum: xmm0 a list, rcx 0 for its total or 1 for its average: numbers, or amounts of one measure
    # (in the first one's unit), added up in order, as vm.js's sumOf does
    set sum_loop to new_label(a)
    set summed to new_label(a)
    set odd_item to new_label(a)
    set number_more to new_label(a)
    set not_numbers to new_label(a)
    set cant_add to new_label(a)
    set some_items to new_label(a)
    set give_sum to new_label(a)
    set shaped to new_label(a)
    set sum_out to new_label(a)
    set empty_list to new_label(a)
    mark(a, "rt_tb_sum")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    movq_rx(a, rbx, xmm0)
    untag(a, rbx)
    mov_rr(a, r14, rcx)
    movi(a, r12, 0) # where in the list
    movi(a, r13, 0) # how many added so far
    mark(a, sum_loop)
    alu_load(a, "cmp", r12, mem(rbx, 0))
    jcc(a, cc_ae, summed)
    item_at(a, rax, rbx, r12)
    inc_r(a, r12)
    movi64(a, rcx, bits_nothing)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_e, sum_loop)
    movq_xr(a, xmm0, rax)
    odd_jump(a, xmm0, odd_item)
    test_rr(a, r13, r13)
    jcc(a, cc_ne, number_more)
    movsd_store(a, rip("tb_sum"), xmm0)
    movsd_store(a, rip("tb_first"), xmm0)
    inc_r(a, r13)
    jmp_to(a, sum_loop)
    mark(a, number_more) # a number on a sum of numbers
    movsd_load(a, xmm1, rip("tb_first"))
    odd_jump(a, xmm1, cant_add)
    movsd_load(a, xmm1, rip("tb_sum"))
    sse_math(a, "+", xmm1, reg_at(xmm0))
    movsd_store(a, rip("tb_sum"), xmm1)
    inc_r(a, r13)
    jmp_to(a, sum_loop)
    mark(a, odd_item)
    if units of a # an amount: the first, or one of the same measure as the first, in its unit
        set amount_more to new_label(a)
        movq_rx(a, rax, xmm0)
        call_to(a, "rt_q_measure")
        alui(a, "cmp", rax, -1)
        jcc(a, cc_e, not_numbers)
        test_rr(a, r13, r13)
        jcc(a, cc_ne, amount_more)
        movsd_store(a, rip("tb_first"), xmm0)
        movq_rx(a, rax, xmm0)
        untag(a, rax)
        movsd_load(a, xmm1, mem(rax, 0))
        movsd_store(a, rip("tb_sum"), xmm1)
        inc_r(a, r13)
        jmp_to(a, sum_loop)
        mark(a, amount_more)
        movapd(a, xmm1, xmm0)
        movsd_load(a, xmm0, rip("tb_first"))
        call_to(a, "rt_q_pair")
        test_rr(a, rax, rax)
        jcc(a, cc_ne, cant_add)
        movsd_load(a, xmm0, rip("tb_sum"))
        sse_math(a, "+", xmm0, reg_at(xmm1))
        movsd_store(a, rip("tb_sum"), xmm0)
        inc_r(a, r13)
        jmp_to(a, sum_loop)
    end
    mark(a, not_numbers)
    movsd_store(a, rip("err_a"), xmm0)
    storei(a, rip("err_why"), 91)
    movi(a, rax, 2)
    jmp_to(a, sum_out)
    mark(a, cant_add) # the item just looked at, and the first
    load(a, rax, mem(rbx, 16))
    mov_rr(a, rcx, r12)
    dec_r(a, rcx)
    shifti(a, "shl", rcx, 3)
    alu(a, "add", rax, rcx)
    load(a, rax, mem(rax, 0))
    store(a, rip("err_a"), rax)
    load(a, rax, rip("tb_first"))
    store(a, rip("err_b"), rax)
    storei(a, rip("err_why"), 92)
    movi(a, rax, 2)
    jmp_to(a, sum_out)
    mark(a, summed)
    test_rr(a, r13, r13)
    jcc(a, cc_ne, some_items)
    test_rr(a, r14, r14)
    jcc(a, cc_ne, empty_list)
    movi(a, rax, 0)
    movq_xr(a, xmm0, rax)
    jmp_to(a, sum_out)
    mark(a, some_items)
    movsd_load(a, xmm0, rip("tb_sum"))
    test_rr(a, r14, r14)
    jcc(a, cc_e, shaped)
    cvtsi2sd(a, xmm1, r13)
    sse_math(a, "/", xmm0, reg_at(xmm1))
    mark(a, shaped)
    if units of a # a sum of amounts is an amount of the first one's unit
        set plain_sum to new_label(a)
        load(a, rax, rip("tb_first"))
        mov_rr(a, rcx, rax)
        shifti(a, "shr", rcx, 48)
        alui(a, "cmp", rcx, kind_quantity)
        jcc(a, cc_ne, plain_sum)
        untag(a, rax)
        load(a, rcx, mem(rax, 8))
        call_to(a, "rt_q_make")
        mark(a, plain_sum)
    end
    movi(a, rax, 0)
    jmp_to(a, sum_out)
    mark(a, empty_list)
    storei(a, rip("err_why"), 93)
    movi(a, rax, 2)
    mark(a, sum_out)
    storei(a, rip("tb_first"), 0)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_tb_best: xmm0 a list, rcx 0 for its largest or 1 for its smallest: the first item that no later one
    # beats, as the engines compare them
    set best_loop to new_label(a)
    set best_compare to new_label(a)
    set best_less to new_label(a)
    set best_compared to new_label(a)
    set best_failed to new_label(a)
    set best_chosen to new_label(a)
    set best_out to new_label(a)
    mark(a, "rt_tb_best")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    movq_rx(a, rbx, xmm0)
    untag(a, rbx)
    mov_rr(a, r14, rcx)
    movi(a, r12, 0)
    movi(a, r13, 0)
    mark(a, best_loop)
    alu_load(a, "cmp", r12, mem(rbx, 0))
    jcc(a, cc_ae, best_chosen)
    item_at(a, rax, rbx, r12)
    inc_r(a, r12)
    movi64(a, rcx, bits_nothing)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_e, best_loop)
    test_rr(a, r13, r13)
    jcc(a, cc_ne, best_compare)
    store(a, rip("tb_best"), rax)
    inc_r(a, r13)
    jmp_to(a, best_loop)
    mark(a, best_compare)
    store(a, rip("tb_item"), rax)
    movq_xr(a, xmm0, rax)
    movsd_load(a, xmm1, rip("tb_best"))
    test_rr(a, r14, r14)
    jcc(a, cc_ne, best_less)
    call_to(a, "rt_cmp_gt")
    jmp_to(a, best_compared)
    mark(a, best_less)
    call_to(a, "rt_cmp_lt")
    mark(a, best_compared)
    alui(a, "cmp", rax, 1)
    jcc(a, cc_a, best_failed)
    jcc(a, cc_ne, best_loop)
    load(a, rax, rip("tb_item"))
    store(a, rip("tb_best"), rax)
    jmp_to(a, best_loop)
    mark(a, best_failed) # err_a and err_b are the two, from the comparison
    mov_rr(a, rax, r14)
    alui(a, "add", rax, 95)
    store(a, rip("err_why"), rax)
    movi(a, rax, 2)
    jmp_to(a, best_out)
    mark(a, best_chosen)
    test_rr(a, r13, r13)
    set some_best to new_label(a)
    jcc(a, cc_ne, some_best)
    storei(a, rip("err_why"), 93)
    movi(a, rax, 2)
    jmp_to(a, best_out)
    mark(a, some_best)
    movsd_load(a, xmm0, rip("tb_best"))
    movi(a, rax, 0)
    mark(a, best_out)
    for each slot_name in list of "tb_best", "tb_item", "tb_first"
        storei(a, rip(slot_name), 0)
    end
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_why_table: what was wrong, from err_why, into the builder, as vm.js's tables say it
    set w91 to new_label(a)
    set w92 to new_label(a)
    set w93 to new_label(a)
    set w94 to new_label(a)
    set w95 to new_label(a)
    set w96 to new_label(a)
    mark(a, "rt_why_table")
    load(a, rax, rip("err_why"))
    alui(a, "cmp", rax, 3)
    jcc(a, cc_be, "rt_why_field")
    alui(a, "cmp", rax, 20)
    jcc(a, cc_b, "rt_why_builtin")
    for each pair in list of (list of 91, w91), (list of 92, w92), (list of 93, w93), (list of 94, w94), (list of 95, w95), (list of 96, w96)
        alui(a, "cmp", rax, item 1 of pair)
        jcc(a, cc_e, item 2 of pair)
    end
    what_name(a) # 90
    b_text(a, " needs a list, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, w91)
    what_name(a)
    b_text(a, " needs numbers, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, w92)
    what_name(a)
    b_text(a, " can't add ")
    load(a, rax, rip("err_a"))
    call_to(a, "rt_e_kind")
    b_text(a, " to ")
    load(a, rax, rip("err_b"))
    jmp_to(a, "rt_e_kind")
    mark(a, w93)
    what_name(a)
    b_text(a, " needs a list with something in it")
    ret(a)
    mark(a, w94)
    b_text(a, "'")
    field_name(a)
    b_text(a, " in' needs a list of records, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    for each pair in list of (list of w95, "greater than"), (list of w96, "less than")
        mark(a, item 1 of pair)
        b_text(a, "can't check if ")
        load(a, rax, rip("err_a"))
        call_to(a, "rt_e_kind")
        b_text(a, " is " + item 2 of pair + " ")
        load(a, rax, rip("err_b"))
        jmp_to(a, "rt_e_kind")
    end
end

