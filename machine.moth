# ---------- the end of Unicode's cases ----------

# ---------- the runtime: upper and lower case ----------
# `uppercase of` and `lowercase of`, as JavaScript's toUpperCase and toLowerCase: ASCII straight away, and
# any other character from the tables above, found by halving. A Σ in lower case is ς at the end of a word,
# which is when a cased character comes before it and none after, not counting case-ignorable ones between,
# and σ anywhere else. Only a program that changes case carries all this.

# the bytes UTF-8 writes a character as
to utf8_bytes_of with code
    set out to empty list
    if code is less than 128
        add code to out
    else if code is less than 2048
        add 192 + shift code right by 6 to out
        add 128 + (code bit and 63) to out
    else if code is less than 65536
        add 224 + shift code right by 12 to out
        add 128 + ((shift code right by 6) bit and 63) to out
        add 128 + (code bit and 63) to out
    else
        add 240 + shift code right by 18 to out
        add 128 + ((shift code right by 12) bit and 63) to out
        add 128 + ((shift code right by 6) bit and 63) to out
        add 128 + (code bit and 63) to out
    end
    return out
end

# a 4-byte number, signed, into a register
to load32s with a, dst, at
    enc(a, empty list, yes, (list of 0x63), dst, at, empty list)
end

# the tables, as 4-byte numbers: each run's first, last, step and what to add; each special character, in
# order, then where its bytes are and how many, then the bytes; and the ranges' firsts and lasts
to emit_case_tables with a
    set ro to rodata of a
    pad_to(ro, 4)
    for each which in list of (list of "case_upper", case_upper_runs, case_upper_special),
        (list of "case_lower", case_lower_runs, case_lower_special)
        rodata_here(a, item 1 of which + "_runs")
        for each v in item 2 of which
            put32(ro, v)
        end
        set specials to item 3 of which
        set codes to empty list
        set places to empty list
        set blob to empty list
        set k to 1
        repeat while k is at most length of specials
            add item k of specials to codes
            set count to item (k + 1) of specials
            set made to empty list
            for each j from 1 to count
                put_all(made, utf8_bytes_of(item (k + 1 + j) of specials))
            end
            add length of blob to places
            add length of made to places
            put_all(blob, made)
            set k to k + 2 + count
        end
        rodata_here(a, item 1 of which + "_codes")
        for each v in codes
            put32(ro, v)
        end
        rodata_here(a, item 1 of which + "_places")
        for each v in places
            put32(ro, v)
        end
        rodata_here(a, item 1 of which + "_bytes")
        put_all(ro, blob)
        pad_to(ro, 4)
    end
    for each which in list of (list of "case_cased", case_cased), (list of "case_ignorable", case_ignorable)
        rodata_here(a, item 1 of which)
        for each v in item 2 of which
            put32(ro, v)
        end
    end
end

to special_count with specials
    set count to 0
    set k to 1
    repeat while k is at most length of specials
        add 1 to count
        set k to k + 2 + item (k + 1) of specials
    end
    return count
end

to emit_cases with a
    emit_case_tables(a)
    set case_common to new_label(a)
    set next_char to new_label(a)
    set cased_done to new_label(a)
    set wide to new_label(a)
    set ascii_lower to new_label(a)
    set ascii_put to new_label(a)
    set not_sigma to new_label(a)
    set not_special to new_label(a)
    set put_code to new_label(a)
    # rt_upper, rt_lower: xmm0 a text: it in upper or lower case, in xmm0, and rax 0; else rax 2
    mark(a, "rt_upper")
    need_text(a, xmm0, "'uppercase of'")
    movi(a, r8, 0)
    jmp_to(a, case_common)
    mark(a, "rt_lower")
    need_text(a, xmm0, "'lowercase of'")
    movi(a, r8, 1)
    mark(a, case_common)
    for each r in list of rbx, r12, r13, r14, r15
        push_r(a, r)
    end
    mov_rr(a, r15, r8) # 0 for upper, 1 for lower
    movq_rx(a, rbx, xmm0)
    untag(a, rbx)
    load(a, r12, mem(rbx, 16))
    mov_rr(a, r13, r12)
    alu_load(a, "add", r13, mem(rbx, 0))
    call_to(a, "rt_b_reset")
    mark(a, next_char)
    alu(a, "cmp", r12, r13)
    jcc(a, cc_ae, cased_done)
    load8(a, rax, mem(r12, 0))
    alui(a, "cmp", rax, 0x80)
    jcc(a, cc_ae, wide)
    test_rr(a, r15, r15)
    jcc(a, cc_ne, ascii_lower)
    alui(a, "cmp", rax, 97) # a to z
    jcc(a, cc_b, ascii_put)
    alui(a, "cmp", rax, 122)
    jcc(a, cc_a, ascii_put)
    alui(a, "sub", rax, 32)
    jmp_to(a, ascii_put)
    mark(a, ascii_lower)
    alui(a, "cmp", rax, 65) # A to Z
    jcc(a, cc_b, ascii_put)
    alui(a, "cmp", rax, 90)
    jcc(a, cc_a, ascii_put)
    alui(a, "add", rax, 32)
    mark(a, ascii_put)
    call_to(a, "rt_b_byte")
    inc_r(a, r12)
    jmp_to(a, next_char)
    mark(a, wide)
    mov_rr(a, rsi, r12)
    call_to(a, "rt_decode")
    char_size(a)
    mov_rr(a, r14, rdx)
    test_rr(a, r15, r15)
    jcc(a, cc_e, not_sigma)
    alui(a, "cmp", rax, 0x3A3)
    jcc(a, cc_ne, not_sigma)
    call_to(a, "rt_final_sigma")
    jmp_to(a, put_code)
    mark(a, not_sigma)
    mov_rr(a, r8, r15)
    call_to(a, "rt_case_special")
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, not_special)
    call_to(a, "rt_b_bytes")
    alu(a, "add", r12, r14)
    jmp_to(a, next_char)
    mark(a, not_special)
    mov_rr(a, r8, r15)
    call_to(a, "rt_case_map")
    mark(a, put_code)
    call_to(a, "rt_b_code")
    alu(a, "add", r12, r14)
    jmp_to(a, next_char)
    mark(a, cased_done)
    call_to(a, "rt_b_text")
    movq_xr(a, xmm0, rax)
    for each r in list of r15, r14, r13, r12, rbx
        pop_r(a, r)
    end
    movi(a, rax, 0)
    ret(a)

    # rt_case_find: rax a character, rsi a table of rcx entries of rdx bytes, each starting with a 4-byte
    # character, in order: the last entry whose character is at most rax, in r8, or 0. Uses r9 to r11.
    set halving to new_label(a)
    set go_low to new_label(a)
    set halved to new_label(a)
    set none_found to new_label(a)
    mark(a, "rt_case_find")
    movi(a, r9, 0)
    mov_rr(a, r10, rcx)
    mark(a, halving)
    alu(a, "cmp", r9, r10)
    jcc(a, cc_ae, halved)
    mov_rr(a, r11, r9)
    alu(a, "add", r11, r10)
    shifti(a, "shr", r11, 1)
    mov_rr(a, r8, r11)
    imul_rr(a, r8, rdx)
    alu(a, "add", r8, rsi)
    load32(a, r8, mem(r8, 0))
    alu(a, "cmp", r8, rax)
    jcc(a, cc_a, go_low)
    lea(a, r9, mem(r11, 1))
    jmp_to(a, halving)
    mark(a, go_low)
    mov_rr(a, r10, r11)
    jmp_to(a, halving)
    mark(a, halved)
    test_rr(a, r9, r9)
    jcc(a, cc_e, none_found)
    dec_r(a, r9)
    mov_rr(a, r8, r9)
    imul_rr(a, r8, rdx)
    alu(a, "add", r8, rsi)
    ret(a)
    mark(a, none_found)
    movi(a, r8, 0)
    ret(a)

    # rt_case_map: rax a character, r8 0 for upper case or 1 for lower: the character it becomes, in rax.
    # Every other register is kept.
    set map_lower to new_label(a)
    set map_table to new_label(a)
    set map_same to new_label(a)
    set map_add to new_label(a)
    mark(a, "rt_case_map")
    for each r in list of rcx, rdx, rsi, r8, r9, r10, r11
        push_r(a, r)
    end
    test_rr(a, r8, r8)
    jcc(a, cc_ne, map_lower)
    lea(a, rsi, rip("case_upper_runs"))
    movi(a, rcx, length of case_upper_runs / 4)
    jmp_to(a, map_table)
    mark(a, map_lower)
    lea(a, rsi, rip("case_lower_runs"))
    movi(a, rcx, length of case_lower_runs / 4)
    mark(a, map_table)
    movi(a, rdx, 16)
    call_to(a, "rt_case_find")
    test_rr(a, r8, r8)
    jcc(a, cc_e, map_same)
    load32(a, r9, mem(r8, 4))
    alu(a, "cmp", rax, r9)
    jcc(a, cc_a, map_same)
    load32(a, r9, mem(r8, 8))
    alui(a, "cmp", r9, 2)
    jcc(a, cc_ne, map_add)
    load32(a, r9, mem(r8, 0))
    mov_rr(a, r10, rax)
    alu(a, "sub", r10, r9)
    alui(a, "and", r10, 1)
    jcc(a, cc_ne, map_same)
    mark(a, map_add)
    load32s(a, r9, mem(r8, 12))
    alu(a, "add", rax, r9)
    mark(a, map_same)
    for each r in list of r11, r10, r9, r8, rsi, rdx, rcx
        pop_r(a, r)
    end
    ret(a)

    # rt_case_special: rax a character, r8 0 for upper case or 1 for lower: if it becomes more than one
    # character, their bytes, rsi and rcx; else rcx 0. Every other register is kept.
    set special_lower to new_label(a)
    set special_table to new_label(a)
    set special_none to new_label(a)
    set special_back to new_label(a)
    mark(a, "rt_case_special")
    for each r in list of rdx, r8, r9, r10, r11, rbx
        push_r(a, r)
    end
    test_rr(a, r8, r8)
    jcc(a, cc_ne, special_lower)
    lea(a, rsi, rip("case_upper_codes"))
    lea(a, rbx, rip("case_upper_places"))
    lea(a, r11, rip("case_upper_bytes"))
    movi(a, rcx, special_count(case_upper_special))
    jmp_to(a, special_table)
    mark(a, special_lower)
    lea(a, rsi, rip("case_lower_codes"))
    lea(a, rbx, rip("case_lower_places"))
    lea(a, r11, rip("case_lower_bytes"))
    movi(a, rcx, special_count(case_lower_special))
    mark(a, special_table)
    push_r(a, r11)
    movi(a, rdx, 4)
    call_to(a, "rt_case_find")
    pop_r(a, r11)
    test_rr(a, r8, r8)
    jcc(a, cc_e, special_none)
    load32(a, r9, mem(r8, 0))
    alu(a, "cmp", r9, rax)
    jcc(a, cc_ne, special_none)
    alu(a, "sub", r8, rsi) # which one: its bytes' place is twice as far into places
    alu(a, "add", r8, r8)
    alu(a, "add", r8, rbx)
    load32(a, rsi, mem(r8, 0))
    alu(a, "add", rsi, r11)
    load32(a, rcx, mem(r8, 4))
    jmp_to(a, special_back)
    mark(a, special_none)
    movi(a, rcx, 0)
    mark(a, special_back)
    for each r in list of rbx, r11, r10, r9, r8, rdx
        pop_r(a, r)
    end
    ret(a)

    # rt_case_in: rax a character, rsi ranges, rcx of them: rdx 1 if it's in one, else 0. Every other
    # register is kept.
    set in_none to new_label(a)
    set in_back to new_label(a)
    mark(a, "rt_case_in")
    for each r in list of r8, r9, r10, r11
        push_r(a, r)
    end
    movi(a, rdx, 8)
    call_to(a, "rt_case_find")
    test_rr(a, r8, r8)
    jcc(a, cc_e, in_none)
    load32(a, r9, mem(r8, 4))
    alu(a, "cmp", rax, r9)
    jcc(a, cc_a, in_none)
    movi(a, rdx, 1)
    jmp_to(a, in_back)
    mark(a, in_none)
    movi(a, rdx, 0)
    mark(a, in_back)
    for each r in list of r11, r10, r9, r8
        pop_r(a, r)
    end
    ret(a)

    # rt_final_sigma: r12 where a Σ is in the text at rbx, which ends at r13: ς if it ends a word, else σ,
    # in rax. Every other register is kept.
    set before_char to new_label(a)
    set back_byte to new_label(a)
    set after_char to new_label(a)
    set sigma_final to new_label(a)
    set sigma_not to new_label(a)
    set sigma_back to new_label(a)
    mark(a, "rt_final_sigma")
    for each r in list of rcx, rdx, rsi, rdi, r9
        push_r(a, r)
    end
    load(a, r9, mem(rbx, 16))
    mov_rr(a, rdi, r12)
    mark(a, before_char) # back past what's case-ignorable: is it cased?
    alu(a, "cmp", rdi, r9)
    jcc(a, cc_be, sigma_not)
    mark(a, back_byte)
    dec_r(a, rdi)
    load8(a, rax, mem(rdi, 0))
    alui(a, "and", rax, 0xC0)
    alui(a, "cmp", rax, 0x80)
    jcc(a, cc_e, back_byte)
    mov_rr(a, rsi, rdi)
    call_to(a, "rt_decode")
    case_ranges(a, "case_ignorable", case_ignorable)
    test_rr(a, rdx, rdx)
    jcc(a, cc_ne, before_char)
    case_ranges(a, "case_cased", case_cased)
    test_rr(a, rdx, rdx)
    jcc(a, cc_e, sigma_not)
    lea(a, rdi, mem(r12, 2))
    mark(a, after_char) # on past what's case-ignorable: is there something cased?
    alu(a, "cmp", rdi, r13)
    jcc(a, cc_ae, sigma_final)
    mov_rr(a, rsi, rdi)
    call_to(a, "rt_decode")
    char_size(a)
    alu(a, "add", rdi, rdx)
    case_ranges(a, "case_ignorable", case_ignorable)
    test_rr(a, rdx, rdx)
    jcc(a, cc_ne, after_char)
    case_ranges(a, "case_cased", case_cased)
    test_rr(a, rdx, rdx)
    jcc(a, cc_ne, sigma_not)
    mark(a, sigma_final)
    movi(a, rax, 0x3C2)
    jmp_to(a, sigma_back)
    mark(a, sigma_not)
    movi(a, rax, 0x3C3)
    mark(a, sigma_back)
    for each r in list of r9, rdi, rsi, rdx, rcx
        pop_r(a, r)
    end
    ret(a)

    # rt_b_code: rax a character: its UTF-8 bytes go in the builder; uses rax, rcx, rdx and rdi
    set two_bytes to new_label(a)
    set three_bytes to new_label(a)
    set four_bytes to new_label(a)
    mark(a, "rt_b_code")
    alui(a, "cmp", rax, 0x80)
    jcc(a, cc_ae, two_bytes)
    jmp_to(a, "rt_b_byte")
    mark(a, two_bytes)
    alui(a, "cmp", rax, 0x800)
    jcc(a, cc_ae, three_bytes)
    push_r(a, rax)
    shifti(a, "shr", rax, 6)
    alui(a, "or", rax, 0xC0)
    call_to(a, "rt_b_byte")
    pop_r(a, rax)
    alui(a, "and", rax, 63)
    alui(a, "or", rax, 0x80)
    jmp_to(a, "rt_b_byte")
    mark(a, three_bytes)
    alui(a, "cmp", rax, 0x10000)
    jcc(a, cc_ae, four_bytes)
    push_r(a, rax)
    shifti(a, "shr", rax, 12)
    alui(a, "or", rax, 0xE0)
    call_to(a, "rt_b_byte")
    load(a, rax, mem(rsp, 0))
    shifti(a, "shr", rax, 6)
    alui(a, "and", rax, 63)
    alui(a, "or", rax, 0x80)
    call_to(a, "rt_b_byte")
    pop_r(a, rax)
    alui(a, "and", rax, 63)
    alui(a, "or", rax, 0x80)
    jmp_to(a, "rt_b_byte")
    mark(a, four_bytes)
    push_r(a, rax)
    shifti(a, "shr", rax, 18)
    alui(a, "or", rax, 0xF0)
    call_to(a, "rt_b_byte")
    for each part in list of 12, 6
        load(a, rax, mem(rsp, 0))
        shifti(a, "shr", rax, part)
        alui(a, "and", rax, 63)
        alui(a, "or", rax, 0x80)
        call_to(a, "rt_b_byte")
    end
    pop_r(a, rax)
    alui(a, "and", rax, 63)
    alui(a, "or", rax, 0x80)
    jmp_to(a, "rt_b_byte")
end

# rdx 1 if the character in rax is in these ranges, else 0; keeps every other register
to case_ranges with a, label, ranges
    push_r(a, rsi)
    push_r(a, rcx)
    lea(a, rsi, rip(label))
    movi(a, rcx, length of ranges / 2)
    call_to(a, "rt_case_in")
    pop_r(a, rcx)
    pop_r(a, rsi)
end

# ---------- the runtime: drawing ----------
# The turtle, as vm.js's Turtle has it: where it is, which way it faces (90, up, to start), whether its pen
# is down, and the pen's colour (text, as the program gave it) and width. What it draws goes into a list in
# memory, each thing 64 bytes: what it is (1 a line, 2 a box, 3 a circle, 4 text), then four numbers (a
# line's ends; a box's corner, width and height; a circle's middle and radius; text's place and size), a
# line's width, its colour and, for text, the text. `clear` empties it, as the playground only shows what
# came after the last `clear`. On Windows a window shows it when the program ends (see the window, below).

set turtle_moves to list of "'move forward'", "'move back'", "'turn left'", "'turn right'"

# a 4-byte number, signed, into a register
# xmm x rounded down to a whole number (SSE4.1's roundsd)
to floor_sd with a, x, y
    enc(a, (list of 0x66), no, (list of 0x0F, 0x3A, 0x0B), x, reg_at(y), imm8(9))
end

to emit_turtle with a
    # rt_turtle_init: the turtle as it starts, before the program runs
    mark(a, "rt_turtle_init")
    load_bits(a, xmm0, double_bytes(90))
    movsd_store(a, rip("t_heading"), xmm0)
    load_bits(a, xmm0, double_bytes(2))
    movsd_store(a, rip("t_width"), xmm0)
    storei(a, rip("t_pen"), 1)
    lea(a, rax, rip(text_object(a, "#4f8ff7")))
    movi64(a, rcx, tag_text)
    alu(a, "or", rax, rcx)
    store(a, rip("t_color"), rax)
    ret(a)

    # rt_round2: xmm0 to hundredths, as the engines put a drawn thing's numbers: Math.round(n * 100) / 100,
    # and 0 rather than -0. Uses xmm1 and xmm2.
    set not_up to new_label(a)
    mark(a, "rt_round2")
    load_bits(a, xmm1, double_bytes(100))
    sse_math(a, "*", xmm0, reg_at(xmm1))
    floor_sd(a, xmm1, xmm0)
    movapd(a, xmm2, xmm0)
    sse_math(a, "-", xmm2, reg_at(xmm1))
    load_bits(a, xmm0, double_bytes(0.5))
    ucomisd(a, xmm2, reg_at(xmm0))
    jcc(a, cc_b, not_up)
    load_bits(a, xmm0, double_bytes(1))
    sse_math(a, "+", xmm1, reg_at(xmm0))
    mark(a, not_up)
    load_bits(a, xmm0, double_bytes(100))
    sse_math(a, "/", xmm1, reg_at(xmm0))
    load_bits(a, xmm0, double_bytes(0))
    sse_math(a, "+", xmm1, reg_at(xmm0)) # -0 + 0 is 0
    movapd(a, xmm0, xmm1)
    ret(a)

    # rt_pic_add: a thing drawn, from pi_kind, pi_a to pi_d, pi_w and pi_text, in the turtle's colour, goes at
    # the end of the picture's list, which grows as it needs to. Keeps every register but rax.
    set room to new_label(a)
    set some to new_label(a)
    mark(a, "rt_pic_add")
    for each r in list of rcx, rdx, rsi, rdi
        push_r(a, r)
    end
    load(a, rax, rip("pic_n"))
    alu_load(a, "cmp", rax, rip("pic_cap"))
    jcc(a, cc_b, room)
    load(a, rcx, rip("pic_cap"))
    alu(a, "add", rcx, rcx)
    jcc(a, cc_ne, some)
    movi(a, rcx, 64)
    mark(a, some)
    store(a, rip("pic_cap"), rcx)
    shifti(a, "shl", rcx, 6)
    call_to(a, "rt_alloc")
    mov_rr(a, rdi, rax)
    load(a, rsi, rip("pic_items"))
    load(a, rcx, rip("pic_n"))
    shifti(a, "shl", rcx, 3)
    rep_movsq(a)
    store(a, rip("pic_items"), rax)
    mark(a, room)
    load(a, rdi, rip("pic_n"))
    shifti(a, "shl", rdi, 6)
    alu_load(a, "add", rdi, rip("pic_items"))
    for each field in list of (list of "pi_kind", 0), (list of "pi_a", 8), (list of "pi_b", 16), (list of "pi_c", 24),
        (list of "pi_d", 32), (list of "pi_w", 40), (list of "t_color", 48), (list of "pi_text", 56)
        load(a, rax, rip(item 1 of field))
        store(a, mem(rdi, item 2 of field), rax)
    end
    alu_at(a, "add", rip("pic_n"), 1)
    for each r in list of rdi, rsi, rdx, rcx
        pop_r(a, r)
    end
    ret(a)

    # rt_pic_line: a line from (t_x, t_y) to (t_nx, t_ny), its ends to hundredths, if the pen is down
    set pen_up to new_label(a)
    mark(a, "rt_pic_line")
    load(a, rax, rip("t_pen"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, pen_up)
    for each pair in list of (list of "t_x", "pi_a"), (list of "t_y", "pi_b"), (list of "t_nx", "pi_c"), (list of "t_ny", "pi_d")
        movsd_load(a, xmm0, rip(item 1 of pair))
        call_to(a, "rt_round2")
        movsd_store(a, rip(item 2 of pair), xmm0)
    end
    load(a, rax, rip("t_width"))
    store(a, rip("pi_w"), rax)
    storei(a, rip("pi_kind"), 1)
    storei(a, rip("pi_text"), 0)
    call_to(a, "rt_pic_add")
    mark(a, pen_up)
    ret(a)

    # rt_turtle_numbers: rax a list, untagged, of rcx numbers, the one at place rdx (from 0) nothing for 16:
    # each, to hundredths, from tn0 on; rax 0, or 1 with err_a the first that isn't a number. The list is one
    # the program's own code made, so it has as many as that.
    set each_one to new_label(a)
    set fine to new_label(a)
    set not_number to new_label(a)
    set given to new_label(a)
    set numbers_done to new_label(a)
    mark(a, "rt_turtle_numbers")
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    load(a, rbx, mem(rax, 16))
    mov_rr(a, r12, rcx)
    mov_rr(a, r13, rdx)
    movi(a, r14, 0)
    mark(a, each_one)
    alu(a, "cmp", r14, r12)
    jcc(a, cc_ae, numbers_done)
    mov_rr(a, rax, r14)
    shifti(a, "shl", rax, 3)
    alu(a, "add", rax, rbx)
    movsd_load(a, xmm0, mem(rax, 0))
    alu(a, "cmp", r14, r13)
    jcc(a, cc_ne, given)
    movq_rx(a, rax, xmm0)
    movi64(a, rcx, bits_nothing)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_ne, given)
    load_bits(a, xmm0, double_bytes(16))
    mark(a, given)
    odd_jump(a, xmm0, not_number)
    call_to(a, "rt_round2")
    lea(a, rax, rip("tn0"))
    mov_rr(a, rcx, r14)
    shifti(a, "shl", rcx, 3)
    alu(a, "add", rax, rcx)
    movsd_store(a, mem(rax, 0), xmm0)
    inc_r(a, r14)
    jmp_to(a, each_one)
    mark(a, not_number)
    movsd_store(a, rip("err_a"), xmm0)
    movi(a, rax, 1)
    jmp_to(a, fine)
    mark(a, numbers_done)
    movi(a, rax, 0)
    mark(a, fine)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_turtle: rcx what to do, in vm.js's TURTLE_ACTIONS order (forward, back, left, right, up, down, color,
    # width, to, clear, box, circle, text), xmm0 what with: rax 0, or 2 with err_why for rt_why_turtle
    set acts to empty list
    for each k from 0 to 12
        add new_label(a) to acts
    end
    set wrong_kind to new_label(a)
    set wrong_numbers to new_label(a)
    set done_ok to new_label(a)
    set move_back to new_label(a)
    set turn_right to new_label(a)
    mark(a, "rt_turtle")
    for each k from 0 to 12
        alui(a, "cmp", rcx, k)
        jcc(a, cc_e, item (k + 1) of acts)
    end
    if charts of a # `draw chart of`
        alui(a, "cmp", rcx, 13)
        jcc(a, cc_e, "rt_chart")
    end
    set widget_acts to empty list
    if widgets of a # `draw button`, `draw text box`, `clear the text box`, by where compiler.moth has them
        set widget_names to list of "button", "text box", "clear text box"
        if controls of a # and checkboxes, text areas and lists
            set widget_names to list of "button", "text box", "clear text box", "checkbox", "tick", "untick", "text area", "list", "dropdown",
                "slider", "set slider"
        end
        for each widget_name in widget_names
            add new_label(a) to widget_acts
            alui(a, "cmp", rcx, slot_of_word(front's turtle_actions, widget_name) - 1)
            jcc(a, cc_e, item (length of widget_acts) of widget_acts)
        end
    end
    jmp_to(a, done_ok)
    for each k from 0 to 3 # forward, back, left, right: a number
        mark(a, item (k + 1) of acts)
        lea(a, rax, rip(text_object(a, item (k + 1) of turtle_moves)))
        store(a, rip("err_what"), rax)
        odd_jump(a, xmm0, wrong_kind)
        if k is 0 or k is 1
            if k is 1
                movq_rx(a, rax, xmm0)
                bit_op(a, "btc", rax, 63)
                movq_xr(a, xmm0, rax)
            end
            jmp_to(a, move_back)
        else
            if k is 3
                movq_rx(a, rax, xmm0)
                bit_op(a, "btc", rax, 63)
                movq_xr(a, xmm0, rax)
            end
            jmp_to(a, turn_right)
        end
    end
    mark(a, move_back) # steps from where it is, the way it faces
    movsd_store(a, rip("t_steps"), xmm0)
    movsd_load(a, xmm1, rip("t_heading"))
    load_bits(a, xmm2, double_bytes(3.141592653589793))
    sse_math(a, "*", xmm1, reg_at(xmm2))
    load_bits(a, xmm2, double_bytes(180))
    sse_math(a, "/", xmm1, reg_at(xmm2))
    movsd_store(a, rip("t_angle"), xmm1)
    enc(a, empty list, no, (list of 0xDD), 0, rip("t_angle"), empty list) # fld the angle
    raw(a, list of 0xD9, 0xFB) # fsincos: its cosine, then its sine
    enc(a, empty list, no, (list of 0xDD), 3, rip("t_cos"), empty list)
    enc(a, empty list, no, (list of 0xDD), 3, rip("t_sin"), empty list)
    movsd_load(a, xmm2, rip("t_steps"))
    sse_math(a, "*", xmm2, rip("t_cos"))
    movsd_load(a, xmm1, rip("t_x"))
    sse_math(a, "+", xmm1, reg_at(xmm2))
    movsd_store(a, rip("t_nx"), xmm1)
    movsd_load(a, xmm2, rip("t_steps"))
    sse_math(a, "*", xmm2, rip("t_sin"))
    movsd_load(a, xmm1, rip("t_y"))
    sse_math(a, "+", xmm1, reg_at(xmm2))
    movsd_store(a, rip("t_ny"), xmm1)
    call_to(a, "rt_pic_line")
    load(a, rax, rip("t_nx"))
    store(a, rip("t_x"), rax)
    load(a, rax, rip("t_ny"))
    store(a, rip("t_y"), rax)
    jmp_to(a, done_ok)
    mark(a, turn_right)
    movsd_load(a, xmm1, rip("t_heading"))
    sse_math(a, "+", xmm1, reg_at(xmm0))
    movsd_store(a, rip("t_heading"), xmm1)
    jmp_to(a, done_ok)
    mark(a, item 5 of acts) # up
    storei(a, rip("t_pen"), 0)
    jmp_to(a, done_ok)
    mark(a, item 6 of acts) # down
    storei(a, rip("t_pen"), 1)
    jmp_to(a, done_ok)
    mark(a, item 7 of acts) # color: any text
    movsd_store(a, rip("err_a"), xmm0)
    movq_rx(a, rax, xmm0)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_text)
    set colour_fine to new_label(a)
    jcc(a, cc_e, colour_fine)
    storei(a, rip("err_why"), 72)
    movi(a, rax, 2)
    ret(a)
    mark(a, colour_fine)
    movsd_store(a, rip("t_color"), xmm0)
    jmp_to(a, done_ok)
    mark(a, item 8 of acts) # width: a number above 0
    movsd_store(a, rip("err_a"), xmm0)
    set width_wrong to new_label(a)
    odd_jump(a, xmm0, width_wrong)
    load_bits(a, xmm1, double_bytes(0))
    ucomisd(a, xmm0, reg_at(xmm1))
    jcc(a, cc_be, width_wrong)
    movsd_store(a, rip("t_width"), xmm0)
    jmp_to(a, done_ok)
    mark(a, width_wrong)
    storei(a, rip("err_why"), 73)
    movi(a, rax, 2)
    ret(a)
    mark(a, item 9 of acts) # to x, y
    lea(a, rax, rip(text_object(a, "'move to'")))
    store(a, rip("err_what"), rax)
    movq_rx(a, rax, xmm0)
    untag(a, rax)
    movi(a, rcx, 2)
    movi(a, rdx, -1)
    call_to(a, "rt_turtle_numbers")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, wrong_numbers)
    load(a, rax, rip("tn0"))
    store(a, rip("t_nx"), rax)
    load(a, rax, rip("tn1"))
    store(a, rip("t_ny"), rax)
    call_to(a, "rt_pic_line")
    load(a, rax, rip("tn0"))
    store(a, rip("t_x"), rax)
    load(a, rax, rip("tn1"))
    store(a, rip("t_y"), rax)
    jmp_to(a, done_ok)
    mark(a, item 10 of acts) # clear
    storei(a, rip("pic_n"), 0)
    jmp_to(a, done_ok)
    for each shape in list of (list of 11, "'draw box'", 4, 2), (list of 12, "'draw circle'", 3, 3)
        mark(a, item (item 1 of shape) of acts)
        lea(a, rax, rip(text_object(a, item 2 of shape)))
        store(a, rip("err_what"), rax)
        movq_rx(a, rax, xmm0)
        untag(a, rax)
        movi(a, rcx, item 3 of shape)
        movi(a, rdx, -1)
        call_to(a, "rt_turtle_numbers")
        test_rr(a, rax, rax)
        jcc(a, cc_ne, wrong_numbers)
        if item 4 of shape is 3 # a circle's size is 0 or more
            set round_fine to new_label(a)
            movsd_load(a, xmm0, rip("tn2"))
            load_bits(a, xmm1, double_bytes(0))
            ucomisd(a, xmm0, reg_at(xmm1))
            jcc(a, cc_ae, round_fine)
            movsd_store(a, rip("err_a"), xmm0)
            storei(a, rip("err_why"), 74)
            movi(a, rax, 2)
            ret(a)
            mark(a, round_fine)
        end
        for each pair in list of (list of "tn0", "pi_a"), (list of "tn1", "pi_b"), (list of "tn2", "pi_c"), (list of "tn3", "pi_d")
            load(a, rax, rip(item 1 of pair))
            store(a, rip(item 2 of pair), rax)
        end
        storei(a, rip("pi_kind"), item 4 of shape)
        storei(a, rip("pi_w"), 0)
        storei(a, rip("pi_text"), 0)
        call_to(a, "rt_pic_add")
        jmp_to(a, done_ok)
    end
    mark(a, item 13 of acts) # text at x, y, size (16 if none): text as `say` shows it
    lea(a, rax, rip(text_object(a, "'draw ... at'")))
    store(a, rip("err_what"), rax)
    movq_rx(a, rax, xmm0)
    untag(a, rax)
    push_r(a, rax)
    # the text is first: the numbers after it
    load(a, rcx, mem(rax, 16))
    alui(a, "add", rcx, 8)
    store(a, rip("t_list"), rcx) # a list's items from the second on, as rt_turtle_numbers reads them
    lea(a, rax, rip("t_list"))
    alui(a, "sub", rax, 16)
    movi(a, rcx, 3)
    movi(a, rdx, 2)
    call_to(a, "rt_turtle_numbers")
    pop_r(a, rcx)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, wrong_numbers)
    set size_fine to new_label(a)
    movsd_load(a, xmm0, rip("tn2"))
    load_bits(a, xmm1, double_bytes(0))
    ucomisd(a, xmm0, reg_at(xmm1))
    jcc(a, cc_a, size_fine)
    movsd_store(a, rip("err_a"), xmm0)
    storei(a, rip("err_why"), 75)
    movi(a, rax, 2)
    ret(a)
    mark(a, size_fine)
    load(a, rcx, mem(rcx, 16)) # the text, shown
    load(a, rax, mem(rcx, 0))
    push_r(a, rax)
    call_to(a, "rt_b_reset")
    pop_r(a, rax)
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    call_to(a, "rt_b_text")
    store(a, rip("pi_text"), rax)
    for each pair in list of (list of "tn0", "pi_a"), (list of "tn1", "pi_b"), (list of "tn2", "pi_c")
        load(a, rax, rip(item 1 of pair))
        store(a, rip(item 2 of pair), rax)
    end
    storei(a, rip("pi_d"), 0)
    storei(a, rip("pi_w"), 0)
    storei(a, rip("pi_kind"), 4)
    call_to(a, "rt_pic_add")
    jmp_to(a, done_ok)
    if widgets of a
        for each widget in list of 1, 2 # a button (5), then a text box (6): label, x, y, the label as `say` shows it
            mark(a, item widget of widget_acts)
            if widget is 1
                lea(a, rax, rip(text_object(a, "'draw button'")))
            else
                lea(a, rax, rip(text_object(a, "'draw text box'")))
            end
            store(a, rip("err_what"), rax)
            movq_rx(a, rax, xmm0)
            untag(a, rax)
            push_r(a, rax)
            load(a, rcx, mem(rax, 16))
            alui(a, "add", rcx, 8)
            store(a, rip("t_list"), rcx)
            lea(a, rax, rip("t_list"))
            alui(a, "sub", rax, 16)
            movi(a, rcx, 2)
            movi(a, rdx, -1)
            call_to(a, "rt_turtle_numbers")
            pop_r(a, rcx)
            test_rr(a, rax, rax)
            jcc(a, cc_ne, wrong_numbers)
            load(a, rcx, mem(rcx, 16))
            movsd_load(a, xmm0, mem(rcx, 0))
            call_to(a, "rt_show_text")
            store(a, rip("pi_text"), rax)
            for each pair in list of (list of "tn0", "pi_a"), (list of "tn1", "pi_b")
                load(a, rax, rip(item 1 of pair))
                store(a, rip(item 2 of pair), rax)
            end
            load_bits(a, xmm0, double_bytes(30))
            movsd_store(a, rip("pi_d"), xmm0)
            if widget is 1 # 20 wide, and 10 more for each letter
                load(a, rax, rip("pi_text"))
                untag(a, rax)
                load(a, rax, mem(rax, 8))
                imul_ri(a, rax, rax, 10)
                alui(a, "add", rax, 20)
                cvtsi2sd(a, xmm0, rax)
                movsd_store(a, rip("pi_c"), xmm0)
                storei(a, rip("pi_w"), 0)
                storei(a, rip("pi_kind"), 5)
            else # 200 wide, and which box it is, by its label
                load(a, rax, rip("pi_text"))
                call_to(a, "rt_box_entry")
                store(a, rip("pi_w"), rax)
                load_bits(a, xmm0, double_bytes(200))
                movsd_store(a, rip("pi_c"), xmm0)
                storei(a, rip("pi_kind"), 6)
            end
            call_to(a, "rt_pic_add")
            jmp_to(a, done_ok)
        end
        mark(a, item 3 of widget_acts) # clear the text box: what's typed in it, if anything, goes, its cursor to its start
        call_to(a, "rt_show_text")
        call_to(a, "rt_box_find")
        test_rr(a, rax, rax)
        jcc(a, cc_e, done_ok)
        dec_r(a, rax)
        shifti(a, "shl", rax, 6)
        alu_load(a, "add", rax, rip("box_items"))
        lea(a, rcx, rip(text_object(a, "")))
        movi64(a, rdx, tag_text)
        alu(a, "or", rcx, rdx)
        store(a, mem(rax, 8), rcx)
        for each place in list of 16, 24, 32, 40
            storei(a, mem(rax, place), 0)
        end
        jmp_to(a, done_ok)
        if controls of a
            emit_control_acts(a, widget_acts, wrong_numbers, done_ok)
        end
    end
    mark(a, wrong_kind)
    movsd_store(a, rip("err_a"), xmm0)
    storei(a, rip("err_why"), 70)
    movi(a, rax, 2)
    ret(a)
    mark(a, wrong_numbers)
    storei(a, rip("err_why"), 71)
    movi(a, rax, 2)
    ret(a)
    mark(a, done_ok)
    movi(a, rax, 0)
    ret(a)

    # rt_why_turtle: what was wrong, into the builder, as vm.js's Turtle says it
    set w71 to new_label(a)
    set w72 to new_label(a)
    set w73 to new_label(a)
    set w74 to new_label(a)
    set w75 to new_label(a)
    set w77 to new_label(a)
    mark(a, "rt_why_turtle")
    load(a, rax, rip("err_why"))
    for each pair in list of (list of 71, w71), (list of 72, w72), (list of 73, w73), (list of 74, w74), (list of 75, w75), (list of 77, w77)
        alui(a, "cmp", rax, item 1 of pair)
        jcc(a, cc_e, item 2 of pair)
    end
    set w82 to new_label(a)
    set w83 to new_label(a)
    set w84 to new_label(a)
    set w85 to new_label(a)
    set w86 to new_label(a)
    if controls of a
        for each pair in list of (list of 82, w82), (list of 83, w83), (list of 84, w84), (list of 85, w85), (list of 86, w86)
            alui(a, "cmp", rax, item 1 of pair)
            jcc(a, cc_e, item 2 of pair)
        end
    end
    set w78 to new_label(a)
    set w79 to new_label(a)
    if charts of a
        alui(a, "cmp", rax, 78)
        jcc(a, cc_e, w78)
        alui(a, "cmp", rax, 79)
        jcc(a, cc_e, w79)
    end
    what_name(a) # 70
    b_text(a, " needs a number, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, w71)
    what_name(a)
    b_text(a, " needs numbers, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, w72)
    b_text(a, "'pen color' needs text like \"red\", not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_e_kind")
    mark(a, w73)
    b_text(a, "'pen width' needs a number above 0, not ")
    load(a, rax, rip("err_a"))
    movi(a, rdx, 1)
    jmp_to(a, "rt_b_value")
    mark(a, w74)
    b_text(a, "a circle's size is 0 or more, not ")
    load(a, rax, rip("err_a"))
    movi(a, rdx, 0)
    jmp_to(a, "rt_b_value")
    mark(a, w75)
    b_text(a, "text's size is a number above 0, not ")
    load(a, rax, rip("err_a"))
    movi(a, rdx, 0)
    jmp_to(a, "rt_b_value")
    mark(a, w77)
    b_text(a, "'every' needs a number above 0, not ")
    load(a, rax, rip("err_a"))
    jmp_to(a, "rt_described")
    if charts of a
        mark(a, w78)
        b_text(a, "'draw chart of' needs a list or a dictionary, not ")
        load(a, rax, rip("err_a"))
        jmp_to(a, "rt_e_kind")
        mark(a, w79)
        b_text(a, "'draw chart of' needs numbers, or amounts of one measure, not ")
        load(a, rax, rip("err_a"))
        jmp_to(a, "rt_e_kind")
    end
    if controls of a
        for each pair in list of (list of w82, "a text area's size is a number above 0, not "),
            (list of w83, "a list's size is a number above 0, not ")
            mark(a, item 1 of pair)
            b_text(a, item 2 of pair)
            load(a, rax, rip("err_a"))
            movi(a, rdx, 0)
            jmp_to(a, "rt_b_value")
        end
        mark(a, w84)
        b_text(a, "'draw list ... showing' needs a list, not ")
        load(a, rax, rip("err_a"))
        jmp_to(a, "rt_e_kind")
        mark(a, w85)
        b_text(a, "'draw dropdown ... showing' needs a list, not ")
        load(a, rax, rip("err_a"))
        jmp_to(a, "rt_e_kind")
        mark(a, w86)
        b_text(a, "'set the slider' needs a number, not ")
        load(a, rax, rip("err_a"))
        jmp_to(a, "rt_e_kind")
    end
    if widgets of a
        emit_boxes(a)
    end
end

# `draw chart of sales`, as vm.js's Turtle draws one: a bar for each number (or amount) in a list, or each
# value of a dictionary, labelled with its place in the list or its key. The longest bar is 200 long, each 30
# wide and 10 from the next, from (0, 0), with its value at its end; nothing has a label and no bar. Only a
# program that draws a chart gets this code.
to emit_chart with a
    # rt_chart: xmm0 what to chart: rax 0, or 2 with err_why 78 or 79 for rt_why_turtle
    set chart_list to new_label(a)
    set chart_dict to new_label(a)
    set entries_loop to new_label(a)
    set values_ready to new_label(a)
    set first_loop to new_label(a)
    set first_found to new_label(a)
    set sizes_loop to new_label(a)
    set sizes_done to new_label(a)
    set sized to new_label(a)
    set not_number to new_label(a)
    set biggest_loop to new_label(a)
    set scaled to new_label(a)
    set no_scale to new_label(a)
    set draw_loop to new_label(a)
    set drawn to new_label(a)
    set no_bar to new_label(a)
    set height_known to new_label(a)
    set place_label to new_label(a)
    set by_place to new_label(a)
    set labelled to new_label(a)
    set chart_out to new_label(a)
    mark(a, "rt_chart")
    movsd_store(a, rip("err_a"), xmm0)
    movq_rx(a, rax, xmm0)
    mov_rr(a, rdx, rax)
    shifti(a, "shr", rdx, 48)
    alui(a, "cmp", rdx, kind_list)
    jcc(a, cc_e, chart_list)
    alui(a, "cmp", rdx, kind_dict)
    jcc(a, cc_e, chart_dict)
    storei(a, rip("err_why"), 78)
    movi(a, rax, 2)
    ret(a)
    mark(a, chart_list) # the values: a copy of the list's items, and no keys
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    untag(a, rax)
    mov_rr(a, rbx, rax)
    load(a, r13, mem(rbx, 0))
    lea(a, rcx, mem(r13, 1))
    shifti(a, "shl", rcx, 3)
    call_to(a, "rt_alloc")
    store(a, rip("ch_vals"), rax)
    mov_rr(a, rdi, rax)
    load(a, rsi, mem(rbx, 16))
    mov_rr(a, rcx, r13)
    rep_movsq(a)
    storei(a, rip("ch_keys"), 0)
    jmp_to(a, values_ready)
    mark(a, chart_dict) # the values and the keys, in the order the keys were added
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    push_r(a, r14)
    untag(a, rax)
    mov_rr(a, rbx, rax)
    load(a, r13, mem(rbx, 0))
    lea(a, rcx, mem(r13, 1))
    shifti(a, "shl", rcx, 3)
    call_to(a, "rt_alloc")
    store(a, rip("ch_vals"), rax)
    lea(a, rcx, mem(r13, 1))
    shifti(a, "shl", rcx, 3)
    call_to(a, "rt_alloc")
    store(a, rip("ch_keys"), rax)
    movi(a, r12, 0) # which entry
    movi(a, r14, 0) # how many found
    mark(a, entries_loop)
    alu_load(a, "cmp", r12, mem(rbx, 8))
    jcc(a, cc_ae, values_ready)
    mov_rr(a, rax, r12)
    imul_ri(a, rax, rax, 24)
    alu_load(a, "add", rax, mem(rbx, 24))
    inc_r(a, r12)
    load(a, rcx, mem(rax, 0))
    movi64(a, rdx, bits_unset)
    alu(a, "cmp", rcx, rdx)
    jcc(a, cc_e, entries_loop)
    mov_rr(a, r8, r14)
    shifti(a, "shl", r8, 3)
    load(a, rdx, rip("ch_keys"))
    alu(a, "add", rdx, r8)
    store(a, mem(rdx, 0), rcx)
    load(a, rdx, rip("ch_vals"))
    alu(a, "add", rdx, r8)
    load(a, rcx, mem(rax, 8))
    store(a, mem(rdx, 0), rcx)
    inc_r(a, r14)
    jmp_to(a, entries_loop)
    mark(a, values_ready) # r13 of them: how big each is, in the first one's unit if that's an amount
    lea(a, rcx, mem(r13, 1))
    shifti(a, "shl", rcx, 3)
    call_to(a, "rt_alloc_raw")
    store(a, rip("ch_sizes"), rax)
    movi64(a, rax, bits_nothing)
    store(a, rip("ch_first"), rax)
    load(a, rbx, rip("ch_vals"))
    movi(a, r12, 0)
    mark(a, first_loop)
    alu(a, "cmp", r12, r13)
    jcc(a, cc_ae, first_found)
    mov_rr(a, rax, r12)
    shifti(a, "shl", rax, 3)
    alu(a, "add", rax, rbx)
    load(a, rax, mem(rax, 0))
    inc_r(a, r12)
    movi64(a, rcx, bits_nothing)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_e, first_loop)
    store(a, rip("ch_first"), rax)
    mark(a, first_found)
    movi(a, r12, 0)
    mark(a, sizes_loop)
    alu(a, "cmp", r12, r13)
    jcc(a, cc_ae, sizes_done)
    mov_rr(a, rax, r12)
    shifti(a, "shl", rax, 3)
    alu(a, "add", rax, rbx)
    load(a, rax, mem(rax, 0))
    movq_xr(a, xmm1, rax)
    movi64(a, rcx, bits_nothing)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_e, sized) # nothing: no bar, which its size, nothing, says
    if units of a # the first an amount: each must be one of its measure, in its unit
        set not_amount to new_label(a)
        load(a, rax, rip("ch_first"))
        mov_rr(a, rcx, rax)
        shifti(a, "shr", rcx, 48)
        alui(a, "cmp", rcx, kind_quantity)
        jcc(a, cc_ne, not_amount)
        movsd_load(a, xmm0, rip("ch_first"))
        call_to(a, "rt_q_pair")
        test_rr(a, rax, rax)
        jcc(a, cc_ne, not_number)
        movq_rx(a, rax, xmm1)
        jmp_to(a, sized)
        mark(a, not_amount)
    end
    odd_jump(a, xmm1, not_number)
    movq_rx(a, rax, xmm1)
    mark(a, sized)
    load(a, rcx, rip("ch_sizes"))
    mov_rr(a, rdx, r12)
    shifti(a, "shl", rdx, 3)
    alu(a, "add", rcx, rdx)
    store(a, mem(rcx, 0), rax)
    inc_r(a, r12)
    jmp_to(a, sizes_loop)
    mark(a, not_number)
    mov_rr(a, rax, r12)
    shifti(a, "shl", rax, 3)
    alu(a, "add", rax, rbx)
    load(a, rax, mem(rax, 0))
    store(a, rip("err_a"), rax)
    storei(a, rip("err_why"), 79)
    movi(a, rax, 2)
    jmp_to(a, chart_out)
    mark(a, sizes_done) # the biggest size, which becomes 200 long
    load_bits(a, xmm2, double_bytes(0))
    load(a, rsi, rip("ch_sizes"))
    movi(a, r12, 0)
    mark(a, biggest_loop)
    alu(a, "cmp", r12, r13)
    jcc(a, cc_ae, scaled)
    load(a, rax, mem(rsi, 0))
    alui(a, "add", rsi, 8)
    inc_r(a, r12)
    movi64(a, rcx, bits_nothing)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_e, biggest_loop)
    bit_op(a, "btr", rax, 63)
    movq_xr(a, xmm0, rax)
    ucomisd(a, xmm0, reg_at(xmm2))
    jcc(a, cc_be, biggest_loop)
    movapd(a, xmm2, xmm0)
    jmp_to(a, biggest_loop)
    mark(a, scaled)
    load_bits(a, xmm0, double_bytes(0))
    ucomisd(a, xmm2, reg_at(xmm0))
    jcc(a, cc_e, no_scale)
    load_bits(a, xmm0, double_bytes(200))
    sse_math(a, "/", xmm0, reg_at(xmm2))
    mark(a, no_scale)
    movsd_store(a, rip("ch_scale"), xmm0)
    movi(a, r12, 0)
    mark(a, draw_loop) # each bar, its value and its label
    alu(a, "cmp", r12, r13)
    jcc(a, cc_ae, drawn)
    imul_ri(a, rax, r12, 40)
    cvtsi2sd(a, xmm0, rax)
    movsd_store(a, rip("ch_x"), xmm0)
    load(a, rax, rip("ch_sizes"))
    mov_rr(a, rcx, r12)
    shifti(a, "shl", rcx, 3)
    alu(a, "add", rax, rcx)
    load(a, rax, mem(rax, 0))
    movi64(a, rcx, bits_nothing)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_e, no_bar)
    movq_xr(a, xmm0, rax)
    sse_math(a, "*", xmm0, rip("ch_scale"))
    call_to(a, "rt_round2")
    ucomisd(a, xmm0, reg_at(xmm0)) # NaN || 0 is 0
    jcc(a, cc_np, height_known)
    load_bits(a, xmm0, double_bytes(0))
    mark(a, height_known)
    movsd_store(a, rip("ch_height"), xmm0)
    load(a, rax, rip("ch_x")) # the bar
    store(a, rip("pi_a"), rax)
    load_bits(a, xmm1, double_bytes(0))
    minsd(a, xmm0, xmm1)
    movsd_store(a, rip("pi_b"), xmm0)
    load_bits(a, xmm0, double_bytes(30))
    movsd_store(a, rip("pi_c"), xmm0)
    movsd_load(a, xmm0, rip("ch_height"))
    abs_sd(a, xmm0)
    movsd_store(a, rip("pi_d"), xmm0)
    storei(a, rip("pi_kind"), 2)
    storei(a, rip("pi_w"), 0)
    storei(a, rip("pi_text"), 0)
    call_to(a, "rt_pic_add")
    call_to(a, "rt_b_reset") # its value, at its end
    load(a, rax, rip("ch_vals"))
    mov_rr(a, rcx, r12)
    shifti(a, "shl", rcx, 3)
    alu(a, "add", rax, rcx)
    load(a, rax, mem(rax, 0))
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    call_to(a, "rt_b_text")
    store(a, rip("pi_text"), rax)
    load(a, rax, rip("ch_x"))
    store(a, rip("pi_a"), rax)
    movsd_load(a, xmm0, rip("ch_height"))
    load_bits(a, xmm1, double_bytes(0))
    sse_math(a, "max", xmm0, reg_at(xmm1))
    load_bits(a, xmm1, double_bytes(4))
    sse_math(a, "+", xmm0, reg_at(xmm1))
    movsd_store(a, rip("pi_b"), xmm0)
    load_bits(a, xmm0, double_bytes(12))
    movsd_store(a, rip("pi_c"), xmm0)
    storei(a, rip("pi_d"), 0)
    storei(a, rip("pi_kind"), 4)
    storei(a, rip("pi_w"), 0)
    call_to(a, "rt_pic_add")
    jmp_to(a, place_label)
    mark(a, no_bar)
    storei(a, rip("ch_height"), 0)
    mark(a, place_label) # its label: its place, or its key
    call_to(a, "rt_b_reset")
    load(a, rax, rip("ch_keys"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, by_place)
    mov_rr(a, rcx, r12)
    shifti(a, "shl", rcx, 3)
    alu(a, "add", rax, rcx)
    load(a, rax, mem(rax, 0))
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    jmp_to(a, labelled)
    mark(a, by_place)
    lea(a, rax, mem(r12, 1))
    call_to(a, "rt_e_plain")
    mark(a, labelled)
    call_to(a, "rt_b_text")
    store(a, rip("pi_text"), rax)
    load(a, rax, rip("ch_x"))
    store(a, rip("pi_a"), rax)
    movsd_load(a, xmm0, rip("ch_height"))
    load_bits(a, xmm1, double_bytes(0))
    minsd(a, xmm0, xmm1)
    load_bits(a, xmm1, double_bytes(18))
    sse_math(a, "-", xmm0, reg_at(xmm1))
    movsd_store(a, rip("pi_b"), xmm0)
    load_bits(a, xmm0, double_bytes(12))
    movsd_store(a, rip("pi_c"), xmm0)
    storei(a, rip("pi_d"), 0)
    storei(a, rip("pi_kind"), 4)
    storei(a, rip("pi_w"), 0)
    call_to(a, "rt_pic_add")
    inc_r(a, r12)
    jmp_to(a, draw_loop)
    mark(a, drawn)
    movi(a, rax, 0)
    mark(a, chart_out)
    for each slot_name in list of "ch_vals", "ch_keys", "ch_sizes", "ch_first"
        storei(a, rip(slot_name), 0)
    end
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
end

# ---------- the runtime: buttons and text boxes ----------
# A button is a thing drawn (5), as is a text box (6), whose fifth number says which box it is: each box, by
# its label, has an entry of 64 bytes in a list of its own, its label, what's typed in it, and where its
# cursor is (see box_entry), which `clear` leaves alone, as DESIGN §36 and §41 have it. box_focus is the
# entry of the box that has the focus, from 1, or 0.

to emit_boxes with a
    # rt_show_text: xmm0 a value: as `say` shows it, as a new text, in rax
    mark(a, "rt_show_text")
    call_to(a, "rt_b_reset")
    movq_rx(a, rax, xmm0)
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    jmp_to(a, "rt_b_text")

    # rt_box_find: rax a label, as text: the entry of the box with that label, from 1, in rax, or 0 for none
    set find_loop to new_label(a)
    set find_none to new_label(a)
    set find_done to new_label(a)
    mark(a, "rt_box_find")
    for each r in list of rbx, r12, r13
        push_r(a, r)
    end
    mov_rr(a, r12, rax)
    movi(a, r13, 0)
    mark(a, find_loop)
    alu_load(a, "cmp", r13, rip("box_n"))
    jcc(a, cc_ae, find_none)
    mov_rr(a, rbx, r13)
    shifti(a, "shl", rbx, 6)
    alu_load(a, "add", rbx, rip("box_items"))
    load(a, rax, mem(rbx, 0))
    mov_rr(a, rdx, r12)
    call_to(a, "rt_equal")
    inc_r(a, r13)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, find_done)
    jmp_to(a, find_loop)
    mark(a, find_none)
    movi(a, r13, 0)
    mark(a, find_done)
    mov_rr(a, rax, r13)
    for each r in list of r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_box_entry: rax a label, as text: its entry, as rt_box_find has it, made if there isn't one yet
    set have_one to new_label(a)
    set room to new_label(a)
    set some to new_label(a)
    mark(a, "rt_box_entry")
    push_r(a, rax) # where the collector sees it
    call_to(a, "rt_box_find")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, have_one)
    load(a, rax, rip("box_n"))
    alu_load(a, "cmp", rax, rip("box_cap"))
    jcc(a, cc_b, room)
    load(a, rcx, rip("box_cap"))
    alu(a, "add", rcx, rcx)
    jcc(a, cc_ne, some)
    movi(a, rcx, 8)
    mark(a, some)
    store(a, rip("box_cap"), rcx)
    shifti(a, "shl", rcx, 6)
    call_to(a, "rt_alloc")
    mov_rr(a, rdi, rax)
    load(a, rsi, rip("box_items"))
    load(a, rcx, rip("box_n"))
    shifti(a, "shl", rcx, 3)
    rep_movsq(a)
    store(a, rip("box_items"), rax)
    mark(a, room)
    load(a, rdi, rip("box_n"))
    shifti(a, "shl", rdi, 6)
    alu_load(a, "add", rdi, rip("box_items"))
    load(a, rax, mem(rsp, 0))
    store(a, mem(rdi, 0), rax)
    lea(a, rax, rip(text_object(a, "")))
    movi64(a, rcx, tag_text)
    alu(a, "or", rax, rcx)
    store(a, mem(rdi, 8), rax)
    alu_at(a, "add", rip("box_n"), 1)
    load(a, rax, rip("box_n"))
    mark(a, have_one)
    pop_r(a, rcx)
    ret(a)

    # rt_box_text: xmm0 a label: what's typed in the box with that label, into xmm0, with rax 0 (`the text in
    # the text box`)
    set no_box to new_label(a)
    mark(a, "rt_box_text")
    call_to(a, "rt_show_text")
    call_to(a, "rt_box_find")
    test_rr(a, rax, rax)
    jcc(a, cc_e, no_box)
    dec_r(a, rax)
    shifti(a, "shl", rax, 6)
    alu_load(a, "add", rax, rip("box_items"))
    movsd_load(a, xmm0, mem(rax, 8))
    movi(a, rax, 0)
    ret(a)
    mark(a, no_box)
    load_text(a, xmm0, "")
    movi(a, rax, 0)
    ret(a)
    if controls of a
        emit_controls(a)
    end
end

# ---------- the runtime: checkboxes, text areas and lists ----------
# A checkbox is a thing drawn (10), as are a text area (11) and a list (12), whose fifth number says which it
# is. Each checkbox, by its label, has an entry of 16 bytes in a list of its own: its label, and 1 if it's
# ticked. Each list has one of 64: its label, a copy of its items, those as `say` shows them, the place of
# the one chosen (from 0, or -1 for none), and the place of the first in view. A text area's entry is a text
# box's, so the two share what's typed in them by their labels, as vm.js has it. `clear` leaves them all
# alone, as DESIGN §40 says. list_focus is the entry of the list that has the focus, from 1, or 0.

to emit_controls with a
    emit_controls_more(a)
    emit_entries(a, "tk", 4)
    emit_entries(a, "ls", 6)

    # rt_ls_rows: xmm0 a list's height: how many rows it shows, a row every 24 and at least 1, in rax; uses xmm1
    set rows_some to new_label(a)
    mark(a, "rt_ls_rows")
    load_bits(a, xmm1, double_bytes(24))
    sse_math(a, "/", xmm0, reg_at(xmm1))
    cvttsd2si(a, rax, xmm0)
    alui(a, "cmp", rax, 1)
    jcc(a, cc_ge, rows_some)
    movi(a, rax, 1)
    mark(a, rows_some)
    ret(a)

    # rt_ls_fill: rax a list of items, tn3 a list's height: the list at entry pi_w gets a copy of the items,
    # and them as `say` shows them, and its first row in view stays as near to where it was as they allow
    set fill_loop to new_label(a)
    set fill_done to new_label(a)
    mark(a, "rt_ls_fill")
    for each r in list of rbx, r12, r13
        push_r(a, r)
    end
    push_r(a, rax) # where the collector sees it
    for each field in list of 8, 16 # a copy of them, then another, which becomes them shown
        load(a, rax, mem(rsp, 0))
        untag(a, rax)
        load(a, r13, mem(rax, 0))
        mov_rr(a, rcx, r13)
        shifti(a, "shl", rcx, 3)
        call_to(a, "rt_alloc")
        mov_rr(a, rdi, rax)
        load(a, rsi, mem(rsp, 0))
        untag(a, rsi)
        load(a, rsi, mem(rsi, 16))
        mov_rr(a, rcx, r13)
        rep_movsq(a)
        mov_rr(a, rdx, rax)
        mov_rr(a, rcx, r13)
        call_to(a, "rt_list_of")
        load(a, rbx, rip("pi_w"))
        dec_r(a, rbx)
        shifti(a, "shl", rbx, 6)
        alu_load(a, "add", rbx, rip("ls_items"))
        movsd_store(a, mem(rbx, field), xmm0)
    end
    movi(a, r12, 0)
    mark(a, fill_loop)
    alu(a, "cmp", r12, r13)
    jcc(a, cc_ae, fill_done)
    load(a, rax, mem(rbx, 16))
    untag(a, rax)
    load(a, rax, mem(rax, 16))
    mov_rr(a, rcx, r12)
    shifti(a, "shl", rcx, 3)
    alu(a, "add", rax, rcx)
    movsd_load(a, xmm0, mem(rax, 0))
    call_to(a, "rt_show_text")
    load(a, rdx, mem(rbx, 16))
    untag(a, rdx)
    load(a, rdx, mem(rdx, 16))
    mov_rr(a, rcx, r12)
    shifti(a, "shl", rcx, 3)
    alu(a, "add", rdx, rcx)
    store(a, mem(rdx, 0), rax)
    inc_r(a, r12)
    jmp_to(a, fill_loop)
    mark(a, fill_done)
    movsd_load(a, xmm0, rip("tn3"))
    call_to(a, "rt_ls_rows")
    load(a, rcx, mem(rbx, 32))
    ls_keep_in_view(a)
    pop_r(a, rax)
    for each r in list of r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_ticked: xmm0 a label: whether the checkbox with that label is ticked, into xmm0, with rax 0 (`the
    # checkbox "Done" is ticked`)
    set not_ticked to new_label(a)
    mark(a, "rt_ticked")
    call_to(a, "rt_show_text")
    call_to(a, "rt_tk_find")
    test_rr(a, rax, rax)
    jcc(a, cc_e, not_ticked)
    dec_r(a, rax)
    shifti(a, "shl", rax, 4)
    alu_load(a, "add", rax, rip("tk_items"))
    load(a, rax, mem(rax, 8))
    test_rr(a, rax, rax)
    jcc(a, cc_e, not_ticked)
    load_bits(a, xmm0, bits_yes)
    movi(a, rax, 0)
    ret(a)
    mark(a, not_ticked)
    load_bits(a, xmm0, bits_no)
    movi(a, rax, 0)
    ret(a)

    # rt_choice: xmm0 a label: the item chosen in the list with that label, or nothing, into xmm0, with rax
    # 0 (`the choice in the list "Fruits"`)
    set no_choice to new_label(a)
    mark(a, "rt_choice")
    call_to(a, "rt_show_text")
    call_to(a, "rt_ls_find")
    test_rr(a, rax, rax)
    jcc(a, cc_e, no_choice)
    dec_r(a, rax)
    shifti(a, "shl", rax, 6)
    alu_load(a, "add", rax, rip("ls_items"))
    load(a, rcx, mem(rax, 24))
    test_rr(a, rcx, rcx)
    jcc(a, cc_s, no_choice)
    load(a, rdx, mem(rax, 8))
    untag(a, rdx)
    alu_load(a, "cmp", rcx, mem(rdx, 0))
    jcc(a, cc_ae, no_choice)
    load(a, rdx, mem(rdx, 16))
    shifti(a, "shl", rcx, 3)
    alu(a, "add", rdx, rcx)
    movsd_load(a, xmm0, mem(rdx, 0))
    movi(a, rax, 0)
    ret(a)
    mark(a, no_choice)
    load_bits(a, xmm0, bits_nothing)
    movi(a, rax, 0)
    ret(a)
end

# rt_tk_find or rt_ls_find: rax a label, as text: the entry with that label, from 1, in rax, or 0 for none;
# and rt_tk_entry or rt_ls_entry: its entry, made if there isn't one yet. Each entry is 2 to the `size_bits`
# bytes, its label first, then nothing but 0s, but a list's -1 for none chosen.
to emit_entries with a, prefix, size_bits
    set entry_items to prefix + "_items"
    set entry_n to prefix + "_n"
    set entry_cap to prefix + "_cap"
    set entry_loop to new_label(a)
    set entry_none to new_label(a)
    set entry_found to new_label(a)
    mark(a, "rt_" + prefix + "_find")
    for each r in list of rbx, r12, r13
        push_r(a, r)
    end
    mov_rr(a, r12, rax)
    movi(a, r13, 0)
    mark(a, entry_loop)
    alu_load(a, "cmp", r13, rip(entry_n))
    jcc(a, cc_ae, entry_none)
    mov_rr(a, rbx, r13)
    shifti(a, "shl", rbx, size_bits)
    alu_load(a, "add", rbx, rip(entry_items))
    load(a, rax, mem(rbx, 0))
    mov_rr(a, rdx, r12)
    call_to(a, "rt_equal")
    inc_r(a, r13)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, entry_found)
    jmp_to(a, entry_loop)
    mark(a, entry_none)
    movi(a, r13, 0)
    mark(a, entry_found)
    mov_rr(a, rax, r13)
    for each r in list of r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    set entry_have to new_label(a)
    set entry_room to new_label(a)
    set entry_some to new_label(a)
    mark(a, "rt_" + prefix + "_entry")
    push_r(a, rax) # where the collector sees it
    call_to(a, "rt_" + prefix + "_find")
    test_rr(a, rax, rax)
    jcc(a, cc_ne, entry_have)
    load(a, rax, rip(entry_n))
    alu_load(a, "cmp", rax, rip(entry_cap))
    jcc(a, cc_b, entry_room)
    load(a, rcx, rip(entry_cap))
    alu(a, "add", rcx, rcx)
    jcc(a, cc_ne, entry_some)
    movi(a, rcx, 8)
    mark(a, entry_some)
    store(a, rip(entry_cap), rcx)
    shifti(a, "shl", rcx, size_bits)
    call_to(a, "rt_alloc")
    mov_rr(a, rdi, rax)
    load(a, rsi, rip(entry_items))
    load(a, rcx, rip(entry_n))
    shifti(a, "shl", rcx, size_bits - 3)
    rep_movsq(a)
    store(a, rip(entry_items), rax)
    mark(a, entry_room)
    load(a, rdi, rip(entry_n))
    shifti(a, "shl", rdi, size_bits)
    alu_load(a, "add", rdi, rip(entry_items))
    load(a, rax, mem(rsp, 0))
    store(a, mem(rdi, 0), rax)
    if prefix is "ls" # none chosen yet
        storei(a, mem(rdi, 24), -1)
    end
    if prefix is "sl" # no value yet
        movi64(a, rcx, bits_nothing)
        store(a, mem(rdi, 8), rcx)
    end
    alu_at(a, "add", rip(entry_n), 1)
    load(a, rax, rip(entry_n))
    mark(a, entry_have)
    pop_r(a, rcx)
    ret(a)
end

# rbx a list's entry, rcx where its first row in view might go, rax how many rows it shows: there, as near as
# its items allow, from 0 to however many more there are than rows; uses rdx
to ls_keep_in_view with a
    set view_high to new_label(a)
    set view_low to new_label(a)
    load(a, rdx, mem(rbx, 8))
    untag(a, rdx)
    load(a, rdx, mem(rdx, 0))
    alu(a, "sub", rdx, rax)
    alu(a, "cmp", rcx, rdx)
    jcc(a, cc_le, view_high)
    mov_rr(a, rcx, rdx)
    mark(a, view_high)
    test_rr(a, rcx, rcx)
    jcc(a, cc_ns, view_low)
    movi(a, rcx, 0)
    mark(a, view_low)
    store(a, mem(rbx, 32), rcx)
end

# rt_turtle's numbers for a control: the value in xmm0 a list whose first `skip` items come before them,
# `count` of them, into tn0 on (or to `wrong`, err_a the one that isn't a number, err_what `what`); rcx the
# list, untagged, after
to control_numbers with a, what, skip, count, wrong
    lea(a, rax, rip(text_object(a, what)))
    store(a, rip("err_what"), rax)
    movq_rx(a, rax, xmm0)
    untag(a, rax)
    push_r(a, rax)
    load(a, rcx, mem(rax, 16))
    alui(a, "add", rcx, 8 * skip)
    store(a, rip("t_list"), rcx)
    lea(a, rax, rip("t_list"))
    alui(a, "sub", rax, 16)
    movi(a, rcx, count)
    movi(a, rdx, -1)
    call_to(a, "rt_turtle_numbers")
    pop_r(a, rcx)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, wrong)
end

# rt_turtle's checkboxes, text areas and lists, by their places in `acts` (see emit_controls): each thing
# drawn gets its label as `say` shows it in pi_text, and its entry in pi_w
to emit_control_acts with a, acts, wrong_numbers, done_ok
    mark(a, item 4 of acts) # a checkbox: label, x, y; 20 high, and 28 wide and 10 more for each letter
    control_numbers(a, "'draw checkbox'", 1, 2, wrong_numbers)
    load(a, rcx, mem(rcx, 16))
    movsd_load(a, xmm0, mem(rcx, 0))
    call_to(a, "rt_show_text")
    store(a, rip("pi_text"), rax)
    call_to(a, "rt_tk_entry")
    store(a, rip("pi_w"), rax)
    load(a, rax, rip("pi_text"))
    untag(a, rax)
    load(a, rax, mem(rax, 8))
    imul_ri(a, rax, rax, 10)
    alui(a, "add", rax, 28)
    cvtsi2sd(a, xmm0, rax)
    movsd_store(a, rip("pi_c"), xmm0)
    load_bits(a, xmm0, double_bytes(20))
    movsd_store(a, rip("pi_d"), xmm0)
    for each pair in list of (list of "tn0", "pi_a"), (list of "tn1", "pi_b")
        load(a, rax, rip(item 1 of pair))
        store(a, rip(item 2 of pair), rax)
    end
    storei(a, rip("pi_kind"), 10)
    call_to(a, "rt_pic_add")
    jmp_to(a, done_ok)

    for each ticking in list of 5, 6 # tick or untick the checkbox with that label, drawn yet or not
        mark(a, item ticking of acts)
        call_to(a, "rt_show_text")
        call_to(a, "rt_tk_entry")
        dec_r(a, rax)
        shifti(a, "shl", rax, 4)
        alu_load(a, "add", rax, rip("tk_items"))
        storei(a, mem(rax, 8), 6 - ticking)
        jmp_to(a, done_ok)
    end

    # a text area: label, x, y, and its width and height or nothing for the usual ones; a list: label, its
    # items, then the same. Its items must be a list, then the numbers numbers, then its size above 0.
    for each tall in list of 7, 8
        set tall_skip to tall - 6
        set tall_what to "'draw text area'"
        set tall_why to 82
        set tall_usual to list of 300, 120
        if tall is 8
            set tall_what to "'draw list'"
            set tall_why to 83
            set tall_usual to list of 200, 144
        end
        mark(a, item tall of acts)
        if tall is 8
            set items_fine to new_label(a)
            movq_rx(a, rax, xmm0)
            untag(a, rax)
            load(a, rax, mem(rax, 16))
            movsd_load(a, xmm1, mem(rax, 8))
            movq_rx(a, rax, xmm1)
            shifti(a, "shr", rax, 48)
            alui(a, "cmp", rax, kind_list)
            jcc(a, cc_e, items_fine)
            movsd_store(a, rip("err_a"), xmm1)
            storei(a, rip("err_why"), 84)
            movi(a, rax, 2)
            ret(a)
            mark(a, items_fine)
        end
        set tall_sized to new_label(a)
        set tall_numbered to new_label(a)
        movq_rx(a, rax, xmm0) # sized, unless its width and height are both nothing
        untag(a, rax)
        load(a, rax, mem(rax, 16))
        movi64(a, rdx, bits_nothing)
        for each place in list of tall_skip + 2, tall_skip + 3
            alu_load(a, "cmp", rdx, mem(rax, 8 * place))
            jcc(a, cc_ne, tall_sized)
        end
        control_numbers(a, tall_what, tall_skip, 2, wrong_numbers)
        load_bits(a, xmm1, double_bytes(item 1 of tall_usual))
        movsd_store(a, rip("tn2"), xmm1)
        load_bits(a, xmm1, double_bytes(item 2 of tall_usual))
        movsd_store(a, rip("tn3"), xmm1)
        jmp_to(a, tall_numbered)
        mark(a, tall_sized)
        control_numbers(a, tall_what, tall_skip, 4, wrong_numbers)
        mark(a, tall_numbered)
        for each side in list of "tn2", "tn3"
            set side_fine to new_label(a)
            movsd_load(a, xmm1, rip(side))
            load_bits(a, xmm2, double_bytes(0))
            ucomisd(a, xmm1, reg_at(xmm2))
            jcc(a, cc_a, side_fine)
            movsd_store(a, rip("err_a"), xmm1)
            storei(a, rip("err_why"), tall_why)
            movi(a, rax, 2)
            ret(a)
            mark(a, side_fine)
        end
        push_r(a, rcx)
        load(a, rax, mem(rcx, 16))
        movsd_load(a, xmm0, mem(rax, 0))
        call_to(a, "rt_show_text")
        store(a, rip("pi_text"), rax)
        if tall is 7
            call_to(a, "rt_box_entry")
            store(a, rip("pi_w"), rax)
        else
            call_to(a, "rt_ls_entry")
            store(a, rip("pi_w"), rax)
            load(a, rcx, mem(rsp, 0))
            load(a, rax, mem(rcx, 16))
            load(a, rax, mem(rax, 8))
            call_to(a, "rt_ls_fill")
        end
        pop_r(a, rcx)
        for each pair in list of (list of "tn0", "pi_a"), (list of "tn1", "pi_b"), (list of "tn2", "pi_c"), (list of "tn3", "pi_d")
            load(a, rax, rip(item 1 of pair))
            store(a, rip(item 2 of pair), rax)
        end
        storei(a, rip("pi_kind"), tall + 4)
        call_to(a, "rt_pic_add")
        jmp_to(a, done_ok)
    end
    emit_control_acts_more(a, acts, wrong_numbers, done_ok)
end

# Dropdowns (13) and sliders (14), DESIGN §42. A dropdown's entry is a list's: its items, them as shown, what's
# chosen and what's first in view, by its label. A slider's entry is 32 bytes: its label, its value (nothing
# until it's drawn or set), and the `from` and `to` it was last drawn with. drop_open is the entry of the
# dropdown that's open, from 1, or 0.
to emit_controls_more with a
    emit_entries(a, "sl", 5)

    # rt_slider_value: xmm0 a label: the value of the slider with that label, or nothing, into xmm0, with rax 0
    set no_slider to new_label(a)
    mark(a, "rt_slider_value")
    call_to(a, "rt_show_text")
    call_to(a, "rt_sl_find")
    test_rr(a, rax, rax)
    jcc(a, cc_e, no_slider)
    dec_r(a, rax)
    shifti(a, "shl", rax, 5)
    alu_load(a, "add", rax, rip("sl_items"))
    movsd_load(a, xmm0, mem(rax, 8))
    movi(a, rax, 0)
    ret(a)
    mark(a, no_slider)
    load_bits(a, xmm0, bits_nothing)
    movi(a, rax, 0)
    ret(a)

    # rt_drop_rows: rax a list's entry, its place: how many of its items a dropdown shows open, from 1 to 6,
    # in rax, and that many rows high, in xmm0
    set rows_few to new_label(a)
    set rows_one to new_label(a)
    mark(a, "rt_drop_rows")
    load(a, rax, mem(rax, 8))
    untag(a, rax)
    load(a, rax, mem(rax, 0))
    alui(a, "cmp", rax, 6)
    jcc(a, cc_le, rows_few)
    movi(a, rax, 6)
    mark(a, rows_few)
    alui(a, "cmp", rax, 1)
    jcc(a, cc_ge, rows_one)
    movi(a, rax, 1)
    mark(a, rows_one)
    imul_ri(a, rcx, rax, 24)
    cvtsi2sd(a, xmm0, rcx)
    ret(a)
end

# rt_turtle's dropdowns and sliders, and `set the slider`, by their places in `acts`
to emit_control_acts_more with a, acts, wrong_numbers, done_ok
    set drop_items_fine to new_label(a)
    mark(a, item 9 of acts) # a dropdown: label, its items, x, y; 200 by 30
    movq_rx(a, rax, xmm0)
    untag(a, rax)
    load(a, rax, mem(rax, 16))
    movsd_load(a, xmm1, mem(rax, 8))
    movq_rx(a, rax, xmm1)
    shifti(a, "shr", rax, 48)
    alui(a, "cmp", rax, kind_list)
    jcc(a, cc_e, drop_items_fine)
    movsd_store(a, rip("err_a"), xmm1)
    storei(a, rip("err_why"), 85)
    movi(a, rax, 2)
    ret(a)
    mark(a, drop_items_fine)
    control_numbers(a, "'draw dropdown'", 2, 2, wrong_numbers)
    push_r(a, rcx)
    load(a, rax, mem(rcx, 16))
    movsd_load(a, xmm0, mem(rax, 0))
    call_to(a, "rt_show_text")
    store(a, rip("pi_text"), rax)
    call_to(a, "rt_ls_entry")
    store(a, rip("pi_w"), rax)
    load(a, rcx, mem(rsp, 0)) # its items: as many rows as it shows open, for what's first in view
    load(a, rax, mem(rcx, 16))
    load(a, rax, mem(rax, 8))
    untag(a, rax)
    set count_few to new_label(a)
    set count_one to new_label(a)
    load(a, rax, mem(rax, 0))
    alui(a, "cmp", rax, 6)
    jcc(a, cc_le, count_few)
    movi(a, rax, 6)
    mark(a, count_few)
    alui(a, "cmp", rax, 1)
    jcc(a, cc_ge, count_one)
    movi(a, rax, 1)
    mark(a, count_one)
    imul_ri(a, rax, rax, 24)
    cvtsi2sd(a, xmm0, rax)
    movsd_store(a, rip("tn3"), xmm0)
    load(a, rcx, mem(rsp, 0))
    load(a, rax, mem(rcx, 16))
    load(a, rax, mem(rax, 8))
    call_to(a, "rt_ls_fill")
    pop_r(a, rcx)
    set still_open to new_label(a) # an open dropdown drawn with no items closes
    load(a, rax, rip("drop_open"))
    alu_load(a, "cmp", rax, rip("pi_w"))
    jcc(a, cc_ne, still_open)
    load(a, rcx, mem(rcx, 16))
    load(a, rcx, mem(rcx, 8))
    untag(a, rcx)
    load(a, rcx, mem(rcx, 0))
    test_rr(a, rcx, rcx)
    jcc(a, cc_ne, still_open)
    storei(a, rip("drop_open"), 0)
    mark(a, still_open)
    for each pair in list of (list of "tn0", "pi_a"), (list of "tn1", "pi_b")
        load(a, rax, rip(item 1 of pair))
        store(a, rip(item 2 of pair), rax)
    end
    load_bits(a, xmm0, double_bytes(200))
    movsd_store(a, rip("pi_c"), xmm0)
    load_bits(a, xmm0, double_bytes(30))
    movsd_store(a, rip("pi_d"), xmm0)
    storei(a, rip("pi_kind"), 13)
    call_to(a, "rt_pic_add")
    jmp_to(a, done_ok)

    mark(a, item 10 of acts) # a slider: label, from, to, x, y; 200 by 20, its value a whole number from `from` to `to`
    control_numbers(a, "'draw slider'", 1, 4, wrong_numbers)
    push_r(a, rcx)
    for each ends in list of (list of "tn0", "sl_from"), (list of "tn1", "sl_to")
        movsd_load(a, xmm0, rip(item 1 of ends))
        load_bits(a, xmm1, double_bytes(0.5))
        sse_math(a, "+", xmm0, reg_at(xmm1))
        floor_sd(a, xmm0, xmm0)
        movsd_store(a, rip(item 2 of ends), xmm0)
    end
    load(a, rax, mem(rcx, 16))
    movsd_load(a, xmm0, mem(rax, 0))
    call_to(a, "rt_show_text")
    store(a, rip("pi_text"), rax)
    call_to(a, "rt_sl_entry")
    store(a, rip("pi_w"), rax)
    dec_r(a, rax)
    shifti(a, "shl", rax, 5)
    alu_load(a, "add", rax, rip("sl_items"))
    load(a, rcx, rip("sl_from"))
    store(a, mem(rax, 16), rcx)
    load(a, rcx, rip("sl_to"))
    store(a, mem(rax, 24), rcx)
    set has_value to new_label(a)
    load(a, rcx, mem(rax, 8)) # its value, from `from` if it has none, kept to its range
    movi64(a, rdx, bits_nothing)
    alu(a, "cmp", rcx, rdx)
    jcc(a, cc_ne, has_value)
    load(a, rcx, rip("sl_from"))
    mark(a, has_value)
    movq_xr(a, xmm0, rcx)
    sl_keep(a, rax)
    movsd_store(a, mem(rax, 8), xmm0)
    pop_r(a, rcx)
    for each pair in list of (list of "tn2", "pi_a"), (list of "tn3", "pi_b")
        load(a, rax, rip(item 1 of pair))
        store(a, rip(item 2 of pair), rax)
    end
    load_bits(a, xmm0, double_bytes(200))
    movsd_store(a, rip("pi_c"), xmm0)
    load_bits(a, xmm0, double_bytes(20))
    movsd_store(a, rip("pi_d"), xmm0)
    storei(a, rip("pi_kind"), 14)
    call_to(a, "rt_pic_add")
    jmp_to(a, done_ok)

    set set_number to new_label(a)
    set set_drawn_loop to new_label(a)
    set set_store to new_label(a)
    set set_wrong to new_label(a)
    mark(a, item 11 of acts) # set the slider: label, value: a whole number, kept to its range while it's drawn
    movq_rx(a, rax, xmm0)
    untag(a, rax)
    load(a, rax, mem(rax, 16))
    movsd_load(a, xmm1, mem(rax, 8))
    movsd_store(a, rip("sl_now"), xmm1)
    odd_jump(a, xmm1, set_wrong)
    jmp_to(a, set_number)
    mark(a, set_wrong)
    movsd_store(a, rip("err_a"), xmm1)
    storei(a, rip("err_why"), 86)
    movi(a, rax, 2)
    ret(a)
    mark(a, set_number)
    movq_rx(a, rax, xmm0)
    untag(a, rax)
    load(a, rax, mem(rax, 16))
    movsd_load(a, xmm1, rip("sl_now"))
    load_bits(a, xmm2, double_bytes(0.5))
    sse_math(a, "+", xmm1, reg_at(xmm2))
    floor_sd(a, xmm1, xmm1)
    movsd_store(a, rip("sl_now"), xmm1)
    movsd_load(a, xmm0, mem(rax, 0))
    call_to(a, "rt_show_text")
    call_to(a, "rt_sl_entry")
    mov_rr(a, rdx, rax) # drawn since the last `clear`?
    load(a, rcx, rip("pic_n"))
    load(a, rsi, rip("pic_items"))
    mark(a, set_drawn_loop)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, set_store)
    load(a, r8, mem(rsi, 0))
    alui(a, "cmp", r8, 14)
    set set_next to new_label(a)
    jcc(a, cc_ne, set_next)
    alu_load(a, "cmp", rdx, mem(rsi, 40))
    set set_kept to new_label(a)
    jcc(a, cc_e, set_kept)
    mark(a, set_next)
    alui(a, "add", rsi, 64)
    dec_r(a, rcx)
    jmp_to(a, set_drawn_loop)
    mark(a, set_kept)
    mov_rr(a, rax, rdx)
    dec_r(a, rax)
    shifti(a, "shl", rax, 5)
    alu_load(a, "add", rax, rip("sl_items"))
    movsd_load(a, xmm0, rip("sl_now"))
    sl_keep(a, rax)
    movsd_store(a, rip("sl_now"), xmm0)
    mark(a, set_store)
    mov_rr(a, rax, rdx)
    dec_r(a, rax)
    shifti(a, "shl", rax, 5)
    alu_load(a, "add", rax, rip("sl_items"))
    load(a, rcx, rip("sl_now"))
    store(a, mem(rax, 8), rcx)
    jmp_to(a, done_ok)
end

# xmm0 a value, kept from the lesser to the greater of the `from` and `to` in the slider's entry at register
# r; uses xmm1 to xmm3
to sl_keep with a, r
    movsd_load(a, xmm1, mem(r, 16))
    movsd_load(a, xmm2, mem(r, 24))
    movapd(a, xmm3, xmm1)
    minsd(a, xmm3, xmm2)
    sse_math(a, "max", xmm1, reg_at(xmm2))
    minsd(a, xmm0, xmm1)
    sse_math(a, "max", xmm0, reg_at(xmm3))
end

# ---------- the runtime: apps ----------
# `when a key is pressed`, `when the mouse is clicked` or dragged, and `every 2 seconds`: each handler, in
# the order the program made them, 32 bytes: what it waits for (0 a key, 1 a click, 2 a drag, 3 a button,
# and on as front's event_names has them, or app_timer for a timer), the function, how many inputs it takes,
# and for a timer how many milliseconds apart, or for a button or text box its label.
set app_timer to 8 # after the last of event_names, so a timer is never taken for a button

to emit_app_setup with a
    # rt_on: rcx what it waits for, rax the function, rdx how many inputs it takes; rt_every: the same for a
    # timer, xmm0 how often, in units of rcx milliseconds: rax 0, or 2 (err_why 77) for a time that isn't a
    # number above 0
    set room to new_label(a)
    set some to new_label(a)
    set every_wrong to new_label(a)
    set put to new_label(a)
    mark(a, "rt_every")
    mov_rr(a, r10, rax) # the function and the unit, kept from odd_jump
    mov_rr(a, r11, rcx)
    movsd_store(a, rip("err_a"), xmm0)
    odd_jump(a, xmm0, every_wrong)
    load_bits(a, xmm1, double_bytes(0))
    ucomisd(a, xmm0, reg_at(xmm1))
    jcc(a, cc_be, every_wrong)
    movq_rx(a, r8, xmm0)
    movi64(a, r9, list of 0, 0, 0, 0, 0, 0, 0xF0, 0x7F) # infinity
    alu(a, "cmp", r8, r9)
    jcc(a, cc_e, every_wrong)
    cvtsi2sd(a, xmm1, r11)
    sse_math(a, "*", xmm0, reg_at(xmm1))
    movsd_store(a, rip("ev_ms"), xmm0)
    mov_rr(a, rax, r10)
    movi(a, rcx, app_timer)
    jmp_to(a, put)
    mark(a, every_wrong)
    storei(a, rip("err_why"), 77)
    movi(a, rax, 2)
    ret(a)
    if widgets of a # rt_on_label: as rt_on, and r8 the label of the button or text box it waits for, as text
        mark(a, "rt_on_label")
        store(a, rip("ev_ms"), r8)
        jmp_to(a, put)
    end
    mark(a, "rt_on")
    storei(a, rip("ev_ms"), 0)
    mark(a, put)
    push_r(a, rax)
    push_r(a, rcx)
    push_r(a, rdx)
    load(a, rax, rip("app_n"))
    alu_load(a, "cmp", rax, rip("app_cap"))
    jcc(a, cc_b, room)
    load(a, rcx, rip("app_cap"))
    alu(a, "add", rcx, rcx)
    jcc(a, cc_ne, some)
    movi(a, rcx, 8)
    mark(a, some)
    store(a, rip("app_cap"), rcx)
    shifti(a, "shl", rcx, 5)
    call_to(a, "rt_alloc")
    mov_rr(a, rdi, rax)
    load(a, rsi, rip("app_items"))
    load(a, rcx, rip("app_n"))
    shifti(a, "shl", rcx, 2)
    rep_movsq(a)
    store(a, rip("app_items"), rax)
    mark(a, room)
    load(a, rdi, rip("app_n"))
    shifti(a, "shl", rdi, 5)
    alu_load(a, "add", rdi, rip("app_items"))
    pop_r(a, rdx)
    pop_r(a, rcx)
    pop_r(a, rax)
    store(a, mem(rdi, 0), rcx)
    store(a, mem(rdi, 8), rax)
    store(a, mem(rdi, 16), rdx)
    load(a, rax, rip("ev_ms"))
    store(a, mem(rdi, 24), rax)
    alu_at(a, "add", rip("app_n"), 1)
    movi(a, rax, 0)
    ret(a)
end

# ---------- the runtime: a window, on Windows ----------
# When a program that drew something, or set up an app, ends at a terminal, a window shows the picture as
# the playground does: 500 by 500, (0, 0) in the middle and y going up, smoothed by GDI+, and a drawing
# made smaller if it reaches past the edge (an app's never is: it's where its clicks land). An app runs in
# it: keys, clicks, drags and timers go to its handlers, and the picture is drawn again after each. A
# question that starts with "Draw", asked at a terminal, opens a pad to draw the answer on, which comes
# back the way the playground's pad gives it. Away from a terminal none of this opens, so a program runs
# as it does anywhere else; MOTH_PICTURE=file.bmp instead draws the picture into that file, after the
# events in MOTH_EVENTS ("key left;click 10 20;drag 11 21;tick 0"), which is how the tests see it.

set gui_imports to list of (list of "USER32.dll", (list of "RegisterClassExW", "CreateWindowExW", "DefWindowProcW",
    "GetMessageW", "TranslateMessage", "DispatchMessageW", "PostQuitMessage", "InvalidateRect", "BeginPaint", "EndPaint",
    "LoadCursorW", "SetTimer", "SetCapture", "ReleaseCapture", "AdjustWindowRect", "DestroyWindow", "CharLowerW",
    "GetKeyState", "SetForegroundWindow")),
    (list of "GDI32.dll", (list of "CreateCompatibleDC", "CreateCompatibleBitmap", "SelectObject", "DeleteObject",
    "DeleteDC", "BitBlt", "CreateDIBSection", "GdiFlush")),
    (list of "gdiplus.dll", (list of "GdiplusStartup", "GdipCreateFromHDC", "GdipDeleteGraphics", "GdipSetSmoothingMode",
    "GdipSetTextRenderingHint", "GdipGraphicsClear", "GdipCreatePen1", "GdipSetPenStartCap", "GdipSetPenEndCap",
    "GdipSetPenLineJoin", "GdipDeletePen", "GdipDrawLine", "GdipCreateSolidFill", "GdipDeleteBrush", "GdipFillRectangle",
    "GdipFillEllipse", "GdipCreateFontFamilyFromName", "GdipGetCellAscent", "GdipGetEmHeight", "GdipCreateFont",
    "GdipDeleteFont", "GdipDrawString", "GdipStringFormatGetGenericTypographic")),
    (list of "KERNEL32.dll", (list of "GetModuleHandleW", "GetEnvironmentVariableW"))

# CSS's named colours, as a browser's canvas knows them, each with its red, green and blue
set css_colors to list of "aliceblue", 0xF0F8FF, "antiquewhite", 0xFAEBD7, "aqua", 0x00FFFF, "aquamarine", 0x7FFFD4,
    "azure", 0xF0FFFF, "beige", 0xF5F5DC, "bisque", 0xFFE4C4, "black", 0x000000, "blanchedalmond", 0xFFEBCD,
    "blue", 0x0000FF, "blueviolet", 0x8A2BE2, "brown", 0xA52A2A, "burlywood", 0xDEB887, "cadetblue", 0x5F9EA0,
    "chartreuse", 0x7FFF00, "chocolate", 0xD2691E, "coral", 0xFF7F50, "cornflowerblue", 0x6495ED, "cornsilk", 0xFFF8DC,
    "crimson", 0xDC143C, "cyan", 0x00FFFF, "darkblue", 0x00008B, "darkcyan", 0x008B8B, "darkgoldenrod", 0xB8860B,
    "darkgray", 0xA9A9A9, "darkgreen", 0x006400, "darkgrey", 0xA9A9A9, "darkkhaki", 0xBDB76B, "darkmagenta", 0x8B008B,
    "darkolivegreen", 0x556B2F, "darkorange", 0xFF8C00, "darkorchid", 0x9932CC, "darkred", 0x8B0000,
    "darksalmon", 0xE9967A, "darkseagreen", 0x8FBC8F, "darkslateblue", 0x483D8B, "darkslategray", 0x2F4F4F,
    "darkslategrey", 0x2F4F4F, "darkturquoise", 0x00CED1, "darkviolet", 0x9400D3, "deeppink", 0xFF1493,
    "deepskyblue", 0x00BFFF, "dimgray", 0x696969, "dimgrey", 0x696969, "dodgerblue", 0x1E90FF, "firebrick", 0xB22222,
    "floralwhite", 0xFFFAF0, "forestgreen", 0x228B22, "fuchsia", 0xFF00FF, "gainsboro", 0xDCDCDC,
    "ghostwhite", 0xF8F8FF, "gold", 0xFFD700, "goldenrod", 0xDAA520, "gray", 0x808080, "green", 0x008000,
    "greenyellow", 0xADFF2F, "grey", 0x808080, "honeydew", 0xF0FFF0, "hotpink", 0xFF69B4, "indianred", 0xCD5C5C,
    "indigo", 0x4B0082, "ivory", 0xFFFFF0, "khaki", 0xF0E68C, "lavender", 0xE6E6FA, "lavenderblush", 0xFFF0F5,
    "lawngreen", 0x7CFC00, "lemonchiffon", 0xFFFACD, "lightblue", 0xADD8E6, "lightcoral", 0xF08080,
    "lightcyan", 0xE0FFFF, "lightgoldenrodyellow", 0xFAFAD2, "lightgray", 0xD3D3D3, "lightgreen", 0x90EE90,
    "lightgrey", 0xD3D3D3, "lightpink", 0xFFB6C1, "lightsalmon", 0xFFA07A, "lightseagreen", 0x20B2AA,
    "lightskyblue", 0x87CEFA, "lightslategray", 0x778899, "lightslategrey", 0x778899, "lightsteelblue", 0xB0C4DE,
    "lightyellow", 0xFFFFE0, "lime", 0x00FF00, "limegreen", 0x32CD32, "linen", 0xFAF0E6, "magenta", 0xFF00FF,
    "maroon", 0x800000, "mediumaquamarine", 0x66CDAA, "mediumblue", 0x0000CD, "mediumorchid", 0xBA55D3,
    "mediumpurple", 0x9370DB, "mediumseagreen", 0x3CB371, "mediumslateblue", 0x7B68EE, "mediumspringgreen", 0x00FA9A,
    "mediumturquoise", 0x48D1CC, "mediumvioletred", 0xC71585, "midnightblue", 0x191970, "mintcream", 0xF5FFFA,
    "mistyrose", 0xFFE4E1, "moccasin", 0xFFE4B5, "navajowhite", 0xFFDEAD, "navy", 0x000080, "oldlace", 0xFDF5E6,
    "olive", 0x808000, "olivedrab", 0x6B8E23, "orange", 0xFFA500, "orangered", 0xFF4500, "orchid", 0xDA70D6,
    "palegoldenrod", 0xEEE8AA, "palegreen", 0x98FB98, "paleturquoise", 0xAFEEEE, "palevioletred", 0xDB7093,
    "papayawhip", 0xFFEFD5, "peachpuff", 0xFFDAB9, "peru", 0xCD853F, "pink", 0xFFC0CB, "plum", 0xDDA0DD,
    "powderblue", 0xB0E0E6, "purple", 0x800080, "rebeccapurple", 0x663399, "red", 0xFF0000, "rosybrown", 0xBC8F8F,
    "royalblue", 0x4169E1, "saddlebrown", 0x8B4513, "salmon", 0xFA8072, "sandybrown", 0xF4A460, "seagreen", 0x2E8B57,
    "seashell", 0xFFF5EE, "sienna", 0xA0522D, "silver", 0xC0C0C0, "skyblue", 0x87CEEB, "slateblue", 0x6A5ACD,
    "slategray", 0x708090, "slategrey", 0x708090, "snow", 0xFFFAFA, "springgreen", 0x00FF7F, "steelblue", 0x4682B4,
    "tan", 0xD2B48C, "teal", 0x008080, "thistle", 0xD8BFD8, "tomato", 0xFF6347, "turquoise", 0x40E0D0,
    "violet", 0xEE82EE, "wheat", 0xF5DEB3, "white", 0xFFFFFF, "whitesmoke", 0xF5F5F5, "yellow", 0xFFFF00,
    "yellowgreen", 0x9ACD32

# the names keys have, as the playground gives them, by their Windows key codes
set gui_key_names to list of 0x25, "left", 0x26, "up", 0x27, "right", 0x28, "down", 0x20, "space", 0x0D, "enter",
    0x1B, "escape", 0x08, "backspace", 0x10, "shift", 0x14, "capslock", 0x2E, "delete", 0x24, "home", 0x23, "end",
    0x21, "pageup", 0x22, "pagedown", 0x2D, "insert", 0x70, "f1", 0x71, "f2", 0x72, "f3", 0x73, "f4", 0x74, "f5",
    0x75, "f6", 0x76, "f7", 0x77, "f8", 0x78, "f9", 0x79, "f10", 0x7A, "f11", 0x7B, "f12"

to w_call with a, fn_name
    call_import(a, "imp_" + fn_name)
end

# where the k-th input of a Windows function (from the 5th on) goes, inside win_enter
to arg_at with k
    return mem(rsp, 32 + 8 * (k - 5))
end

to cvtsd2ss with a, x, y
    sse(a, 0xF2, 0x5A, x, reg_at(y))
end

to movss_store with a, at, x
    sse(a, 0xF3, 0x11, x, at)
end

to minsd with a, x, y
    sse(a, 0xF2, 0x5D, x, reg_at(y))
end

to movdqu_store with a, at, x
    enc(a, (list of 0xF3), no, (list of 0x0F, 0x7F), x, at, empty list)
end

to movdqu_load with a, x, at
    enc(a, (list of 0xF3), no, (list of 0x0F, 0x6F), x, at, empty list)
end

# 16 bits of register src, signed, into dst
to movsx16 with a, dst, src
    enc(a, empty list, yes, (list of 0x0F, 0xBF), dst, reg_at(src), empty list)
end

# xmm x without its sign; uses rax
to abs_sd with a, x
    movq_rx(a, rax, x)
    bit_op(a, "btr", rax, 63)
    movq_xr(a, x, rax)
end

# xmm dst: where x in the picture goes across, 250 + x times the scale; uses xmm5
to picture_x with a, dst, at
    movsd_load(a, dst, at)
    sse_math(a, "*", dst, rip("gui_scale"))
    load_bits(a, xmm5, double_bytes(250))
    sse_math(a, "+", dst, reg_at(xmm5))
end

# xmm dst: where y goes down, 250 - y times the scale; uses xmm5
to picture_y with a, dst, at
    movsd_load(a, xmm5, at)
    sse_math(a, "*", xmm5, rip("gui_scale"))
    load_bits(a, dst, double_bytes(250))
    sse_math(a, "-", dst, reg_at(xmm5))
end

# a text's UTF-16, ending in 0, in the read-only data: its label
to wide_place with a, t
    set ro to rodata of a
    pad_to(ro, 2)
    set label to "W" + length of ro
    rodata_here(a, label)
    for each c in t
        set code to code_point(c)
        if code is less than 65536
            put16(ro, code)
        else
            set code to code - 65536
            put16(ro, 0xD800 + shift code right by 10)
            put16(ro, 0xDC00 + (code bit and 1023))
        end
    end
    put16(ro, 0)
    return label
end

# jumps to `label` unless the byte in register r is white space as CSS has it: a space, tab, line feed, form
# feed or carriage return; changes r
to css_space_jump with a, r, label
    set space to new_label(a)
    alui(a, "cmp", r, 32)
    jcc(a, cc_e, space)
    alui(a, "sub", r, 9)
    alui(a, "cmp", r, 1)
    jcc(a, cc_be, space)
    alui(a, "sub", r, 3)
    alui(a, "cmp", r, 1)
    jcc(a, cc_a, label)
    mark(a, space)
end

# rsi past the white space before rdx
to css_skip_space with a
    set skipping to new_label(a)
    set skipped to new_label(a)
    mark(a, skipping)
    alu(a, "cmp", rsi, rdx)
    jcc(a, cc_ae, skipped)
    load8(a, rax, mem(rsi, 0))
    css_space_jump(a, rax, skipped)
    inc_r(a, rsi)
    jmp_to(a, skipping)
    mark(a, skipped)
end

# xmm x: x, but no less than lowest and no more than highest (and NaN as lowest); uses xmm5
to css_clamp with a, x, lowest, highest
    load_bits(a, xmm5, double_bytes(lowest))
    sse_math(a, "max", x, reg_at(xmm5))
    load_bits(a, xmm5, double_bytes(highest))
    minsd(a, x, xmm5)
end

# register r: xmm x, from 0 to 1, as a byte: x times 255, rounded; uses xmm5
to css_byte with a, r, x
    load_bits(a, xmm5, double_bytes(255))
    sse_math(a, "*", x, reg_at(xmm5))
    load_bits(a, xmm5, double_bytes(0.5))
    sse_math(a, "+", x, reg_at(xmm5))
    cvttsd2si(a, r, x)
end

# rgb(), rgba(), hsl() and hsla() as a browser's canvas reads them (CSS Color 4): the old way, with commas
# and no `none`, where rgb's three are all numbers or all percentages and hsl's last two are percentages; or
# the new way, with spaces, `none` for 0 and the alpha after a /. Red, green and blue are from 0 to 255 or
# from 0% to 100%; a hue is in degrees, or deg, grad, rad or turn; saturation and lightness are percentages;
# an alpha is from 0 to 1 or a percentage. Each is held to its range and rounded to a byte, and hsl becomes
# red, green and blue the way Chrome works it out.
to emit_css_functions with a
    # rt_css_number: rsi at a number, rdx where the text ends: rax what it is (0 a number, 1 a percentage, 2 an
    # angle, made degrees, 3 none, 4 some other unit, or -1 not a number), its value in xmm0, and rsi past it.
    # Uses rcx, r8 to r11 and xmm1.
    set sign_done to new_label(a)
    set int_loop to new_label(a)
    set int_done to new_label(a)
    set frac_loop to new_label(a)
    set frac_done to new_label(a)
    set exp_done to new_label(a)
    set exp_loop to new_label(a)
    set exp_digits_done to new_label(a)
    set scale_up to new_label(a)
    set scale_down to new_label(a)
    set scaled to new_label(a)
    set signed to new_label(a)
    set unit_start to new_label(a)
    set unit_loop to new_label(a)
    set unit_done to new_label(a)
    set plain to new_label(a)
    set not_number to new_label(a)
    set other_unit to new_label(a)
    set got_none to new_label(a)
    mark(a, "rt_css_number")
    mov_rr(a, rcx, rdx) # `none`?
    alu(a, "sub", rcx, rsi)
    alui(a, "cmp", rcx, 4)
    set not_none to new_label(a)
    jcc(a, cc_b, not_none)
    ascii_prefix(a, "none", not_none)
    alui(a, "cmp", rcx, 4)
    jcc(a, cc_e, got_none)
    load8(a, rax, mem(rsi, 4)) # a letter, digit, _, - or anything past ASCII after it makes it another word
    alui(a, "cmp", rax, 127)
    jcc(a, cc_a, not_none)
    alui(a, "cmp", rax, 95)
    jcc(a, cc_e, not_none)
    alui(a, "cmp", rax, 45)
    jcc(a, cc_e, not_none)
    lea(a, r8, mem(rax, -48))
    alui(a, "cmp", r8, 9)
    jcc(a, cc_be, not_none)
    alui(a, "or", rax, 32)
    lea(a, r8, mem(rax, -97))
    alui(a, "cmp", r8, 25)
    jcc(a, cc_be, not_none)
    mark(a, got_none)
    alui(a, "add", rsi, 4)
    movi(a, rax, 0)
    movq_xr(a, xmm0, rax)
    movi(a, rax, 3)
    ret(a)
    mark(a, not_none)
    movi(a, r8, 0) # 1 for a minus
    movi(a, r9, 0) # how many digits
    movi(a, r10, 0) # how many after the point
    movi(a, rax, 0)
    movq_xr(a, xmm0, rax)
    alu(a, "cmp", rsi, rdx)
    jcc(a, cc_ae, not_number)
    load8(a, rax, mem(rsi, 0))
    alui(a, "cmp", rax, 43)
    jcc(a, cc_e, signed)
    alui(a, "cmp", rax, 45)
    jcc(a, cc_ne, sign_done)
    movi(a, r8, 1)
    mark(a, signed)
    inc_r(a, rsi)
    mark(a, sign_done)
    mark(a, int_loop)
    alu(a, "cmp", rsi, rdx)
    jcc(a, cc_ae, int_done)
    load8(a, rax, mem(rsi, 0))
    alui(a, "sub", rax, 48)
    alui(a, "cmp", rax, 9)
    jcc(a, cc_a, int_done)
    load_bits(a, xmm1, double_bytes(10))
    sse_math(a, "*", xmm0, reg_at(xmm1))
    cvtsi2sd(a, xmm1, rax)
    sse_math(a, "+", xmm0, reg_at(xmm1))
    inc_r(a, r9)
    inc_r(a, rsi)
    jmp_to(a, int_loop)
    mark(a, int_done) # a point, if a digit comes after it
    lea(a, rcx, mem(rsi, 1))
    alu(a, "cmp", rcx, rdx)
    jcc(a, cc_ae, frac_done)
    load8(a, rax, mem(rsi, 0))
    alui(a, "cmp", rax, 46)
    jcc(a, cc_ne, frac_done)
    load8(a, rax, mem(rsi, 1))
    alui(a, "sub", rax, 48)
    alui(a, "cmp", rax, 9)
    jcc(a, cc_a, frac_done)
    inc_r(a, rsi)
    mark(a, frac_loop)
    alu(a, "cmp", rsi, rdx)
    jcc(a, cc_ae, frac_done)
    load8(a, rax, mem(rsi, 0))
    alui(a, "sub", rax, 48)
    alui(a, "cmp", rax, 9)
    jcc(a, cc_a, frac_done)
    load_bits(a, xmm1, double_bytes(10))
    sse_math(a, "*", xmm0, reg_at(xmm1))
    cvtsi2sd(a, xmm1, rax)
    sse_math(a, "+", xmm0, reg_at(xmm1))
    inc_r(a, r9)
    inc_r(a, r10)
    inc_r(a, rsi)
    jmp_to(a, frac_loop)
    mark(a, frac_done)
    test_rr(a, r9, r9)
    jcc(a, cc_e, not_number)
    unary(a, "neg", r10) # the power of ten: less the digits after the point, plus an exponent if one comes
    alu(a, "cmp", rsi, rdx)
    jcc(a, cc_ae, exp_done)
    load8(a, rax, mem(rsi, 0))
    alui(a, "or", rax, 32)
    alui(a, "cmp", rax, 101) # e
    jcc(a, cc_ne, exp_done)
    lea(a, rcx, mem(rsi, 1))
    movi(a, r11, 0) # 1 for a minus
    alu(a, "cmp", rcx, rdx)
    jcc(a, cc_ae, exp_done)
    load8(a, rax, mem(rcx, 0))
    set exp_signed to new_label(a)
    set exp_sign_done to new_label(a)
    alui(a, "cmp", rax, 43)
    jcc(a, cc_e, exp_signed)
    alui(a, "cmp", rax, 45)
    jcc(a, cc_ne, exp_sign_done)
    movi(a, r11, 1)
    mark(a, exp_signed)
    inc_r(a, rcx)
    mark(a, exp_sign_done)
    alu(a, "cmp", rcx, rdx) # a digit must come next, or the e isn't part of it
    jcc(a, cc_ae, exp_done)
    load8(a, rax, mem(rcx, 0))
    alui(a, "sub", rax, 48)
    alui(a, "cmp", rax, 9)
    jcc(a, cc_a, exp_done)
    mov_rr(a, rsi, rcx)
    movi(a, r9, 0)
    mark(a, exp_loop)
    alu(a, "cmp", rsi, rdx)
    jcc(a, cc_ae, exp_digits_done)
    load8(a, rax, mem(rsi, 0))
    alui(a, "sub", rax, 48)
    alui(a, "cmp", rax, 9)
    jcc(a, cc_a, exp_digits_done)
    imul_ri(a, r9, r9, 10)
    alu(a, "add", r9, rax)
    alui(a, "cmp", r9, 1000) # far past where every value is the same
    set exp_capped to new_label(a)
    jcc(a, cc_b, exp_capped)
    movi(a, r9, 1000)
    mark(a, exp_capped)
    inc_r(a, rsi)
    jmp_to(a, exp_loop)
    mark(a, exp_digits_done)
    test_rr(a, r11, r11)
    set exp_plus to new_label(a)
    jcc(a, cc_e, exp_plus)
    unary(a, "neg", r9)
    mark(a, exp_plus)
    alu(a, "add", r10, r9)
    mark(a, exp_done) # times 10 to that power
    load_bits(a, xmm1, double_bytes(10))
    mark(a, scale_up)
    alui(a, "cmp", r10, 0)
    jcc(a, cc_le, scale_down)
    sse_math(a, "*", xmm0, reg_at(xmm1))
    dec_r(a, r10)
    jmp_to(a, scale_up)
    mark(a, scale_down)
    alui(a, "cmp", r10, 0)
    jcc(a, cc_ge, scaled)
    sse_math(a, "/", xmm0, reg_at(xmm1))
    inc_r(a, r10)
    jmp_to(a, scale_down)
    mark(a, scaled)
    test_rr(a, r8, r8)
    set positive to new_label(a)
    jcc(a, cc_e, positive)
    movq_rx(a, rax, xmm0)
    bit_op(a, "btc", rax, 63)
    movq_xr(a, xmm0, rax)
    mark(a, positive) # then a % or a unit, or neither
    alu(a, "cmp", rsi, rdx)
    jcc(a, cc_ae, plain)
    load8(a, rax, mem(rsi, 0))
    alui(a, "cmp", rax, 37)
    set not_percent to new_label(a)
    jcc(a, cc_ne, not_percent)
    inc_r(a, rsi)
    movi(a, rax, 1)
    ret(a)
    mark(a, not_percent)
    mov_rr(a, rcx, rax) # a letter, _ or a byte past ASCII starts a unit
    alui(a, "cmp", rcx, 127)
    jcc(a, cc_a, unit_start)
    alui(a, "cmp", rcx, 95)
    jcc(a, cc_e, unit_start)
    alui(a, "or", rcx, 32)
    alui(a, "sub", rcx, 97)
    alui(a, "cmp", rcx, 25)
    jcc(a, cc_be, unit_start)
    alui(a, "cmp", rax, 45) # - and then one of those does too
    jcc(a, cc_ne, plain)
    lea(a, rcx, mem(rsi, 1))
    alu(a, "cmp", rcx, rdx)
    jcc(a, cc_ae, plain)
    load8(a, rcx, mem(rcx, 0))
    alui(a, "cmp", rcx, 127)
    jcc(a, cc_a, unit_start)
    alui(a, "cmp", rcx, 95)
    jcc(a, cc_e, unit_start)
    alui(a, "or", rcx, 32)
    alui(a, "sub", rcx, 97)
    alui(a, "cmp", rcx, 25)
    jcc(a, cc_be, unit_start)
    mark(a, plain)
    movi(a, rax, 0)
    ret(a)
    mark(a, unit_start) # the unit: letters, digits, _ and -
    mov_rr(a, r8, rsi)
    mark(a, unit_loop)
    alu(a, "cmp", rsi, rdx)
    jcc(a, cc_ae, unit_done)
    load8(a, rax, mem(rsi, 0))
    set unit_more to new_label(a)
    alui(a, "cmp", rax, 127)
    jcc(a, cc_a, unit_more)
    alui(a, "cmp", rax, 95)
    jcc(a, cc_e, unit_more)
    alui(a, "cmp", rax, 45)
    jcc(a, cc_e, unit_more)
    lea(a, rcx, mem(rax, -48))
    alui(a, "cmp", rcx, 9)
    jcc(a, cc_be, unit_more)
    alui(a, "or", rax, 32)
    alui(a, "sub", rax, 97)
    alui(a, "cmp", rax, 25)
    jcc(a, cc_a, unit_done)
    mark(a, unit_more)
    inc_r(a, rsi)
    jmp_to(a, unit_loop)
    mark(a, unit_done) # deg, grad, rad or turn, in either case: degrees
    mov_rr(a, rcx, rsi)
    alu(a, "sub", rcx, r8)
    push_r(a, rsi)
    mov_rr(a, rsi, r8)
    for each angle in list of (list of "deg", 1), (list of "grad", 0.9), (list of "rad", 57.29577951308232), (list of "turn", 360)
        set other_angle to new_label(a)
        alui(a, "cmp", rcx, length of item 1 of angle)
        jcc(a, cc_ne, other_angle)
        ascii_prefix(a, item 1 of angle, other_angle)
        pop_r(a, rsi)
        load_bits(a, xmm1, double_bytes(item 2 of angle))
        sse_math(a, "*", xmm0, reg_at(xmm1))
        movi(a, rax, 2)
        ret(a)
        mark(a, other_angle)
    end
    pop_r(a, rsi)
    mark(a, other_unit)
    movi(a, rax, 4)
    ret(a)
    mark(a, not_number)
    movi(a, rax, -1)
    ret(a)

    # rt_css_func: rsi and rcx a colour's text: if it starts rgb(, rgba(, hsl( or hsla(, in either case, its
    # ARGB in rax, or -1 if it isn't one a canvas reads; else rax -2, with rsi and rcx kept
    set is_rgba to new_label(a)
    set is_rgb to new_label(a)
    set is_hsla to new_label(a)
    set not_func to new_label(a)
    set func_start to new_label(a)
    set comp_loop to new_label(a)
    set bad to new_label(a)
    set closed to new_label(a)
    set modern to new_label(a)
    set legacy to new_label(a)
    set decided to new_label(a)
    set checked to new_label(a)
    set func_out to new_label(a)
    mark(a, "rt_css_func")
    for each func in list of (list of "rgba(", 0), (list of "rgb(", 0), (list of "hsla(", 1), (list of "hsl(", 1)
        set other_func to new_label(a)
        alui(a, "cmp", rcx, length of item 1 of func)
        jcc(a, cc_b, other_func)
        ascii_prefix(a, item 1 of func, other_func)
        push_r(a, rbx)
        push_r(a, r12)
        push_r(a, r13)
        push_r(a, r14)
        movi(a, rbx, item 2 of func) # 0 for rgb, 1 for hsl
        lea(a, rdx, mem(rsi, 0))
        alu(a, "add", rdx, rcx)
        alui(a, "add", rsi, length of item 1 of func)
        jmp_to(a, func_start)
        mark(a, other_func)
    end
    movi(a, rax, -2)
    ret(a)
    mark(a, func_start) # r12 how many so far, r13 1 the old way with commas, 0 the new
    movi(a, r12, 0)
    movi(a, r13, -1)
    css_skip_space(a)
    mark(a, comp_loop)
    call_to(a, "rt_css_number")
    alui(a, "cmp", rax, 0)
    jcc(a, cc_l, bad)
    lea(a, rcx, rip("css_types"))
    mov_rr(a, r8, r12)
    shifti(a, "shl", r8, 3)
    alu(a, "add", rcx, r8)
    store(a, mem(rcx, 0), rax)
    lea(a, rcx, rip("css_vals"))
    alu(a, "add", rcx, r8)
    movsd_store(a, mem(rcx, 0), xmm0)
    inc_r(a, r12)
    css_skip_space(a)
    alu(a, "cmp", rsi, rdx)
    jcc(a, cc_ae, bad)
    load8(a, rax, mem(rsi, 0))
    alui(a, "cmp", r13, -1) # after the first: a comma says which way
    jcc(a, cc_ne, decided)
    movi(a, r13, 0)
    alui(a, "cmp", rax, 44)
    jcc(a, cc_ne, decided)
    movi(a, r13, 1)
    mark(a, decided)
    alui(a, "cmp", rax, 41) # )
    jcc(a, cc_e, closed)
    test_rr(a, r13, r13)
    jcc(a, cc_e, modern)
    alui(a, "cmp", rax, 44) # the old way: a comma before each of the rest
    jcc(a, cc_ne, bad)
    alui(a, "cmp", r12, 4)
    jcc(a, cc_ae, bad)
    inc_r(a, rsi)
    css_skip_space(a)
    jmp_to(a, comp_loop)
    mark(a, modern) # the new: three, then maybe / and the alpha
    alui(a, "cmp", r12, 3)
    jcc(a, cc_b, comp_loop)
    jcc(a, cc_a, bad)
    alui(a, "cmp", rax, 47)
    jcc(a, cc_ne, bad)
    inc_r(a, rsi)
    css_skip_space(a)
    jmp_to(a, comp_loop)
    mark(a, closed) # three or four, and nothing after the )
    inc_r(a, rsi)
    css_skip_space(a)
    alu(a, "cmp", rsi, rdx)
    jcc(a, cc_ne, bad)
    alui(a, "cmp", r12, 3)
    jcc(a, cc_b, bad)
    alui(a, "cmp", r12, 4)
    jcc(a, cc_a, bad)
    # what each may be: r8 to r11 the four kinds (the alpha 0 if there is none)
    load(a, r8, rip("css_types"))
    load(a, r9, rip_plus("css_types", 8))
    load(a, r10, rip_plus("css_types", 16))
    movi(a, r11, 0)
    alui(a, "cmp", r12, 4)
    set three to new_label(a)
    jcc(a, cc_ne, three)
    load(a, r11, rip_plus("css_types", 24))
    mark(a, three)
    for each r in list of r8, r9, r10, r11 # some other unit never; none only the new way
        alui(a, "cmp", r, 4)
        jcc(a, cc_e, bad)
        set not_none_here to new_label(a)
        alui(a, "cmp", r, 3)
        jcc(a, cc_ne, not_none_here)
        test_rr(a, r13, r13)
        jcc(a, cc_ne, bad)
        mark(a, not_none_here)
    end
    alui(a, "cmp", r11, 2) # an alpha is a number or a percentage
    jcc(a, cc_e, bad)
    set hsl_kinds to new_label(a)
    test_rr(a, rbx, rbx)
    jcc(a, cc_ne, hsl_kinds)
    for each r in list of r8, r9, r10 # rgb: no angles; the old way, all numbers or all percentages
        alui(a, "cmp", r, 2)
        jcc(a, cc_e, bad)
    end
    test_rr(a, r13, r13)
    jcc(a, cc_e, checked)
    alu(a, "cmp", r8, r9)
    jcc(a, cc_ne, bad)
    alu(a, "cmp", r8, r10)
    jcc(a, cc_ne, bad)
    jmp_to(a, checked)
    mark(a, hsl_kinds) # hsl: a hue that's no percentage; then no angles, and the old way percentages
    alui(a, "cmp", r8, 1)
    jcc(a, cc_e, bad)
    for each r in list of r9, r10
        alui(a, "cmp", r, 2)
        jcc(a, cc_e, bad)
        set fine_here to new_label(a)
        test_rr(a, r13, r13)
        jcc(a, cc_e, fine_here)
        alui(a, "cmp", r, 1)
        jcc(a, cc_ne, bad)
        mark(a, fine_here)
    end
    mark(a, checked) # the alpha first: from 0 to 1, as a byte, in r14
    movi(a, r14, 255)
    alui(a, "cmp", r12, 4)
    set no_alpha to new_label(a)
    jcc(a, cc_ne, no_alpha)
    movsd_load(a, xmm0, rip_plus("css_vals", 24))
    css_unit_value(a, r11, 100)
    css_clamp(a, xmm0, 0, 1)
    css_byte(a, r14, xmm0)
    mark(a, no_alpha)
    shifti(a, "shl", r14, 24)
    set from_hsl to new_label(a)
    test_rr(a, rbx, rbx)
    jcc(a, cc_ne, from_hsl)
    for each k from 0 to 2 # red, green and blue: from 0 to 255, or a percentage of it
        movsd_load(a, xmm0, rip_plus("css_vals", 8 * k))
        load(a, rax, rip_plus("css_types", 8 * k))
        css_unit_value(a, rax, 100)
        set as_number to new_label(a)
        alui(a, "cmp", rax, 1)
        jcc(a, cc_ne, as_number)
        load_bits(a, xmm1, double_bytes(255))
        sse_math(a, "*", xmm0, reg_at(xmm1))
        mark(a, as_number)
        css_clamp(a, xmm0, 0, 255)
        load_bits(a, xmm5, double_bytes(0.5))
        sse_math(a, "+", xmm0, reg_at(xmm5))
        cvttsd2si(a, rax, xmm0)
        shifti(a, "shl", rax, 16 - 8 * k)
        alu(a, "or", r14, rax)
    end
    mov_rr(a, rax, r14)
    jmp_to(a, func_out)
    mark(a, from_hsl) # the hue in sixths of a turn, from 0 up to 6; saturation and lightness from 0 to 1
    movsd_load(a, xmm0, rip("css_vals"))
    load(a, rax, rip("css_types"))
    css_unit_value(a, rax, 1)
    load_bits(a, xmm1, double_bytes(360))
    movapd(a, xmm2, xmm0)
    sse_math(a, "/", xmm2, reg_at(xmm1))
    floor_sd(a, xmm2, xmm2)
    sse_math(a, "*", xmm2, reg_at(xmm1))
    sse_math(a, "-", xmm0, reg_at(xmm2))
    load_bits(a, xmm1, double_bytes(60))
    sse_math(a, "/", xmm0, reg_at(xmm1))
    movsd_store(a, rip("css_vals"), xmm0)
    for each k from 1 to 2
        movsd_load(a, xmm0, rip_plus("css_vals", 8 * k))
        load(a, rax, rip_plus("css_types", 8 * k))
        css_unit_value(a, rax, 1)
        css_clamp(a, xmm0, 0, 100)
        load_bits(a, xmm1, double_bytes(100))
        sse_math(a, "/", xmm0, reg_at(xmm1))
        movsd_store(a, rip_plus("css_vals", 8 * k), xmm0)
    end
    movsd_load(a, xmm3, rip_plus("css_vals", 8)) # s
    movsd_load(a, xmm4, rip_plus("css_vals", 16)) # l
    set coloured to new_label(a)
    load_bits(a, xmm0, double_bytes(0))
    ucomisd(a, xmm3, reg_at(xmm0))
    jcc(a, cc_ne, coloured)
    movapd(a, xmm0, xmm4) # no saturation: grey
    css_byte(a, rax, xmm0)
    alu(a, "or", r14, rax)
    shifti(a, "shl", rax, 8)
    alu(a, "or", r14, rax)
    shifti(a, "shl", rax, 8)
    alu(a, "or", r14, rax)
    mov_rr(a, rax, r14)
    jmp_to(a, func_out)
    mark(a, coloured) # temp2 in xmm2, temp1 in xmm1
    set high_light to new_label(a)
    set temps to new_label(a)
    load_bits(a, xmm0, double_bytes(0.5))
    ucomisd(a, xmm4, reg_at(xmm0))
    jcc(a, cc_a, high_light)
    load_bits(a, xmm2, double_bytes(1))
    sse_math(a, "+", xmm2, reg_at(xmm3))
    sse_math(a, "*", xmm2, reg_at(xmm4))
    jmp_to(a, temps)
    mark(a, high_light)
    movapd(a, xmm2, xmm4)
    sse_math(a, "+", xmm2, reg_at(xmm3))
    movapd(a, xmm0, xmm4)
    sse_math(a, "*", xmm0, reg_at(xmm3))
    sse_math(a, "-", xmm2, reg_at(xmm0))
    mark(a, temps)
    movapd(a, xmm1, xmm4)
    sse_math(a, "+", xmm1, reg_at(xmm4))
    sse_math(a, "-", xmm1, reg_at(xmm2))
    for each k from 0 to 2 # red at the hue plus 2, green at it, blue at it less 2
        movsd_load(a, xmm0, rip("css_vals"))
        if k is 0
            load_bits(a, xmm5, double_bytes(2))
            sse_math(a, "+", xmm0, reg_at(xmm5))
        else if k is 2
            load_bits(a, xmm5, double_bytes(2))
            sse_math(a, "-", xmm0, reg_at(xmm5))
        end
        call_to(a, "rt_hue_part")
        css_byte(a, rax, xmm0)
        shifti(a, "shl", rax, 16 - 8 * k)
        alu(a, "or", r14, rax)
    end
    mov_rr(a, rax, r14)
    jmp_to(a, func_out)
    mark(a, bad)
    movi(a, rax, -1)
    mark(a, func_out)
    pop_r(a, r14)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_hue_part: xmm0 a place in the hue, in sixths, xmm1 temp1 and xmm2 temp2: how much of the colour is
    # there, from 0 to 1, in xmm0, as Chrome's CalcHue has it; uses xmm5
    set wrapped to new_label(a)
    set not_below to new_label(a)
    set rising to new_label(a)
    set flat to new_label(a)
    set falling to new_label(a)
    mark(a, "rt_hue_part")
    load_bits(a, xmm5, double_bytes(0))
    ucomisd(a, xmm0, reg_at(xmm5))
    jcc(a, cc_ae, not_below)
    load_bits(a, xmm5, double_bytes(6))
    sse_math(a, "+", xmm0, reg_at(xmm5))
    jmp_to(a, wrapped)
    mark(a, not_below)
    load_bits(a, xmm5, double_bytes(6))
    ucomisd(a, xmm0, reg_at(xmm5))
    jcc(a, cc_b, wrapped)
    sse_math(a, "-", xmm0, reg_at(xmm5))
    mark(a, wrapped)
    load_bits(a, xmm5, double_bytes(1))
    ucomisd(a, xmm0, reg_at(xmm5))
    jcc(a, cc_b, rising)
    load_bits(a, xmm5, double_bytes(3))
    ucomisd(a, xmm0, reg_at(xmm5))
    jcc(a, cc_b, flat)
    load_bits(a, xmm5, double_bytes(4))
    ucomisd(a, xmm0, reg_at(xmm5))
    jcc(a, cc_b, falling)
    movapd(a, xmm0, xmm1)
    ret(a)
    mark(a, flat)
    movapd(a, xmm0, xmm2)
    ret(a)
    mark(a, falling) # 4 less it
    load_bits(a, xmm5, double_bytes(4))
    sse_math(a, "-", xmm5, reg_at(xmm0))
    movapd(a, xmm0, xmm5)
    mark(a, rising) # temp1 + (temp2 - temp1) times it
    movapd(a, xmm5, xmm2)
    sse_math(a, "-", xmm5, reg_at(xmm1))
    sse_math(a, "*", xmm0, reg_at(xmm5))
    sse_math(a, "+", xmm0, reg_at(xmm1))
    ret(a)
end

# xmm0, a value of the kind in register r (as rt_css_number gives it): none is 0, and a percentage is divided
# by `per`; uses xmm5
to css_unit_value with a, r, per
    set not_none to new_label(a)
    set not_per to new_label(a)
    alui(a, "cmp", r, 3)
    jcc(a, cc_ne, not_none)
    load_bits(a, xmm0, double_bytes(0))
    mark(a, not_none)
    alui(a, "cmp", r, 1)
    jcc(a, cc_ne, not_per)
    load_bits(a, xmm5, double_bytes(per))
    sse_math(a, "/", xmm0, reg_at(xmm5))
    mark(a, not_per)
end

# What a window does on Windows and Linux alike: CSS's colours, how small to draw a picture, and calling an
# app's handlers.
to emit_gui_common with a
    set ro to rodata of a
    pad_to(ro, 8)
    rodata_here(a, "css_names") # 32 bytes each: the name's length, then the name
    set colour_count to 0
    set k to 1
    repeat while k is at most length of css_colors
        set named to (item k of css_colors) as bytes
        put64(ro, length of named)
        put_all(ro, named)
        repeat 24 - length of named times
            add 0 to ro
        end
        add 1 to colour_count
        set k to k + 2
    end
    rodata_here(a, "css_argb")
    set k to 2
    repeat while k is at most length of css_colors
        put32(ro, 0xFF000000 + item k of css_colors)
        set k to k + 2
    end
    # rt_css_argb: rax a colour as text: its ARGB in rax, or -1 for one a canvas wouldn't know. #rgb, #rgba,
    # #rrggbb, #rrggbbaa, a CSS name in any case, transparent, or rgb(), rgba(), hsl() and hsla() (see
    # rt_css_func), with white space either side.
    set hex_loop to new_label(a)
    set hex_done to new_label(a)
    set not_hex to new_label(a)
    set unknown to new_label(a)
    set names_loop to new_label(a)
    set name_next to new_label(a)
    set name_chars to new_label(a)
    set name_found to new_label(a)
    set digit_ok to new_label(a)
    set lower_ok to new_label(a)
    set short_form to new_label(a)
    set has_alpha to new_label(a)
    set argb_back to new_label(a)
    set a_text_colour to new_label(a)
    mark(a, "rt_css_argb")
    mov_rr(a, rcx, rax)
    shifti(a, "shr", rcx, 48)
    alui(a, "cmp", rcx, kind_text)
    jcc(a, cc_e, a_text_colour)
    movi(a, rax, -1)
    ret(a)
    mark(a, a_text_colour)
    push_r(a, rbx)
    push_r(a, r12)
    push_r(a, r13)
    untag(a, rax)
    load(a, rsi, mem(rax, 16))
    load(a, rcx, mem(rax, 0))
    set trim_front to new_label(a) # without the white space either side, as CSS reads it
    set trim_back to new_label(a)
    set trimmed to new_label(a)
    mark(a, trim_front)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, unknown)
    load8(a, rax, mem(rsi, 0))
    css_space_jump(a, rax, trim_back)
    inc_r(a, rsi)
    dec_r(a, rcx)
    jmp_to(a, trim_front)
    mark(a, trim_back)
    mov_rr(a, rax, rsi)
    alu(a, "add", rax, rcx)
    load8(a, rax, mem(rax, -1))
    css_space_jump(a, rax, trimmed)
    dec_r(a, rcx)
    jmp_to(a, trim_back)
    mark(a, trimmed)
    load8(a, rax, mem(rsi, 0))
    alui(a, "cmp", rax, 35) # #
    jcc(a, cc_ne, not_hex)
    movi(a, rbx, 0) # the hex digits, 4 bits each
    lea(a, r12, mem(rcx, -1)) # how many
    movi(a, r13, 1)
    mark(a, hex_loop)
    alu(a, "cmp", r13, rcx)
    jcc(a, cc_ae, hex_done)
    mov_rr(a, rax, rsi)
    alu(a, "add", rax, r13)
    load8(a, rax, mem(rax, 0))
    alui(a, "or", rax, 32) # lower case
    alui(a, "sub", rax, 48)
    alui(a, "cmp", rax, 9)
    jcc(a, cc_be, digit_ok)
    alui(a, "sub", rax, 49) # 'a' - '0'
    alui(a, "cmp", rax, 5)
    jcc(a, cc_a, unknown)
    alui(a, "add", rax, 10)
    mark(a, digit_ok)
    shifti(a, "shl", rbx, 4)
    alu(a, "or", rbx, rax)
    inc_r(a, r13)
    jmp_to(a, hex_loop)
    mark(a, hex_done)
    alui(a, "cmp", r12, 3)
    jcc(a, cc_e, short_form)
    alui(a, "cmp", r12, 4)
    jcc(a, cc_e, short_form)
    alui(a, "cmp", r12, 6)
    jcc(a, cc_e, argb_back)
    alui(a, "cmp", r12, 8)
    jcc(a, cc_ne, unknown)
    mov_rr(a, rax, rbx) # rrggbbaa: the alpha to the top
    alui(a, "and", rax, 255)
    shifti(a, "shl", rax, 24)
    shifti(a, "shr", rbx, 8)
    alu(a, "or", rbx, rax)
    mov_rr(a, rax, rbx)
    jmp_to(a, has_alpha)
    mark(a, short_form) # each digit twice
    movi(a, rax, 0)
    movi(a, r13, 0)
    set doubling to new_label(a)
    set doubled to new_label(a)
    mov_rr(a, rdx, r12)
    mark(a, doubling)
    test_rr(a, rdx, rdx)
    jcc(a, cc_e, doubled)
    dec_r(a, rdx)
    mov_rr(a, rcx, rdx)
    shifti(a, "shl", rcx, 2)
    mov_rr(a, r8, rbx)
    shift_cl(a, "shr", r8)
    alui(a, "and", r8, 15)
    mov_rr(a, r9, r8)
    shifti(a, "shl", r9, 4)
    alu(a, "or", r8, r9)
    shifti(a, "shl", rax, 8)
    alu(a, "or", rax, r8)
    jmp_to(a, doubling)
    mark(a, doubled)
    mov_rr(a, rbx, rax)
    alui(a, "cmp", r12, 4)
    jcc(a, cc_ne, argb_back)
    mov_rr(a, rax, rbx)
    alui(a, "and", rax, 255)
    shifti(a, "shl", rax, 24)
    shifti(a, "shr", rbx, 8)
    alu(a, "or", rbx, rax)
    mov_rr(a, rax, rbx)
    jmp_to(a, has_alpha)
    mark(a, argb_back)
    mov_rr(a, rax, rbx)
    alui(a, "or", rax, -16777216) # opaque
    shifti(a, "shl", rax, 32)
    shifti(a, "shr", rax, 32)
    mark(a, has_alpha)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
    mark(a, not_hex) # rgb(...) and the rest, or a name
    call_to(a, "rt_css_func")
    alui(a, "cmp", rax, -2)
    jcc(a, cc_ne, has_alpha)
    lea(a, rbx, rip("css_names"))
    movi(a, r12, 0)
    mark(a, names_loop)
    alui(a, "cmp", r12, colour_count)
    jcc(a, cc_ae, unknown)
    alu_load(a, "cmp", rcx, mem(rbx, 0))
    jcc(a, cc_ne, name_next)
    movi(a, r13, 0)
    mark(a, name_chars)
    alu(a, "cmp", r13, rcx)
    jcc(a, cc_ae, name_found)
    mov_rr(a, rax, rsi)
    alu(a, "add", rax, r13)
    load8(a, rax, mem(rax, 0))
    lea(a, rdx, mem(rax, -65)) # A to Z, lower case
    alui(a, "cmp", rdx, 25)
    jcc(a, cc_a, lower_ok)
    alui(a, "add", rax, 32)
    mark(a, lower_ok)
    mov_rr(a, rdx, rbx)
    alu(a, "add", rdx, r13)
    load8(a, rdx, mem(rdx, 8))
    alu(a, "cmp", rax, rdx)
    jcc(a, cc_ne, name_next)
    inc_r(a, r13)
    jmp_to(a, name_chars)
    mark(a, name_next)
    alui(a, "add", rbx, 32)
    inc_r(a, r12)
    jmp_to(a, names_loop)
    mark(a, name_found)
    lea(a, rax, rip("css_argb"))
    shifti(a, "shl", r12, 2)
    alu(a, "add", rax, r12)
    load32(a, rax, mem(rax, 0))
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
    mark(a, unknown) # transparent, or one it doesn't know
    set not_clear to new_label(a)
    alui(a, "cmp", rcx, 11)
    jcc(a, cc_ne, not_clear)
    lea(a, rdi, rip(label of text_place(a, "transparent")))
    movi(a, r13, 0)
    set clear_chars to new_label(a)
    mark(a, clear_chars)
    alui(a, "cmp", r13, 11)
    set is_clear to new_label(a)
    jcc(a, cc_ae, is_clear)
    mov_rr(a, rax, rsi)
    alu(a, "add", rax, r13)
    load8(a, rax, mem(rax, 0))
    alui(a, "or", rax, 32)
    mov_rr(a, rdx, rdi)
    alu(a, "add", rdx, r13)
    load8(a, rdx, mem(rdx, 0))
    alu(a, "cmp", rax, rdx)
    jcc(a, cc_ne, not_clear)
    inc_r(a, r13)
    jmp_to(a, clear_chars)
    mark(a, is_clear)
    movi(a, rax, 0)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)
    mark(a, not_clear)
    movi(a, rax, -1)
    pop_r(a, r13)
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    emit_css_functions(a)

    # rt_pic_scale: how much smaller to draw it: 1 for an app, else at most what fits it in, 240 from the middle
    set reach_loop to new_label(a)
    set reach_done to new_label(a)
    set not_line to new_label(a)
    set not_box to new_label(a)
    set not_round to new_label(a)
    set reached to new_label(a)
    set app_scale to new_label(a)
    mark(a, "rt_pic_scale")
    load(a, rax, rip("app_n"))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, app_scale)
    load_bits(a, xmm6, double_bytes(0)) # the reach
    load(a, rsi, rip("pic_items"))
    load(a, rcx, rip("pic_n"))
    mark(a, reach_loop)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, reach_done)
    load(a, rdx, mem(rsi, 0))
    alui(a, "cmp", rdx, 1)
    jcc(a, cc_ne, not_line)
    for each off in list of 8, 16, 24, 32
        movsd_load(a, xmm0, mem(rsi, off))
        abs_sd(a, xmm0)
        sse_math(a, "max", xmm6, reg_at(xmm0))
    end
    jmp_to(a, reached)
    mark(a, not_line)
    set as_box to new_label(a)
    if pictures of a # a picture reaches as far as a box
        alui(a, "cmp", rdx, 9)
        jcc(a, cc_e, as_box)
    end
    if widgets of a # a button or a text box reaches as a box does
        alui(a, "cmp", rdx, 5)
        jcc(a, cc_e, as_box)
        alui(a, "cmp", rdx, 6)
        jcc(a, cc_e, as_box)
    end
    if controls of a # and so do checkboxes, text areas and lists
        for each control_kind in list of 10, 11, 12, 13, 14
            alui(a, "cmp", rdx, control_kind)
            jcc(a, cc_e, as_box)
        end
    end
    alui(a, "cmp", rdx, 2)
    jcc(a, cc_ne, not_box)
    mark(a, as_box)
    for each pair in list of (list of 8, 0), (list of 16, 0), (list of 8, 24), (list of 16, 32)
        movsd_load(a, xmm0, mem(rsi, item 1 of pair))
        if item 2 of pair is not 0
            sse_math(a, "+", xmm0, mem(rsi, item 2 of pair))
        end
        abs_sd(a, xmm0)
        sse_math(a, "max", xmm6, reg_at(xmm0))
    end
    jmp_to(a, reached)
    mark(a, not_box)
    alui(a, "cmp", rdx, 3)
    jcc(a, cc_ne, not_round)
    movsd_load(a, xmm0, mem(rsi, 8)) # a circle: the farther of x and y, and its radius
    abs_sd(a, xmm0)
    movsd_load(a, xmm1, mem(rsi, 16))
    abs_sd(a, xmm1)
    sse_math(a, "max", xmm0, reg_at(xmm1))
    sse_math(a, "+", xmm0, mem(rsi, 24))
    sse_math(a, "max", xmm6, reg_at(xmm0))
    jmp_to(a, reached)
    mark(a, not_round) # text: its x, and its y and size
    movsd_load(a, xmm0, mem(rsi, 8))
    abs_sd(a, xmm0)
    sse_math(a, "max", xmm6, reg_at(xmm0))
    movsd_load(a, xmm0, mem(rsi, 16))
    abs_sd(a, xmm0)
    sse_math(a, "+", xmm0, mem(rsi, 24))
    sse_math(a, "max", xmm6, reg_at(xmm0))
    mark(a, reached)
    alui(a, "add", rsi, 64)
    dec_r(a, rcx)
    jmp_to(a, reach_loop)
    mark(a, reach_done)
    load_bits(a, xmm0, double_bytes(240))
    sse_math(a, "/", xmm0, reg_at(xmm6))
    load_bits(a, xmm1, double_bytes(1))
    minsd(a, xmm1, xmm0)
    movsd_store(a, rip("gui_scale"), xmm1)
    ret(a)
    mark(a, app_scale)
    load_bits(a, xmm0, double_bytes(1))
    movsd_store(a, rip("gui_scale"), xmm0)
    ret(a)

    # rt_app_call: rbx a handler: its function, called with ev_a and ev_b, as many as it takes. It's the
    # first call in progress, so a mistake in it lists only the calls under it.
    set no_inputs to new_label(a)
    mark(a, "rt_app_call")
    for each r in list of rbx, rbp, r12, r13, r14, r15
        push_r(a, r)
    end
    mov_rr(a, r12, rsp)
    load(a, rax, mem(rbx, 8))
    push_r(a, rax)
    load(a, rcx, mem(rbx, 16))
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, no_inputs)
    load(a, rax, rip("ev_a"))
    push_r(a, rax)
    alui(a, "cmp", rcx, 2)
    jcc(a, cc_b, no_inputs)
    load(a, rax, rip("ev_b"))
    push_r(a, rax)
    mark(a, no_inputs)
    storei(a, rip("try_top"), 0)
    movi(a, r15, 1)
    load(a, rax, mem(rbx, 8))
    untag(a, rax)
    load(a, rdx, mem(rax, 8))
    load(a, rcx, mem(rax, 0))
    movi(a, rax, -1)
    call_r(a, rcx)
    call_mark(a, -1)
    mov_rr(a, rsp, r12)
    if last_word of a # the handler done, the app waits for what happens next
        call_to(a, "rt_dbg_waits")
    end
    call_to(a, "rt_flush_out") # what it said, shown now
    for each r in list of r15, r14, r13, r12, rbp, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_app_send: rcx what happened (0 a key, 1 a click, 2 a drag): each handler of it, in order
    set send_loop to new_label(a)
    set send_next to new_label(a)
    set sent to new_label(a)
    mark(a, "rt_app_send")
    for each r in list of rbx, r12, r13
        push_r(a, r)
    end
    mov_rr(a, r12, rcx)
    movi(a, r13, 0)
    mark(a, send_loop)
    alu_load(a, "cmp", r13, rip("app_n"))
    jcc(a, cc_ae, sent)
    mov_rr(a, rbx, r13)
    shifti(a, "shl", rbx, 5)
    alu_load(a, "add", rbx, rip("app_items"))
    alu_load(a, "cmp", r12, mem(rbx, 0))
    jcc(a, cc_ne, send_next)
    call_to(a, "rt_app_call")
    mark(a, send_next)
    inc_r(a, r13)
    jmp_to(a, send_loop)
    mark(a, sent)
    for each r in list of r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_app_tick: rcx which timer, from 0 in the order the program made them: its handler
    set tick_loop to new_label(a)
    set tick_next to new_label(a)
    set ticked to new_label(a)
    mark(a, "rt_app_tick")
    for each r in list of rbx, r12, r13
        push_r(a, r)
    end
    mov_rr(a, r12, rcx)
    movi(a, r13, 0)
    mark(a, tick_loop)
    alu_load(a, "cmp", r13, rip("app_n"))
    jcc(a, cc_ae, ticked)
    mov_rr(a, rbx, r13)
    shifti(a, "shl", rbx, 5)
    alu_load(a, "add", rbx, rip("app_items"))
    load(a, rax, mem(rbx, 0))
    alui(a, "cmp", rax, app_timer)
    jcc(a, cc_ne, tick_next)
    test_rr(a, r12, r12)
    jcc(a, cc_ne, tick_next)
    call_to(a, "rt_app_call")
    jmp_to(a, ticked)
    mark(a, tick_next)
    load(a, rax, mem(rbx, 0))
    alui(a, "cmp", rax, app_timer)
    set not_timer to new_label(a)
    jcc(a, cc_ne, not_timer)
    dec_r(a, r12)
    mark(a, not_timer)
    inc_r(a, r13)
    jmp_to(a, tick_loop)
    mark(a, ticked)
    for each r in list of r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_ev_spot: rcx and rdx a point in the window: as the picture's own numbers, (0, 0) in the middle and y
    # going up, in ev_a and ev_b
    mark(a, "rt_ev_spot")
    alui(a, "sub", rcx, 250)
    cvtsi2sd(a, xmm0, rcx)
    movsd_store(a, rip("ev_a"), xmm0)
    movi(a, rax, 250)
    alu(a, "sub", rax, rdx)
    cvtsi2sd(a, xmm0, rax)
    movsd_store(a, rip("ev_b"), xmm0)
    ret(a)

    # rt_math_round: xmm0 as Math.round has it, into rax
    set rounded_down to new_label(a)
    mark(a, "rt_math_round")
    floor_sd(a, xmm1, xmm0)
    movapd(a, xmm2, xmm0)
    sse_math(a, "-", xmm2, reg_at(xmm1))
    cvttsd2si(a, rax, xmm1)
    load_bits(a, xmm3, double_bytes(0.5))
    ucomisd(a, xmm2, reg_at(xmm3))
    jcc(a, cc_b, rounded_down)
    inc_r(a, rax)
    mark(a, rounded_down)
    ret(a)

    # rt_ev_run: rcx how many UTF-16 units of MOTH_EVENTS are in gui_events: each event they list, sent to the
    # app as if it had happened in the window, each unit taken as a byte
    set ev_loop to new_label(a)
    set ev_done to new_label(a)
    set ev_click to new_label(a)
    set ev_drag to new_label(a)
    set ev_tick to new_label(a)
    set ev_key to new_label(a)
    set ev_skip to new_label(a)
    mark(a, "rt_ev_run")
    for each r in list of r12, r13, r14, r15
        push_r(a, r)
    end
    mov_rr(a, r13, rcx)
    lea(a, r12, rip("gui_events"))
    alu(a, "add", r13, r13)
    alu(a, "add", r13, r12)
    mark(a, ev_loop)
    alu(a, "cmp", r12, r13)
    jcc(a, cc_ae, ev_done)
    load16(a, rax, mem(r12, 0))
    alui(a, "cmp", rax, 32)
    jcc(a, cc_e, ev_skip)
    alui(a, "cmp", rax, 59)
    jcc(a, cc_e, ev_skip)
    mov_rr(a, r15, rax) # what it is, by its first letter: k, c, d or t
    if widgets of a # or "ty" for type, which goes as y
        set not_typing to new_label(a)
        alui(a, "cmp", r15, 116)
        jcc(a, cc_ne, not_typing)
        load16(a, rax, mem(r12, 2))
        alui(a, "cmp", rax, 121)
        jcc(a, cc_ne, not_typing)
        movi(a, r15, 121)
        mark(a, not_typing)
    end
    mark(a, "rt_ev_word")
    alu(a, "cmp", r12, r13)
    jcc(a, cc_ae, ev_done)
    load16(a, rax, mem(r12, 0))
    alui(a, "cmp", rax, 32)
    set word_over to new_label(a)
    jcc(a, cc_e, word_over)
    alui(a, "add", r12, 2)
    jmp_to(a, "rt_ev_word")
    mark(a, word_over)
    alui(a, "add", r12, 2)
    alui(a, "cmp", r15, 107) # k
    jcc(a, cc_e, ev_key)
    if widgets of a
        alui(a, "cmp", r15, 121) # y: the text typed, up to the next ;, as a key's name is read
        jcc(a, cc_e, ev_key)
    end
    call_to(a, "rt_ev_int")
    mov_rr(a, r14, rax)
    alui(a, "cmp", r15, 116) # t
    jcc(a, cc_e, ev_tick)
    call_to(a, "rt_ev_int")
    mov_rr(a, rdx, rax)
    mov_rr(a, rcx, r14)
    alui(a, "add", rcx, 250) # the numbers are the picture's own: as a point in the window
    movi(a, rax, 250)
    alu(a, "sub", rax, rdx)
    mov_rr(a, rdx, rax)
    call_to(a, "rt_ev_spot")
    if controls of a # s: a wheel, how many rows after where it is
        set not_wheel to new_label(a)
        alui(a, "cmp", r15, 115)
        jcc(a, cc_ne, not_wheel)
        call_to(a, "rt_ev_int")
        store(a, rip("ev_c"), rax)
        movi(a, rcx, 6)
        jmp_to(a, ev_click)
        mark(a, not_wheel)
    end
    movi(a, rcx, 1)
    alui(a, "cmp", r15, 99) # c
    jcc(a, cc_e, ev_click)
    movi(a, rcx, 2)
    mark(a, ev_click)
    app_send(a)
    jmp_to(a, ev_loop)
    mark(a, ev_tick)
    mov_rr(a, rcx, r14)
    call_to(a, "rt_app_tick")
    jmp_to(a, ev_loop)
    mark(a, ev_key) # the key's name, up to the next ;
    call_to(a, "rt_b_reset")
    set key_chars to new_label(a)
    set key_over to new_label(a)
    mark(a, key_chars)
    alu(a, "cmp", r12, r13)
    jcc(a, cc_ae, key_over)
    load16(a, rax, mem(r12, 0))
    alui(a, "cmp", rax, 59)
    jcc(a, cc_e, key_over)
    call_to(a, "rt_b_byte")
    alui(a, "add", r12, 2)
    jmp_to(a, key_chars)
    mark(a, key_over)
    call_to(a, "rt_b_text")
    store(a, rip("ev_a"), rax)
    movi(a, rcx, 0)
    if widgets of a
        alui(a, "cmp", r15, 121)
        set as_key to new_label(a)
        jcc(a, cc_ne, as_key)
        movi(a, rcx, 5)
        mark(a, as_key)
    end
    app_send(a)
    jmp_to(a, ev_loop)
    mark(a, ev_skip)
    alui(a, "add", r12, 2)
    jmp_to(a, ev_loop)
    mark(a, ev_done)
    for each r in list of r15, r14, r13, r12
        pop_r(a, r)
    end
    ret(a)

    # rt_ev_int: a whole number, maybe with a minus, from r12 (UTF-16) on, up to a space or ;: in rax
    set int_loop to new_label(a)
    set int_done to new_label(a)
    set int_plus to new_label(a)
    mark(a, "rt_ev_int")
    movi(a, rax, 0)
    movi(a, rcx, 0)
    load16(a, rdx, mem(r12, 0))
    alui(a, "cmp", rdx, 45)
    jcc(a, cc_ne, int_loop)
    movi(a, rcx, 1)
    alui(a, "add", r12, 2)
    mark(a, int_loop)
    alu(a, "cmp", r12, r13)
    jcc(a, cc_ae, int_done)
    load16(a, rdx, mem(r12, 0))
    alui(a, "sub", rdx, 48)
    alui(a, "cmp", rdx, 9)
    jcc(a, cc_a, int_done)
    imul_ri(a, rax, rax, 10)
    alu(a, "add", rax, rdx)
    alui(a, "add", r12, 2)
    jmp_to(a, int_loop)
    mark(a, int_done)
    alui(a, "add", r12, 2)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, int_plus)
    unary(a, "neg", rax)
    mark(a, int_plus)
    ret(a)
end

to emit_gui with a, title
    emit_gui_common(a)
    set class_name to wide_place(a, "MothWindow")
    set font_name to wide_place(a, "Segoe UI")
    set mono_names to empty list
    if widgets of a # and for what's typed in a box, a font whose letters all take the same room
        set mono_names to list of wide_place(a, "Consolas"), wide_place(a, "Courier New")
    end
    set picture_title to wide_place(a, title + " - Moth")
    set picture_env to wide_place(a, "MOTH_PICTURE")
    set events_env to wide_place(a, "MOTH_EVENTS")
    set pad_hint to wide_place(a, "Enter answers, Esc clears, closing ends the program")

    # rt_render_picture: rcx a GDI+ graphics: the picture on it, from the last `clear` on
    set item_loop to new_label(a)
    set items_done to new_label(a)
    set colour_known to new_label(a)
    set colour_kept to new_label(a)
    set a_box to new_label(a)
    set a_circle to new_label(a)
    set a_text to new_label(a)
    set item_next to new_label(a)
    set not_dot to new_label(a)
    mark(a, "rt_render_picture")
    for each r in list of rbx, r12, r13, r14, r15
        push_r(a, r)
    end
    mov_rr(a, r14, rcx)
    if widgets of a
        store(a, rip("gui_gfx"), rcx)
    end
    win_enter(a)
    mov_rr(a, rcx, r14)
    movi(a, rdx, 4) # smoothed
    w_call(a, "GdipSetSmoothingMode")
    mov_rr(a, rcx, r14)
    movi(a, rdx, 4)
    w_call(a, "GdipSetTextRenderingHint")
    mov_rr(a, rcx, r14)
    movi(a, rdx, 0xFF0B1122) # the playground's dark blue
    w_call(a, "GdipGraphicsClear")
    call_to(a, "rt_pic_scale")
    movi(a, rax, 0xFF000000) # a colour a canvas doesn't know keeps the one before, black to start
    store(a, rip("gui_argb"), rax)
    storei(a, rip("gui_last"), 0)
    load(a, r12, rip("pic_items"))
    load(a, r13, rip("pic_n"))
    movi(a, r15, 0)
    mark(a, item_loop)
    alu(a, "cmp", r15, r13)
    jcc(a, cc_ae, items_done)
    mov_rr(a, rbx, r15)
    shifti(a, "shl", rbx, 6)
    alu(a, "add", rbx, r12)
    load(a, rax, mem(rbx, 48))
    alu_load(a, "cmp", rax, rip("gui_last"))
    jcc(a, cc_e, colour_known)
    store(a, rip("gui_last"), rax)
    call_to(a, "rt_css_argb")
    alui(a, "cmp", rax, -1)
    jcc(a, cc_e, colour_known)
    store(a, rip("gui_argb"), rax)
    mark(a, colour_known)
    load(a, rax, mem(rbx, 0))
    alui(a, "cmp", rax, 2)
    jcc(a, cc_e, a_box)
    alui(a, "cmp", rax, 3)
    jcc(a, cc_e, a_circle)
    alui(a, "cmp", rax, 4)
    jcc(a, cc_e, a_text)
    set a_picture to new_label(a)
    if pictures of a
        alui(a, "cmp", rax, 9)
        jcc(a, cc_e, a_picture)
    end
    set a_button to new_label(a)
    set a_textbox to new_label(a)
    if widgets of a
        alui(a, "cmp", rax, 5)
        jcc(a, cc_e, a_button)
        alui(a, "cmp", rax, 6)
        jcc(a, cc_e, a_textbox)
    end
    set control_draws to list of (list of new_label(a), 10, "rt_gui_check"), (list of new_label(a), 11, "rt_gui_typed"),
        (list of new_label(a), 12, "rt_gui_list"), (list of new_label(a), 13, "rt_gui_drop"), (list of new_label(a), 14, "rt_gui_slide")
    if controls of a # see emit_gui_controls
        for each drawn_kind in control_draws
            alui(a, "cmp", rax, item 2 of drawn_kind)
            jcc(a, cc_e, item 1 of drawn_kind)
        end
    end
    # a line, with round ends; one that goes nowhere is a dot, as on a canvas
    movsd_load(a, xmm0, mem(rbx, 8))
    ucomisd(a, xmm0, mem(rbx, 24))
    jcc(a, cc_ne, not_dot)
    movsd_load(a, xmm0, mem(rbx, 16))
    ucomisd(a, xmm0, mem(rbx, 32))
    jcc(a, cc_ne, not_dot)
    load32(a, rcx, rip("gui_argb"))
    lea(a, rdx, rip("gui_brush"))
    w_call(a, "GdipCreateSolidFill")
    movsd_load(a, xmm0, mem(rbx, 40)) # the width, scaled: a circle that wide
    sse_math(a, "*", xmm0, rip("gui_scale"))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, arg_at(5), xmm4)
    movss_store(a, arg_at(6), xmm4)
    load_bits(a, xmm1, double_bytes(0.5))
    sse_math(a, "*", xmm0, reg_at(xmm1))
    movsd_store(a, rip("gui_half"), xmm0)
    picture_x(a, xmm2, mem(rbx, 8))
    sse_math(a, "-", xmm2, rip("gui_half"))
    cvtsd2ss(a, xmm2, xmm2)
    picture_y(a, xmm3, mem(rbx, 16))
    sse_math(a, "-", xmm3, rip("gui_half"))
    cvtsd2ss(a, xmm3, xmm3)
    mov_rr(a, rcx, r14)
    load(a, rdx, rip("gui_brush"))
    w_call(a, "GdipFillEllipse")
    load(a, rcx, rip("gui_brush"))
    w_call(a, "GdipDeleteBrush")
    jmp_to(a, item_next)
    mark(a, not_dot)
    movsd_load(a, xmm0, mem(rbx, 40))
    sse_math(a, "*", xmm0, rip("gui_scale"))
    cvtsd2ss(a, xmm1, xmm0)
    load32(a, rcx, rip("gui_argb"))
    movi(a, r8, 2) # in pixels
    lea(a, r9, rip("gui_pen"))
    w_call(a, "GdipCreatePen1")
    for each fn_name in list of "GdipSetPenStartCap", "GdipSetPenEndCap"
        load(a, rcx, rip("gui_pen"))
        movi(a, rdx, 2) # round
        w_call(a, fn_name)
    end
    picture_x(a, xmm0, mem(rbx, 24))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, arg_at(5), xmm4)
    picture_y(a, xmm0, mem(rbx, 32))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, arg_at(6), xmm4)
    picture_x(a, xmm2, mem(rbx, 8))
    cvtsd2ss(a, xmm2, xmm2)
    picture_y(a, xmm3, mem(rbx, 16))
    cvtsd2ss(a, xmm3, xmm3)
    mov_rr(a, rcx, r14)
    load(a, rdx, rip("gui_pen"))
    w_call(a, "GdipDrawLine")
    load(a, rcx, rip("gui_pen"))
    w_call(a, "GdipDeletePen")
    jmp_to(a, item_next)
    mark(a, a_box) # from its corner nearest the top left
    load32(a, rcx, rip("gui_argb"))
    lea(a, rdx, rip("gui_brush"))
    w_call(a, "GdipCreateSolidFill")
    movsd_load(a, xmm0, mem(rbx, 8))
    movapd(a, xmm1, xmm0)
    sse_math(a, "+", xmm1, mem(rbx, 24))
    minsd(a, xmm0, xmm1)
    movsd_store(a, rip("gui_t0"), xmm0)
    movsd_load(a, xmm0, mem(rbx, 16))
    movapd(a, xmm1, xmm0)
    sse_math(a, "+", xmm1, mem(rbx, 32))
    sse_math(a, "max", xmm0, reg_at(xmm1))
    movsd_store(a, rip("gui_t1"), xmm0)
    for each pair in list of (list of 24, 5), (list of 32, 6)
        movsd_load(a, xmm0, mem(rbx, item 1 of pair))
        abs_sd(a, xmm0)
        sse_math(a, "*", xmm0, rip("gui_scale"))
        cvtsd2ss(a, xmm4, xmm0)
        movss_store(a, arg_at(item 2 of pair), xmm4)
    end
    picture_x(a, xmm2, rip("gui_t0"))
    cvtsd2ss(a, xmm2, xmm2)
    picture_y(a, xmm3, rip("gui_t1"))
    cvtsd2ss(a, xmm3, xmm3)
    mov_rr(a, rcx, r14)
    load(a, rdx, rip("gui_brush"))
    w_call(a, "GdipFillRectangle")
    load(a, rcx, rip("gui_brush"))
    w_call(a, "GdipDeleteBrush")
    jmp_to(a, item_next)
    mark(a, a_circle) # in the square around it
    load32(a, rcx, rip("gui_argb"))
    lea(a, rdx, rip("gui_brush"))
    w_call(a, "GdipCreateSolidFill")
    movsd_load(a, xmm0, mem(rbx, 8))
    sse_math(a, "-", xmm0, mem(rbx, 24))
    movsd_store(a, rip("gui_t0"), xmm0)
    movsd_load(a, xmm0, mem(rbx, 16))
    sse_math(a, "+", xmm0, mem(rbx, 24))
    movsd_store(a, rip("gui_t1"), xmm0)
    movsd_load(a, xmm0, mem(rbx, 24))
    sse_math(a, "+", xmm0, reg_at(xmm0))
    sse_math(a, "*", xmm0, rip("gui_scale"))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, arg_at(5), xmm4)
    movss_store(a, arg_at(6), xmm4)
    picture_x(a, xmm2, rip("gui_t0"))
    cvtsd2ss(a, xmm2, xmm2)
    picture_y(a, xmm3, rip("gui_t1"))
    cvtsd2ss(a, xmm3, xmm3)
    mov_rr(a, rcx, r14)
    load(a, rdx, rip("gui_brush"))
    w_call(a, "GdipFillEllipse")
    load(a, rcx, rip("gui_brush"))
    w_call(a, "GdipDeleteBrush")
    jmp_to(a, item_next)
    if pictures of a
        mark(a, a_picture)
        emit_picture_draw(a)
        jmp_to(a, item_next)
    end
    mark(a, a_text) # its baseline at y, as a canvas puts it
    load32(a, rcx, rip("gui_argb"))
    lea(a, rdx, rip("gui_brush"))
    w_call(a, "GdipCreateSolidFill")
    load(a, rcx, rip("gui_family"))
    movsd_load(a, xmm0, mem(rbx, 24))
    sse_math(a, "*", xmm0, rip("gui_scale"))
    cvtsd2ss(a, xmm1, xmm0)
    movi(a, r8, 0)
    movi(a, r9, 2)
    lea(a, rax, rip("gui_font"))
    store(a, arg_at(5), rax)
    w_call(a, "GdipCreateFont")
    load(a, rax, mem(rbx, 56)) # the text, as UTF-16
    untag(a, rax)
    movi(a, rcx, 65001)
    movi(a, rdx, 0)
    load(a, r8, mem(rax, 16))
    load32(a, r9, mem(rax, 0))
    lea(a, rax, rip("wbuf"))
    store(a, arg_at(5), rax)
    storei(a, arg_at(6), wide_cap)
    w_call(a, "MultiByteToWideChar")
    store(a, rip("gui_units"), rax)
    picture_x(a, xmm0, mem(rbx, 8))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, rip("gui_rectf"), xmm4)
    picture_y(a, xmm0, mem(rbx, 16))
    movsd_load(a, xmm1, mem(rbx, 24))
    sse_math(a, "*", xmm1, rip("gui_scale"))
    sse_math(a, "*", xmm1, rip("gui_ascent"))
    sse_math(a, "-", xmm0, reg_at(xmm1))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, rip_plus("gui_rectf", 4), xmm4)
    load_bits(a, xmm0, double_bytes(100000))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, rip_plus("gui_rectf", 8), xmm4)
    movss_store(a, rip_plus("gui_rectf", 12), xmm4)
    mov_rr(a, rcx, r14)
    lea(a, rdx, rip("wbuf"))
    load32(a, r8, rip("gui_units"))
    load(a, r9, rip("gui_font"))
    lea(a, rax, rip("gui_rectf"))
    store(a, arg_at(5), rax)
    load(a, rax, rip("gui_format"))
    store(a, arg_at(6), rax)
    load(a, rax, rip("gui_brush"))
    store(a, arg_at(7), rax)
    w_call(a, "GdipDrawString")
    load(a, rcx, rip("gui_font"))
    w_call(a, "GdipDeleteFont")
    load(a, rcx, rip("gui_brush"))
    w_call(a, "GdipDeleteBrush")
    if widgets of a
        jmp_to(a, item_next)
        render_widgets(a, a_button, a_textbox, item_next)
        if controls of a
            for each drawn_kind in control_draws
                mark(a, item 1 of drawn_kind)
                call_to(a, item 3 of drawn_kind)
                jmp_to(a, item_next)
            end
        end
    end
    mark(a, item_next)
    inc_r(a, r15)
    jmp_to(a, item_loop)
    mark(a, items_done)
    if controls of a # an open dropdown's items, on top of everything
        call_to(a, "rt_gui_popup")
    end
    win_leave(a)
    for each r in list of r15, r14, r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_render_pad: rcx a GDI+ graphics: the drawing pad, its strokes 26 wide and nearly white, as the
    # playground's pad draws them, and how to use it
    set point_loop to new_label(a)
    set points_done to new_label(a)
    set stroke_start to new_label(a)
    set point_next to new_label(a)
    mark(a, "rt_render_pad")
    for each r in list of rbx, r12, r13, r14, r15
        push_r(a, r)
    end
    mov_rr(a, r14, rcx)
    win_enter(a)
    mov_rr(a, rcx, r14)
    movi(a, rdx, 4)
    w_call(a, "GdipSetSmoothingMode")
    mov_rr(a, rcx, r14)
    movi(a, rdx, 4)
    w_call(a, "GdipSetTextRenderingHint")
    mov_rr(a, rcx, r14)
    movi(a, rdx, 0xFF080C18)
    w_call(a, "GdipGraphicsClear")
    movi(a, rcx, 0xFFF5F5F5)
    load_bits(a, xmm0, double_bytes(26))
    cvtsd2ss(a, xmm1, xmm0)
    movi(a, r8, 2)
    lea(a, r9, rip("gui_pen"))
    w_call(a, "GdipCreatePen1")
    for each fn_name in list of "GdipSetPenStartCap", "GdipSetPenEndCap", "GdipSetPenLineJoin"
        load(a, rcx, rip("gui_pen"))
        movi(a, rdx, 2)
        w_call(a, fn_name)
    end
    movi(a, rcx, 0xFFF5F5F5)
    lea(a, rdx, rip("gui_brush"))
    w_call(a, "GdipCreateSolidFill")
    load(a, r12, rip("pad_pts"))
    load(a, r13, rip("pad_n"))
    movi(a, r15, 0)
    mark(a, point_loop)
    alu(a, "cmp", r15, r13)
    jcc(a, cc_ae, points_done)
    imul_ri(a, rbx, r15, 24)
    alu(a, "add", rbx, r12)
    load(a, rax, mem(rbx, 16))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, stroke_start)
    for each pair in list of (list of 0, 5), (list of 8, 6) # from the point before to this one
        load(a, rax, mem(rbx, item 1 of pair))
        cvtsi2sd(a, xmm0, rax)
        load_bits(a, xmm1, double_bytes(4.4))
        sse_math(a, "*", xmm0, reg_at(xmm1))
        cvtsd2ss(a, xmm4, xmm0)
        movss_store(a, arg_at(item 2 of pair), xmm4)
    end
    for each pair in list of (list of -24, xmm2), (list of -16, xmm3)
        load(a, rax, mem(rbx, item 1 of pair))
        cvtsi2sd(a, item 2 of pair, rax)
        load_bits(a, xmm1, double_bytes(4.4))
        sse_math(a, "*", item 2 of pair, reg_at(xmm1))
        cvtsd2ss(a, item 2 of pair, item 2 of pair)
    end
    mov_rr(a, rcx, r14)
    load(a, rdx, rip("gui_pen"))
    w_call(a, "GdipDrawLine")
    jmp_to(a, point_next)
    mark(a, stroke_start) # a dot where a stroke starts
    load_bits(a, xmm0, double_bytes(26))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, arg_at(5), xmm4)
    movss_store(a, arg_at(6), xmm4)
    for each pair in list of (list of 0, xmm2), (list of 8, xmm3)
        load(a, rax, mem(rbx, item 1 of pair))
        cvtsi2sd(a, item 2 of pair, rax)
        load_bits(a, xmm1, double_bytes(4.4))
        sse_math(a, "*", item 2 of pair, reg_at(xmm1))
        load_bits(a, xmm1, double_bytes(13))
        sse_math(a, "-", item 2 of pair, reg_at(xmm1))
        cvtsd2ss(a, item 2 of pair, item 2 of pair)
    end
    mov_rr(a, rcx, r14)
    load(a, rdx, rip("gui_brush"))
    w_call(a, "GdipFillEllipse")
    mark(a, point_next)
    inc_r(a, r15)
    jmp_to(a, point_loop)
    mark(a, points_done)
    load(a, rcx, rip("gui_pen"))
    w_call(a, "GdipDeletePen")
    load(a, rcx, rip("gui_brush"))
    w_call(a, "GdipDeleteBrush")
    movi(a, rcx, 0xFF5A6488) # how to use it, small and dim, at the bottom
    lea(a, rdx, rip("gui_brush"))
    w_call(a, "GdipCreateSolidFill")
    load(a, rcx, rip("gui_family"))
    load_bits(a, xmm0, double_bytes(13))
    cvtsd2ss(a, xmm1, xmm0)
    movi(a, r8, 0)
    movi(a, r9, 2)
    lea(a, rax, rip("gui_font"))
    store(a, arg_at(5), rax)
    w_call(a, "GdipCreateFont")
    for each pair in list of (list of 0, 10), (list of 4, 418), (list of 8, 420), (list of 12, 30)
        load_bits(a, xmm0, double_bytes(item 2 of pair))
        cvtsd2ss(a, xmm4, xmm0)
        movss_store(a, rip_plus("gui_rectf", item 1 of pair), xmm4)
    end
    mov_rr(a, rcx, r14)
    lea(a, rdx, rip(pad_hint))
    movi(a, r8, -1)
    load(a, r9, rip("gui_font"))
    lea(a, rax, rip("gui_rectf"))
    store(a, arg_at(5), rax)
    load(a, rax, rip("gui_format"))
    store(a, arg_at(6), rax)
    load(a, rax, rip("gui_brush"))
    store(a, arg_at(7), rax)
    w_call(a, "GdipDrawString")
    load(a, rcx, rip("gui_font"))
    w_call(a, "GdipDeleteFont")
    load(a, rcx, rip("gui_brush"))
    w_call(a, "GdipDeleteBrush")
    win_leave(a)
    for each r in list of r15, r14, r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_gui_start: GDI+, the font, and the window's class, once
    set started to new_label(a)
    mark(a, "rt_gui_start")
    load(a, rax, rip("gui_started"))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, started)
    storei(a, rip("gui_started"), 1)
    win_enter(a)
    storei(a, rip("gui_input"), 1)
    lea(a, rcx, rip("gui_token"))
    lea(a, rdx, rip("gui_input"))
    movi(a, r8, 0)
    w_call(a, "GdiplusStartup")
    lea(a, rcx, rip(font_name))
    movi(a, rdx, 0)
    lea(a, r8, rip("gui_family"))
    w_call(a, "GdipCreateFontFamilyFromName")
    load(a, rcx, rip("gui_family"))
    movi(a, rdx, 0)
    lea(a, r8, rip("gui_t0"))
    w_call(a, "GdipGetCellAscent")
    load(a, rcx, rip("gui_family"))
    movi(a, rdx, 0)
    lea(a, r8, rip("gui_t1"))
    w_call(a, "GdipGetEmHeight")
    load16(a, rax, rip("gui_t0")) # how far above the baseline the font goes, for its size
    cvtsi2sd(a, xmm0, rax)
    load16(a, rax, rip("gui_t1"))
    cvtsi2sd(a, xmm1, rax)
    sse_math(a, "/", xmm0, reg_at(xmm1))
    movsd_store(a, rip("gui_ascent"), xmm0)
    if widgets of a # Consolas, or Courier New, or the other if neither is there
        set mono_found to new_label(a)
        for each mono_name in mono_names
            lea(a, rcx, rip(mono_name))
            movi(a, rdx, 0)
            lea(a, r8, rip("gui_mono"))
            w_call(a, "GdipCreateFontFamilyFromName")
            mov32_rr(a, rax, rax)
            test_rr(a, rax, rax)
            jcc(a, cc_e, mono_found)
        end
        load(a, rax, rip("gui_family"))
        store(a, rip("gui_mono"), rax)
        mark(a, mono_found)
        load(a, rcx, rip("gui_mono"))
        movi(a, rdx, 0)
        lea(a, r8, rip("gui_t0"))
        w_call(a, "GdipGetCellAscent")
        load(a, rcx, rip("gui_mono"))
        movi(a, rdx, 0)
        lea(a, r8, rip("gui_t1"))
        w_call(a, "GdipGetEmHeight")
        load16(a, rax, rip("gui_t0"))
        cvtsi2sd(a, xmm0, rax)
        load16(a, rax, rip("gui_t1"))
        cvtsi2sd(a, xmm1, rax)
        sse_math(a, "/", xmm0, reg_at(xmm1))
        movsd_store(a, rip("gui_mono_ascent"), xmm0)
    end
    lea(a, rcx, rip("gui_format"))
    w_call(a, "GdipStringFormatGetGenericTypographic")
    movi(a, rcx, 0)
    w_call(a, "GetModuleHandleW")
    store(a, rip("gui_hinst"), rax)
    movi(a, rcx, 0)
    movi(a, rdx, 32512) # the arrow
    w_call(a, "LoadCursorW")
    storei(a, rip("gui_wc"), 80)
    lea(a, rcx, rip("rt_wndproc"))
    store(a, rip_plus("gui_wc", 8), rcx)
    load(a, rcx, rip("gui_hinst"))
    store(a, rip_plus("gui_wc", 24), rcx)
    store(a, rip_plus("gui_wc", 40), rax)
    lea(a, rcx, rip(class_name))
    store(a, rip_plus("gui_wc", 64), rcx)
    lea(a, rcx, rip("gui_wc"))
    w_call(a, "RegisterClassExW")
    win_leave(a)
    mark(a, started)
    ret(a)

    # rt_window_open: rcx 0 for the picture or 1 for the pad, rdx how many pixels across and down, r8 the
    # title: a window, shown
    mark(a, "rt_window_open")
    store(a, rip("gui_mode"), rcx)
    store(a, rip("gui_size"), rdx)
    storei(a, rip("gui_done"), 0)
    push_r(a, rbx)
    mov_rr(a, rbx, r8)
    call_to(a, "rt_gui_start")
    win_enter(a)
    storei(a, rip("gui_rect"), 0)
    load(a, rax, rip("gui_size"))
    store32(a, rip_plus("gui_rect", 8), rax)
    store32(a, rip_plus("gui_rect", 12), rax)
    lea(a, rcx, rip("gui_rect"))
    movi(a, rdx, 0x00CA0000) # a caption, a close box and a minimise box
    movi(a, r8, 0)
    w_call(a, "AdjustWindowRect")
    movi(a, rcx, 0)
    lea(a, rdx, rip(class_name))
    mov_rr(a, r8, rbx)
    movi(a, r9, 0x10CA0000) # and visible
    storei(a, arg_at(5), -2147483648)
    storei(a, arg_at(6), -2147483648)
    load32s(a, rax, rip_plus("gui_rect", 8))
    load32s(a, r10, rip("gui_rect"))
    alu(a, "sub", rax, r10)
    store(a, arg_at(7), rax)
    load32s(a, rax, rip_plus("gui_rect", 12))
    load32s(a, r10, rip_plus("gui_rect", 4))
    alu(a, "sub", rax, r10)
    store(a, arg_at(8), rax)
    storei(a, arg_at(9), 0)
    storei(a, arg_at(10), 0)
    load(a, rax, rip("gui_hinst"))
    store(a, arg_at(11), rax)
    storei(a, arg_at(12), 0)
    w_call(a, "CreateWindowExW")
    store(a, rip("gui_hwnd"), rax)
    mov_rr(a, rcx, rax)
    w_call(a, "SetForegroundWindow")
    win_leave(a)
    pop_r(a, rbx)
    ret(a)

    # rt_gui_loop: messages to the window until it's done with
    set loop_top to new_label(a)
    set loop_out to new_label(a)
    mark(a, "rt_gui_loop")
    win_enter(a)
    mark(a, loop_top)
    load(a, rax, rip("gui_done"))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, loop_out)
    if threading of a # in a frame of its own, below the registers' copies
        call_to(a, "rt_gil_out")
        win_enter(a)
    end
    lea(a, rcx, rip("gui_msg"))
    movi(a, rdx, 0)
    movi(a, r8, 0)
    movi(a, r9, 0)
    w_call(a, "GetMessageW")
    if threading of a
        win_leave(a)
        call_to(a, "rt_gil_in")
    end
    load32s(a, rax, reg_at(rax))
    alui(a, "cmp", rax, 0)
    jcc(a, cc_le, loop_out)
    lea(a, rcx, rip("gui_msg"))
    w_call(a, "TranslateMessage")
    lea(a, rcx, rip("gui_msg"))
    w_call(a, "DispatchMessageW")
    jmp_to(a, loop_top)
    mark(a, loop_out)
    win_leave(a)
    ret(a)

    # rt_paint: rcx the window: drawn again, into a picture of its own first, then all at once
    set as_pad to new_label(a)
    set drawn to new_label(a)
    mark(a, "rt_paint")
    for each r in list of rbx, r12, r13, r14
        push_r(a, r)
    end
    mov_rr(a, rbx, rcx)
    win_enter(a)
    mov_rr(a, rcx, rbx)
    lea(a, rdx, rip("gui_ps"))
    w_call(a, "BeginPaint")
    mov_rr(a, r12, rax)
    mov_rr(a, rcx, r12)
    w_call(a, "CreateCompatibleDC")
    mov_rr(a, r13, rax)
    mov_rr(a, rcx, r12)
    load(a, rdx, rip("gui_size"))
    mov_rr(a, r8, rdx)
    w_call(a, "CreateCompatibleBitmap")
    mov_rr(a, r14, rax)
    mov_rr(a, rcx, r13)
    mov_rr(a, rdx, r14)
    w_call(a, "SelectObject")
    store(a, rip("gui_old"), rax)
    mov_rr(a, rcx, r13)
    lea(a, rdx, rip("gui_graphics"))
    w_call(a, "GdipCreateFromHDC")
    load(a, rcx, rip("gui_graphics"))
    load(a, rax, rip("gui_mode"))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, as_pad)
    call_to(a, "rt_render_picture")
    jmp_to(a, drawn)
    mark(a, as_pad)
    call_to(a, "rt_render_pad")
    mark(a, drawn)
    load(a, rcx, rip("gui_graphics"))
    w_call(a, "GdipDeleteGraphics")
    mov_rr(a, rcx, r12)
    movi(a, rdx, 0)
    movi(a, r8, 0)
    load(a, r9, rip("gui_size"))
    store(a, arg_at(5), r9)
    store(a, arg_at(6), r13)
    storei(a, arg_at(7), 0)
    storei(a, arg_at(8), 0)
    storei(a, arg_at(9), 0x00CC0020) # copied as it is
    w_call(a, "BitBlt")
    mov_rr(a, rcx, r13)
    load(a, rdx, rip("gui_old"))
    w_call(a, "SelectObject")
    mov_rr(a, rcx, r14)
    w_call(a, "DeleteObject")
    mov_rr(a, rcx, r13)
    w_call(a, "DeleteDC")
    mov_rr(a, rcx, rbx)
    lea(a, rdx, rip("gui_ps"))
    w_call(a, "EndPaint")
    win_leave(a)
    for each r in list of r14, r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_pad_point: rcx and rdx a point on the pad, in its pixels, r8 1 if a stroke starts there: added, as
    # the playground's pad has it, from 0 to 100 across and down, unless it's less than 1.5 from the last
    set pad_room to new_label(a)
    set pad_some to new_label(a)
    set pad_add to new_label(a)
    set pad_skip to new_label(a)
    mark(a, "rt_pad_point")
    for each r in list of rbx, r12, r13
        push_r(a, r)
    end
    mov_rr(a, r13, r8)
    for each pair in list of (list of rcx, rbx), (list of rdx, r12)
        cvtsi2sd(a, xmm0, item 1 of pair)
        load_bits(a, xmm1, double_bytes(440))
        sse_math(a, "/", xmm0, reg_at(xmm1))
        load_bits(a, xmm1, double_bytes(100))
        sse_math(a, "*", xmm0, reg_at(xmm1))
        call_to(a, "rt_math_round")
        mov_rr(a, item 2 of pair, rax)
    end
    set pad_has to new_label(a)
    load(a, rax, rip("pad_n"))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, pad_has)
    movi(a, r13, 1) # the first point always starts a stroke
    jmp_to(a, pad_add)
    mark(a, pad_has)
    test_rr(a, r13, r13)
    jcc(a, cc_ne, pad_add)
    imul_ri(a, rax, rax, 24)
    alu_load(a, "add", rax, rip("pad_pts"))
    mov_rr(a, rcx, rbx)
    alu_load(a, "sub", rcx, mem(rax, -24))
    imul_rr(a, rcx, rcx)
    mov_rr(a, rdx, r12)
    alu_load(a, "sub", rdx, mem(rax, -16))
    imul_rr(a, rdx, rdx)
    alu(a, "add", rcx, rdx)
    cvtsi2sd(a, xmm0, rcx)
    load_bits(a, xmm1, double_bytes(2.25))
    ucomisd(a, xmm0, reg_at(xmm1))
    jcc(a, cc_b, pad_skip)
    mark(a, pad_add)
    load(a, rax, rip("pad_n"))
    alu_load(a, "cmp", rax, rip("pad_cap"))
    jcc(a, cc_b, pad_room)
    load(a, rcx, rip("pad_cap"))
    alu(a, "add", rcx, rcx)
    jcc(a, cc_ne, pad_some)
    movi(a, rcx, 256)
    mark(a, pad_some)
    store(a, rip("pad_cap"), rcx)
    imul_ri(a, rcx, rcx, 24)
    call_to(a, "rt_alloc_raw")
    mov_rr(a, rdi, rax)
    load(a, rsi, rip("pad_pts"))
    load(a, rcx, rip("pad_n"))
    imul_ri(a, rcx, rcx, 3)
    rep_movsq(a)
    store(a, rip("pad_pts"), rax)
    mark(a, pad_room)
    load(a, rax, rip("pad_n"))
    imul_ri(a, rax, rax, 24)
    alu_load(a, "add", rax, rip("pad_pts"))
    store(a, mem(rax, 0), rbx)
    store(a, mem(rax, 8), r12)
    store(a, mem(rax, 16), r13)
    alu_at(a, "add", rip("pad_n"), 1)
    mark(a, pad_skip)
    for each r in list of r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_b_int: rax a whole number, maybe below 0, its digits into the builder
    set positive to new_label(a)
    set digit_loop to new_label(a)
    set digits_out to new_label(a)
    mark(a, "rt_b_int")
    push_r(a, rbx)
    mov_rr(a, rbx, rax)
    test_rr(a, rbx, rbx)
    jcc(a, cc_ns, positive)
    movi(a, rax, 45)
    call_to(a, "rt_b_byte")
    unary(a, "neg", rbx)
    mark(a, positive)
    lea(a, rdi, rip_plus("dbuf", 32))
    mov_rr(a, rax, rbx)
    movi(a, rcx, 10)
    mark(a, digit_loop)
    movi(a, rdx, 0)
    unary(a, "div", rcx)
    alui(a, "add", rdx, 48)
    dec_r(a, rdi)
    store8(a, mem(rdi, 0), rdx)
    test_rr(a, rax, rax)
    jcc(a, cc_ne, digit_loop)
    mov_rr(a, rsi, rdi)
    lea(a, rcx, rip_plus("dbuf", 32))
    alu(a, "sub", rcx, rdi)
    call_to(a, "rt_b_bytes")
    pop_r(a, rbx)
    ret(a)

    # rt_pad_text: the strokes as text, the playground's pad's way: points "x,y" split by spaces, strokes by ";"
    set text_loop to new_label(a)
    set text_done to new_label(a)
    set not_first to new_label(a)
    set put_point to new_label(a)
    mark(a, "rt_pad_text")
    push_r(a, rbx)
    push_r(a, r12)
    call_to(a, "rt_b_reset")
    movi(a, r12, 0)
    mark(a, text_loop)
    alu_load(a, "cmp", r12, rip("pad_n"))
    jcc(a, cc_ae, text_done)
    imul_ri(a, rbx, r12, 24)
    alu_load(a, "add", rbx, rip("pad_pts"))
    test_rr(a, r12, r12)
    jcc(a, cc_e, put_point)
    movi(a, rax, 32)
    load(a, rcx, mem(rbx, 16))
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, not_first)
    movi(a, rax, 59)
    mark(a, not_first)
    call_to(a, "rt_b_byte")
    mark(a, put_point)
    load(a, rax, mem(rbx, 0))
    call_to(a, "rt_b_int")
    movi(a, rax, 44)
    call_to(a, "rt_b_byte")
    load(a, rax, mem(rbx, 8))
    call_to(a, "rt_b_int")
    inc_r(a, r12)
    jmp_to(a, text_loop)
    mark(a, text_done)
    call_to(a, "rt_b_text")
    pop_r(a, r12)
    pop_r(a, rbx)
    ret(a)

    # rt_wndproc: what Windows calls with what happened to the window: rcx the window, rdx what, r8 and r9
    # more about it. It keeps what Windows needs kept, the xmm registers from 6 on included.
    set w_paint to new_label(a)
    set w_erase to new_label(a)
    set w_close to new_label(a)
    set w_destroy to new_label(a)
    set w_timer to new_label(a)
    set w_key to new_label(a)
    set w_char to new_label(a)
    set w_down to new_label(a)
    set w_move to new_label(a)
    set w_up to new_label(a)
    set w_zero to new_label(a)
    set w_back to new_label(a)
    set w_redraw to new_label(a)
    set w_wheel to new_label(a)
    set w_ctrl to new_label(a)
    mark(a, "rt_wndproc")
    push_r(a, rbp)
    mov_rr(a, rbp, rsp)
    for each r in list of rbx, rsi, rdi, r12, r13, r14, r15
        push_r(a, r)
    end
    alui(a, "sub", rsp, 168)
    for each k from 6 to 15
        movdqu_store(a, mem(rsp, 16 * (k - 6)), k)
    end
    mov_rr(a, rbx, rcx)
    mov_rr(a, r12, rdx)
    mov_rr(a, r13, r8)
    mov_rr(a, r14, r9)
    if threading of a # called while the program waits for a message, with the turn let go: it takes it
        set held_already to new_label(a)
        storei(a, mem(rsp, 160), 0)
        lea(a, rcx, rip("thr_slots"))
        load(a, rax, mem(rcx, thr_holding))
        test_rr(a, rax, rax)
        jcc(a, cc_ne, held_already)
        call_to(a, "rt_gil_take")
        storei(a, mem(rsp, 160), 1)
        mark(a, held_already)
    end
    for each pair in list of (list of 0x000F, w_paint), (list of 0x0014, w_erase), (list of 0x0010, w_close),
        (list of 0x0002, w_destroy), (list of 0x0113, w_timer), (list of 0x0100, w_key), (list of 0x0102, w_char),
        (list of 0x0201, w_down), (list of 0x0200, w_move), (list of 0x0202, w_up)
        alui(a, "cmp", r12, item 1 of pair)
        jcc(a, cc_e, item 2 of pair)
    end
    if controls of a # the mouse's wheel
        alui(a, "cmp", r12, 0x020A)
        jcc(a, cc_e, w_wheel)
    end
    win_enter(a) # anything else, as Windows does it
    mov_rr(a, rcx, rbx)
    mov_rr(a, rdx, r12)
    mov_rr(a, r8, r13)
    mov_rr(a, r9, r14)
    w_call(a, "DefWindowProcW")
    win_leave(a)
    jmp_to(a, w_back)
    mark(a, w_paint)
    mov_rr(a, rcx, rbx)
    call_to(a, "rt_paint")
    jmp_to(a, w_zero)
    mark(a, w_erase) # never wiped first: it's drawn whole
    movi(a, rax, 1)
    jmp_to(a, w_back)
    mark(a, w_close) # the pad, closed: no answer; the picture, closed: gone
    set close_picture to new_label(a)
    load(a, rax, rip("gui_mode"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, close_picture)
    storei(a, rip("gui_done"), 2)
    jmp_to(a, w_zero)
    mark(a, close_picture)
    win_enter(a)
    mov_rr(a, rcx, rbx)
    w_call(a, "DestroyWindow")
    win_leave(a)
    jmp_to(a, w_zero)
    mark(a, w_destroy)
    load(a, rax, rip("gui_mode"))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, w_zero)
    storei(a, rip("gui_done"), 1)
    win_enter(a)
    movi(a, rcx, 0)
    w_call(a, "PostQuitMessage")
    win_leave(a)
    jmp_to(a, w_zero)
    mark(a, w_timer) # its handler: the timer's number is one more than its place
    mov_rr(a, r12, rbx)
    mov_rr(a, rbx, r13)
    dec_r(a, rbx)
    shifti(a, "shl", rbx, 5)
    alu_load(a, "add", rbx, rip("app_items"))
    call_to(a, "rt_app_call")
    mov_rr(a, rbx, r12)
    jmp_to(a, w_redraw)
    mark(a, w_key)
    set key_app to new_label(a)
    set key_found to new_label(a)
    set key_none to new_label(a)
    set key_names_loop to new_label(a)
    load(a, rax, rip("gui_mode"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, key_app)
    alui(a, "cmp", r13, 0x0D) # the pad: Enter answers, Escape wipes it
    set pad_not_enter to new_label(a)
    jcc(a, cc_ne, pad_not_enter)
    storei(a, rip("gui_done"), 1)
    jmp_to(a, w_zero)
    mark(a, pad_not_enter)
    alui(a, "cmp", r13, 0x1B)
    jcc(a, cc_ne, w_zero)
    storei(a, rip("pad_n"), 0)
    storei(a, rip("pad_down"), 0) # and a stroke going on stops, as the playground's does
    jmp_to(a, w_redraw)
    mark(a, key_app)
    win_enter(a) # not with Ctrl or Alt, as the playground has it
    movi(a, rcx, 0x11)
    w_call(a, "GetKeyState")
    win_leave(a)
    alui(a, "and", rax, 0x8000)
    if widgets of a # but see w_ctrl
        jcc(a, cc_ne, w_ctrl)
    else
        jcc(a, cc_ne, w_zero)
    end
    lea(a, rsi, rip("gui_keys"))
    movi(a, rcx, length of gui_key_names / 2)
    mark(a, key_names_loop)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, key_none)
    alu_load(a, "cmp", r13, mem(rsi, 0))
    jcc(a, cc_e, key_found)
    alui(a, "add", rsi, 16)
    dec_r(a, rcx)
    jmp_to(a, key_names_loop)
    mark(a, key_found)
    load(a, rax, rip("app_n"))
    test_rr(a, rax, rax)
    set key_send to new_label(a)
    jcc(a, cc_ne, key_send)
    alui(a, "cmp", r13, 0x1B) # a picture, not an app: Escape closes it
    jcc(a, cc_ne, w_zero)
    jmp_to(a, close_picture)
    mark(a, key_send)
    load(a, rax, mem(rsi, 8))
    movi64(a, rcx, tag_text)
    alu(a, "or", rax, rcx)
    store(a, rip("ev_a"), rax)
    if widgets of a # with Shift, a key that moves the cursor (End, Home or an arrow) goes as "shift+left" (DESIGN §41)
        set no_shift to new_label(a)
        alui(a, "cmp", r13, 0x23)
        jcc(a, cc_b, no_shift)
        alui(a, "cmp", r13, 0x28)
        jcc(a, cc_a, no_shift)
        load(a, r15, mem(rsi, 8))
        win_enter(a)
        movi(a, rcx, 0x10)
        w_call(a, "GetKeyState")
        win_leave(a)
        alui(a, "and", rax, 0x8000)
        jcc(a, cc_e, no_shift)
        call_to(a, "rt_b_reset")
        b_text(a, "shift+")
        load(a, rsi, mem(r15, 16))
        load(a, rcx, mem(r15, 0))
        call_to(a, "rt_b_bytes")
        call_to(a, "rt_b_text")
        store(a, rip("ev_a"), rax)
        mark(a, no_shift)
    end
    movi(a, rcx, 0)
    app_send(a)
    jmp_to(a, w_redraw)
    if widgets of a
        # With Ctrl, a letter goes as "ctrl+a", for a text box; but V pastes, as text typed, C copies what's
        # selected in the box with the focus, and X copies it, then goes, for the box to take it off
        set not_paste to new_label(a)
        set copy_it to new_label(a)
        set not_copy to new_label(a)
        mark(a, w_ctrl)
        alui(a, "cmp", r13, 0x41)
        jcc(a, cc_b, w_zero)
        alui(a, "cmp", r13, 0x5A)
        jcc(a, cc_a, w_zero)
        alui(a, "cmp", r13, 0x56)
        jcc(a, cc_ne, not_paste)
        call_to(a, "rt_clip_paste")
        test_rr(a, rax, rax)
        jcc(a, cc_e, w_zero)
        store(a, rip("ev_a"), rax)
        movi(a, rcx, 5)
        app_send(a)
        jmp_to(a, w_redraw)
        mark(a, not_paste)
        alui(a, "cmp", r13, 0x43)
        jcc(a, cc_e, copy_it)
        alui(a, "cmp", r13, 0x58)
        jcc(a, cc_ne, not_copy)
        mark(a, copy_it)
        call_to(a, "rt_clip_copy")
        alui(a, "cmp", r13, 0x43)
        jcc(a, cc_e, w_zero)
        mark(a, not_copy)
        call_to(a, "rt_b_reset")
        b_text(a, "ctrl+")
        mov_rr(a, rax, r13)
        alui(a, "add", rax, 32)
        call_to(a, "rt_b_byte")
        call_to(a, "rt_b_text")
        store(a, rip("ev_a"), rax)
        movi(a, rcx, 0)
        app_send(a)
        jmp_to(a, w_redraw)
    end
    mark(a, key_none)
    jmp_to(a, w_zero)
    mark(a, w_char) # a character: lower case, unless it's one of those above, or with Ctrl
    load(a, rax, rip("gui_mode"))
    test_rr(a, rax, rax)
    jcc(a, cc_ne, w_zero)
    alui(a, "cmp", r13, 0x20)
    if widgets of a # a space is typed too, though its key came with WM_KEYDOWN
        jcc(a, cc_b, w_zero)
    else
        jcc(a, cc_be, w_zero)
    end
    alui(a, "cmp", r13, 0x7F)
    jcc(a, cc_e, w_zero)
    mov_rr(a, rax, r13)
    alui(a, "and", rax, 0xF800)
    alui(a, "cmp", rax, 0xD800)
    jcc(a, cc_e, w_zero)
    win_enter(a)
    movi(a, rcx, 0x11)
    w_call(a, "GetKeyState")
    win_leave(a)
    alui(a, "and", rax, 0x8000)
    jcc(a, cc_ne, w_zero)
    set char_typed to new_label(a)
    if widgets of a
        alui(a, "cmp", r13, 0x20)
        jcc(a, cc_e, char_typed)
    end
    win_enter(a)
    mov_rr(a, rcx, r13)
    w_call(a, "CharLowerW")
    win_leave(a)
    alui(a, "and", rax, 0xFFFF)
    call_to(a, "rt_b_reset")
    call_to(a, "rt_b_code")
    call_to(a, "rt_b_text")
    store(a, rip("ev_a"), rax)
    movi(a, rcx, 0)
    app_send(a)
    if widgets of a # then the character as it was typed, for a text box
        mark(a, char_typed)
        call_to(a, "rt_b_reset")
        mov_rr(a, rax, r13)
        call_to(a, "rt_b_code")
        call_to(a, "rt_b_text")
        store(a, rip("ev_a"), rax)
        movi(a, rcx, 5)
        call_to(a, "rt_app_event")
    end
    jmp_to(a, w_redraw)
    mark(a, w_down)
    win_enter(a)
    mov_rr(a, rcx, rbx)
    w_call(a, "SetCapture")
    win_leave(a)
    movsx16(a, rcx, r14)
    mov_rr(a, rdx, r14)
    shifti(a, "shr", rdx, 16)
    movsx16(a, rdx, rdx)
    load(a, rax, rip("gui_mode"))
    test_rr(a, rax, rax)
    set down_app to new_label(a)
    jcc(a, cc_e, down_app)
    storei(a, rip("pad_down"), 1)
    movi(a, r8, 1)
    call_to(a, "rt_pad_point")
    jmp_to(a, w_redraw)
    mark(a, down_app)
    call_to(a, "rt_ev_spot")
    movi(a, rcx, 1)
    app_send(a)
    jmp_to(a, w_redraw)
    mark(a, w_move) # with the button down: a drag, or more of a stroke
    mov_rr(a, rax, r13)
    alui(a, "and", rax, 1)
    jcc(a, cc_e, w_zero)
    movsx16(a, rcx, r14)
    mov_rr(a, rdx, r14)
    shifti(a, "shr", rdx, 16)
    movsx16(a, rdx, rdx)
    load(a, rax, rip("gui_mode"))
    test_rr(a, rax, rax)
    set move_app to new_label(a)
    jcc(a, cc_e, move_app)
    load(a, rax, rip("pad_down"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, w_zero)
    movi(a, r8, 0)
    call_to(a, "rt_pad_point")
    jmp_to(a, w_redraw)
    mark(a, move_app)
    call_to(a, "rt_ev_spot")
    movi(a, rcx, 2)
    app_send(a)
    jmp_to(a, w_redraw)
    mark(a, w_up)
    storei(a, rip("pad_down"), 0)
    win_enter(a)
    w_call(a, "ReleaseCapture")
    win_leave(a)
    jmp_to(a, w_zero)
    if controls of a
        # In an app, a wheel scrolls the list under it: a row for each 40 it turns (3 a notch, as Windows
        # scrolls), down for a turn towards you, and a row for less.
        set wheel_some to new_label(a)
        mark(a, w_wheel)
        load(a, rax, rip("gui_mode"))
        test_rr(a, rax, rax)
        jcc(a, cc_ne, w_zero)
        mov_rr(a, rax, r13)
        shifti(a, "shr", rax, 16)
        movsx16(a, rax, rax)
        test_rr(a, rax, rax)
        jcc(a, cc_e, w_zero)
        unary(a, "neg", rax)
        mov_rr(a, r15, rax)
        cqo(a)
        movi(a, rcx, 40)
        unary(a, "idiv", rcx)
        test_rr(a, rax, rax)
        jcc(a, cc_ne, wheel_some)
        movi(a, rax, 1)
        test_rr(a, r15, r15)
        jcc(a, cc_ns, wheel_some)
        movi(a, rax, -1)
        mark(a, wheel_some)
        store(a, rip("ev_c"), rax)
        movsx16(a, rax, r14) # where it is: on the screen, then in the window
        store32(a, rip("gui_pt"), rax)
        mov_rr(a, rax, r14)
        shifti(a, "shr", rax, 16)
        movsx16(a, rax, rax)
        store32(a, rip_plus("gui_pt", 4), rax)
        win_enter(a)
        mov_rr(a, rcx, rbx)
        lea(a, rdx, rip("gui_pt"))
        w_call(a, "ScreenToClient")
        win_leave(a)
        load32(a, rcx, rip("gui_pt"))
        shifti(a, "shl", rcx, 32)
        shifti(a, "sar", rcx, 32)
        load32(a, rdx, rip_plus("gui_pt", 4))
        shifti(a, "shl", rdx, 32)
        shifti(a, "sar", rdx, 32)
        call_to(a, "rt_ev_spot")
        movi(a, rcx, 6)
        app_send(a)
        jmp_to(a, w_redraw)
    end
    mark(a, w_redraw) # what happened may have drawn something: the window, drawn again
    win_enter(a)
    mov_rr(a, rcx, rbx)
    movi(a, rdx, 0)
    movi(a, r8, 0)
    w_call(a, "InvalidateRect")
    win_leave(a)
    mark(a, w_zero)
    movi(a, rax, 0)
    mark(a, w_back)
    if threading of a # and gives it back, if it took it
        set not_taken to new_label(a)
        load(a, rcx, mem(rsp, 160))
        test_rr(a, rcx, rcx)
        jcc(a, cc_e, not_taken)
        push_r(a, rax)
        push_r(a, rax)
        call_to(a, "rt_gil_give")
        pop_r(a, rax)
        pop_r(a, rax)
        mark(a, not_taken)
    end
    for each k from 6 to 15
        movdqu_load(a, k, mem(rsp, 16 * (k - 6)))
    end
    alui(a, "add", rsp, 168)
    for each r in list of r15, r14, r13, r12, rdi, rsi, rbx
        pop_r(a, r)
    end
    pop_r(a, rbp)
    ret(a)

    # rt_headless: MOTH_PICTURE named a file: the events MOTH_EVENTS lists, then the picture, into that file
    # as a BMP, 500 by 500
    mark(a, "rt_headless")
    for each r in list of rbx, r12, r13, r14, r15
        push_r(a, r)
    end
    storei(a, rip("gui_headless"), 1)
    call_to(a, "rt_gui_start")
    win_enter(a)
    lea(a, rcx, rip(events_env))
    lea(a, rdx, rip("gui_events"))
    movi(a, r8, 4096)
    w_call(a, "GetEnvironmentVariableW")
    win_leave(a)
    mov32_rr(a, rcx, rax) # how many UTF-16 units: none if too many to fit
    set events_fit to new_label(a)
    alui(a, "cmp", rcx, 4096)
    jcc(a, cc_b, events_fit)
    movi(a, rcx, 0)
    mark(a, events_fit)
    call_to(a, "rt_ev_run")
    call_to(a, "rt_headless_write")
    for each r in list of r15, r14, r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_headless_write: the picture, into MOTH_PICTURE's file as a BMP, 500 by 500
    mark(a, "rt_headless_write")
    for each r in list of rbx, r12, r13, r14, r15
        push_r(a, r)
    end
    win_enter(a) # the picture, drawn into memory
    movi(a, rcx, 0)
    w_call(a, "CreateCompatibleDC")
    mov_rr(a, r12, rax)
    storei(a, rip("gui_bmi"), 40)
    movi(a, rax, 500)
    store32(a, rip_plus("gui_bmi", 4), rax)
    movi(a, rax, -500) # from the top down
    store32(a, rip_plus("gui_bmi", 8), rax)
    movi(a, rax, 0x00200001) # one plane, 32 bits a pixel
    store32(a, rip_plus("gui_bmi", 12), rax)
    mov_rr(a, rcx, r12)
    lea(a, rdx, rip("gui_bmi"))
    movi(a, r8, 0)
    lea(a, r9, rip("gui_bits"))
    storei(a, arg_at(5), 0)
    storei(a, arg_at(6), 0)
    w_call(a, "CreateDIBSection")
    mov_rr(a, r13, rax)
    mov_rr(a, rcx, r12)
    mov_rr(a, rdx, r13)
    w_call(a, "SelectObject")
    mov_rr(a, rcx, r12)
    lea(a, rdx, rip("gui_graphics"))
    w_call(a, "GdipCreateFromHDC")
    storei(a, rip("gui_mode"), 0)
    storei(a, rip("gui_size"), 500)
    load(a, rcx, rip("gui_graphics"))
    call_to(a, "rt_render_picture")
    load(a, rcx, rip("gui_graphics"))
    w_call(a, "GdipDeleteGraphics")
    w_call(a, "GdiFlush")
    lea(a, rcx, rip("gui_path")) # and into the file
    movi(a, rdx, 0x40000000)
    movi(a, r8, 0)
    movi(a, r9, 0)
    storei(a, arg_at(5), 2)
    storei(a, arg_at(6), 0x80)
    storei(a, arg_at(7), 0)
    w_call(a, "CreateFileW")
    mov_rr(a, r14, rax)
    movi(a, rax, 0x4D42) # BM, its size, and where the pixels start
    store(a, rip("gui_head"), rax)
    movi(a, rax, 54 + 1000000)
    store32(a, rip_plus("gui_head", 2), rax)
    storei(a, rip_plus("gui_head", 6), 0)
    movi(a, rax, 54)
    store32(a, rip_plus("gui_head", 10), rax)
    for each part in list of (list of "gui_head", 14), (list of "gui_bmi", 40), (list of "", 1000000)
        mov_rr(a, rcx, r14)
        if item 1 of part is ""
            load(a, rdx, rip("gui_bits"))
        else
            lea(a, rdx, rip(item 1 of part))
        end
        movi(a, r8, item 2 of part)
        lea(a, r9, rip("gui_t0"))
        storei(a, arg_at(5), 0)
        w_call(a, "WriteFile")
    end
    mov_rr(a, rcx, r14)
    w_call(a, "CloseHandle")
    win_leave(a)
    for each r in list of r15, r14, r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_gui_finish: the program has ended: MOTH_PICTURE, or at a terminal a window for what it drew or the
    # app it set up, until it's closed
    set finished to new_label(a)
    set timers_loop to new_label(a)
    set timers_next to new_label(a)
    set timers_done to new_label(a)
    set faster to new_label(a)
    # A handler that stops the program comes here again, from inside the window or the events: the program
    # ends there, its picture into the file if it's going to one.
    set first_time to new_label(a)
    set no_picture to new_label(a)
    mark(a, "rt_gui_finish")
    load(a, rax, rip("gui_ending"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, first_time)
    load(a, rax, rip("gui_headless"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, no_picture)
    call_to(a, "rt_headless_write")
    mark(a, no_picture)
    ret(a)
    mark(a, first_time)
    storei(a, rip("gui_ending"), 1)
    for each r in list of rbx, r12
        push_r(a, r)
    end
    win_enter(a)
    lea(a, rcx, rip(picture_env))
    lea(a, rdx, rip("gui_path"))
    movi(a, r8, 1024)
    w_call(a, "GetEnvironmentVariableW")
    win_leave(a)
    mov32_rr(a, rax, rax)
    test_rr(a, rax, rax)
    set no_file to new_label(a)
    jcc(a, cc_e, no_file)
    alui(a, "cmp", rax, 1024)
    jcc(a, cc_ae, no_file)
    call_to(a, "rt_headless")
    jmp_to(a, finished)
    mark(a, no_file)
    load32(a, rax, rip("out_tty"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, finished)
    load(a, rax, rip("pic_n"))
    alu_load(a, "or", rax, rip("app_n"))
    jcc(a, cc_e, finished)
    movi(a, rcx, 0)
    movi(a, rdx, 500)
    lea(a, r8, rip(picture_title))
    call_to(a, "rt_window_open")
    movi(a, r12, 0) # each timer, every so many milliseconds, 10 at the fastest
    mark(a, timers_loop)
    alu_load(a, "cmp", r12, rip("app_n"))
    jcc(a, cc_ae, timers_done)
    mov_rr(a, rbx, r12)
    shifti(a, "shl", rbx, 5)
    alu_load(a, "add", rbx, rip("app_items"))
    load(a, rax, mem(rbx, 0))
    alui(a, "cmp", rax, app_timer)
    jcc(a, cc_ne, timers_next)
    movsd_load(a, xmm0, mem(rbx, 24))
    cvttsd2si(a, r8, xmm0)
    alui(a, "cmp", r8, 10)
    jcc(a, cc_ge, faster)
    movi(a, r8, 10)
    mark(a, faster)
    win_enter(a)
    load(a, rcx, rip("gui_hwnd"))
    lea(a, rdx, mem(r12, 1))
    movi(a, r9, 0)
    w_call(a, "SetTimer")
    win_leave(a)
    mark(a, timers_next)
    inc_r(a, r12)
    jmp_to(a, timers_loop)
    mark(a, timers_done)
    call_to(a, "rt_gui_loop")
    mark(a, finished)
    for each r in list of r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_pad_hook: xmm0 a question: if it starts with "Draw" and a person at a terminal is asked, the pad,
    # with rax 1 and the drawing in xmm0, as text; else rax 0 and nothing changes
    set not_pad to new_label(a)
    set skip_spaces to new_label(a)
    set spaced to new_label(a)
    set word_end to new_label(a)
    set is_pad to new_label(a)
    mark(a, "rt_pad_hook")
    movq_rx(a, rax, xmm0)
    mov_rr(a, rcx, rax)
    shifti(a, "shr", rcx, 48)
    alui(a, "cmp", rcx, kind_text)
    jcc(a, cc_ne, not_pad)
    untag(a, rax)
    load(a, rsi, mem(rax, 16))
    load(a, rcx, mem(rax, 0))
    mark(a, skip_spaces)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, not_pad)
    load8(a, rax, mem(rsi, 0))
    alui(a, "cmp", rax, 32)
    jcc(a, cc_e, spaced)
    alui(a, "sub", rax, 9) # a tab to a carriage return
    alui(a, "cmp", rax, 4)
    jcc(a, cc_a, word_end)
    mark(a, spaced)
    inc_r(a, rsi)
    dec_r(a, rcx)
    jmp_to(a, skip_spaces)
    mark(a, word_end) # "draw", in any case, then not a letter, a digit or _
    alui(a, "cmp", rcx, 4)
    jcc(a, cc_b, not_pad)
    for each k from 0 to 3
        load8(a, rax, mem(rsi, k))
        alui(a, "or", rax, 32)
        alui(a, "cmp", rax, item (k + 1) of (list of 100, 114, 97, 119))
        jcc(a, cc_ne, not_pad)
    end
    alui(a, "cmp", rcx, 4)
    jcc(a, cc_e, is_pad)
    load8(a, rax, mem(rsi, 4))
    alui(a, "cmp", rax, 95)
    jcc(a, cc_e, not_pad)
    alui(a, "cmp", rax, 128)
    jcc(a, cc_ae, is_pad)
    set letter_test to new_label(a)
    mov_rr(a, rdx, rax)
    alui(a, "sub", rdx, 48)
    alui(a, "cmp", rdx, 9)
    jcc(a, cc_be, not_pad)
    alui(a, "or", rax, 32)
    alui(a, "sub", rax, 97)
    alui(a, "cmp", rax, 25)
    jcc(a, cc_be, not_pad)
    mark(a, is_pad)
    movsd_store(a, rip("pad_q"), xmm0)
    call_to(a, "rt_in_setup")
    set no_person to new_label(a)
    load(a, rax, rip("in_tty"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, no_person)
    push_r(a, rbx)
    call_to(a, "rt_b_reset") # the question, and a space, as asking shows it
    load(a, rax, rip("pad_q"))
    movi(a, rdx, 0)
    call_to(a, "rt_b_value")
    movi(a, rax, 32)
    call_to(a, "rt_b_byte")
    load(a, rsi, rip("b_ptr"))
    load(a, rcx, rip("b_len"))
    call_to(a, "rt_out_text")
    call_to(a, "rt_flush_out")
    win_enter(a) # the question, without the space, as the pad's title
    movi(a, rcx, 65001)
    movi(a, rdx, 0)
    load(a, r8, rip("b_ptr"))
    load(a, r9, rip("b_len"))
    dec_r(a, r9)
    lea(a, rax, rip("gui_title"))
    store(a, arg_at(5), rax)
    storei(a, arg_at(6), 1023)
    w_call(a, "MultiByteToWideChar")
    win_leave(a)
    lea(a, rcx, rip("gui_title"))
    mov32_rr(a, rax, rax)
    alu(a, "add", rax, rax)
    alu(a, "add", rcx, rax)
    storei(a, mem(rcx, 0), 0)
    storei(a, rip("pad_n"), 0)
    storei(a, rip("pad_down"), 0)
    movi(a, rcx, 1)
    movi(a, rdx, 440)
    lea(a, r8, rip("gui_title"))
    call_to(a, "rt_window_open")
    call_to(a, "rt_gui_loop")
    load(a, rax, rip("gui_done"))
    alui(a, "cmp", rax, 1)
    set pad_answered to new_label(a)
    jcc(a, cc_e, pad_answered)
    call_to(a, "rt_out_line") # closed: the program ends
    call_to(a, "rt_flush_out")
    if last_word of a
        call_to(a, "rt_last_word")
        call_to(a, "rt_flush_out")
    end
    movi(a, rcx, 0)
    jmp_to(a, "rt_exit")
    mark(a, pad_answered)
    call_to(a, "rt_pad_text")
    mov_rr(a, rbx, rax)
    win_enter(a)
    load(a, rcx, rip("gui_hwnd"))
    w_call(a, "DestroyWindow")
    win_leave(a)
    point_at_text(a, "(a drawing)")
    call_to(a, "rt_out_text")
    call_to(a, "rt_out_line")
    movq_xr(a, xmm0, rbx)
    pop_r(a, rbx)
    movi(a, rax, 1)
    ret(a)
    mark(a, no_person) # input from a file or a pipe: asked as any question is
    movsd_load(a, xmm0, rip("pad_q"))
    mark(a, not_pad)
    movi(a, rax, 0)
    ret(a)
    if widgets of a
        emit_gui_widgets(a)
        emit_gdi_prims(a)
    end
    if controls of a
        emit_gui_controls(a)
    end
end

# an event for the app's handlers: through its buttons and text boxes first, if it has any
to app_send with a
    if widgets of a
        call_to(a, "rt_app_event")
    else
        call_to(a, "rt_app_send")
    end
end

# xmm0 1 times the scale; uses nothing else
to times_scale with a, x, n
    load_bits(a, x, double_bytes(n))
    sse_math(a, "*", x, rip("gui_scale"))
end

# A button and a text box in rt_render_picture, rbx the thing drawn, as the playground draws them: a button
# in the pen's colour with its label in white in the middle; a text box as rt_gui_typed draws it.
to render_widgets with a, a_button, a_textbox, item_next
    mark(a, a_button)
    for each pair in list of (list of xmm0, 8), (list of xmm1, 16), (list of xmm2, 24), (list of xmm3, 32)
        movsd_load(a, item 1 of pair, mem(rbx, item 2 of pair))
    end
    call_to(a, "rt_gui_px")
    load32(a, rcx, rip("gui_argb"))
    call_to(a, "rt_gui_fill")
    load(a, rax, mem(rbx, 56))
    call_to(a, "rt_gui_prep")
    movsd_load(a, xmm0, mem(rbx, 24)) # its middle, less half the label
    load_bits(a, xmm1, double_bytes(0.5))
    sse_math(a, "*", xmm0, reg_at(xmm1))
    sse_math(a, "+", xmm0, mem(rbx, 8))
    movsd_store(a, rip("gui_t0"), xmm0)
    picture_x(a, xmm0, rip("gui_t0"))
    movsd_load(a, xmm1, rip("gui_tw"))
    load_bits(a, xmm2, double_bytes(0.5))
    sse_math(a, "*", xmm1, reg_at(xmm2))
    sse_math(a, "-", xmm0, reg_at(xmm1))
    movsd_store(a, rip("gui_tl"), xmm0)
    baseline(a)
    movsd_load(a, xmm0, rip("gui_tl"))
    movi(a, rcx, 0xFFFFFFFF)
    call_to(a, "rt_gui_put")
    call_to(a, "rt_gui_unprep")
    jmp_to(a, item_next)

    mark(a, a_textbox) # see rt_gui_typed
    call_to(a, "rt_gui_typed")
    jmp_to(a, item_next)
end

# xmm1: where the baseline of a button's or a text box's text goes, 10 up from its bottom (rbx the thing drawn)
to baseline with a
    movsd_load(a, xmm1, mem(rbx, 16))
    load_bits(a, xmm2, double_bytes(10))
    sse_math(a, "+", xmm1, reg_at(xmm2))
    movsd_store(a, rip("gui_t1"), xmm1)
    picture_y(a, xmm1, rip("gui_t1"))
end

to cvtss2sd with a, x, at
    sse(a, 0xF3, 0x5A, x, at)
end

# What draws, with GDI+, for buttons, boxes and the rest, and what else they need of Windows: the clipboard
# (see emit_fb_prims for Linux's)
to emit_gdi_prims with a
    # rt_gui_fill: rcx a colour, ARGB: the box at gui_fx to gui_fh, filled with it
    mark(a, "rt_gui_fill")
    win_enter(a)
    lea(a, rdx, rip("gui_brush"))
    w_call(a, "GdipCreateSolidFill")
    for each pair in list of (list of "gui_fw", 5), (list of "gui_fh", 6)
        movsd_load(a, xmm0, rip(item 1 of pair))
        cvtsd2ss(a, xmm4, xmm0)
        movss_store(a, arg_at(item 2 of pair), xmm4)
    end
    movsd_load(a, xmm2, rip("gui_fx"))
    cvtsd2ss(a, xmm2, xmm2)
    movsd_load(a, xmm3, rip("gui_fy"))
    cvtsd2ss(a, xmm3, xmm3)
    load(a, rcx, rip("gui_gfx"))
    load(a, rdx, rip("gui_brush"))
    w_call(a, "GdipFillRectangle")
    load(a, rcx, rip("gui_brush"))
    w_call(a, "GdipDeleteBrush")
    win_leave(a)
    ret(a)

    # rt_gui_clip, rt_gui_unclip: drawing kept to the box at gui_fx to gui_fh, and let go again
    mark(a, "rt_gui_clip")
    win_enter(a)
    movsd_load(a, xmm0, rip("gui_fh"))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, arg_at(5), xmm4)
    storei(a, arg_at(6), 0) # instead of what was there
    movsd_load(a, xmm1, rip("gui_fx"))
    cvtsd2ss(a, xmm1, xmm1)
    movsd_load(a, xmm2, rip("gui_fy"))
    cvtsd2ss(a, xmm2, xmm2)
    movsd_load(a, xmm3, rip("gui_fw"))
    cvtsd2ss(a, xmm3, xmm3)
    load(a, rcx, rip("gui_gfx"))
    w_call(a, "GdipSetClipRect")
    win_leave(a)
    ret(a)
    mark(a, "rt_gui_unclip")
    win_enter(a)
    load(a, rcx, rip("gui_gfx"))
    w_call(a, "GdipResetClip")
    win_leave(a)
    ret(a)

    # rt_gui_prep: rax a text: it as UTF-16 in wbuf (gui_units long), a 16 font in gui_font, and how wide the
    # text is in it, in pixels, in gui_tw
    set measured to new_label(a)
    mark(a, "rt_gui_prep")
    push_r(a, rbx)
    mov_rr(a, rbx, rax)
    untag(a, rbx)
    win_enter(a)
    load(a, rcx, rip("gui_family"))
    times_scale(a, xmm0, 16)
    cvtsd2ss(a, xmm1, xmm0)
    movi(a, r8, 0)
    movi(a, r9, 2)
    lea(a, rax, rip("gui_font"))
    store(a, arg_at(5), rax)
    w_call(a, "GdipCreateFont")
    movi(a, rcx, 65001)
    movi(a, rdx, 0)
    load(a, r8, mem(rbx, 16))
    load32(a, r9, mem(rbx, 0))
    lea(a, rax, rip("wbuf"))
    store(a, arg_at(5), rax)
    storei(a, arg_at(6), wide_cap)
    w_call(a, "MultiByteToWideChar")
    store(a, rip("gui_units"), rax)
    storei(a, rip("gui_tw"), 0)
    mov32_rr(a, rax, rax)
    test_rr(a, rax, rax)
    jcc(a, cc_e, measured)
    storei(a, rip("gui_bbox"), 0)
    storei(a, rip_plus("gui_bbox", 8), 0)
    for each pair in list of (list of 0, 0), (list of 4, 0), (list of 8, 100000), (list of 12, 100000)
        load_bits(a, xmm0, double_bytes(item 2 of pair))
        cvtsd2ss(a, xmm4, xmm0)
        movss_store(a, rip_plus("gui_rectf", item 1 of pair), xmm4)
    end
    load(a, rcx, rip("gui_gfx"))
    lea(a, rdx, rip("wbuf"))
    load32(a, r8, rip("gui_units"))
    load(a, r9, rip("gui_font"))
    lea(a, rax, rip("gui_rectf"))
    store(a, arg_at(5), rax)
    load(a, rax, rip("gui_format"))
    store(a, arg_at(6), rax)
    lea(a, rax, rip("gui_bbox"))
    store(a, arg_at(7), rax)
    storei(a, arg_at(8), 0)
    storei(a, arg_at(9), 0)
    w_call(a, "GdipMeasureString")
    cvtss2sd(a, xmm0, rip_plus("gui_bbox", 8))
    movsd_store(a, rip("gui_tw"), xmm0)
    mark(a, measured)
    win_leave(a)
    pop_r(a, rbx)
    ret(a)

    # rt_gui_put: rcx a colour, ARGB, xmm0 and xmm1 where in the window, in pixels: the text rt_gui_prep made
    # ready, its baseline there
    set nothing_to_put to new_label(a)
    mark(a, "rt_gui_put")
    movsd_store(a, rip("gui_tx"), xmm0)
    movsd_store(a, rip("gui_ty"), xmm1)
    load(a, rax, rip("gui_units"))
    mov32_rr(a, rax, rax)
    test_rr(a, rax, rax)
    jcc(a, cc_e, nothing_to_put)
    win_enter(a)
    lea(a, rdx, rip("gui_brush"))
    w_call(a, "GdipCreateSolidFill")
    movsd_load(a, xmm0, rip("gui_tx"))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, rip("gui_rectf"), xmm4)
    movsd_load(a, xmm0, rip("gui_ty"))
    times_scale(a, xmm1, 16)
    sse_math(a, "*", xmm1, rip("gui_ascent"))
    sse_math(a, "-", xmm0, reg_at(xmm1))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, rip_plus("gui_rectf", 4), xmm4)
    load_bits(a, xmm0, double_bytes(100000))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, rip_plus("gui_rectf", 8), xmm4)
    movss_store(a, rip_plus("gui_rectf", 12), xmm4)
    load(a, rcx, rip("gui_gfx"))
    lea(a, rdx, rip("wbuf"))
    load32(a, r8, rip("gui_units"))
    load(a, r9, rip("gui_font"))
    lea(a, rax, rip("gui_rectf"))
    store(a, arg_at(5), rax)
    load(a, rax, rip("gui_format"))
    store(a, arg_at(6), rax)
    load(a, rax, rip("gui_brush"))
    store(a, arg_at(7), rax)
    w_call(a, "GdipDrawString")
    load(a, rcx, rip("gui_brush"))
    w_call(a, "GdipDeleteBrush")
    win_leave(a)
    mark(a, nothing_to_put)
    ret(a)

    mark(a, "rt_gui_unprep") # the font rt_gui_prep made
    win_enter(a)
    load(a, rcx, rip("gui_font"))
    w_call(a, "GdipDeleteFont")
    win_leave(a)
    ret(a)

    # rt_mono_begin, rt_mono_end: the font whose letters take the same room (see rt_gui_typed), made 16 for the
    # scale in gui_mfont, and let go
    mark(a, "rt_mono_begin")
    win_enter(a)
    load(a, rcx, rip("gui_mono"))
    times_scale(a, xmm0, 16)
    cvtsd2ss(a, xmm1, xmm0)
    movi(a, r8, 0)
    movi(a, r9, 2)
    lea(a, rax, rip("gui_mfont"))
    store(a, arg_at(5), rax)
    w_call(a, "GdipCreateFont")
    win_leave(a)
    ret(a)
    mark(a, "rt_mono_end")
    win_enter(a)
    load(a, rcx, rip("gui_mfont"))
    w_call(a, "GdipDeleteFont")
    win_leave(a)
    ret(a)

    # rt_gui_glyph: r13 a letter's bytes, rcx how many, gui_t0 and gui_t1 where its left and baseline go in the
    # picture's numbers, gui_tc its colour: drawn in the font whose letters take the same room
    mark(a, "rt_gui_glyph")
    win_enter(a)
    mov_rr(a, r9, rcx)
    movi(a, rcx, 65001)
    movi(a, rdx, 0)
    mov_rr(a, r8, r13)
    lea(a, rax, rip("wbuf"))
    store(a, arg_at(5), rax)
    storei(a, arg_at(6), wide_cap)
    w_call(a, "MultiByteToWideChar")
    store(a, rip("gui_units"), rax)
    load32(a, rcx, rip("gui_tc"))
    lea(a, rdx, rip("gui_brush"))
    w_call(a, "GdipCreateSolidFill")
    picture_x(a, xmm0, rip("gui_t0"))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, rip("gui_rectf"), xmm4)
    picture_y(a, xmm0, rip("gui_t1"))
    times_scale(a, xmm1, 16)
    sse_math(a, "*", xmm1, rip("gui_mono_ascent"))
    sse_math(a, "-", xmm0, reg_at(xmm1))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, rip_plus("gui_rectf", 4), xmm4)
    load_bits(a, xmm0, double_bytes(100000))
    cvtsd2ss(a, xmm4, xmm0)
    movss_store(a, rip_plus("gui_rectf", 8), xmm4)
    movss_store(a, rip_plus("gui_rectf", 12), xmm4)
    load(a, rcx, rip("gui_gfx"))
    lea(a, rdx, rip("wbuf"))
    load32(a, r8, rip("gui_units"))
    load(a, r9, rip("gui_mfont"))
    lea(a, rax, rip("gui_rectf"))
    store(a, arg_at(5), rax)
    load(a, rax, rip("gui_format"))
    store(a, arg_at(6), rax)
    load(a, rax, rip("gui_brush"))
    store(a, arg_at(7), rax)
    w_call(a, "GdipDrawString")
    load(a, rcx, rip("gui_brush"))
    w_call(a, "GdipDeleteBrush")
    win_leave(a)
    ret(a)

    if controls of a # rt_gui_tri: the three corners in gui_poly, in the window's pixels as 4-byte floats, filled in gui_argb
        mark(a, "rt_gui_tri")
        win_enter(a)
        load32(a, rcx, rip("gui_argb"))
        lea(a, rdx, rip("gui_brush"))
        w_call(a, "GdipCreateSolidFill")
        load(a, rcx, rip("gui_gfx"))
        load(a, rdx, rip("gui_brush"))
        lea(a, r8, rip("gui_poly"))
        movi(a, r9, 3)
        storei(a, arg_at(5), 0)
        w_call(a, "GdipFillPolygon")
        load(a, rcx, rip("gui_brush"))
        w_call(a, "GdipDeleteBrush")
        win_leave(a)
        ret(a)
    end

    # rt_clip_copy: what's selected in the box with the focus, onto the clipboard, as UTF-16 with its new
    # lines as CR LF; not while the events come from MOTH_EVENTS, so a test leaves the clipboard alone
    set copy_out to new_label(a)
    set copy_units to new_label(a)
    set copy_counted to new_label(a)
    set copy_loop to new_label(a)
    set copy_plain to new_label(a)
    set copy_done to new_label(a)
    set copy_free to new_label(a)
    mark(a, "rt_clip_copy")
    load(a, rax, rip("gui_headless"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, copy_units)
    ret(a)
    mark(a, copy_units)
    for each r in list of rbx, r12, r13, r14
        push_r(a, r)
    end
    call_to(a, "rt_focus_check")
    load(a, rbx, rip("box_focus"))
    test_rr(a, rbx, rbx)
    jcc(a, cc_e, copy_out)
    box_entry(a, rbx)
    call_to(a, "rt_ed_selected")
    alu(a, "cmp", rcx, rdx)
    jcc(a, cc_e, copy_out)
    mov_rr(a, r13, rdx)
    load(a, rax, mem(rbx, 8))
    untag(a, rax)
    load(a, rsi, mem(rax, 16))
    load(a, r14, mem(rax, 0))
    mov_rr(a, rdx, rcx)
    mov_rr(a, rcx, r14)
    call_to(a, "rt_ed_off")
    mov_rr(a, r12, rax) # where it starts, in bytes
    mov_rr(a, rcx, r14)
    mov_rr(a, rdx, r13)
    call_to(a, "rt_ed_off")
    mov_rr(a, r13, rax)
    alu(a, "sub", r13, r12) # and how many
    alu(a, "add", r12, rsi)
    win_enter(a)
    movi(a, rcx, 65001)
    movi(a, rdx, 0)
    mov_rr(a, r8, r12)
    mov_rr(a, r9, r13)
    lea(a, rax, rip("wbuf"))
    store(a, arg_at(5), rax)
    storei(a, arg_at(6), wide_cap)
    w_call(a, "MultiByteToWideChar")
    mov32_rr(a, r12, rax) # how many units
    lea(a, rsi, rip("wbuf")) # and how many new lines among them
    mov_rr(a, rcx, r12)
    mov_rr(a, r13, r12)
    mark(a, copy_counted)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, copy_loop)
    load16(a, rax, mem(rsi, 0))
    alui(a, "cmp", rax, 10)
    set not_line to new_label(a)
    jcc(a, cc_ne, not_line)
    inc_r(a, r13)
    mark(a, not_line)
    alui(a, "add", rsi, 2)
    dec_r(a, rcx)
    jmp_to(a, copy_counted)
    mark(a, copy_loop)
    movi(a, rcx, 2) # moveable memory, as the clipboard takes
    lea(a, rdx, mem(r13, 1))
    alu(a, "add", rdx, rdx)
    w_call(a, "GlobalAlloc")
    mov_rr(a, rbx, rax)
    test_rr(a, rax, rax)
    jcc(a, cc_e, copy_done)
    mov_rr(a, rcx, rax)
    w_call(a, "GlobalLock")
    mov_rr(a, rdi, rax)
    lea(a, rsi, rip("wbuf"))
    mov_rr(a, rcx, r12)
    set copy_each to new_label(a)
    set copy_end to new_label(a)
    mark(a, copy_each)
    test_rr(a, rcx, rcx)
    jcc(a, cc_e, copy_end)
    load16(a, rax, mem(rsi, 0))
    alui(a, "cmp", rax, 10)
    jcc(a, cc_ne, copy_plain)
    movi(a, rdx, 13)
    store16(a, mem(rdi, 0), rdx)
    alui(a, "add", rdi, 2)
    mark(a, copy_plain)
    store16(a, mem(rdi, 0), rax)
    alui(a, "add", rdi, 2)
    alui(a, "add", rsi, 2)
    dec_r(a, rcx)
    jmp_to(a, copy_each)
    mark(a, copy_end)
    movi(a, rax, 0)
    store16(a, mem(rdi, 0), rax)
    mov_rr(a, rcx, rbx)
    w_call(a, "GlobalUnlock")
    load(a, rcx, rip("gui_hwnd"))
    w_call(a, "OpenClipboard")
    test_rr(a, rax, rax)
    jcc(a, cc_e, copy_free)
    w_call(a, "EmptyClipboard")
    movi(a, rcx, 13)
    mov_rr(a, rdx, rbx)
    w_call(a, "SetClipboardData")
    w_call(a, "CloseClipboard")
    jmp_to(a, copy_done)
    mark(a, copy_free)
    mov_rr(a, rcx, rbx)
    w_call(a, "GlobalFree")
    mark(a, copy_done)
    win_leave(a)
    mark(a, copy_out)
    for each r in list of r14, r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_clip_paste: what's on the clipboard as text, in rax, or 0 for nothing (or while the events come from
    # MOTH_EVENTS); a surrogate on its own becomes U+FFFD
    set paste_go to new_label(a)
    set paste_none to new_label(a)
    set paste_loop to new_label(a)
    set paste_one to new_label(a)
    set paste_lone to new_label(a)
    set paste_end to new_label(a)
    set paste_close to new_label(a)
    mark(a, "rt_clip_paste")
    load(a, rax, rip("gui_headless"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, paste_go)
    movi(a, rax, 0)
    ret(a)
    mark(a, paste_go)
    for each r in list of rbx, r12, r13
        push_r(a, r)
    end
    movi(a, r13, 0) # nothing yet
    win_enter(a)
    load(a, rcx, rip("gui_hwnd"))
    w_call(a, "OpenClipboard")
    test_rr(a, rax, rax)
    jcc(a, cc_e, paste_none)
    movi(a, rcx, 13)
    w_call(a, "GetClipboardData")
    mov_rr(a, rbx, rax)
    test_rr(a, rax, rax)
    jcc(a, cc_e, paste_close)
    mov_rr(a, rcx, rax)
    w_call(a, "GlobalLock")
    mov_rr(a, r12, rax)
    test_rr(a, rax, rax)
    jcc(a, cc_e, paste_close)
    call_to(a, "rt_b_reset")
    movi(a, r13, 1)
    mark(a, paste_loop) # each character, up to 8,000 units, more than a text area holds
    load16(a, rax, mem(r12, 0))
    test_rr(a, rax, rax)
    jcc(a, cc_e, paste_end)
    alui(a, "cmp", r13, 8000)
    jcc(a, cc_a, paste_end)
    inc_r(a, r13)
    alui(a, "add", r12, 2)
    mov_rr(a, rcx, rax)
    alui(a, "and", rcx, 0xF800)
    alui(a, "cmp", rcx, 0xD800)
    jcc(a, cc_ne, paste_one)
    alui(a, "cmp", rax, 0xDC00)
    jcc(a, cc_ae, paste_lone)
    load16(a, rdx, mem(r12, 0))
    mov_rr(a, rcx, rdx)
    alui(a, "and", rcx, 0xFC00)
    alui(a, "cmp", rcx, 0xDC00)
    jcc(a, cc_ne, paste_lone)
    alui(a, "add", r12, 2)
    alui(a, "sub", rax, 0xD800)
    shifti(a, "shl", rax, 10)
    alui(a, "sub", rdx, 0xDC00)
    alu(a, "add", rax, rdx)
    alui(a, "add", rax, 0x10000)
    jmp_to(a, paste_one)
    mark(a, paste_lone)
    movi(a, rax, 0xFFFD)
    mark(a, paste_one)
    call_to(a, "rt_b_code")
    jmp_to(a, paste_loop)
    mark(a, paste_end)
    mov_rr(a, rcx, rbx)
    w_call(a, "GlobalUnlock")
    mark(a, paste_close)
    w_call(a, "CloseClipboard")
    mark(a, paste_none)
    win_leave(a)
    movi(a, rax, 0)
    test_rr(a, r13, r13)
    set paste_out to new_label(a)
    jcc(a, cc_e, paste_out)
    call_to(a, "rt_b_text")
    mark(a, paste_out)
    for each r in list of r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)
end

# ---------- the runtime: drawing a picture in memory, on Linux ----------
# Linux has no GDI+, so the picture is drawn here, into fb: 500 by 500 pixels, 4 bytes each, blue, green, red
# and alpha, the rows from the top down, as a BMP file and an X server's window both take them. Shapes' edges
# are smoothed by how much of each pixel they cover, as a canvas's and GDI+'s are; text comes from the glyph
# tables DejaVu Sans and DejaVu Sans Mono were drawn into (see font_tables). Only what's inside the clip, from
# fb_cx0, fb_cy0 up to but not reaching fb_cx1, fb_cy1, changes.

to sqrt_sd with a, x, y
    sse(a, 0xF2, 0x51, x, reg_at(y))
end

to ceil_sd with a, x, y
    enc(a, (list of 0x66), no, (list of 0x0F, 0x3A, 0x0B), x, reg_at(y), imm8(10))
end

# register dst: xmm x rounded down, or up, to a whole number; uses xmm7
to floor_int with a, dst, x
    floor_sd(a, xmm7, x)
    cvttsd2si(a, dst, xmm7)
end

to ceil_int with a, dst, x
    ceil_sd(a, xmm7, x)
    cvttsd2si(a, dst, xmm7)
end

# register r kept to no less than, or no more than, the whole number at `at`
to clamp_up with a, r, at
    set kept to new_label(a)
    alu_load(a, "cmp", r, at)
    jcc(a, cc_ge, kept)
    load(a, r, at)
    mark(a, kept)
end

to clamp_down with a, r, at
    set kept to new_label(a)
    alu_load(a, "cmp", r, at)
    jcc(a, cc_le, kept)
    load(a, r, at)
    mark(a, kept)
end

# rdi: where pixel (rx, ry) of fb is; uses rax
to fb_pixel with a, rx, ry
    imul_ri(a, rdi, ry, 500)
    alu(a, "add", rdi, rx)
    shifti(a, "shl", rdi, 2)
    lea(a, rax, rip("fb"))
    alu(a, "add", rdi, rax)
end

# xmm x: kept from 0 to 1; uses xmm7
to unit_clamp with a, x
    load_bits(a, xmm7, double_bytes(0))
    sse_math(a, "max", x, reg_at(xmm7))
    load_bits(a, xmm7, double_bytes(1))
    minsd(a, x, xmm7)
end

to minsd_at with a, x, at
    sse(a, 0xF2, 0x5D, x, at)
end

# register dst: the signed byte at `at`
to movsx8_load with a, dst, at
    enc(a, empty list, yes, (list of 0x0F, 0xBE), dst, at, empty list)
end

to emit_fb_core with a
    # rt_fb_blend: rdi a pixel of fb, r9 a colour (ARGB), xmm0 how much of the pixel it covers, from 0 to 1:
    # the colour over what's there, by its alpha and that; keeps rdi, r9 and xmm2 to xmm15
    set blend_none to new_label(a)
    set blend_mix to new_label(a)
    mark(a, "rt_fb_blend")
    mov_rr(a, rax, r9)
    shifti(a, "shr", rax, 24)
    cvtsi2sd(a, xmm1, rax)
    sse_math(a, "*", xmm1, reg_at(xmm0))
    load_bits(a, xmm0, double_bytes(0.5))
    sse_math(a, "+", xmm1, reg_at(xmm0))
    cvttsd2si(a, r10, xmm1)
    test_rr(a, r10, r10)
    jcc(a, cc_le, blend_none)
    alui(a, "cmp", r10, 255)
    jcc(a, cc_b, blend_mix)
    mov_rr(a, rax, r9)
    alui(a, "or", rax, 0xFF000000)
    store32(a, mem(rdi, 0), rax)
    ret(a)
    mark(a, blend_mix)
    load32(a, r11, mem(rdi, 0))
    movi(a, r8, 255)
    alu(a, "sub", r8, r10)
    movi(a, rdx, 0xFF000000)
    for each channel_shift in list of 0, 8, 16
        mov_rr(a, rax, r9)
        if channel_shift is not 0
            shifti(a, "shr", rax, channel_shift)
        end
        alui(a, "and", rax, 255)
        imul_rr(a, rax, r10)
        mov_rr(a, rcx, r11)
        if channel_shift is not 0
            shifti(a, "shr", rcx, channel_shift)
        end
        alui(a, "and", rcx, 255)
        imul_rr(a, rcx, r8)
        alu(a, "add", rax, rcx)
        alui(a, "add", rax, 127)
        imul_ri(a, rax, rax, 0x8081)
        shifti(a, "shr", rax, 23)
        if channel_shift is not 0
            shifti(a, "shl", rax, channel_shift)
        end
        alu(a, "or", rdx, rax)
    end
    store32(a, mem(rdi, 0), rdx)
    mark(a, blend_none)
    ret(a)

    # rt_fb_noclip: the clip, the whole picture
    mark(a, "rt_fb_noclip")
    storei(a, rip("fb_cx0"), 0)
    storei(a, rip("fb_cy0"), 0)
    storei(a, rip("fb_cx1"), 500)
    storei(a, rip("fb_cy1"), 500)
    ret(a)

    # rt_fb_clear: r9 a colour: every pixel of fb that, opaque
    set clear_loop to new_label(a)
    mark(a, "rt_fb_clear")
    mov_rr(a, rax, r9)
    alui(a, "or", rax, 0xFF000000)
    mov32_rr(a, rax, rax)
    mov_rr(a, rcx, rax)
    shifti(a, "shl", rcx, 32)
    alu(a, "or", rax, rcx)
    lea(a, rdi, rip("fb"))
    movi(a, rcx, 125000)
    mark(a, clear_loop)
    store(a, mem(rdi, 0), rax)
    alui(a, "add", rdi, 8)
    dec_r(a, rcx)
    jcc(a, cc_ne, clear_loop)
    ret(a)

    # rt_fb_rect: the box from fb_x0, fb_y0 to fb_x1, fb_y1 (in pixels, fb_x0 the lesser), filled in r9's colour,
    # each pixel by how much of it the box covers
    set rect_rows to new_label(a)
    set rect_cols to new_label(a)
    set rect_next to new_label(a)
    set rect_done to new_label(a)
    mark(a, "rt_fb_rect")
    for each r in list of r12, r13, r14, r15
        push_r(a, r)
    end
    movsd_load(a, xmm2, rip("fb_x0"))
    floor_int(a, r12, xmm2) # columns from r12 to r13, rows from r14 to r15
    clamp_up(a, r12, rip("fb_cx0"))
    movsd_load(a, xmm2, rip("fb_x1"))
    ceil_int(a, r13, xmm2)
    clamp_down(a, r13, rip("fb_cx1"))
    movsd_load(a, xmm2, rip("fb_y0"))
    floor_int(a, r14, xmm2)
    clamp_up(a, r14, rip("fb_cy0"))
    movsd_load(a, xmm2, rip("fb_y1"))
    ceil_int(a, r15, xmm2)
    clamp_down(a, r15, rip("fb_cy1"))
    alu(a, "cmp", r12, r13)
    jcc(a, cc_ge, rect_done)
    mark(a, rect_rows)
    alu(a, "cmp", r14, r15)
    jcc(a, cc_ge, rect_done)
    cvtsi2sd(a, xmm3, r14) # how much of the row: from the greater of its top and y0 to the lesser of its bottom and y1
    movapd(a, xmm2, xmm3)
    load_bits(a, xmm4, double_bytes(1))
    sse_math(a, "+", xmm2, reg_at(xmm4))
    movsd_load(a, xmm4, rip("fb_y1"))
    minsd(a, xmm2, xmm4)
    sse_math(a, "max", xmm3, rip("fb_y0"))
    sse_math(a, "-", xmm2, reg_at(xmm3))
    mov_rr(a, rcx, r12)
    mark(a, rect_cols)
    alu(a, "cmp", rcx, r13)
    jcc(a, cc_ge, rect_next)
    cvtsi2sd(a, xmm3, rcx)
    movapd(a, xmm0, xmm3)
    load_bits(a, xmm4, double_bytes(1))
    sse_math(a, "+", xmm0, reg_at(xmm4))
    movsd_load(a, xmm4, rip("fb_x1"))
    minsd(a, xmm0, xmm4)
    sse_math(a, "max", xmm3, rip("fb_x0"))
    sse_math(a, "-", xmm0, reg_at(xmm3))
    sse_math(a, "*", xmm0, reg_at(xmm2))
    push_r(a, rcx)
    fb_pixel(a, rcx, r14)
    call_to(a, "rt_fb_blend")
    pop_r(a, rcx)
    inc_r(a, rcx)
    jmp_to(a, rect_cols)
    mark(a, rect_next)
    inc_r(a, r14)
    jmp_to(a, rect_rows)
    mark(a, rect_done)
    for each r in list of r15, r14, r13, r12
        pop_r(a, r)
    end
    ret(a)

    # rt_fb_disc: a disc, its middle at fb_x0, fb_y0 and its radius fb_r, in r9's colour, smoothed at its edge
    set disc_rows to new_label(a)
    set disc_cols to new_label(a)
    set disc_skip to new_label(a)
    set disc_next to new_label(a)
    set disc_done to new_label(a)
    mark(a, "rt_fb_disc")
    for each r in list of r12, r13, r14, r15
        push_r(a, r)
    end
    load_bits(a, xmm5, double_bytes(1))
    sse_math(a, "+", xmm5, rip("fb_r")) # its reach, and 1 more
    movsd_load(a, xmm2, rip("fb_x0"))
    sse_math(a, "-", xmm2, reg_at(xmm5))
    floor_int(a, r12, xmm2)
    clamp_up(a, r12, rip("fb_cx0"))
    movsd_load(a, xmm2, rip("fb_x0"))
    sse_math(a, "+", xmm2, reg_at(xmm5))
    ceil_int(a, r13, xmm2)
    clamp_down(a, r13, rip("fb_cx1"))
    movsd_load(a, xmm2, rip("fb_y0"))
    sse_math(a, "-", xmm2, reg_at(xmm5))
    floor_int(a, r14, xmm2)
    clamp_up(a, r14, rip("fb_cy0"))
    movsd_load(a, xmm2, rip("fb_y0"))
    sse_math(a, "+", xmm2, reg_at(xmm5))
    ceil_int(a, r15, xmm2)
    clamp_down(a, r15, rip("fb_cy1"))
    mark(a, disc_rows)
    alu(a, "cmp", r14, r15)
    jcc(a, cc_ge, disc_done)
    cvtsi2sd(a, xmm2, r14) # how far down from its middle, squared
    load_bits(a, xmm4, double_bytes(0.5))
    sse_math(a, "+", xmm2, reg_at(xmm4))
    sse_math(a, "-", xmm2, rip("fb_y0"))
    sse_math(a, "*", xmm2, reg_at(xmm2))
    mov_rr(a, rcx, r12)
    mark(a, disc_cols)
    alu(a, "cmp", rcx, r13)
    jcc(a, cc_ge, disc_next)
    cvtsi2sd(a, xmm3, rcx)
    load_bits(a, xmm4, double_bytes(0.5))
    sse_math(a, "+", xmm3, reg_at(xmm4))
    sse_math(a, "-", xmm3, rip("fb_x0"))
    sse_math(a, "*", xmm3, reg_at(xmm3))
    sse_math(a, "+", xmm3, reg_at(xmm2))
    sqrt_sd(a, xmm3, xmm3)
    movsd_load(a, xmm0, rip("fb_r"))
    sse_math(a, "+", xmm0, reg_at(xmm4))
    sse_math(a, "-", xmm0, reg_at(xmm3))
    load_bits(a, xmm4, double_bytes(0))
    ucomisd(a, xmm0, reg_at(xmm4))
    jcc(a, cc_be, disc_skip)
    unit_clamp(a, xmm0)
    push_r(a, rcx)
    fb_pixel(a, rcx, r14)
    call_to(a, "rt_fb_blend")
    pop_r(a, rcx)
    mark(a, disc_skip)
    inc_r(a, rcx)
    jmp_to(a, disc_cols)
    mark(a, disc_next)
    inc_r(a, r14)
    jmp_to(a, disc_rows)
    mark(a, disc_done)
    for each r in list of r15, r14, r13, r12
        pop_r(a, r)
    end
    ret(a)

    # rt_fb_line: a line from fb_x0, fb_y0 to fb_x1, fb_y1, fb_r either side of it, with round ends, in r9's
    # colour: each pixel by how far its middle is from the line. Each row only looks from where the line's band
    # crosses it to where it leaves, which keeps a long slanting line quick.
    set line_rows to new_label(a)
    set line_cols to new_label(a)
    set line_skip to new_label(a)
    set line_next to new_label(a)
    set line_done to new_label(a)
    set line_level to new_label(a)
    set line_band to new_label(a)
    set t_low to new_label(a)
    set t_high to new_label(a)
    mark(a, "rt_fb_line")
    for each r in list of r12, r13, r14, r15, rbx
        push_r(a, r)
    end
    movsd_load(a, xmm0, rip("fb_x1")) # along it, and how long that is, squared
    sse_math(a, "-", xmm0, rip("fb_x0"))
    movsd_store(a, rip("fb_vx"), xmm0)
    movsd_load(a, xmm1, rip("fb_y1"))
    sse_math(a, "-", xmm1, rip("fb_y0"))
    movsd_store(a, rip("fb_vy"), xmm1)
    sse_math(a, "*", xmm0, reg_at(xmm0))
    sse_math(a, "*", xmm1, reg_at(xmm1))
    sse_math(a, "+", xmm0, reg_at(xmm1))
    movsd_store(a, rip("fb_len2"), xmm0)
    load_bits(a, xmm5, double_bytes(1))
    sse_math(a, "+", xmm5, rip("fb_r"))
    movsd_load(a, xmm2, rip("fb_x0"))
    minsd_at(a, xmm2, rip("fb_x1"))
    sse_math(a, "-", xmm2, reg_at(xmm5))
    floor_int(a, r12, xmm2)
    clamp_up(a, r12, rip("fb_cx0"))
    movsd_load(a, xmm2, rip("fb_x0"))
    sse_math(a, "max", xmm2, rip("fb_x1"))
    sse_math(a, "+", xmm2, reg_at(xmm5))
    ceil_int(a, r13, xmm2)
    clamp_down(a, r13, rip("fb_cx1"))
    movsd_load(a, xmm2, rip("fb_y0"))
    minsd_at(a, xmm2, rip("fb_y1"))
    sse_math(a, "-", xmm2, reg_at(xmm5))
    floor_int(a, r14, xmm2)
    clamp_up(a, r14, rip("fb_cy0"))
    movsd_load(a, xmm2, rip("fb_y0"))
    sse_math(a, "max", xmm2, rip("fb_y1"))
    sse_math(a, "+", xmm2, reg_at(xmm5))
    ceil_int(a, r15, xmm2)
    clamp_down(a, r15, rip("fb_cy1"))
    mark(a, line_rows)
    alu(a, "cmp", r14, r15)
    jcc(a, cc_ge, line_done)
    cvtsi2sd(a, xmm2, r14) # how far down from its start the row's middle is
    load_bits(a, xmm4, double_bytes(0.5))
    sse_math(a, "+", xmm2, reg_at(xmm4))
    sse_math(a, "-", xmm2, rip("fb_y0"))
    movsd_store(a, rip("fb_wy"), xmm2)
    mov_rr(a, rcx, r12) # where the band crosses the row: all of it, for a line that's nearly level
    mov_rr(a, rbx, r13)
    movsd_load(a, xmm3, rip("fb_vy"))
    movapd(a, xmm4, xmm3)
    abs_sd(a, xmm4)
    load_bits(a, xmm6, double_bytes(0.000001))
    ucomisd(a, xmm4, reg_at(xmm6))
    jcc(a, cc_b, line_level)
    movsd_load(a, xmm6, rip("fb_vx")) # its middle there: x0 + wy * vx / vy
    sse_math(a, "*", xmm6, reg_at(xmm2))
    sse_math(a, "/", xmm6, reg_at(xmm3))
    sse_math(a, "+", xmm6, rip("fb_x0"))
    movsd_load(a, xmm3, rip("fb_len2")) # and half its width there: (r + 1) * length / |vy|
    sqrt_sd(a, xmm3, xmm3)
    sse_math(a, "*", xmm3, reg_at(xmm5))
    sse_math(a, "/", xmm3, reg_at(xmm4))
    movapd(a, xmm4, xmm6)
    sse_math(a, "-", xmm4, reg_at(xmm3))
    floor_int(a, rax, xmm4)
    alu(a, "cmp", rax, rcx)
    jcc(a, cc_le, line_band)
    mov_rr(a, rcx, rax)
    mark(a, line_band)
    sse_math(a, "+", xmm6, reg_at(xmm3))
    ceil_int(a, rax, xmm6)
    inc_r(a, rax)
    alu(a, "cmp", rax, rbx)
    jcc(a, cc_ge, line_level)
    mov_rr(a, rbx, rax)
    mark(a, line_level)
    mark(a, line_cols)
    alu(a, "cmp", rcx, rbx)
    jcc(a, cc_ge, line_next)
    cvtsi2sd(a, xmm3, rcx) # how far along from its start the pixel's middle is
    load_bits(a, xmm4, double_bytes(0.5))
    sse_math(a, "+", xmm3, reg_at(xmm4))
    sse_math(a, "-", xmm3, rip("fb_x0"))
    movapd(a, xmm0, xmm3) # t: how far along the line its nearest point is, from 0 to 1
    sse_math(a, "*", xmm0, rip("fb_vx"))
    movsd_load(a, xmm1, rip("fb_wy"))
    sse_math(a, "*", xmm1, rip("fb_vy"))
    sse_math(a, "+", xmm0, reg_at(xmm1))
    sse_math(a, "/", xmm0, rip("fb_len2"))
    unit_clamp(a, xmm0)
    movsd_load(a, xmm1, rip("fb_vx")) # from there to the pixel
    sse_math(a, "*", xmm1, reg_at(xmm0))
    sse_math(a, "-", xmm3, reg_at(xmm1))
    movsd_load(a, xmm1, rip("fb_vy"))
    sse_math(a, "*", xmm1, reg_at(xmm0))
    movsd_load(a, xmm4, rip("fb_wy"))
    sse_math(a, "-", xmm4, reg_at(xmm1))
    sse_math(a, "*", xmm3, reg_at(xmm3))
    sse_math(a, "*", xmm4, reg_at(xmm4))
    sse_math(a, "+", xmm3, reg_at(xmm4))
    sqrt_sd(a, xmm3, xmm3)
    movsd_load(a, xmm0, rip("fb_r"))
    load_bits(a, xmm4, double_bytes(0.5))
    sse_math(a, "+", xmm0, reg_at(xmm4))
    sse_math(a, "-", xmm0, reg_at(xmm3))
    load_bits(a, xmm4, double_bytes(0))
    ucomisd(a, xmm0, reg_at(xmm4))
    jcc(a, cc_be, line_skip)
    unit_clamp(a, xmm0)
    push_r(a, rcx)
    fb_pixel(a, rcx, r14)
    call_to(a, "rt_fb_blend")
    pop_r(a, rcx)
    mark(a, line_skip)
    inc_r(a, rcx)
    jmp_to(a, line_cols)
    mark(a, line_next)
    inc_r(a, r14)
    jmp_to(a, line_rows)
    mark(a, line_done)
    for each r in list of rbx, r15, r14, r13, r12
        pop_r(a, r)
    end
    ret(a)

    # rt_fb_ink: rcx and rdx a pixel of the glyph at fb_gink (fb_gw wide, fb_gh high, fb_grow bytes a row): its
    # ink, from 0 to 15, in rax, or 0 outside it; uses r8
    set ink_none to new_label(a)
    mark(a, "rt_fb_ink")
    movi(a, rax, 0)
    test_rr(a, rcx, rcx)
    jcc(a, cc_s, ink_none)
    test_rr(a, rdx, rdx)
    jcc(a, cc_s, ink_none)
    alu_load(a, "cmp", rcx, rip("fb_gw"))
    jcc(a, cc_ge, ink_none)
    alu_load(a, "cmp", rdx, rip("fb_gh"))
    jcc(a, cc_ge, ink_none)
    load(a, r8, rip("fb_grow"))
    imul_rr(a, r8, rdx)
    alu_load(a, "add", r8, rip("fb_gink"))
    mov_rr(a, rax, rcx)
    shifti(a, "shr", rax, 1)
    alu(a, "add", r8, rax)
    load8(a, rax, mem(r8, 0))
    set ink_low to new_label(a) # the low half for an even pixel, the high for an odd one
    mov_rr(a, r8, rcx)
    alui(a, "and", r8, 1)
    jcc(a, cc_e, ink_low)
    shifti(a, "shr", rax, 4)
    mark(a, ink_low)
    alui(a, "and", rax, 15)
    mark(a, ink_none)
    ret(a)

    # rt_fb_text: rsi and rcx a text's bytes, r8 a font (see emit_font_tables), fb_tx and fb_ty where it
    # starts and its baseline, fb_ts its size, r9 its colour: drawn, if fb_draw isn't 0, and either way fb_tx
    # moved on to its end. Text 16 high is drawn from the font's table at 16, each letter from a whole pixel,
    # as hinted text is, which keeps its lines sharp; any other size from its other table, each letter's ink
    # read between its pixels (bilinearly), scaled from the table's em to the size.
    set text_loop to new_label(a)
    set text_done to new_label(a)
    set one_byte to new_label(a)
    set decoded to new_label(a)
    set glyph_found to new_label(a)
    set glyph_drawn to new_label(a)
    set gy_loop to new_label(a)
    set gx_loop to new_label(a)
    set gx_skip to new_label(a)
    set gy_next to new_label(a)
    mark(a, "rt_fb_text")
    for each r in list of rbx, r12, r13, r14, r15
        push_r(a, r)
    end
    mov_rr(a, r12, rsi)
    lea(a, r13, mem(rsi, 0))
    alu(a, "add", r13, rcx)
    set other_size to new_label(a)
    set table_chosen to new_label(a)
    storei(a, rip("fb_snap"), 0)
    load(a, rbx, mem(r8, 0))
    load8(a, rax, mem(rbx, 2))
    cvtsi2sd(a, xmm1, rax)
    movsd_load(a, xmm0, rip("fb_ts"))
    ucomisd(a, xmm0, reg_at(xmm1))
    jcc(a, cc_ne, other_size)
    jcc(a, cc_p, other_size)
    storei(a, rip("fb_snap"), 1)
    jmp_to(a, table_chosen)
    mark(a, other_size)
    load(a, rbx, mem(r8, 8))
    mark(a, table_chosen)
    load8(a, rax, mem(rbx, 2)) # the scale: the size over the table's em
    cvtsi2sd(a, xmm1, rax)
    movsd_load(a, xmm0, rip("fb_ts"))
    sse_math(a, "/", xmm0, reg_at(xmm1))
    movsd_store(a, rip("fb_gs"), xmm0)
    mark(a, text_loop)
    alu(a, "cmp", r12, r13)
    jcc(a, cc_ae, text_done)
    load8(a, rax, mem(r12, 0)) # the next character, from UTF-8
    inc_r(a, r12)
    alui(a, "cmp", rax, 0x80)
    jcc(a, cc_b, decoded)
    movi(a, rcx, 1)
    movi(a, rdx, 0x1F)
    alui(a, "cmp", rax, 0xE0)
    set two to new_label(a)
    jcc(a, cc_b, two)
    movi(a, rcx, 2)
    movi(a, rdx, 0x0F)
    alui(a, "cmp", rax, 0xF0)
    jcc(a, cc_b, two)
    movi(a, rcx, 3)
    movi(a, rdx, 0x07)
    mark(a, two)
    alu(a, "and", rax, rdx)
    set more_bytes to new_label(a)
    mark(a, more_bytes)
    alu(a, "cmp", r12, r13)
    jcc(a, cc_ae, decoded)
    load8(a, rdx, mem(r12, 0))
    inc_r(a, r12)
    shifti(a, "shl", rax, 6)
    alui(a, "and", rdx, 0x3F)
    alu(a, "or", rax, rdx)
    dec_r(a, rcx)
    jcc(a, cc_ne, more_bytes)
    mark(a, decoded) # which glyph: 32 to 126 first, then 160 to 255, then U+FFFD for any other but a control
    # character, which is a space, as a canvas has a tab or a new line
    movi(a, rcx, 0)
    alui(a, "cmp", rax, 32)
    jcc(a, cc_b, glyph_found)
    load16(a, rcx, mem(rbx, 5))
    dec_r(a, rcx)
    set not_ascii to new_label(a)
    alui(a, "cmp", rax, 127)
    jcc(a, cc_ae, not_ascii)
    lea(a, rcx, mem(rax, -32))
    jmp_to(a, glyph_found)
    mark(a, not_ascii)
    alui(a, "cmp", rax, 160)
    jcc(a, cc_b, glyph_found)
    alui(a, "cmp", rax, 256)
    jcc(a, cc_ae, glyph_found)
    lea(a, rcx, mem(rax, 95 - 160))
    mark(a, glyph_found)
    imul_ri(a, r14, rcx, 12) # its head
    lea(a, r14, mem(r14, 7))
    alu(a, "add", r14, rbx)
    load8(a, rax, mem(r14, 7))
    store(a, rip("fb_gw"), rax)
    load8(a, rcx, mem(r14, 8))
    store(a, rip("fb_gh"), rcx)
    inc_r(a, rax)
    shifti(a, "shr", rax, 1)
    store(a, rip("fb_grow"), rax)
    load(a, rax, rip("fb_draw"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, glyph_drawn)
    load(a, rax, rip("fb_gw"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, glyph_drawn)
    load(a, rax, rip("fb_gh"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, glyph_drawn)
    load(a, rax, mem(r14, 9)) # where its ink is
    alui(a, "and", rax, 0xFFFFFF)
    load16(a, rcx, mem(rbx, 5))
    imul_ri(a, rcx, rcx, 12)
    alu(a, "add", rax, rcx)
    lea(a, rax, mem(rax, 7))
    alu(a, "add", rax, rbx)
    store(a, rip("fb_gink"), rax)
    movsx8_load(a, rax, mem(r14, 5)) # its picture's left, from where it's drawn, scaled
    cvtsi2sd(a, xmm0, rax)
    sse_math(a, "*", xmm0, rip("fb_gs"))
    sse_math(a, "+", xmm0, rip("fb_tx"))
    movsx8_load(a, rax, mem(r14, 6)) # and its top, above the baseline
    cvtsi2sd(a, xmm2, rax)
    sse_math(a, "*", xmm2, rip("fb_gs"))
    movsd_load(a, xmm1, rip("fb_ty"))
    sse_math(a, "-", xmm1, reg_at(xmm2))
    set unsnapped to new_label(a)
    load(a, rax, rip("fb_snap"))
    test_rr(a, rax, rax)
    jcc(a, cc_e, unsnapped)
    load_bits(a, xmm2, double_bytes(0.5))
    sse_math(a, "+", xmm0, reg_at(xmm2))
    floor_sd(a, xmm0, xmm0)
    sse_math(a, "+", xmm1, reg_at(xmm2))
    floor_sd(a, xmm1, xmm1)
    mark(a, unsnapped)
    movsd_store(a, rip("fb_gx"), xmm0)
    movsd_store(a, rip("fb_gy"), xmm1)
    floor_int(a, r15, xmm1) # its rows on fb
    clamp_up(a, r15, rip("fb_cy0"))
    mark(a, gy_loop)
    load(a, rax, rip("fb_gh")) # as far down as it goes, scaled
    cvtsi2sd(a, xmm0, rax)
    sse_math(a, "*", xmm0, rip("fb_gs"))
    sse_math(a, "+", xmm0, rip("fb_gy"))
    ceil_int(a, rax, xmm0)
    clamp_down(a, rax, rip("fb_cy1"))
    alu(a, "cmp", r15, rax)
    jcc(a, cc_ge, glyph_drawn)
    cvtsi2sd(a, xmm0, r15) # v: where the row's middle falls among its ink's rows
    load_bits(a, xmm1, double_bytes(0.5))
    sse_math(a, "+", xmm0, reg_at(xmm1))
    sse_math(a, "-", xmm0, rip("fb_gy"))
    sse_math(a, "/", xmm0, rip("fb_gs"))
    sse_math(a, "-", xmm0, reg_at(xmm1))
    movsd_store(a, rip("fb_gv"), xmm0)
    movsd_load(a, xmm0, rip("fb_gx"))
    floor_int(a, rax, xmm0)
    clamp_up(a, rax, rip("fb_cx0"))
    store(a, rip("fb_gc"), rax)
    mark(a, gx_loop)
    load(a, rax, rip("fb_gw"))
    cvtsi2sd(a, xmm0, rax)
    sse_math(a, "*", xmm0, rip("fb_gs"))
    sse_math(a, "+", xmm0, rip("fb_gx"))
    ceil_int(a, rax, xmm0)
    clamp_down(a, rax, rip("fb_cx1"))
    alu_load(a, "cmp", rax, rip("fb_gc"))
    jcc(a, cc_le, gy_next)
    load(a, rax, rip("fb_gc")) # u, likewise across
    cvtsi2sd(a, xmm0, rax)
    load_bits(a, xmm1, double_bytes(0.5))
    sse_math(a, "+", xmm0, reg_at(xmm1))
    sse_math(a, "-", xmm0, rip("fb_gx"))
    sse_math(a, "/", xmm0, rip("fb_gs"))
    sse_math(a, "-", xmm0, reg_at(xmm1))
    floor_sd(a, xmm2, xmm0) # the ink at the four pixels around (u, v), weighed by how near each is
    sse_math(a, "-", xmm0, reg_at(xmm2))
    movsd_store(a, rip("fb_fu"), xmm0)
    cvttsd2si(a, rcx, xmm2)
    store(a, rip("fb_iu"), rcx)
    movsd_load(a, xmm0, rip("fb_gv"))
    floor_sd(a, xmm2, xmm0)
    sse_math(a, "-", xmm0, reg_at(xmm2))
    movsd_store(a, rip("fb_fv"), xmm0)
    cvttsd2si(a, rdx, xmm2)
    store(a, rip("fb_iv"), rdx)
    load_bits(a, xmm3, double_bytes(0))
    for each tap in list of (list of 0, 0), (list of 1, 0), (list of 0, 1), (list of 1, 1)
        load(a, rcx, rip("fb_iu"))
        if item 1 of tap is 1
            inc_r(a, rcx)
        end
        load(a, rdx, rip("fb_iv"))
        if item 2 of tap is 1
            inc_r(a, rdx)
        end
        call_to(a, "rt_fb_ink")
        cvtsi2sd(a, xmm0, rax)
        if item 1 of tap is 1
            sse_math(a, "*", xmm0, rip("fb_fu"))
        else
            load_bits(a, xmm1, double_bytes(1))
            sse_math(a, "-", xmm1, rip("fb_fu"))
            sse_math(a, "*", xmm0, reg_at(xmm1))
        end
        if item 2 of tap is 1
            sse_math(a, "*", xmm0, rip("fb_fv"))
        else
            load_bits(a, xmm1, double_bytes(1))
            sse_math(a, "-", xmm1, rip("fb_fv"))
            sse_math(a, "*", xmm0, reg_at(xmm1))
        end
        sse_math(a, "+", xmm3, reg_at(xmm0))
    end
    load_bits(a, xmm1, double_bytes(15))
    sse_math(a, "/", xmm3, reg_at(xmm1))
    load_bits(a, xmm1, double_bytes(0.01))
    ucomisd(a, xmm3, reg_at(xmm1))
    jcc(a, cc_b, gx_skip)
    movapd(a, xmm0, xmm3)
    unit_clamp(a, xmm0)
    load(a, rcx, rip("fb_gc"))
    fb_pixel(a, rcx, r15)
    call_to(a, "rt_fb_blend")
    mark(a, gx_skip)
    alu_at(a, "add", rip("fb_gc"), 1)
    jmp_to(a, gx_loop)
    mark(a, gy_next)
    inc_r(a, r15)
    jmp_to(a, gy_loop)
    mark(a, glyph_drawn) # and on to where the next one goes
    load16(a, rax, mem(r14, 3))
    cvtsi2sd(a, xmm0, rax)
    load_bits(a, xmm1, double_bytes(64))
    sse_math(a, "/", xmm0, reg_at(xmm1))
    sse_math(a, "*", xmm0, rip("fb_gs"))
    sse_math(a, "+", xmm0, rip("fb_tx"))
    movsd_store(a, rip("fb_tx"), xmm0)
    jmp_to(a, text_loop)
    mark(a, text_done)
    for each r in list of r15, r14, r13, r12, rbx
        pop_r(a, r)
    end
    ret(a)

    # rt_fb_tri: the triangle with corners fb_p (six doubles: x, y, x, y, x, y, in pixels), filled in r9's
    # colour, each pixel by how many of 16 points across it are inside
    set tri_rows to new_label(a)
    set tri_cols to new_label(a)
    set tri_next to new_label(a)
    set tri_done to new_label(a)
    mark(a, "rt_fb_tri")
    for each r in list of r12, r13, r14, r15, rbx
        push_r(a, r)
    end
    movsd_load(a, xmm0, rip_plus("fb_p", 0)) # its bounds
    movapd(a, xmm1, xmm0)
    movsd_load(a, xmm2, rip_plus("fb_p", 8))
    movapd(a, xmm3, xmm2)
    for each corner in list of 16, 32
        minsd_at(a, xmm0, rip_plus("fb_p", corner))
        sse_math(a, "max", xmm1, rip_plus("fb_p", corner))
        minsd_at(a, xmm2, rip_plus("fb_p", corner + 8))
        sse_math(a, "max", xmm3, rip_plus("fb_p", corner + 8))
    end
    floor_int(a, r12, xmm0)
    clamp_up(a, r12, rip("fb_cx0"))
    ceil_int(a, r13, xmm1)
    clamp_down(a, r13, rip("fb_cx1"))
    floor_int(a, r14, xmm2)
    clamp_up(a, r14, rip("fb_cy0"))
    ceil_int(a, r15, xmm3)
    clamp_down(a, r15, rip("fb_cy1"))
    mark(a, tri_rows)
    alu(a, "cmp", r14, r15)
    jcc(a, cc_ge, tri_done)
    mov_rr(a, rbx, r12)
    mark(a, tri_cols)
    alu(a, "cmp", rbx, r13)
    jcc(a, cc_ge, tri_next)
    movi(a, r10, 0) # how many of the 16 are inside
    for each sy from 0 to 3
        for each sx from 0 to 3
            set outside to new_label(a)
            set inside to new_label(a)
            cvtsi2sd(a, xmm0, rbx)
            load_bits(a, xmm1, double_bytes((sx + 0.5) / 4))
            sse_math(a, "+", xmm0, reg_at(xmm1))
            cvtsi2sd(a, xmm1, r14)
            load_bits(a, xmm2, double_bytes((sy + 0.5) / 4))
            sse_math(a, "+", xmm1, reg_at(xmm2))
            movi(a, r11, 0) # which sides it's on: bit 0 for one, bit 1 for the other
            for each edge in list of (list of 0, 16), (list of 16, 32), (list of 32, 0)
                set on_plus to new_label(a)
                set sided to new_label(a)
                movsd_load(a, xmm2, rip_plus("fb_p", item 2 of edge)) # (b - a) × (p - a)
                sse_math(a, "-", xmm2, rip_plus("fb_p", item 1 of edge))
                movapd(a, xmm3, xmm1)
                sse_math(a, "-", xmm3, rip_plus("fb_p", item 1 of edge + 8))
                sse_math(a, "*", xmm2, reg_at(xmm3))
                movsd_load(a, xmm3, rip_plus("fb_p", item 2 of edge + 8))
                sse_math(a, "-", xmm3, rip_plus("fb_p", item 1 of edge + 8))
                movapd(a, xmm4, xmm0)
                sse_math(a, "-", xmm4, rip_plus("fb_p", item 1 of edge))
                sse_math(a, "*", xmm3, reg_at(xmm4))
                sse_math(a, "-", xmm2, reg_at(xmm3))
                load_bits(a, xmm3, double_bytes(0))
                ucomisd(a, xmm2, reg_at(xmm3))
                jcc(a, cc_ae, on_plus)
                alui(a, "or", r11, 1)
                jmp_to(a, sided)
                mark(a, on_plus)
                alui(a, "or", r11, 2)
                mark(a, sided)
            end
            alui(a, "cmp", r11, 3)
            jcc(a, cc_e, outside)
            inc_r(a, r10)
            mark(a, outside)
        end
    end
    test_rr(a, r10, r10)
    set tri_skip to new_label(a)
    jcc(a, cc_e, tri_skip)
    cvtsi2sd(a, xmm0, r10)
    load_bits(a, xmm1, double_bytes(16))
    sse_math(a, "/", xmm0, reg_at(xmm1))
    fb_pixel(a, rbx, r14)
    call_to(a, "rt_fb_blend")
    mark(a, tri_skip)
    inc_r(a, rbx)
    jmp_to(a, tri_cols)
    mark(a, tri_next)
    inc_r(a, r14)
    jmp_to(a, tri_rows)
    mark(a, tri_done)
    for each r in list of rbx, r15, r14, r13, r12
        pop_r(a, r)
    end
    ret(a)

    # rt_fb_image: rsi a picture's pixels (4 bytes each, ARGB), rdx how many across and r8 down, fb_x0, fb_y0
    # where its top left goes and fb_x1, fb_y1 how wide and high it's drawn: each pixel the one nearest it, as
    # a canvas draws a picture with smoothing off, over what's there by its alpha
    set img_rows to new_label(a)
    set img_cols to new_label(a)
    set img_next to new_label(a)
    set img_done to new_label(a)
    mark(a, "rt_fb_image")
    for each r in list of r12, r13, r14, r15, rbx
        push_r(a, r)
    end
    store(a, rip("fb_isrc"), rsi)
    store(a, rip("fb_iw"), rdx)
    store(a, rip("fb_ih"), r8)
    movsd_load(a, xmm0, rip("fb_x0"))
    floor_int(a, r12, xmm0)
    clamp_up(a, r12, rip("fb_cx0"))
    sse_math(a, "+", xmm0, rip("fb_x1"))
    ceil_int(a, r13, xmm0)
    clamp_down(a, r13, rip("fb_cx1"))
    movsd_load(a, xmm0, rip("fb_y0"))
    floor_int(a, r14, xmm0)
    clamp_up(a, r14, rip("fb_cy0"))
    sse_math(a, "+", xmm0, rip("fb_y1"))
    ceil_int(a, r15, xmm0)
    clamp_down(a, r15, rip("fb_cy1"))
    mark(a, img_rows)
    alu(a, "cmp", r14, r15)
    jcc(a, cc_ge, img_done)
    cvtsi2sd(a, xmm0, r14) # the picture's row: where the pixel's middle falls in it
    load_bits(a, xmm1, double_bytes(0.5))
    sse_math(a, "+", xmm0, reg_at(xmm1))
    sse_math(a, "-", xmm0, rip("fb_y0"))
    sse_math(a, "/", xmm0, rip("fb_y1"))
    load(a, rax, rip("fb_ih"))
    cvtsi2sd(a, xmm1, rax)
    sse_math(a, "*", xmm0, reg_at(xmm1))
    floor_int(a, rbx, xmm0)
    test_rr(a, rbx, rbx)
    jcc(a, cc_s, img_next)
    alu_load(a, "cmp", rbx, rip("fb_ih"))
    jcc(a, cc_ge, img_next)
    mov_rr(a, rcx, r12)
    mark(a, img_cols)
    alu(a, "cmp", rcx, r13)
    jcc(a, cc_ge, img_next)
    cvtsi2sd(a, xmm0, rcx)
    load_bits(a, xmm1, double_bytes(0.5))
    sse_math(a, "+", xmm0, reg_at(xmm1))
    sse_math(a, "-", xmm0, rip("fb_x0"))
    sse_math(a, "/", xmm0, rip("fb_x1"))
    load(a, rax, rip("fb_iw"))
    cvtsi2sd(a, xmm1, rax)
    sse_math(a, "*", xmm0, reg_at(xmm1))
    floor_int(a, rdx, xmm0)
    set col_skip to new_label(a)
    test_rr(a, rdx, rdx)
    jcc(a, cc_s, col_skip)
    alu_load(a, "cmp", rdx, rip("fb_iw"))
    jcc(a, cc_ge, col_skip)
    load(a, rax, rip("fb_iw"))
    imul_rr(a, rax, rbx)
    alu(a, "add", rax, rdx)
    shifti(a, "shl", rax, 2)
    alu_load(a, "add", rax, rip("fb_isrc"))
    load32(a, r9, mem(rax, 0))
    load_bits(a, xmm0, double_bytes(1))
    push_r(a, rcx)
    fb_pixel(a, rcx, r14)
    call_to(a, "rt_fb_blend")
    pop_r(a, rcx)
    mark(a, col_skip)
    inc_r(a, rcx)
    jmp_to(a, img_cols)
    mark(a, img_next)
    inc_r(a, r14)
    jmp_to(a, img_rows)
    mark(a, img_done)
    for each r in list of rbx, r15, r14, r13, r12
        pop_r(a, r)
    end
    ret(a)
end

# ---------- DejaVu's letters: made by tools/glyph-tables.py ----------
# DejaVu Sans at 16 and 24 pixels to the em, and DejaVu Sans Mono at 16: the glyph tables rt_fb_text draws
# text with on Linux, as base64, 100 characters a line. A table is "MF", the em, the ascent and descent and
# how many glyphs (2 bytes); then 12 bytes for each: its character (3 bytes), its advance in 64ths of a pixel
# (2), its picture's left and top from where it's drawn, the top going up (1 each, signed), its width and
# height (1 each), and where its ink starts among the ink bytes (3); then the ink, 4 bits a pixel, the left
# one in a byte's low half, each row starting on a byte of its own. Its characters are 32 to 126, 160 to 255
# and U+FFFD, for any other. dejavu_notice is the fonts' licence, which goes into a program with them.
set dejavu_sans16_lines to list of "TUYQDwTAACAAAEABAAAFAAAAACEAAIABAAwGDAAAACIAAMABAAwHDCQAACMAAEADAAsNC1QAACQAAIACAAwKDqEAACUAAMADAAwP",
