value after it,\\n  // which fillDefaults puts in its place, as no call could have a name followed by a value before.\\n  function anInput(args) \{\\n    const e = expression();\\n    if (e.kind === \\\"name\\\" && !e.name.includes(\\\"'s\\\") && !peek().nl && !check(\\\",\\\") && !check(\\\")\\\")) \{\\n      args.push(\{ kind: \\\"named\\\", name: e.name, value: expression(), at: e.at });\\n      return;\\n    }\\n    if (args.some((a) => a.kind === \\\"named\\\")) fail(e.at, \\\"the inputs given in order come before those given by name\\\");\\n    args.push(e);\\n  }\\n\\n  // A variable of the program's own, for what a statement is written as, with a name no program can write:\\n  // `the step on line 3`, in a file the program uses `the step on line 3 of shapes.folio`, then `(2)`, `(3)`...\\n  // a number written in at a token, as if written there, as the JIT writes a number as it was written\\n  const numberAt = (n, t) => (\{ kind: \\\"value\\\", value: n, at: \{ ...t, type: \\\"number\\\", value: n, text: String(n) } });\\n\\n  const hiddenOnLine = new Map();\\n  function hidden(what, t) \{\\n    const named = `$\{what} on line $\{t.line}$\{t.file ? ` of $\{t.file}` : \\\"\\\"}`;\\n    const n = (hiddenOnLine.get(named) ?? 0) + 1;\\n    hiddenOnLine.set(named, n);\\n    return n > 1 ? `$\{named} ($\{n})` : named;\\n  }\\n\\n  // tokens as they were written, with a space between each but after ( and before ), a comma and 's\\n  function spoken(said) \{\\n    let out = \\\"\\\";\\n    said.forEach((tk, k) => \{\\n      const piece = tk.type === \\\"word\\\" ? tk.raw : tk.type === \\\"number\\\" ? tk.text : tk.type === \\\"string\\\" ? `\\\"$\{tk.value}\\\"` : tk.value;\\n      if (k > 0 && !(piece === \\\")\\\" || piece === \\\",\\\" || tk.type === \\\"'s\\\") && said[k - 1].type !== \\\"(\\\") out += \\\" \\\";\\n      out += piece;\\n    });\\n    return out;\\n  }\\n\\n  // `to withdraw with amount where amount is greater than 0` (DESIGN §143): what a function needs, checked at\\n  // the start of each call, as an `if` that fails with what the function needs, said as it was written, and, for\\n  // a comparison of a name, what that name was\\n  function needsOf(fnName, t) \{\\n    const from = pos;\\n    const cond = expression();\\n    const at = (kind, rest) => (\{ ...rest, kind, at: t });\\n    const text = `'$\{fnName}' needs $\{spoken(tokens.slice(from, pos))}`;\\n    let why = at(\\\"value\\\", \{ value: text });\\n    if (cond.kind === \\\"compare\\\" && cond.left.kind === \\\"name\\\") \{\\n      why = at(\\\"math\\\", \{ op: \\\"+\\\", left: at(\\\"value\\\", \{ value: `$\{text}, but $\{cond.left.name} is ` }), right: at(\\\"name\\\", \{ name: cond.left.name }) });\\n    }\\n    return at(\\\"if\\\", \{ cond: at(\\\"not\\\", \{ operand: cond }), then: [at(\\\"fail\\\", \{ value: why })], otherwise: [] });\\n  }\\n\\n  // `set a, b to pair`: what's after `to` kept in a variable of its own, then each name its item, once there\\n  // are as many as names. Gives the statements.\\n  function unpacked(names, value, t) \{\\n    const at = (kind, rest) => (\{ ...rest, kind, at: t });\\n    const kept = hidden(\\\"the values\\\", t);\\n    const made = [at(\\\"set\\\", \{ name: kept, value })];\\n    if (!(value.kind === \\\"list\\\" && value.items.length === names.length)) \{\\n      const count = () => at(\\\"length\\\", \{ of: at(\\\"name\\\", \{ name: kept }) });\\n      const why = at(\\\"math\\\", \{ op: \\\"+\\\", left: at(\\\"value\\\", \{ value: `can't set $\{names.length} names from a list of ` }), right: count() });\\n      made.push(at(\\\"if\\\", \{ cond: at(\\\"compare\\\", \{ op: \\\"is\\\", negate: true, left: count(), right: numberAt(names.length, t) }), then: [at(\\\"fail\\\", \{ value: why })], otherwise: [] }));\\n    }\\n    names.forEach((n, i) => made.push(at(\\\"set\\\", \{ name: n, value: at(\\\"item\\\", \{ index: numberAt(i + 1, t), of: at(\\\"name\\\", \{ name: kept }) }) })));\\n    return made;\\n  }\\n\\n  // `for each k from 10 to 1 by -2`: a count from 0 to the steps there's room for, with k worked out from it\\n  // each time round, so a step that doesn't land on the end stops before it, as Python's range does\\n  function stepped(variable, from, to, step, body, t, by) \{\\n    const at = (kind, rest) => (\{ ...rest, kind, at: by });\\n    const [start, size, count] = [hidden(\\\"the start\\\", t), hidden(\\\"the step\\\", t), hidden(\\\"the count\\\", t)];\\n    const ref = (n) => at(\\\"name\\\", \{ name: n });\\n    const steps = at(\\\"builtin\\\", \{ name: \\\"rounded down\\\", args: [at(\\\"math\\\", \{ op: \\\"/\\\", left: at(\\\"math\\\", \{ op: \\\"-\\\", left: to, right: ref(start) }), right: ref(size) })] });\\n    const zero = at(\\\"compare\\\", \{ op: \\\"is\\\", negate: false, left: ref(size), right: numberAt(0, by) });\\n    const here = at(\\\"set\\\", \{ name: variable, value: at(\\\"math\\\", \{ op: \\\"+\\\", left: ref(start), right: at(\\\"math\\\", \{ op: \\\"*\\\", left: ref(count), right: ref(size) }) }) });\\n    return \{ kind: \\\"several\\\", body: [at(\\\"set\\\", \{ name: start, value: from }), at(\\\"set\\\", \{ name: size, value: step }),\\n      at(\\\"if\\\", \{ cond: zero, then: [at(\\\"fail\\\", \{ value: at(\\\"value\\\", \{ value: \\\"'by' needs a step that isn't 0\\\" }) })], otherwise: [] }),\\n      \{ kind: \\\"count\\\", name: count, from: numberAt(0, by), to: steps, body: [here, ...body], at: t }], at: t };\\n  }\\n\\n  // `try ... either way ... end`: what's after `either way` runs however the try's statements end, written in\\n  // what Folio has. The try goes in another, whose `if it fails` keeps the mistake; with a `return` or a `stop`\\n  // that leaves it, both go in a loop that runs once, and each becomes a note of how it left and a `stop` of\\n  // that loop (a loop it's in stops, and the loop after it). Then what runs either way, and then the mistake\\n  // is passed on, or the return or the stop made.\\n  function eitherWay(t, body, caught, handler, after) \{\\n    const at = (kind, rest) => (\{ ...rest, kind, at: t });\\n    const [failed, mistake, leaving, giving] = [hidden(\\\"whether it failed\\\", t), hidden(\\\"the mistake\\\", t), hidden(\\\"how it left\\\", t), hidden(\\\"what it gave\\\", t)];\\n    const ref = (n) => at(\\\"name\\\", \{ name: n });\\n    const leftBy = (how) => at(\\\"compare\\\", \{ op: \\\"is\\\", negate: false, left: ref(leaving), right: at(\\\"value\\\", \{ value: how }) });\\n    const left = \{ return: false, stop: false };\\n    const leave = (how, s) => [...(how === \\\"return\\\" ? [\{ kind: \\\"set\\\", name: giving, value: s.value ?? \{ kind: \\\"value\\\", value: null, at: s.at }, at: s.at }] : []),\\n      \{ kind: \\\"set\\\", name: leaving, value: \{ kind: \\\"value\\\", value: how, at: s.at }, at: s.at }, \{ kind: \\\"stop\\\", at: s.at }];\\n    const rewrite = (list, inLoop) => list.flatMap((s) => \{\\n      if (s.kind === \\\"return\\\") return (left.return = true), leave(\\\"return\\\", s);\\n      if (s.kind === \\\"stop\\\" && !inLoop) return (left.stop = true), leave(\\\"stop\\\", s);\\n      if (s.kind === \\\"if\\\") return [\{ ...s, then: rewrite(s.then, inLoop), otherwise: rewrite(s.otherwise, inLoop) }];\\n      if (s.kind === \\\"try\\\") return [\{ ...s, body: rewrite(s.body, inLoop), handler: rewrite(s.handler, inLoop) }];\\n      if (![\\\"while\\\", \\\"repeat\\\", \\\"count\\\", \\\"each\\\"].includes(s.kind)) return [s];\\n      const before = left.return;\\n      left.return = false;\\n      const loop = \{ ...s, body: rewrite(s.body, true) };\\n      const returns = left.return;\\n      left.return = before || returns;\\n      return returns ? [loop, at(\\\"if\\\", \{ cond: leftBy(\\\"return\\\"), then: [at(\\\"stop\\\", \{})], otherwise: [] })] : [loop];\\n    });\\n    const inner = rewrite(handler ? [at(\\\"try\\\", \{ body, name: caught, handler })] : body, false);\\n    const keeping = at(\\\"try\\\", \{ body: inner, name: mistake, handler: [at(\\\"set\\\", \{ name: failed, value: at(\\\"value\\\", \{ value: true }) })] });\\n    const made = [at(\\\"set\\\", \{ name: failed, value: at(\\\"value\\\", \{ value: false }) })];\\n    if (left.return || left.stop) made.push(at(\\\"set\\\", \{ name: leaving, value: at(\\\"value\\\", \{ value: null }) }), at(\\\"repeat\\\", \{ count: numberAt(1, t), body: [keeping] }));\\n    else made.push(keeping);\\n    made.push(...after, at(\\\"if\\\", \{ cond: ref(failed), then: [at(\\\"fail\\\", \{ value: ref(mistake) })], otherwise: [] }));\\n    if (left.return) made.push(at(\\\"if\\\", \{ cond: leftBy(\\\"return\\\"), then: [at(\\\"return\\\", \{ value: ref(giving) })], otherwise: [] }));\\n    if (left.stop) made.push(at(\\\"if\\\", \{ cond: leftBy(\\\"stop\\\"), then: [at(\\\"stop\\\", \{})], otherwise: [] }));\\n    return \{ kind: \\\"several\\\", body: made, at: t };\\n  }\\n\\n  // A function's inputs, after its `with`, if it has one: each one's name, what it says it is (`with width as\\n  // a number`, or -1), and what it is when a call leaves it out (`greeting or \\\"Hello\\\"`, or null).\\n  function inputsOf() \{\\n    const [params, kinds, types, defaults] = [[], [], [], []];\\n    if (word(\\\"with\\\")) \{\\n      do \{\\n        const at = peek();\\n        params.push(name(\\\"an input name\\\"));\\n        const [kind, type] = word(\\\"as\\\") ? inputType() : [-1, null];\\n        kinds.push(kind);\\n        types.push(type);\\n        const fallback = word(\\\"or\\\") ? unary() : null;\\n        if (fallback && !fallbackFits(fallback)) fail(fallback.at, `an input's 'or' is what it is when a call leaves it out: a number, text, yes, no, nothing, or a list of them, written out`);\\n        if (!fallback && defaults.some((d) => d)) fail(at, `'$\{params.at(-1)}' needs an 'or' too, as an input before it has one`);\\n        defaults.push(fallback);\\n      } while (match(\\\",\\\") || word(\\\"and\\\"));\\n    }\\n    return \{ params, kinds, types, defaults };\\n  }\\n\\n  // whether `kind` starts a kind: a name after it, then `with` or `from` on the same line, or the line's end\\n  // and a `to` starting the next\\n  function kindNext() \{\\n    const [named, after] = [tokens[pos + 1], tokens[pos + 2]];\\n    if (named.nl || named.type !== \\\"word\\\" || RESERVED.has(named.value)) return false;\\n    if (after.type !== \\\"eof\\\" && !after.nl) return after.type === \\\"word\\\" && (after.value === \\\"with\\\" || after.value === \\\"from\\\");\\n    return wordAt(pos + 2, \\\"to\\\");\\n  }\\n\\n  // `kind dog with name, sound or \\\"woof\\\"`, then the functions each dog has, each made with `to`, then `end`.\\n  // `dog` is a function with those inputs, which makes a record of them, its `kind` \\\"dog\\\", with a field for\\n  // each of the functions, made as `dog's speak`, so `rex's speak()` calls it with rex first (DESIGN §68).\\n  // `kind puppy with name from dog(name)`: what dog(name) makes is given puppy's inputs, kind and functions\\n  // instead, and `dog's speak(self)` calls dog's own. Gives the functions, as statements.\\n  function madeKind(t) \{\\n    const kindName = name(\\\"a kind's name\\\");\\n    const \{ params, kinds, types, defaults } = inputsOf();\\n    if (params.includes(\\\"kind\\\")) fail(t, \\\"a kind's inputs can't include one called 'kind', as that's the field that says which kind it is\\\");\\n    const from = word(\\\"from\\\") ? expression() : null;\\n    if (!peek().nl) expected(\\\"a new line\\\");\\n    aliases.add(kindName); // `dog's speak` is dog's function, as `math's sine` is math's\\n    const fns = blockEnd(t);\\n    const owns = [];\\n    for (const d of fns) \{\\n      if (d.kind !== \\\"define\\\") fail(d.at, \\\"a kind holds only its functions, each made with 'to'\\\");\\n      if (params.includes(d.name)) fail(d.at, `'$\{d.name}' is one of the kind's inputs, so a function of it can't be called that too`);\\n      owns.push(\{ own: d.name, at: d.at });\\n      if (d.name === \\\"shown\\\") reading.wants.add(\\\"shown\\\"); // say and values in text then go through it (see withLanguage)\\n      d.name = `$\{kindName}'s $\{d.name}`;\\n    }\\n    const at = (kind, rest) => (\{ ...rest, kind, at: t });\\n    const made = hidden(\\\"the one made\\\", t);\\n    const ref = () => at(\\\"name\\\", \{ name: made });\\n    const named = at(\\\"value\\\", \{ value: kindName });\\n    const body = [at(\\\"set\\\", \{ name: made, value: from ?? at(\\\"record\\\", \{ fields: [\\\"kind\\\"], values: [named] }) })];\\n    if (from) body.push(at(\\\"setField\\\", \{ name: \\\"kind\\\", target: ref(), value: at(\\\"value\\\", \{ value: kindName }) }));\\n    for (const p of params) body.push(at(\\\"setField\\\", \{ name: p, target: ref(), value: at(\\\"name\\\", \{ name: p }) }));\\n    for (const o of owns) body.push(at(\\\"setField\\\", \{ name: o.own, target: ref(), value: \{ kind: \\\"name\\\", name: `$\{kindName}'s $\{o.own}`, at: o.at } }));\\n    body.push(at(\\\"return\\\", \{ value: ref() }));\\n    const maker = \{ kind: \\\"define\\\", name: kindName, params, body, at: t, kinds, madeKind: kindName }; // the checker knows a dog by madeKind\\n    if (defaults.some((d) => d)) maker.defaults = defaults;\\n    if (types.some((type) => type)) maker.types = types;\\n    reading.defines.push(maker);\\n    return \{ kind: \\\"several\\\", body: [...fns, maker], at: t };\\n  }\\n\\n  // whether the line after this one starts with `when`, as a `match`'s first clause does\\n  function whenNext() \{\\n    let i = pos + 1;\\n    while (tokens[i].type !== \\\"eof\\\" && !tokens[i].nl) i++;\\n    return wordAt(i, \\\"when\\\");\\n  }\\n\\n  // `match command` and its clauses: `when \\\"go\\\", \\\"walk\\\"` (or `when \\\"go\\\" or \\\"walk\\\"`), `when is greater than 5`\\n  // (any of `is`'s comparisons), then `else`. The value is kept in a variable of its own, and each clause is an\\n  // `if` of it, the next clause in its `else`.\\n  function matched(t) \{\\n    const subject = expression();\\n    if (!peek().nl) expected(\\\"a new line\\\");\\n    const kept = hidden(\\\"the value matched\\\", t);\\n    const ref = (at) => (\{ kind: \\\"name\\\", name: kept, at });\\n    const clauses = [];\\n    nesting++;\\n    while (isWord(\\\"when\\\")) \{\\n      const w = peek();\\n      lay(w);\\n      pos++;\\n      let cond;\\n      if (isWord(\\\"is\\\")) cond = compared(ref(w));\\n      else \{\\n        const values = [bitwise()];\\n        while (match(\\\",\\\") || word(\\\"or\\\")) values.push(bitwise());\\n        cond = values.map((v) => (\{ kind: \\\"compare\\\", op: \\\"is\\\", negate: false, left: ref(w), right: v, at: w })).reduce((a, b) => (\{ kind: \\\"or\\\", left: a, right: b, at: w }));\\n      }\\n      if (!peek().nl) expected(\\\"a new line\\\");\\n      clauses.push(\{ cond, then: statements(t, \\\"match\\\"), at: w });\\n    }\\n    let otherwise = [];\\n    if (word(\\\"else\\\")) otherwise = block(t);\\n    nesting--;\\n    lay(peek());\\n    expectWord(\\\"end\\\");\\n    let chain = otherwise;\\n    for (const c of clauses.reverse()) chain = [\{ kind: \\\"if\\\", cond: c.cond, then: c.then, otherwise: chain, at: c.at }];\\n    return \{ kind: \\\"several\\\", body: [\{ kind: \\\"set\\\", name: kept, value: subject, at: t }, ...chain], at: t };\\n  }\\n\\n  const made = statements(null);\\n  if (reading.depth === 1) withLanguage(reading, made);\\n  if (--reading.depth === 0) \{\\n    fillDefaults(reading);\\n    madeGenerators(reading, made);\\n    ownCalls(reading, made);\\n  }\\n  return made;\\n}\\n\\n// The language's own functions (LANGUAGE), at the program's top, if it needs them: for `with 2 decimals`, or\\n// for a kind's `shown`, which every `say` and value in text then goes through, so a record whose `shown` field\\n// is a function is shown as that function gives it.\\nfunction withLanguage(reading, body) \{\\n  if (reading.wants.has(\\\"shown\\\")) \{\\n    const shown = (e) => (\{ kind: \\\"call\\\", name: \\\"the language's shown\\\", args: [e], at: e.at });\\n    for (const s of reading.shows) \{\\n      if (s.kind === \\\"say\\\") s.parts = s.parts.map(shown);\\n      else s.right = shown(s.right);\\n    }\\n  }\\n  if (reading.wants.size) body.unshift(...prefixed(parse(tokenize(LANGUAGE, \\\"the language\\\"), reading), \\\"the language\\\"));\\n}\\n\\n// `pet's speak(x)`, in a program that makes nothing called speak (no function, input or variable, in any\\n// file it uses): a call to a function made for it at the program's top, which calls the function pet's\\n// speak field holds, with pet first, so records can each have their own. If pet has no speak, it fails as\\n// a call to a function nobody made did.\\nfunction ownCalls(reading, body) \{\\n  if (!reading.owns.length) return;\\n  const names = madeNames(body, new Set());\\n  const helpers = [];\\n  const onLine = new Map();\\n  for (const call of reading.owns) \{\\n    if (names.has(call.name)) continue;\\n    const [t, own] = [call.at, call.name];\\n    const key = `$\{own} $\{t.line}`;\\n    onLine.set(key, (onLine.get(key) ?? 0) + 1);\\n    const helper = `$\{own} of the record on line $\{t.line}$\{onLine.get(key) > 1 ? ` ($\{onLine.get(key)})` : \\\"\\\"}`;\\n    const params = [\\\"the record\\\", ...call.args.slice(1).map((_, i) => `input $\{i + 1}`)];\\n    const at = (kind, rest) => (\{ ...rest, kind, at: t });\\n    const guess = closest(own, [...names]);\\n    const why = `there is no function called '$\{own}'$\{guess ? `. Did you mean '$\{guess}'?` : \\\"\\\"}`;\\n    helpers.push(at(\\\"define\\\", \{ name: helper, params, kinds: params.map(() => -1), body: [\\n      at(\\\"try\\\", \{ body: [at(\\\"set\\\", \{ name: own, value: at(\\\"field\\\", \{ name: own, of: at(\\\"name\\\", \{ name: \\\"the record\\\" }) }) })], name: null,\\n        handler: [at(\\\"fail\\\", \{ value: at(\\\"value\\\", \{ value: why }) })] }),\\n      at(\\\"return\\\", \{ value: at(\\\"call\\\", \{ name: own, args: params.map((p) => at(\\\"name\\\", \{ name: p })) }) }),\\n    ] }));\\n    call.name = helper;\\n  }\\n  body.unshift(...helpers);\\n}\\n\\n// `give x` in a function, in a program that makes nothing called `give` (no function, input or variable): the\\n// function gives the list of every value it gave, in order, when it returns (DESIGN §96). The list is a\\n// variable of its own, made as the function starts; each `give x` adds x to it, and each `return` returns it.\\nfunction madeGenerators(reading, program) \{\\n  const giving = (s) => s.kind === \\\"call\\\" && s.name === \\\"give\\\" && s.args.length === 1;\\n  const gives = (body) => body.some((s) => giving(s) || [s.then, s.otherwise, s.kind !== \\\"define\\\" && s.body, s.handler].some((inner) => Array.isArray(inner) && gives(inner)));\\n  const fns = reading.defines.filter((f) => gives(f.body));\\n  if (!fns.length || madeNames(program, new Set()).has(\\\"give\\\")) return;\\n  for (const f of fns) \{\\n    const t = f.at;\\n    const list = `the values given on line $\{t.line}$\{t.file ? ` of $\{t.file}` : \\\"\\\"}`;\\n    const walk = (body) => body.forEach((s, i) => \{\\n      if (giving(s)) body[i] = \{ kind: \\\"add\\\", value: s.args[0], name: list, at: s.at };\\n      else if (s.kind === \\\"return\\\") \{\\n        if (s.value && !(s.value.kind === \\\"name\\\" && s.value.name.includes(\\\" on line \\\"))) fail(s.value.at, \\\"a function that gives its values with 'give' returns the list of them, so it can't return a value too\\\");\\n        body[i] = \{ kind: \\\"return\\\", value: \{ kind: \\\"name\\\", name: list, at: s.at }, at: s.at };\\n      } else for (const inner of [s.then, s.otherwise, s.kind !== \\\"define\\\" && s.body, s.handler]) if (Array.isArray(inner)) walk(inner);\\n    });\\n    walk(f.body);\\n    f.body.unshift(\{ kind: \\\"set\\\", name: list, value: \{ kind: \\\"list\\\", items: [], at: t }, at: t });\\n    f.body.push(\{ kind: \\\"return\\\", value: \{ kind: \\\"name\\\", name: list, at: t }, at: t });\\n  }\\n}\\n\\n// every name the code makes: functions, their inputs, and variables, in the order they're written\\nfunction madeNames(body, names) \{\\n  for (const s of body) \{\\n    const fn = s.kind === \\\"define\\\" ? s : s.fn; // `when` and `every` make a function too\\n    if (fn) \{\\n      if (s.kind === \\\"define\\\") names.add(s.name);\\n      for (const p of fn.params) names.add(p);\\n      madeNames(fn.body, names);\\n    }\\n    if ([\\\"set\\\", \\\"add\\\", \\\"count\\\", \\\"each\\\"].includes(s.kind) || (s.kind === \\\"try\\\" && s.name)) names.add(s.name);\\n    for (const inner of [s.then, s.otherwise, s.kind !== \\\"define\\\" && s.body, s.handler]) if (inner) madeNames(inner, names);\\n  }\\n  return names;\\n}\\n\\n// A call by a function's name that leaves inputs out, `greet(\\\"Sam\\\")` for `to greet with name, greeting or\\n// \\\"Hello\\\"`, gets what each was given after its `or`, once the whole program is read, so every engine sees a\\n// call with all of them. A function made more than once with that name: its last. Through a value, a call\\n// needs them all. Inputs given by name, `greet(\\\"Sam\\\", greeting \\\"Hi\\\")`, go in their places first, each left\\n// out before one of them getting its `or`.\\nfunction fillDefaults(reading) \{\\n  const made = new Map();\\n  for (const f of reading.defines) made.set(f.name, f);\\n  for (const call of reading.calls) \{\\n    const first = call.args.findIndex((a) => a.kind === \\\"named\\\");\\n    if (first < 0) continue;\\n    const f = made.get(call.name);\\n    const given = call.args.splice(first);\\n    if (!f) fail(given[0].at, `'$\{call.name}' isn't a function made with 'to' here, so its inputs can't be given by name`);\\n    for (const g of given) \{\\n      const k = f.params.indexOf(g.name);\\n      if (k < 0) fail(g.at, `'$\{call.name}' has no input called '$\{g.name}'`);\\n      if (call.args[k] !== undefined) fail(g.at, `'$\{g.name}' is given twice`);\\n      call.args[k] = g.value;\\n    }\\n    for (let k = 0; k < call.args.length; k++) \{\\n      if (call.args[k] !== undefined) continue;\\n      if (!f.defaults?.[k]) fail(given[0].at, `'$\{call.name}' needs its input '$\{f.params[k]}' too, as it has no 'or'`);\\n      call.args[k] = copied(f.defaults[k]);\\n    }\\n  }\\n  const withDefaults = new Map();\\n  for (const f of reading.defines) withDefaults.set(f.name, f.defaults ? f : null);\\n  for (const call of reading.calls) \{\\n    const f = withDefaults.get(call.name);\\n    if (!f || call.args.length >= f.params.length || f.defaults.slice(call.args.length).includes(null)) continue;\\n    call.args.push(...f.defaults.slice(call.args.length).map(copied));\\n  }\\n}\\nconst copied = (node) => (Array.isArray(node) ? node.map(copied) : node?.kind ? Object.fromEntries(Object.entries(node).map(([k, v]) => [k, k === \\\"at\\\" ? v : copied(v)])) : node);\\n\\n// what can come after an input's `or`: a value written out, or a list of them\\nconst fallbackFits = (e) => e.kind === \\\"value\\\" || (e.kind === \\\"negate\\\" && e.operand.kind === \\\"value\\\" && typeof e.operand.value === \\\"number\\\")\\n  || (e.kind === \\\"list\\\" && e.items.every(fallbackFits)) || (e.kind === \\\"dictionary\\\" && e.items.length === 0) || (e.kind === \\\"record\\\" && e.fields.length === 0);\\n\\n// `use \\\"math.folio\\\" as math`: each name in the file becomes `math's pi`, `math's sine`, which no name in the\\n// program can be, so the file keeps its own top level, as if it ran alone. The file's code is then the\\n// program's, as with any `use`. A function's inputs, and the functions a function makes, are left alone,\\n// since nothing outside the function can reach them; every other name is renamed, so a variable only a\\n// function in the file sets stays that function's own, and a name the file never makes isn't the program's.\\n// What a library's function can take and give, and what Folio checks each input is (see KINDS in vm.js, and -1\\n// for anything): a number is a double, a float a float, a whole number an int, a long whole number 64 bits,\\n// and a pointer a whole number, nothing or bytes; text is UTF-8, wide text wchar_t's (UTF-16 on Windows). A\\n// structure is a record, or nothing, and a callback a function. A list of numbers is a double*, to the list's own\\n// numbers, which C can read and change (DESIGN §118).\\nconst LIBRARY_TYPES = \{ \\\"a number\\\": 0, \\\"a float\\\": 0, \\\"a whole number\\\": 0, \\\"a long whole number\\\": 0, \\\"a pointer\\\": -1, \\\"text\\\": 1, \\\"wide text\\\": 1, \\\"bytes\\\": 6, \\\"yes or no\\\": 2,\\n  \\\"a byte\\\": 0, \\\"a signed byte\\\": 0, \\\"a short whole number\\\": 0, \\\"an unsigned short whole number\\\": 0, \\\"an unsigned whole number\\\": 0, \\\"an unsigned long whole number\\\": 0,\\n  \\\"a list of numbers\\\": 3 };\\n\\nconst NAMED = new Set([\\\"set\\\", \\\"add\\\", \\\"count\\\", \\\"each\\\", \\\"define\\\", \\\"call\\\", \\\"name\\\", \\\"try\\\"]); // nodes whose `name` is a variable\\nfunction prefixed(body, alias) \{\\n  const walk = (node, hidden, handler) => \{\\n    if (NAMED.has(node.kind) && node.name != null && !hidden.has(node.name) && !handler && !node.name.startsWith(\\\"the language's \\\")) node.name = `$\{alias}'s $\{node.name}`;\\n    const inside = node.kind === \\\"define\\\" ? new Set([...hidden, ...node.params, ...declarations(node.body).own]) : hidden;\\n    for (const [key, child] of Object.entries(node)) \{ // a `when` or `every`'s function (`fn`) has a name that isn't a variable\\n      if (key !== \\\"at\\\") for (const c of Array.isArray(child) ? child : [child]) if (c?.kind) walk(c, key === \\\"body\\\" ? inside : hidden, key === \\\"fn\\\");\\n    }\\n  };\\n  for (const s of body) walk(s, new Set());\\n  return body;\\n}\\n\\n// ---------- bytecode compiler ----------\\n\\nconst \{ GET, SET, CONST, JUMP, JUMP_IF_FALSE, COMPARE, ADD, SUB, MUL, DIV, CALL, GET_FN, RETURN, POP, AND, OR, NEG, NOT,\\n  LIST, LENGTH, ITEM, ITEM_REF, SET_ITEM, ADD_TO, SAY, CHECK_REPEAT, REPEAT_NEXT, CHECK_RANGE, RANGE_NEXT, ITER, ITER_NEXT,\\n  MAKE_FN, UNDEFINED, HALT, LINE, TURTLE, RECORD, FIELD, RECORD_REF, SET_FIELD, FAIL, BUILTIN, ASK, TRY, END_TRY, CAUGHT, DICT, REMOVE, READ, WRITE, ARGUMENTS, EXPECT, RANDOM, HANDLE, EVERY, SAY_ERROR, EXIT, REMOVE_FILE, NOW, WAIT,\\n  READ_FOLDER, PLAY, WORKER } = OP;\\nconst MATH_OPS = \{ \\\"+\\\": ADD, \\\"-\\\": SUB, \\\"*\\\": MUL, \\\"/\\\": DIV };\\nconst LOOPS = new Set([\\\"while\\\", \\\"repeat\\\", \\\"count\\\", \\\"each\\\"]);\\n\\n// Compiles one function (or the whole program) to bytecode for vm.js. Scope (scope.js) has already given\\n// every variable a slot, so a name becomes a (depth, slot) pair here.\\nclass Compiler extends Scope \{\\n  constructor(parent, name, params, body, options) \{\\n    super(parent, name, params, body, options);\\n    Object.assign(this.fn, \{ code: [], consts: [], at: [] });\\n    this.loops = []; // the loops being compiled, innermost last: how much each keeps on the stack, and its stops\\n    this.tries = 0; // `try`s around the code being compiled, in this function\\n    for (const s of body) this.statement(s);\\n    if (parent) this.emit(null, CONST, this.constant(null), RETURN);\\n    else this.emit(null, HALT);\\n  }\\n\\n  // In a debug build, the machine can pause here: a statement on this line is about to run. A function the\\n  // parser made for what a statement is written as (`speak of the record on line 3`, made at the program's top)\\n  // marks no line of its own, as the statement it's for does when it runs.\\n  mark(s) \{\\n    if (s.kind === \\\"define\\\" && s.name.includes(\\\" on line \\\")) return;\\n    if (this.debug && !s.at.file) this.emit(s.at, LINE, s.at.line); // the debugger steps through this file, not the ones it uses\\n  }\\n\\n  emit(at, ...code) \{\\n    this.fn.at[this.fn.code.length] = at;\\n    this.fn.code.push(...code);\\n  }\\n\\n  constant(value) \{\\n    return this.fn.consts.push(value) - 1;\\n  }\\n\\n  here() \{\\n    return this.fn.code.length;\\n  }\\n\\n  jump(at, op, to = -1) \{\\n    this.emit(at, op, to);\\n    return this.here() - 1; // where the target goes, for patch()\\n  }\\n\\n  patch(i) \{\\n    this.fn.code[i] = this.here();\\n  }\\n\\n  // A name nothing ever sets: fail when this line runs (with any \\\"did you mean\\\" from Scope).\\n  undefinedName(name, at, options) \{\\n    this.emit(at, UNDEFINED, this.constant(this.undefinedMessage(name, options)));\\n  }\\n\\n  load(name, at) \{\\n    const found = this.resolve(name);\\n    if (found) this.emit(at, GET, ...found, this.constant(name));\\n    else this.undefinedName(name, at);\\n  }\\n\\n  store(name, at) \{\\n    this.emit(at, SET, ...this.resolve(name)); // always found: declarations() saw every name that is stored\\n  }\\n\\n  // `state` is how many values the loop keeps on the stack while it runs, which a `stop` takes off\\n  loop(s, next, state) \{\\n    const top = this.here();\\n    const exit = this.jump(s.at, next);\\n    if (s.name) this.store(s.name, s.at);\\n    this.mark(s); // every round pauses on the loop's line, after the loop variable has its new value\\n    this.body(s.body, state);\\n    this.jump(s.at, JUMP, top);\\n    this.patch(exit);\\n    this.patchStops();\\n  }\\n\\n  body(statements, state) \{\\n    this.loops.push(\{ state, stops: [], tries: this.tries });\\n    for (const inner of statements) this.statement(inner);\\n  }\\n\\n  patchStops() \{\\n    for (const i of this.loops.pop().stops) this.patch(i);\\n  }\\n\\n  call(e, statement = false) \{\\n    const found = this.resolve(e.name);\\n    if (found) this.emit(e.at, GET_FN, ...found, this.constant(e.name));\\n    else this.undefinedName(e.name, e.at, \{ call: true, statement });\\n    for (const arg of e.args) this.expr(arg);\\n    this.emit(e.at, CALL, e.args.length, this.constant(e.name));\\n  }\\n\\n  statement(s) \{\\n    if (!LOOPS.has(s.kind)) this.mark(s); // loops mark each round instead\\n    switch (s.kind) \{\\n      case \\\"set\\\":\\n        this.expr(s.value);\\n        this.store(s.name, s.at);\\n        return;\\n      case \\\"setItem\\\":\\n        this.expr(s.target.of);\\n        this.expr(s.target.index);\\n        this.emit(s.target.at, ITEM_REF);\\n        this.expr(s.value);\\n        this.emit(s.target.at, SET_ITEM); // fails if the value can't go there, like 300 in a byte\\n        return;\\n      case \\\"add\\\": \{\\n        this.expr(s.value);\\n        const found = this.resolve(s.name);\\n        if (found) this.emit(s.at, ADD_TO, ...found, this.constant(s.name));\\n        else this.undefinedName(s.name, s.at);\\n        return;\\n      }\\n      case \\\"say\\\":\\n        for (const part of s.parts) this.expr(part);\\n        this.emit(s.at, s.errors ? SAY_ERROR : SAY, s.parts.length);\\n        return;\\n      case \\\"exit\\\":\\n        if (s.value) this.expr(s.value);\\n        else this.emit(s.at, CONST, this.constant(0));\\n        this.emit(s.at, EXIT);\\n        return;\\n      case \\\"if\\\": \{\\n        this.expr(s.cond);\\n        const toElse = this.jump(s.at, JUMP_IF_FALSE);\\n        for (const inner of s.then) this.statement(inner);\\n        const toEnd = this.jump(s.at, JUMP);\\n        this.patch(toElse);\\n        for (const inner of s.otherwise) this.statement(inner);\\n        this.patch(toEnd);\\n        return;\\n      }\\n      case \\\"while\\\": \{\\n        const top = this.here();\\n        this.mark(s);\\n        this.expr(s.cond);\\n        const exit = this.jump(s.at, JUMP_IF_FALSE);\\n        this.body(s.body, 0);\\n        this.jump(s.at, JUMP, top);\\n        this.patch(exit);\\n        this.patchStops();\\n        return;\\n      }\\n      case \\\"repeat\\\":\\n        this.expr(s.count);\\n        this.emit(s.at, CHECK_REPEAT);\\n        this.loop(s, REPEAT_NEXT, 1);\\n        return;\\n      case \\\"count\\\":\\n        this.expr(s.from);\\n        this.expr(s.to);\\n        this.emit(s.at, CHECK_RANGE);\\n        this.loop(s, RANGE_NEXT, 2);\\n        return;\\n      case \\\"each\\\":\\n        this.expr(s.list);\\n        this.emit(s.at, ITER);\\n        this.loop(s, ITER_NEXT, 1);\\n        return;\\n      case \\\"define\\\": \{\\n        const fn = new Compiler(this, s.name, s.params, s.body).fn;\\n        if (s.kinds.some((k) => k >= 0)) fn.kinds = s.kinds; // checked at each call (see checkKinds in vm.js)\\n        this.emit(s.at, MAKE_FN, this.constant(fn));\\n        this.store(s.name, s.at);\\n        return;\\n      }\\n      case \\\"when\\\": \{ // a handler is a function of its own, made and handed over, not kept in a variable\\n        const fn = new Compiler(this, s.fn.name, s.fn.params, s.fn.body).fn;\\n        if (s.label) this.expr(s.label); // the button or text box it waits for, under it\\n        this.emit(s.at, MAKE_FN, this.constant(fn));\\n        this.emit(s.at, HANDLE, EVENTS.indexOf(s.event));\\n        return;\\n      }\\n      case \\\"every\\\": \{\\n        const fn = new Compiler(this, s.fn.name, s.fn.params, s.fn.body).fn;\\n        this.expr(s.interval);\\n        this.emit(s.at, MAKE_FN, this.constant(fn));\\n        this.emit(s.at, EVERY, s.unit);\\n        return;\\n      }\\n      case \\\"return\\\":\\n        if (s.value) this.expr(s.value);\\n        else this.emit(s.at, CONST, this.constant(null));\\n        this.emit(s.at, RETURN);\\n        return;\\n      case \\\"call\\\":\\n        this.call(s, true);\\n        this.emit(s.at, POP);\\n        return;\\n      case \\\"do\\\": // a value done for what it does: `start count(10)`, `wait for job`\\n        this.expr(s.value);\\n        this.emit(s.at, POP);\\n        return;\\n      case \\\"turtle\\\":\\n        if (s.value) this.expr(s.value);\\n        this.emit(s.at, TURTLE, TURTLE_ACTIONS.indexOf(s.action));\\n        return;\\n      case \\\"setField\\\": // the record is checked before the value is worked out, as `set item` does\\n        this.expr(s.target);\\n        this.emit(s.at, RECORD_REF, this.constant(s.name));\\n        this.expr(s.value);\\n        this.emit(s.at, SET_FIELD, this.constant(s.name));\\n        return;\\n      case \\\"fail\\\":\\n        this.expr(s.value);\\n        this.emit(s.at, FAIL);\\n        return;\\n      case \\\"remove\\\":\\n        this.expr(s.key);\\n        this.expr(s.target);\\n        this.emit(s.at, REMOVE);\\n        return;\\n      case \\\"write\\\":\\n        this.expr(s.value);\\n        this.expr(s.target);\\n        this.emit(s.at, WRITE);\\n        return;\\n      case \\\"removeFile\\\":\\n        this.expr(s.target);\\n        this.emit(s.at, REMOVE_FILE);\\n        return;\\n      case \\\"wait\\\":\\n        this.expr(s.amount);\\n        this.emit(s.at, WAIT, s.unit);\\n        return;\\n      case \\\"play\\\": // the note, then how long, unless it's a beep\\n        if (s.note) \{\\n          this.expr(s.note);\\n          this.expr(s.time);\\n        }\\n        this.emit(s.at, PLAY, s.unit);\\n        return;\\n      case \\\"expect\\\": // a comparison keeps both its sides, to say what they were\\n        if (s.cond.kind === \\\"compare\\\") \{\\n          this.expr(s.cond.left);\\n          this.expr(s.cond.right);\\n          this.emit(s.at, EXPECT, COMPARE_OPS.indexOf(s.cond.op), s.cond.negate ? 1 : 0);\\n        } else \{\\n          this.expr(s.cond);\\n          this.emit(s.at, EXPECT, -1, 0);\\n        }\\n        return;\\n      case \\\"try\\\": \{\\n        const handler = this.jump(s.at, TRY);\\n        this.tries++;\\n        for (const inner of s.body) this.statement(inner);\\n        this.tries--;\\n        this.emit(s.at, END_TRY);\\n        const end = this.jump(s.at, JUMP);\\n        this.patch(handler);\\n        this.emit(s.at, CAUGHT);\\n        if (s.name) this.store(s.name, s.at);\\n        else this.emit(s.at, POP);\\n        for (const inner of s.handler) this.statement(inner);\\n        this.patch(end);\\n        return;\\n      }\\n      case \\\"stop\\\": \{ // leave the tries inside the loop, take its own values off the stack, and jump to its end\\n        const loop = this.loops.at(-1);\\n        for (let i = loop.tries; i < this.tries; i++) this.emit(s.at, END_TRY);\\n        for (let i = 0; i < loop.state; i++) this.emit(s.at, POP);\\n        loop.stops.push(this.jump(s.at, JUMP));\\n        return;\\n      }\\n    }\\n  }\\n\\n  expr(e) \{\\n    switch (e.kind) \{\\n      case \\\"value\\\":\\n        this.emit(e.at, CONST, this.constant(e.value));\\n        return;\\n      case \\\"name\\\":\\n        this.load(e.name, e.at);\\n        return;\\n      case \\\"call\\\":\\n        this.call(e);\\n        return;\\n      case \\\"math\\\":\\n        this.expr(e.left);\\n        this.expr(e.right);\\n        this.emit(e.at, MATH_OPS[e.op]);\\n        return;\\n      case \\\"compare\\\":\\n        this.expr(e.left);\\n        this.expr(e.right);\\n        this.emit(e.at, COMPARE, COMPARE_OPS.indexOf(e.op));\\n        if (e.negate) this.emit(e.at, NOT);\\n        return;\\n      case \\\"and\\\":\\n      case \\\"or\\\": \{\\n        this.expr(e.left);\\n        const end = this.jump(e.at, e.kind === \\\"and\\\" ? AND : OR);\\n        this.expr(e.right);\\n        this.patch(end);\\n        return;\\n      }\\n      case \\\"not\\\":\\n        this.expr(e.operand);\\n        this.emit(e.at, NOT);\\n        return;\\n      case \\\"negate\\\":\\n        this.expr(e.operand);\\n        this.emit(e.at, NEG);\\n        return;\\n      case \\\"list\\\":\\n        for (const item of e.items) this.expr(item);\\n        this.emit(e.at, LIST, e.items.length);\\n        return;\\n      case \\\"length\\\":\\n        this.expr(e.of);\\n        this.emit(e.at, LENGTH);\\n        return;\\n      case \\\"item\\\":\\n        this.expr(e.of);\\n        this.expr(e.index);\\n        this.emit(e.at, ITEM);\\n        return;\\n      case \\\"record\\\":\\n        for (const value of e.values) this.expr(value);\\n        this.emit(e.at, RECORD, this.constant(e.fields));\\n        return;\\n      case \\\"dictionary\\\":\\n        for (const x of e.items) this.expr(x);\\n        this.emit(e.at, DICT, e.items.length);\\n        return;\\n      case \\\"field\\\":\\n        this.expr(e.of);\\n        this.emit(e.at, FIELD, this.constant(e.name));\\n        return;\\n      case \\\"ask\\\":\\n        this.expr(e.question);\\n        this.emit(e.at, ASK);\\n        return;\\n      case \\\"read\\\":\\n        this.expr(e.of);\\n        this.emit(e.at, READ, e.bytes ? 1 : 0);\\n        return;\\n      case \\\"readFolder\\\":\\n        this.expr(e.of);\\n        this.emit(e.at, READ_FOLDER);\\n        return;\\n      case \\\"arguments\\\":\\n        this.emit(e.at, ARGUMENTS);\\n        return;\\n      case \\\"random\\\":\\n        this.expr(e.left);\\n        this.expr(e.right);\\n        this.emit(e.at, RANDOM);\\n        return;\\n      case \\\"now\\\":\\n        this.emit(e.at, NOW, e.which);\\n        return;\\n      case \\\"builtin\\\":\\n        if (e.name === \\\"start worker\\\") \{ // the call, made on copies (see WORKER in vm.js)\\n          const call = e.args[0];\\n          const found = this.resolve(call.name);\\n          if (found) this.emit(call.at, GET_FN, ...found, this.constant(call.name));\\n          else this.undefinedName(call.name, call.at, \{ call: true });\\n          for (const arg of call.args) this.expr(arg);\\n          this.emit(call.at, WORKER, call.args.length, this.constant(call.name));\\n          return;\\n        }\\n        for (const arg of e.args) this.expr(arg);\\n        this.emit(e.at, BUILTIN, BUILTINS.findIndex((b) => b.name === e.name));\\n        return;\\n    }\\n  }\\n}\\n\\n// ---------- reading bytecode ----------\\n\\nconst shown = (v) => (v === null ? \\\"nothing\\\" : typeof v === \\\"boolean\\\" ? (v ? \\\"yes\\\" : \\\"no\\\") : JSON.stringify(v));\\n\\n// What an instruction's operands mean, where a number alone wouldn't say.\\nfunction note(fn, op, args, scopes) \{\\n  switch (op) \{\\n    case \\\"SET\\\": return scopes.at(-1 - args[0]).names[args[1]];\\n    case \\\"LINE\\\": return `line $\{args[0]}`;\\n    case \\\"CONST\\\": return shown(fn.consts[args[0]]);\\n    case \\\"MAKE_FN\\\": return `function $\{fn.consts[args[0]].name}`;\\n    case \\\"GET\\\": case \\\"GET_FN\\\": case \\\"ADD_TO\\\": return fn.consts[args[2]];\\n    case \\\"CALL\\\": return fn.consts[args[1]];\\n    case \\\"UNDEFINED\\\": return fn.consts[args[0]];\\n    case \\\"COMPARE\\\": return args[0] ? `is $\{COMPARE_OPS[args[0]]}` : \\\"is\\\";\\n    case \\\"RECORD\\\": return fn.consts[args[0]].join(\\\", \\\");\\n    case \\\"FIELD\\\": case \\\"RECORD_REF\\\": case \\\"SET_FIELD\\\": return fn.consts[args[0]];\\n    case \\\"BUILTIN\\\": return BUILTINS[args[0]].name;\\n    default: return \\\"\\\";\\n  }\\n}\\n\\n// Bytecode as readable text, for `folio bytecode` and the playground.\\nexport function disassemble(fn, scopes = [fn], out = []) \{\\n  const inputs = fn.params.map((p, i) => (fn.kinds?.[i] >= 0 ? `$\{p} as $\{KINDS[fn.kinds[i]]}` : p));\\n  out.push(`$\{fn.name}$\{inputs.length ? ` with $\{inputs.join(\\\", \\\")}` : \\\"\\\"}:`);\\n  for (let i = 0; i < fn.code.length; ) \{\\n    const [op, count] = OPCODES[fn.code[i]];\\n    const args = fn.code.slice(i + 1, i + 1 + count);\\n    const why = note(fn, op, args, scopes);\\n    out.push(`  $\{String(i).padStart(4)}  $\{op.padEnd(13)} $\{args.join(\\\" \\\").padEnd(8)}$\{why ? ` ; $\{why}` : \\\"\\\"}`.trimEnd());\\n    i += 1 + count;\\n  }\\n  for (const c of fn.consts) if (c?.code) disassemble(c, [...scopes, c], out); // functions made inside this one\\n  return out.join(\\\"\\\\n\\\");\\n}\\n\\n// ---------- running ----------\\n\\n// Parses the source and hands the syntax tree to a back end.\\n// `files` gives the text of a file the program uses, by name, and `file` is the program's own name, if it has one.\\nfunction build(source, backEnd, \{ files, file } = \{}) \{\\n  try \{\\n    return backEnd(parse(tokenize(source), \{ files, loaded: new Set(file ? [file] : []), open: file ? [file] : [] }));\\n  } catch (err) \{\\n    // shortcut: points at line 1, since the overflow hides where the nesting was; only ~1,000 levels of brackets get here\\n    if (ranOut(err)) fail(\{ line: 1, col: 1 }, \\\"the code is nested too deeply\\\");\\n    throw err;\\n  }\\n}\\n\\n// The stack ran out reading or compiling a program: past the depth the JIT keeps to (TooDeep), or past\\n// JavaScript's own stack (a RangeError, or Firefox's InternalError), as ~1,000 levels of nesting can. Every front\\n// end makes that the same mistake, never a JavaScript error (DESIGN §152).\\nconst ranOut = (err) => err instanceof TooDeep || err instanceof RangeError || err?.name === \\\"InternalError\\\";\\n\\n// Compiles Folio source to bytecode for vm.js. Options: `slots` carries over the top-level variables of\\n// earlier shell entries; `debug` adds LINE markers so a debugger can pause at each statement.\\nexport function compile(source, options) \{\\n  return build(source, (program) => new Compiler(null, \\\"main\\\", [], program, options).fn, options);\\n}\\n\\n// Compiles Folio source to JavaScript (jit.js): \{ source, run(print, draw, maxSteps) }.\\nexport function compileToJs(source, options) \{\\n  return build(source, jit, options);\\n}\\n\\n// Compiles Folio source to a WebAssembly module (wasm.js): \{ bytes, listing, run(print, draw, maxSteps) }.\\nexport function compileToWasm(source, options) \{\\n  return build(source, wasm, options);\\n}\\n\\n// The same module's bytes and a readable listing, without compiling it (which a browser page may only do\\n// for small modules unless it waits): \{ bytes, listing }.\\nexport function compileToWasmBytes(source, options) \{\\n  return build(source, compileToWasmModule, options);\\n}\\n\\n// Problems found without running the program (checker.js): [\{ line, col, kind, message }]. Code that\\n// can't even be read comes back as a single problem of kind \\\"error\\\".\\nexport function check(source, options) \{\\n  try \{\\n    return build(source, checkProgram, options);\\n  } catch (err) \{\\n    if (!(err instanceof FolioError)) throw err;\\n    return [\{ line: err.line, col: err.col, kind: \\\"error\\\", message: err.reason, ...(err.file && \{ file: err.file }) }];\\n  }\\n}\\n\\n// ---------- fixing ----------\\n\\n// symbols from other languages, and the Folio words that mean the same (`=` alone could mean set or is, and `%`\\n// a remainder, so those get no fix)\\nconst SYMBOL_FIXES = \{ \\\"<=\\\": \\\"is at most\\\", \\\">=\\\": \\\"is at least\\\", \\\"!=\\\": \\\"is not\\\", \\\"==\\\": \\\"is\\\", \\\"<\\\": \\\"is less than\\\", \\\">\\\": \\\"is greater than\\\" };\\n\\n// The fix a mistake points to, for a Fix button: a misspelled name (\\\"'totl' has no value yet. Did you mean\\n// 'total'?\\\") becomes the name it meant, and a symbol from another language (`>`) the Folio words for it. Gives\\n// \{ line, col, length, text } (put `text` in place of `length` characters at line:col), or null. It checks the\\n// code really has the misspelling at that spot, so a fix can't land anywhere else.\\nexport function suggestedFix(source, \{ line, col, reason }) \{\\n  const text = source.split(/\\\\r?\\\\n/)[line - 1];\\n  if (text === undefined || !reason) return null;\\n  const at = col - 1;\\n  const meant = reason.match(/\\\\. Did you mean '([^' ]+)'\\\\?$/);\\n  const wrong = reason.match(/^(?:there is no function called |this record has no )?'([^' ]+)'/);\\n  if (meant && wrong) \{\\n    const name = wrong[1];\\n    const written = text.slice(at, at + name.length);\\n    if (written.toLowerCase() === name && !/\\\\w/.test(text[at + name.length] ?? \\\"\\\") && !/\\\\w/.test(text[at - 1] ?? \\\"\\\")) \{\\n      return \{ line, col, length: name.length, text: meant[1] };\\n    }\\n  }\\n  if (/^I don't understand '[<>!=]'/.test(reason)) \{\\n    const symbol = [text.slice(at, at + 2), text[at]].find((s) => Object.hasOwn(SYMBOL_FIXES, s));\\n    if (symbol) return \{ line, col, length: symbol.length, text: SYMBOL_FIXES[symbol] };\\n  }\\n  return null;\\n}\\n\\n// ---------- tidying ----------\\n\\n// One line of code as its pieces, as written, and its comment: [\{ type, text, col }], comment or null.\\nfunction piecesOf(line) \{\\n  const pieces = [];\\n  for (let at = 0; at < line.length; at = TOKEN.lastIndex) \{\\n    TOKEN.lastIndex = at;\\n    let [text, space, comment, number, word, string] = TOKEN.exec(line);\\n    if (comment) return \{ pieces, comment: text.trimEnd(), commentCol: at };\\n    if (space) continue;\\n    if (string) \{\\n      text = line.slice(at, textEnd(line, at).end); // the parser read it already, so it ends\\n      TOKEN.lastIndex = at + text.length;\\n    }\\n    pieces.push(\{ type: number ? \\\"number\\\" : word ? \\\"word\\\" : string ? \\\"string\\\" : text, text, col: at + 1, end: at + text.length });\\n  }\\n  return \{ pieces, comment: null };\\n}\\n\\n// The pieces of line `line` joined the one way Folio writes them: a space between each, but none inside\\n// brackets, before a comma or 's, before a call's bracket, or after a minus that makes a number negative.\\n// `tight` holds those brackets and minuses, which only the parser can tell from the others.\\nfunction joined(pieces, line, tight) \{\\n  let out = \\\"\\\";\\n  pieces.forEach((p, i) => \{\\n    const before = pieces[i - 1];\\n    const marked = (q) => tight.has(`$\{line}:$\{q.col}`);\\n    const close = !before || before.type === \\\"(\\\" || p.type === \\\")\\\" || p.type === \\\",\\\" || p.type === \\\"'s\\\"\\n      || (before.type === \\\"-\\\" && marked(before)) || (p.type === \\\"(\\\" && marked(p));\\n    out += (close ? \\\"\\\" : \\\" \\\") + p.text;\\n  });\\n  return out;\\n}\\n\\n// Folio code, tidied: each line indented 4 spaces for each block it's in (and 4 more if it carries on a\\n// statement from the line before), single spaces between the pieces of a line, comments kept where they\\n// are, at most one blank line in a row, and one new line at the end. The parser says where each statement\\n// starts and how deep, so nothing is guessed. Only code that can be read is tidied (a mistake throws, as in\\n// compile()), and the result must read exactly the same, piece for piece.\\nexport function format(source) \{\\n  const [layout, tight] = [new Map(), new Set()];\\n  try \{\\n    parse(tokenize(source), \{ files: () => \\\"\\\", loaded: new Set(), open: [], layout, tight }); // what a used file holds doesn't matter here\\n  } catch (err) \{\\n    if (ranOut(err)) fail(\{ line: 1, col: 1 }, \\\"the code is nested too deeply\\\");\\n    throw err;\\n  }\\n  const tidy = [];\\n  let indent = 0; // the indent of the statement being written, for the lines that carry it on\\n  let waiting = []; // lines with only a comment, which take the indent of the code after them\\n  source.split(\\\"\\\\n\\\").forEach((line, i) => \{\\n    const \{ pieces, comment, commentCol } = piecesOf(line);\\n    if (!pieces.length) \{\\n      if (comment) waiting.push(tidy.push(comment) - 1);\\n      else if (tidy.length && tidy.at(-1) !== \\\"\\\") tidy.push(\\\"\\\");\\n      return;\\n    }\\n    const depth = layout.get(`$\{i + 1}:$\{pieces[0].col}`);\\n    const here = depth === undefined ? indent + 4 : depth * 4;\\n    if (depth !== undefined) indent = here;\\n    // a comment just before an end, else or if it fails belongs to the block it closes\\n    const closing = /^(end|else)$/i.test(pieces[0].text) || pieces.slice(0, 3).map((p) => p.text.toLowerCase()).join(\\\" \\\") === \\\"if it fails\\\"\\n      || pieces.slice(0, 2).map((p) => p.text.toLowerCase()).join(\\\" \\\") === \\\"either way\\\";\\n    for (const at of waiting) tidy[at] = \\\" \\\".repeat(closing ? here + 4 : here) + tidy[at];\\n    waiting = [];\\n    let text = \\\" \\\".repeat(here) + joined(pieces, i + 1, tight);\\n    if (comment) text += \\\" \\\".repeat(Math.max(1, commentCol - pieces.at(-1).end)) + comment;\\n    tidy.push(text);\\n  });\\n  while (tidy.at(-1) === \\\"\\\") tidy.pop();\\n  const result = tidy.length ? `$\{tidy.join(\\\"\\\\n\\\")}\\\\n` : \\\"\\\";\\n  const same = (a, b) => a.length === b.length && a.every((t, i) => t.type === b[i].type && t.value === b[i].value);\\n  if (!same(tokenize(source), tokenize(result))) throw new Error(\\\"tidying would have changed the code\\\"); // a bug in format(), never a mistake in the code\\n  return result;\\n}\\n\\n// Runs a Folio program. Each `say` line goes to `print` (or to `printError`, said to the error output), each\\n// line the turtle draws to `draw`, and each `ask` to `ask`, which returns the answer (see askFor in vm.js);\\n// mistakes in the program throw FolioError. `stop the program with 2` ends the run, and `exit` gets the 2.\\n// `maxSteps` stops loops and calls after that many rounds, for running untrusted code without a Stop button.\\n// `engine` is \\\"jit\\\" (compile to JavaScript), \\\"wasm\\\" (WebAssembly) or \\\"vm\\\" (bytecode). `files` and `file` are\\n// for `use` (see build). `disk` holds the files `read` and `write` use (see readFile in vm.js, and memoryDisk\\n// below), `args` is what `arguments` gives, `random` gives the random numbers (seeded() unless given), and\\n// `clock` the time and the waiting (fakeClock() unless given: see vm.js).\\n// A program that sets up handlers with `when` or `every` is an app: run() returns it, to be sent events.\\n// Each sound the program makes goes to `play`, as \{ hertz, seconds } (see soundOf in vm.js).\\n// `wasm`, with engine \\\"wasm\\\", compiles the program to a module another way: a function from the source to what\\n// compileToWasmModule gives, such as the one wasmFolioCompiler makes.\\nexport function run(source, print = console.log, \{ maxSteps = Infinity, draw, engine = \\\"jit\\\", ask, files, file, disk, args = [], random = seeded(), printError = console.error, exit, clock = fakeClock(), play, wasm: wasmModule } = \{}) \{\\n  const reading = \{ files, file };\\n  startTasks();\\n  // What the program got from outside, in order: each answer, each file it read, and how each write went.\\n  // Kept, so that running it again (below) gets the same, and writes nothing twice.\\n  const outside = [];\\n  const kept = (f) => (...inputs) => \{\\n    try \{\\n      const got = f(...inputs);\\n      outside.push(\{ got: copy(got) });\\n      return got;\\n    } catch (err) \{\\n      outside.push(\{ err });\\n      throw err;\\n    }\\n  };\\n  const answer = ask && kept(ask);\\n  const chance = kept(random);\\n  const timer = \{ now: kept(() => clock.now()), since: kept(() => clock.since()), sleep: kept((ms) => clock.sleep(ms)) };\\n  const drive = disk && \{ read: kept((name, asBytes, headers) => (headers ? disk.read(name, asBytes, headers) : disk.read(name, asBytes))),\\n    write: kept((name, data) => disk.write(name, data)), remove: disk.remove && kept((name) => disk.remove(name)),\\n    folder: disk.folder && kept((name) => disk.folder(name)), send: disk.send && kept((address, data, headers) => disk.send(address, data, headers)) };\\n  let program = null;\\n  if (engine !== \\\"vm\\\") \{\\n    try \{\\n      if (engine === \\\"wasm\\\") program = wasmModule ? wasmProgram(wasmModule(source)) : compileToWasm(source, reading);\\n      else program = compileToJs(source, reading);\\n    } catch (err) \{\\n      if (!(err instanceof EvalError)) throw err; // a page whose security policy forbids making code from text\\n    }\\n  }\\n  let said = 0;\\n  let complained = 0; // lines said to the error output\\n  let drawn = 0;\\n  let played = 0;\\n  // each handler an app has called so far, as [handler, inputs], and each event its picture's buttons and text\\n  // boxes have seen, as [event, inputs]: a run on the VM does them all again, in order\\n  const sent = [];\\n\\n  // The program on the VM. `again`: run from the start once more, as the JIT or WebAssembly engine handed it\\n  // over, getting everything from outside that the first run got, and passing on only what it hadn't said or\\n  // drawn already. The clock is from outside too, so a second run gets the same times, and doesn't wait again.\\n  function onVm(again) \{\\n    let [next, skipSaid, skipDrawn, skipComplained, skipPlayed] = [0, again ? said : 0, again ? drawn : 0, again ? complained : 0, again ? played : 0];\\n    const replay = (f) => f && (!again ? f : (...inputs) => \{\\n      if (next >= outside.length) \{ // past what the first run got: a call of its own, which is kept too, so not got again\\n        try \{\\n          return f(...inputs);\\n        } finally \{\\n          next = outside.length;\\n        }\\n      }\\n      const before = outside[next++];\\n      if (\\\"err\\\" in before) throw before.err;\\n      return copy(before.got);\\n    });\\n    const say = (line) => skipSaid-- > 0 || print(line);\\n    const options = \{\\n      maxSteps, ask: replay(answer), disk: drive && \{ read: replay(drive.read), write: replay(drive.write), remove: replay(drive.remove), folder: replay(drive.folder), send: replay(drive.send) }, args, random: replay(chance),\\n      clock: \{ now: replay(timer.now), since: replay(timer.since), sleep: replay(timer.sleep) },\\n      listeners: [], turtle: new Turtle((line) => skipDrawn-- > 0 || draw?.(line)), printError: (line) => skipComplained-- > 0 || printError(line),\\n      play: (sound) => skipPlayed-- > 0 || play?.(sound),\\n    };\\n    startTasks();\\n    new Machine(compile(source, reading), say, options).run();\\n    const host = \{ vm: true, handlers: options.listeners, call: (handler, inputs) => callFunction(handler.closure, inputs, say, options), turtle: options.turtle };\\n    for (const [i, inputs] of sent) typeof i === \\\"string\\\" ? host.turtle.route(i, inputs) : host.call(host.handlers[i], inputs);\\n    return host;\\n  }\\n\\n  // Calls went deeper than the JIT (or the WebAssembly engine) goes, or the stack ran out anyway, or a value\\n  // outgrew what JavaScript allows: the VM keeps its own stack, and reports a too-big value at the right line.\\n  const handOver = (err) => err instanceof TooDeep || err instanceof RangeError || err?.name === \\\"InternalError\\\";\\n  // `stop the program` ends it on purpose, not as a mistake: `exit` gets the number it ended with\\n  const ended = (err) => \{\\n    if (!(err instanceof Ended)) throw err;\\n    exit?.(err.code);\\n  };\\n  let host = \{ handlers: [] }; // the engine running the program, which fills in its handlers, how to call one, and its turtle\\n  try \{\\n    if (!program) host = onVm(false);\\n    else \{\\n      try \{\\n        // counted once passed on, so a hand-over in the middle of passing one on can't lose it\\n        program.run((line) => (print(line), said++), (line) => (draw?.(line), drawn++), maxSteps, answer, drive, args, chance, host,\\n          (line) => (printError(line), complained++), timer, (sound) => (play?.(sound), played++));\\n      } catch (err) \{\\n        if (!handOver(err)) throw err;\\n        host = onVm(true);\\n      }\\n    }\\n  } catch (err) \{\\n    ended(err);\\n    return undefined;\\n  }\\n  if (!host.handlers.length) return undefined;\\n\\n  // An app: what its handlers wait for, and a way to hand them events. Each handler call gets `maxSteps` of\\n  // its own, and a mistake in one throws, which ends the app. A handler that stops the program ends it too:\\n  // `stopped` is then the number it ended with, and events after it do nothing.\\n  const app = \{\\n    waits: host.handlers.map((\{ event, interval, label }) => (interval !== undefined ? \{ event, interval } : label !== undefined ? \{ event, label } : \{ event })),\\n    stopped: undefined,\\n    handle(i, inputs = []) \{\\n      if (app.stopped !== undefined) return;\\n      try \{\\n        try \{\\n          host.call(host.handlers[i], inputs);\\n        } catch (err) \{\\n          if (host.vm || !handOver(err)) throw err;\\n          host = onVm(true); // everything so far again, on the VM, then this event\\n          host.call(host.handlers[i], inputs);\\n        }\\n      } catch (err) \{\\n        if (!(err instanceof Ended)) throw err;\\n        app.stopped = err.code;\\n        exit?.(err.code);\\n      }\\n      sent.push([i, inputs]);\\n    },\\n    // every handler of this event, in the order the program made them: \\\"key\\\" with the key's name, \\\"click\\\"\\n    // and \\\"drag\\\" with x and y, and \\\"type\\\" with the text typed. The picture's buttons and text boxes see it\\n    // first (see route() in vm.js), and may take it: a click on a button goes to that button's handlers.\\n    send(event, inputs = []) \{\\n      if (app.stopped !== undefined) return;\\n      const [to, label, given] = host.turtle.route(event, inputs) ?? [];\\n      sent.push([event, inputs]);\\n      app.waits.forEach((wait, i) => wait.event === to && wait.label === label && app.handle(i, given));\\n    },\\n  };\\n  return app;\\n}\\nconst copy = (v) => (v instanceof Uint8Array ? v.slice() : v); // bytes a program read could be changed after\\n\\n// Runs a file's tests: each function at its top level named test_something, on its own, in a fresh run of\\n// the file, so one test can't spoil another. A mistake in it, like an `expect` that isn't so, fails it, and\\n// so does stopping the program with a number other than 0. A file with no tests is one test itself. Gives\\n// [\{ name, said, error, stopped }], `error` only for a test that failed with a mistake, whose trail leaves\\n// out the call that started the test, and `stopped` only for one that stopped the program with a number\\n// other than 0. Options as for run(); a file that can't be read at all throws, as in run().\\nexport function test(source, options = \{}) \{\\n  const program = build(source, (body) => body, options);\\n  const names = program.filter((s) => s.kind === \\\"define\\\" && s.name.startsWith(\\\"test_\\\")).map((s) => s.name);\\n  const last = source.split(\\\"\\\\n\\\").length; // the call that starts a test goes on the line after this one\\n  const one = (name) => \{\\n    const said = [];\\n    let stopped = 0;\\n    try \{\\n      run(name ? `$\{source}\\\\n$\{name}()` : source, (line) => said.push(line), \{ ...options, exit: (code) => (stopped = code) });\\n      return stopped ? \{ name, said, stopped } : \{ name, said };\\n    } catch (err) \{\\n      if (!(err instanceof FolioError)) throw err;\\n      err.trail = err.trail.filter((t) => t.file || t.line <= last);\\n      return \{ name, said, error: err };\\n    }\\n  };\\n  return names.length ? names.map(one) : [one(null)];\\n}\\n\\n// Files kept in memory, for a page or a test: `start` gives the first ones, by name, as text or bytes.\\nexport function memoryDisk(start = \{}) \{\\n  const files = new Map(Object.entries(start));\\n  const sent = [];\\n  return \{\\n    files,\\n    // what was sent to a site, each \{ address, data, headers }; a site's reply is the file of its address\\n    sent,\\n    send: (address, data, headers) => \{\\n      sent.push(\{ address, data, headers });\\n      if (!files.has(address)) throw new Error(\\\"couldn't reach it\\\");\\n      const reply = files.get(address);\\n      return typeof reply === \\\"string\\\" ? reply : new TextDecoder().decode(reply);\\n    },\\n    read: (name, asBytes) => \{\\n      if (!files.has(name)) return null;\\n      const data = files.get(name);\\n      if (asBytes) return typeof data === \\\"string\\\" ? new TextEncoder().encode(data) : data.slice();\\n      return typeof data === \\\"string\\\" ? data : new TextDecoder().decode(data);\\n    },\\n    write: (name, data) => void files.set(name, data),\\n    remove: (name) => files.delete(name),\\n    // what is in a folder: the files and folders whose names start with its name and a /, where // is / and\\n    // ./ at the start is nothing; the top is \\\".\\\" or \\\"\\\"\\n    folder: (name) => \{\\n      const path = name.replace(/\\\\/+/g, \\\"/\\\").replace(/^(\\\\.\\\\/)+/, \\\"\\\").replace(/\\\\/$/, \\\"\\\");\\n      const top = path === \\\".\\\" || path === \\\"\\\";\\n      const start = top ? \\\"\\\" : `$\{path}/`;\\n      const found = new Set();\\n      for (const file of files.keys()) \{\\n        if (!file.startsWith(start)) continue;\\n        const rest = file.slice(start.length);\\n        const cut = rest.indexOf(\\\"/\\\");\\n        found.add(cut < 0 ? rest : rest.slice(0, cut + 1));\\n      }\\n      return found.size || top ? [...found] : null;\\n    },\\n  };\\n}\\n\\n// Runs a program and hands back what it made at the top level, by name; a Folio function comes back as a\\n// JavaScript function. This is how JavaScript drives code written in Folio, like Folio's own compiler.\\nexport function load(source, print = console.log) \{\\n  return loadProgram(compileToJs(source), print);\\n}\\n\\nfunction loadProgram(program, print = console.log) \{\\n  const values = program.run(print, undefined, Infinity);\\n  const made = Object.create(null); // a variable could be called __proto__\\n  program.names.forEach((name, slot) => \{\\n    const value = values[slot - 1];\\n    if (value !== UNSET) made[name] = value instanceof Closure ? (...args) => value.fn.run(...args) : value;\\n  });\\n  return made;\\n}\\n\\n// Folio's compiler written in Folio (compiler.folio): give it that file's text and get back a compiler that\\n// works like compileToJs(). `using` compiles compiler.folio itself: compileToJs() by default, or a compiler\\n// made by this function, which is how the tests show the compiler compiling itself.\\nexport function folioCompiler(compilerSource, using = compileToJs) \{\\n  const \{ compile } = loadProgram(using(compilerSource));\\n  return (source, files = \{}) => \{ // files: each file a program may use, by name\\n    let made;\\n    try \{\\n      made = compile(source, Object.entries(files).map(([name, text]) => makeRecord([\\\"name\\\", \\\"text\\\"], [name, text])));\\n    } catch (err) \{\\n      // a mistake in the program it compiles comes back as `fail with` a record of where and why\\n      if (err instanceof FolioError && isRecord(err.value) && Object.hasOwn(err.value, \\\"reason\\\")) fail(err.value.at, err.value.reason);\\n      if (ranOut(err)) fail(\{ line: 1, col: 1 }, \\\"the code is nested too deeply\\\");\\n      throw err;\\n    }\\n    const names = [];\\n    made.names.forEach((name, i) => (names[i + 1] = name)); // slot 1 is the first name, as in jit()\\n    return fromJs(made.js, made.ats, names);\\n  };\\n}\\n\\n// Folio's machine-code back end (machine.folio, which reads programs with compiler.folio): give it both files'\\n// text and get back a function that turns a program into the bytes of a program of its own, for `target`\\n// \\\"windows\\\" (a PE .exe) or \\\"linux\\\" (an ELF executable). `files` are the files the program uses, by name,\\n// `name` is the program's own, for its mistakes, and `allow` the --allow flags built into it, which say what it\\n// may do without asking.\\nexport function machineCompiler(machineSource, compilerSource) \{\\n  const \{ compile_shipping: compileMachine, compile_debugging: compileDebugging, compile_library: compileLibrary, library_header: libraryHeader } = loadProgram(compileToJs(machineSource, \{ files: (name) => (name === \\\"compiler.folio\\\" ? compilerSource : undefined), file: \\\"machine.folio\\\" }));\\n  // `icon`, an .ico or .png file's bytes, and `version`, as \\\"1.2.0\\\", for a Windows program; `include`, files built\\n  // into the program, as \{ \\\"logo.png\\\": bytes }, which its `read`s find there first; `debug`, a build for `folio debug`,\\n  // which needs the debugger, folio-debugger.folio, among the files; `library`, a shared library of the program's\\n  // functions for C (DESIGN §129), and `header`, the C header for one, as text\\n  return (source, \{ files = \{}, target, name = \\\"program.folio\\\", allow = [], icon = null, version = null, include = \{}, debug = false, library = false, header = false } = \{}) => \{\\n    try \{\\n      if (header) return libraryHeader(source, Object.keys(files), Object.values(files), name);\\n      if (library) return Uint8Array.from(compileLibrary(source, Object.keys(files), Object.values(files), target, name, allow));\\n      if (debug) return Uint8Array.from(compileDebugging(source, Object.keys(files), Object.values(files), target, name, allow));\\n      return Uint8Array.from(compileMachine(source, Object.keys(files), Object.values(files), target, name, allow, icon, version,\\n        Object.keys(include), Object.values(include).map((b) => Uint8Array.from(b))));\\n    } catch (err) \{\\n      if (err instanceof FolioError && isRecord(err.value) && Object.hasOwn(err.value, \\\"reason\\\")) fail(err.value.at, err.value.reason);\\n      if (ranOut(err)) fail(\{ line: 1, col: 1 }, \\\"the code is nested too deeply\\\");\\n      throw err;\\n    }\\n  };\\n}\\n\\n// Runs a module `folio build --target wasm` made, from its bytes, with run()'s options. With no source to hand to the\\n// VM, calls more than 2,000 deep are a mistake here, and an app's handlers aren't called.\\nexport function runWasm(bytes, print = console.log, \{ maxSteps = Infinity, draw, ask, disk, args = [], random = seeded(), printError = console.error, exit, clock = fakeClock(), play } = \{}) \{\\n  startTasks();\\n  const timer = \{ now: () => clock.now(), since: () => clock.since(), sleep: (ms) => clock.sleep(ms) };\\n  try \{\\n    wasmFile(bytes).run(print, draw, maxSteps, ask, disk, args, random, \{ handlers: [] }, printError, timer, play);\\n  } catch (err) \{\\n    if (err instanceof TooDeep) fail(\{ line: 1, col: 1 }, \\\"calls went more than 2,000 deep, which a module made by folio build --target wasm can't go yet\\\");\\n    if (!(err instanceof Ended)) throw err;\\n    exit?.(err.code);\\n  }\\n}\\n\\n// Folio's WebAssembly back end written in Folio (wasm.folio, which reads programs with compiler.folio, and the shared\\n// part of its runtime from wasm-runtime.folio): give it the three files' text and get back a function that turns\\n// a program, and the files it uses (\{ \\\"name.folio\\\": text }), into what compileToWasmModule in wasm.js gives:\\n// \{ bytes, ats, names, kinds }, the same bytes and all.\\nexport function wasmFolioCompiler(wasmSource, compilerSource, runtimeSource) \{\\n  const used = \{ \\\"compiler.folio\\\": compilerSource, \\\"wasm-runtime.folio\\\": runtimeSource };\\n  const \{ wasm_compile: compileWasm } = loadProgram(compileToJs(wasmSource, \{ files: (name) => used[name], file: \\\"wasm.folio\\\" }));\\n  return (source, files = \{}) => \{\\n    try \{\\n      const made = compileWasm(source, Object.keys(files), Object.values(files));\\n      // a position as folio.js's tokens have one: the program's own file is no file\\n      const ats = made.ats.map((at) => (\{ type: at.type, line: at.line, col: at.col, file: at.file || undefined }));\\n      return \{ bytes: Uint8Array.from(made.code), ats, names: made.names, kinds: made.kinds };\\n    } catch (err) \{\\n      if (err instanceof FolioError && isRecord(err.value) && Object.hasOwn(err.value, \\\"reason\\\")) fail(err.value.at, err.value.reason);\\n      if (ranOut(err)) fail(\{ line: 1, col: 1 }, \\\"the code is nested too deeply\\\");\\n      throw err;\\n    }\\n  };\\n}\\n\\n// Folio's compiler as WebAssembly (folio.wasm, which make-folio-wasm.mjs makes; DESIGN §144): give it the module's\\n// bytes and get back a function that compiles a program, and the files it may use (\{ \\\"name.folio\\\": text }), as\\n// compileToWasmModule does: \{ bytes, ats, names, kinds }, and `whole`, the module with what running it\\n// needs in its section \\\"folio\\\", as folio build --target wasm writes it. A mistake in the program is a FolioError.\\nexport function folioWasmCompiler(bytes) \{\\n  const compiler = wasmFile(bytes);\\n  return (source, files = \{}) => \{\\n    const given = [source];\\n    for (const [name, text] of Object.entries(files)) given.push(name, text);\\n    const said = [];\\n    try \{\\n      compiler.run((line) => said.push(line), undefined, Infinity, undefined, undefined, given, seeded(), \{ handlers: [] }, (line) => said.push(line));\\n    } catch (err) \{\\n      if (ranOut(err)) fail(\{ line: 1, col: 1 }, \\\"the code is nested too deeply\\\");\\n      throw err;\\n    }\\n    const line = said.join(\\\"\\\\n\\\");\\n    if (line.startsWith(\\\"mistake \\\")) \{\\n      const why = JSON.parse(line.slice(8));\\n      if (why && typeof why === \\\"object\\\" && why.reason !== undefined) fail(\{ line: why.at.line, col: why.at.col, file: why.at.file || undefined }, why.reason);\\n      throw new Error(`folio.wasm: $\{typeof why === \\\"string\\\" ? why : line}`);\\n    }\\n    const whole = Uint8Array.from(line.split(\\\",\\\"), Number);\\n    return \{ ...wasmDetails(whole), whole };\\n  };\\n}\\n\\n// A paused program for a debugger: call run(\{ pauseAtLines: true }) to go to the next statement, and\\n// inspect() to see where it is and what its variables hold.\\nexport function debug(source, print = console.log, draw = undefined, ask = undefined, \{ files, file, disk, args, random, printError, clock } = \{}) \{\\n  startTasks();\\n  return new Machine(compile(source, \{ debug: true, files, file }), print, \{ draw, ask, disk, args, random, printError, clock });\\n}\\n\\n// A whole run, recorded for a time-travel debugger: at every statement, where the program was, what its\\n// variables held, and how many lines it had said and drawn by then. Recording stops after `limit` steps\\n// (`cut` is then true), so a loop that never ends can't run forever. A mistake ends it with an `error` step,\\n// and `stop the program` with a `done` one that says what it `stopped` with. `answers` answer its questions,\\n// in order, each shown after its question as a line of output; lines said to the error output are output too.\\nexport function timeline(source, \{ limit = 10_000, answers = [], files, file, disk, args, random, clock } = \{}) \{\\n  const said = [];\\n  const drawn = [];\\n  let asked = 0;\\n  const ask = (question) => \{\\n    if (asked >= answers.length) return null;\\n    said.push(`$\{question} $\{answers[asked]}`);\\n    return answers[asked++];\\n  };\\n  const machine = debug(source, (line) => said.push(line), (line) => drawn.push(line), ask, \{ files, file, disk, args, random, printError: (line) => said.push(line), clock });\\n  const steps = [];\\n  const snapshot = (extra) => steps.push(\{ ...machine.inspect(), said: said.length, drawn: drawn.length, ...extra });\\n  let cut = false;\\n  try \{\\n    for (;;) \{\\n      if (machine.run(\{ pauseAtLines: true }) === \\\"done\\\") \{\\n        snapshot(\{ done: true });\\n        break;\\n      }\\n      snapshot();\\n      if ((cut = steps.length >= limit)) break;\\n    }\\n  } catch (err) \{\\n    if (err instanceof Ended) snapshot(\{ done: true, stopped: err.code });\\n    else if (!(err instanceof FolioError)) throw err;\\n    else snapshot(\{ error: err }); // the variables as they were when it failed, since lists and values change in place\\n  }\\n  return \{ steps, said, drawn, cut };\\n}\\n\\n// A shell session: each entry runs with the variables and functions made by the entries before it.\\nexport function session(print = console.log, \{ files, disk } = \{}) \{\\n  const slots = new Map();\\n  const env = [null];\\n  return (source) => \{\\n    const main = compile(source, \{ slots, files });\\n    while (env.length <= main.nslots) env.push(UNSET); // room for the variables this entry adds\\n    execute(main, print, Infinity, env, undefined, disk);\\n  };\\n}\\n\",\"examples.js\":\"// Shown in the playground's example menu, and run by the tests.\\nexport default \{\\n  \\\"Spiral\\\": `# the turtle starts in the middle, facing up, and draws wherever it moves\\nset colors to list of \\\"tomato\\\", \\\"gold\\\", \\\"mediumseagreen\\\", \\\"dodgerblue\\\", \\\"orchid\\\"\\nset size to 1\\nrepeat 30 times\\n    for each color in colors\\n        pen color color\\n        move forward size\\n        turn right 73\\n        add 2.6 to size\\n    end\\nend`,\\n\\n  \\\"Tree\\\": `# a function that calls itself draws every branch\\nto branch with size\\n    if size is less than 6\\n        return\\n    end\\n    if size is less than 20\\n        pen color \\\"mediumseagreen\\\"\\n    else\\n        pen color \\\"sienna\\\"\\n    end\\n    pen width size / 8\\n    move forward size\\n    turn left 25\\n    branch size * 0.72\\n    turn right 50\\n    branch size * 0.72\\n    turn left 25\\n    pen up\\n    move back size\\n    pen down\\nend\\n\\npen up\\nmove back 220\\npen down\\nbranch 105`,\\n\\n  \\\"Hello\\\": `say \\\"Hello, world!\\\"\\nset name to \\\"Folio\\\"\\nsay \\\"My name is \\\" name \\\" and it has \\\" length of name \\\" letters.\\\"`,\\n\\n  \\\"Repeat\\\": `set stars to \\\"\\\"\\nrepeat 5 times\\n    add \\\"*\\\" to stars\\n    say stars\\nend`,\\n\\n  \\\"FizzBuzz\\\": `for each n from 1 to 15\\n    if n is divisible by 15\\n        say \\\"FizzBuzz\\\"\\n    else if n is divisible by 3\\n        say \\\"Fizz\\\"\\n    else if n is divisible by 5\\n        say \\\"Buzz\\\"\\n    else\\n        say n\\n    end\\nend`,\\n\\n  \\\"Lists\\\": `set fruits to list of \\\"apple\\\", \\\"banana\\\", \\\"cherry\\\"\\nadd \\\"mango\\\" to fruits\\n\\nfor each fruit in fruits\\n    say \\\"I like \\\" fruit\\nend\\n\\nsay \\\"That's \\\" length of fruits \\\" fruits, and the first is \\\" item 1 of fruits`,\\n\\n  \\\"Functions\\\": `to fib with n\\n    if n is less than 2\\n        return n\\n    end\\n    return fib(n - 1) + fib(n - 2)\\nend\\n\\nto greet with name\\n    say \\\"Hello, \\\" name \\\"!\\\"\\nend\\n\\ngreet \\\"Sam\\\"\\nsay \\\"fib(20) is \\\" fib(20)`,\\n\\n  \\\"Counter\\\": `# a function can remember the variables around it\\nto counter\\n    set count to 0\\n    to next\\n        add 1 to count\\n        return count\\n    end\\n    return next\\nend\\n\\nset tick to counter()\\ntick\\ntick\\nsay \\\"Ticked \\\" tick() \\\" times\\\"`,\\n\\n  \\\"Records\\\": `# a record keeps named values together\\nset sam to record with name \\\"Sam\\\", age 20\\nset ana to record with name \\\"Ana\\\", age 31\\nfor each person in list of sam, ana\\n    say name of person \\\" is \\\" age of person\\nend\\nset age of sam to 21\\nsay sam`,\\n\\n  \\\"Data\\\": `# numbers with units, a table worked out, and a chart\\nset trip to 5 km + 300 m\\nsay \\\"Trip: \\\" trip \\\", or \\\" trip in miles\\nsay \\\"Time: \\\" 2 hours + 45 minutes in minutes\\nsay \\\"0.1 + 0.2 is \\\" 0.1 + 0.2\\n\\n# a table is a list of records: read table \\\"steps.csv\\\" makes one from a file\\nset week to list of (record with day \\\"Mon\\\", steps 4200), (record with day \\\"Tue\\\", steps 8100),\\n    (record with day \\\"Wed\\\", steps 10500), (record with day \\\"Thu\\\", steps 6900)\\nfor each row in week where steps of row is at least 7000\\n    say day of row \\\" was a good day\\\"\\nend\\nsay \\\"Average: \\\" average of steps in week \\\" steps\\\"\\n\\nset by_day to empty dictionary\\nfor each row in week\\n    set item (day of row) of by_day to steps of row\\nend\\ndraw chart of by_day`,\\n\\n  \\\"Guess\\\": `# a guessing game: answer in the box under the output\\nset secret to 37\\nset tries to 0\\nrepeat while yes\\n    set guess to number of ask \\\"Guess my number (1 to 100):\\\"\\n    add 1 to tries\\n    if guess is secret\\n        say \\\"Yes! \\\" secret \\\" in \\\" tries \\\" tries\\\"\\n        stop\\n    else if guess is less than secret\\n        say \\\"Higher\\\"\\n    else\\n        say \\\"Lower\\\"\\n    end\\nend`,\\n\\n  \\\"Tune\\\": `# each sound starts when the one before it ends, and the program doesn't wait for them\\nsay \\\"Twinkle, twinkle, little star\\\"\\nset tune to list of \\\"C\\\", \\\"C\\\", \\\"G\\\", \\\"G\\\", \\\"A\\\", \\\"A\\\", \\\"G\\\", \\\"rest\\\", \\\"F\\\", \\\"F\\\", \\\"E\\\", \\\"E\\\", \\\"D\\\", \\\"D\\\", \\\"C\\\"\\nfor each pitch in tune\\n    play note pitch for 0.3 seconds\\nend\\nplay note 1046.5 for 600 milliseconds # a number is a pitch in hertz: this is a high C\\nplay a beep`,\\n\\n  \\\"Primes\\\": `set primes to empty list\\nfor each n from 2 to 50\\n    set prime to yes\\n    for each p in primes\\n        if n is divisible by p\\n            set prime to no\\n        end\\n    end\\n    if prime\\n        add n to primes\\n    end\\nend\\nsay \\\"Primes up to 50: \\\" primes`,\\n\\n  \\\"Errors\\\": `# mistakes get a clear message with the line number\\nset fruits to list of \\\"apple\\\", \\\"banana\\\"\\nsay item 5 of fruits`,\\n};\\n\",\"worker.js\":\"// Runs one Folio program off the page's main thread, so a loop that never ends can't freeze the page:\\n// the page just ends this worker when Stop is pressed. An app (a program with `when` or `every`) keeps the\\n// worker going after it has set up: the worker runs its timers, and the page sends it keys and clicks.\\n// A line said to the error output goes to the page as \{ error: line }, among the others, and `stop the\\n// program` ends the run (or the app) with the number it gave, which the page shows. Each sound goes to the\\n// page too, which plays them one after the other.\\nimport \{ run, memoryDisk, seeded, excerpt, describeTrail, FolioError, folioWasmCompiler, compileToWasmBytes } from \\\"./folio.js\\\";\\nimport \{ realClock } from \\\"./vm.js\\\";\\n\\n// shortcut: past these, output and drawing are dropped rather than paged; raise them if programs need more.\\n// Drawing counts from the last `clear`, so an app that draws every frame can go on for ever.\\nconst MAX_LINES = 10_000;\\nconst MAX_DRAWN = 100_000;\\nconst FASTEST = 10; // milliseconds: an `every` faster than this runs this often\\n// shortcut: a sound that would start more than this many seconds from now is dropped, so a loop that never\\n// stops making sounds can't fill the page; each counts as at least a hundredth of a second\\nconst SOUNDS_AHEAD = 600;\\n\\n// Thrown by `ask` when the page hasn't answered yet: this run stops, the page asks the person, and runs the\\n// program again from the start with every answer so far. It says and draws the same things up to there.\\nclass Waiting \{}\\n\\nlet app = null; // the running app, once the program has set it up\\nlet lines = [];\\nlet drawn = [];\\nlet played = [];\\nlet page = null; // the newest page the program showed (page.folio, DESIGN §145) since the last message\\nlet pages = 0; // pages shown this run\\nlet sent = 0;\\n// A picture drawn again and again (a game's sprite) goes to the page once: the drawing names it by number.\\nconst pictureIds = new Map();\\nlet pictures = []; // [number, image] for each picture drawn for the first time since the last message\\nconst pictureId = (image) => \{\\n  if (!pictureIds.has(image)) \{\\n    pictureIds.set(image, pictureIds.size);\\n    pictures.push([pictureIds.size - 1, image]);\\n  }\\n  return pictureIds.get(image);\\n};\\nconst flush = () => \{\\n  if (lines.length || drawn.length || played.length || page !== null) postMessage(\{ lines, drawn, pictures, played, page });\\n  lines = [];\\n  page = null;\\n  drawn = [];\\n  pictures = [];\\n  played = [];\\n  sent = performance.now();\\n};\\nlet soundsEnd = 0; // about when, by performance.now(), the page will have played every sound so far\\nconst due = () => performance.now() - sent > 50 && flush(); // stream while the program keeps running\\n\\nlet source = \\\"\\\";\\nlet files = \{};\\n// A mistake ends the program, or the app; anything else that goes wrong is Folio's own.\\n// A page's files are the ones picked or dropped on it (`start`, by name), and `write` makes more, for this\\n// run. `read \\\"https://...\\\"` reads a site, if the site lets pages read it; the browser keeps the program to\\n// what any page can do. What's written to \\\"<page>\\\" isn't kept: it's the page the program shows (page.folio).\\nfunction pageDisk(start) \{\\n  const files = memoryDisk(start);\\n  return \{\\n    read: (name, asBytes, headers = []) => \{\\n      if (!/^https?:\\\\/\\\\//i.test(name)) return files.read(name, asBytes);\\n      const request = new XMLHttpRequest(); // a worker may wait for it\\n      request.open(\\\"GET\\\", name, false);\\n      for (const [field, value] of headers) request.setRequestHeader(field, value);\\n      if (asBytes) request.overrideMimeType(\\\"text/plain; charset=x-user-defined\\\");\\n      try \{\\n        request.send();\\n      } catch \{\\n        throw new Error(\\\"couldn't reach it (the site may not let pages read it)\\\");\\n      }\\n      if (request.status === 0) throw new Error(\\\"couldn't reach it (the site may not let pages read it)\\\");\\n      if (request.status >= 400) throw new Error(`the site answered $\{request.status}`);\\n      if (!asBytes) return request.responseText;\\n      return Uint8Array.from(request.responseText, (c) => c.charCodeAt(0) & 0xff);\\n    },\\n    // `send`: POSTed, and the site's reply. A browser follows a move to another address by itself.\\n    send: (address, data, headers) => \{\\n      const request = new XMLHttpRequest();\\n      request.open(\\\"POST\\\", address, false);\\n      for (const [field, value] of headers) request.setRequestHeader(field, value);\\n      try \{\\n        request.send(data);\\n      } catch \{\\n        throw new Error(\\\"couldn't reach it (the site may not let pages send to it)\\\");\\n      }\\n      if (request.status === 0) throw new Error(\\\"couldn't reach it (the site may not let pages send to it)\\\");\\n      if (request.status >= 300) throw new Error(`the site answered $\{request.status}`);\\n      return request.responseText;\\n    },\\n    write: (name, data) => \{\\n      if (name !== \\\"<page>\\\") return files.write(name, data);\\n      page = typeof data === \\\"string\\\" ? data : new TextDecoder().decode(data);\\n      pages++;\\n      due();\\n    },\\n    remove: files.remove,\\n    folder: files.folder,\\n  };\\n}\\n\\nfunction failed(err) \{\\n  if (err instanceof Waiting) \{\\n    flush();\\n    postMessage(\{ error: \\\"Error: an app can't ask a question once it's running\\\" });\\n    app = null;\\n    return;\\n  }\\n  flush();\\n  const trail = err instanceof FolioError && err.trail.length ? `\\\\n$\{describeTrail(err.trail)}` : \\\"\\\"; // the calls that led there\\n  postMessage(\{\\n    error: err instanceof FolioError ? `Error: $\{err.message}\\\\n$\{excerpt(err.file ? files[err.file] ?? \\\"\\\" : source, err)}$\{trail}` : `Folio itself crashed: $\{err.message}`,\\n    mistake: err instanceof FolioError && !err.file ? \{ line: err.line, col: err.col, reason: err.reason } : undefined, // for a Fix button\\n  });\\n  app = null;\\n}\\n\\n// one event for the app: its handlers run, then what they said and drew goes to the page\\nfunction handle(run) \{\\n  if (!app) return;\\n  try \{\\n    run();\\n    flush();\\n    if (app.stopped !== undefined) \{ // a handler stopped the program: the app is over\\n      postMessage(\{ stopped: app.stopped });\\n      app = null;\\n    }\\n  } catch (err) \{\\n    failed(err);\\n  }\\n}\\n\\nonmessage = (\{ data }) => \{\\n  if (data.event) return handle(() => app.send(data.event, data.inputs)); // a key or a click, from the page\\n  (\{ source, files = \{} } = data);\\n  const \{ engine, answers = [], seed = 1, disk = \{}, folioWasm } = data;\\n  // On WebAssembly, the program is compiled by Folio's own compiler, folio.wasm (DESIGN §144), which the page has\\n  // compiled once and sends with each run; until it has, or where it couldn't fetch it, by wasm.js. A mistake\\n  // in the program is folio.wasm's to say; anything else that goes wrong in it, wasm.js compiles it after all.\\n  const folioCompiler = engine === \\\"wasm\\\" && folioWasm ? folioWasmCompiler(folioWasm) : null;\\n  const compiled = folioCompiler && ((text) => \{\\n    try \{\\n      return folioCompiler(text, files);\\n    } catch (err) \{\\n      if (err instanceof FolioError) throw err;\\n      return compileToWasmBytes(text, \{ files: (name) => files[name] });\\n    }\\n  });\\n  let said = 0;\\n  pages = 0;\\n  let total = 0;\\n  let pictured = 0; // drawn since the last clear\\n  let sounds = 0;\\n  const say = (line) => \{\\n    if (++said <= MAX_LINES) lines.push(line);\\n    else if (said === MAX_LINES + 1) lines.push(`(only the first $\{MAX_LINES.toLocaleString(\\\"en\\\")} lines are shown)`);\\n    due();\\n  };\\n  let stopped; // the number `stop the program` gave, if it ran\\n  const sayError = (line) => \{ // a line said to the error output, which the page shows in the colour of a mistake\\n    if (++said <= MAX_LINES) lines.push(\{ error: line });\\n    else if (said === MAX_LINES + 1) lines.push(`(only the first $\{MAX_LINES.toLocaleString(\\\"en\\\")} lines are shown)`);\\n    due();\\n  };\\n  let asked = 0;\\n  const ask = (question) => \{\\n    if (asked < answers.length) \{\\n      const \{ text, shown = text } = answers[asked++]; // a drawing is shown as \\\"(a drawing)\\\", not its points\\n      say(`$\{question} $\{shown}`); // the question and its answer, as a line of output\\n      return text;\\n    }\\n    if (app) throw new Waiting(); // too late to stop and ask\\n    flush();\\n    postMessage(\{ question });\\n    throw new Waiting();\\n  };\\n  const start = performance.now();\\n  const clock = realClock();\\n  try \{\\n    app = run(source, say, \{\\n      draw: (d) => \{\\n        total++;\\n        if (d.clear) pictured = 0;\\n        if (++pictured <= MAX_DRAWN) drawn.push(d.shape === \\\"picture\\\" ? \{ ...d, image: pictureId(d.image) } : d);\\n        due();\\n      },\\n      engine,\\n      ...(compiled && \{ wasm: compiled }),\\n      ask,\\n      files: (name) => files[name],\\n      disk: pageDisk(disk), // the files picked or dropped on the page, and what `write` makes, for this run\\n      random: seeded(seed), // the page picks a seed for each Run, so running again for an answer gets the same numbers\\n      clock: \{ ...clock, sleep: (ms) => (flush(), clock.sleep(ms)) }, // the real time; what was said and drawn shows before a wait\\n      printError: sayError,\\n      exit: (code) => (stopped = code),\\n      play: (sound) => \{\\n        sounds++;\\n        const now = performance.now();\\n        if (Math.max(soundsEnd, now) - now <= SOUNDS_AHEAD * 1000) \{\\n          soundsEnd = Math.max(soundsEnd, now) + 1000 * Math.max(sound.seconds, 0.01);\\n          played.push(sound);\\n        }\\n        due();\\n      },\\n    }) ?? null;\\n    flush();\\n    postMessage(\{ done: true, app: app?.waits, empty: said === 0 && total === 0 && sounds === 0 && pages === 0, ms: performance.now() - start, stopped, byFolioWasm: !!compiled });\\n    app?.waits.forEach((wait, i) => wait.event === \\\"every\\\" && setInterval(() => handle(() => app.handle(i)), Math.max(FASTEST, wait.interval)));\\n  } catch (err) \{\\n    if (err instanceof Waiting) return; // the page asks, and runs it again\\n    failed(err);\\n  }\\n};\\n\"};\n    const folioUrls = \{};\n    // a module of the engine's, made from its text the first time it's asked for, its imports made so too\n    function folioModule(name) \{\n      if (!folioUrls[name]) \{\n        const text = folioSources[name].replace(/from \"\\.\\/([\\w.-]+\\.js)\"/g, (_, used) => `from \"$\{folioModule(used)}\"`);\n        folioUrls[name] = URL.createObjectURL(new Blob([text], \{ type: \"text/javascript\" }));\n      }\n      return folioUrls[name];\n    }\n  </script>\n  <script type=\"module\">\n    const examples = (await import(folioModule(\"examples.js\"))).default;\n    const \{ run, compile, compileToJs, compileToWasmBytes, folioCompiler, disassemble, check, timeline, memoryDisk, format, seeded, excerpt, suggestedFix, FolioError, soundSamples, SOUND_RATE } = await import(folioModule(\"folio.js\"));\n\n    const $ = (id) => document.getElementById(id);\n    const [code, output, picker, stopButton, status] = [\"code\", \"output\", \"example\", \"stop\", \"status\"].map($);\n    let worker = null;\n    let trace = null; // the recorded run being debugged\n    let at = 0; // which of its steps is showing\n    let drawing = []; // what the program has drawn since its last `clear` (which stays first, so the view stays open)\n    let shownDrawn = 0; // how much it has drawn in all, counting what a `clear` wiped\n    let shownPlayed = 0; // how many sounds it has made, which a run after an answer makes again\n    let appRunning = false; // an app is running: its picture stays put, and takes keys and clicks\n    let appDraws = true; // the app has a picture: it isn't one that only waits for its page to be used\n\n    // Folio's own words, for colouring. Every piece of the code is escaped before it goes in as HTML,\n    // because the code can come from someone else's share link.\n    const WORDS = new Set((\"set add say if else end repeat while for to return and or not is yes no nothing list empty length item \"\n      + \"move turn pen record dictionary where remove keys byte bytes as hex binary shift bit xor read write arguments expect clear draw box circle button random when every milliseconds seconds pressed clicked dragged mouse key fail stop ask use try fails uppercase lowercase split join number position by times each in from with than at least most divisible by of forward back left right up down color width \"\n      + \"table total average largest smallest chart picture play note beep send json headers checkbox tick untick area showing choice ticked dropdown slider moved choose library gives package function power items rounded remainder divided without repeats\").split(\" \"));\n    // a unit only counts straight after a number, so `5 km` is coloured as one number, and `km` alone isn't\n    const UNIT = String.raw`(?:\\s+(?:mm|cm|m|km|millimetres?|centimetres?|metres?|kilometres?|millimeters?|centimeters?|meters?|kilometers?|inch|inches|foot|feet|yards?|miles?|milliseconds?|seconds?|minutes?|hours?|days?|weeks?|mg|g|kg|milligrams?|grams?|kilograms?|ounces?|pounds?|tonnes?|ml|millilitres?|litres?|milliliters?|liters?)\\b)?`;\n    const escape = (text) => text.replace(/[&<>]/g, (c) => (\{ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\" })[c]);\n    // red: what makes folio check end with 1 (code that goes against what it says it is too); the other problems\n    // (\"never runs\", \"unused\") are yellow\n    const BAD = new Set([\"fails\", \"error\", \"doesn't fit\"]);\n    // A value in text (\"Hi \{name}\"): a '\{' right before a letter, '_' or '(', which ends at its own '}' and\n    // can have text inside it. These give where text that starts at `at` ends, and where such a value does,\n    // as the tokenizer finds them; text or a value with no end runs to the end of the line.\n    const startsValue = (c) => c !== undefined && /[A-Za-z_(]/.test(c);\n    function textEnd(text, at) \{\n      let i = at + 1;\n      while (i < text.length && text[i] !== '\"') \{\n        if (text[i] === \"\\\\\") i += 2;\n        else if (text[i] === \"\{\" && startsValue(text[i + 1])) i = valueEnd(text, i) + 1;\n        else i++;\n      }\n      return Math.min(i + 1, text.length);\n    }\n    function valueEnd(text, at) \{\n      let i = at + 1;\n      while (i < text.length && text[i] !== \"}\") i = text[i] === '\"' ? textEnd(text, i) : i + 1;\n      return i;\n    }\n    // text, with each value in it coloured as code\n    function filledIn(str) \{\n      let html = \"\";\n      let last = 0;\n      for (let i = 1; i < str.length; ) \{\n        if (str[i] === \"\\\\\") i += 2;\n        else if (str[i] === \"\{\" && startsValue(str[i + 1])) \{\n          const end = valueEnd(str, i);\n          html += `$\{escape(str.slice(last, i))}</span>\{$\{highlight(str.slice(i + 1, end))}$\{str[end] ?? \"\"}<span class=\"s\">`;\n          i = last = end + 1;\n        } else i++;\n      }\n      return html + escape(str.slice(last));\n    }\n    const PIECE = new RegExp(String.raw`(#.*)|(\")|\\b(\\d+(?:\\.\\d+)?\\b$\{UNIT})|([A-Za-z_]\\w*)|([^#\"\\w])`, \"y\");\n    // `marks` maps a line number to the columns the checker flagged there, which get a wavy underline.\n    function highlight(source, marks = new Map()) \{\n      return source.split(\"\\n\").map((text, i) => \{\n        const flagged = marks.get(i + 1);\n        let line = \"\";\n        for (let at = 0; at < text.length; ) \{\n          PIECE.lastIndex = at;\n          const m = PIECE.exec(text);\n          if (!m) \{ // a digit straight after a word's letters, say: as it is\n            line += escape(text[at++]);\n            continue;\n          }\n          const [, comment, quote, number, word, other] = m;\n          const piece = quote ? text.slice(at, textEnd(text, at)) : m[0];\n          const html = comment ? `<span class=\"c\">$\{escape(comment)}</span>`\n            : quote ? `<span class=\"s\">$\{filledIn(piece)}</span>`\n            : number ? `<span class=\"n\">$\{number}</span>`\n            : word ? (WORDS.has(word.toLowerCase()) ? `<span class=\"k\">$\{word}</span>` : word)\n            : escape(other);\n          const kind = flagged?.get(at + 1);\n          line += kind ? `<span class=\"squiggle $\{BAD.has(kind) ? \"bad\" : \"meh\"}\">$\{html}</span>` : html;\n          at += piece.length;\n        }\n        return line;\n      }).join(\"\\n\");\n    }\n\n    // The checker runs on every change, which takes well under a millisecond for programs this size.\n    // Files the code uses (`use \"math.folio\"`), fetched from this site the first time; until one arrives, the\n    // checker says it can't find it, and the editor checks again once it's here.\n    const usedFiles = new Map();\n    const files = (name) => usedFiles.get(name);\n    const usesIn = (text) => [...text.matchAll(/^[ \\t]*use[ \\t]+\"([^\"\\n]*)\"/gim)].map((m) => m[1]);\n    async function fetchUses(text) \{\n      for (const name of usesIn(text)) \{\n        if (usedFiles.has(name)) continue;\n        // a file beside the page, or one of the standard library's (page.folio and the rest, in tools/)\n        usedFiles.set(name, await fetchText(name).catch(() => (/^[\\w-]+[.]folio$/.test(name) ? fetchText(`tools/$\{name}`) : undefined)).catch(() => undefined));\n        await fetchUses(usedFiles.get(name) ?? \"\");\n      }\n    }\n\n    function refreshEditor() \{\n      if (usesIn(code.value).some((name) => !usedFiles.has(name))) fetchUses(code.value).then(refreshEditor);\n      const problems = check(code.value, \{ files });\n      const marks = new Map();\n      for (const p of problems) if (!p.file) marks.set(p.line, (marks.get(p.line) ?? new Map()).set(p.col, p.kind));\n      paint(code.value, marks);\n      $(\"gutter\").textContent = code.value.split(\"\\n\").map((_, n) => n + 1).join(\"\\n\");\n      showProblems(problems);\n      syncScroll();\n    }\n\n    // The coloured copy of the code under the textarea (whose own text is see-through), redrawn only where\n    // lines changed: rebuilding all of a long program's lines took most of the time a key press took. Each\n    // line is its own block, a <div> ending in a new line, so changing one doesn't lay out all the others\n    // again; the last line ends in a new line too, which keeps the copy's height in step with the textarea's.\n    // `painted` holds each line's text and marks, as drawn now.\n    let painted = [];\n    function paint(source, marks) \{\n      const box = $(\"highlight\");\n      if (!painted.length) box.replaceChildren();\n      const lines = source.split(\"\\n\");\n      const keys = lines.map((text, i) => (marks.has(i + 1) ? `$\{text}\\u0000$\{[...marks.get(i + 1)].join(\";\")}` : text));\n      let start = 0; // the lines that changed are the ones between the unchanged ones at each end\n      while (start < keys.length && start < painted.length && keys[start] === painted[start]) start++;\n      let [oldEnd, newEnd] = [painted.length, keys.length];\n      while (oldEnd > start && newEnd > start && painted[oldEnd - 1] === keys[newEnd - 1]) [oldEnd, newEnd] = [oldEnd - 1, newEnd - 1];\n      const after = box.childNodes[oldEnd] ?? null;\n      for (let i = start; i < oldEnd; i++) box.childNodes[start].remove();\n      const fresh = document.createElement(\"template\");\n      fresh.innerHTML = lines.slice(start, newEnd).map((text, i) => \{\n        const line = start + i + 1;\n        return `<div>$\{highlight(text, marks.has(line) ? new Map([[1, marks.get(line)]]) : undefined)}\\n</div>`;\n      }).join(\"\");\n      box.insertBefore(fresh.content, after);\n      painted = keys;\n    }\n\n    function showProblems(problems) \{\n      $(\"problems-view\").hidden = !problems.length;\n      $(\"problems\").replaceChildren(...problems.map((p) => \{\n        const button = document.createElement(\"button\");\n        button.className = BAD.has(p.kind) ? \"bad\" : \"meh\";\n        button.textContent = `$\{BAD.has(p.kind) ? \"⛔\" : \"⚠\"} $\{p.file ? `$\{p.file}, ` : \"\"}line $\{p.line}: $\{\{ fails: \"will fail: \", \"doesn't fit\": \"doesn't fit: \" }[p.kind] ?? \"\"}$\{p.message}`;\n        if (!p.file) button.onclick = () => jumpTo(p); // only this file is in the editor\n        const li = document.createElement(\"li\");\n        li.append(button);\n        const fix = !p.file && fixButton(\{ line: p.line, col: p.col, reason: p.message });\n        if (fix) li.append(fix);\n        return li;\n      }));\n      $(\"hint\").textContent = problems.length\n        ? `$\{problems.length} problem$\{problems.length === 1 ? \"\" : \"s\"} found without running`\n        : \"Ctrl+Enter runs · Debug goes backwards too\";\n    }\n\n    function jumpTo(\{ line, col }) \{\n      const offset = code.value.split(\"\\n\").slice(0, line - 1).reduce((n, text) => n + text.length + 1, 0) + col - 1;\n      code.focus();\n      code.setSelectionRange(offset, offset);\n    }\n    function syncScroll() \{\n      $(\"highlight\").scrollTop = $(\"gutter\").scrollTop = code.scrollTop;\n      $(\"highlight\").scrollLeft = code.scrollLeft;\n    }\n    code.oninput = refreshEditor;\n    code.onscroll = syncScroll;\n\n    // Draws what the program drew (lines, filled shapes and text: see Turtle in vm.js) from its last `clear`\n    // on, with Folio's (0, 0) in the middle and y going up, zoomed out if `fitTo` reaches past the edge.\n    const sinceClear = (items) => items.slice(items.findLastIndex((d) => d.clear) + 1);\n    const reachOf = (d) => ([\"box\", \"picture\", \"button\", \"textbox\", \"checkbox\", \"textarea\", \"list\", \"dropdown\", \"slider\"].includes(d.shape) ? Math.max(Math.abs(d.x), Math.abs(d.y), Math.abs(d.x + d.width), Math.abs(d.y + d.height))\n      : d.shape === \"circle\" ? Math.max(Math.abs(d.x), Math.abs(d.y)) + d.radius\n      : d.shape === \"text\" ? Math.max(Math.abs(d.x), Math.abs(d.y) + d.size)\n      : d.clear || d.textbox !== undefined || d.checkbox !== undefined || d.list !== undefined || d.dropdown !== undefined || d.slider !== undefined ? 0 : Math.max(Math.abs(d.x1), Math.abs(d.y1), Math.abs(d.x2), Math.abs(d.y2)));\n    function render(items = drawing, fitTo = items) \{\n      const canvas = $(\"canvas\");\n      const pen = canvas.getContext(\"2d\");\n      const half = canvas.width / 2;\n      const reach = Math.max(0, ...sinceClear(fitTo).map(reachOf));\n      const scale = appRunning ? 1 : Math.min(1, (half - 10) / reach); // an app's view never moves: it's where its clicks land\n      $(\"drawing-view\").hidden = !(appRunning && appDraws) && !fitTo.length;\n      pen.setTransform(1, 0, 0, 1, 0, 0);\n      pen.clearRect(0, 0, canvas.width, canvas.height);\n      pen.setTransform(scale, 0, 0, -scale, half, half);\n      pen.lineCap = \"round\";\n      const shown = sinceClear(items);\n      // a text box shows what the last word on it says: its own, or a change to its text or focus (DESIGN §36)\n      const boxes = new Map();\n      for (const d of shown) if (d.shape === \"textbox\" || d.shape === \"textarea\" || d.textbox !== undefined) boxes.set(d.label ?? d.textbox, d);\n      // and so does a checkbox, and a list, whose items are the ones it was drawn with (DESIGN §40)\n      const ticks = new Map();\n      const lists = new Map();\n      for (const d of shown) \{\n        if (d.shape === \"checkbox\" || d.checkbox !== undefined) ticks.set(d.label ?? d.checkbox, d.ticked);\n        if (d.shape === \"list\" || d.list !== undefined) lists.set(d.label ?? d.list, d);\n      }\n      // a dropdown and a slider too, the last word on each kept with what it was drawn with (DESIGN §42)\n      const drops = new Map();\n      const sliders = new Map();\n      for (const d of shown) \{\n        if (d.shape === \"dropdown\" || d.dropdown !== undefined) drops.set(d.label ?? d.dropdown, \{ ...drops.get(d.label ?? d.dropdown), ...d });\n        if (d.shape === \"slider\" || d.slider !== undefined) sliders.set(d.label ?? d.slider, \{ ...sliders.get(d.label ?? d.slider), ...d });\n      }\n      // a list's rows in the box `b`, white in a border of the pen's colour (3 wide while it has the focus): a\n      // row every 24 from the top, the chosen one in the pen's colour with its text in white, and while they\n      // don't all fit, a bar at the right for where the rows in view are among them all\n      const rowsIn = (b, items, \{ chosen, top, focused }, rows) => \{\n        pen.fillRect(b.x, b.y, b.width, b.height);\n        pen.save();\n        pen.fillStyle = \"#ffffff\";\n        const edge = focused ? 3 : 2;\n        pen.fillRect(b.x + edge, b.y + edge, b.width - 2 * edge, b.height - 2 * edge);\n        pen.beginPath();\n        pen.rect(b.x + edge, b.y + edge, b.width - 2 * edge, b.height - 2 * edge);\n        pen.clip();\n        for (let row = 0; row < rows && top + row < items.length; row++) \{\n          const low = b.y + b.height - 24 * (row + 1);\n          if (top + row === chosen) \{\n            pen.fillStyle = b.color;\n            pen.fillRect(b.x, low, b.width, 24);\n          }\n          pen.fillStyle = top + row === chosen ? \"#ffffff\" : \"#000000\";\n          write(items[top + row], b.x + 8, low + 7, 16);\n        }\n        if (items.length > rows) \{\n          pen.fillStyle = b.color;\n          const length = (b.height * rows) / items.length;\n          pen.fillRect(b.x + b.width - 6, b.y + b.height - (b.height * top) / items.length - length, 3, length);\n        }\n        pen.restore();\n      };\n      // text the right way up, in a picture whose y goes up, its baseline at (x, y)\n      const write = (text, x, y, size, align = \"left\") => \{\n        pen.save();\n        pen.translate(x, y);\n        pen.scale(1, -1);\n        pen.font = `$\{size}px system-ui, sans-serif`;\n        pen.textAlign = align;\n        pen.fillText(text, 0, 0);\n        pen.restore();\n      };\n      // What's typed in a text box or a text area (DESIGN §41), inside its border: a letter every 10 across from\n      // 8 in, from the first column and line in view, in a font whose letters take the same room, a line every\n      // 20 from 20 below the top; what's selected behind it in light blue, and the cursor, while it has the\n      // focus, between two letters. An empty one shows its label in grey.\n      const typedIn = (d, \{ text, focused, cursor, anchor, left, top }, rows) => \{\n        const letters = [...(text || d.label)];\n        const cols = Math.max(1, Math.floor((d.width - 16) / 10));\n        const [from, to] = text ? [Math.min(cursor, anchor), Math.max(cursor, anchor)] : [0, 0];\n        let [line, start, at] = [0, 0, [0, 0]];\n        for (let i = 0; i <= letters.length; i++) \{\n          if (i === (text ? cursor : 0)) at = [line, i - start];\n          if (i === letters.length || letters[i] === \"\\n\") \{\n            const row = line - top;\n            if (row >= 0 && row < rows) \{\n              const base = d.y + d.height - 20 - 20 * row;\n              for (let c = left; c < Math.min(left + cols, i - start); c++) \{\n                const x = d.x + 8 + 10 * (c - left);\n                if (start + c >= from && start + c < to) \{\n                  pen.fillStyle = \"#b4d5fe\";\n                  pen.fillRect(x, base - 4, 10, 20);\n                }\n                pen.fillStyle = text ? \"#000000\" : \"#888888\";\n                pen.save();\n                pen.translate(x, base);\n                pen.scale(1, -1);\n                pen.font = \"16px ui-monospace, Consolas, monospace\";\n                pen.fillText(letters[start + c], 0, 0);\n                pen.restore();\n              }\n            }\n            [line, start] = [line + 1, i + 1];\n          }\n        }\n        const [row, col] = [at[0] - top, at[1] - left];\n        if (focused && row >= 0 && row < rows && col >= 0 && col <= cols) \{\n          pen.fillStyle = \"#000000\";\n          pen.fillRect(d.x + 7 + 10 * col, d.y + d.height - 24 - 20 * row, 2, 18);\n        }\n      };\n      for (const d of shown) \{\n        if (d.textbox !== undefined || d.checkbox !== undefined || d.list !== undefined || d.dropdown !== undefined || d.slider !== undefined) continue; // drawn with its box\n        pen.strokeStyle = pen.fillStyle = d.color; // a color name the browser doesn't know keeps the previous one\n        if (d.shape === \"box\") pen.fillRect(d.x, d.y, d.width, d.height);\n        else if (d.shape === \"button\") \{ // in the pen's colour, its label in white in the middle\n          pen.fillRect(d.x, d.y, d.width, d.height);\n          pen.save(); // so the pen's colour is as it was after\n          pen.fillStyle = \"#ffffff\";\n          write(d.text, d.x + d.width / 2, d.y + 10, 16, \"center\");\n          pen.restore();\n        } else if (d.shape === \"textbox\" || d.shape === \"textarea\") \{ // white, in a border of the pen's colour\n          pen.fillRect(d.x, d.y, d.width, d.height);\n          pen.save();\n          pen.fillStyle = \"#ffffff\";\n          pen.fillRect(d.x + 2, d.y + 2, d.width - 4, d.height - 4);\n          pen.beginPath();\n          pen.rect(d.x + 2, d.y + 2, d.width - 4, d.height - 4);\n          pen.clip();\n          typedIn(d, boxes.get(d.label), d.shape === \"textbox\" ? 1 : Math.max(1, Math.floor((d.height - 8) / 20)));\n          pen.restore();\n        } else if (d.shape === \"checkbox\") \{ // a box in the pen's colour, white inside, ticked with a box of the pen's colour\n          pen.fillRect(d.x, d.y, 20, 20);\n          pen.save();\n          pen.fillStyle = \"#ffffff\";\n          pen.fillRect(d.x + 2, d.y + 2, 16, 16);\n          pen.restore();\n          if (ticks.get(d.label)) pen.fillRect(d.x + 5, d.y + 5, 10, 10);\n          write(d.label, d.x + 28, d.y + 4, 16);\n        } else if (d.shape === \"list\") rowsIn(d, d.items, lists.get(d.label), Math.max(1, Math.floor(d.height / 24)));\n        else if (d.shape === \"dropdown\") \{ // as a text box, the item chosen in it, or its label in grey, and an arrow\n          const \{ chosen } = drops.get(d.label);\n          pen.fillRect(d.x, d.y, d.width, d.height);\n          pen.save();\n          pen.fillStyle = \"#ffffff\";\n          pen.fillRect(d.x + 2, d.y + 2, d.width - 4, d.height - 4);\n          pen.beginPath();\n          pen.rect(d.x + 2, d.y + 2, d.width - 30, d.height - 4);\n          pen.clip();\n          pen.fillStyle = chosen >= 0 && chosen < d.items.length ? \"#000000\" : \"#888888\";\n          write(chosen >= 0 && chosen < d.items.length ? d.items[chosen] : d.label, d.x + 8, d.y + 10, 16);\n          pen.restore();\n          pen.beginPath();\n          pen.moveTo(d.x + d.width - 22, d.y + 19);\n          pen.lineTo(d.x + d.width - 10, d.y + 19);\n          pen.lineTo(d.x + d.width - 16, d.y + 11);\n          pen.fill();\n        } else if (d.shape === \"slider\") \{ // a track 4 high, in the pen's colour up to its knob, and the knob, 12 wide\n          const \{ value, focused } = sliders.get(d.label);\n          const knob = d.x + 10 + (d.to === d.from ? 0 : ((value - d.from) / (d.to - d.from)) * (d.width - 20));\n          pen.save();\n          pen.fillStyle = \"#c8c8c8\";\n          pen.fillRect(d.x + 10, d.y + 8, d.width - 20, 4);\n          pen.restore();\n          pen.fillRect(d.x + 10, d.y + 8, knob - d.x - 10, 4);\n          pen.fillRect(knob - 6, d.y, 12, 20);\n          if (focused) \{ // a white line in the knob while it has the focus\n            pen.save();\n            pen.fillStyle = \"#ffffff\";\n            pen.fillRect(knob - 1, d.y + 4, 2, 12);\n            pen.restore();\n          }\n        } else if (d.shape === \"circle\") \{\n          pen.beginPath();\n          pen.arc(d.x, d.y, d.radius, 0, 2 * Math.PI);\n          pen.fill();\n        } else if (d.shape === \"text\") \{ // the right way up, in a picture whose y goes up\n          pen.save();\n          pen.translate(d.x, d.y);\n          pen.scale(1, -1);\n          pen.font = `$\{d.size}px system-ui, sans-serif`;\n          pen.fillText(d.text, 0, 0);\n          pen.restore();\n        } else if (d.shape === \"picture\") \{ // the right way up too, its pixels sharp however big it's drawn\n          pen.save();\n          pen.translate(d.x, d.y + d.height);\n          pen.scale(1, -1);\n          pen.imageSmoothingEnabled = false;\n          pen.drawImage(drawable(d.image), 0, 0, d.width, d.height);\n          pen.restore();\n        } else \{\n          pen.beginPath();\n          pen.lineWidth = d.width;\n          pen.moveTo(d.x1, d.y1);\n          pen.lineTo(d.x2, d.y2);\n          pen.stroke();\n        }\n      }\n      // last, on top of everything, an open dropdown's items: a list below it, as many rows as it has, up to 6\n      for (const d of shown) \{\n        if (d.shape !== \"dropdown\" || !drops.get(d.label).open) continue;\n        const state = drops.get(d.label);\n        const rows = Math.max(1, Math.min(6, d.items.length));\n        pen.fillStyle = d.color;\n        rowsIn(\{ x: d.x, y: d.y - 24 * rows, width: d.width, height: 24 * rows, color: d.color }, d.items, \{ ...state, focused: false }, rows);\n      }\n    }\n\n    // A picture from a file (see decodePicture in pictures.js), on a canvas of its own, made the first time\n    // it's drawn: a sprite a game draws every frame is the same image each time.\n    const drawables = new WeakMap();\n    function drawable(image) \{\n      if (!drawables.has(image)) \{\n        const canvas = Object.assign(document.createElement(\"canvas\"), \{ width: image.width, height: image.height });\n        const pixels = new Uint8ClampedArray(image.pixels.buffer, image.pixels.byteOffset, image.pixels.length);\n        canvas.getContext(\"2d\").putImageData(new ImageData(pixels, image.width, image.height), 0, 0);\n        drawables.set(image, canvas);\n      }\n      return drawables.get(image);\n    }\n\n    // Sounds (see soundOf in vm.js) take turns, as in machine code: each starts when the one before it ends,\n    // and the program doesn't wait for them. Each becomes samples (soundSamples, the numbers machine code\n    // plays) only shortly before its turn, so a long tune doesn't fill the page. Stop and Run silence them.\n    let audio = null;\n    let soundsEnd = 0; // when, on the audio clock, the last sound so far ends\n    let waitingSounds = []; // \{ sound, at }, in turn, from `nextSound` on: not yet handed to the browser\n    let nextSound = 0;\n    let soundTimer = null;\n    const sounding = new Set();\n    function queueSounds(sounds) \{\n      try \{\n        audio ??= new AudioContext();\n        audio.resume();\n      } catch \{\n        return; // a browser that can't make sound\n      }\n      for (const sound of sounds) \{\n        const at = Math.max(soundsEnd, audio.currentTime + 0.05);\n        soundsEnd = at + Math.floor(sound.seconds * SOUND_RATE + 0.5) / SOUND_RATE;\n        if (sound.hertz > 0) waitingSounds.push(\{ sound, at }); // a rest is only the wait\n      }\n      soundsSoon();\n    }\n    function soundsSoon() \{\n      while (nextSound < waitingSounds.length && waitingSounds[nextSound].at < audio.currentTime + 1) \{\n        const \{ sound, at } = waitingSounds[nextSound++];\n        const samples = soundSamples(sound);\n        if (!samples.length) continue;\n        const buffer = audio.createBuffer(1, samples.length, SOUND_RATE);\n        const wave = buffer.getChannelData(0);\n        for (let i = 0; i < samples.length; i++) wave[i] = samples[i] / 32768;\n        const source = audio.createBufferSource();\n        source.buffer = buffer;\n        source.connect(audio.destination);\n        source.onended = () => sounding.delete(source);\n        source.start(at);\n        sounding.add(source);\n      }\n      if (nextSound === waitingSounds.length) [waitingSounds, nextSound] = [[], 0];\n      clearTimeout(soundTimer);\n      soundTimer = waitingSounds.length ? setTimeout(soundsSoon, 250) : null;\n    }\n    function silence() \{\n      for (const source of sounding) source.stop();\n      sounding.clear();\n      [waitingSounds, nextSound, soundsEnd] = [[], 0, 0];\n      clearTimeout(soundTimer);\n    }\n\n    // at most once a frame, however fast an app draws\n    let painting = false;\n    function paintSoon() \{\n      if (painting) return;\n      painting = true;\n      requestAnimationFrame(() => \{\n        painting = false;\n        render();\n      });\n    }\n\n    function finish(message) \{\n      appRunning = false;\n      worker?.terminate();\n      worker = null;\n      stopButton.disabled = true;\n      status.textContent = message;\n    }\n\n    function fail(text, mistake) \{\n      output.classList.add(\"error\");\n      output.append(text);\n      const fix = mistake && fixButton(mistake);\n      if (fix) output.append(\"\\n\", fix);\n      finish(\"\");\n    }\n\n    // A button that puts a mistake right, where it says how (see suggestedFix in folio.js): the misspelled name\n    // becomes the one it meant, `>` becomes `is greater than`. The change can be undone with Ctrl+Z.\n    function fixButton(mistake) \{\n      const fix = suggestedFix(code.value, mistake);\n      if (!fix) return null;\n      const button = Object.assign(document.createElement(\"button\"), \{ type: \"button\", className: \"fix\", textContent: `Fix: $\{fix.text}` });\n      button.title = `Put '$\{fix.text}' on line $\{fix.line}`;\n      button.onclick = () => \{\n        const start = code.value.split(\"\\n\").slice(0, fix.line - 1).reduce((n, l) => n + l.length + 1, 0) + fix.col - 1;\n        code.focus();\n        code.setSelectionRange(start, start + fix.length);\n        if (!document.execCommand(\"insertText\", false, fix.text)) \{ // the browser's own undoable way, if it has one\n          code.setRangeText(fix.text, start, start + fix.length, \"end\");\n          refreshEditor();\n        }\n        button.disabled = true;\n      };\n      return button;\n    }\n\n    // Folio programs kept in files of their own (compiler.folio, neural.folio), fetched the first time they're needed\n    const fetched = new Map();\n    async function fetchText(file) \{\n      if (!fetched.has(file)) \{\n        const response = await fetch(file);\n        if (!response.ok) throw new Error(`$\{file}: $\{response.status} $\{response.statusText}`);\n        fetched.set(file, await response.text());\n      }\n      return fetched.get(file);\n    }\n    let folioCompiled = null; // compiler.folio, Folio's compiler written in Folio, compiled by the JIT\n    async function compileWithFolio(source) \{\n      folioCompiled ??= folioCompiler(await fetchText(\"compiler.folio\"));\n      await fetchUses(source);\n      return folioCompiled(source, Object.fromEntries([...usedFiles].filter(([, text]) => text !== undefined))).source;\n    }\n\n    // What the compilers made of the code: the VM's bytecode, the JavaScript from the JIT, or the\n    // JavaScript from the compiler written in Folio, checked against the JIT's.\n    async function showCompiled() \{\n      const which = $(\"compiled\").value;\n      $(\"bytecode-view\").hidden = !which;\n      if (!which) return;\n      const source = code.value;\n      try \{\n        if (which === \"folio\") \{\n          const js = await compileWithFolio(source);\n          if (source !== code.value) return; // the code changed while compiler.folio loaded; that call shows it\n          const same = js === compileToJs(source, \{ files }).source;\n          $(\"compiled-title\").textContent = `JavaScript · written by compiler.folio, Folio's compiler in Folio: $\{same ? \"the same as the JIT's, byte for byte\" : \"DIFFERENT from the JIT's\"}`;\n          $(\"bytecode\").textContent = js;\n          return;\n        }\n        if (which === \"wasm\") \{\n          const \{ bytes, listing } = compileToWasmBytes(source, \{ files });\n          $(\"compiled-title\").textContent = `WebAssembly · $\{bytes.length.toLocaleString(\"en\")} bytes, which the browser compiles to machine code`;\n          $(\"bytecode\").textContent = listing;\n          return;\n        }\n        $(\"compiled-title\").textContent = which === \"js\"\n          ? \"JavaScript · what the JIT made, which V8 then compiles to machine code\"\n          : \"Bytecode · what the compiler made, which the virtual machine runs\";\n        $(\"bytecode\").textContent = which === \"js\" ? compileToJs(source, \{ files }).source : disassemble(compile(source, \{ files }));\n      } catch (err) \{\n        if (!(err instanceof FolioError) && which === \"folio\") \{\n          $(\"bytecode\").textContent = `(compiler.folio didn't load: $\{err.message})`;\n          return;\n        }\n        if (!(err instanceof FolioError)) throw err;\n        $(\"bytecode\").textContent = \"(fix the mistake in the code to see it compiled)\";\n      }\n    }\n\n    // Each run gets a fresh worker (worker.js), so Stop can end it however busy it is. A program that asks a\n    // question stops there; once it's answered, it runs again from the start with every answer so far, and\n    // since it says and draws the same things up to there, only what's new is shown.\n    let answers = [];\n    let shownLines = 0;\n    let seed = 1; // where this run's random numbers start: a new one for each Run, kept for its answers and Debug\n    function runCode() \{\n      seed = Math.floor(Math.random() * 2 ** 32);\n      stopDebugging(\"\");\n      showCompiled();\n      output.textContent = \"\";\n      output.classList.remove(\"error\");\n      drawing = [];\n      shownDrawn = 0;\n      render();\n      silence();\n      shownPlayed = 0;\n      answers = [];\n      shownLines = 0;\n      pageFresh = true;\n      $(\"page-view\").hidden = true;\n      document.body.classList.remove(\"paged\");\n      startRun();\n    }\n\n    function startRun() \{\n      document.querySelector(\".answer\")?.remove();\n      finish(\"Running…\");\n      stopButton.disabled = false;\n      let [skipLines, skipDrawn, skipPlayed] = [shownLines, shownDrawn, shownPlayed]; // shown (and played) by the runs before this one\n      const current = (worker = new Worker(folioModule(\"worker.js\"), \{ type: \"module\" }));\n      const pictures = new Map(); // each picture this run drew, by the number its drawing has (see worker.js)\n      current.onmessage = (\{ data }) => \{\n        if (worker !== current) return; // a message from a run that was already replaced\n        for (const [id, image] of data.pictures ?? []) pictures.set(id, image);\n        if (data.drawn) data.drawn = data.drawn.map((d) => (d.shape === \"picture\" ? \{ ...d, image: pictures.get(d.image) } : d));\n        if (data.lines?.length) \{\n          const skip = Math.min(skipLines, data.lines.length);\n          skipLines -= skip;\n          if (data.lines.length > skip) \{\n            for (const line of data.lines.slice(skip)) \{ // a line said to the error output in the colour of a mistake\n              if (typeof line === \"string\") output.append(`$\{line}\\n`);\n              else output.append(Object.assign(document.createElement(\"span\"), \{ className: \"error-output\", textContent: `$\{line.error}\\n` }));\n            }\n            shownLines += data.lines.length - skip;\n          }\n        }\n        if (data.drawn?.length) \{\n          const skip = Math.min(skipDrawn, data.drawn.length);\n          skipDrawn -= skip;\n          if (data.drawn.length > skip) \{\n            const fresh = data.drawn.slice(skip);\n            shownDrawn += fresh.length;\n            drawing = drawing.concat(fresh);\n            drawing = drawing.slice(Math.max(0, drawing.findLastIndex((d) => d.clear))); // nothing before a clear is seen again\n            paintSoon();\n          }\n        }\n        if (data.played?.length) \{\n          const skip = Math.min(skipPlayed, data.played.length);\n          skipPlayed -= skip;\n          if (data.played.length > skip) \{\n            shownPlayed += data.played.length - skip;\n            queueSounds(data.played.slice(skip));\n          }\n        }\n        if (data.page != null) showPage(data.page);\n        if (data.question !== undefined) return waitForAnswer(data.question);\n        if (data.error) fail(data.error, data.mistake);\n        if (data.stopped !== undefined && !data.done) return finish(`The app stopped the program with $\{data.stopped}`); // a handler did\n        if (data.done) \{\n          if (data.empty && !data.app) output.append(\"(no output)\");\n          const engine = \{ jit: \"the JIT\", wasm: data.byFolioWasm ? \"WebAssembly, compiled by folio.wasm\" : \"WebAssembly\", vm: \"the VM\" }[$(\"engine\").value];\n          const ms = data.ms < 10 ? data.ms.toFixed(1) : Math.round(data.ms);\n          if (data.app) return startApp(data.app, `Set up in $\{ms} ms on $\{engine}`);\n          // `stop the program with 2` just ends the run: there is no system here to hand the 2 to\n          finish(`Ran in $\{ms} ms on $\{engine}$\{data.stopped === undefined ? \"\" : `, and stopped the program with $\{data.stopped}`}`);\n        }\n      };\n      current.onerror = (e) => fail(`Error: $\{e.message || \"the program stopped unexpectedly\"}`); // e.g. it ran out of memory\n      const source = code.value;\n      fetchUses(source).then(() => \{\n        if (worker === current) current.postMessage(\{ source, engine: $(\"engine\").value, answers, files: Object.fromEntries(usedFiles), seed, disk: Object.fromEntries(pageFiles), folioWasm });\n      });\n    }\n\n    // An app: the worker keeps running it, and the picture, which stays put, takes keys pressed while it has\n    // the focus, clicks and drags. Stop ends it.\n    function startApp(waits, done) \{\n      appRunning = true;\n      const paged = waits.some((w) => w.event === \"page\");\n      appDraws = !paged || waits.some((w) => ![\"page\", \"every\"].includes(w.event));\n      const wants = [waits.some((w) => w.event === \"key\") && \"press keys\", waits.some((w) => ![\"key\", \"every\", \"page\"].includes(w.event)) && \"click the picture\",\n        paged && \"use the page\"].filter(Boolean);\n      status.textContent = `$\{done} · an app, running$\{wants.length ? `: $\{wants.join(\" or \")}` : \"\"} · Stop ends it`;\n      render(); // now, not on the next frame: a hidden picture can't take the focus\n      if (appDraws) $(\"canvas\").focus(\{ preventScroll: true });\n    }\n\n    // The page a program shows (page.folio, DESIGN §145), in a frame of its own: sandboxed, and of no site, so\n    // nothing on it can reach this page or what the site keeps, however it was written. The program's first page\n    // of a run is loaded into it; each page after that goes to the script below, which puts it in place of the\n    // one before, keeping what has the focus, so a page shown again as it's typed in doesn't take the typing\n    // away. What's clicked, typed or chosen on it comes back as `when the page is used`.\n    const pageFrame = $(\"page-frame\");\n    let pageFresh = true; // the next page is the run's first\n    let pageLoaded = false;\n    let pageWaiting = null; // the newest page, until the frame has loaded\n    function inPage() \{\n      const named = (el) => el?.closest?.(\"[data-folio]\");\n      const isField = (el) => el.matches(\"input:not([type=button]):not([type=submit]):not([type=reset]), select, textarea\");\n      const valueOf = (el) => (el.type === \"checkbox\" ? el.checked : isField(el) ? el.value : el.textContent.trim());\n      const send = (type, el) => \{\n        const values = \{};\n        for (const field of document.querySelectorAll(\"[data-folio]\")) if (isField(field)) values[field.dataset.folio] = valueOf(field);\n        parent.postMessage(\{ folio: \"page\", type, name: el.dataset.folio, value: valueOf(el), values }, \"*\");\n      };\n      document.addEventListener(\"click\", (e) => \{\n        const el = named(e.target);\n        if (!el || isField(el)) return;\n        e.preventDefault();\n        send(\"click\", el);\n      });\n      let entered = null; // the text box Enter was pressed in, and what was in it: its change after that isn't news\n      document.addEventListener(\"change\", (e) => \{\n        const el = named(e.target);\n        if (!el || !isField(el) || (entered?.el === el && entered.value === el.value)) return;\n        send(\"change\", el);\n      });\n      document.addEventListener(\"keydown\", (e) => \{\n        const el = named(e.target);\n        if (e.key !== \"Enter\" || !el?.matches(\"input\")) return;\n        e.preventDefault();\n        entered = \{ el, value: el.value };\n        send(\"enter\", el);\n      });\n      addEventListener(\"message\", (e) => \{\n        if (e.source !== parent || e.data?.folio !== \"show\") return;\n        const had = document.activeElement;\n        const focused = had?.dataset?.folio;\n        const [start, end] = [had?.selectionStart, had?.selectionEnd];\n        const made = new DOMParser().parseFromString(e.data.html, \"text/html\");\n        document.title = made.title;\n        document.head.replaceWith(made.head);\n        document.body.replaceWith(made.body);\n        const again = focused === undefined ? null : [...document.querySelectorAll(\"[data-folio]\")].find((el) => el.dataset.folio === focused);\n        if (!again) return;\n        again.focus(\{ preventScroll: true });\n        if (typeof start === \"number\" && again.setSelectionRange && again.value.length >= end) again.setSelectionRange(start, end);\n      });\n    }\n    function showPage(html) \{\n      $(\"page-view\").hidden = false;\n      document.body.classList.add(\"paged\");\n      if (pageFresh) \{\n        pageFresh = false;\n        pageLoaded = false;\n        pageWaiting = null;\n        const script = `<script>($\{inPage})()<\\/script>`;\n        pageFrame.srcdoc = /^\\s*<!doctype[^>]*>/i.test(html) ? html.replace(/^\\s*<!doctype[^>]*>/i, (doctype) => doctype + script) : script + html;\n      } else if (pageLoaded) pageFrame.contentWindow.postMessage(\{ folio: \"show\", html }, \"*\");\n      else pageWaiting = html;\n    }\n    pageFrame.onload = () => \{\n      pageLoaded = true;\n      if (pageWaiting !== null) pageFrame.contentWindow.postMessage(\{ folio: \"show\", html: pageWaiting }, \"*\");\n      pageWaiting = null;\n    };\n    // what was done on the page, as a dictionary: its \"type\", the \"name\" of what was used, its \"value\", and\n    // \"values\", every text box's, checkbox's and dropdown's, by name (text, or yes or no for a checkbox)\n    addEventListener(\"message\", (e) => \{\n      if (e.source !== pageFrame.contentWindow || e.data?.folio !== \"page\") return;\n      const \{ type, name, value, values } = e.data;\n      const fits = (v) => typeof v === \"string\" || typeof v === \"boolean\";\n      if (![\"click\", \"change\", \"enter\"].includes(type) || typeof name !== \"string\" || !fits(value) || typeof values !== \"object\" || values === null) return;\n      const fields = new Map(Object.entries(values).filter(([, v]) => fits(v)));\n      sendEvent(\"page\", [new Map([[\"type\", type], [\"name\", name], [\"value\", value], [\"values\", fields]])]);\n    });\n    const KEYS = \{ ArrowLeft: \"left\", ArrowRight: \"right\", ArrowUp: \"up\", ArrowDown: \"down\", \" \": \"space\", Enter: \"enter\", Escape: \"escape\", Backspace: \"backspace\" };\n    const sendEvent = (event, inputs) => appRunning && worker?.postMessage(\{ event, inputs });\n    // A key: with Shift, an arrow, Home or End goes as \"shift+left\", for a text box to select with; with Ctrl\n    // (or a Mac's Command), a letter goes as \"ctrl+a\", and C, X and V copy, cut and paste, below (DESIGN §41)\n    $(\"canvas\").onkeydown = (e) => \{\n      if (!appRunning || e.altKey || e.key === \"Tab\") return; // Tab still moves on\n      const name = KEYS[e.key] ?? e.key.toLowerCase();\n      if (e.ctrlKey || e.metaKey) \{\n        if (/^[a-z]$/.test(name) && !\"cxv\".includes(name)) \{\n          e.preventDefault();\n          sendEvent(\"key\", [`ctrl+$\{name}`]);\n        }\n        return;\n      }\n      e.preventDefault(); // arrows and space would scroll the page\n      sendEvent(\"key\", [e.shiftKey && [\"left\", \"right\", \"up\", \"down\", \"home\", \"end\"].includes(name) ? `shift+$\{name}` : name]);\n      if ([...e.key].length === 1) sendEvent(\"type\", [e.key]); // the letter as typed, for a text box (DESIGN §36)\n    };\n    // the text box with the focus, as the picture last showed it, and what's selected in it\n    function selectedText() \{\n      const boxes = new Map();\n      for (const d of sinceClear(drawing)) if (d.shape === \"textbox\" || d.shape === \"textarea\" || d.textbox !== undefined) boxes.set(d.label ?? d.textbox, d);\n      const box = [...boxes.values()].find((d) => d.focused);\n      return box ? [...box.text].slice(Math.min(box.cursor, box.anchor), Math.max(box.cursor, box.anchor)).join(\"\") : \"\";\n    }\n    // Copying puts what's selected on the clipboard, and cutting does, then has the box take it off; pasting\n    // types what's on the clipboard, new lines and all, which a text box drops and a text area keeps\n    for (const kind of [\"copy\", \"cut\"]) \{\n      document.addEventListener(kind, (e) => \{\n        if (!appRunning || document.activeElement !== $(\"canvas\")) return;\n        const text = selectedText();\n        e.preventDefault();\n        if (!text) return;\n        e.clipboardData.setData(\"text/plain\", text);\n        if (kind === \"cut\") sendEvent(\"key\", [\"ctrl+x\"]);\n      });\n    }\n    document.addEventListener(\"paste\", (e) => \{\n      if (!appRunning || document.activeElement !== $(\"canvas\")) return;\n      e.preventDefault();\n      const text = e.clipboardData.getData(\"text/plain\").replace(/\\r\\n?/g, \"\\n\");\n      if (text) sendEvent(\"type\", [text]);\n    });\n    // where the pointer is, in the picture's own numbers: (0, 0) in the middle, y going up\n    function spot(e) \{\n      const canvas = $(\"canvas\");\n      const box = canvas.getBoundingClientRect();\n      const x = ((e.clientX - box.left) / box.width) * canvas.width - canvas.width / 2;\n      const y = canvas.height / 2 - ((e.clientY - box.top) / box.height) * canvas.height;\n      return [Math.round(x), Math.round(y)];\n    }\n    $(\"canvas\").onpointerdown = (e) => \{\n      if (!appRunning) return;\n      $(\"canvas\").setPointerCapture(e.pointerId); // a drag keeps going past the edge\n      sendEvent(\"click\", spot(e));\n    };\n    $(\"canvas\").onpointermove = (e) => e.buttons && sendEvent(\"drag\", spot(e));\n    // a mouse wheel scrolls the list under it (DESIGN §40): a line for each 24 pixels it would have scrolled\n    $(\"canvas\").addEventListener(\"wheel\", (e) => \{\n      if (!appRunning) return;\n      e.preventDefault();\n      const lines = e.deltaMode === 0 ? Math.round(e.deltaY / 24) || Math.sign(e.deltaY) : Math.sign(e.deltaY) * 3;\n      sendEvent(\"scroll\", [...spot(e), lines]);\n    }, \{ passive: false });\n\n    // A box to type the answer in, or, for a question that starts with \"Draw\", a pad to draw it on. Each\n    // answer is \{ text, shown }: what the program gets, and what the output shows after the question.\n    function waitForAnswer(question) \{\n      finish(\"Waiting for an answer\");\n      const drawing = /^\\s*draw\\b/i.test(question);\n      if (/^\\s*which file to open\\b/i.test(question)) \{ // `choose a file to open`: a file from this computer, added to the page's files (DESIGN §42)\n        const form = Object.assign(document.createElement(\"form\"), \{ className: \"answer\" });\n        const picker = Object.assign(document.createElement(\"input\"), \{ type: \"file\" });\n        picker.setAttribute(\"aria-label\", question);\n        form.append(Object.assign(document.createElement(\"span\"), \{ textContent: question }), picker,\n          Object.assign(document.createElement(\"button\"), \{ textContent: \"Answer\" }));\n        form.onsubmit = async (e) => \{\n          e.preventDefault();\n          const file = picker.files[0];\n          if (file) await addFiles([file]);\n          answers.push(\{ text: file ? file.name : \"\" });\n          startRun();\n        };\n        output.after(form);\n        return;\n      }\n      const form = Object.assign(document.createElement(\"form\"), \{ className: drawing ? \"answer drawing\" : \"answer\" });\n      const label = Object.assign(document.createElement(\"span\"), \{ textContent: question });\n      const answer = Object.assign(document.createElement(\"button\"), \{ textContent: \"Answer\" });\n      if (drawing) \{\n        const pad = drawingPad();\n        const clear = Object.assign(document.createElement(\"button\"), \{ type: \"button\", textContent: \"Clear\", onclick: pad.clear });\n        const buttons = document.createElement(\"div\");\n        buttons.append(answer, \" \", clear);\n        form.append(label, pad.canvas, buttons);\n        form.onsubmit = (e) => \{\n          e.preventDefault();\n          answers.push(\{ text: pad.text(), shown: \"(a drawing)\" });\n          startRun();\n        };\n      } else \{\n        const input = Object.assign(document.createElement(\"input\"), \{ autocomplete: \"off\" });\n        input.setAttribute(\"aria-label\", question);\n        form.append(label, input, answer);\n        form.onsubmit = (e) => \{\n          e.preventDefault();\n          answers.push(\{ text: input.value });\n          startRun();\n        };\n        queueMicrotask(() => input.focus());\n      }\n      output.after(form);\n    }\n\n    // A canvas to draw on with a mouse, pen or finger. text() gives the strokes the way digits.folio reads\n    // them: strokes split by \";\", points by spaces, each \"x,y\" from 0 to 100 with y going down.\n    function drawingPad() \{\n      const canvas = Object.assign(document.createElement(\"canvas\"), \{ className: \"pad\", width: 440, height: 440 });\n      canvas.setAttribute(\"aria-label\", \"Drawing pad\");\n      const pen = canvas.getContext(\"2d\");\n      Object.assign(pen, \{ lineWidth: 26, lineCap: \"round\", lineJoin: \"round\", strokeStyle: \"#f5f5f5\" });\n      const strokes = [];\n      const at = (e) => \{\n        const box = canvas.getBoundingClientRect();\n        return \{ x: Math.round(((e.clientX - box.left) / box.width) * 100), y: Math.round(((e.clientY - box.top) / box.height) * 100) };\n      };\n      const line = (a, b) => \{\n        pen.beginPath();\n        pen.moveTo(a.x * 4.4, a.y * 4.4);\n        pen.lineTo(b.x * 4.4, b.y * 4.4);\n        pen.stroke();\n      };\n      let down = false;\n      canvas.onpointerdown = (e) => \{\n        try \{\n          canvas.setPointerCapture(e.pointerId); // keep the stroke going if the pen leaves the pad\n        } catch \{} // a pointer that can't be captured still draws\n        down = true;\n        const p = at(e);\n        strokes.push([p]);\n        line(p, p);\n      };\n      canvas.onpointermove = (e) => \{\n        const stroke = strokes.at(-1);\n        if (!down || !stroke) return;\n        const p = at(e);\n        const last = stroke.at(-1);\n        if (Math.hypot(p.x - last.x, p.y - last.y) < 1.5) return; // keep the text short\n        stroke.push(p);\n        line(last, p);\n      };\n      canvas.onpointerup = canvas.onpointercancel = () => (down = false);\n      return \{\n        canvas,\n        clear: () => \{\n          strokes.length = 0;\n          pen.clearRect(0, 0, canvas.width, canvas.height);\n        },\n        text: () => strokes.map((s) => s.map((p) => `$\{p.x},$\{p.y}`).join(\" \")).join(\";\"),\n      };\n    }\n\n    // The time-travel debugger: Debug records the whole run first (timeline() in folio.js), then Back, Step,\n    // End and the slider just show a recorded step, so going backwards is as easy as going forwards.\n    function startDebugging() \{\n      finish(\"\");\n      stopDebugging(\"\");\n      showCompiled();\n      output.textContent = \"\";\n      output.classList.remove(\"error\");\n      render((drawing = []));\n      try \{\n        trace = timeline(code.value, \{ answers: answers.map((a) => a.text), files, disk: memoryDisk(Object.fromEntries(pageFiles)), random: seeded(seed) }); // the answers given when it last ran\n      } catch (err) \{\n        if (!(err instanceof FolioError)) throw err;\n        output.classList.add(\"error\");\n        return output.append(`Error: $\{err.message}\\n$\{excerpt(code.value, err)}`); // it didn't compile\n      }\n      $(\"lines\").replaceChildren(...code.value.split(\"\\n\").map((text) => Object.assign(document.createElement(\"li\"), \{ innerHTML: highlight(text) })));\n      $(\"timeline\").max = trace.steps.length - 1;\n      setDebugging(true);\n      show(0);\n    }\n\n    function setDebugging(on) \{\n      $(\"editor\").hidden = on;\n      for (const id of [\"lines\", \"debug-panel\", \"debug-controls\"]) $(id).hidden = !on;\n      $(\"hint\").hidden = on;\n      $(\"statusbar\").classList.toggle(\"debugging\", on);\n      stopButton.disabled = !on;\n      if (on) $(\"step\").focus();\n    }\n\n    function stopDebugging(message) \{\n      if (!trace) return;\n      trace = null;\n      setDebugging(false);\n      status.textContent = message;\n    }\n\n    // Shows recorded step `i`: the line about to run, the variables, and the output and drawing up to then.\n    function show(i) \{\n      const last = trace.steps.length - 1;\n      at = Math.max(0, Math.min(i, last));\n      const s = trace.steps[at];\n      $(\"timeline\").value = at;\n      $(\"position\").textContent = `Step $\{at + 1} of $\{trace.steps.length}$\{trace.cut ? \" (the first steps only)\" : \"\"}`;\n      $(\"back\").disabled = at === 0;\n      $(\"step\").disabled = $(\"end\").disabled = at === last;\n\n      const line = s.error ? s.error.line : s.done ? 0 : s.line;\n      for (const [n, li] of [...$(\"lines\").children].entries()) li.classList.toggle(\"current\", n + 1 === line);\n      const current = $(\"lines\").children[line - 1];\n      if (current) $(\"lines\").scrollTop = current.offsetTop - $(\"lines\").clientHeight / 2; // scroll the code, not the page\n\n      output.textContent = trace.said.slice(0, s.said).map((text) => text + \"\\n\").join(\"\");\n      output.classList.toggle(\"error\", !!s.error);\n      if (s.error) output.append(`Error: $\{s.error.message}\\n$\{excerpt(code.value, s.error)}`);\n      if (s.done && !s.said && !trace.drawn.length) output.append(\"(no output)\");\n      render(trace.drawn.slice(0, s.drawn), trace.drawn); // fit to the whole drawing, so the view doesn't jump\n      const finished = s.stopped === undefined ? \"Finished\" : `Finished: it stopped the program with $\{s.stopped}`;\n      status.textContent = s.error ? `Stopped by a mistake on line $\{line}` : s.done ? finished : `Before line $\{line}`;\n\n      const list = (vars) => (vars.length ? vars.map(([name, value]) => `  $\{name} = $\{value}`).join(\"\\n\") : \"  (nothing yet)\");\n      const calls = []; // \"branch ×8\" rather than eight of them, when a function calls itself\n      for (const name of [\"top level\", ...s.calls.slice(1)]) \{\n        if (calls.at(-1)?.name === name) calls.at(-1).times++;\n        else calls.push(\{ name, times: 1 });\n      }\n      $(\"variables\").textContent = [\n        `Running: $\{calls.map((\{ name, times }) => (times > 1 ? `$\{name} ×$\{times}` : name)).join(\" → \")}`,\n        // innermost first: the running function, the functions it was made inside, then the top level\n        ...s.scopes.flatMap((\{ name, vars }, n) => [\n          n === s.scopes.length - 1 ? \"Top level:\" : n === 0 ? `Inside $\{name}:` : `Remembered from $\{name}:`,\n          list(vars),\n        ]),\n      ].join(\"\\n\");\n    }\n\n    $(\"debug\").onclick = startDebugging;\n    $(\"back\").onclick = () => show(at - 1);\n    $(\"step\").onclick = () => show(at + 1);\n    $(\"end\").onclick = () => show(Infinity);\n    $(\"timeline\").oninput = () => show(Number($(\"timeline\").value));\n\n    stopButton.onclick = () => \{\n      if (trace) return stopDebugging(\"\");\n      output.append(\"(stopped)\");\n      silence();\n      finish(\"Stopped\");\n    };\n\n    // The code travels in the link's #fragment, which browsers never send to a server.\n    $(\"share\").onclick = async () => \{\n      history.replaceState(null, \"\", `#code=$\{encodeURIComponent(code.value)}`);\n      try \{\n        await navigator.clipboard.writeText(location.href);\n        status.textContent = \"Link copied\";\n      } catch \{\n        status.textContent = \"Copy the link from the address bar\";\n      }\n    };\n    // Tidy (format() in folio.js) leaves code with a mistake alone. It puts the tidy code in all at once: the\n    // browser's own undoable way, execCommand(\"insertText\"), does slow work for every line (Chrome took 17\n    // seconds for the compiler's 1,580), so Tidy keeps its own undo: Ctrl+Z puts back the code as it was, as\n    // long as the tidy code hasn't been changed since (or has been undone back to it).\n    let untidy = null; // \{ before, after } the last Tidy\n    $(\"tidy\").onclick = () => \{\n      let tidied;\n      try \{\n        tidied = format(code.value).replace(/\\n$/, \"\");\n      } catch (err) \{\n        status.textContent = err instanceof FolioError ? `Can't tidy it yet: $\{err.message}` : `Couldn't tidy it: $\{err.message}`;\n        return;\n      }\n      if (tidied === code.value) \{\n        status.textContent = \"Already tidy\";\n        return;\n      }\n      untidy = \{ before: code.value, after: tidied };\n      replaceCode(tidied);\n      status.textContent = \"Tidied (Ctrl+Z puts it back)\";\n    };\n    // new text for the editor, keeping the cursor on the line it was on and the view where it was\n    function replaceCode(text) \{\n      const line = code.value.slice(0, code.selectionStart).split(\"\\n\").length;\n      const top = code.scrollTop;\n      code.value = text;\n      const at = text.split(\"\\n\").slice(0, line - 1).reduce((n, l) => n + l.length + 1, 0);\n      code.setSelectionRange(Math.min(at, text.length), Math.min(at, text.length));\n      code.scrollTop = top;\n      code.focus();\n      refreshEditor();\n    }\n    $(\"compiled\").onchange = showCompiled;\n    // WebAssembly runs a program about twice as fast as the JIT, so it's the engine to begin with wherever the\n    // browser has what Folio's WebAssembly uses: its GC's structs, and exceptions (try and catch_all)\n    const wasmReady = (() => \{\n      try \{\n        return WebAssembly.validate(new Uint8Array([0, 97, 115, 109, 1, 0, 0, 0, 1, 3, 1, 0x5f, 0]))\n          && WebAssembly.validate(new Uint8Array([0, 97, 115, 109, 1, 0, 0, 0, 1, 4, 1, 0x60, 0, 0, 3, 2, 1, 0, 10, 8, 1, 6, 0, 0x06, 0x40, 0x19, 0x0b, 0x0b]));\n      } catch \{\n        return false;\n      }\n    })();\n    if (wasmReady) $(\"engine\").value = \"wasm\";\n    // Folio's own compiler as WebAssembly (folio.wasm, DESIGN §144), compiled here once and sent with each run, so\n    // the WebAssembly engine's programs are compiled by Folio itself. Where it can't be fetched (a page folio build\n    // --web made, say), the worker compiles them with wasm.js.\n    let folioWasm = null;\n    if (wasmReady) \{\n      fetch(\"./folio.wasm\").then((answer) => (answer.ok ? answer.arrayBuffer() : null)).then((bytes) => bytes && WebAssembly.compile(bytes))\n        .then((module) => (folioWasm = module ?? null), () => \{});\n    }\n    $(\"engine\").onchange = runCode;\n\n    // Files a program can read, by name, as if they were in its folder: picked with Files, or dropped on the\n    // playground. Each run gets them as they are here, and what it writes lasts only that run. They stay on\n    // this page: nothing is sent anywhere, and a shared link has only the code.\n    const pageFiles = new Map(); // name: bytes\n    const sizeOf = (n) => (n < 1024 ? `$\{n} bytes` : n < 1024 * 1024 ? `$\{(n / 1024).toFixed(1)} KB` : `$\{(n / 1024 / 1024).toFixed(1)} MB`);\n    function showFiles() \{\n      $(\"files-view\").hidden = !pageFiles.size;\n      $(\"files\").replaceChildren(...[...pageFiles].map(([name, bytes]) => \{\n        const li = document.createElement(\"li\");\n        const label = Object.assign(document.createElement(\"span\"), \{ textContent: `$\{name} ` });\n        label.append(Object.assign(document.createElement(\"small\"), \{ textContent: sizeOf(bytes.length) }));\n        li.append(label);\n        if (/\\.(png|bmp)$/i.test(name)) \{ // a picture: a button that puts a line drawing it in the code\n          const line = `draw picture $\{JSON.stringify(name)} at 0, 0`;\n          li.append(Object.assign(document.createElement(\"button\"), \{ type: \"button\", textContent: \"+ draw\", title: `Put '$\{line}' in the code`, onclick: () => \{\n            code.focus();\n            const text = (code.selectionStart && code.value[code.selectionStart - 1] !== \"\\n\" ? \"\\n\" : \"\") + line + \"\\n\";\n            if (!document.execCommand(\"insertText\", false, text)) \{\n              code.setRangeText(text, code.selectionStart, code.selectionEnd, \"end\");\n              refreshEditor();\n            }\n          } }));\n        }\n        li.append(Object.assign(document.createElement(\"button\"), \{ type: \"button\", textContent: \"✕\", title: `Take $\{name} away`, onclick: () => \{\n          pageFiles.delete(name);\n          showFiles();\n        } }));\n        return li;\n      }));\n    }\n    async function addFiles(list) \{\n      const added = [...list];\n      for (const file of added) pageFiles.set(file.name, new Uint8Array(await file.arrayBuffer()));\n      showFiles();\n      if (added.length) status.textContent = `$\{added.length === 1 ? added[0].name : `$\{added.length} files`} added: a program reads $\{added.length === 1 ? \"it\" : \"them\"} by name`;\n    }\n    $(\"add-files\").onclick = () => $(\"file-picker\").click();\n    $(\"file-picker\").onchange = () => addFiles($(\"file-picker\").files).finally(() => ($(\"file-picker\").value = \"\"));\n    const dragsFiles = (e) => e.dataTransfer?.types.includes(\"Files\");\n    $(\"playground\").ondragover = (e) => \{\n      if (!dragsFiles(e)) return; // text dragged into the code goes in as it always did\n      e.preventDefault();\n      e.dataTransfer.dropEffect = \"copy\";\n      $(\"playground\").classList.add(\"dropping\");\n    };\n    $(\"playground\").ondragleave = (e) => $(\"playground\").contains(e.relatedTarget) || $(\"playground\").classList.remove(\"dropping\");\n    $(\"playground\").ondrop = (e) => \{\n      $(\"playground\").classList.remove(\"dropping\");\n      if (!dragsFiles(e)) return;\n      e.preventDefault();\n      addFiles(e.dataTransfer.files);\n    };\n\n    // Some examples are files: two apps, a neural network that learns, the handwriting reader, and the\n    // compiler written in Folio, with a line at the end that uses it.\n    const FILES = \{\n      \"Neural network\": [\"neural.folio\", \"\"],\n      \"Handwriting\": [\"handwriting.folio\", \"\"],\n      \"Snake\": [\"apps/snake.folio\", \"\"],\n      \"Paint\": [\"apps/paint.folio\", \"\"],\n      \"Folio's own compiler\": [\"compiler.folio\", `\\n\\n# The compiler above, compiling a line of Folio to JavaScript:\\nsay js of compile(\"say 1 + 2\")\\n`],\n    };\n    const [first, second, ...rest] = Object.keys(examples);\n    picker.append(...[first, second, \"Snake\", \"Paint\", \"Neural network\", \"Handwriting\", ...rest, \"Folio's own compiler\"].map((name) => new Option(name)));\n    picker.onchange = async () => \{\n      const name = picker.value;\n      let text;\n      try \{\n        text = Object.hasOwn(FILES, name) ? (await fetchText(FILES[name][0])).trimEnd() + FILES[name][1] : examples[name];\n      } catch (err) \{\n        status.textContent = `Couldn't load that example ($\{err.message})`;\n        return;\n      }\n      if (name !== picker.value) return; // another example was picked while this one loaded\n      code.value = text;\n      refreshEditor();\n      runCode();\n    };\n    $(\"run\").onclick = runCode;\n    code.onkeydown = (e) => \{\n      if (e.key === \"Enter\" && (e.ctrlKey || e.metaKey)) \{\n        e.preventDefault();\n        runCode();\n      }\n      // Tidy's own undo (see Tidy): only while the code is just as Tidy left it\n      if (e.key.toLowerCase() === \"z\" && (e.ctrlKey || e.metaKey) && !e.shiftKey && untidy?.after === code.value) \{\n        e.preventDefault();\n        replaceCode(untidy.before);\n        untidy = null;\n        status.textContent = \"Put back as it was before Tidy\";\n      }\n    };\n    const SAMPLE = [\n      'set guests to list of \"Ada\", \"Grace\", \"Alan\"',\n      \"for each guest in guests\",\n      \"    if length of guest is at least 4\",\n      '        say \"Welcome, \" guest \"!\"',\n      \"    else\",\n      '        say \"Hi, \" guest',\n      \"    end\",\n      \"end\",\n    ].join(\"\\n\");\n    $(\"sample\").innerHTML = highlight(SAMPLE);\n    const sampleSaid = [];\n    run(SAMPLE, (line) => sampleSaid.push(line));\n    $(\"sample-said\").textContent = sampleSaid.join(\"\\n\");\n    const toPlayground = () => $(\"playground\").scrollIntoView(\{ behavior: matchMedia(\"(prefers-reduced-motion: reduce)\").matches ? \"auto\" : \"smooth\" });\n    $(\"try-sample\").onclick = () => \{\n      code.value = SAMPLE;\n      picker.selectedIndex = -1;\n      refreshEditor();\n      runCode();\n      toPlayground();\n    };\n    for (const shot of $(\"gallery\").children) \{\n      shot.onclick = () => \{\n        picker.value = shot.dataset.example;\n        picker.onchange();\n        toPlayground();\n      };\n    }\n\n    // A page `folio build --web` made holds one program, and the files it uses, in window.FOLIO_APP: it shows\n    // only what the program says and draws, and runs it at once.\n    const app = window.FOLIO_APP;\n    let shared = null;\n    try \{\n      if (!app && location.hash.startsWith(\"#code=\")) shared = decodeURIComponent(location.hash.slice(\"#code=\".length));\n    } catch \{} // a broken link just opens the first example\n    if (app) \{\n      document.body.classList.add(\"app\");\n      document.title = app.name;\n      for (const [name, text] of Object.entries(app.files)) usedFiles.set(name, text);\n      code.value = app.source;\n      runCode();\n    } else if (shared === null) picker.onchange();\n    else \{\n      code.value = shared;\n      picker.selectedIndex = -1;\n      refreshEditor();\n      runCode();\n      $(\"playground\").scrollIntoView(\{ behavior: \"instant\" }); // someone shared code: show it, not the front page\n    }\n  </script>\n</body>\n</html>\n"
end
