# Random numbers for secrets, as Python's secrets module has them: bytes no one can guess, from the system
# (BCryptGenRandom on Windows, getrandom on Linux), for passwords, keys and tokens, where `random number`
# (which a program can make repeat) won't do. A program `folio build` makes can use it, built with
# --allow-libraries.
#
#   use "secrets.folio" as secrets
#   say secrets's random_bytes(16)       # (16 bytes: ...)
#   say secrets's token_hex(16)          # 32 hex digits
#   say secrets's token_url(16)          # about 22 letters that can go in an address
#   say secrets's below(6) + 1           # 1 to 6, each as likely
#   say secrets's choice(list of "red", "green", "blue")
#   say secrets's shuffled(list of 1, 2, 3, 4)
#   say secrets's same_secret(given, kept)   # compares without taking longer where they first differ

use the library "bcrypt"
    "BCryptGenRandom" as secrets_windows_random(a pointer, bytes, a whole number, a whole number) gives a whole number
end
use the library "c"
    "getrandom" as secrets_unix_random(bytes, a long whole number, a whole number) gives a long whole number
end
use "base64.folio" as secrets_b64

set secrets_hex to "0123456789abcdef"

# n bytes from the system's own source of randomness
to random_bytes with n
    if not (n is divisible by 1) or n is less than 0
        fail with "random_bytes needs a whole number of bytes from 0 up, not " + n
    end
    set made to n bytes
    if n is 0
        return made
    end
    try
        if secrets_windows_random(nothing, made, n, 2) is 0 # BCRYPT_USE_SYSTEM_PREFERRED_RNG
            return made
        end
    if it fails
        set made to made # not Windows: Linux's own, below
    end
    set got to 0
    repeat while got is less than n # getrandom gives up to 33 MB at once, and may give fewer if a signal comes
        set room to (n - got) bytes
        set given to secrets_unix_random(room, n - got, 0)
        if given is less than 1
            fail with "the system wouldn't give random bytes"
        end
        for each k from 1 to given
            set byte (got + k) of made to byte k of room
        end
        set got to got + given
    end
    return made
end

# n random bytes as hex, 2 digits each
to token_hex with n
    set made to empty list
    for each b in random_bytes(n)
        add item ((shift b right by 4) + 1) of secrets_hex + item ((b bit and 15) + 1) of secrets_hex to made
    end
    return join made with ""
end

# n random bytes as URL-safe base64, without its = at the end, as Python's token_urlsafe
to token_url with n
    set made to secrets_b64's url_base64_of(random_bytes(n))
    repeat while length of made is greater than 0 and item (length of made) of made is "="
        set made to items 1 to (length of made - 1) of made
    end
    return made
end

# a whole number from 0 to n - 1, each as likely: random bytes, again when they'd make one more likely
to below with n
    if not (n is divisible by 1) or n is less than 1 or n is greater than 281474976710656
        fail with "below needs a whole number from 1 to 2^48, not " + n
    end
    set size to 1
    set span to 256
    repeat while span is less than n
        set size to size + 1
        set span to span * 256
    end
    set limit to span - remainder of span divided by n # values from here up would favour the smallest
    repeat while yes
        set v to 0
        for each b in random_bytes(size)
            set v to v * 256 + b
        end
        if v is less than limit
            return remainder of v divided by n
        end
    end
end

# one of the list's things, each as likely, chosen so no one can guess which
to choice with items_given
    if length of items_given is 0
        fail with "choice needs something to choose from: the list is empty"
    end
    return item (below(length of items_given) + 1) of items_given
end

# a copy of the list in an order no one can guess (Fisher and Yates')
to shuffled with items_given
    set made to empty list
    for each x in items_given
        add x to made
    end
    set k to length of made
    repeat while k is greater than 1
        set j to below(k) + 1
        set kept to item k of made
        set item k of made to item j of made
        set item j of made to kept
        set k to k - 1
    end
    return made
end

# whether two texts or bytes are the same, taking as long however much of them is: so a password or token
# checked this way says nothing, by how long it takes, about how much of it was right
to same_secret with a, b
    set x to a as bytes
    set y to b as bytes
    set differ to 0
    if length of x is not length of y
        set differ to 1
        set y to x
    end
    for each k from 1 to length of x
        set differ to differ bit or (byte k of x bit xor byte k of y)
    end
    return differ is 0
end
