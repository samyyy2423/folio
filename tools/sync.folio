# Tasks taking turns, as Python's threading, queue and concurrent.futures have it: a lock that one task holds
# at a time, a semaphore that a few can, a flag that tasks wait to see raised, a queue that one task sends to
# and another takes from, and many calls run as tasks. In Folio alone, so it works everywhere.
#
#   use "sync.folio" as sync
#   set guard to sync's lock()
#   set balance to 0
#   to deposit with amount
#       sync's take(guard)
#       set balance to balance + amount     # one task at a time in here
#       sync's let_go(guard)
#   end
#
#   set jobs to sync's queue()              # or queue_holding(10): send waits while 10 are waiting
#   to worker
#       repeat while yes
#           set job to sync's receive(jobs)     # waits for one
#           if job is nothing
#               return "done"
#           end
#           deposit(job)
#       end
#   end
#   set w to start worker()
#   sync's send(jobs, 5)
#   sync's send(jobs, nothing)
#   say wait for w                          # done
#
#   say sync's run_each(slow_square, list of 1, 2, 3)   # [1, 4, 9]: a task for each, waited for in order
#
# take_within(lock, 50) waits at most 50 milliseconds and says whether it took the lock; receive_within(queue,
# 50) fails, with "nothing came in 50 milliseconds", if nothing came. A flag is raised and lowered, and
# wait_for_flag waits until it's raised. wait_for_all(jobs) gives what each task gave, and wait_for_any(jobs)
# the first of them to end. `job has ended` asks without waiting.
#
# Workers (`start f(x) on another core`, DESIGN §124) share nothing: each is given copies, so a lock, flag or
# queue given to one, or among the program's variables it starts with, is its own, and keeps its own tasks in
# step. wait_for_all and wait_for_any take workers as they take tasks.
#
# One task runs Folio at a time, and a task only lets the others run at a loop's end, a call or a wait, so
# what's between those happens with nothing else running: a lock is taken by seeing it's free and marking it
# held, with nothing in between. That's why take and receive do their work themselves, with no call. On the
# JavaScript engines a task runs to its end when it's started, so a task there that waits for what the program
# does after starting it waits for ever, and take_within and receive_within give up when their time is up.

# ---------- locks and semaphores ----------

# a lock: one task at a time holds it
to lock
    return record with free 1, most 1
end

# a semaphore: up to n tasks hold it at once
to semaphore with n
    if n is less than 1 or n rounded down is not n
        fail with "a semaphore is for 1 or more tasks at once, not " + n
    end
    return record with free n, most n
end

# waits until the lock (or a semaphore's place) is free, and takes it
to take with guard
    repeat while free of guard is 0
        wait 1 millisecond
    end
    set free of guard to free of guard - 1
end

# as take, waiting at most so many milliseconds: whether it took it
to take_within with guard, ms
    set deadline to the clock + ms / 1000
    repeat while free of guard is 0
        if the clock is at least deadline
            return no
        end
        wait 1 millisecond
    end
    set free of guard to free of guard - 1
    return yes
end

# takes it if it's free now: whether it did
to take_if_free with guard
    if free of guard is 0
        return no
    end
    set free of guard to free of guard - 1
    return yes
end

# the lock (or a semaphore's place) let go, for a task waiting for it to take; a mistake if it isn't held
to let_go with guard
    if free of guard is most of guard
        fail with "the lock isn't held, so it can't be let go"
    end
    set free of guard to free of guard + 1
end

# whether a lock is held: for a semaphore, whether every place is
to is_held with guard
    return free of guard is 0
end

# a function called holding the lock, let go after, even if the function fails: what the function gave
to holding with guard, work
    take(guard)
    try
        set gave to work()
    if it fails with why
        let_go(guard)
        fail with why
    end
    let_go(guard)
    return gave
end

# ---------- flags ----------

# a flag: tasks can wait until it's raised
to flag
    return record with raised no
end

# the flag raised: every task waiting for it goes on
to raise_flag with f
    set raised of f to yes
end

# the flag lowered, so wait_for_flag waits again
to lower_flag with f
    set raised of f to no
end

# whether the flag is raised
to is_raised with f
    return raised of f
end

# waits until the flag is raised, letting other tasks run meanwhile
to wait_for_flag with f
    repeat while not raised of f
        wait 1 millisecond
    end
end

# as wait_for_flag, waiting at most so many milliseconds: whether it was raised
to wait_for_flag_within with f, ms
    set deadline to the clock + ms / 1000
    repeat while not raised of f
        if the clock is at least deadline
            return no
        end
        wait 1 millisecond
    end
    return yes
end

# ---------- queues ----------

# A queue keeps what's sent in a dictionary, by where each is: from `first` to `last`.
to queue
    return record with slots empty dictionary, first 1, last 0, most 0
end

# a queue that holds at most n: send waits while n are waiting
to queue_holding with n
    if n is less than 1 or n rounded down is not n
        fail with "a queue holds 1 or more, not " + n
    end
    return record with slots empty dictionary, first 1, last 0, most n
end

# at the back, once there's room
to send with q, x
    if most of q is greater than 0
        repeat while last of q - first of q + 1 is at least most of q
            wait 1 millisecond
        end
    end
    set last of q to last of q + 1
    set kept to slots of q
    set item (last of q) of kept to x
end

# the first sent of those waiting, once there's one
to receive with q
    repeat while last of q is less than first of q
        wait 1 millisecond
    end
    set kept to slots of q
    set x to item (first of q) of kept
    remove (first of q) from kept
    set first of q to first of q + 1
    return x
end

# as receive, waiting at most so many milliseconds
to receive_within with q, ms
    set deadline to the clock + ms / 1000
    repeat while last of q is less than first of q
        if the clock is at least deadline
            fail with "nothing came in " + ms + " milliseconds"
        end
        wait 1 millisecond
    end
    set kept to slots of q
    set x to item (first of q) of kept
    remove (first of q) from kept
    set first of q to first of q + 1
    return x
end

# how many are waiting to be received
to waiting with q
    return last of q - first of q + 1
end

# whether the queue has nothing waiting
to is_empty with q
    return last of q is less than first of q
end

# ---------- many tasks ----------

# what each task gave, in order, once they've all ended
to wait_for_all with jobs
    set gave to empty list
    for each job in jobs
        add (wait for job) to gave
    end
    return gave
end

# the first of the tasks to end (the first in the list, if several have)
to wait_for_any with jobs
    if length of jobs is 0
        fail with "wait_for_any needs a task to wait for"
    end
    repeat while yes
        for each job in jobs
            if job has ended
                return job
            end
        end
        wait 1 millisecond
    end
end

# how many of the tasks have ended
to ended_count with jobs
    set n to 0
    for each job in jobs
        if job has ended
            set n to n + 1
        end
    end
    return n
end

# the function called with each thing, each in a task of its own: what each gave, in order
to run_each with work, things
    set jobs to empty list
    for each thing in things
        add (start work(thing)) to jobs
    end
    return wait_for_all(jobs)
end

# as run_each, with at most n tasks running at once
to run_each_at_most with work, things, n
    if n is less than 1 or n rounded down is not n
        fail with "run_each_at_most runs 1 or more at once, not " + n
    end
    set jobs to empty list
    set gave to empty list
    set waited to 0
    for each thing in things
        if length of jobs - waited is at least n
            set waited to waited + 1
            add (wait for item waited of jobs) to gave
        end
        add (start work(thing)) to jobs
    end
    repeat while waited is less than length of jobs
        set waited to waited + 1
        add (wait for item waited of jobs) to gave
    end
    return gave
end
