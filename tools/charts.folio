    "CAAAACD9DwAAAAD5HwAAAAD4LwAAAAD3bwAAAAD0/28AAABg/W8AAM8AAM8AAM8AAM8AAM8AAM8AAM8AAM8AAM8AAM8AAM8AAM8A",
    "AM8AAM8AAM8AAM8AAP+dAQAAAP//CQAAACD+DQAAAAD7DwAAAAD6DwAAAAD6HwAAAAD4fwEAAADC/28AAADT/28AAAD5bwEAAAD6",
    "DwAAAAD7DwAAACD9DgAAAP//CgAAAP+uAQAAAAAAAAAAAADF30kRpgBA/////78AQDogx94ZABAAAAAAAAAAAAAAAAAAAAAAAAAA",
    "AA=="

# the colours: what charts are drawn on, text, lines under the marks, and the series' own, in this order
set chart_surface to "#fcfcfb"
set chart_ink to "#0b0b0b"
set chart_soft_ink to "#52514e"
set chart_grid to "#e1e0d9"
set chart_series to list of "#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"
set chart_fonts to nothing

# ---------- making charts ----------

# the values as series: a list of numbers is one, a dictionary of lists one for each key
to series_of with title, labels, values
    set made to empty list
    set names to nothing
    try
        set names to keys of values
    if it fails
        set names to nothing
    end
    if names is nothing
        add (record with name title, values values) to made
    else
        for each name in names
            add (record with name name, values item name of values) to made
        end
    end
    if length of made is greater than 8
        fail with "a chart shows at most 8 series: put the rest together in one called Other"
    end
    for each one in made
        if length of values of one is not length of labels
            fail with "'" + name of one + "' has " + length of values of one + " numbers for " + length of labels + " labels"
        end
    end
    return made
end

to new_chart with kind_of_it, title, labels, values, height
    if length of labels is 0
        fail with "a chart needs at least one label, and a number for it"
    end
    return record with kind kind_of_it, title title, labels labels, series series_of(title, labels, values), width 720, height height
end

# a bar chart: a title, the labels along the bottom, and the values, a list of numbers or a dictionary of
# lists, a series for each key
to bar_chart with title, labels, values
    return new_chart("bars", title, labels, values, 440)
end

# a line chart: a title, the labels along the bottom, and the values, a list of numbers or a dictionary of
# lists, a line for each key
to line_chart with title, labels, values
    return new_chart("lines", title, labels, values, 440)
end

# one whole split into its parts, a segment each, as wide as its share
to parts_chart with title, labels, values
    set made to new_chart("parts", title, labels, values, 200)
    if length of series of made is not 1
        fail with "a parts chart splits one whole: give it a list of numbers"
    end
    set whole to 0
    for each v in values
        if v is less than 0
            fail with "a parts chart's parts are 0 or more, not " + v
        end
        set whole to whole + v
    end
    if whole is 0
        fail with "a parts chart's parts add up to more than 0"
    end
    return made
end

# the same chart, another size in pixels (720 by 440 to begin with)
to sized with chart, width, height
    return record with kind kind of chart, title title of chart, labels labels of chart, series series of chart, width width, height height
end

# the chart written to a file: .svg or .png, by the name's end
to save with chart, path
    set lowered to lowercase of path
    set n to length of lowered
    if n is greater than 4 and items (n - 3) to n of lowered is ".svg"
        write svg_of(chart) to path
    else if n is greater than 4 and items (n - 3) to n of lowered is ".png"
        write png_of(chart) to path
    else
        fail with "a chart is saved as .svg or .png, not '" + path + "'"
    end
end

# ---------- letters ----------

# DejaVu's letters, read once: each one's advance, where its ink is, and the ink, 4 bits a pixel
to fonts
    if chart_fonts is nothing
        set chart_fonts to record with small font_of(chart_font_13), big font_of(chart_font_16)
    end
    return chart_fonts
end

to font_of with lines
    set data to chart_b64's bytes_of_base64(join lines with "")
    set count to byte 6 of data + byte 7 of data * 256
    set glyphs to empty dictionary
    for each k from 0 to count - 1
        set at to 8 + k * 12
        set up to byte (at + 6) of data
        if up is at least 128
            set up to up - 256
        end
        set left_side to byte (at + 5) of data
        if left_side is at least 128
            set left_side to left_side - 256
        end
        set code to byte at of data + byte (at + 1) of data * 256
        set item code of glyphs to record with advance (byte (at + 3) of data + byte (at + 4) of data * 256) / 64, left left_side, up up, wide byte (at + 7) of data, high byte (at + 8) of data, start byte (at + 9) of data + byte (at + 10) of data * 256 + byte (at + 11) of data * 65536
    end
    return record with glyphs glyphs, ink data, ink_at 7 + count * 12, ascent byte 4 of data
end

to glyph_of with font, c
    set code to (c as bytes)
    set n to 63
    if length of code is 1
        set n to byte 1 of code
    end
    if not (n is in glyphs of font)
        set n to 63
    end
    return item n of glyphs of font
end

to font_for with size
    if size is greater than 14
        return big of fonts()
    end
    return small of fonts()
end

# how wide text is, in pixels, at a size
to width_of with words, size
    set font to font_for(size)
    set total_width to 0
    for each c in words
        set total_width to total_width + advance of glyph_of(font, c)
    end
    return total_width
end

# ---------- numbers on an axis ----------

# a step for about 5 lines between lo and hi: 1, 2 or 5 times a power of 10
to nice_step with lo, hi
    set raw to (hi - lo) / 5
    set p to 1
    repeat while p * 10 is at most raw
        set p to p * 10
    end
    repeat while p is greater than raw
        set p to p / 10
    end
    for each m in list of 1, 2, 5, 10
        if m * p is at least raw
            return m * p
        end
    end
    return 10 * p
end

# a number as an axis says it: in full under 10,000 (with commas), else 10K, 1.5M
to axis_text with v, compact
    if compact
        set size_of_it to v
        if size_of_it is less than 0
            set size_of_it to 0 - size_of_it
        end
        if size_of_it is at least 1000000000
            return "" + v / 1000000000 + "B"
        else if size_of_it is at least 1000000
            return "" + v / 1000000 + "M"
        else if size_of_it is at least 1000
            return "" + v / 1000 + "K"
        end
        return "" + v
    end
    return with_commas(v)
end

to with_commas with v
    set written to "" + v
    set sign to ""
    if item 1 of written is "-"
        set sign to "-"
        set written to items 2 to (length of written) of written
    end
    set dot to position of "." in written
    set whole_part to written
    set rest to ""
    if dot is greater than 0
        set whole_part to items 1 to (dot - 1) of written
        set rest to items dot to (length of written) of written
    end
    set made to ""
    set k to length of whole_part
    set counted to 0
    repeat while k is at least 1
        if counted is 3
            set made to "," + made
            set counted to 0
        end
        set made to item k of whole_part + made
        set counted to counted + 1
        set k to k - 1
    end
    return sign + made + rest
end

# ---------- laying out: shapes and text, for SVG and PNG alike ----------

to shape_rect with x, y, w, h, colour, rounding, tip
    return record with kind "rect", x x, y y, w w, h h, colour colour, rounding rounding, tip tip
end

to shape_line with x1, y1, x2, y2, colour
    return record with kind "line", x1 x1, y1 y1, x2 x2, y2 y2, colour colour
end

to shape_text with x, y, words, size, colour, anchor
    return record with kind "text", x x, y y, words words, size size, colour colour, anchor anchor
end

# the chart as shapes, each a record: rect, line (a hairline), path (a 2-pixel line through points), dot, text
to shapes_of with chart
    set made to empty list
    set w to width of chart
    set h to height of chart
    add shape_text(16, 30, title of chart, 16, chart_ink, "start") to made
    set top_edge to 52
    set many to length of series of chart is greater than 1 or kind of chart is "parts"
    if many # a legend: a square of each colour and its name, in a row
        set x to 16
        set names to empty list
        if kind of chart is "parts"
            set names to labels of chart
        else
            for each one in series of chart
                add name of one to names
            end
        end
        for each k from 1 to length of names
            add shape_rect(x, top_edge - 10, 12, 12, item k of chart_series, "all", nothing) to made
            add shape_text(x + 18, top_edge, "" + item k of names, 13, chart_soft_ink, "start") to made
            set x to x + 18 + width_of("" + item k of names, 13) + 20
        end
        set top_edge to top_edge + 28
    end
    if kind of chart is "parts"
        return parts_shapes(chart, made, top_edge)
    end
    # the axis: from 0 or below to the largest, in nice steps
    set lo to 0
    set hi to 0
    for each one in series of chart
        for each v in values of one
            if v is less than lo
                set lo to v
            end
            if v is greater than hi
                set hi to v
            end
        end
    end
    if hi is lo
        set hi to lo + 1
    end
    set step to nice_step(lo, hi)
    set axis_lo to ((lo / step) rounded down) * step
    set axis_hi to ((hi / step) rounded up) * step
    set compact to axis_hi is at least 10000 or axis_lo is at most -10000
    set ticks to empty list
    set t to axis_lo
    repeat while t is at most axis_hi + step / 1000
        add t to ticks
        set t to t + step
    end
    set widest to 0
    for each tick in ticks
        set tw to width_of(axis_text(tick, compact), 13)
        if tw is greater than widest
            set widest to tw
        end
    end
    set left_edge to 16 + widest + 10
    set right_edge to w - 16
    if kind of chart is "lines" and length of series of chart is at most 4 and many # room for each line's name at its end
        set widest_name to 0
        for each one in series of chart
            set nw to width_of("" + name of one, 13)
            if nw is greater than widest_name
                set widest_name to nw
            end
        end
        set right_edge to w - 16 - widest_name - 12
    end
    set bottom_edge to h - 36
    set plot to record with left left_edge, right right_edge, top top_edge, bottom bottom_edge, lo axis_lo, hi axis_hi
    for each tick in ticks
        set ty to y_of(plot, tick)
        add shape_line(left_edge, ty, right_edge, ty, chart_grid) to made
        add shape_text(left_edge - 8, ty + 4, axis_text(tick, compact), 13, chart_soft_ink, "end") to made
    end
    # the labels under it, every one that fits
    set n to length of labels of chart
    set band to (right_edge - left_edge) / n
    set widest_label to 0
    for each label in labels of chart
        set lw to width_of("" + label, 13)
        if lw is greater than widest_label
            set widest_label to lw
        end
    end
    set every_nth to 1
    repeat while every_nth * band is less than widest_label + 8
        set every_nth to every_nth + 1
    end
    for each k from 0 to n - 1
        if remainder of k divided by every_nth is 0
            add shape_text(left_edge + band * (k + 0.5), bottom_edge + 22, "" + item (k + 1) of labels of chart, 13, chart_soft_ink, "middle") to made
        end
    end
    if kind of chart is "bars"
        return bar_shapes(chart, made, plot, band)
    end
    return line_shapes(chart, made, plot, band, many)
end

to y_of with plot, v
    return bottom of plot - (v - lo of plot) / (hi of plot - lo of plot) * (bottom of plot - top of plot)
end

# a bar for each series in each label's band, side by side, 2 pixels apart, at most 24 wide, from 0
to bar_shapes with chart, made, plot, band
    set s to length of series of chart
    set thick to (band * 0.8 - 2 * (s - 1)) / s
    if thick is greater than 24
        set thick to 24
    end
    if thick is less than 1
        set thick to 1
    end
    set group to s * thick + 2 * (s - 1)
    set base to y_of(plot, 0)
    for each k from 0 to length of labels of chart - 1
        set x to left of plot + band * k + (band - group) / 2
        for each j from 1 to s
            set one to item j of series of chart
            set v to item (k + 1) of values of one
            set vy to y_of(plot, v)
            set tip to "" + item (k + 1) of labels of chart + ": " + with_commas(v)
            if s is greater than 1
                set tip to name of one + ", " + tip
            end
            if v is at least 0
                add shape_rect(x, vy, thick, base - vy, item j of chart_series, "top", tip) to made
            else
                add shape_rect(x, base, thick, vy - base, item j of chart_series, "bottom", tip) to made
            end
            set x to x + thick + 2
        end
    end
    return made
end

# a 2-pixel line for each series through its labels' bands, a dot at its end, and its name there too
to line_shapes with chart, made, plot, band, many
    set ends to empty list
    set j to 0
    for each one in series of chart
        set j to j + 1
        set points to empty list
        for each k from 0 to length of values of one - 1
            add list of left of plot + band * (k + 0.5), y_of(plot, item (k + 1) of values of one) to points
        end
        add (record with kind "path", points points, colour item j of chart_series) to made
        set last_point to item (length of points) of points
        set tip to "" + item (length of labels of chart) of labels of chart + ": " + with_commas(item (length of values of one) of values of one)
        if many
            set tip to name of one + ", " + tip
        end
        add (record with kind "dot", x item 1 of last_point, y item 2 of last_point, colour item j of chart_series, tip tip) to made
        add (record with name "" + name of one, x item 1 of last_point + 10, y item 2 of last_point + 4) to ends
    end
    if many and length of series of chart is at most 4 # names at the ends, kept 14 apart
        set ends to ends in order by y
        for each k from 2 to length of ends
            set before to item (k - 1) of ends
            set here to item k of ends
            if y of here - y of before is less than 14
                set y of here to y of before + 14
            end
        end
        for each e in ends
            add shape_text(x of e, y of e, name of e, 13, chart_soft_ink, "start") to made
        end
    end
    return made
end

# one bar across, 40 high, a segment for each part as wide as its share, 2 pixels apart, its share under it
to parts_shapes with chart, made, top_edge
    set values to values of item 1 of series of chart
    set whole to 0
    for each v in values
        set whole to whole + v
    end
    set left_edge to 16
    set full to width of chart - 32
    set x to left_edge
    set y to top_edge + 8
    for each k from 1 to length of values
        set v to item k of values
        set part_width to full * v / whole
        set shown_width to part_width
        if k is less than length of values
            set shown_width to part_width - 2
        end
        set share to (v / whole * 100) rounded
        if shown_width is greater than 0
            add shape_rect(x, y, shown_width, 40, item k of chart_series, "none", "" + item k of labels of chart + ": " + with_commas(v) + " (" + share + "%)") to made
        end
        if part_width is at least width_of(share + "%", 13) + 4
            add shape_text(x, y + 60, share + "%", 13, chart_soft_ink, "start") to made
        end
        set x to x + part_width
    end
    return made
end

# ---------- SVG ----------

to svg_number with v
    return "" + (((v * 100) rounded) / 100)
end

to svg_escaped with words
    set made to ""
    for each c in "" + words
        if c is "&"
            set made to made + "&amp;"
        else if c is "<"
            set made to made + "&lt;"
        else if c is ">"
            set made to made + "&gt;"
        else if c is "\""
            set made to made + "&quot;"
        else
            set made to made + c
        end
    end
    return made
end

# a bar's outline: square at its base, its other end's corners rounded 4 pixels
to bar_path with s
    set r to 4
    if r is greater than w of s / 2
        set r to w of s / 2
    end
    if r is greater than h of s
        set r to h of s
    end
    set x to x of s
    set y to y of s
    set x2 to x + w of s
    set y2 to y + h of s
    if rounding of s is "top"
        return "M" + svg_number(x) + " " + svg_number(y2) + "V" + svg_number(y + r) + "Q" + svg_number(x) + " " + svg_number(y) + " " + svg_number(x + r) + " " + svg_number(y) + "H" + svg_number(x2 - r) + "Q" + svg_number(x2) + " " + svg_number(y) + " " + svg_number(x2) + " " + svg_number(y + r) + "V" + svg_number(y2) + "Z"
    end
    return "M" + svg_number(x) + " " + svg_number(y) + "V" + svg_number(y2 - r) + "Q" + svg_number(x) + " " + svg_number(y2) + " " + svg_number(x + r) + " " + svg_number(y2) + "H" + svg_number(x2 - r) + "Q" + svg_number(x2) + " " + svg_number(y2) + " " + svg_number(x2) + " " + svg_number(y2 - r) + "V" + svg_number(y) + "Z"
end

to svg_tip with tip
    if tip is nothing
        return ""
    end
    return "<title>" + svg_escaped(tip) + "</title>"
end

# the chart as an SVG file's text: sharp at any size, each mark saying its value when the mouse is on it
to svg_of with chart
    set w to width of chart
    set h to height of chart
    set parts to list of "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" + w + "\" height=\"" + h + "\" viewBox=\"0 0 " + w + " " + h + "\" font-family=\"DejaVu Sans, Verdana, sans-serif\">"
    add "<title>" + svg_escaped(title of chart) + "</title>" to parts
    add "<rect width=\"" + w + "\" height=\"" + h + "\" fill=\"" + chart_surface + "\"/>" to parts
    for each s in shapes_of(chart)
        set what to kind of s
        if what is "rect" and (rounding of s is "top" or rounding of s is "bottom")
            add "<path d=\"" + bar_path(s) + "\" fill=\"" + colour of s + "\">" + svg_tip(tip of s) + "</path>" to parts
        else if what is "rect"
            set corner to "0"
            if rounding of s is "all"
                set corner to "2"
            end
            add "<rect x=\"" + svg_number(x of s) + "\" y=\"" + svg_number(y of s) + "\" width=\"" + svg_number(w of s) + "\" height=\"" + svg_number(h of s) + "\" rx=\"" + corner + "\" fill=\"" + colour of s + "\">" + svg_tip(tip of s) + "</rect>" to parts
        else if what is "line"
            add "<line x1=\"" + svg_number(x1 of s) + "\" y1=\"" + svg_number(y1 of s) + "\" x2=\"" + svg_number(x2 of s) + "\" y2=\"" + svg_number(y2 of s) + "\" stroke=\"" + colour of s + "\" stroke-width=\"1\" shape-rendering=\"crispEdges\"/>" to parts
        else if what is "path"
            set written to empty list
            for each p in points of s
                add svg_number(item 1 of p) + "," + svg_number(item 2 of p) to written
            end
            add "<polyline points=\"" + (join written with " ") + "\" fill=\"none\" stroke=\"" + colour of s + "\" stroke-width=\"2\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>" to parts
        else if what is "dot"
            add "<circle cx=\"" + svg_number(x of s) + "\" cy=\"" + svg_number(y of s) + "\" r=\"5\" fill=\"" + colour of s + "\" stroke=\"" + chart_surface + "\" stroke-width=\"2\">" + svg_tip(tip of s) + "</circle>" to parts
        else
            set weight to ""
            if size of s is greater than 14
                set weight to " font-weight=\"bold\""
            end
            add "<text x=\"" + svg_number(x of s) + "\" y=\"" + svg_number(y of s) + "\" font-size=\"" + size of s + "\"" + weight + " fill=\"" + colour of s + "\" text-anchor=\"" + anchor of s + "\">" + svg_escaped(words of s) + "</text>" to parts
        end
    end
    add "</svg>" to parts
    return (join parts with "\n") + "\n"
end

# ---------- PNG ----------

to colour_numbers with hex_text
    set digits to "0123456789abcdef"
    set made to empty list
    for each k from 0 to 2
        set high to (position of (item (2 + k * 2) of hex_text) in digits) - 1
        set low to (position of (item (3 + k * 2) of hex_text) in digits) - 1
        add high * 16 + low to made
    end
    return made
end

# a pixel's colour moved toward `colour` by `amount`, from 0 (none) to 1 (all of it)
to blend with canvas, x, y, colour, amount
    if x is less than 0 or y is less than 0 or x is at least width of canvas or y is at least height of canvas or amount is at most 0
        return nothing
    end
    set kept to pixels of canvas
    set at to (y * width of canvas + x) * 4
    if amount is at least 1
        set byte (at + 1) of kept to item 1 of colour
        set byte (at + 2) of kept to item 2 of colour
        set byte (at + 3) of kept to item 3 of colour
        return nothing
    end
    for each c from 1 to 3
        set old to byte (at + c) of kept
        set byte (at + c) of kept to (old + (item c of colour - old) * amount) rounded
    end
end

to clamped with v
    if v is less than 0
        return 0
    end
    if v is greater than 1
        return 1
    end
    return v
end

# how much of the pixel at px, py a rect covers, its rounded corners smoothed
to rect_cover with s, px, py, r
    set cx to px + 0.5
    set cy to py + 0.5
    set across to clamped(cx - x of s + 0.5) * clamped(x of s + w of s - cx + 0.5)
    set down to clamped(cy - y of s + 0.5) * clamped(y of s + h of s - cy + 0.5)
    set covered to across * down
    if r is 0 or covered is 0
        return covered
    end
    set rounded_top to rounding of s is "top" or rounding of s is "all"
    set rounded_bottom to rounding of s is "bottom" or rounding of s is "all"
    set corner_x to nothing
    if cx is less than x of s + r
        set corner_x to x of s + r
    else if cx is greater than x of s + w of s - r
        set corner_x to x of s + w of s - r
    end
    set corner_y to nothing
    if rounded_top and cy is less than y of s + r
        set corner_y to y of s + r
    else if rounded_bottom and cy is greater than y of s + h of s - r
        set corner_y to y of s + h of s - r
    end
    if corner_x is nothing or corner_y is nothing
        return covered
    end
    set d to chart_math's sqrt((cx - corner_x) * (cx - corner_x) + (cy - corner_y) * (cy - corner_y))
    return covered * clamped(r + 0.5 - d)
end

to draw_rect with canvas, s
    set r to 0
    if rounding of s is "top" or rounding of s is "bottom"
        set r to 4
    else if rounding of s is "all"
        set r to 2
    end
    if r is greater than w of s / 2
        set r to w of s / 2
    end
    if r is greater than h of s
        set r to h of s
    end
    set colour to colour_numbers(colour of s)
    for each py from ((y of s) rounded down) to ((y of s + h of s) rounded up)
        for each px from ((x of s) rounded down) to ((x of s + w of s) rounded up)
            blend(canvas, px, py, colour, rect_cover(s, px, py, r))
        end
    end
end

# how far a point is from the segment from a to b
to distance_to_segment with px, py, ax, ay, bx, by
    set dx to bx - ax
    set dy to by - ay
    set along to 0
    set length_squared to dx * dx + dy * dy
    if length_squared is greater than 0
        set along to clamped(((px - ax) * dx + (py - ay) * dy) / length_squared)
    end
    set nx to ax + along * dx - px
    set ny to ay + along * dy - py
    return chart_math's sqrt(nx * nx + ny * ny)
end

to draw_path with canvas, s
    set colour to colour_numbers(colour of s)
    set points to points of s
    set covered to empty dictionary # each pixel drawn once, at the most any segment covers it
    for each k from 1 to length of points - 1
        set a to item k of points
        set b to item (k + 1) of points
        set x_from to (minimum_of(item 1 of a, item 1 of b) - 2) rounded down
        set x_to to (maximum_of(item 1 of a, item 1 of b) + 2) rounded up
        set y_from to (minimum_of(item 2 of a, item 2 of b) - 2) rounded down
        set y_to to (maximum_of(item 2 of a, item 2 of b) + 2) rounded up
        for each py from y_from to y_to
            for each px from x_from to x_to
                set amount to clamped(1.5 - distance_to_segment(px + 0.5, py + 0.5, item 1 of a, item 2 of a, item 1 of b, item 2 of b))
                if amount is greater than 0
                    set key to py * 100000 + px
                    if not (key is in covered) or item key of covered is less than amount
                        set item key of covered to amount
                    end
                end
            end
        end
    end
    for each key in covered
        set py to (key / 100000) rounded down
        blend(canvas, key - py * 100000, py, colour, item key of covered)
    end
end

to minimum_of with a, b
    if a is less than b
        return a
    end
    return b
end

to maximum_of with a, b
    if a is greater than b
        return a
    end
    return b
end

to draw_disc with canvas, cx, cy, r, colour
    for each py from ((cy - r - 1) rounded down) to ((cy + r + 1) rounded up)
        for each px from ((cx - r - 1) rounded down) to ((cx + r + 1) rounded up)
            set d to chart_math's sqrt((px + 0.5 - cx) * (px + 0.5 - cx) + (py + 0.5 - cy) * (py + 0.5 - cy))
            blend(canvas, px, py, colour, clamped(r + 0.5 - d))
        end
    end
end

to draw_text with canvas, s
    set font to font_for(size of s)
    set colour to colour_numbers(colour of s)
    set pen_x to x of s
    if anchor of s is "end"
        set pen_x to pen_x - width_of(words of s, size of s)
    else if anchor of s is "middle"
        set pen_x to pen_x - width_of(words of s, size of s) / 2
    end
    set ink to ink of font
    for each c in "" + words of s
        set g to glyph_of(font, c)
        set gx to (pen_x + left of g) rounded
        set gy to ((y of s) rounded) - up of g
        set row_bytes to ((wide of g + 1) / 2) rounded down
        for each row from 0 to high of g - 1
            for each column from 0 to wide of g - 1
                set held to byte (ink_at of font + start of g + row * row_bytes + ((column / 2) rounded down) + 1) of ink
                set level to held bit and 15
                if remainder of column divided by 2 is 1
                    set level to shift held right by 4
                end
                if level is greater than 0
                    blend(canvas, gx + column, gy + row, colour, level / 15)
                end
            end
        end
        set pen_x to pen_x + advance of g
    end
end

# the chart as a PNG file's bytes
to png_of with chart
    set canvas to chart_images's new_image(width of chart, height of chart, colour_numbers(chart_surface))
    for each s in shapes_of(chart)
        set what to kind of s
        if what is "rect"
            draw_rect(canvas, s)
        else if what is "line" # a hairline, across or down, on whole pixels
            set colour to colour_numbers(colour of s)
            if y1 of s is y2 of s
                set py to (y1 of s) rounded down
                for each px from ((x1 of s) rounded) to ((x2 of s) rounded)
                    blend(canvas, px, py, colour, 1)
                end
            else
                set px to (x1 of s) rounded down
                for each py from ((y1 of s) rounded) to ((y2 of s) rounded)
                    blend(canvas, px, py, colour, 1)
                end
            end
        else if what is "path"
            draw_path(canvas, s)
        else if what is "dot"
            draw_disc(canvas, x of s, y of s, 6, colour_numbers(chart_surface))
            draw_disc(canvas, x of s, y of s, 4, colour_numbers(colour of s))
        else
            draw_text(canvas, s)
        end
    end
    return chart_images's png_of(canvas)
end
