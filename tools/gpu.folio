# the kernels learn.folio trains with: a matrix turned over, a row of numbers added to each row, each column added
# up, each row's softmax, softmax and cross-entropy at once, each row's largest, relu's gradient, numbers added in
# place, and Adam
to gpu_learning_code
    set lines to empty list
    add ".visible .entry transpose(.param .u64 p_out, .param .u64 p_a, .param .u32 p_rows, .param .u32 p_cols)\n\{\n.reg .pred %p<2>;\n.reg .b32 %r<12>;\n.reg .f32 %f<2>;\n.reg .b64 %rd<10>;\nld.param.u64 %rd1, [p_out];\nld.param.u64 %rd2, [p_a];\nld.param.u32 %r5, [p_rows];\nld.param.u32 %r6, [p_cols];\nmul.lo.u32 %r7, %r5, %r6;\nmov.u32 %r1, %ctaid.x;\nmov.u32 %r2, %ntid.x;\nmov.u32 %r3, %tid.x;\nmad.lo.s32 %r4, %r1, %r2, %r3;\nsetp.ge.u32 %p1, %r4, %r7;\n@%p1 bra DONE;\ncvta.to.global.u64 %rd3, %rd1;\ncvta.to.global.u64 %rd4, %rd2;\ndiv.u32 %r8, %r4, %r6;\nrem.u32 %r9, %r4, %r6;\nmad.lo.s32 %r10, %r9, %r5, %r8;\nmul.wide.u32 %rd5, %r4, 4;\nadd.s64 %rd6, %rd4, %rd5;\nld.global.f32 %f1, [%rd6];\nmul.wide.u32 %rd7, %r10, 4;\nadd.s64 %rd8, %rd3, %rd7;\nst.global.f32 [%rd8], %f1;\nDONE:\nret;\n}\n" to lines
