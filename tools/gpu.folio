# Numbers on the graphics card, worked on there: NVIDIA's, through CUDA's driver (DESIGN §158). Lists of numbers
# go up to the card, as 32-bit floats, as graphics cards keep them, are added, multiplied, matrix-multiplied and
# summed there, thousands at a time, and come back as lists. The card's code is written here in PTX, which the
# driver makes the card's own as it loads, so nothing but the driver is needed: no CUDA toolkit.
#
#   use "gpu.folio" as gpu
#   if gpu's available()
#       say gpu's device()                          # its name, memory, capability and processors
#       set a to gpu's upload(list of 1, 2, 3)      # on the card
#       set b to gpu's upload(list of 10, 20, 30)
#       say gpu's download(gpu's plus(a, b))        # [11, 22, 33]
#       say gpu's sum(a)                            # 6
#   end
#
# For learn.folio, which trains networks on the card: transpose, add_rows (a row added to each row),
# column_sums, softmax_rows, cross_entropy (each row's softmax against its label, its loss and gradient at
# once), argmax_rows, relu_gradient, add_scaled (in place) and adam_step; matmul_turned (a side turned over,
# into a gradient), column_sums_into and adam_many (every parameter in a launch). Memory free gives back is kept for
# the next numbers of as many, as a training loop makes the same sizes over and over; give_back_memory()
# hands it to the driver. For transformers: gather_rows and scatter_add_rows (an embedding and its gradient),
# gelu and gelu_gradient, layer_norm and layer_norm_gradient, and attention and attention_gradient, with a causal
# mask.
#
# A program that uses it is run or built with --allow-libraries. On a computer with no NVIDIA card, or no
# driver, available() is no and the rest is a `fail with` that says so. Numbers on the card are floats: about 7
# digits, not Folio's 15, as machine learning wants them.

use the library "nvcuda" or "cuda"
    "cuInit" as gpu_cu_init(a whole number) gives a whole number
    "cuDeviceGetCount" as gpu_cu_count(bytes) gives a whole number
    "cuDeviceGet" as gpu_cu_device(bytes, a whole number) gives a whole number
    "cuDeviceGetName" as gpu_cu_name(bytes, a whole number, a whole number) gives a whole number
    "cuDeviceTotalMem_v2" as gpu_cu_total(bytes, a whole number) gives a whole number
    "cuDeviceGetAttribute" as gpu_cu_attribute(bytes, a whole number, a whole number) gives a whole number
    "cuDevicePrimaryCtxRetain" as gpu_cu_retain(bytes, a whole number) gives a whole number
    "cuCtxSetCurrent" as gpu_cu_current(a pointer) gives a whole number
    "cuCtxSynchronize" as gpu_cu_sync() gives a whole number
    "cuMemAlloc_v2" as gpu_cu_alloc(bytes, a long whole number) gives a whole number
    "cuMemFree_v2" as gpu_cu_free(a long whole number) gives a whole number
    "cuMemcpyHtoD_v2" as gpu_cu_up(a long whole number, bytes, a long whole number) gives a whole number
    "cuMemcpyDtoH_v2" as gpu_cu_down(bytes, a long whole number, a long whole number) gives a whole number
    "cuMemcpyDtoD_v2" as gpu_cu_across(a long whole number, a long whole number, a long whole number) gives a whole number
    "cuModuleLoadDataEx" as gpu_cu_load(bytes, text, a whole number, bytes, bytes) gives a whole number
    "cuModuleGetFunction" as gpu_cu_function(bytes, a pointer, text) gives a whole number
    "cuLaunchKernel" as gpu_cu_launch(a pointer, a whole number, a whole number, a whole number, a whole number, a whole number, a whole number, a whole number, a pointer, bytes, a pointer) gives a whole number
    "cuGetErrorName" as gpu_cu_error_name(a whole number, bytes) gives a whole number
end

use the library "msvcrt" or "c"
    "memcpy" as gpu_address_of(bytes, bytes, a long whole number) gives a pointer
    "memcpy" as gpu_copy_from(bytes, a pointer, a long whole number) gives a pointer
    "strlen" as gpu_strlen(a pointer) gives a long whole number
end

use the library "folio"
    "numbers_convert" as gpu_convert(a long whole number, a list of numbers, bytes) gives a long whole number
end

# numbers on the card: where they start there, and how many there are
kind gpu_numbers with at, count
    to shown with self
        return self's count + " numbers on the graphics card"
    end
end

set gpu_started to no
set gpu_state to "not started"
set gpu_card to 0
set gpu_context to nothing
set gpu_module to nothing
set gpu_functions to empty dictionary
set gpu_pool to empty dictionary
set gpu_launches to empty dictionary

# ---------- the card ----------

# whether there's an NVIDIA card with a driver to work on numbers with
to available
    gpu_start()
    return gpu_state is "ready"
end

# the card: its name, memory in bytes, the CUDA capability it has (as "7.5") and how many processors it has
to device
    gpu_ready()
    set raw to 256 bytes
    gpu_check(gpu_cu_name(raw, 256, gpu_card), "find the card's name")
    set n to 0
    repeat while n is less than 256 and item (n + 1) of raw is not 0
        add 1 to n
    end
    set name to ""
    if n is greater than 0
        set name to (items 1 to n of raw) as text
    end
    set slot to 8 bytes
    gpu_check(gpu_cu_total(slot, gpu_card), "find the card's memory")
    set memory to gpu_whole_in(slot)
    return record with name name, memory memory, capability gpu_attribute(75) + "." + gpu_attribute(76), processors gpu_attribute(16)
end

# waits until the card has done all it was asked to
to finish
    gpu_ready()
    gpu_check(gpu_cu_sync(), "finish its work")
end

# ---------- numbers up and down ----------

# a list of numbers, put on the card
to upload with numbers
    set made to gpu_allocate(length of numbers)
    if length of numbers is greater than 0
        set raw to (4 * length of numbers) bytes
        if gpu_convert(1, numbers, raw) is not 0
            fail with "gpu.folio can only put numbers on the card, not " + numbers
        end
        gpu_check(gpu_cu_up(made's at, raw, 4 * length of numbers), "take numbers to the card")
    end
    return made
end

# numbers on the card, as a list
to download with g
    gpu_ready()
    set n to g's count
    gpu_check(gpu_cu_sync(), "finish its work")
    set made to empty list
    repeat n times
        add 0 to made
    end
    if n is greater than 0
        set raw to (4 * n) bytes
        gpu_check(gpu_cu_down(raw, g's at, 4 * n), "bring numbers back from the card")
        gpu_convert(2, made, raw)
    end
    return made
end

# count numbers on the card, each 0
to zeros with count
    return filled(count, 0)
end

# count numbers on the card, each value
to filled with count, value
    set made to gpu_allocate(count)
    gpu_run_flat("fill", count, (list of made's at), value, count)
    return made
end

# the card's memory for numbers given back, for others to use: kept for the next numbers of as many, as asking
# the driver for memory takes a while, which a program that trains, making and freeing the same sizes over and
# over, would wait for at every step
to free with g
    gpu_ready()
    if g's at is not 0
        if not (g's count is in gpu_pool)
            set item g's count of gpu_pool to record with places empty list, kept 0
        end
        set kept to item g's count of gpu_pool
        set places to kept's places
        if kept's kept is less than length of places
            set item (kept's kept + 1) of places to g's at
        else
            add g's at to places
        end
        set kept's kept to kept's kept + 1
        set at of g to 0
        set count of g to 0
    end
end

# the memory kept for numbers to come, given back to the driver
to give_back_memory
    gpu_ready()
    for each count in keys of gpu_pool
        set kept to item count of gpu_pool
        for each k from 1 to kept's kept
            gpu_check(gpu_cu_free(item k of kept's places), "give memory back")
        end
    end
    set gpu_pool to empty dictionary
end

# a copy, on the card
to copy_of with g
    set made to gpu_allocate(g's count)
    if g's count is greater than 0
        gpu_check(gpu_cu_across(made's at, g's at, 4 * g's count), "copy numbers")
    end
    return made
end

# ---------- each number with each, on the card ----------

# each number plus the other's at its place, or plus a number
to plus with a, b
    return gpu_each(a, b, 0, "+")
end

# each number less the other's at its place, or less a number
to minus with a, b
    return gpu_each(a, b, 1, "-")
end

# each number times the other's at its place, or times a number
to times with a, b
    return gpu_each(a, b, 2, "*")
end

# each number divided by the other's at its place, or by a number
to divided_by with a, b
    return gpu_each(a, b, 3, "/")
end

# the larger of each number and the other's at its place, or a number
to maximum with a, b
    return gpu_each(a, b, 4, "maximum")
end

# the smaller of each number and the other's at its place, or a number
to minimum with a, b
    return gpu_each(a, b, 5, "minimum")
end

# each number the other way: 3 is -3
to negate with a
    return gpu_one(a, 0)
end

# each number, or 0 if it's below 0: the rectifier neural networks learn with
to relu with a
    return gpu_one(a, 1)
end

# e to the power of each number
to exp with a
    return gpu_one(a, 2)
end

# the natural logarithm of each number
to ln with a
    return gpu_one(a, 3)
end

# the hyperbolic tangent of each number, from -1 to 1
to tanh with a
    return gpu_one(a, 4)
end

# 1 over 1 plus e to the minus each number: from 0 to 1
to sigmoid with a
    return gpu_one(a, 5)
end

# the square root of each number
to sqrt with a
    return gpu_one(a, 6)
end

# each number without its sign
to absolute with a
    return gpu_one(a, 7)
end

# each number times itself
to square with a
    return gpu_one(a, 8)
end

# 1 where a number is above 0, and 0 where it isn't: what relu's slope is, for learning
to step with a
    return gpu_one(a, 9)
end

# all the numbers added up
to sum with a
    set total to filled(1, 0)
    if a's count is greater than 0
        set blocks to gpu_blocks(a's count)
        if blocks is greater than 1024
            set blocks to 1024
        end
        gpu_launch("sum", blocks, 1, 256, 1, (list of total's at, a's at, a's count), (list of "pointer", "pointer", "whole"))
    end
    set made to item 1 of download(total)
    free(total)
    return made
end

# a matrix times a matrix, each its numbers row after row: a is rows by inner, b inner by columns, and what it
# gives rows by columns
to matmul with a, b, rows, inner, columns
    return matmul_turned(a, b, rows, inner, columns, no, no, nothing)
end

# a times b as matmul, with a kept turned over (a_turned: a is inner by rows, row after row) or b (b_turned: b is
# columns by inner), as a network's gradients want them, with no transpose; into new numbers, or added to
# into's. Few rows and columns but a long inner axis, as a layer's weight gradient has, is shared out in
# pieces, so the card has enough blocks to keep busy (DESIGN §168)
to matmul_turned with a, b, rows, inner, columns, a_turned, b_turned, into
    if a's count is not rows * inner or b's count is not inner * columns
        fail with "matmul needs " + rows + " by " + inner + " numbers and " + inner + " by " + columns + ", not " + a's count + " and " + b's count
    end
    set name to "matmul"
    if a_turned and b_turned
        fail with "matmul_turned takes a turned over or b, not both"
    else if a_turned
        set name to "matmul_tn"
    else if b_turned
        set name to "matmul_nt"
    end
    set across to gpu_ceiling(columns / 64)
    set tiles to across * gpu_ceiling(rows / 64)
    set pieces to 1
    if tiles is less than 32 and inner is at least 128
        set pieces to gpu_ceiling(64 / tiles)
        if pieces is greater than (inner / 64) rounded down
            set pieces to (inner / 64) rounded down
        end
    end
    set chunk to gpu_ceiling(inner / pieces / 16) * 16
    if inner is greater than 0
        set pieces to gpu_ceiling(inner / chunk)
    end
    set made to into
    set adding to 1
    if into is nothing
        if pieces is greater than 1
            set made to zeros(rows * columns)
        else
            set made to gpu_allocate(rows * columns)
            set adding to 0
        end
    else if into's count is not rows * columns
        fail with "matmul_turned adds " + rows + " by " + columns + " numbers, not into " + into's count
    end
    if rows * columns is greater than 0
        gpu_launch(name, across * pieces, gpu_ceiling(rows / 64), 16, 16, (list of made's at, a's at, b's at, rows, inner, columns, chunk, adding),
            (list of "pointer", "pointer", "pointer", "whole", "whole", "whole", "whole", "whole"))
    end
    return made
end

# ---------- for learning ----------

# a matrix turned over: a is rows by columns, row after row, and what it gives columns by rows
to transpose with a, rows, columns
    gpu_shape(a, rows, columns, "transpose")
    set made to gpu_allocate(rows * columns)
    if rows * columns is greater than 0
        gpu_launch("transpose", gpu_blocks(rows * columns), 1, 256, 1, (list of made's at, a's at, rows, columns),
            (list of "pointer", "pointer", "whole", "whole"))
    end
    return made
end

# each row of a, rows by columns, plus b, a row of columns numbers: a layer's bias
to add_rows with a, b, rows, columns
    gpu_shape(a, rows, columns, "add_rows")
    if b's count is not columns
        fail with "add_rows needs a row of " + columns + " numbers to add, not " + b's count
    end
    set made to gpu_allocate(rows * columns)
    if rows * columns is greater than 0
        gpu_launch("add_rows", gpu_blocks(rows * columns), 1, 256, 1, (list of made's at, a's at, b's at, rows, columns),
            (list of "pointer", "pointer", "pointer", "whole", "whole"))
    end
    return made
end

# each column of a, rows by columns, added up: a row of columns numbers
to column_sums with a, rows, columns
    set made to gpu_allocate(columns)
    if columns is greater than 0
        gpu_run_flat("fill", columns, (list of made's at), 0, columns)
    end
    return column_sums_into(made, a, rows, columns)
end

# each column's sum added to into's numbers, a row of columns: a bias's gradient added to what it has
to column_sums_into with into, a, rows, columns
    gpu_shape(a, rows, columns, "column_sums")
    gpu_shape(into, 1, columns, "column_sums_into")
    if rows * columns is greater than 0
        gpu_launch("column_parts", gpu_blocks(gpu_ceiling(rows / 32) * columns), 1, 256, 1, (list of into's at, a's at, rows, columns),
            (list of "pointer", "pointer", "whole", "whole"))
    end
    return into
end

# each row's softmax: chances that add up to 1, the largest number's the largest
to softmax_rows with a, rows, columns
    gpu_shape(a, rows, columns, "softmax_rows")
    set made to gpu_allocate(rows * columns)
    if rows * columns is greater than 0
        gpu_launch("softmax_rows", gpu_blocks(rows), 1, 256, 1, (list of made's at, a's at, rows, columns),
            (list of "pointer", "pointer", "whole", "whole"))
    end
    return made
end

# the cross-entropy of each row's softmax against its label (a place from 0, on the card): its loss, the
# average over the rows, and its gradient, how the average changes with each of a's numbers
to cross_entropy with a, labels, rows, columns
    gpu_shape(a, rows, columns, "cross_entropy")
    if labels's count is not rows
        fail with "cross_entropy needs a label for each of the " + rows + " rows, not " + labels's count
    end
    if rows is 0 or columns is 0
        fail with "cross_entropy needs at least a row of at least one number"
    end
    set losses to gpu_allocate(rows)
    set gradient to gpu_allocate(rows * columns)
    gpu_launch("softmax_xent", gpu_blocks(rows), 1, 256, 1, (list of losses's at, gradient's at, a's at, labels's at, rows, columns, 1 / rows),
        (list of "pointer", "pointer", "pointer", "pointer", "whole", "whole", "float"))
    set loss to sum(losses) / rows
    free(losses)
    return record with loss loss, gradient gradient
end

# the place, from 0, of each row's largest number: what a classifier picks
to argmax_rows with a, rows, columns
    gpu_shape(a, rows, columns, "argmax_rows")
    set made to gpu_allocate(rows)
    if rows is greater than 0
        gpu_launch("argmax_rows", gpu_blocks(rows), 1, 256, 1, (list of made's at, a's at, rows, columns),
            (list of "pointer", "pointer", "whole", "whole"))
    end
    return made
end

# relu's gradient: g where x was more than 0, else 0
to relu_gradient with g, x
    if g's count is not x's count
        fail with "relu_gradient needs as many numbers on each side, not " + g's count + " and " + x's count
    end
    set made to gpu_allocate(g's count)
    if g's count is greater than 0
        gpu_launch("relu_grad", gpu_blocks(g's count), 1, 256, 1, (list of made's at, g's at, x's at, g's count),
            (list of "pointer", "pointer", "pointer", "whole"))
    end
    return made
end

# target's numbers each plus a's times s, in place: gradients added up (s 1), or a step down one (s the rate, negated)
to add_scaled with target, a, s
    if target's count is not a's count
        fail with "add_scaled needs as many numbers on each side, not " + target's count + " and " + a's count
    end
    if a's count is greater than 0
        gpu_launch("add_scaled", gpu_blocks(a's count), 1, 256, 1, (list of target's at, a's at, s, a's count),
            (list of "pointer", "pointer", "float", "whole"))
    end
end

# one step of Adam, in place: parameters p moved against their gradient g, with m and v (each as many numbers,
# 0 at first) its running averages, at step t from 1
to adam_step with p, g, m, v, rate, b1, b2, eps, t
    if g's count is not p's count or m's count is not p's count or v's count is not p's count
        fail with "adam_step needs as many numbers in each of p, g, m and v"
    end
    if p's count is greater than 0
        set c1 to 1 / (1 - (b1 to the power of t))
        set c2 to 1 / (1 - (b2 to the power of t))
        gpu_launch("adam", gpu_blocks(p's count), 1, 256, 1, (list of p's at, g's at, m's at, v's at, p's count, rate, b1, b2, eps, c1, c2),
            (list of "pointer", "pointer", "pointer", "pointer", "whole", "float", "float", "float", "float", "float", "float"))
    end
end

# Adam's step for many parameters at once (DESIGN §168): entries a list of lists of p, g, m and v, numbers on
# the card, as adam_step takes them, 64 to a launch, not one each; zero_grads leaves each g 0, for the next
# step's gradients to be added to
to adam_many with entries, rate, b1, b2, eps, t, zero_grads
    set c1 to 1 / (1 - (b1 to the power of t))
    set c2 to 1 / (1 - (b2 to the power of t))
    set first to 1
    repeat while first is at most length of entries
        set last to first + 63
        if last is greater than length of entries
            set last to length of entries
        end
        gpu_adam_launch(entries, first, last, (list of rate, b1, b2, eps, c1, c2), zero_grads)
        set first to last + 1
    end
end

set gpu_adam_table to nothing

to gpu_adam_launch with entries, first, last, scalars, zero_grads
    if gpu_adam_table is nothing
        set values to 2624 bytes
        set params to 8 bytes
        gpu_convert(3, (list of gpu_address_of(values, values, 0)), params)
        set wholes to empty list
        for each k from 1 to 328
            add 0 to wholes
        end
        set gpu_adam_table to record with values values, params params, wholes wholes, one (list of 0), four (4 bytes)
    end
    set kept to gpu_adam_table
    set wholes to kept's wholes
    for each k from 1 to 8
        set item k of wholes to 0
    end
    if zero_grads
        set item 7 of wholes to 1
    end
    set widest to 0
    set at to 8
    for each j from first to last
        set entry to item j of entries
        set n to (item 1 of entry)'s count
        for each part in entry
            if part's count is not n
                fail with "adam_many needs as many numbers in each of p, g, m and v"
            end
        end
        for each part in entry
            add 1 to at
            set item at of wholes to part's at
        end
        add 1 to at
        set item at of wholes to n
        if n is greater than widest
            set widest to n
        end
    end
    set values to kept's values
    gpu_convert(3, wholes, values)
    set one to kept's one
    set four to kept's four
    for each k from 1 to 6
        set item 1 of one to item k of scalars
        gpu_convert(1, one, four)
        for each j from 1 to 4
            set item (8 * (k - 1) + j) of values to item j of four
        end
    end
    if widest is greater than 0
        gpu_check(gpu_cu_launch(gpu_function("adam_many"), gpu_blocks(widest), last - first + 1, 1, 256, 1, 1, 0, nothing, kept's params, nothing), "run adam_many")
    end
end

to gpu_shape with a, rows, columns, what
    if a's count is not rows * columns
        fail with what + " needs " + rows + " by " + columns + " numbers, not " + a's count
    end
end

# ---------- for transformers (DESIGN §167) ----------

# rows of a table, rows by columns, by their places from 0 in ids, numbers on the card: an embedding
to gather_rows with table, ids, rows, columns
    set n to ids's count
    set made to gpu_allocate(n * columns)
    if n * columns is greater than 0
        gpu_launch("gather_rows", gpu_blocks(n * columns), 1, 256, 1, (list of made's at, table's at, ids's at, n, columns),
            (list of "pointer", "pointer", "pointer", "whole", "whole"))
    end
    return made
end

# grad's rows added to target's rows at ids, in place, however many rows have the same id: an embedding's gradient
to scatter_add_rows with target, grad, ids, columns
    set n to ids's count
    if grad's count is not n * columns
        fail with "scatter_add_rows needs " + n + " rows of " + columns + " numbers, not " + grad's count
    end
    if n * columns is greater than 0
        gpu_launch("scatter_add_rows", gpu_blocks(n * columns), 1, 256, 1, (list of target's at, grad's at, ids's at, n, columns),
            (list of "pointer", "pointer", "pointer", "whole", "whole"))
    end
end

# GELU of each number, as GPT-2 has it
to gelu with a
    set made to gpu_allocate(a's count)
    if a's count is greater than 0
        gpu_launch("gelu", gpu_blocks(a's count), 1, 256, 1, (list of made's at, a's at, a's count), (list of "pointer", "pointer", "whole"))
    end
    return made
end

# GELU's gradient: dy times its slope at each x
to gelu_gradient with dy, x
    if dy's count is not x's count
        fail with "gelu_gradient needs as many numbers on each side, not " + dy's count + " and " + x's count
    end
    set made to gpu_allocate(x's count)
    if x's count is greater than 0
        gpu_launch("gelu_grad", gpu_blocks(x's count), 1, 256, 1, (list of made's at, dy's at, x's at, x's count),
            (list of "pointer", "pointer", "pointer", "whole"))
    end
    return made
end

# each row of x, rows by columns, normalized and then times gamma plus beta (each a row of columns): out, and
# xhat and rstd for the gradient
to layer_norm with x, gamma, beta, rows, columns
    gpu_shape(x, rows, columns, "layer_norm")
    set out to gpu_allocate(rows * columns)
    set xhat to gpu_allocate(rows * columns)
    set rstd to gpu_allocate(rows)
    if rows * columns is greater than 0
        gpu_launch("layernorm", gpu_blocks(rows * 32), 1, 256, 1, (list of out's at, xhat's at, rstd's at, x's at, gamma's at, beta's at, rows, columns),
            (list of "pointer", "pointer", "pointer", "pointer", "pointer", "pointer", "whole", "whole"))
    end
    return record with out out, xhat xhat, rstd rstd
end

# layer norm's gradient for x, from dy and what layer_norm kept
to layer_norm_gradient with dy, xhat, rstd, gamma, rows, columns
    set made to gpu_allocate(rows * columns)
    if rows * columns is greater than 0
        gpu_launch("layernorm_grad", gpu_blocks(rows * 32), 1, 256, 1, (list of made's at, dy's at, xhat's at, rstd's at, gamma's at, rows, columns),
            (list of "pointer", "pointer", "pointer", "pointer", "pointer", "whole", "whole"))
    end
    return made
end

# attention with a causal mask: q, k and v batch * time rows of heads * size columns; each place t of each head
# looks at places up to t. out, and probs (batch, heads, time, time) for the gradient
to attention with q, k, v, batch, time, heads
    set columns to q's count / (batch * time)
    set size to columns / heads
    set out to gpu_allocate(q's count)
    set probs to gpu_allocate(batch * heads * time * time)
    set scale to 1 / gpu_sqrt_of(size)
    set shape to list of "whole", "whole", "whole", "whole", "float"
    gpu_launch("attn_dot", gpu_blocks(batch * heads * time * time), 1, 256, 1, (list of probs's at, q's at, k's at, batch, time, heads, size, scale),
        (list of "pointer", "pointer", "pointer", "whole", "whole", "whole", "whole", "float"))
    gpu_launch("attn_softmax", gpu_blocks(batch * heads * time * 32), 1, 256, 1, (list of probs's at, batch, time, heads, size, scale),
        (list of "pointer", "whole", "whole", "whole", "whole", "float"))
    gpu_launch("attn_out", gpu_blocks(batch * heads * time * size), 1, 256, 1, (list of out's at, probs's at, v's at, batch, time, heads, size, scale),
        (list of "pointer", "pointer", "pointer", "whole", "whole", "whole", "whole", "float"))
    return record with out out, probs probs
end

# attention's gradients for q, k and v, from dout and what attention kept
to attention_gradient with dout, probs, q, k, v, batch, time, heads
    set columns to q's count / (batch * time)
    set size to columns / heads
    set dq to gpu_allocate(q's count)
    set dk to gpu_allocate(k's count)
    set dv to gpu_allocate(v's count)
    set ds to gpu_allocate(batch * heads * time * time)
    set scale to 1 / gpu_sqrt_of(size)
    gpu_launch("attn_dot", gpu_blocks(batch * heads * time * time), 1, 256, 1, (list of ds's at, dout's at, v's at, batch, time, heads, size, 1),
        (list of "pointer", "pointer", "pointer", "whole", "whole", "whole", "whole", "float"))
    gpu_launch("attn_ds_rows", gpu_blocks(batch * heads * time * 32), 1, 256, 1, (list of ds's at, probs's at, batch, time, heads, size, scale),
        (list of "pointer", "pointer", "whole", "whole", "whole", "whole", "float"))
    gpu_launch("attn_dq", gpu_blocks(batch * heads * time * size), 1, 256, 1, (list of dq's at, ds's at, k's at, batch, time, heads, size, scale),
        (list of "pointer", "pointer", "pointer", "whole", "whole", "whole", "whole", "float"))
    gpu_launch("attn_dkv", gpu_blocks(batch * heads * time * size), 1, 256, 1, (list of dk's at, dv's at, ds's at, probs's at, q's at, dout's at, batch, time, heads, size, scale),
        (list of "pointer", "pointer", "pointer", "pointer", "pointer", "pointer", "whole", "whole", "whole", "whole", "float"))
    free(ds)
    return record with dq dq, dk dk, dv dv
end

to gpu_sqrt_of with x
    set r to x
    if r is less than 1
        set r to 1
    end
    repeat 40 times
        set r to (r + x / r) / 2
    end
    return r
end

# ---------- the card's code ----------

to gpu_each with a, b, op, sign
    if gpu_is_numbers(b)
        if a's count is not b's count
            fail with "'" + sign + "' on the card needs as many numbers on each side, not " + a's count + " and " + b's count
        end
        set made to gpu_allocate(a's count)
        gpu_launch("binary", gpu_blocks(a's count), 1, 256, 1, (list of made's at, a's at, b's at, a's count, op),
            (list of "pointer", "pointer", "pointer", "whole", "whole"))
        return made
    end
    set made to gpu_allocate(a's count)
    gpu_launch("scalar", gpu_blocks(a's count), 1, 256, 1, (list of made's at, a's at, b, a's count, op),
        (list of "pointer", "pointer", "float", "whole", "whole"))
    return made
end

# whether v is numbers on the card, and not a number
to gpu_is_numbers with v
    try
        return v's count is not nothing
    if it fails
        return no
    end
end

to gpu_one with a, op
    set made to gpu_allocate(a's count)
    gpu_launch("unary", gpu_blocks(a's count), 1, 256, 1, (list of made's at, a's at, a's count, op), (list of "pointer", "pointer", "whole", "whole"))
    return made
end

# fill(out, value, count)
to gpu_run_flat with name, count, pointers, value, n
    if count is greater than 0
        gpu_launch(name, gpu_blocks(count), 1, 256, 1, (list of item 1 of pointers, value, n), (list of "pointer", "float", "whole"))
    end
end

to gpu_blocks with count
    return gpu_ceiling(count / 256)
end

to gpu_ceiling with x
    set whole to x rounded down
    if whole is less than x
        return whole + 1
    end
    return whole
end

# memory on the card for count numbers
to gpu_allocate with count
    gpu_ready()
    if count is 0
        return gpu_numbers(0, 0)
    end
    if count is in gpu_pool # memory given back for as many
        set kept to item count of gpu_pool
        if kept's kept is greater than 0
            set at to item kept's kept of kept's places
            set kept's kept to kept's kept - 1
            return gpu_numbers(at, count)
        end
    end
    set slot to 8 bytes
    if gpu_cu_alloc(slot, 4 * count) is not 0 # the card full: the memory kept goes back, and it's asked again
        give_back_memory()
        set slot to 8 bytes
        gpu_check(gpu_cu_alloc(slot, 4 * count), "find room for " + count + " numbers")
    end
    return gpu_numbers(gpu_whole_in(slot), count)
end

# the kernel called name, run on blocks_x by blocks_y blocks of threads_x by threads_y threads each, given args,
# each of its kind: "pointer" (a place on the card), "whole" (a whole number, 32 bits) or "float"
to gpu_launch with name, blocks_x, blocks_y, threads_x, threads_y, args, kinds
    set n to length of args
    if not (n is in gpu_launches)
        gpu_launch_room(n)
    end
    set kept to item n of gpu_launches
    set wholes to kept's wholes
    set floats to no
    for each k from 1 to n
        if item k of kinds is "float"
            set item k of wholes to 0
            set floats to yes
        else
            set item k of wholes to item k of args
        end
    end
    set values to kept's values
    gpu_convert(3, wholes, values)
    if floats # each float's 4 bytes into its 8
        set one to kept's one
        set four to kept's four
        for each k from 1 to n
            if item k of kinds is "float"
                set item 1 of one to item k of args
                gpu_convert(1, one, four)
                for each j from 1 to 4
                    set item (8 * (k - 1) + j) of values to item j of four
                end
            end
        end
    end
    gpu_check(gpu_cu_launch(gpu_function(name), blocks_x, blocks_y, 1, threads_x, threads_y, 1, 0, nothing, kept's params, nothing), "run " + name)
end

# a launch's room for n inputs, made once and kept: their 8 bytes each, and where each one is, which
# cuLaunchKernel takes; the collector doesn't move bytes, so where they are stays where they are
to gpu_launch_room with n
    set values to (8 * n) bytes
    set base to gpu_address_of(values, values, 0)
    set places to empty list
    set wholes to empty list
    for each k from 1 to n
        add base + 8 * (k - 1) to places
        add 0 to wholes
    end
    set params to (8 * n) bytes
    gpu_convert(3, places, params)
    set item n of gpu_launches to record with values values, params params, wholes wholes, one (list of 0), four (4 bytes)
end

to gpu_function with name
    gpu_ready()
    if name is in gpu_functions
        return item name of gpu_functions
    end
    if gpu_module is nothing
        set slot to 8 bytes
        set log to 4096 bytes
        set options to 8 bytes
        set item 1 of options to 5 # CU_JIT_ERROR_LOG_BUFFER
        set item 5 of options to 6 # CU_JIT_ERROR_LOG_BUFFER_SIZE_BYTES
        set values to 16 bytes
        gpu_convert(3, (list of gpu_address_of(log, log, 0), 4096), values)
        set status to gpu_cu_load(slot, gpu_code(), 2, options, values)
        if status is not 0
            set n to 0
            repeat while n is less than 4096 and item (n + 1) of log is not 0
                add 1 to n
            end
            set said to ""
            if n is greater than 0
                set said to ": " + (items 1 to n of log) as text
            end
            fail with "the graphics card couldn't take gpu.folio's code (" + gpu_error_name(status) + ")" + said
        end
        set gpu_module to gpu_whole_in(slot)
    end
    set slot to 8 bytes
    gpu_check(gpu_cu_function(slot, gpu_module, name), "find its code for " + name)
    set found to gpu_whole_in(slot)
    set item name of gpu_functions to found
    return found
end

# ---------- the driver ----------

to gpu_start
    if gpu_started
        return nothing
    end
    set gpu_started to yes
    try
        set status to gpu_cu_init(0)
        if status is not 0
            set gpu_state to "the driver wouldn't start (" + gpu_error_name(status) + ")"
            return nothing
        end
        set slot to 8 bytes
        gpu_cu_count(slot)
        if gpu_whole_in(slot) is 0
            set gpu_state to "there's no graphics card CUDA can use"
            return nothing
        end
        set slot to 8 bytes
        gpu_check(gpu_cu_device(slot, 0), "find the card")
        set gpu_card to gpu_whole_in(slot)
        set slot to 8 bytes
        gpu_check(gpu_cu_retain(slot, gpu_card), "start working on the card")
        set gpu_context to gpu_whole_in(slot)
        gpu_check(gpu_cu_current(gpu_context), "start working on the card")
        set gpu_state to "ready"
    if it fails with why
        set gpu_state to "there's no NVIDIA driver here (" + why + ")"
    end
end

to gpu_ready
    gpu_start()
    if gpu_state is not "ready"
        fail with "gpu.folio can't use a graphics card: " + gpu_state
    end
end

to gpu_attribute with which
    set slot to 8 bytes
    gpu_check(gpu_cu_attribute(slot, which, gpu_card), "find what the card can do")
    return gpu_whole_in(slot)
end

to gpu_check with status, what
    if status is not 0
        fail with "the graphics card couldn't " + what + " (" + gpu_error_name(status) + ")"
    end
end

to gpu_error_name with status
    set slot to 8 bytes
    if gpu_cu_error_name(status, slot) is not 0
        return "error " + status
    end
    set at to gpu_whole_in(slot)
    set n to gpu_strlen(at)
    set raw to n bytes
    gpu_copy_from(raw, at, n)
    return raw as text
end

# the 64-bit whole number in a slot C filled
to gpu_whole_in with slot
    set made to list of 0
    gpu_convert(4, made, slot)
    return item 1 of made
end

# the card's code, in PTX: each kernel's threads take one number each (sum's go through them all, a block at a
# time, and matmul's work on 16 by 16 tiles of the matrices, kept in the card's fast memory)
to gpu_code
    set lines to list of ".version 6.0", ".target sm_50", ".address_size 64", ""
    # out[i] = a[i] op b[i]: + - * / maximum minimum
    for each line in list of ".visible .entry binary(.param .u64 p_out, .param .u64 p_a, .param .u64 p_b, .param .u32 p_n, .param .u32 p_op)", "\{",
        ".reg .pred %p<4>;", ".reg .b32 %r<8>;", ".reg .f32 %f<4>;", ".reg .b64 %rd<10>;",
        "ld.param.u64 %rd1, [p_out];", "ld.param.u64 %rd2, [p_a];", "ld.param.u64 %rd3, [p_b];", "ld.param.u32 %r5, [p_n];", "ld.param.u32 %r6, [p_op];",
        "mov.u32 %r1, %ctaid.x;", "mov.u32 %r2, %ntid.x;", "mov.u32 %r3, %tid.x;", "mad.lo.s32 %r4, %r1, %r2, %r3;",
        "setp.ge.u32 %p1, %r4, %r5;", "@%p1 bra DONE;",
        "cvta.to.global.u64 %rd4, %rd1;", "cvta.to.global.u64 %rd5, %rd2;", "cvta.to.global.u64 %rd6, %rd3;",
        "mul.wide.u32 %rd7, %r4, 4;", "add.s64 %rd8, %rd5, %rd7;", "ld.global.f32 %f1, [%rd8];", "add.s64 %rd8, %rd6, %rd7;", "ld.global.f32 %f2, [%rd8];",
        "mov.f32 %f3, %f1;",
        "setp.eq.u32 %p2, %r6, 0;", "@%p2 add.f32 %f3, %f1, %f2;",
        "setp.eq.u32 %p2, %r6, 1;", "@%p2 sub.f32 %f3, %f1, %f2;",
        "setp.eq.u32 %p2, %r6, 2;", "@%p2 mul.f32 %f3, %f1, %f2;",
        "setp.eq.u32 %p2, %r6, 3;", "@%p2 div.rn.f32 %f3, %f1, %f2;",
        "setp.eq.u32 %p2, %r6, 4;", "@%p2 max.f32 %f3, %f1, %f2;",
        "setp.eq.u32 %p2, %r6, 5;", "@%p2 min.f32 %f3, %f1, %f2;",
        "add.s64 %rd9, %rd4, %rd7;", "st.global.f32 [%rd9], %f3;",
        "DONE:", "ret;", "}", ""
        add line to lines
    end
    # out[i] = a[i] op s, s a number
    for each line in list of ".visible .entry scalar(.param .u64 p_out, .param .u64 p_a, .param .f32 p_s, .param .u32 p_n, .param .u32 p_op)", "\{",
        ".reg .pred %p<4>;", ".reg .b32 %r<8>;", ".reg .f32 %f<4>;", ".reg .b64 %rd<10>;",
        "ld.param.u64 %rd1, [p_out];", "ld.param.u64 %rd2, [p_a];", "ld.param.f32 %f2, [p_s];", "ld.param.u32 %r5, [p_n];", "ld.param.u32 %r6, [p_op];",
        "mov.u32 %r1, %ctaid.x;", "mov.u32 %r2, %ntid.x;", "mov.u32 %r3, %tid.x;", "mad.lo.s32 %r4, %r1, %r2, %r3;",
        "setp.ge.u32 %p1, %r4, %r5;", "@%p1 bra DONE;",
        "cvta.to.global.u64 %rd4, %rd1;", "cvta.to.global.u64 %rd5, %rd2;",
        "mul.wide.u32 %rd7, %r4, 4;", "add.s64 %rd8, %rd5, %rd7;", "ld.global.f32 %f1, [%rd8];",
        "mov.f32 %f3, %f1;",
        "setp.eq.u32 %p2, %r6, 0;", "@%p2 add.f32 %f3, %f1, %f2;",
        "setp.eq.u32 %p2, %r6, 1;", "@%p2 sub.f32 %f3, %f1, %f2;",
        "setp.eq.u32 %p2, %r6, 2;", "@%p2 mul.f32 %f3, %f1, %f2;",
        "setp.eq.u32 %p2, %r6, 3;", "@%p2 div.rn.f32 %f3, %f1, %f2;",
        "setp.eq.u32 %p2, %r6, 4;", "@%p2 max.f32 %f3, %f1, %f2;",
        "setp.eq.u32 %p2, %r6, 5;", "@%p2 min.f32 %f3, %f1, %f2;",
        "add.s64 %rd9, %rd4, %rd7;", "st.global.f32 [%rd9], %f3;",
        "DONE:", "ret;", "}", ""
        add line to lines
    end
    # out[i] = f(a[i]): negate relu exp ln tanh sigmoid sqrt absolute square step
    for each line in list of ".visible .entry unary(.param .u64 p_out, .param .u64 p_a, .param .u32 p_n, .param .u32 p_op)", "\{",
        ".reg .pred %p<4>;", ".reg .b32 %r<8>;", ".reg .f32 %f<8>;", ".reg .b64 %rd<10>;",
        "ld.param.u64 %rd1, [p_out];", "ld.param.u64 %rd2, [p_a];", "ld.param.u32 %r5, [p_n];", "ld.param.u32 %r6, [p_op];",
        "mov.u32 %r1, %ctaid.x;", "mov.u32 %r2, %ntid.x;", "mov.u32 %r3, %tid.x;", "mad.lo.s32 %r4, %r1, %r2, %r3;",
        "setp.ge.u32 %p1, %r4, %r5;", "@%p1 bra DONE;",
        "cvta.to.global.u64 %rd4, %rd1;", "cvta.to.global.u64 %rd5, %rd2;",
        "mul.wide.u32 %rd7, %r4, 4;", "add.s64 %rd8, %rd5, %rd7;", "ld.global.f32 %f1, [%rd8];",
        "mov.f32 %f3, %f1;",
        "setp.eq.u32 %p2, %r6, 0;", "@%p2 neg.f32 %f3, %f1;",
        "setp.eq.u32 %p2, %r6, 1;", "@%p2 max.f32 %f3, %f1, 0f00000000;",
        "setp.eq.u32 %p2, %r6, 2;", "@%p2 mul.f32 %f4, %f1, 0f3FB8AA3B;", "@%p2 ex2.approx.f32 %f3, %f4;",
        "setp.eq.u32 %p2, %r6, 3;", "@%p2 lg2.approx.f32 %f4, %f1;", "@%p2 mul.f32 %f3, %f4, 0f3F317218;",
        "setp.eq.u32 %p2, %r6, 4;", "@%p2 mul.f32 %f4, %f1, 0f4038AA3B;", "@%p2 ex2.approx.f32 %f4, %f4;", "@%p2 add.f32 %f5, %f4, 0f3F800000;",
        "@%p2 div.rn.f32 %f6, 0f40000000, %f5;", "@%p2 sub.f32 %f3, 0f3F800000, %f6;",
        "setp.eq.u32 %p2, %r6, 5;", "@%p2 mul.f32 %f4, %f1, 0fBFB8AA3B;", "@%p2 ex2.approx.f32 %f4, %f4;", "@%p2 add.f32 %f5, %f4, 0f3F800000;",
        "@%p2 div.rn.f32 %f3, 0f3F800000, %f5;",
        "setp.eq.u32 %p2, %r6, 6;", "@%p2 sqrt.rn.f32 %f3, %f1;",
        "setp.eq.u32 %p2, %r6, 7;", "@%p2 abs.f32 %f3, %f1;",
        "setp.eq.u32 %p2, %r6, 8;", "@%p2 mul.f32 %f3, %f1, %f1;",
        "setp.eq.u32 %p2, %r6, 9;", "@%p2 setp.gt.f32 %p3, %f1, 0f00000000;", "@%p2 selp.f32 %f3, 0f3F800000, 0f00000000, %p3;",
        "add.s64 %rd9, %rd4, %rd7;", "st.global.f32 [%rd9], %f3;",
        "DONE:", "ret;", "}", ""
        add line to lines
    end
    # out[i] = v
    for each line in list of ".visible .entry fill(.param .u64 p_out, .param .f32 p_v, .param .u32 p_n)", "\{",
        ".reg .pred %p<2>;", ".reg .b32 %r<8>;", ".reg .f32 %f<2>;", ".reg .b64 %rd<10>;",
        "ld.param.u64 %rd1, [p_out];", "ld.param.f32 %f1, [p_v];", "ld.param.u32 %r5, [p_n];",
        "mov.u32 %r1, %ctaid.x;", "mov.u32 %r2, %ntid.x;", "mov.u32 %r3, %tid.x;", "mad.lo.s32 %r4, %r1, %r2, %r3;",
        "setp.ge.u32 %p1, %r4, %r5;", "@%p1 bra DONE;",
        "cvta.to.global.u64 %rd4, %rd1;", "mul.wide.u32 %rd7, %r4, 4;", "add.s64 %rd9, %rd4, %rd7;", "st.global.f32 [%rd9], %f1;",
        "DONE:", "ret;", "}", ""
        add line to lines
    end
    # out[0] += every a[i]: each thread adds up those a stride apart, a block adds up its threads' in fast memory,
    # and each block adds its own to out
    for each line in list of ".visible .entry sum(.param .u64 p_out, .param .u64 p_a, .param .u32 p_n)", "\{",
        ".shared .align 4 .f32 part[256];",
        ".reg .pred %p<4>;", ".reg .b32 %r<12>;", ".reg .f32 %f<4>;", ".reg .b64 %rd<10>;",
        "ld.param.u64 %rd1, [p_out];", "ld.param.u64 %rd2, [p_a];", "ld.param.u32 %r5, [p_n];",
        "cvta.to.global.u64 %rd4, %rd1;", "cvta.to.global.u64 %rd5, %rd2;",
        "mov.u32 %r1, %ctaid.x;", "mov.u32 %r2, %ntid.x;", "mov.u32 %r3, %tid.x;", "mad.lo.s32 %r4, %r1, %r2, %r3;",
        "mov.u32 %r7, %nctaid.x;", "mul.lo.s32 %r8, %r7, %r2;",
        "mov.f32 %f1, 0f00000000;",
        "LOOP:", "setp.ge.u32 %p1, %r4, %r5;", "@%p1 bra STORE;",
        "mul.wide.u32 %rd7, %r4, 4;", "add.s64 %rd8, %rd5, %rd7;", "ld.global.f32 %f2, [%rd8];", "add.f32 %f1, %f1, %f2;",
        "add.s32 %r4, %r4, %r8;", "bra LOOP;",
        "STORE:", "mov.u32 %r9, part;", "shl.b32 %r10, %r3, 2;", "add.u32 %r10, %r9, %r10;", "st.shared.f32 [%r10], %f1;", "bar.sync 0;",
        "mov.u32 %r11, 128;",
        "HALF:", "setp.eq.u32 %p2, %r11, 0;", "@%p2 bra ADD;",
        "setp.lt.u32 %p3, %r3, %r11;", "@!%p3 bra SYNC;",
        "shl.b32 %r6, %r11, 2;", "add.u32 %r6, %r10, %r6;", "ld.shared.f32 %f2, [%r6];", "ld.shared.f32 %f3, [%r10];", "add.f32 %f3, %f3, %f2;",
        "st.shared.f32 [%r10], %f3;",
        "SYNC:", "bar.sync 0;", "shr.u32 %r11, %r11, 1;", "bra HALF;",
        "ADD:", "setp.ne.u32 %p1, %r3, 0;", "@%p1 bra DONE;", "ld.shared.f32 %f2, [%r9];", "red.global.add.f32 [%rd4], %f2;",
        "DONE:", "ret;", "}", ""
        add line to lines
    end
    for each line in gpu_matmul_code()
        add line to lines
    end
    for each line in gpu_learning_code()
        add line to lines
    end
    for each line in gpu_transformer_code()
        add line to lines
    end
    for each line in gpu_fast_code()
        add line to lines
    end
    return join lines with "\n"
end

# c = a times b, a m by k, b k by n. Each block of 16 by 16 threads works out a 64 by 64 tile of c, each thread a 4
# by 4 of it, 16 apart, in registers: a 64 by 16 tile of a and a 16 by 64 of b are loaded into the card's fast
# memory in turn, and each of their 16 steps takes 8 numbers from it for 16 multiplications, where one each took 2
to gpu_matmul_code
    set lines to empty list
