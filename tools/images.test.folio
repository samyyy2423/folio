# images.folio's tests, which folio.test.js runs on every engine: PNGs and a JPEG that Pillow made, and what
# Pillow reads in each

use "images.folio" as images
use "base64.folio" as b64

to test_reading_png
    # rgba
    set made to images's image_from(b64's bytes_of_base64("iVBORw0KGgoAAAANSUhEUgAAAAUAAAADCAYAAABbNsX4AAAAN0lEQVR4nC3IMRHAIBAAsAwV8yIq4mdm8IAXbFRYHXyvHFsu0G9qUg/9pS7NIhCD2P7zRC4SOT6giguS+WfpoAAAAABJRU5ErkJggg=="))
    expect width of made is 5
    expect height of made is 3
    expect pixels of made is b64's bytes_of_base64("AAAAZDwAAP94AAD/tAAAZPAAAP8AWgD/PFoo/3haUGS0Wnj/8Fqg/wC0AP88tFBkeLSg/7S08P/wtEBk")
    # rgb
    set made to images's image_from(b64's bytes_of_base64("iVBORw0KGgoAAAANSUhEUgAAAAUAAAADCAIAAADUVFKvAAAAG0lEQVR4nGNkYGCwQUIsDFEMDAwacATnB0AQAEhgA2YH8tNBAAAAAElFTkSuQmCC"))
    expect width of made is 5
    expect height of made is 3
    expect pixels of made is b64's bytes_of_base64("AAAA/zwAAP94AAD/tAAA//AAAP8AWgD/PFoo/3haUP+0Wnj/8Fqg/wC0AP88tFD/eLSg/7S08P/wtED/")
    # grey
    set made to images's image_from(b64's bytes_of_base64("iVBORw0KGgoAAAANSUhEUgAAAAUAAAADCAAAAAB+XZokAAAAGklEQVR4nGNkEBISEmI0FRMXE2cxlZaW/gcADJkCYj/B6JYAAAAASUVORK5CYII="))
    expect width of made is 5
    expect height of made is 3
    expect pixels of made is b64's bytes_of_base64("AAAA/xISEv8kJCT/NjY2/0hISP81NTX/S0tL/2JiYv94eHj/j4+P/2pqav+FhYX/oKCg/7u7u/+5ubn/")
    # one bit
    set made to images's image_from(b64's bytes_of_base64("iVBORw0KGgoAAAANSUhEUgAAAAUAAAADAQAAAABzTfhVAAAADklEQVR4nGNgYNBg2AEAATYA4d7965gAAAAASUVORK5CYII="))
    expect width of made is 5
    expect height of made is 3
    expect pixels of made is b64's bytes_of_base64("AAAA/wAAAP8AAAD/AAAA/wAAAP8AAAD/AAAA//////8AAAD///////////8AAAD/////////////////")
    # palette
    set made to images's image_from(b64's bytes_of_base64("iVBORw0KGgoAAAANSUhEUgAAAAUAAAADAgMAAAAmWC1rAAAADFBMVEW0tJu0Wngehx54AABKz93sAAAAAnRSTlP/AOW3MEoAAAARSURBVHicY/h/gGGpA8MCBgASugNFTZoQDgAAAABJRU5ErkJggg=="))
    expect width of made is 5
    expect height of made is 3
    expect pixels of made is b64's bytes_of_base64("eAAA/3gAAP94AAD/eAAA/3gAAP8ehx7/Hoce/7RaeAC0WngAtFp4AB6HHv8ehx7/tLSb/7S0m/+0tJv/")
    # sixteen bits
    set made to images's image_from(b64's bytes_of_base64("iVBORw0KGgoAAAANSUhEUgAAAAUAAAADEAAAAAAuzUZnAAAAHklEQVR4nGNkYGAQgkBGBlMGMQZxEGZhMGWQBsN/ABWsAmIg8bHcAAAAAElFTkSuQmCC"))
    expect width of made is 5
    expect height of made is 3
    expect pixels of made is b64's bytes_of_base64("AAAA/wAAAP8AAAD/AAAA/wAAAP8AAAD/AAAA/wAAAP8AAAD/AAAA/wAAAP8AAAD/AAAA/wAAAP8AAAD/")
end

# a JPEG Pillow made, read within 4 of what Pillow reads in it, as the two round their sums their own ways
to test_reading_jpeg
    set made to images's image_from(b64's bytes_of_base64(""))
    set wanted to b64's bytes_of_base64("")
    expect width of made is 16
    expect height of made is 16
    expect largest_difference(pixels of made, wanted) is at most 4
end

to largest_difference with got, wanted
    set most to 0
    for each k from 1 to length of wanted
        set d to byte k of got - byte k of wanted
        if d is less than 0
            set d to 0 - d
        end
        if d is greater than most
            set most to d
        end
    end
    return most
end

# an image made here, written as a PNG and read back the same, and as a JPEG and read back close to it
to test_round_trips
    set made to images's new_image(7, 5, list of 0, 0, 0)
    for each y from 0 to 4
        for each x from 0 to 6
            images's set_pixel(made, x, y, list of x * 30, y * 50, 200 - x * y * 5, 255 - x * 20)
        end
    end
    set back to images's image_from(images's png_of(made))
    expect pixels of back is pixels of made
    set smooth to images's new_image(24, 20, nothing)
    for each y from 0 to 19
        for each x from 0 to 23
            images's set_pixel(smooth, x, y, list of 50 + x * 5, 180 - y * 4, 90 + x + y)
        end
    end
    set squeezed to images's jpeg_of(smooth, 95)
    expect byte 1 of squeezed is 255
    expect byte 2 of squeezed is 216
    set opened to images's image_from(squeezed)
    expect width of opened is 24
    expect height of opened is 20
    expect largest_difference(pixels of opened, pixels of smooth) is at most 10
end

to test_editing
    set made to images's new_image(4, 2, list of 10, 20, 30, 255)
    expect images's pixel(made, 3, 1) is list of 10, 20, 30, 255
    images's set_pixel(made, 0, 0, list of 255, 0, 0)
    images's set_pixel(made, 3, 0, list of 0, 0, 255, 128)
    expect images's pixel(made, 0, 0) is list of 255, 0, 0, 255
    expect images's pixel(images's flipped(made), 3, 0) is list of 255, 0, 0, 255
    expect images's pixel(images's flipped(made), 0, 0) is list of 0, 0, 255, 128
    set part to images's cropped(made, 2, 0, 2, 1)
    expect width of part is 2
    expect images's pixel(part, 1, 0) is list of 0, 0, 255, 128
    set bigger to images's resized(made, 8, 4)
    expect images's pixel(bigger, 1, 1) is list of 255, 0, 0, 255
    expect images's pixel(bigger, 7, 3) is list of 10, 20, 30, 255
    expect images's pixel(images's grey(made), 0, 0) is list of 76, 76, 76, 255
    expect images's pixel(images's new_image(1, 1, nothing), 0, 0) is list of 0, 0, 0, 0
end

to mistake_of with which
    set caught to nothing
    try
        if which is 1
            images's image_from("hello" as bytes)
        else if which is 2
            images's pixel(images's new_image(2, 2, nothing), 2, 0)
        else if which is 3
            images's jpeg_of(images's new_image(2, 2, nothing), 0)
        else if which is 4
            images's new_image(0, 5, nothing)
        else
            images's image_from(b64's bytes_of_base64(""))
        end
    if it fails with why
        set caught to why
    end
    return caught
end

to test_mistakes
    expect mistake_of(1) is "that isn't a PNG or a JPEG"
    expect mistake_of(2) is "there's no pixel 2, 0 in an image 2 by 2"
    expect mistake_of(3) is "a JPEG's quality is a whole number from 1 to 100, not 0"
    expect mistake_of(4) is "an image's width is a whole number of 1 or more, not 0"
    expect mistake_of(5) is "a progressive JPEG isn't read yet: save it as a baseline one"
end
