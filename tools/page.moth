# Web pages, made in Moth: headings, text, links, pictures, lists, tables, text boxes, buttons and the rest,
# styled with CSS of the page's own or Moth's, shown where the program runs on the web (the playground, or a
# page moth build --web made, as the whole window). What's clicked, typed or chosen on it comes back to the
# program: `when the page is used with what`, `what` a dictionary of its "type" ("click", "enter" for Enter
# in a text box, or "change"), the "name" of what was used, its "value", and "values": every text box's,
# checkbox's and dropdown's value on the page, by its name. Show the page again to change it.
#
#   use "page.moth" as page
#   set todos to list of "Feed the cat"
#   to view
#       set p to page's new("To do")
#       page's heading(p, "To do")
#       page's text_box(p, "new", "What needs doing?")
#       page's button(p, "add", "Add")
#       page's start_list(p)
#       for each t in todos
#           page's list_item(p, t)
#       end
#       page's end_list(p)
#       page's show(p)
#   end
#   when the page is used with what
#       if item "name" of what is "add"
#           add item "new" of item "values" of what to todos
#           view()
#       end
#   end
#   view()
#
# Every text is shown as it is, never read as HTML; html() puts HTML in as it's written, and anything in it
# with a data-moth="name" is used as a button is. A page is shown by writing it to the file "<page>", which
# the web shows instead of keeping. Elsewhere, html_of() is the page's HTML, to write to a file of its own or
# for server.moth to send; a site's pages have menu(), list_link() and forms, start_form() to end_form(),
# whose fields the browser sends to the server, as a page shown in the playground has no server to send to.

set page_file to "<page>"

# Moth's own look, before the page's own CSS
set page_base to "body \{ font: 17px/1.55 system-ui, -apple-system, Segoe UI, sans-serif; color: #1d1b16; background: #fbfaf7; max-width: 46rem; margin: 2rem auto; padding: 0 1.2rem; }\nh1, h2, h3 \{ line-height: 1.2; }\na \{ color: #1c5fb4; }\nbutton \{ font: inherit; padding: .45rem 1rem; border: 0; border-radius: 6px; background: #1d1b16; color: #fff; cursor: pointer; }\nbutton:hover \{ background: #3d3a33; }\ninput, textarea, select \{ font: inherit; padding: .4rem .6rem; border: 1px solid #c9c4b8; border-radius: 6px; background: #fff; }\ninput[type=checkbox] \{ width: 1.1rem; height: 1.1rem; }\ntable \{ border-collapse: collapse; }\nth, td \{ text-align: left; padding: .35rem .8rem; border-bottom: 1px solid #e3dfd5; }\nimg \{ max-width: 100%; }\n.row \{ display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; }\n.menu \{ display: flex; gap: 1.2rem; flex-wrap: wrap; padding: .8rem 0; margin-bottom: 1.5rem; border-bottom: 1px solid #e3dfd5; }\n.menu a \{ font-weight: 600; text-decoration: none; }\n.mistake \{ color: #a3261b; }\nform \{ display: grid; gap: .7rem; max-width: 30rem; }\n.card \{ background: #fff; border: 1px solid #e3dfd5; border-radius: 10px; padding: 1rem 1.2rem; margin: 1rem 0; }\n"

# text as HTML shows it: & < > and " written as their names
to escaped with words
    set out to ""
    for each c in split ("" + words) by ""
        if c is "&"
            set out to out + "&amp;"
        else if c is "<"
            set out to out + "&lt;"
        else if c is ">"
            set out to out + "&gt;"
        else if c is "\""
            set out to out + "&quot;"
        else
            set out to out + c
        end
    end
    return out
end

# a page, by its title, with nothing on it yet
to new with title
    return record with title title, parts empty list, open empty list, css ""
end

to page_add with on, html_text
    set kept to parts of on
    add html_text to kept
end

# an element's attributes for being used: its name, for what comes back to the program
to page_named with name
    return " data-moth=\"" + escaped(name) + "\" name=\"" + escaped(name) + "\""
end

# the page's heading
to heading with on, words
    page_add(on, "<h1>" + escaped(words) + "</h1>")
end

# a heading below it, for a part of the page
to subheading with on, words
    page_add(on, "<h2>" + escaped(words) + "</h2>")
end

# a paragraph of text
to paragraph with on, words
    page_add(on, "<p>" + escaped(words) + "</p>")
end

# text in bold, in a paragraph of its own
to bold with on, words
    page_add(on, "<p><strong>" + escaped(words) + "</strong></p>")
end

# code, or anything else whose lines and spaces are kept as they are
to code_block with on, words
    page_add(on, "<pre><code>" + escaped(words) + "</code></pre>")
end

# a link to another page or site, which opens in a tab of its own
to link with on, words, address
    page_add(on, "<p><a href=\"" + escaped(address) + "\" target=\"_blank\" rel=\"noopener\">" + escaped(words) + "</a></p>")
end

# a picture, from its address, and what it shows, for those who can't see it
to picture with on, address, shows
    page_add(on, "<img src=\"" + escaped(address) + "\" alt=\"" + escaped(shows) + "\">")
end

# a line across the page
to rule with on
    page_add(on, "<hr>")
end

# a button: clicking it is a "click" with its name
to button with on, name, words
    page_add(on, "<button type=\"button\"" + page_named(name) + ">" + escaped(words) + "</button>")
end

# a text box, by its name, with a hint in it until something's typed, and what's in it to start with
to text_box with on, name, hint, value or ""
    page_add(on, "<input type=\"text\"" + page_named(name) + " placeholder=\"" + escaped(hint) + "\" value=\"" + escaped(value) + "\">")
end

# a box for lines of text
to text_area with on, name, hint, value or ""
    page_add(on, "<textarea rows=\"4\"" + page_named(name) + " placeholder=\"" + escaped(hint) + "\">" + escaped(value) + "</textarea>")
end

# a checkbox with its words beside it, ticked or not: its value is yes or no
to checkbox with on, name, words, ticked or no
    set tick to ""
    if ticked
        set tick to " checked"
    end
    page_add(on, "<label class=\"row\"><input type=\"checkbox\"" + page_named(name) + tick + "> " + escaped(words) + "</label>")
end

# a dropdown of choices, one of them chosen to start with
to dropdown with on, name, choices, chosen or nothing
    set out to "<select" + page_named(name) + ">"
    for each c in choices
        set picked to ""
        if c is chosen
            set picked to " selected"
        end
        set out to out + "<option" + picked + ">" + escaped(c) + "</option>"
    end
    page_add(on, out + "</select>")
end

# a list, an item at a time until end_list(), with bullets or (numbered yes) numbers
to start_list with on, numbered or no
    set tag to "ul"
    if numbered
        set tag to "ol"
    end
    page_open(on, tag, "")
end

# an item of the list
to list_item with on, words
    page_add(on, "<li>" + escaped(words) + "</li>")
end

# an item of the list that's a link, to a page of the site
to list_link with on, words, address
    page_add(on, "<li><a href=\"" + escaped(address) + "\">" + escaped(words) + "</a></li>")
end

# the end of the list started last
to end_list with on
    page_close(on, "list")
end

# a row of links to a site's pages: their names, and their addresses, in the same order
to menu with on, names, addresses
    if length of names is not length of addresses
        fail with "page.moth: a menu needs an address for each name"
    end
    set out to "<nav class=\"menu\">"
    for each k from 1 to length of names
        set out to out + "<a href=\"" + escaped(item k of addresses) + "\">" + escaped(item k of names) + "</a>"
    end
    page_add(on, out + "</nav>")
end

# a table, its headings first, then a row at a time until end_table()
to start_table with on, headings
    set out to "<table><thead><tr>"
    for each h in headings
        set out to out + "<th>" + escaped(h) + "</th>"
    end
    page_add(on, out + "</tr></thead><tbody>")
    set kept to open of on
    add "tbody></table" to kept
end

# a row of the table: its cells, a list
to table_row with on, cells
    set out to "<tr>"
    for each c in cells
        set out to out + "<td>" + escaped(c) + "</td>"
    end
    page_add(on, out + "</tr>")
end

# the end of the table started last
to end_table with on
    page_close(on, "table")
end

# what's put on the page until finish() goes in a box of its own: "row" for side by side, "card" for a box
# with a border, or any class of the page's own CSS
to start with on, kind_of_box
    page_open(on, "div", kind_of_box)
end

# the end of the box started last
to finish with on
    page_close(on, "box")
end

# a form, until end_form(): what's in it, its text boxes, checkboxes and dropdowns, a browser sends to the
# address when its submit() button is pressed, by their names: as a POST, which is server.moth's request's
# body, or with the method "get", after a ? in the address, its query
to start_form with on, address, method or "post"
    page_add(on, "<form method=\"" + escaped(method) + "\" action=\"" + escaped(address) + "\">")
    set kept to open of on
    add "form" to kept
end

# a button that sends the form
to submit with on, words
    page_add(on, "<button type=\"submit\">" + escaped(words) + "</button>")
end

# the end of the form started last
to end_form with on
    page_close(on, "form")
end

to page_open with on, tag, class
    set attributes to ""
    if class is not ""
        set attributes to " class=\"" + escaped(class) + "\""
    end
    page_add(on, "<" + tag + attributes + ">")
    set kept to open of on
    add tag to kept
end

# what an open tag is called, in what page.moth says
to page_kind with tag
    if tag is "ul" or tag is "ol"
        return "list"
    else if tag is "div"
        return "box"
    else if tag is "form"
        return "form"
    end
    return "table"
end

to page_close with on, kind
    set kept to open of on
    if length of kept is 0
        fail with "page.moth: there's no " + kind + " started to end"
    end
    set tag to item (length of kept) of kept
    if page_kind(tag) is not kind
        fail with "page.moth: the " + page_kind(tag) + " started last isn't ended yet"
    end
    set rest to empty list
    for each k from 1 to length of kept - 1
        add item k of kept to rest
    end
    set open of on to rest
    page_add(on, "</" + tag + ">")
end

# CSS of the page's own, after Moth's
to style with on, css
    set css of on to css of on + css + "\n"
end

# HTML, put on the page as it's written: no text in it is made safe
to html with on, written
    page_add(on, written)
end

# the page's HTML, as show() shows it
to html_of with on
    set closed to ""
    set kept to open of on
    for each k from 1 to length of kept
        set closed to closed + "</" + item (length of kept - k + 1) of kept + ">"
    end
    return "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>" + escaped(title of on) + "</title>\n<style>\n" + page_base + css of on + "</style>\n</head>\n<body>\n" + (join parts of on with "\n") + closed + "\n</body>\n</html>\n"
end

# the page, shown: in place of the one shown before, if there was one
to show with on
    write html_of(on) to page_file
end
