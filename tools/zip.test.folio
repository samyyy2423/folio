# zip.folio's own tests: `folio test zip.test.folio`
use "zip.folio" as zip

to test_checks
    expect zip's crc32("123456789") is 3421780262
    expect zip's crc32("") is 0
    expect zip's crc32(256 bytes) is 227968344
end

# what zlib made: gzip of "hello\n", and DEFLATE's three kinds of block, as it is, with the fixed code, and with
# codes of its own
to test_reading_what_zlib_makes
    set hello to list of 31, 139, 8, 0, 0, 0, 0, 0, 2, 10, 203, 72, 205, 201, 201, 231, 2, 0, 32, 48, 58, 54, 6, 0, 0, 0
    expect zip's gunzip(hello as bytes) as text is "hello\n"
    set stored to list of 1, 12, 0, 243, 255, 115, 116, 111, 114, 101, 100, 32, 98, 121, 116, 101, 115
    expect zip's inflate(stored as bytes) as text is "stored bytes"
    set own to list of 165, 202, 209, 9, 128, 48, 12, 69, 209, 85, 222, 0, 226, 22, 22, 28, 35, 180, 197, 6, 67, 42, 73, 164, 235, 91,
        93, 193, 223, 123, 110, 234, 194, 29, 86, 169, 56, 132, 207, 138, 75, 136, 21, 155, 30, 194, 222, 86, 164, 159,
        190, 7, 26, 189, 228, 225, 203, 252, 114, 183, 121, 146, 22, 20, 206, 193, 93, 201, 184, 78, 249, 138, 209,
        112, 12, 142, 6, 66, 220, 22, 82, 215, 7
    set line to "Folio reads like plain English. "
    expect zip's inflate(own as bytes) as text is line + line + line + "It has lists, records and dictionaries, and draws with a turtle."
end

to test_round_trips
    set many to empty list
    for each i from 1 to 3000
        add item (remainder of i * 7 divided by 5) + 1 of (list of "folio", "lamp", "night", "é", "😀") to many
    end
    set every_byte to empty list
    for each b from 0 to 255
        add b to every_byte
    end
    for each data in list of "", "a", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", join many with " ", 70000 bytes, every_byte as bytes
        set block to data as bytes
        expect zip's inflate(zip's deflate(block)) is block
        expect zip's gunzip(zip's gzip(block)) is block
    end
    expect length of zip's gzip(70000 bytes) is less than 200
    expect length of zip's deflate(every_byte as bytes) is at most 261 # as it is, when squeezing would make it bigger
end

to test_archives
    set names to list of "a.txt", "folder/", "folder/b.bin", "é.txt"
    set contents to list of "one", "", 1000 bytes, "two"
    set files to zip's unzipped(zip's zipped(names, contents))
    expect length of files is 4
    for each k from 1 to 4
        expect item (item k of names) of files is item k of contents as bytes
    end
    expect zip's unzipped(zip's zipped(empty list, empty list)) is empty dictionary
end

# a few bytes of copies stand for many: with `most`, no more than that, and a zip file's things no bigger than its
# list says (DESIGN §188)
to test_no_more_than_it_should
    set many to 100000 bytes
    set squeezed to zip's deflate(many)
    expect length of zip's inflate(squeezed, 100000) is 100000
    set caught to nothing
    try
        zip's inflate(squeezed, 1000)
    if it fails with why
        set caught to why
    end
    expect caught is "the compressed data stands for more than the 1000 bytes it should"
    set packed to zip's zipped((list of "big.bin"), (list of many)) as bytes
    set place to 0
    for each k from 1 to length of packed - 3
        if place is 0 and byte k of packed is 80 and byte (k + 1) of packed is 75 and byte (k + 2) of packed is 1 and byte (k + 3) of packed is 2
            set place to k
        end
    end
    expect place is greater than 0
    set byte (place + 24) of packed to 10 # its list says 10 bytes
    set byte (place + 25) of packed to 0
    set byte (place + 26) of packed to 0
    set byte (place + 27) of packed to 0
    set caught to nothing
    try
        zip's unzipped(packed)
    if it fails with why
        set caught to why
    end
    expect caught is "the compressed data stands for more than the 10 bytes it should"
end

# what the call, by its number, fails with
to mistake_of with which
    set caught to nothing
    try
        if which is 1
            zip's gunzip("not gzip at all")
        else if which is 2
            zip's inflate((list of 7) as bytes)
        else if which is 3
            zip's unzipped("PK, but not really")
        else if which is 4
            set made to zip's gzip("hello") as bytes
            set byte 12 of made to 0
            zip's gunzip(made)
        else
            zip's inflate((list of 1, 5, 0) as bytes)
        end
    if it fails with why
        set caught to why
    end
    return caught
end

to test_mistakes
    expect mistake_of(1) is "this isn't gzip: it doesn't start with gzip's two bytes"
    expect mistake_of(2) is "the compressed data has a block of a kind DEFLATE doesn't have"
    expect mistake_of(3) is "this isn't a zip file: it has no list of what it holds"
    expect mistake_of(4) is not nothing
    expect mistake_of(5) is "the compressed data ends too soon"
end
