# Hashes, as Python's hashlib and hmac have them: a text's or bytes' SHA-256, SHA-224, SHA-512, SHA-384, SHA-1
# or MD5, as the hex digits `sha256sum` and every other program give for the same bytes (a text's are its
# UTF-8); HMAC, a hash with a key, which says a message came from one who knows it; and PBKDF2, a key made
# from a password slowly, to keep passwords. In Folio alone, so it works everywhere. (SHA-1 and MD5 are broken
# for keeping secrets: they're here for checking files and talking to what still uses them.)
#
#   use "hash.folio" as hash
#   say hash's sha256("abc")             # ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
#   say hash's sha256(read bytes "folio.exe")
#   say hash's digest("sha512", "abc")   # any of them by its name: md5, sha1, sha224, sha256, sha384, sha512
#   say hash's sha224("abc")             # and sha384, sha512; sha1 and md5 for what still uses them
#   say hash's sha384("abc")
#   say hash's sha512("abc")
#   say hash's sha1("abc")
#   say hash's md5("abc")
#   say hash's hmac("sha256", "key", "The quick brown fox jumps over the lazy dog")
#   say hash's pbkdf2("sha256", "password", "salt", 1000, 32)   # 32 bytes, as hex
#   say hash's bytes_of_hex("ff00")      # (2 bytes: 255, 0); hex_of(bytes) back

set hash_constants to list of 1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748,
    2870763221, 3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
    3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986, 2554220882,
    2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895, 666307205, 773529912,
    1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037, 2730485921, 2820302411, 3259730800,
    3345764771, 3516065817, 3600352804, 4094571909, 275423344, 430227734, 506948616, 659060556, 883997877,
