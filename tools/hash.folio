set hash_512_constants to list of 1116352408, 3609767458, 1899447441, 602891725, 3049323471, 3964484399, 3921009573,
    2173295548, 961987163, 4081628472, 1508970993, 3053834265, 2453635748, 2937671579, 2870763221, 3664609560,
