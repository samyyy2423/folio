set hash_224_starts to list of 3238371032, 914150663, 812702999, 4144912697, 4290775857, 1750603025, 1694076839,
    3204075428
set hash_md5_constants to list of 3614090360, 3905402710, 606105819, 3250441966, 4118548399, 1200080426, 2821735955,
    4249261313, 1770035416, 2336552879, 4294925233, 2304563134, 1804603682, 4254626195, 2792965006, 1236535329,
