    2618297676, 1288033470, 3409855158, 1501505948, 4234509866, 1607167915, 987167468, 1816402316, 1246189591
set hash_512_starts to list of 1779033703, 4089235720, 3144134277, 2227873595, 1013904242, 4271175723, 2773480762,
    1595750129, 1359893119, 2917565137, 2600822924, 725511199, 528734635, 4215389547, 1541459225, 327033209
set hash_384_starts to list of 3418070365, 3238371032, 1654270250, 914150663, 2438529370, 812702999, 355462360,
    4144912697, 1731405415, 4290775857, 2394180231, 1750603025, 3675008525, 1694076839, 1203062813, 3204075428
set hash_md5_shifts to list of 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20,
    5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15,
    21, 6, 10, 15, 21, 6, 10, 15, 21
set hash_powers to list of 1 # 2 to the 0th, 1st, ... 32nd, from item 1
repeat 32 times
    add item (length of hash_powers) of hash_powers * 2 to hash_powers
end
set hash_hex_digits to "0123456789abcdef"

# a 32-bit number turned right by n: what falls off the right comes back on the left, kept below 2^53 all along
to hash_turn with x, n
    return (shift x right by n) + (x bit and (item (n + 1) of hash_powers - 1)) * item (33 - n) of hash_powers
end

# turned left by n
to hash_left with x, n
    return hash_turn(x, 32 - n)
end

to hash_add with x, y
    return (x + y) bit and 4294967295
end

to hash_bytes_of with data as text
    return data as bytes
end

# a text's UTF-8, or bytes as they are
to hash_message with data
    try
        return hash_bytes_of(data)
    if it fails
        return data
    end
end

# the message, then 128, then 0s, then its length in bits in `size` bytes, to a whole number of blocks of `block`
# bytes; the length the highest byte first, or (for MD5) the lowest
to hash_padded with message, block, size, lowest_first
    set count to length of message
    set blocks to hash_whole((count + size) / block) + 1
    set padded to (block * blocks) bytes
    for each k from 1 to count
        set byte k of padded to byte k of message
    end
    set byte (count + 1) of padded to 128
    set bits to count * 8
    for each k from 0 to 6 # 2^56 bits is plenty
        if lowest_first
            set byte (block * blocks - size + 1 + k) of padded to bits bit and 255
        else
            set byte (block * blocks - k) of padded to bits bit and 255
        end
        set bits to shift bits right by 8
    end
    return padded
end

# 32-bit numbers as hex, 8 digits each, the highest byte first, or (for MD5) the lowest
to hash_hex_words with words, lowest_first
    set made to empty list
    for each part in words
        if lowest_first
            set left to part
            repeat 4 times
                add hash_hex_byte(left bit and 255) to made
                set left to shift left right by 8
            end
        else
            set shown to part as hex
            repeat 8 - length of shown times
                set shown to "0" + shown
            end
            add shown to made
        end
    end
    return join made with ""
end

to hash_hex_byte with b
    return item ((shift b right by 4) + 1) of hash_hex_digits + item ((b bit and 15) + 1) of hash_hex_digits
end

# ---------- SHA-256 and SHA-224 ----------

# the hash of a text or of bytes, as 64 hex digits
to sha256 with data
    return hash_hex_words(hash_256_words(hash_message(data), hash_starts), no)
end

# as 56 hex digits: SHA-256 from other starting words, its first 7
to sha224 with data
    set words to hash_256_words(hash_message(data), hash_224_starts)
    return hash_hex_words(items 1 to 7 of words, no)
end

to hash_256_words with message, starts
    set padded to hash_padded(message, 64, 8, no)
    set blocks to length of padded / 64
    set h to empty list
    for each start in starts
        add start to h
    end
    set w to empty list
    repeat 64 times
        add 0 to w
    end
    for each block from 0 to blocks - 1
        set at to 64 * block
        for each t from 1 to 16
            set b to at + 4 * t - 3
            set item t of w to byte b of padded * 16777216 + byte (b + 1) of padded * 65536 + byte (b + 2) of padded * 256
                + byte (b + 3) of padded
        end
        for each t from 17 to 64
            set x to item (t - 15) of w
            set y to item (t - 2) of w
            set small0 to hash_turn(x, 7) bit xor hash_turn(x, 18) bit xor (shift x right by 3)
            set small1 to hash_turn(y, 17) bit xor hash_turn(y, 19) bit xor (shift y right by 10)
            set item t of w to (item (t - 16) of w + small0 + item (t - 7) of w + small1) bit and 4294967295
        end
        set a to item 1 of h
        set b2 to item 2 of h
        set c to item 3 of h
        set d to item 4 of h
        set e to item 5 of h
        set f to item 6 of h
        set g to item 7 of h
        set hh to item 8 of h
        for each t from 1 to 64
            set big1 to hash_turn(e, 6) bit xor hash_turn(e, 11) bit xor hash_turn(e, 25)
            set choice to (e bit and f) bit xor ((4294967295 - e) bit and g)
            set temp1 to (hh + big1 + choice + item t of hash_constants + item t of w) bit and 4294967295
            set big0 to hash_turn(a, 2) bit xor hash_turn(a, 13) bit xor hash_turn(a, 22)
            set most to (a bit and b2) bit xor (a bit and c) bit xor (b2 bit and c)
            set temp2 to hash_add(big0, most)
            set hh to g
            set g to f
            set f to e
            set e to hash_add(d, temp1)
            set d to c
            set c to b2
            set b2 to a
            set a to hash_add(temp1, temp2)
        end
        set item 1 of h to hash_add(item 1 of h, a)
        set item 2 of h to hash_add(item 2 of h, b2)
        set item 3 of h to hash_add(item 3 of h, c)
        set item 4 of h to hash_add(item 4 of h, d)
        set item 5 of h to hash_add(item 5 of h, e)
        set item 6 of h to hash_add(item 6 of h, f)
        set item 7 of h to hash_add(item 7 of h, g)
        set item 8 of h to hash_add(item 8 of h, hh)
    end
    return h
end

# ---------- SHA-1 ----------

# the hash of a text or of bytes, as 40 hex digits
to sha1 with data
    set padded to hash_padded(hash_message(data), 64, 8, no)
    set h to list of 1732584193, 4023233417, 2562383102, 271733878, 3285377520
    set w to empty list
    repeat 80 times
        add 0 to w
    end
    for each block from 0 to length of padded / 64 - 1
        set at to 64 * block
        for each t from 1 to 16
            set b to at + 4 * t - 3
            set item t of w to byte b of padded * 16777216 + byte (b + 1) of padded * 65536 + byte (b + 2) of padded * 256
                + byte (b + 3) of padded
        end
        for each t from 17 to 80
            set item t of w to hash_left(item (t - 3) of w bit xor item (t - 8) of w bit xor item (t - 14) of w bit xor item (t - 16) of w, 1)
        end
        set a to item 1 of h
        set b2 to item 2 of h
        set c to item 3 of h
        set d to item 4 of h
        set e to item 5 of h
        for each t from 1 to 80
            set f to 0
            set k to 0
            if t is at most 20
                set f to (b2 bit and c) bit xor ((4294967295 - b2) bit and d)
                set k to 1518500249
            else if t is at most 40
                set f to b2 bit xor c bit xor d
                set k to 1859775393
            else if t is at most 60
                set f to (b2 bit and c) bit xor (b2 bit and d) bit xor (c bit and d)
                set k to 2400959708
            else
                set f to b2 bit xor c bit xor d
                set k to 3395469782
            end
            set temp to (hash_left(a, 5) + f + e + k + item t of w) bit and 4294967295
            set e to d
            set d to c
            set c to hash_left(b2, 30)
            set b2 to a
            set a to temp
        end
        set item 1 of h to hash_add(item 1 of h, a)
        set item 2 of h to hash_add(item 2 of h, b2)
        set item 3 of h to hash_add(item 3 of h, c)
        set item 4 of h to hash_add(item 4 of h, d)
        set item 5 of h to hash_add(item 5 of h, e)
    end
    return hash_hex_words(h, no)
end

# ---------- MD5 ----------

# the hash of a text or of bytes, as 32 hex digits
to md5 with data
    set padded to hash_padded(hash_message(data), 64, 8, yes)
    set h to list of 1732584193, 4023233417, 2562383102, 271733878
    set m to empty list
    repeat 16 times
        add 0 to m
    end
    for each block from 0 to length of padded / 64 - 1
        set at to 64 * block
        for each t from 1 to 16 # each word's lowest byte first
            set b to at + 4 * t - 3
            set item t of m to byte (b + 3) of padded * 16777216 + byte (b + 2) of padded * 65536 + byte (b + 1) of padded * 256
                + byte b of padded
        end
        set a to item 1 of h
        set b2 to item 2 of h
        set c to item 3 of h
        set d to item 4 of h
        for each i from 0 to 63
            set f to 0
            set g to 0
            if i is less than 16
                set f to (b2 bit and c) bit xor ((4294967295 - b2) bit and d)
                set g to i
            else if i is less than 32
                set f to (d bit and b2) bit xor ((4294967295 - d) bit and c)
                set g to remainder of (5 * i + 1) divided by 16
            else if i is less than 48
                set f to b2 bit xor c bit xor d
                set g to remainder of (3 * i + 5) divided by 16
            else
                set f to c bit xor (b2 bit or (4294967295 - d))
                set g to remainder of (7 * i) divided by 16
            end
            set f to (f + a + item (i + 1) of hash_md5_constants + item (g + 1) of m) bit and 4294967295
            set a to d
            set d to c
            set c to b2
            set b2 to hash_add(b2, hash_left(f, item (i + 1) of hash_md5_shifts))
        end
        set item 1 of h to hash_add(item 1 of h, a)
        set item 2 of h to hash_add(item 2 of h, b2)
        set item 3 of h to hash_add(item 3 of h, c)
        set item 4 of h to hash_add(item 4 of h, d)
    end
    return hash_hex_words(h, yes)
end

# ---------- SHA-512 and SHA-384 ----------

# A 64-bit word is two 32-bit numbers, its high half and its low, each kept below 2^32, so every sum stays exact.

# the high half of (hi, lo) turned right by n, from 1 to 63; hash_turn_low its low half
to hash_turn_high with hi, lo, n
    if n is at least 32
        return hash_turn_high(lo, hi, n - 32)
    end
    if n is 0
        return hi
    end
    return (shift hi right by n) + (lo bit and (item (n + 1) of hash_powers - 1)) * item (33 - n) of hash_powers
end

to hash_turn_low with hi, lo, n
    if n is at least 32
        return hash_turn_low(lo, hi, n - 32)
    end
    if n is 0
        return lo
    end
    return (shift lo right by n) + (hi bit and (item (n + 1) of hash_powers - 1)) * item (33 - n) of hash_powers
end

# the low half of (hi, lo) shifted right by n, below 32 (the high half is hi shifted)
to hash_shift_low with hi, lo, n
    return (shift lo right by n) + (hi bit and (item (n + 1) of hash_powers - 1)) * item (33 - n) of hash_powers
end

# the hash of a text or of bytes, as 128 hex digits
to sha512 with data
    return hash_hex_words(hash_512_words(hash_message(data), hash_512_starts), no)
end

# as 96 hex digits: SHA-512 from other starting words, its first 6
to sha384 with data
    set words to hash_512_words(hash_message(data), hash_384_starts)
    return hash_hex_words(items 1 to 12 of words, no)
end

# the 8 64-bit words, as 16 halves, the high half first
to hash_512_words with message, starts
    set padded to hash_padded(message, 128, 16, no)
    set h to empty list
    for each start in starts
        add start to h
    end
    set wh to empty list
    set wl to empty list
    repeat 80 times
        add 0 to wh
        add 0 to wl
    end
    for each block from 0 to length of padded / 128 - 1
        set at to 128 * block
        for each t from 1 to 16
            set b to at + 8 * t - 7
            set item t of wh to byte b of padded * 16777216 + byte (b + 1) of padded * 65536 + byte (b + 2) of padded * 256
                + byte (b + 3) of padded
            set item t of wl to byte (b + 4) of padded * 16777216 + byte (b + 5) of padded * 65536 + byte (b + 6) of padded * 256
                + byte (b + 7) of padded
        end
        for each t from 17 to 80
            set xh to item (t - 15) of wh
            set xl to item (t - 15) of wl
            set s0h to hash_turn_high(xh, xl, 1) bit xor hash_turn_high(xh, xl, 8) bit xor (shift xh right by 7)
            set s0l to hash_turn_low(xh, xl, 1) bit xor hash_turn_low(xh, xl, 8) bit xor hash_shift_low(xh, xl, 7)
            set yh to item (t - 2) of wh
            set yl to item (t - 2) of wl
            set s1h to hash_turn_high(yh, yl, 19) bit xor hash_turn_high(yh, yl, 61) bit xor (shift yh right by 6)
            set s1l to hash_turn_low(yh, yl, 19) bit xor hash_turn_low(yh, yl, 61) bit xor hash_shift_low(yh, yl, 6)
            set low to item (t - 16) of wl + s0l + item (t - 7) of wl + s1l
            set low_part to remainder of low divided by 4294967296
            set item t of wl to low_part
            set item t of wh to remainder of (item (t - 16) of wh + s0h + item (t - 7) of wh + s1h + (low - low_part) / 4294967296) divided by 4294967296
        end
        set ah to item 1 of h
        set al to item 2 of h
        set bh to item 3 of h
        set bl to item 4 of h
        set ch to item 5 of h
        set cl to item 6 of h
        set dh to item 7 of h
        set dl to item 8 of h
        set eh to item 9 of h
        set el to item 10 of h
        set fh to item 11 of h
        set fl to item 12 of h
        set gh to item 13 of h
        set gl to item 14 of h
        set hh to item 15 of h
        set hl to item 16 of h
        for each t from 1 to 80
            set big1h to hash_turn_high(eh, el, 14) bit xor hash_turn_high(eh, el, 18) bit xor hash_turn_high(eh, el, 41)
            set big1l to hash_turn_low(eh, el, 14) bit xor hash_turn_low(eh, el, 18) bit xor hash_turn_low(eh, el, 41)
            set chh to (eh bit and fh) bit xor ((4294967295 - eh) bit and gh)
            set chl to (el bit and fl) bit xor ((4294967295 - el) bit and gl)
            set low to hl + big1l + chl + item (2 * t) of hash_512_constants + item t of wl
            set t1l to remainder of low divided by 4294967296
            set t1h to remainder of (hh + big1h + chh + item (2 * t - 1) of hash_512_constants + item t of wh + (low - t1l) / 4294967296) divided by 4294967296
            set big0h to hash_turn_high(ah, al, 28) bit xor hash_turn_high(ah, al, 34) bit xor hash_turn_high(ah, al, 39)
            set big0l to hash_turn_low(ah, al, 28) bit xor hash_turn_low(ah, al, 34) bit xor hash_turn_low(ah, al, 39)
            set majh to (ah bit and bh) bit xor (ah bit and ch) bit xor (bh bit and ch)
            set majl to (al bit and bl) bit xor (al bit and cl) bit xor (bl bit and cl)
            set low to big0l + majl
            set t2l to remainder of low divided by 4294967296
            set t2h to remainder of (big0h + majh + (low - t2l) / 4294967296) divided by 4294967296
            set hh to gh
            set hl to gl
            set gh to fh
            set gl to fl
            set fh to eh
            set fl to el
            set low to dl + t1l
            set el to remainder of low divided by 4294967296
            set eh to remainder of (dh + t1h + (low - el) / 4294967296) divided by 4294967296
            set dh to ch
            set dl to cl
            set ch to bh
            set cl to bl
            set bh to ah
            set bl to al
            set low to t1l + t2l
            set al to remainder of low divided by 4294967296
            set ah to remainder of (t1h + t2h + (low - al) / 4294967296) divided by 4294967296
        end
        set made to list of ah, al, bh, bl, ch, cl, dh, dl, eh, el, fh, fl, gh, gl, hh, hl
        for each k from 1 to 8
            set low to item (2 * k) of h + item (2 * k) of made
            set low_part to remainder of low divided by 4294967296
            set item (2 * k) of h to low_part
            set item (2 * k - 1) of h to remainder of (item (2 * k - 1) of h + item (2 * k - 1) of made + (low - low_part) / 4294967296) divided by 4294967296
        end
    end
    return h
end

# ---------- by name, with a key, and from a password ----------

# a hash by its name, "md5", "sha1", "sha224", "sha256", "sha384" or "sha512", as hex
to digest with name, data
    set wanted to lowercase of name
    if wanted is "sha256"
        return sha256(data)
    else if wanted is "sha224"
        return sha224(data)
    else if wanted is "sha512"
        return sha512(data)
    else if wanted is "sha384"
        return sha384(data)
    else if wanted is "sha1"
        return sha1(data)
    else if wanted is "md5"
        return md5(data)
    end
    fail with "there's no hash called '" + name + "' here: md5, sha1, sha224, sha256, sha384 and sha512 are"
end

# HMAC (RFC 2104): the hash, by its name, of the key and the data together, as hex
to hmac with name, key, data
    set block to 64
    if lowercase of name is "sha384" or lowercase of name is "sha512"
        set block to 128
    end
    set k to hash_message(key)
    if length of k is greater than block
        set k to bytes_of_hex(digest(name, k))
    end
    set message to hash_message(data)
    set inner to (block + length of message) bytes
    set outer_key to block bytes
    for each i from 1 to block
        set b to 0
        if i is at most length of k
            set b to byte i of k
        end
        set byte i of inner to b bit xor 54
        set byte i of outer_key to b bit xor 92
    end
    for each i from 1 to length of message
        set byte (block + i) of inner to byte i of message
    end
    set inner_hash to bytes_of_hex(digest(name, inner))
    set outer to (block + length of inner_hash) bytes
    for each i from 1 to block
        set byte i of outer to byte i of outer_key
    end
    for each i from 1 to length of inner_hash
        set byte (block + i) of outer to byte i of inner_hash
    end
    return digest(name, outer)
end

# PBKDF2 (RFC 8018) with HMAC of the hash by its name: `size` bytes made from a password and salt over so many
# rounds, as hex; each round is two hashes, so more rounds make guessing a password slower too
to pbkdf2 with name, password, salt, rounds, size
    set salted to hash_message(salt)
    set made to empty list
    set count to 1
    repeat while length of made is less than size
        set first to (length of salted + 4) bytes
        for each i from 1 to length of salted
            set byte i of first to byte i of salted
        end
        set n to length of salted
        set byte (n + 1) of first to (shift count right by 24) bit and 255
        set byte (n + 2) of first to (shift count right by 16) bit and 255
        set byte (n + 3) of first to (shift count right by 8) bit and 255
        set byte (n + 4) of first to count bit and 255
        set u to bytes_of_hex(hmac(name, password, first))
        set t to empty list
        for each b in u
            add b to t
        end
        repeat rounds - 1 times
            set u to bytes_of_hex(hmac(name, password, u))
            for each i from 1 to length of t
                set item i of t to item i of t bit xor byte i of u
            end
        end
        for each b in t
            if length of made is less than size
                add b to made
            end
        end
        set count to count + 1
    end
    return hex_of(made as bytes)
end

# ---------- hex ----------

# bytes as hex, two digits each
to hex_of with data
    set made to empty list
    for each b in hash_message(data)
        add hash_hex_byte(b) to made
    end
    return join made with ""
end

# hex, as "ff00" or "FF00", back to its bytes
to bytes_of_hex with digits
    set low to lowercase of digits
    if remainder of length of low divided by 2 is not 0
        fail with "hex has two digits for each byte, and '" + digits + "' has an odd number"
    end
    set made to (length of low / 2) bytes
    for each k from 1 to length of made
        set high to position of item (2 * k - 1) of low in hash_hex_digits
        set lower to position of item (2 * k) of low in hash_hex_digits
        if high is 0 or lower is 0
            fail with "'" + digits + "' isn't hex: its digits are 0 to 9 and a to f"
        end
        set byte k of made to (high - 1) * 16 + lower - 1
    end
    return made
end

# the whole part of a number from 0 up
to hash_whole with x
    return number of item 1 of split ("" + x) by "."
end
