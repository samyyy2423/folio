# learn.folio's tests, on the processor, which folio.test.js runs on every engine; machine.test.js runs them in
# machine code too, and checks the card against them where there's one

use "learn.folio" as learn

to test_matrices
    learn's use_card(no)
    set m to learn's matrix(list of (list of 1, 2, 3), (list of 4, 5, 6))
    expect learn's shape_of(m) is list of 2, 3
    expect learn's rows_of(m) is list of (list of 1, 2, 3), (list of 4, 5, 6)
    expect learn's numbers_of(learn's zeros(2, 2)) is list of 0, 0, 0, 0
    expect learn's value(learn's sum(m)) is 21
    expect learn's value(learn's mean(m)) is 3.5
    set t to learn's matmul(m, learn's matrix_of((list of 1, 0, 0, 1, 1, 1), 3, 2))
    expect learn's rows_of(t) is list of (list of 4, 5), (list of 10, 11)
    expect learn's rows_of(learn's add_row(m, learn's matrix(list of (list of 10, 20, 30)))) is list of (list of 11, 22, 33), (list of 14, 25, 36)
    expect learn's numbers_of(learn's relu(learn's matrix_of((list of -1, 2), 1, 2))) is list of 0, 2
    expect learn's numbers_of(learn's times(m, 2)) is list of 2, 4, 6, 8, 10, 12
    set chances to learn's numbers_of(learn's softmax_of(learn's matrix_of((list of 0, 0), 1, 2)))
    expect chances is list of 0.5, 0.5
    expect learn's accuracy(learn's matrix(list of (list of 1, 9), (list of 8, 2), (list of 0, 3)), (list of 1, 0, 0)) is 2 / 3
    set r to learn's random_normal(100, 10, 2)
    set spread to learn's value(learn's mean(learn's times(r, r)))
    expect spread is greater than 3 and spread is less than 5
    expect "{m}" is "(a 2 by 3 matrix)"
end

# each parameter's gradient against the slope of the loss as the parameter's numbers move a little either way
to check_gradients with make_loss, names, starts
    set params to empty list
    for each s in starts
        add learn's parameter(learn's matrix(s)) to params
    end
    learn's backward(make_loss(params))
    set worked to empty list
    for each p in params
        add learn's numbers_of(learn's gradient_of(p)) to worked
    end
    learn's forget()
    set h to 0.00001
    for each k from 1 to length of starts
        set numbers to learn's numbers_of(learn's matrix(item k of starts))
        for each j from 1 to length of numbers
            set up to learn_value_with(make_loss, starts, k, j, h)
            set down to learn_value_with(make_loss, starts, k, j, -h)
            set slope to (up - down) / (2 * h)
            set got to item j of item k of worked
            set off to got - slope
            if off is less than 0
                set off to -off
            end
            expect off is less than 0.0001 + 0.0001 * (slope * slope)
            if off is at least 0.0001 + 0.0001 * (slope * slope)
                say item k of names + " " + j + ": backward " + got + ", the slope " + slope
            end
        end
    end
end

to learn_value_with with make_loss, starts, k, j, h
    set params to empty list
    set i to 0
    for each s in starts
        add 1 to i
        set m to learn's matrix(s)
        if i is k
            set numbers to learn's numbers_of(m)
            set item j of numbers to item j of numbers + h
            set m to learn's matrix_of(numbers, length of s, length of item 1 of s)
        end
        add learn's parameter(m) to params
    end
    set got to learn's value(make_loss(params))
    learn's forget()
    return got
end

set x_data to list of (list of 0.5, -1.2), (list of 1.5, 0.3), (list of -0.7, 0.9)

to loss_matmul with ps
    return learn's sum(learn's times(learn's matmul(item 1 of ps, item 2 of ps), 0.5))
end

to loss_layer with ps
    set x to learn's matrix(x_data)
    return learn's mean(learn's relu(learn's add_row(learn's matmul(x, item 1 of ps), item 2 of ps)))
end

to loss_entropy with ps
    set x to learn's matrix(x_data)
    return learn's cross_entropy(learn's add_row(learn's matmul(x, item 1 of ps), item 2 of ps), list of 2, 0, 1)
end

to loss_squares with ps
    set target to learn's matrix(list of (list of 1, 2), (list of 3, 4))
    set both to learn's plus(learn's times(item 1 of ps, item 2 of ps), learn's minus(item 1 of ps, item 2 of ps))
    return learn's mean_squared_error(both, target)
end

to test_gradients
    learn's use_card(no)
    check_gradients(loss_matmul, (list of "a", "b"), list of (list of (list of 1, 2, -1), (list of 0.5, 3, 2)), (list of (list of 1, -2), (list of 0.3, 4), (list of 2, 1)))
    check_gradients(loss_layer, (list of "weights", "bias"), list of (list of (list of 1, 2, -1), (list of 0.5, 3, 2)), (list of (list of 0.15, 0.2, 0.3)))
    check_gradients(loss_entropy, (list of "weights", "bias"), list of (list of (list of 1, 2, -1), (list of 0.5, 3, 2)), (list of (list of 0.1, -0.2, 0.3)))
    check_gradients(loss_squares, (list of "a", "b"), list of (list of (list of 1, 2), (list of -1, 0.5)), (list of (list of 0.3, -2), (list of 4, 1)))
end

to loss_embedding with ps
    set target to learn's matrix(list of (list of 1, 0, 2), (list of 0.5, 1, -1), (list of 2, 2, 0), (list of 1, 0, 2))
    return learn's mean_squared_error(learn's embedding(item 1 of ps, list of 2, 0, 2, 1), target)
end

to loss_gelu with ps
    set w to learn's matrix(list of (list of 1, -2, 0.5), (list of 3, 1, -1))
    return learn's sum(learn's times(learn's gelu(item 1 of ps), w))
end

to loss_layer_norm with ps
    set w to learn's matrix(list of (list of 1, -2, 0.5, 2), (list of 3, 1, -1, 0.25), (list of -1, 1, 2, 1))
    return learn's sum(learn's times(learn's layer_norm(item 1 of ps, item 2 of ps, item 3 of ps), w))
end

to loss_attention with ps
    set w to learn's matrix(list of (list of 1, -2, 0.5, 2), (list of 3, 1, -1, 0.25), (list of -1, 1, 2, 1),
        (list of 0.5, 0.5, -2, 1), (list of 2, -1, 1, 1), (list of -0.5, 1.5, 1, -1))
    return learn's sum(learn's times(learn's attention(item 1 of ps, item 2 of ps, item 3 of ps, 2, 3, 2), w))
end

to test_transformer_gradients
    learn's use_card(no)
    check_gradients(loss_embedding, (list of "table"), list of (list of (list of 0.1, 0.2, 0.3), (list of -1, 0.5, 2), (list of 1, 1, 1)))
    check_gradients(loss_gelu, (list of "x"), list of (list of (list of 0.3, -1.2, 2), (list of 0.01, 1, -0.4)))
    check_gradients(loss_layer_norm, (list of "x", "gamma", "beta"), list of (list of (list of 1, 2, 4, -1), (list of 0.5, -0.5, 3, 2), (list of 2, 0, 1, 1.5)),
        (list of (list of 1, 0.5, 2, 1)), (list of (list of 0, 0.1, -0.2, 0.3)))
    set qkv to list of (list of 0.1, 0.4, -0.3, 0.2), (list of 0.5, -0.1, 0.2, 0.3), (list of -0.2, 0.3, 0.4, -0.5),
        (list of 0.3, 0.2, -0.1, 0.6), (list of -0.4, 0.1, 0.5, 0.2), (list of 0.2, -0.3, 0.1, 0.4)
    check_gradients(loss_attention, (list of "q", "k", "v"), list of qkv, qkv, qkv)
    # each place sees only the places up to it: the first place's output is the first v's own, in each batch
    set q to learn's matrix(qkv)
    set out to learn's rows_of(learn's attention(q, q, q, 2, 3, 2))
    expect item 1 of out is item 1 of qkv
    expect item 4 of out is item 4 of qkv
end

# a network's parameters saved to a safetensors file and put back, and a file's header as the format has it
to test_saving
    learn's use_card(no)
    set net to learn's network(list of 3, 4, 2)
    set named to learn's named_parameters(net)
    expect keys of named is list of "1.weights", "1.bias", "2.weights", "2.bias"
    set w to item "1.weights" of named
    set kept to learn's numbers_of(w)
    learn's save(named, "weights.safetensors")
    set back to learn's load("weights.safetensors")
    expect keys of back is keys of named
    expect learn's shape_of(item "1.weights" of back) is list of 3, 4
    expect learn's shape_of(item "2.bias" of back) is list of 1, 2
    set got to learn's numbers_of(item "1.weights" of back)
    for each i from 1 to length of kept
        set off to item i of got - item i of kept
        if off is less than 0
            set off to -off
        end
        expect off is less than 0.000001
    end
    set other to learn's network(list of 3, 4, 2)
    learn's load_into(learn's named_parameters(other), "weights.safetensors")
    expect learn's numbers_of(item "1.weights" of learn's named_parameters(other)) is got
    set raw to read bytes "weights.safetensors"
    set n to byte 1 of raw + 256 * byte 2 of raw
    expect ((n / 8) rounded down) * 8 is n
    set first to "\{\"1.weights\":\{\"dtype\":\"F32\",\"shape\":[3,4],\"data_offsets\":[0,48]}"
    expect ((items 9 to (8 + length of first) of raw) as text) is first
end

# a network learns XOR, which no straight line can
to test_training
    learn's use_card(no)
    set x to learn's matrix(list of (list of 0, 0), (list of 0, 1), (list of 1, 0), (list of 1, 1))
    set labels to list of 0, 1, 1, 0
    set net to learn's network(list of 2, 16, 2)
    set opt to learn's adam(learn's parameters_of(net), 0.05)
    set first to nothing
    set last to nothing
    for each round from 1 to 150
        set loss to learn's cross_entropy(learn's forward(net, x), labels)
        learn's backward(loss)
        set last to learn's value(loss)
        if first is nothing
            set first to last
        end
        learn's step(opt)
    end
    expect last is less than first / 10
    expect learn's accuracy(learn's forward(net, x), labels) is 1
    learn's forget()
end

to test_optimizers
    learn's use_card(no)
    set p to learn's parameter(learn's matrix(list of (list of 1, 2)))
    set opt to learn's sgd((list of p), 0.1)
    learn's backward(learn's sum(learn's times(p, 3)))
    expect learn's numbers_of(learn's gradient_of(p)) is list of 3, 3
    learn's step(opt)
    expect learn's numbers_of(p) is list of 0.7, 1.7
    # Adam's first step is the rate, against the gradient's sign, whatever its size
    set q to learn's parameter(learn's matrix(list of (list of 1, 2)))
    set opt to learn's adam((list of q), 0.1)
    learn's backward(learn's sum(learn's times(q, -50)))
    learn's step(opt)
    set moved to learn's numbers_of(q)
    expect item 1 of moved - 1.1 is less than 0.000001 and 1.1 - item 1 of moved is less than 0.000001
    expect item 2 of moved - 2.1 is less than 0.000001 and 2.1 - item 2 of moved is less than 0.000001
end

# within a millionth, a number or each of a list
to near with got, wanted
    if is_a_list(got)
        if length of got is not length of wanted
            return no
        end
        for each k from 1 to length of got
            if not near(item k of got, item k of wanted)
                return no
            end
        end
        return yes
    end
    return got - wanted is less than 0.000001 and wanted - got is less than 0.000001
end

to is_a_list with v
    try
        set n to length of v
    if it fails
        return no
    end
    return yes
end

# AdamW's decay, clipping, the cosine rate and dropout (DESIGN §170)
to test_training_tools
    learn's use_card(no)
    # AdamW: a weight of two rows made smaller, times 1 - rate decay, then Adam's step; a bias, one row, not
    set w to learn's parameter(learn's matrix(list of (list of 2), (list of -4)))
    set b to learn's parameter(learn's matrix(list of (list of 2)))
    set opt to learn's adamw((list of w, b), 0.1, 0.5)
    learn's backward(learn's plus(learn's sum(learn's times(w, -50)), learn's sum(learn's times(b, -50))))
    learn's step(opt)
    expect near(learn's numbers_of(w), list of 2, -3.7)
    expect near(learn's numbers_of(b), list of 2.1)
    # clipping: gradients 3 and 4, 5 together, made 1 together
    set p to learn's parameter(learn's matrix(list of (list of 1, 2)))
    set opt to learn's sgd((list of p), 1)
    learn's clip_gradients(opt, 1)
    learn's backward(learn's sum(learn's times(p, learn's matrix(list of (list of 3, 4)))))
    expect near(learn's gradient_norm(opt), 5)
    learn's step(opt)
    expect near(learn's numbers_of(p), list of 0.4, 1.2)
    learn's clip_gradients(opt, 10) # not too big: as it was
    learn's backward(learn's sum(learn's times(p, learn's matrix(list of (list of 3, 4)))))
    learn's step(opt)
    expect near(learn's numbers_of(p), list of -2.6, -2.8)
    # the rate: up over the warmup, then down along half a cosine
    expect learn's cosine_rate(5, 100, 10, 1, 0.1) is 0.5
    expect learn's cosine_rate(10, 100, 10, 1, 0.1) is 1
    expect near(learn's cosine_rate(55, 100, 10, 1, 0.1), 0.55)
    expect learn's cosine_rate(100, 100, 10, 1, 0.1) is 0.1
    expect learn's cosine_rate(500, 100, 10, 1, 0.1) is 0.1
    # dropout: about a quarter 0, the rest 4/3, and the gradient through the same ones
    set ones to empty list
    for each k from 1 to 1000
        add 1 to ones
    end
    set x to learn's parameter(learn's matrix_of(ones, 1, 1000))
    set d to learn's dropout(x, 0.25)
    set ds to learn's numbers_of(d)
    set dropped to 0
    set others to yes
    for each y in ds
        if y is 0
            add 1 to dropped
        else if not near(y, 4 / 3)
            set others to no
        end
    end
    expect others
    expect dropped is greater than 180 and dropped is less than 320
    learn's backward(learn's sum(d))
    expect learn's numbers_of(learn's gradient_of(x)) is ds
    learn's forget()
    learn's training(no)
    expect learn's numbers_of(learn's dropout(x, 0.5)) is ones
    learn's training(yes)
    try
        learn's dropout(x, 1)
        expect "a chance of 1" is "a mistake"
    if it fails with why
        expect why is "'dropout' needs a chance from 0 up to 1, not 1 itself, not 1"
    end
    try
        learn's adamw((list of x), 0.1, -1)
        expect "a decay less than 0" is "a mistake"
    if it fails with why
        expect why is "'adamw' needs a decay of 0 or more, not -1"
    end
    try
        learn's clip_gradients(learn's sgd((list of x), 0.1), 0)
        expect "clipping to 0" is "a mistake"
    if it fails with why
        expect why is "'clip_gradients' needs a number more than 0, not 0"
    end
end

to test_mistakes
    learn's use_card(no)
    set a to learn's matrix(list of (list of 1, 2))
    set b to learn's matrix(list of (list of 1, 2, 3))
    for each case in list of (list of "'matmul' needs a's columns to be b's rows: 1 by 2 and 1 by 3", "matmul"),
        (list of "'plus' needs matrices of the same shape, not 1 by 2 and 1 by 3", "plus")
        try
            if item 2 of case is "matmul"
                learn's matmul(a, b)
            else
                learn's plus(a, b)
            end
            expect item 1 of case is "no mistake"
        if it fails with why
            expect why is item 1 of case
        end
    end
    try
        learn's backward(learn's sum(a))
        expect "a loss no parameter went into" is "a mistake"
    if it fails with why
        expect why is "'backward' needs a loss that parameters went into"
    end
    set p to learn's parameter(learn's matrix(list of (list of 1, 2)))
    try
        learn's backward(learn's times(p, 2))
        expect "a loss of two numbers" is "a mistake"
    if it fails with why
        expect why is "'backward' starts from a loss, a 1 by 1 matrix, not 1 by 2"
    end
    set loss to learn's sum(learn's times(p, 2))
    learn's step(learn's sgd((list of p), 0.1))
    try
        learn's value(loss)
        expect "a matrix let go" is "a mistake"
    if it fails with why
        expect why is "'value' was given a matrix that was let go at a step, or by free"
    end
    try
        learn's cross_entropy(learn's matrix(list of (list of 1, 2)), list of 2)
        expect "a label past the end" is "a mistake"
    if it fails with why
        expect why is "'cross_entropy' needs each label to be a place from 0 to 1, not 2"
    end
end
