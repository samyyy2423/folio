# Learning, as PyTorch has it: matrices of numbers, on the graphics card when there is one (gpu.folio) and on the
# processor when there isn't (arrays.folio), each operation on them remembered, so backward() works out how a loss
# changes with every number that went into it, and optimizers that move a network's parameters against that.
#
#   use "learn.folio" as learn
#   set net to learn's network(list of 256, 64, 10)       # 256 numbers in, 64 between, 10 out
#   set opt to learn's adam(learn's parameters_of(net), 0.01)
#   set x to learn's matrix(pictures)                      # a list of rows, each a list of numbers
#   for each round from 1 to 20
#       set loss to learn's cross_entropy(learn's forward(net, x), labels)   # a place from 0 for each row
#       learn's backward(loss)
#       say learn's value(loss)                            # the number it is
#       learn's step(opt)                                  # the parameters moved; the round's matrices let go
#   end
#   say learn's accuracy(learn's forward(net, x), labels)  # how many rows it gets right, from 0 to 1
#
# Matrices: matrix(rows), matrix_of(numbers, rows, columns), zeros(rows, columns), random_normal(rows, columns,
# spread), and parameter(m), a matrix that learns. On them: matmul(a, b), plus, minus and times (each number with
# each, or times a number), add_row(m, row), a row added to each row (a layer's bias), relu, sum, mean,
# cross_entropy(scores, labels) and mean_squared_error(m, target); and for transformers, embedding(table, ids),
# gelu(m), layer_norm(m, gamma, beta) and attention(q, k, v, batch, time, heads), with a causal mask. Then backward(loss), and value(m), numbers_of(m),
# rows_of(m), shape_of(m), gradient_of(p), softmax_of(m) and accuracy(scores, labels). Layers: layer(inputs,
# outputs), network(sizes), forward(net, x) and parameters_of(net). dropout(m, chance) while training(yes), as at
# first; training(no) to use what it learned. Optimizers: sgd(parameters, rate), adam(parameters, rate) and
# adamw(parameters, rate, decay), moved on by step(opt); clip_gradients(opt, most) and gradient_norm(opt), and
# cosine_rate(s, steps, warmup, top, bottom) for opt's rate at each step, set as `set opt's rate to ...`.
# forget() lets go of every matrix worked out since the last step,
# for a program that only uses a network; free(m) lets go of one. save(named, file), load(file) and
# load_into(named, file) keep matrices in a safetensors file, as Hugging Face does, and named_parameters(net)
# names a network's.
#
# A program that uses the card is run or built with --allow-libraries; without that, or with no NVIDIA card, it
# all works on the processor, more slowly, and use_card(no) asks for that. On the card numbers are floats, about 7
# digits, as machine learning keeps them. A matrix worked out before a step is let go at the step: its value is a
# mistake after, so a loss is read with value() first.

use "gpu.folio" as learn_gpu
use "arrays.folio" as learn_arrays
use "math.folio" as learn_math
use "memory.folio" as learn_memory
use "json.folio" as learn_json

# a matrix: rows by columns numbers, row after row, on the card (data gpu.folio's numbers) or not (an array);
# learns if it's a parameter, tracks if a parameter went into it, and made_by, inputs and extra say how
kind learn_matrix with rows, columns, data, card, grad, learns, tracks, made_by, inputs, extra, gone, zeroed
    to shown with self
        if self's gone
            return "(a matrix that was let go)"
        end
        set where to ""
        if self's card
            set where to ", on the graphics card"
        end
        return "(a " + self's rows + " by " + self's columns + " matrix" + where + ")"
    end
end

set learn_wants_card to yes
set learn_card to nothing
set learn_tape to empty list
set learn_training to yes

# ---------- where the numbers are ----------

# whether matrices go on the graphics card (yes, if there's one, the first time one is made) or not
to use_card with wanted
    if learn_card is not nothing and wanted is not learn_card
        fail with "use_card comes before the first matrix: they're all on the card or all on the processor"
    end
    set learn_wants_card to wanted
end

# whether the matrices are on the graphics card
to on_card
    return learn_on_card()
end

to learn_on_card
    if learn_card is nothing
        set learn_card to learn_wants_card and learn_gpu's available()
    end
    return learn_card
end

# ---------- making matrices ----------

# a matrix of a list of rows, each a list of numbers
to matrix with rows
    if length of rows is 0
        fail with "'matrix' needs at least one row"
    end
    set columns to length of item 1 of rows
    set numbers to empty list
    for each r in rows
        if length of r is not columns
            fail with "'matrix' needs rows of the same length: " + columns + " and " + length of r
        end
        for each x in r
            add x to numbers
        end
    end
    return matrix_of(numbers, length of rows, columns)
end

# a matrix of numbers, row after row
to matrix_of with numbers, rows, columns
    if length of numbers is not rows * columns
        fail with "'matrix_of' needs " + rows + " by " + columns + " numbers, not " + length of numbers
    end
    if learn_on_card()
        return learn_made(learn_gpu's upload(numbers), rows, columns)
    end
    return learn_made(learn_arrays's shaped(numbers, (list of rows, columns)), rows, columns)
end

# a matrix of zeros
to zeros with rows, columns
    if learn_on_card()
        return learn_made(learn_gpu's zeros(rows * columns), rows, columns)
    end
    return learn_made(learn_arrays's zeros(list of rows, columns), rows, columns)
end

# a matrix of numbers from a normal curve, spread its standard deviation
to random_normal with rows, columns, spread
    set numbers to empty list
    repeat while length of numbers is less than rows * columns
        set u to learn_math's random()
        set w to learn_math's random()
        if u is greater than 0
            set r to learn_math's sqrt(-2 * learn_math's ln(u)) * spread
            add r * learn_math's cosine(2 * learn_math's pi * w) to numbers
            if length of numbers is less than rows * columns
                add r * learn_math's sine(2 * learn_math's pi * w) to numbers
            end
        end
    end
    return matrix_of(numbers, rows, columns)
end

# m, now a parameter: a matrix that learns, which backward() works out a gradient for
to parameter with m
    learn_live(m, "parameter")
    set m's learns to yes
    set m's tracks to yes
    return m
end

to learn_made with data, rows, columns
    return learn_matrix(rows, columns, data, learn_on_card(), nothing, no, no, nothing, empty list, nothing, no, no)
end

# ---------- operations ----------

# the matrix product: a is rows by inner, b inner by columns
to matmul with a, b
    learn_two(a, b, "matmul")
    if a's columns is not b's rows
        fail with "'matmul' needs a's columns to be b's rows: " + a's rows + " by " + a's columns + " and " + b's rows + " by " + b's columns
    end
    if a's card
        set data to learn_gpu's matmul(a's data, b's data, a's rows, a's columns, b's columns)
    else
        set data to learn_arrays's matmul(a's data, b's data)
    end
    return learn_result(data, a's rows, b's columns, "matmul", (list of a, b), nothing)
end

# each number plus the other's at its place
to plus with a, b
    learn_same(a, b, "plus")
    if a's card
        set data to learn_gpu's plus(a's data, b's data)
    else
        set data to learn_arrays's plus(a's data, b's data)
    end
    return learn_result(data, a's rows, a's columns, "plus", (list of a, b), nothing)
end

# each number minus the other's at its place
to minus with a, b
    learn_same(a, b, "minus")
    if a's card
        set data to learn_gpu's minus(a's data, b's data)
    else
        set data to learn_arrays's minus(a's data, b's data)
    end
    return learn_result(data, a's rows, a's columns, "minus", (list of a, b), nothing)
end

# each number times the other's at its place, or times a number
to times with a, b
    if learn_is_number(b)
        learn_live(a, "times")
        if a's card
            set data to learn_gpu's times(a's data, b)
        else
            set data to learn_arrays's times(a's data, b)
        end
        return learn_result(data, a's rows, a's columns, "scale", (list of a), b)
    end
    learn_same(a, b, "times")
    if a's card
        set data to learn_gpu's times(a's data, b's data)
    else
        set data to learn_arrays's times(a's data, b's data)
    end
    return learn_result(data, a's rows, a's columns, "times", (list of a, b), nothing)
end

# a row of numbers, 1 by m's columns, added to each of m's rows: a layer's bias
to add_row with m, r
    learn_two(m, r, "add_row")
    if r's rows is not 1 or r's columns is not m's columns
        fail with "'add_row' needs a row of " + m's columns + " numbers, 1 by " + m's columns + ", not " + r's rows + " by " + r's columns
    end
    if m's card
        set data to learn_gpu's add_rows(m's data, r's data, m's rows, m's columns)
    else
        set data to learn_arrays's plus(m's data, r's data)
    end
    return learn_result(data, m's rows, m's columns, "add_row", (list of m, r), nothing)
end

# each number, or 0 if it's less than 0
to relu with m
    learn_live(m, "relu")
    if m's card
        set data to learn_gpu's relu(m's data)
    else
        set data to learn_arrays's relu(m's data)
    end
    return learn_result(data, m's rows, m's columns, "relu", (list of m), nothing)
end

# all its numbers added up, a 1 by 1 matrix
to sum with m
    learn_live(m, "sum")
    return learn_result(learn_scalar(learn_total(m), m's card), 1, 1, "sum", (list of m), nothing)
end

# the average of its numbers, a 1 by 1 matrix
to mean with m
    learn_live(m, "mean")
    if m's rows * m's columns is 0
        fail with "'mean' needs a matrix with numbers in it"
    end
    return learn_result(learn_scalar(learn_total(m) / (m's rows * m's columns), m's card), 1, 1, "mean", (list of m), nothing)
end

# how far each row's softmax is from its label, a place from 0 for each row, on average: a 1 by 1 matrix
to cross_entropy with scores, labels
    learn_live(scores, "cross_entropy")
    if length of labels is not scores's rows
        fail with "'cross_entropy' needs a label for each of the " + scores's rows + " rows, not " + length of labels
    end
    for each label in labels
        if not learn_is_number(label) or label is less than 0 or label is at least scores's columns or label is not label rounded down
            fail with "'cross_entropy' needs each label to be a place from 0 to " + (scores's columns - 1) + ", not " + label
        end
    end
    if scores's card
        set placed to learn_gpu's upload(labels)
        set worked to learn_gpu's cross_entropy(scores's data, placed, scores's rows, scores's columns)
        learn_gpu's free(placed)
        return learn_result(learn_scalar(worked's loss, yes), 1, 1, "cross_entropy", (list of scores), worked's gradient)
    end
    # each row's softmax, from its largest, its loss and its gradient: the softmax less 1 at the label, over n
    set n to scores's rows
    set c to scores's columns
    set xs to scores's data
    set top to learn_arrays's reshape(learn_arrays's max(xs, 2), (list of n, 1))
    set exps to learn_arrays's exp(learn_arrays's minus(xs, top))
    set totals to learn_arrays's reshape(learn_arrays's sum(exps, 2), (list of n, 1))
    set gradient to learn_arrays's divided_by(exps, totals)
    set tops to top's data
    set sums to totals's data
    set numbers to xs's data
    set gs to gradient's data
    set loss to 0
    for each i from 1 to n
        set at to (i - 1) * c + item i of labels + 1
        set loss to loss + item i of tops + learn_math's ln(item i of sums) - item at of numbers
        set item at of gs to item at of gs - 1
    end
    return learn_result(learn_scalar(loss / n, no), 1, 1, "cross_entropy", (list of scores), learn_arrays's divided_by(gradient, n))
end

# the average of the squares of how far m is from target, a matrix of the same shape: a 1 by 1 matrix
to mean_squared_error with m, target
    learn_same(m, target, "mean_squared_error")
    set off to minus(m, target)
    return mean(times(off, off))
end

# ---------- for transformers (DESIGN §167) ----------

# rows of a table (a parameter, its rows the things looked up), by their places from 0 in ids: an embedding, a
# row for each id
to embedding with table, ids
    learn_live(table, "embedding")
    if not learn_is_list(ids)
        fail with "'embedding' needs a list of places from 0, not " + ids
    end
    for each id in ids
        if not learn_is_number(id) or id is less than 0 or id is at least table's rows or id is not id rounded down
            fail with "'embedding' needs each id to be a place from 0 to " + (table's rows - 1) + ", not " + id
        end
    end
    set n to length of ids
    set c to table's columns
    if table's card
        set placed to learn_gpu's upload(ids)
        return learn_result(learn_gpu's gather_rows(table's data, placed, table's rows, c), n, c, "embedding", (list of table), placed)
    end
    set numbers to learn_arrays's numbers_of(table's data)
    set made to empty list
    for each id in ids
        for each j from 1 to c
            add item (id * c + j) of numbers to made
        end
    end
    return learn_result(learn_arrays's shaped(made, (list of n, c)), n, c, "embedding", (list of table), ids)
end

# GELU of each number, as GPT-2 has it: x / 2 (1 + tanh(sqrt(2 / pi) (x + 0.044715 x^3)))
to gelu with m
    learn_live(m, "gelu")
    if m's card
        set data to learn_gpu's gelu(m's data)
    else
        set data to learn_arrays's apply(m's data, learn_gelu_of)
    end
    return learn_result(data, m's rows, m's columns, "gelu", (list of m), nothing)
end

# each row normalized, its mean 0 and its spread 1, then times gamma plus beta, each a row of m's columns
# (parameters, gamma 1s and beta 0s at first)
to layer_norm with m, gamma, beta
    learn_live(m, "layer_norm")
    learn_two(m, gamma, "layer_norm")
    learn_two(m, beta, "layer_norm")
    if gamma's rows is not 1 or gamma's columns is not m's columns or beta's rows is not 1 or beta's columns is not m's columns
        fail with "'layer_norm' needs gamma and beta to be rows of " + m's columns + " numbers"
    end
    set rows to m's rows
    set c to m's columns
    if m's card
        set worked to learn_gpu's layer_norm(m's data, gamma's data, beta's data, rows, c)
        return learn_result(worked's out, rows, c, "layer_norm", (list of m, gamma, beta), list of worked's xhat, worked's rstd)
    end
    set xs to learn_arrays's numbers_of(m's data)
    set gs to learn_arrays's numbers_of(gamma's data)
    set bs to learn_arrays's numbers_of(beta's data)
    set out to empty list
    set xhat to empty list
    set rstd to empty list
    for each i from 1 to rows
        set total to 0
        for each j from 1 to c
            set total to total + item ((i - 1) * c + j) of xs
        end
        set mean to total / c
        set spread to 0
        for each j from 1 to c
            set d to item ((i - 1) * c + j) of xs - mean
            set spread to spread + d * d
        end
        set r to 1 / learn_math's sqrt(spread / c + 0.00001)
        add r to rstd
        for each j from 1 to c
            set h to (item ((i - 1) * c + j) of xs - mean) * r
            add h to xhat
            add h * item j of gs + item j of bs to out
        end
    end
    return learn_result(learn_arrays's shaped(out, (list of rows, c)), rows, c, "layer_norm", (list of m, gamma, beta), list of xhat, rstd)
end

# attention with a causal mask, as a GPT's: q, k and v each batch * time rows (each batch's places one after
# another) of heads * size columns, each head its own size of them; each place looks at the places up to it,
# softmax(q k^T / sqrt(size)) v
to attention with q, k, v, batch, time, heads
    learn_same(q, k, "attention")
    learn_same(q, v, "attention")
    if q's rows is not batch * time
        fail with "'attention' needs batch times time rows, " + (batch * time) + ", not " + q's rows
    end
    if q's columns is not ((q's columns / heads) rounded down) * heads
        fail with "'attention' needs its columns, " + q's columns + ", to be heads times each head's size"
    end
    set shape to list of batch, time, heads
    if q's card
        set worked to learn_gpu's attention(q's data, k's data, v's data, batch, time, heads)
        return learn_result(worked's out, q's rows, q's columns, "attention", (list of q, k, v), list of worked's probs, shape)
    end
    set c to q's columns
    set size to c / heads
    set scale to 1 / learn_math's sqrt(size)
    set qs to learn_arrays's numbers_of(q's data)
    set ks to learn_arrays's numbers_of(k's data)
    set vs to learn_arrays's numbers_of(v's data)
    set out to learn_list_of(batch * time * c)
    set probs to learn_list_of(batch * heads * time * time)
    for each b from 0 to batch - 1
        for each h from 0 to heads - 1
            for each t from 0 to time - 1
                set at_p to ((b * heads + h) * time + t) * time
                set at_q to (b * time + t) * c + h * size
                set top to nothing
                for each j from 0 to t
                    set at_k to (b * time + j) * c + h * size
                    set s to 0
                    for each d from 1 to size
                        set s to s + item (at_q + d) of qs * item (at_k + d) of ks
                    end
                    set s to s * scale
                    set item (at_p + j + 1) of probs to s
                    if top is nothing or s is greater than top
                        set top to s
                    end
                end
                set total to 0
                for each j from 0 to t
                    set e to learn_math's exp(item (at_p + j + 1) of probs - top)
                    set item (at_p + j + 1) of probs to e
                    set total to total + e
                end
                for each j from 0 to t
                    set item (at_p + j + 1) of probs to item (at_p + j + 1) of probs / total
                end
                for each d from 1 to size
                    set s to 0
                    for each j from 0 to t
                        set s to s + item (at_p + j + 1) of probs * item ((b * time + j) * c + h * size + d) of vs
                    end
                    set item (at_q + d) of out to s
                end
            end
        end
    end
    return learn_result(learn_arrays's shaped(out, (list of q's rows, c)), q's rows, c, "attention", (list of q, k, v), list of probs, shape)
end

# ---------- dropout (DESIGN §170) ----------

# whether dropout() drops numbers: yes while a network learns, as at first, and no to use what it learned
to training with on
    set learn_training to on
end

# m with each number 0 at the chance given, chosen anew each time, and the rest made larger, over 1 - chance, so
# it all adds up to about what it did: a network learns not to lean on any one number. While training(no), m
to dropout with m, chance
    learn_live(m, "dropout")
    if not learn_is_number(chance) or chance is less than 0 or chance is at least 1
        fail with "'dropout' needs a chance from 0 up to 1, not 1 itself, not " + chance
    end
    if not learn_training or chance is 0
        return m
    end
    set n to m's rows * m's columns
    if m's card
        set mask to learn_gpu's dropout_mask(n, chance, (learn_math's random() * 4294967296) rounded down)
        set data to learn_gpu's times(m's data, mask)
    else
        set scale to 1 / (1 - chance)
        set kept to empty list
        for each k from 1 to n
            if learn_math's random() is less than chance
                add 0 to kept
            else
                add scale to kept
            end
        end
        set mask to learn_arrays's shaped(kept, (list of m's rows, m's columns))
        set data to learn_arrays's times(m's data, mask)
    end
    if not m's tracks # nothing to send a gradient back to
        learn_drop(mask, m's card)
        set mask to nothing
    end
    return learn_result(data, m's rows, m's columns, "dropout", (list of m), mask)
end

# ---------- what they are ----------

# a 1 by 1 matrix's number, or a matrix's numbers row after row
to value with m
    learn_live(m, "value")
    set numbers to numbers_of(m)
    if m's rows * m's columns is 1
        return item 1 of numbers
    end
    return numbers
end

# a matrix's numbers, row after row
to numbers_of with m
    learn_live(m, "numbers_of")
    if m's card
        return learn_gpu's download(m's data)
    end
    return learn_arrays's numbers_of(m's data)
end

# a matrix's rows, each a list of numbers
to rows_of with m
    set numbers to numbers_of(m)
    set made to empty list
    for each i from 1 to m's rows
        if m's columns is 0
            add empty list to made
        else
            add items ((i - 1) * m's columns + 1) to (i * m's columns) of numbers to made
        end
    end
    return made
end

# a matrix's rows and columns
to shape_of with m
    return list of m's rows, m's columns
end

# how a loss backward() started from changes with each of a parameter's numbers, a matrix of its shape
to gradient_of with p
    learn_live(p, "gradient_of")
    if p's grad is nothing or p's zeroed
        return zeros(p's rows, p's columns)
    end
    return learn_made(learn_copy(p's grad, p's card), p's rows, p's columns)
end

# each row's softmax: chances from 0 to 1 that add up to 1
to softmax_of with m
    learn_live(m, "softmax_of")
    if m's card
        return learn_made(learn_gpu's softmax_rows(m's data, m's rows, m's columns), m's rows, m's columns)
    end
    return learn_made(learn_arrays's softmax(m's data, 2), m's rows, m's columns)
end

# how many of the rows have their largest score at their label, from 0 to 1
to accuracy with scores, labels
    learn_live(scores, "accuracy")
    if length of labels is not scores's rows
        fail with "'accuracy' needs a label for each of the " + scores's rows + " rows, not " + length of labels
    end
    if scores's rows is 0
        return 0
    end
    set picked to empty list
    if scores's card
        set placed to learn_gpu's argmax_rows(scores's data, scores's rows, scores's columns)
        set picked to learn_gpu's download(placed)
        learn_gpu's free(placed)
    else
        for each r in rows_of(scores)
            set best to 1
            for each j from 2 to length of r
                if item j of r is greater than item best of r
                    set best to j
                end
            end
            add best - 1 to picked
        end
    end
    set right to 0
    for each i from 1 to scores's rows
        if item i of picked is item i of labels
            add 1 to right
        end
    end
    return right / scores's rows
end

# ---------- backward ----------

# how loss, a 1 by 1 matrix, changes with each parameter that went into it: each one's gradient, added to what
# it had, for an optimizer's step
to backward with loss
    learn_live(loss, "backward")
    if loss's rows is not 1 or loss's columns is not 1
        fail with "'backward' starts from a loss, a 1 by 1 matrix, not " + loss's rows + " by " + loss's columns
    end
    if not loss's tracks
        fail with "'backward' needs a loss that parameters went into"
    end
    learn_add_grad(loss, learn_scalar(1, loss's card))
    set k to length of learn_tape
    repeat while k is at least 1
        set m to item k of learn_tape
        if m's grad is not nothing and not m's gone
            learn_back(m)
        end
        set k to k - 1
    end
end

# one matrix's gradient sent back to what made it
to learn_back with m
    set g to m's grad
    set how to m's made_by
    set a to item 1 of m's inputs
    if how is "matmul"
        set b to item 2 of m's inputs
        if a's tracks # g times b turned over
            if m's card
                learn_add_grad_mm(a, g, b's data, m's rows, m's columns, b's rows, no, yes)
            else
                set turned to learn_t(b)
                learn_add_grad(a, learn_mm(g, turned, m's rows, m's columns, b's rows, m's card))
            end
        end
        if b's tracks # a turned over times g
            if m's card
                learn_add_grad_mm(b, a's data, g, a's columns, a's rows, m's columns, yes, no)
            else
                learn_add_grad(b, learn_arrays's matmul_turned(a's data, g))
            end
        end
    else if how is "plus" or how is "minus"
        set b to item 2 of m's inputs
        if a's tracks
            learn_add_grad(a, learn_copy(g, m's card))
        end
        if b's tracks
            if how is "plus"
                learn_add_grad(b, learn_copy(g, m's card))
            else
                learn_add_grad(b, learn_scaled(g, -1, m's card))
            end
        end
    else if how is "times"
        set b to item 2 of m's inputs
        if a's tracks
            learn_add_grad(a, learn_each_times(g, b's data, m's card))
        end
        if b's tracks
            learn_add_grad(b, learn_each_times(g, a's data, m's card))
        end
    else if how is "scale"
        if a's tracks
            learn_add_grad(a, learn_scaled(g, m's extra, m's card))
        end
    else if how is "add_row"
        set b to item 2 of m's inputs
        if a's tracks
            learn_add_grad(a, learn_copy(g, m's card))
        end
        if b's tracks
            if m's card
                learn_add_grad_columns(b, g, m's rows, m's columns)
            else
                learn_add_grad(b, learn_arrays's reshape(learn_arrays's sum(g, 1), (list of 1, m's columns)))
            end
        end
    else if how is "relu"
        if a's tracks
            if m's card
                learn_add_grad(a, learn_gpu's relu_gradient(g, a's data))
            else
                learn_add_grad(a, learn_arrays's relu_gradient(g, a's data))
            end
        end
    else if how is "sum" or how is "mean"
        if a's tracks
            set each to learn_scalar_of(g, m's card)
            if how is "mean"
                set each to each / (a's rows * a's columns)
            end
            if m's card
                learn_add_grad(a, learn_gpu's filled(a's rows * a's columns, each))
            else
                learn_add_grad(a, learn_arrays's filled((list of a's rows, a's columns), each))
            end
        end
    else if how is "embedding"
        if a's tracks
            if m's card and a's grad is not nothing # added where it is, kept zeros or what it has
                learn_gpu's scatter_add_rows(a's grad, g, m's extra, a's columns)
                set a's zeroed to no
            else if m's card
                set g_table to learn_gpu's zeros(a's rows * a's columns)
                learn_gpu's scatter_add_rows(g_table, g, m's extra, a's columns)
                learn_add_grad(a, g_table)
            else
                set sums to learn_list_of(a's rows * a's columns)
                set gs to learn_arrays's numbers_of(g)
                set c to a's columns
                set i to 0
                for each id in m's extra
                    for each j from 1 to c
                        set item (id * c + j) of sums to item (id * c + j) of sums + item (i * c + j) of gs
                    end
                    add 1 to i
                end
                learn_add_grad(a, learn_arrays's shaped(sums, (list of a's rows, c)))
            end
        end
    else if how is "gelu"
        if a's tracks
            if m's card
                learn_add_grad(a, learn_gpu's gelu_gradient(g, a's data))
            else
                learn_add_grad(a, learn_arrays's times(g, learn_arrays's apply(a's data, learn_gelu_slope)))
            end
        end
    else if how is "dropout"
        if a's tracks
            learn_add_grad(a, learn_each_times(g, m's extra, m's card))
        end
    else if how is "layer_norm"
        learn_back_layer_norm(m, g)
    else if how is "attention"
        learn_back_attention(m, g)
    else if how is "cross_entropy"
        if a's tracks
            learn_add_grad(a, learn_scaled(m's extra, learn_scalar_of(g, m's card), m's card))
        end
    end
end

to learn_gelu_of with x
    set u to 0.7978845608028654 * (x + 0.044715 * x * x * x)
    return 0.5 * x * (1 + learn_tanh(u))
end

to learn_gelu_slope with x
    set t to learn_tanh(0.7978845608028654 * (x + 0.044715 * x * x * x))
    return 0.5 * (1 + t) + 0.5 * x * (1 - t * t) * 0.7978845608028654 * (1 + 3 * 0.044715 * x * x)
end

to learn_tanh with u
    if u is greater than 20
        return 1
    end
    if u is less than -20
        return -1
    end
    set e to learn_math's exp(2 * u)
    return (e - 1) / (e + 1)
end

# n zeros, a list of its own
to learn_list_of with n
    set made to empty list
    for each i from 1 to n
        add 0 to made
    end
    return made
end

to learn_is_list with v
    try
        set probe to items 1 to 0 of v
        return not learn_is_number(v)
    if it fails
        return no
    end
end

# layer norm's gradients: x's, rstd (g - mean(g) - xhat mean(g xhat)) with g = dy gamma; gamma's, the column
# sums of dy xhat; beta's, the column sums of dy
to learn_back_layer_norm with m, g
    set x to item 1 of m's inputs
    set gamma to item 2 of m's inputs
    set beta to item 3 of m's inputs
    set rows to m's rows
    set c to m's columns
    set xhat to item 1 of m's extra
    set rstd to item 2 of m's extra
    if m's card
        if x's tracks
            learn_add_grad(x, learn_gpu's layer_norm_gradient(g, xhat, rstd, gamma's data, rows, c))
        end
        if gamma's tracks
            set both to learn_gpu's times(g, xhat)
            learn_add_grad_columns(gamma, both, rows, c)
            learn_gpu's free(both)
        end
        if beta's tracks
            learn_add_grad_columns(beta, g, rows, c)
        end
        return nothing
    end
    set dys to learn_arrays's numbers_of(g)
    set gs to learn_arrays's numbers_of(gamma's data)
    set dx to empty list
    set dgamma to learn_list_of(c)
    set dbeta to learn_list_of(c)
    for each i from 1 to rows
        set s1 to 0
        set s2 to 0
        for each j from 1 to c
            set at to (i - 1) * c + j
            set gj to item at of dys * item j of gs
            set s1 to s1 + gj
            set s2 to s2 + gj * item at of xhat
            set item j of dgamma to item j of dgamma + item at of dys * item at of xhat
            set item j of dbeta to item j of dbeta + item at of dys
        end
        for each j from 1 to c
            set at to (i - 1) * c + j
            set gj to item at of dys * item j of gs
            add item i of rstd * (gj - s1 / c - item at of xhat * s2 / c) to dx
        end
    end
    if x's tracks
        learn_add_grad(x, learn_arrays's shaped(dx, (list of rows, c)))
    end
    if gamma's tracks
        learn_add_grad(gamma, learn_arrays's shaped(dgamma, (list of 1, c)))
    end
    if beta's tracks
        learn_add_grad(beta, learn_arrays's shaped(dbeta, (list of 1, c)))
    end
end

# attention's gradients: dp_j = dout_t . v_j; dv_j += p_j dout_t; ds_j = p_j (dp_j - sum of p_i dp_i);
# dq_t = scale sum of ds_j k_j; dk_j += scale ds_j q_t
to learn_back_attention with m, g
    set q to item 1 of m's inputs
    set k to item 2 of m's inputs
    set v to item 3 of m's inputs
    set shape to item 2 of m's extra
    set batch to item 1 of shape
    set time to item 2 of shape
    set heads to item 3 of shape
    if m's card
        set worked to learn_gpu's attention_gradient(g, item 1 of m's extra, q's data, k's data, v's data, batch, time, heads)
        for each pair in list of (list of q, worked's dq), (list of k, worked's dk), (list of v, worked's dv)
            if (item 1 of pair)'s tracks
                learn_add_grad(item 1 of pair, item 2 of pair)
            else
                learn_gpu's free(item 2 of pair)
            end
        end
        return nothing
    end
    set probs to item 1 of m's extra
    set c to q's columns
    set size to c / heads
    set scale to 1 / learn_math's sqrt(size)
    set qs to learn_arrays's numbers_of(q's data)
    set ks to learn_arrays's numbers_of(k's data)
    set vs to learn_arrays's numbers_of(v's data)
    set dout to learn_arrays's numbers_of(g)
    set dq to learn_list_of(batch * time * c)
    set dk to learn_list_of(batch * time * c)
    set dv to learn_list_of(batch * time * c)
    for each b from 0 to batch - 1
        for each h from 0 to heads - 1
            for each t from 0 to time - 1
                set at_p to ((b * heads + h) * time + t) * time
                set at_t to (b * time + t) * c + h * size
                set dp to empty list
                set weighted to 0
                for each j from 0 to t
                    set at_j to (b * time + j) * c + h * size
                    set s to 0
                    for each d from 1 to size
                        set s to s + item (at_t + d) of dout * item (at_j + d) of vs
                        set item (at_j + d) of dv to item (at_j + d) of dv + item (at_p + j + 1) of probs * item (at_t + d) of dout
                    end
                    add s to dp
                    set weighted to weighted + item (at_p + j + 1) of probs * s
                end
                for each j from 0 to t
                    set at_j to (b * time + j) * c + h * size
                    set ds to item (at_p + j + 1) of probs * (item (j + 1) of dp - weighted) * scale
                    for each d from 1 to size
                        set item (at_t + d) of dq to item (at_t + d) of dq + ds * item (at_j + d) of ks
                        set item (at_j + d) of dk to item (at_j + d) of dk + ds * item (at_t + d) of qs
                    end
                end
            end
        end
    end
    for each pair in list of (list of q, dq), (list of k, dk), (list of v, dv)
        if (item 1 of pair)'s tracks
            learn_add_grad(item 1 of pair, learn_arrays's shaped(item 2 of pair, (list of q's rows, c)))
        end
    end
end

# a gradient added to a matrix's: the first is its own, the rest added in place on the card
to learn_add_grad with m, g
    if m's grad is not nothing and m's zeroed # a parameter's zeros, kept from the last step, aren't needed
        learn_gpu's free(m's grad)
        set m's grad to nothing
        set m's zeroed to no
    end
    if m's grad is nothing
        set m's grad to g
    else if m's card
        learn_gpu's add_scaled(m's grad, g, 1)
        learn_gpu's free(g)
    else
        set m's grad to learn_arrays's plus(m's grad, g)
    end
end

# a gradient worked out on the card by a matmul with one side turned over, added to m's in the same launch
to learn_add_grad_mm with m, a, b, rows, inner, columns, a_turned, b_turned
    set m's grad to learn_gpu's matmul_turned(a, b, rows, inner, columns, a_turned, b_turned, m's grad)
    set m's zeroed to no
end

# a, rows by columns, its column sums added to m's gradient on the card, a row: kept zeros or what it has
to learn_add_grad_columns with m, a, rows, columns
    if m's grad is nothing
        set m's grad to learn_gpu's column_sums(a, rows, columns)
    else
        learn_gpu's column_sums_into(m's grad, a, rows, columns)
    end
    set m's zeroed to no
end

to learn_mm with a, b, rows, inner, columns, card
    if card
        return learn_gpu's matmul(a, b, rows, inner, columns)
    end
    return learn_arrays's matmul(a, b)
end

to learn_t with m
    if m's card
        return learn_gpu's transpose(m's data, m's rows, m's columns)
    end
    return learn_arrays's transpose(m's data)
end

to learn_drop with data, card
    if card
        learn_gpu's free(data)
    end
end

to learn_copy with data, card
    if card
        return learn_gpu's copy_of(data)
    end
    return data
end

to learn_scaled with data, s, card
    if card
        return learn_gpu's times(data, s)
    end
    return learn_arrays's times(data, s)
end

to learn_each_times with g, other, card
    if card
        return learn_gpu's times(g, other)
    end
    return learn_arrays's times(g, other)
end

# ---------- layers ----------

# a layer: inputs numbers in, outputs out, its weights from a normal curve as He's start has them, its bias 0
to layer with inputs, outputs
    set weights to parameter(random_normal(inputs, outputs, learn_math's sqrt(2 / inputs)))
    set bias to parameter(zeros(1, outputs))
    return record with weights weights, bias bias
end

# layers of the sizes, each one's outputs the next one's inputs
to network with sizes
    if length of sizes is less than 2
        fail with "'network' needs at least two sizes: what goes in and what comes out"
    end
    set layers to empty list
    for each k from 1 to length of sizes - 1
        add layer(item k of sizes, item (k + 1) of sizes) to layers
    end
    return layers
end

# what a network makes of x, a row for each example: each layer's weights and bias, with relu between them
to forward with net, x
    set h to x
    set k to 0
    for each l in net
        add 1 to k
        set h to add_row(matmul(h, l's weights), l's bias)
        if k is less than length of net
            set h to relu(h)
        end
    end
    return h
end

# a network's parameters: each layer's weights and bias
to parameters_of with net
    set made to empty list
    for each l in net
        add l's weights to made
        add l's bias to made
    end
    return made
end

# ---------- optimizers ----------

# plain gradient descent: each parameter moved against its gradient, rate times it
to sgd with parameters, rate
    return learn_optimizer("sgd", parameters, rate, 0)
end

# Adam: each parameter moved against a running average of its gradient, over one of its square, as most
# networks are trained (b1 0.9, b2 0.999, eps 10^-8)
to adam with parameters, rate
    return learn_optimizer("adam", parameters, rate, 0)
end

# AdamW, as GPT-2 and most transformers are trained (DESIGN §170): Adam, and each parameter of more than one row,
# the weights and embeddings but not a bias or a layer norm's row, made a little smaller at each step, times
# 1 - rate times decay, apart from its gradient
to adamw with parameters, rate, decay
    if not learn_is_number(decay) or decay is less than 0
        fail with "'adamw' needs a decay of 0 or more, not " + decay
    end
    return learn_optimizer("adam", parameters, rate, decay)
end

to learn_optimizer with way, parameters, rate, decay
    set ms to empty list
    set vs to empty list
    for each p in parameters
        add nothing to ms
        add nothing to vs
    end
    return record with way way, parameters parameters, rate rate, t 0, m ms, v vs, decay decay, clip nothing, room nothing
end

# from now on, at each step, the gradients made smaller together when they're too big: when the square root of
# the sum of all their squares is more than most, each times most over it, as PyTorch's clip_grad_norm_ does,
# so one odd batch can't throw a network far
to clip_gradients with opt, most
    if not learn_is_number(most) or most is at most 0
        fail with "'clip_gradients' needs a number more than 0, not " + most
    end
    set opt's clip to most
end

# how big the parameters' gradients are now, all together: the square root of the sum of their squares, as
# clip_gradients measures them; between backward and step
to gradient_norm with opt
    set total to 0
    set on_card to empty list
    for each p in opt's parameters
        if p's grad is not nothing and not p's zeroed
            if p's card
                add p's grad to on_card
            else
                set total to total + learn_arrays's sum(learn_arrays's times(p's grad, p's grad))
            end
        end
    end
    if length of on_card is greater than 0
        set total to total + learn_gpu's sum_of_squares(on_card)
    end
    return learn_math's sqrt(total)
end

# the rate for step s (from 1) of steps, as GPT-2 and most transformers are trained: up from 0 to top over the
# first warmup steps, then down to bottom along half a cosine, and bottom after
to cosine_rate with s, steps, warmup, top, bottom
    if warmup is greater than 0 and s is at most warmup
        return top * s / warmup
    end
    if s is at least steps
        return bottom
    end
    set through to (s - warmup) / (steps - warmup)
    return bottom + (top - bottom) * 0.5 * (1 + learn_math's cosine(learn_math's pi * through))
end

# one step: each parameter moved, its gradient gone, and every matrix worked out since the last step let go
to step with opt
    set opt's t to opt's t + 1
    set scale to 1 # clipping's, worked out here unless it's on the card
    if opt's clip is not nothing and not (opt's way is "adam" and learn_on_card())
        set scale to opt's clip / (gradient_norm(opt) + 0.000001)
        if scale is greater than 1
            set scale to 1
        end
    end
    set k to 0
    set together to empty list
    for each p in opt's parameters
        add 1 to k
        if p's grad is not nothing and p's zeroed
            # no gradient since the last step
        else if p's grad is not nothing and p's card and opt's way is "adam" # on the card, all in a launch or two,
            # and its gradient left zeros, to be added to next time
            if item k of opt's m is nothing
                set item k of opt's m to learn_gpu's zeros(p's rows * p's columns)
                set item k of opt's v to learn_gpu's zeros(p's rows * p's columns)
            end
            add (list of p's data, p's grad, item k of opt's m, item k of opt's v, learn_decays(opt, p)) to together
            set p's zeroed to yes
        else if p's grad is not nothing
            if opt's way is "sgd"
                learn_sgd_one(p, opt's rate * scale)
            else
                if scale is less than 1
                    set p's grad to learn_arrays's times(p's grad, scale)
                end
                learn_adam_one(opt, k, p)
            end
            learn_free_grad(p)
        end
    end
    if length of together is greater than 0
        set keep to 1 - opt's rate * opt's decay
        if opt's clip is nothing
            learn_gpu's adam_many(together, opt's rate, 0.9, 0.999, 0.00000001, opt's t, yes, keep)
        else
            if opt's room is nothing
                set opt's room to learn_gpu's zeros(1)
            end
            learn_gpu's adam_many(together, opt's rate, 0.9, 0.999, 0.00000001, opt's t, yes, keep, opt's room, opt's clip)
        end
    end
    forget()
end

# whether AdamW makes p smaller: a parameter of more than one row, when there's a decay
to learn_decays with opt, p
    return opt's decay is greater than 0 and p's rows is greater than 1
end

to learn_sgd_one with p, rate
    if p's card
        learn_gpu's add_scaled(p's data, p's grad, -rate)
    else
        set p's data to learn_arrays's minus(p's data, learn_arrays's times(p's grad, rate))
    end
end

to learn_adam_one with opt, k, p
    set b1 to 0.9
    set b2 to 0.999
    set eps to 0.00000001
    if item k of opt's m is nothing
        if p's card
            set item k of opt's m to learn_gpu's zeros(p's rows * p's columns)
            set item k of opt's v to learn_gpu's zeros(p's rows * p's columns)
        else
            set item k of opt's m to learn_arrays's zeros(list of p's rows, p's columns)
            set item k of opt's v to learn_arrays's zeros(list of p's rows, p's columns)
        end
    end
    if p's card
        learn_gpu's adam_step(p's data, p's grad, item k of opt's m, item k of opt's v, opt's rate, b1, b2, eps, opt's t)
        return nothing
    end
    set keep to 1
    if learn_decays(opt, p)
        set keep to 1 - opt's rate * opt's decay
    end
    learn_arrays's adam_step(p's data, p's grad, item k of opt's m, item k of opt's v, opt's rate, b1, b2, eps, opt's t, keep)
end

to learn_free_grad with p
    if p's card and p's grad is not nothing
        learn_gpu's free(p's grad)
    end
    set p's grad to nothing
    set p's zeroed to no
end

# every matrix worked out since the last step let go, and its memory on the card given back
to forget
    for each m in learn_tape
        if not m's learns and not m's gone
            if m's card
                learn_gpu's free(m's data)
                learn_free_extra(m's extra)
            end
            learn_free_grad(m)
            set m's data to nothing
            set m's gone to yes
        end
    end
    set learn_tape to empty list
end

# what an operation kept on the card for its gradient, given back: numbers on the card, or a list with some
to learn_free_extra with x
    if x is nothing or learn_is_number(x)
        return nothing
    end
    if learn_is_list(x)
        for each part in x
            learn_free_extra(part)
        end
        return nothing
    end
    try
        set probe to x's count
    if it fails
        return nothing
    end
    learn_gpu's free(x)
end

# a matrix let go, and its memory on the card given back
to free with m
    learn_live(m, "free")
    if m's card
        learn_gpu's free(m's data)
    end
    learn_free_grad(m)
    set m's data to nothing
    set m's gone to yes
end

# ---------- weights in a file: safetensors, as Hugging Face keeps them (DESIGN §167) ----------

# matrices saved to a file, each by its name: a dictionary of names to matrices. The file is safetensors: 8
# bytes, the header's length; the header, JSON, each name's dtype ("F32"), shape and where its numbers are;
# then the numbers, 32-bit floats, row after row
to save with named, file
    set names to keys of named
    set header to "\{"
    set at to 0
    set k to 0
    for each name in names
        set m to item name of named
        learn_live(m, "save")
        add 1 to k
        if k is greater than 1
            add "," to header
        end
        set size to 4 * m's rows * m's columns
        add learn_json_text(name) + ":\{\"dtype\":\"F32\",\"shape\":[" + m's rows + "," + m's columns + "],\"data_offsets\":[" + at + "," + (at + size) + "]}" to header
        set at to at + size
    end
    add "}" to header
    repeat while (length of (header as bytes)) is not ((length of (header as bytes) / 8) rounded up) * 8
        add " " to header
    end
    set heading to header as bytes
    set made to (8 + length of heading + at) bytes
    learn_memory's put(made, 1, length of heading, "an unsigned long whole number")
    learn_memory's copy(heading, 1, made, 9, length of heading)
    set at to 9 + length of heading
    for each name in names
        set m to item name of named
        set numbers to numbers_of(m)
        if length of numbers is greater than 0
            learn_memory's put_many(made, at, numbers, "a float")
        end
        set at to at + 4 * length of numbers
    end
    write made to file
end

# the matrices a safetensors file holds, a dictionary of their names to them: 32-bit floats ("F32") or 64-bit
# ("F64"), of one axis (a row) or two. parameter() makes one learn again
to load with file
    set b to read bytes file
    if length of b is less than 8
        fail with "'load' needs a safetensors file, and " + file + " is too short to be one"
    end
    set n to learn_memory's get(b, 1, "an unsigned long whole number")
    if n is greater than length of b - 8
        fail with "'load' needs a safetensors file, and " + file + "'s header runs past its end"
    end
    set header to learn_json's parse((items 9 to (8 + n) of b) as text)
    set made to empty dictionary
    for each name in keys of header
        if name is not "__metadata__"
            set info to item name of header
            set kind_of to item "dtype" of info
            set shape to item "shape" of info
            set places to item "data_offsets" of info
            set width to 4
            set kind_name to "a float"
            if kind_of is "F64"
                set width to 8
                set kind_name to "a number"
            else if kind_of is not "F32"
                fail with "'load' reads F32 and F64 numbers, not " + name + "'s " + kind_of
            end
            set rows to 1
            set columns to 1
            if length of shape is 1
                set columns to item 1 of shape
            else if length of shape is 2
                set rows to item 1 of shape
                set columns to item 2 of shape
            else if length of shape is not 0
                fail with "'load' reads matrices, of one axis or two, not " + name + "'s " + length of shape
            end
            set count to (item 2 of places - item 1 of places) / width
            if count is not rows * columns
                fail with "'load' found " + count + " numbers for " + name + ", where its shape has " + (rows * columns)
            end
            set numbers to empty list
            if count is greater than 0
                set numbers to learn_memory's get_many(b, 9 + n + item 1 of places, count, kind_name)
            end
            set item name of made to matrix_of(numbers, rows, columns)
        end
    end
    return made
end

# a file's matrices put into the matrices of the same names, in place, each the same shape: a network's
# parameters back as they were saved
to load_into with named, file
    set saved to load(file)
    for each name in keys of named
        if not (name is in saved)
            fail with "'load_into' found no " + name + " in " + file
        end
        set m to item name of named
        set got to item name of saved
        if got's rows is not m's rows or got's columns is not m's columns
            fail with "'load_into' found " + name + " " + got's rows + " by " + got's columns + " in " + file + ", not " + m's rows + " by " + m's columns
        end
        if m's card
            learn_gpu's free(m's data)
        end
        set m's data to got's data
        set got's data to nothing
    end
end

# a network's parameters by name, for save and load_into: layer 1's weights "1.weights", its bias "1.bias"
to named_parameters with net
    set made to empty dictionary
    set k to 0
    for each l in net
        add 1 to k
        set item ("" + k + ".weights") of made to l's weights
        set item ("" + k + ".bias") of made to l's bias
    end
    return made
end

to learn_json_text with t
    set made to "\""
    for each c in t
        if c is "\"" or c is "\\"
            add "\\" + c to made
        else
            add c to made
        end
    end
    return made + "\""
end

# ---------- in here ----------

to learn_result with data, rows, columns, how, inputs, extra
    set tracks to no
    for each i in inputs
        if i's tracks
            set tracks to yes
        end
    end
    set made to learn_matrix(rows, columns, data, learn_card, nothing, no, tracks, how, inputs, extra, no, no)
    if tracks
        add made to learn_tape
    end
    return made
end

# a number as a 1 by 1 matrix's data
to learn_scalar with x, card
    if card
        return learn_gpu's upload(list of x)
    end
    return learn_arrays's shaped((list of x), (list of 1, 1))
end

# a 1 by 1 matrix's data's number
to learn_scalar_of with data, card
    if card
        return item 1 of learn_gpu's download(data)
    end
    return item 1 of learn_arrays's numbers_of(data)
end

to learn_total with m
    if m's card
        return learn_gpu's sum(m's data)
    end
    return learn_arrays's sum(m's data)
end

to learn_live with m, what
    if not learn_is_matrix(m)
        fail with "'" + what + "' needs a matrix, not " + m
    end
    if m's gone
        fail with "'" + what + "' was given a matrix that was let go at a step, or by free"
    end
end

to learn_two with a, b, what
    learn_live(a, what)
    learn_live(b, what)
    if a's card is not b's card
        fail with "'" + what + "' needs both matrices on the card or both on the processor"
    end
end

to learn_same with a, b, what
    learn_two(a, b, what)
    if a's rows is not b's rows or a's columns is not b's columns
        fail with "'" + what + "' needs matrices of the same shape, not " + a's rows + " by " + a's columns + " and " + b's rows + " by " + b's columns
    end
end

to learn_is_matrix with v
    try
        return kind of v is "learn_matrix"
    if it fails
        return no
    end
end

to learn_is_number with v
    try
        set probe to v - 0
        return yes
    if it fails
        return no
    end
end
