# MCP servers: tools, resources and prompts that Claude and other AI apps can use, served over the Model Context
# Protocol on a program's input and output, a JSON-RPC message a line, as such an app starts the program. A tool
# is a function the app can call with what it needs as a dictionary; a resource, text it can read by its
# address; a prompt, a message it can be given, made from what it's told.
#
#   use "mcp.folio" as mcp
#   to add_up with given
#       return item "a" of given + item "b" of given
#   end
#   set calc to mcp's server("calculator", "1.0.0")
#   set needs to dictionary where "a" is "number", "b" is "number"
#   mcp's tool(calc, "add", "Adds two numbers", needs, add_up)
#   mcp's serve(calc)
#
# Built with folio build calc.folio, the app runs calc.exe (or calc on Linux) as its own program: in Claude
# Desktop's claude_desktop_config.json, "mcpServers": {"calculator": {"command": "C:\\tools\\calc.exe"}}. What a
# tool needs is a dictionary of each input's name and what it is: "number", "whole number", "text", "yes or no",
# "list" or "dictionary", with "or nothing" after it for one the call may leave out and ": what it's for" after
# that, as "text or nothing: a city's name"; or a JSON Schema of its own. A tool's function gives back text, or
# anything else, sent as JSON; a mistake in it is sent as the tool's error, and the server goes on. Only a
# program folio builds can serve, as it reads its input as it comes; answer() answers one message anywhere.

set mcp_versions to list of "2025-06-18", "2025-03-26", "2024-11-05" # the protocol's versions it speaks, newest first

# a server, by the name and version the app is told
to server with name, version
    return record with name name, version version, tools empty list, resources empty list, prompts empty list
end

# a tool the app can call: its name, what it does (which the app's model reads), what it needs, and the function
# that does it, given what the app sent as a dictionary
to tool with on, name, description, needs, does
    set kept to tools of on
    add record with name name, description description, schema mcp_schema(needs), does does to kept
end

# text the app can read, by its address (as "notes://today"): its name, what it is, its type (as "text/plain"),
# and the function that gives the text, given the address
to resource with on, address, name, description, type, reads
    set kept to resources of on
    add record with address address, name name, description description, type type, reads reads to kept
end

# a prompt the app can offer: its name, what it's for, what it needs (as a tool's are said), and the function
# that gives the message's text, given what was filled in as a dictionary
to prompt with on, name, description, needs, makes
    set kept to prompts of on
    add record with name name, description description, needs needs, makes makes to kept
end

# a JSON Schema's type for each of the words that say what an input is
to mcp_type with word
    if word is "number"
        return "number"
    else if word is "whole number"
        return "integer"
    else if word is "text"
        return "string"
    else if word is "yes or no" or word is "yes/no"
        return "boolean"
    else if word is "list"
        return "array"
    else if word is "dictionary" or word is "record"
        return "object"
    end
    fail with "mcp.folio: an input is a number, whole number, text, yes or no, list or dictionary, not " + word
end

# what an input's words say: its type, whether it can be left out, and what it's for
to mcp_input with said
    set what to said
    set about to ""
    set colon to position of ":" in said
    if colon is greater than 0
        set what to mcp_trimmed(items 1 to (colon - 1) of said)
        set about to mcp_trimmed(items (colon + 1) to (length of said) of said)
    end
    set optional to no
    set ending to " or nothing"
    set cut to (length of what) - (length of ending)
    if cut is greater than 0
        set tail to items (cut + 1) to (length of what) of what
        if tail is ending
            set optional to yes
            set what to items 1 to cut of what
        end
    end
    return record with type mcp_type(what), optional optional, about about
end

# text without spaces at either end
to mcp_trimmed with words
    set first to 1
    set last to length of words
    repeat while first is at most last and item first of words is " "
        add 1 to first
    end
    repeat while last is at least first and item last of words is " "
        set last to last - 1
    end
    if last is less than first
        return ""
    end
    return items first to last of words
end

# what a tool needs, as the JSON Schema of an object
to mcp_schema with needs
    if needs is nothing
        return dictionary where "type" is "object", "properties" is empty dictionary
    end
    if "type" is in needs # a JSON Schema already
        return needs
    end
    set properties to empty dictionary
    set required to empty list
    for each name in keys of needs
        set said to item name of needs
        set input to mcp_input(said)
        set property to dictionary where "type" is type of input
        if about of input is not ""
            set item "description" of property to about of input
        end
        set item name of properties to property
        if not optional of input
            add name to required
        end
    end
    return dictionary where "type" is "object", "properties" is properties, "required" is required
end

# a prompt's arguments, as the app is told them
to mcp_arguments with needs
    set out to empty list
    if needs is nothing
        return out
    end
    for each name in keys of needs
        set input to mcp_input(item name of needs)
        set needed to not (optional of input)
        set argument to dictionary where "name" is name, "required" is needed
        if about of input is not ""
            set item "description" of argument to about of input
        end
        add argument to out
    end
    return out
end

# text as it is (a call of it fails for anything else)
to mcp_as_text with given as text
    return given
end

# what a function gave, as the text of a message: text as it is, anything else as JSON
to mcp_text with given
    if given is nothing
        return ""
    end
    try
        return mcp_as_text(given)
    if it fails
        return given as json
    end
end

# what the server says to a request (a method and its params): a record of the result, or of an error's code
# and message
to mcp_handle with on, method, params
    if method is "initialize"
        set version to item 1 of mcp_versions
        if "protocolVersion" is in params
            if item "protocolVersion" of params is in mcp_versions
                set version to item "protocolVersion" of params
            end
        end
        set can to dictionary where "tools" is empty dictionary
        if length of resources of on is greater than 0
            set item "resources" of can to empty dictionary
        end
        if length of prompts of on is greater than 0
            set item "prompts" of can to empty dictionary
        end
        set info to dictionary where "name" is name of on, "version" is version of on
        return record with result (dictionary where "protocolVersion" is version, "capabilities" is can, "serverInfo" is info)
    end
    if method is "ping"
        return record with result empty dictionary
    end
    if method is "tools/list"
        set listed to empty list
        for each t in tools of on
            add dictionary where "name" is name of t, "description" is description of t, "inputSchema" is schema of t to listed
        end
        return record with result (dictionary where "tools" is listed)
    end
    if method is "tools/call"
        set wanted to item "name" of params
        for each t in tools of on
            if name of t is wanted
                set given to empty dictionary
                if "arguments" is in params
                    set given to item "arguments" of params
                end
                set does to does of t
                set failed to no
                try
                    set said to mcp_text(does(given))
                if it fails with why
                    set said to mcp_text(why)
                    set failed to yes
                end
                set content to list of (dictionary where "type" is "text", "text" is said)
                return record with result (dictionary where "content" is content, "isError" is failed)
            end
        end
        return record with code -32602, message "there's no tool called " + wanted
    end
    if method is "resources/list"
        set listed to empty list
        for each r in resources of on
            add dictionary where "uri" is address of r, "name" is name of r, "description" is description of r, "mimeType" is type of r to listed
        end
        return record with result (dictionary where "resources" is listed)
    end
    if method is "resources/read"
        set wanted to item "uri" of params
        for each r in resources of on
            if address of r is wanted
                set reads to reads of r
                set got to dictionary where "uri" is wanted, "mimeType" is type of r, "text" is mcp_text(reads(wanted))
                return record with result (dictionary where "contents" is list of got)
            end
        end
        return record with code -32002, message "there's no resource at " + wanted
    end
    if method is "prompts/list"
        set listed to empty list
        for each p in prompts of on
            add dictionary where "name" is name of p, "description" is description of p, "arguments" is mcp_arguments(needs of p) to listed
        end
        return record with result (dictionary where "prompts" is listed)
    end
    if method is "prompts/get"
        set wanted to item "name" of params
        for each p in prompts of on
            if name of p is wanted
                set given to empty dictionary
                if "arguments" is in params
                    set given to item "arguments" of params
                end
                set makes to makes of p
                set content to dictionary where "type" is "text", "text" is mcp_text(makes(given))
                set message to dictionary where "role" is "user", "content" is content
                return record with result (dictionary where "description" is description of p, "messages" is list of message)
            end
        end
        return record with code -32602, message "there's no prompt called " + wanted
    end
    return record with code -32601, message "there's no method called " + method
end

# A message from the app, as the line of JSON it sent, answered: the reply's line of JSON, or nothing for a
# notification, which has no reply.
to answer with on, line
    set message to nothing
    try
        set message to json from line
    if it fails
        return (dictionary where "jsonrpc" is "2.0", "id" is nothing, "error" is (dictionary where "code" is -32700, "message" is "that isn't JSON")) as json
    end
    set id to nothing
    set asked to no
    try
        set asked to "id" is in message
        if asked
            set id to item "id" of message
        end
        set method to item "method" of message
    if it fails
        return (dictionary where "jsonrpc" is "2.0", "id" is id, "error" is (dictionary where "code" is -32600, "message" is "a request has a method")) as json
    end
    if not asked # a notification, as notifications/initialized: nothing to say
        return nothing
    end
    set params to empty dictionary
    if "params" is in message
        set params to item "params" of message
    end
    set handled to mcp_handle(on, method, params)
    set reply to dictionary where "jsonrpc" is "2.0", "id" is id
    try
        set item "result" of reply to result of handled
    if it fails
        set item "error" of reply to dictionary where "code" is code of handled, "message" is message of handled
    end
    return reply as json
end

# the next line of the input, without its line end, or nothing when the input has ended
to mcp_read_line
    set got to empty list
    repeat while yes
        set b to ask for 1 bytes
        if length of b is 0
            if length of got is 0
                return nothing
            end
            return (got as bytes) as text
        end
        if item 1 of b is 10
            return (got as bytes) as text
        end
        if item 1 of b is not 13 # a line may end with \r\n
            add item 1 of b to got
        end
    end
end

# serves the app that started the program: each line it sends answered, until its input ends
to serve with on
    repeat while yes
        set line to mcp_read_line()
        if line is nothing
            return nothing
        end
        if mcp_trimmed(line) is not ""
            set reply to answer(on, line)
            if reply is not nothing
                say reply
            end
        end
    end
end
