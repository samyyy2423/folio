# what the programs in tools/ make when they run
tools/*.bmp
# pages made from the apps (by folio build --web, in the Node.js command line Folio had until 1.5)
apps/*.html
# folio.folio built into a program of its own: folio.exe on Windows, folio on Linux
/folio.exe
/folio
# where npm run bench and npm run versus put the programs they time, while they do
/.bench-*
# the VS Code extension, packed (by node editors/vscode/make-vsix.mjs, or vsce), the engine vsce packs from,
# the tools to pack and test it (npm ci there), and the copies of VS Code its tests download
editors/vscode/*.vsix
editors/vscode/engine/
editors/vscode/node_modules/
editors/vscode/.vscode-test/
# what building the Zed extension, and the tree-sitter grammar for Neovim, leave behind
editors/zed/target/
editors/zed/extension.wasm
editors/zed/grammars/
editors/tree-sitter-folio/*.so
editors/tree-sitter-folio/*.dll
editors/tree-sitter-folio/*.dylib
# what the guestbook keeps, and its tests' database, when it's run in its folder
apps/guestbook/*.db
apps/guestbook/guestbook
apps/guestbook/guestbook.exe
# what Python makes when it runs the Jupyter kernel or its tests
editors/jupyter/**/__pycache__/
# what packaging/release-build.sh makes, given dist (docs/installers.md)
/dist/
